    <!-- https://hist-arch-vocab.org/bvha#c_7db6670b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_7db6670b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f7qkhf86"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-04T11:38:01.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T18:26:17.000</terms:modified>
        <skos:altLabel xml:lang="de">Desornamentado-Stil</skos:altLabel>
        <skos:altLabel xml:lang="cs">desornamentado</skos:altLabel>
        <skos:definition xml:lang="de">Nach Juan de Herrera, 1530-97, benannter offizieller Baustil zur Regierungszeit Philipps II., eine strenge Version der italienischen Renaissance, der wegen seines sparsamen Dekors auch »Desornamentado-Stil« genannt wird. Hauptwerk: Escorial. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Oficiální stavební sloh z doby vlády španělského krále Filipa II., nazvaný podle Juana de Herrery (1530-97), přísná verze italské renesance, vzhledem k úspornému dekoru nazýván také desornamentado, hlavní dílo: Escorial. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Herrera-Stil</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">herrerův styl</skos:prefLabel>
    </owl:NamedIndividual>
    


