    <!-- https://hist-arch-vocab.org/bvha#c_3d480c77 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_3d480c77">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_ed888401"/>
