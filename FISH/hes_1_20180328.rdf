		<skos:scopeNote xml:lang="en">A place with platforms and other facilities, allowing trains to stop to take on and set down passengers and load and unload goods for transport.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
