		<skos:altLabel xml:lang="de">Römische Tetrarchie (Zeitabschnitt)</skos:altLabel>
		<skos:altLabel xml:lang="de">Tetrarchie (284-305 CE)</skos:altLabel>
		<skos:prefLabel xml:lang="en">Tetrarchy (period)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Zeit der diokletianischen Tetrarchie</skos:altLabel>
		<skos:prefLabel xml:lang="de">Zeit der Römischen Tetrarchie</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000504"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000504"/>
		<skos:definition xml:lang="de">Die Zeit der Römischen Tetrarchie ist eine Phase der Späten Römischen Kaiserzeit, in der das Römische Reich von vier gleichberechtigten Herrschern (Augusti und Caesares) regiert wurde (293–305 n. Chr.). Ihr institutioneller Beginn wird meist auf die Herrschaft Diokletians ab 284 n. Chr. zurückgeführt, während ihr Ende durch die Machtkämpfe nach der Abdankung Diokletians und Maximians sowie die Erhebung Konstantins des Großen zum Kaiser im Jahr 306 n. Chr. markiert wird.</skos:definition>
		<skos:relatedMatch rdf:resource="http://d-nb.info/gnd/4125265-2"/>
		<skos:relatedMatch rdf:resource="http://vocab.getty.edu/aat/300020575"/>
		<skos:mappingRelation rdf:resource="http://www.wikidata.org/entity/Q174450"/>
		<crm:P82a_begin_of_the_begin rdf:datatype="http://www.w3.org/TR/xmlschema11-2/#gYear">+284</crm:P82a_begin_of_the_begin>
		<crm:P82b_end_of_the_end rdf:datatype="http://www.w3.org/TR/xmlschema11-2/#gYear">+305</crm:P82b_end_of_the_end>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000504"/>
