    <!-- https://hist-arch-vocab.org/bvha#c_9b9d7014 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_9b9d7014">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_ff5ae73d"/>
