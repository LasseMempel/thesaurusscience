  <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/171302">
    <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2"/>
    <skos:prefLabel xml:lang="en">FEN COTTAGE</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Fen cottages are small, 1.5 storey, low-status vernacular dwellings constructed of local materials, usually timber-framed with infills of brick, clay lump or wattle and daub panels. Fen cottages are specifically associated with waterborne or water-adjacent smallholder activity that proliferated in the newly-drained fen landscape in the 18th and 19th centuries, intrinsic to the landscape character of the Fens.</skos:scopeNote>
    <dc1:identifier rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/171302"/>
