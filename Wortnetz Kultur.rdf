	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk015443">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Passiergerät</skos:prefLabel>
		<skos:prefLabel xml:lang="en">purée sieve</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006933"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013783"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk006933"/>
		<xe:ter01221 rdf:resource="http://lvr.vocnet.org/wnk/wk018385"/>
		<xe:explanation_temp xml:lang="de">Im Gegensatz zum Sieb wird hier in der Regel das durch das Sieb passierte Produkt weiter verwendet, während beim Sieb in der Regel das aufgefangene Produkt weiter genutzt wird.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Passiergerät ist eine Lebensmittelmühle die in der Regel aus einem sehr feinen Sieb und einem darüber streichenden Metallstreifen bestehen und dazu dienen, Soßen, Marmeladen oder Ähnliches fein zu passieren.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk013783"/>
