    <!-- https://hist-arch-vocab.org/bvha#c_1a47abcf -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_1a47abcf">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b31198a0"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-16T10:35:02.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T15:15:43.000</terms:modified>
        <skos:altLabel xml:lang="de">Klosterbruder</skos:altLabel>
        <skos:altLabel xml:lang="de">Laienbruder</skos:altLabel>
        <skos:altLabel xml:lang="fr">lai</skos:altLabel>
        <skos:altLabel xml:lang="fr">lai convers</skos:altLabel>
        <skos:definition xml:lang="de">Frater m, lat.; Laienbruder m; Klosterbruder m: Mönch, der keine Weihen empfangen hat. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Frater</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">frère</skos:prefLabel>
        <skos:prefLabel xml:lang="en">lay brother</skos:prefLabel>
    </owl:NamedIndividual>
    


