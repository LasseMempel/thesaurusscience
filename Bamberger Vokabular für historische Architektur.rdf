        <skos:prefLabel xml:lang="en">Hair crack</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Microfissure</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">Vlasová trhlina</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Sehr feiner Riss, von weniger als 1 mm Breite.</skos:scopeNote>
    </owl:NamedIndividual>
    


