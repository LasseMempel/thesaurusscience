  <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68888">
    <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2"/>
    <skos:prefLabel xml:lang="en">INTERVAL TOWER</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A tower situated above the rampart walkway and in between the angle towers along a defensive structure, such as a castle wall. They were used as lookout towers, roofed strongpoints or platforms from which missiles could be discharged or artillery fired.</skos:scopeNote>
