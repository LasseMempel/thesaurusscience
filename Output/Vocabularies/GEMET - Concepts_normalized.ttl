<http://www.eionet.europa.eu/gemet/concept/15121> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7982> ;
    skos:definition "Species in which the evolutionary process has been influenced by humans to meet their needs"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "domesticated species"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/3048>,
