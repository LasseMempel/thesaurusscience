    skos:closeMatch <http://data.uba.de/umt/_00041719> ;
    skos:definition "A binding rule or body of rules prescribed by a government to organize, designate and regulate land use within its domain through zoning laws, subdivision regulations, rent and sign controls, growth management and other measures designed to protect human health and ecological integrity."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
