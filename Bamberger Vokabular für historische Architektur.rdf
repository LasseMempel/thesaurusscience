        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T15:49:25.000</terms:modified>
        <skos:definition xml:lang="de">Eine vor, gelegentlich auch hinter dem Tor befindliche Grube, die ein zusätzliches Annäherungshindernis darstellte und durch eine bewegliche Zugbrücke (oder Wippbrücke) überbrückt wurde. R. F.. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:prefLabel xml:lang="de">Wolfsgrube</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_8db71296 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_8db71296">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_85e9de8f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_4b0fc1fe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
