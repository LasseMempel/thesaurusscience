	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/324">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/324</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÀRACH SHONNACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Lann mun a bheil co-dhiù aon sreath de phuist fhiodha faisg air a chèile 's nan seasamh ann an dìg bunait chaol.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PALISADED ENCLOSURE</skos:prefLabel>
