		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/535" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/436" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/531" />
		<skos:scopeNote xml:lang="en">A row of cottages built as accommodation for miners and their families.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
