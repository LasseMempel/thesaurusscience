	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1718">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1718</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">COMHARRA UAIGHE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar cloiche, sglèata, iarainn no fiodha a chomharraicheas an t-àite far a bheil uaigh. Cleachd seòrsa nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GRAVE MARKER</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1721" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1667" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1719" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1720" />
		<skos:scopeNote xml:lang="en">A stone, slate, iron or wooden structure used to mark the site of a grave. Use more specific type.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1719">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1719</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LEAC-UAIGHE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Clach a chaidh a chleachdadh gus uaigh a chòmhdachadh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GRAVE SLAB</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1718" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1653" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1716" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1720" />
		<skos:scopeNote xml:lang="en">A stone used to cover a grave.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1720">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1720</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CLACH-CHINN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Clach no leac a chomharraicheas tìodhlacadh, air an aithnichear an t-àite agus a tha na chuimhneachan dha. Mar is trice aig ceann no bonn uaighe no aig doras tuama.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GRAVESTONE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1718" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1556" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1653" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1713" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1716" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1719" />
		<skos:scopeNote xml:lang="en">A stone or slab used to mark, identify and commemorate a burial. Usually placed at the head or foot of a grave, or at the entrance to a tomb.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1721">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1721</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CLACH DRUIM-TORCA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Clach a chaidh a shnaidheadh air dòigh 's gu bheil coltas taighe thulchainneach air le lùbadh os-chearclach air druim a' mhullaich 's e a' dol air ais dhan 10mh linn AD. Faodaidh seo a bhith eas-chruthach no nàdarrachail agus faodaidh gum bi sgeadachadh mhathan no nathraichean air a bharrachd air sin.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HOGBACK STONE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1718" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1499" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1716" />
		<skos:scopeNote xml:lang="en">A block of stone carved to represent a gabled house, with a convex curve to the ridge of its roof, dating to the 10th century AD. May be abstract or naturalistic, and have additional decoration in the form of bears or snakes.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1722">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1722</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH CARBAD NAM MARBH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Nàdar de thaigh-charbadan, mar is trice ann an cill, far an cumar an crò-charbad.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HEARSE HOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1834" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1667" />
		<skos:scopeNote xml:lang="en">A type of carriage house, usually in a churchyard, for storing a hearse.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1723">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1723</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">IARMAD DAONNA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Iarsmaidhean corp mac an duine. Ma tha na cnàmhan ann an òrdugh daonna fhathast, cleachd TÌODHLACADH. Ma tha iad loisgte, cleachd LOSGADH-CUIRP.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HUMAN REMAINS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-08-08T11:28:27</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1667" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1673" />
		<skos:scopeNote xml:lang="en">The remains of the body of a human being. If articulated use INHUMATION. If burnt use CREMATION.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1724">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1724</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">MAUSOLEUM</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Cuimhneachan àite-tìodhlacaidh, mar is trice do dh'aonan no do theaghlach.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MAUSOLEUM</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">TEMPLE MAUSOLEUM</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1667" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1693" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1708" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1727" />
		<skos:scopeNote xml:lang="en">A monumental burial place, usually for a single person or a family.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1725">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1725</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CRÒ NAM MARBH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Lann cheart-cheàrnach no cha mhòr cheart-cheàrnach à Linn Ùr na Cloiche 's beachd gun deach a chleachdadh gus iarsmaidhean daonna a nochdadh ris na speuran mus deach an tìodhlacadh an dàrna turas.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MORTUARY ENCLOSURE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1667" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1525" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1668" />
		<skos:scopeNote xml:lang="en">A rectangular or sub-rectangular enclosure of Neolithic date, assumed to have been used for the exposure of human remains prior to secondary burial.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1726">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1726</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">ROILIG CNÀMHAN NAM MARBH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Soitheach no stòras airson cnàmhan nam marbh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">OSSUARY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">OSSUARY CAVE</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1667" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1673" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1675" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1700" />
		<skos:scopeNote xml:lang="en">A container or storage place for the bones of the dead.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1727">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1727</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TUAMA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Uaigh a tha a' gabhail a-steach cuimhneachan. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TOMB</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1667" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1488" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1653" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1703" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1716" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1724" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/205" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/206" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/210" />
		<skos:scopeNote xml:lang="en">A grave or sepulchre including a monument. Use specific term where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
