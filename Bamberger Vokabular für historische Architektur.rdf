    <!-- https://hist-arch-vocab.org/bvha#c_a7b9748b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_a7b9748b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
