    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Open Space"@en ;
    skos:scopeNote "Public outdoor areas often with facilities for games and other activities."@en .

<http://purl.org/heritagedata/schemes/571/concepts/160474> a skos:Concept ;
