    <!-- https://hist-arch-vocab.org/bvha#c_baaa219e -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_baaa219e">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
