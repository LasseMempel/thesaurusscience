		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk012979"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk012977"/>
		<xe:explanation_temp xml:lang="de">Bastfasern werden für die Erzeugung von Seilen, Garnen, Matten oder Geweben verwendet und finden sowohl im textilen als auch im industriellen Bereich Verwendung.</xe:explanation_temp>
		<skos:definition xml:lang="de">Bastfaser ist eine Pflanzenfaser, die in Form von mehrzelligen Faserbündeln im Bast verschiedener Pflanzenarten vorhanden ist.</skos:definition>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300048153"/>
