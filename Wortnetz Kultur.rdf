	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk018585">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Wasserspeier (Architekturelement)</skos:prefLabel>
		<skos:prefLabel xml:lang="en">waterspout (architectural element)</skos:prefLabel>
		<skos:altLabel xml:lang="en">waterspouts (architectural elements)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000112"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk021135"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000112"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk021135"/>
		<skos:definition xml:lang="de">Ein Wasserspeier ist ein architektonisches Bauteil, das der Abfuhr von Regenwasser vom Gebäude weg dient, um das Eindringen des Wassers in Mauerwerk zu verhindern. Insbesondere an gotischen Bauten sind steinerne Wasserspeier als von Dächern oder aus Mauern hervorspringende Architekturteile oft künstlerisch figürlich ausgearbeitet, etwa in der Form von tierähnlichen Fabelwesen, aus deren Mäulern heraus das Regenwasser abfließt.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300248603"/>
		<skos:mappingRelation rdf:resource="http://www.wikidata.org/entity/Q1394694"/>
