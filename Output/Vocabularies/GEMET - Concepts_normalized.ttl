    skos:prefLabel "Regenwald"@de,
        "rain forest"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Rainforest> .

<http://www.eionet.europa.eu/gemet/concept/6965> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1221> ;
    skos:closeMatch <http://dbpedia.org/resource/Rare_species> ;
    skos:definition "Species which have a restricted world range."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Seltene Art"@de,
        "rare species"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15121> .

<http://www.eionet.europa.eu/gemet/concept/6970> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7364> ;
    skos:closeMatch <http://data.uba.de/umt/_00021030> ;
    skos:definition "Measures used to ensure the provision of or the access to crude, unprocessed or partially processed materials used as feedstock for processing or manufacturing."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Rohstoffsicherung"@de,
        "raw material securing"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/7170> .

<http://www.eionet.europa.eu/gemet/concept/6979> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/167> ;
    skos:closeMatch <http://dbpedia.org/resource/Reforestation> ;
    skos:definition "The planting of trees in forest areas which have been cleared. Reforestation has become increasingly important for preventing or reversing environmental degradation and for helping to maximize economic returns on commercially forested lands."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_13802> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Wiederaufforstung"@de,
        "reforestation"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15176> .

<http://www.eionet.europa.eu/gemet/concept/6999> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7093> ;
    skos:definition "The process of returning wildlife ecosystems and habitats to their original conditions."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Wiederherstellung der natürlichen Pflanzen- und Tierwelt"@de,
        "fauna restoration"@en .

<http://www.eionet.europa.eu/gemet/concept/7009> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6724> ;
    skos:definition "Characteristic of materials that still have useful physical or chemical properties after serving their original purpose and that can, therefore, be reused or remanufactured into additional products."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Recycelbarkeit"@de,
        "recyclability"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/7012> .

<http://www.eionet.europa.eu/gemet/concept/7010> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6329> ;
    skos:definition "Plastic waste that can be transformed into new products."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Kunststoff (recyclinggerecht)"@de,
        "recyclable plastic"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/7012> ;
    skos:relatedMatch <http://dbpedia.org/resource/Plastic_recycling> .

<http://www.eionet.europa.eu/gemet/concept/7014> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7012> ;
    skos:closeMatch <http://data.uba.de/umt/_00020535> ;
    skos:definition "Paper that has been separated from the solid waste stream for utilization as a raw material in the manufacture of a new product. Not all paper in the waste stream is recyclable. It may be heavily contaminated or otherwise unusable."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Recyclingpapier"@de,
        "recycled paper"@en ;
