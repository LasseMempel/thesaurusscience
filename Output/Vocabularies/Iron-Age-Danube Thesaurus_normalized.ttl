<https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme/concept431> a skos:Concept ;
    skos:altLabel "ALS"@en,
        "LIDAR"@en,
        "LiDAR"@en,
        "Light Detection And Ranging"@en,
        "lidar"@en ;
    skos:broader <https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme/concept424> ;
    skos:definition "Direct measurement of terrain from an airborne platform using laser rangefinders using successive ranges continuously from an aircraft vertically downwards toward the terrain along the ground track of the aircraft. The method is especially useful to uncover the topography of areas covered by forest canopy."@en ;
