        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T18:05:14.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T12:12:39.000</terms:modified>
        <skos:definition xml:lang="de">Chorkapelle, Kapelle an einem Chorschluss (→ Scheitelkapelle) oder einem Chorumgang. Die Gesamtheit der Apsidialkapellen an einem Chor heißt Kapellenkranz. [Koepf / Binding 2016]</skos:definition>
