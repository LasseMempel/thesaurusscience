		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1196" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1826" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1856" />
		<skos:scopeNote xml:lang="en">A shaft designed to allow for the adequate circulation of air through an underground structure.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
