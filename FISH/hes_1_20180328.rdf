		<skos:prefLabel xml:lang="gd">CROIT</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Tuathanas no gabhaltas beag.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CROFT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
