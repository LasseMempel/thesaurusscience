    <!-- https://hist-arch-vocab.org/bvha#c_7a938ac1 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_7a938ac1">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_49b400f3"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T12:09:51.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T12:40:57.000</terms:modified>
        <skos:definition xml:lang="cs">Eufrat, Tigris, Gihon (též Gíchón) a Pison (Píšon, První Mojžíšova), v raně křesťanském umění znázorňovány jako potoky, ve středověku jako muži s nádobami, z nichž prýští voda. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Euphrat, Tigris, Gihon und Physon (I. Moses 2,10ff.), in der frühchristlichen Kunst als Bäche, im Mittelalter als Männer mit Gefäßen dargestellt, denen Wasser entströmt. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Paradiesflüsse</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">rajské řeky</skos:prefLabel>
    </owl:NamedIndividual>
    


