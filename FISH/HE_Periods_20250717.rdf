    <skos:prefLabel xml:lang="en">Archaeological and Cultural Periods</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Time periods to associate with cultural heritage artefacts or monuments.</skos:scopeNote>
    <skos:notation xml:lang="en">period</skos:notation>
