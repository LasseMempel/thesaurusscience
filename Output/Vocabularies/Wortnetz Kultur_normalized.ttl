<http://lvr.vocnet.org/wnk/wk003971> a skos:Concept ;
    skos:broader <http://lvr.vocnet.org/wnk/wk012246> ;
    skos:closeMatch <https://www.wikidata.org/wiki/Q31576> ;
    skos:definition "Sterlingsilber ist eine Silberlegierung, die zu 92,5% aus Silber und zu 7,5% aus Kupfer besteht und daher härter und widerstandsfähiger ist als reines Silber."@de ;
    skos:exactMatch <http://vocab.getty.edu/aat/300010977> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
