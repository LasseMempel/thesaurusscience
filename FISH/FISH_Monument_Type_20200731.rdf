    <skos:scopeNote xml:lang="en">An attic workshop for textile manufacture, usually weaving.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71598">
    <skos:scopeNote xml:lang="en">A building in which a sport is played. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92981">
    <skos:scopeNote xml:lang="en">A common type of lock in the form of a chamber with gates on either side.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94124">
    <skos:scopeNote xml:lang="en">A building containing a machine tool for boring out large cylindrical holes in items such as steam engine cylinders, pump barrels, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92289">
    <skos:scopeNote xml:lang="en">A specialist hospital for the medical treatment of patients suffering from epilepsy. Originally epilepsy was seen as a mental illness.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159295">
    <skos:scopeNote xml:lang="en">A prefabricated structure of cellular hollow plywood 'aero' beams and columns clad with timber framed units of flat asbestos facing sheets and a felt roof. Designed as airfield accommodation that could be reused as post WWII emergency housing.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93370">
    <skos:scopeNote xml:lang="en">An early warning structure built during and after WWI along the south and east coasts of England. Sound detecting acoustic dishes and walls could detect the sound of approaching enemy aircraft at a distance of 8 to 15 miles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87125">
    <skos:scopeNote xml:lang="en">A mill used for the manufacture of narrow strips of woven fabric used in the closing or fixing of garments, or for binding the edges of fabric goods.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70184">
    <skos:scopeNote xml:lang="en">A place where worship is offered or devotions are paid to a deity or saint.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71703">
    <skos:scopeNote xml:lang="en">A purpose-built, or modified, building where organizations and associations meet for presentations and consultation.</skos:scopeNote>
  </rdf:Description>
