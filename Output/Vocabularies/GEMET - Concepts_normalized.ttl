<http://www.eionet.europa.eu/gemet/concept/352> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5887> ;
    skos:definition "A natural or synthetic oxide of aluminum widely distributed in nature, often found as a constituent part of clays, feldspars, micas and other minerals, and as a major component of bauxite."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Tonerde"@de,
        "alumina"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Aluminium_oxide> .

<http://www.eionet.europa.eu/gemet/concept/3521> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12606> ;
    skos:closeMatch <http://data.uba.de/umt/_00004057>,
        <http://dbpedia.org/resource/Fumigation> ;
    skos:definition "The use of a chemical compound in a gaseous state to kill insects, nematodes, arachnids, rodents, weeds, and fungi in confined or inaccessible locations; also used to control weeds, nematodes, and insects in the field."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_3142> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Begasung"@de,
