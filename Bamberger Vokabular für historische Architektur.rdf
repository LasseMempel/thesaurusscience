        <skos:altLabel xml:lang="de">Pendentif-Faltwerk</skos:altLabel>
        <skos:altLabel xml:lang="de">Rippenzwickel</skos:altLabel>
        <skos:definition xml:lang="de">In der Baukunst des Islam gebräuchl. Sonderform der Gewölbezwickel (Pendentifs) mit gekreuzten Rippen, die Rautenformen umschließen. [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Pendentif mit berippter Leibung. (Glossarium Artis, Bd.6)</skos:definition>
        <skos:prefLabel xml:lang="es"> pechina nervada</skos:prefLabel>
        <skos:prefLabel xml:lang="it"> pennacchio nervato</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Rippenpendentif</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">pendentif nervure</skos:prefLabel>
        <skos:prefLabel xml:lang="en">ribbed pendentive</skos:prefLabel>
    </owl:NamedIndividual>
    


