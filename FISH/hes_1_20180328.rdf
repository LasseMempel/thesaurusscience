		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/154" />
		<skos:scopeNote xml:lang="en">A tower used as a watch tower by the coastguard. Often, though not always, built as part of a Coastguard Station.</skos:scopeNote>
