		<skos:prefLabel xml:lang="gd">CAIBEAL</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach a sheasas leis fhèin no seòmar no cùlaist a tha na àite-adhraidh Crìostail ann an eaglais no togalach eile.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CHAPEL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
