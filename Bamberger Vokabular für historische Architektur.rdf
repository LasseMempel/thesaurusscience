    <!-- https://hist-arch-vocab.org/bvha#c_19f2b5e4 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_19f2b5e4">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_fe6ee255"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_81f107fc"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_397b5b94"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_c8f98864"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-04T14:14:43.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T22:46:00.000</terms:modified>
        <skos:altLabel xml:lang="la">corona pharalis</skos:altLabel>
        <skos:altLabel xml:lang="en">crown of light</skos:altLabel>
        <skos:altLabel xml:lang="el">polykandelon</skos:altLabel>
        <skos:definition xml:lang="de">Kronleuchter m; gr. polykandelon; lat. corona lucis; coronapharaIis: ein runder, vielarmiger Hängeleuchter, manchmal mit mehreren Lichterreihen übereinander, deren oberste Panasch (m) genannt wird. Ein Kronleuchter mit der Figur der Jungfrau Maria heißt Marienleuchter (m) oder Muttergottesleuchter (m). [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="cs">Svítidlo zavěšené pod stropem, i s několika světly, má tvar koruny nebo kruhu s věžičkam,1 a branami Jako symbolem nebeského Jeruzaléma (jeruzalémský lustr, románská doba), také s figurami; dřík nebo koule s paprskovitými rameny (gotika), později ze skla (renesance, zvl. v Benátkách). [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Von der Decke herabhängend mit mehreren Lichtern. In Form einer Krone oder eines Rades (Radleuchter) mit Türmen und Toren als Symbol des himmlischen Jerusalem (Romanik), auch mit Figuren; als Schaft oder Kugel mit strahlenförmigen Armen (Gotik), später aus Glas (Renaissance, besonders in Venedig). [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Kronleuchter</skos:prefLabel>
        <skos:prefLabel xml:lang="en">corona lucis</skos:prefLabel>
        <skos:prefLabel xml:lang="la">corona lucis</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">couronne de lumière</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">lustr</skos:prefLabel>
    </owl:NamedIndividual>
    


