		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/742" />
		<skos:scopeNote xml:lang="en">A chamber in which minerals, metals, etc, are subjected to the continuous action of intense heat. Use specific type where known.</skos:scopeNote>
