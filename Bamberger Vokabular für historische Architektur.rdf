        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-29T13:53:43.000</terms:modified>
        <skos:altLabel xml:lang="de">Gerüstgrenze</skos:altLabel>
        <skos:altLabel xml:lang="de">Putzgrenze</skos:altLabel>
        <skos:altLabel xml:lang="de">Putznaht</skos:altLabel>
        <skos:note xml:lang="en">A wide area of plaster applied at the same high as the scaffolding, leaving horizontal seams in the finished work. [EwaGlos]</skos:note>
