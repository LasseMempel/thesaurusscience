        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-07T11:44:14.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-30T23:22:13.000</terms:modified>
        <skos:altLabel xml:lang="de">Blendmauer</skos:altLabel>
        <skos:altLabel xml:lang="de">Blendmauerwerk</skos:altLabel>
        <skos:altLabel xml:lang="cs">lícová vyzdívka</skos:altLabel>
        <skos:altLabel xml:lang="cs">lícové zdivo</skos:altLabel>
        <skos:altLabel xml:lang="cs">obkladová vyzdívka</skos:altLabel>
        <skos:definition xml:lang="de">Mauerwerk, dessen Kern aus Materialien minderer Qualität besteht, z. B. aus Feldsteinen, Bruchsteinen, oder Beton, dessen Ansichtsfläche aber mit Steinen höherer Qualität, z. B. mit Backsteinen, verkleidet ist. (Glossarium Artis, Bd. 3, Bögen und Mauerwerk)</skos:definition>
        <skos:definition xml:lang="de">Mauerwerk, dessen Kern durch ein wertvolleres bzw. wetterbeständigeres Material (Blendsteine u. dergl.) verblendet ist. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Verblendmauerwerk</skos:prefLabel>
        <skos:prefLabel xml:lang="en">facing masonry</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kamenná plenta</skos:prefLabel>
        <skos:prefLabel xml:lang="es">mampostería de paramento</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">maçonnerie en briques de parement</skos:prefLabel>
        <skos:prefLabel xml:lang="it">muratura rivesta (a cortina)</skos:prefLabel>
        <broaderByConstruction rdf:resource="https://hist-arch-vocab.org/bvha#c_k1vkpmvw"/>
    </owl:NamedIndividual>
    


