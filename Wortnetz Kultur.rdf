		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-25T12:46:25+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk012871">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Einsalzen</skos:prefLabel>
		<skos:prefLabel xml:lang="en">salting (food preservation)</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk014695"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013706"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk014695"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk013411"/>
		<skos:definition xml:lang="de">Einsalzen ist ein Verfahren der Lebensmittelkonservierung, bei dem Lebensmittel wie Fleisch, Fisch oder auch Früchte durch Einreiben mit Salz oder Einlegen in Salzlake haltbar gemacht werden und einen besonderen Geschmack erhalten. Wenn zusätzlich Gewürze und weitere Konservierungsmittel zum Einsatz kommen, wird das Verfahren Pökeln genannt.</skos:definition>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4273429-0"/>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300400676"/>
