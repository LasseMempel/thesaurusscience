	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk019956">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Spielzeuginstrument</skos:prefLabel>
		<skos:altLabel xml:lang="de">Spielzeuginstrumente</skos:altLabel>
		<skos:prefLabel xml:lang="en">toy instrument</skos:prefLabel>
		<skos:altLabel xml:lang="en">toy instruments</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk005541"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk005706"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk005541"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk005706"/>
		<skos:definition xml:lang="de">Ein Spielzeuginstrument ist ein Musikinstrument, das als Spielzeug für Kinder hergestellt wurde. Es ist einfacher gestaltet und kleiner als das übliche Musikinstrument, kann diesem nachempfunden sein oder ein ganz eigenes Musikinstrument darstellen. Insbesondere Form und Farbgebung unterscheiden es vom Musikinstrument für Musiker.</skos:definition>
		<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q2310383"/>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300449086"/>
		<skos:narrowMatch rdf:resource="https://d-nb.info/gnd/7565607-3"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk005541"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk005706"/>
