		<skos:altLabel xml:lang="de">Tierbaue</skos:altLabel>
		<skos:altLabel xml:lang="de">Tierbaute</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk009615"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk016337"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk017414"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk009615"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk004229"/>
		<skos:definition xml:lang="de">Ein Tierbau ist eine tierische Behausung, die als unterirdischer Hohlraum von Tieren angelegt wird und Schutz, Rückzug, Brutplatz oder auch der Vorratshaltung bietet. Je nach Art können Tierbaue einfache Höhlen oder komplexe Systeme mit Gängen und Kammern sein.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4185460-3"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk009615"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk016337"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk017414"/>
		<xe:status>approved</xe:status>
		<iso-thes:status>Approved</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
