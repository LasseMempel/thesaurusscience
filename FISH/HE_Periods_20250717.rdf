        <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
        <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
        <skos:prefLabel xml:lang="en">Flavian</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Referring to the reigns of the emperors Vespasian (69-79 CE), Titus (79-81 CE), and Domitian (81-96 CE), that coincided with the dynasty established after the death of Nero in 69 CE. Circa 69 CE to 96 CE.</skos:scopeNote>
        <skos:notation xml:lang="en">ROFL</skos:notation>
      </skos:Concept>
    </skos:narrower>

