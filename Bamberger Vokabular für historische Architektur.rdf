        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T15:36:31.000</terms:modified>
        <skos:definition xml:lang="de">Emporen, die über den Seitenschiffen, im Querhaus und Chor auf einheitl. Höhe und untereinander verbunden herumgeführt sind. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Emporenumgang</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_b7d6a6dd -->


