        <skos:altLabel xml:lang="en">representative relic</skos:altLabel>
        <skos:definition xml:lang="de">Reliquie f, sekundäre; lat. reliquia secundaria: ein Gegenstand, der im Leben eines Heiligen eine Bedeutung hatte, z. B. Kleidung, Schriftrollen und Marterwerkzeuge. Man spricht präzis. auch von Sachreliquie (f). [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="fr">relique secondaire</skos:prefLabel>
        <skos:prefLabel xml:lang="la">reliquie secundaria</skos:prefLabel>
        <skos:prefLabel xml:lang="en">secondary relic</skos:prefLabel>
        <skos:prefLabel xml:lang="de">sekundäre Reliquie </skos:prefLabel>
    </owl:NamedIndividual>
    


