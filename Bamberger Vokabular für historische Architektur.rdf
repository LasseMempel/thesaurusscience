        <skos:altLabel xml:lang="en">double arcade</skos:altLabel>
        <skos:altLabel xml:lang="de">gekuppelte Arkade</skos:altLabel>
        <skos:definition xml:lang="de">Doppelarkade, Zwillingsarkade, zwei Arkaden, die durch einen sie gemeinsam überspannenden Blendbogen oder sichtbaren Entlastungsbogen zu einer Einheit zusammenfasst (gekuppelt) sind. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Zwei miteinander verbundene Bogenstellungen, oft von einem Entlastungsbogen überwölbt. Zwillingsarkaden gliedern häufig Fensteröffnungen. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Zwillingsarkade</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">arcades géminées</skos:prefLabel>
        <skos:prefLabel xml:lang="en">twin arcade</skos:prefLabel>
    </owl:NamedIndividual>
    


