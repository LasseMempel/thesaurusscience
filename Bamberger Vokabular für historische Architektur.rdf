        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_ad800342"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-09T08:31:10.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:33:43.000</terms:modified>
        <skos:definition xml:lang="de">Eine Kuppel von untergeordneter Bedeutung oder geringerer Abmessung, wie z. B. die Kuppeln über dem Querschiff einer Kreuzkuppelkirche oder die Kuppeln über dem Langhaus gegenüber der Vierungskuppel bei einer Kuppelbasilika. (Glossarium Artis)</skos:definition>
        <skos:prefLabel xml:lang="de">Nebenkuppel </skos:prefLabel>
        <skos:prefLabel xml:lang="fr">coupole secondaire</skos:prefLabel>
        <skos:prefLabel xml:lang="en">secondary dome</skos:prefLabel>
        <broaderByPosition rdf:resource="https://hist-arch-vocab.org/bvha#c_ad800342"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_5ea1071e -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_5ea1071e">
