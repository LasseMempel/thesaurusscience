        <skos:altLabel xml:lang="de">Krüppelwalm</skos:altLabel>
        <skos:definition xml:lang="de">Abgewalmte Giebelspitze, bei der der kleine Walm nicht in die Dachkonstruktion eingreift, sondern vor der Giebelfläche auskragt. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Ist der Walm auf einen deutlich kleineren Bruchteil der Dachhöhe beschränkt, wird dieser als Schopfwalm bezeichnet. [Eißing et al. 2012]</skos:definition>
        <skos:prefLabel xml:lang="de">Schopfwalm</skos:prefLabel>
        <skos:prefLabel xml:lang="es">copete del frontón</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">demi-croupe</skos:prefLabel>
        <skos:prefLabel xml:lang="en">half hip roof</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">polovalba</skos:prefLabel>
        <broaderByPosition rdf:resource="https://hist-arch-vocab.org/bvha#c_1863c0bb"/>
    </owl:NamedIndividual>
    


