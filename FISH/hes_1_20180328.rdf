		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/346" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/348">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/348</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TORAN-GUNNA</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Fosgladh ann am balla caisteil no togalaich dhìonaich eile sa bheil tuill a thilgear urchraichean tromhpa. Dh'fhaoidte gu bheil seo na chlach mhòr leatha fhèin.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">GUNLOOP</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/278" />
				<skos:scopeNote xml:lang="en">An aperture in the wall of a castle or other defended building, allowing the firing of guns and other firearms. May be fashioned from a single block of stone.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
