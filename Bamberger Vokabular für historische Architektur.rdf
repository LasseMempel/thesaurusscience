        <skos:altLabel xml:lang="de">Dorsale</skos:altLabel>
        <skos:altLabel xml:lang="fr">arrière d\&apos;autel</skos:altLabel>
        <skos:altLabel xml:lang="en">dossel</skos:altLabel>
