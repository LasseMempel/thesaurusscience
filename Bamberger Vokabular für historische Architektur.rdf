    <!-- https://hist-arch-vocab.org/bvha#c_93629af4 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_93629af4">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_bdd220af"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
