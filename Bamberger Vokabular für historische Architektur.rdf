    <!-- https://hist-arch-vocab.org/bvha#c_d10a6a5c -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_d10a6a5c">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
