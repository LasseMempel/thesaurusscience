    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_364933bc -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_364933bc">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
