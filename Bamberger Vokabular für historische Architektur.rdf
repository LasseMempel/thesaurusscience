    <!-- https://hist-arch-vocab.org/bvha#c_29a75199 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_29a75199">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_162d82c1"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_f10222e0"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-22T18:21:27.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T13:24:07.000</terms:modified>
        <skos:altLabel xml:lang="de">Kantenschlag</skos:altLabel>
        <skos:definition xml:lang="de">Beim Randschlag handelt es sich um einen ersten Arbeitsgang [bei der Herstellung von Werksteinen], bei dem die Umrandung der jeweils zu bearbeitenden Fläche eingefasst wird. [...] Der Randschlag ist ein rein technischer Vorgang, um die Kanten zu sichern, und eine plane Fläche anzulegen. [Voelkle 2016]</skos:definition>
        <skos:definition xml:lang="de">Etwa 2 cm breite, ebene Bahn, die längs der Kanten eines Werksteins angearbeitet ist und ein exaktes Versetzen der Steine ermöglicht. [Glossarium Artis, Bd. 3, Bögen und Mauerwerk]</skos:definition>
        <skos:definition xml:lang="de">Genaue Zurichtung der Kanten eines Quadersteins. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="es"> corte del borde</skos:prefLabel>
        <skos:prefLabel xml:lang="fr"> refend</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Randschlag</skos:prefLabel>
        <skos:prefLabel xml:lang="it">bordo del concio</skos:prefLabel>
        <skos:prefLabel xml:lang="en">recessed margin</skos:prefLabel>
    </owl:NamedIndividual>
    


