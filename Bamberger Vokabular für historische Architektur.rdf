        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_d50c0597"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_df7792b5"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_fc772889"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_fcdd5b59"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-12T10:46:15.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T10:21:42.000</terms:modified>
        <skos:definition xml:lang="de">Allegorie (griech. allegoria; all-egorein = etwas anderes sagen), Personifikation oder bildhafte Darstellung eines abstrakten Begriffs in erkennbarem Bezug zum Gemeinten, z. B. ein alter Mann, der sich am Feuer wärmt, für »Winter« (im Unterschied zum Symbol). Tugenden und Laster; die sieben freien Künste; die sieben Werke der Barmherzigkeit; Fürst der Welt; Musen; Ecclesia und Synagoge. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Allegorie</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_dbae983c -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_dbae983c">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f8146cf8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-03T17:26:43.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T15:22:22.000</terms:modified>
        <skos:definition xml:lang="de">Auf einem Felsen errichtete Burg, deren Räume teilweise in anstehende Felsen eingehauen sind. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Im engeren Sinn Anlagen, die nicht allein auf steil aufragenden, unzugänglichen Felsen errichtet wurden, sondern die sich vor allem dem oft zerklüfteten Baugrund geschickt anpassten und dabei in den anstehenden Fels künstlich gehauene Baubestandteile wie Kammern, Keller, Treppen und Zisternen (Wasserversorgung) mit in die Burg einbezogen. F.en, die zumeist als Gipfelburgen auf weichem Sandstein, Dolomit u. a. erbaut wurden und von den Grottenburgen (Höhlenburgen) zu unterscheiden sind, kamen bereits seit dem 11./12. Jh. vor, wurden aber auch noch im 13. Jh. angelegt. Ihr an geeigneten Baugrund gebundenes Hauptvorkommen liegt in der Pfalz (Altdahn, Drachenfels, Trifels), im Elsass (Fleckenstein, Wasigenstein), in der Schweiz (Aesch-Bärenfels, Alt-Bechburg, Pfeffingen), auf der Schwäbischen Alb (Gebrochen-Gutenstein, Unterfalkenstein) und in der Fränkischen Schweiz (Pottenstein, Waischenfeld, Waldstein). In anderen Regionen sind sie selten (Scharzfels NI, Regenstein SA, Oybin S). H. W. B. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:prefLabel xml:lang="de">Felsenburg</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_dbb1ea13 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_dbb1ea13">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f54d07cc"/>
