		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1308" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/931" />
		<skos:scopeNote xml:lang="en">A works for the production and repair of ships' rigging.</skos:scopeNote>
