    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "CURSUS"@en ;
    skos:scopeNote "A long narrow rectangular earthwork enclosure of Neolithic date, usually defined by a bank and ditch and presumed to be of ceremonial function. Known examples range in length from less than 100m to c.10km."@en .

