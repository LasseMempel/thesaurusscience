        <skos:altLabel xml:lang="it"> sporto</skos:altLabel>
        <skos:altLabel xml:lang="fr">point</skos:altLabel>
        <skos:altLabel xml:lang="es">tope</skos:altLabel>
        <skos:definition xml:lang="de">In die Öffnung eines (gotischen) Maßwerks vorspringende Spitze. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Vorspringende Spitze der Passformen des got. Maß­werks. [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Vorspringende Spitze zwischen den Passformen des gotischen Maßwerks. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Vorspringendes, meist gegengeschwungenes Element mit geradem oder auch spitzem Abschluss, das als Zierform bspw. an den Passformen eines Maßwerks, an Andreaskreuzen im Fachwerkbau oder an Deckplatten von Kapitellen auftretten kann. [BVHA]</skos:definition>
        <skos:definition xml:lang="cs">Výstupek zasahující do otvoru (gotické) kružby. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="es"> gancho</skos:prefLabel>
        <skos:prefLabel xml:lang="it"> nasello</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Nase</skos:prefLabel>
        <skos:prefLabel xml:lang="en">cusp</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kružbový nos</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">redent</skos:prefLabel>
    </owl:NamedIndividual>
    


