		<crm:P82b_end_of_the_end rdf:datatype="http://www.w3.org/TR/xmlschema11-2/#gYear">-506500000</crm:P82b_end_of_the_end>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk001498"/>
