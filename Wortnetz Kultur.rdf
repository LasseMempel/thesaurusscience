		<skos:prefLabel xml:lang="de">Kranzgesims</skos:prefLabel>
		<skos:altLabel xml:lang="de">Kranzgesimse</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003820"/>
