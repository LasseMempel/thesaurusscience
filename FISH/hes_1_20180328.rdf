		<skos:prefLabel xml:lang="gd">MUILEANN-ANAIRT</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Muileann far a bheilear a' fighe lìon-aodach de theudagan lìn.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">LINEN MILL</skos:prefLabel>
