        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-22T14:26:47.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-12-01T12:24:46.000</terms:modified>
        <skos:altLabel xml:lang="de">Kämpfer (Gewölbe)</skos:altLabel>
        <skos:altLabel xml:lang="fr">appui butée</skos:altLabel>
        <skos:altLabel xml:lang="cs">boční část tunelu</skos:altLabel>
        <skos:altLabel xml:lang="en">butment</skos:altLabel>
        <skos:altLabel xml:lang="fr">butée</skos:altLabel>
        <skos:altLabel xml:lang="cs">břehový pilíř přehrady</skos:altLabel>
        <skos:altLabel xml:lang="it">piedritto</skos:altLabel>
        <skos:altLabel xml:lang="cs">podpora</skos:altLabel>
        <skos:altLabel xml:lang="cs">podpěra</skos:altLabel>
        <skos:altLabel xml:lang="en">springing wall</skos:altLabel>
        <skos:definition xml:lang="de">Auflage eines Bogens, Brückenbogens (Landfeste) oder Gewölbes, das auf Druck und Schub beansprucht ist. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Bauglied zur Aufnahme von Druck und Schub eines Bogens oder Gewölbes. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Lagerung von Bogen, Gewölbe und Brücke(-nbogen) zur Kompensation von Druck und Seitenschub. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Uložení oblouku, klenby a mostu (mostního oblouku) sloužící ke kompenzaci svislého a šikmého tlaku. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Widerlager</skos:prefLabel>
        <skos:prefLabel xml:lang="en">abutment</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">culée</skos:prefLabel>
        <skos:prefLabel xml:lang="es">estribo</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">opěra</skos:prefLabel>
        <skos:prefLabel xml:lang="it">spalla</skos:prefLabel>
    </owl:NamedIndividual>
    


