		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-10-25T14:18:07+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk015366">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Jäger (Forstwirtschaft)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Jägersmann</skos:altLabel>
		<skos:altLabel xml:lang="de">Weidmann</skos:altLabel>
		<skos:altLabel xml:lang="de">Wildschütz</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk018273"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013526"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk018273"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk015991"/>
		<xe:explanation_temp xml:lang="de">Der Jäger richtet sich in erster Linie nach den Jagd- und Schonzeiten der dem Jagdrecht unterliegenden jagdbaren Tierarten. Ansitzjagd, Pirsch und Bewegungsjagd werden hauptsächlich auf Schalenwild ausgeübt. Jagdhunde werden für das Brackieren und die Baujagd eingesetzt. Stellt der Jäger dem Wild mit Fallen nach, so spricht man von Fangjagd. Der Einsatz von Greifvögeln zur Bejagung des Wildes wird Beizjagd genannt. Bei der Lockjagd ahmt der Jäger bestimmte Laute der Tiere nach, um sie an sich heranzulocken.</xe:explanation_temp>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300025619"/>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4162654-0"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk013526"/>
