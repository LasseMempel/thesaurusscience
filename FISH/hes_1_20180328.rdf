	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/237">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/237</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH-MALAIRT ARBHAIR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach far an robh buill-shampaill de dh'arbhar ga reic gu dìreach no air reic-tairgse eadar toiseach is meadhan na 19mh linn. Bhathar a' cleachdadh nan togalaichean seo mar thallachan poblach eadar làithean margaid nuair nach robh feum orra airson reic an arbhair.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CORN EXCHANGE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/236" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/150" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/524" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/804" />
		<skos:scopeNote xml:lang="en">A building where samples of corn were sold or auctioned during the early to mid 19th century. When not in use, between market days, the buildings were used as public halls.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/238">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/238</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH LUCHD-TÒRRAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Gnothachas adhlacair a dhèiligeas ri stiùireadh nan deas-ghnàth a tha co-cheangailte ri tìodhlacadh no losgadh cuirp.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">FUNERAL DIRECTORS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/211" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/978" />
		<skos:scopeNote xml:lang="en">The establishment of an undertaker who is responsible for the management of the ceremony connected with the burial or cremation of a dead body.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/240">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/240</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH-ÒSTA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach mòr sa bheil iomadh seòmar-cadail fa leth. Tha cuid-oidhche, biadh agus goireasan ann gan solar do chustamairean air airgead.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HOTEL</skos:prefLabel>
