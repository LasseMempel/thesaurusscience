    <!-- https://hist-arch-vocab.org/bvha#c_6de4ace6 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_6de4ace6">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f4e2bee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_19d56a39"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-18T12:36:10.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-24T11:22:13.000</terms:modified>
        <skos:altLabel xml:lang="en"> rhomboid roof</skos:altLabel>
        <skos:altLabel xml:lang="de">Rautendach</skos:altLabel>
        <skos:altLabel xml:lang="en">helm roof</skos:altLabel>
        <skos:prefLabel xml:lang="fr"> comble rhomboïdal</skos:prefLabel>
        <skos:prefLabel xml:lang="en"> lozenge roof</skos:prefLabel>
        <skos:prefLabel xml:lang="es"> techo romboidal</skos:prefLabel>
        <skos:prefLabel xml:lang="it"> tetto a falde romboidali</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Rhombendach</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">routová střecha</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Dachform, deren Dachfläche in Form von vier Rhomben (Rauten) zwischen vier Giebeln den Abschluss bildet. [Koepf/Binding 2016]</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Rautendach, aus rautenförmigen Dachseiten zusammengesetzt. [Koch 2009]</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Rhombendach, Dach auf Türmen, dessen Dachflächen ein gleichseitiges, schiefwinkliges Parallelogramm bilden. [Koepf / Binding 2016]</skos:scopeNote>
        <skos:scopeNote xml:lang="cs">Romboid, složená z kosočtvercových střešních rovin. [Koch 2008]</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Steigen über den Giebelspitzen eines Kreuzdaches Grate zu einer gemeinsamen Spitze auf, so dass sich dazwischen Rhombenflächen bilden, entsteht das Rhomben- oder Rautendach. [Eißing et al. 2012]</skos:scopeNote>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_f4e2bee8"/>
    </owl:NamedIndividual>
    


