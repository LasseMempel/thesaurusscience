        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_47db91c5"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_e4dee1e3"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-17T17:31:55.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-10T13:05:51.000</terms:modified>
        <skos:altLabel xml:lang="de">Schenkel (Fenster)</skos:altLabel>
        <skos:definition xml:lang="de">Außen umlaufende Hölzer (Leisten) eines Fenster- oder Flügelrahmens. Die senkrechten Hölzer werden Höhenschenkel, die waagerechten Ober- bzw. Unterschenkel genannt. I. d. R. werden die Fenster von innen beschrieben, dabei wird in einen rechten und einen linken Höhenschenkel unterschieden. [Noky 1996]</skos:definition>
        <skos:definition xml:lang="de">Fensterschenkel, die einzelnen Teile, aus denen der Fensterrahmen (Futter- und Flügelrahmen) zusammengesetzt ist. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Fensterschenkel</skos:prefLabel>
        <skos:prefLabel xml:lang="es">maderos del bastidor de una ventana</skos:prefLabel>
        <skos:prefLabel xml:lang="it">profili della finestra</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_d34e6534 -->


