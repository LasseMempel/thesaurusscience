    <!-- https://hist-arch-vocab.org/bvha#c_76e9238b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_76e9238b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_3893b13c"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-25T12:44:44.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-25T18:06:23.000</terms:modified>
        <skos:altLabel xml:lang="es">taracea</skos:altLabel>
        <skos:definition xml:lang="de">Fußboden, der mit Holztafeln belegt ist. Auf einem Blindboden der aus rauen Brettern besteht und auf Balken oder auf ein Fußbodenlager aufgenagelt ist (heute Estrich), wird der eigentl. P.boden verlegt, der aus Tafeln (Tafelp.) oder aus Riemen (Riemenp. oder Schiffsp.) besteht; werden nur Stäbe aneinandergefügt, spricht man von Stabfußboden, nicht von P.; nach dem Verlegen wird die Oberfläche geschliffen (abgezogen) und gewachst, heute mit Kunstharzlacken versiegelt. P. findet sich hauptsächl. in barocken Schlössern, seit dem späten 19. Jh.  auch in Bürgerwohnungen. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="es"> parquet</skos:prefLabel>
        <skos:prefLabel xml:lang="it"> parquet</skos:prefLabel>
        <skos:prefLabel xml:lang="en"> parquét</skos:prefLabel>
        <skos:prefLabel xml:lang="fr"> parquét</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Parkettboden</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">parketová podlaha</skos:prefLabel>
    </owl:NamedIndividual>
    


