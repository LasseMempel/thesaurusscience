	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/558">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/558</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CÙIRT-LIOS</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite a tha fosgailte ris na speuran, mun a bheil togalaichean ceithir timcheall air no gu ìre.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">COURTYARD</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-31T14:07:08</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/552" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502219" />
		<skos:scopeNote xml:lang="en">An uncovered area, surrounded or partially surrounded by buildings.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
