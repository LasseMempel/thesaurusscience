        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-21T15:53:11.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T11:10:46.000</terms:modified>
        <skos:definition xml:lang="de">Stirnfläche eines Querhausarms. Bei dreischiffigen Querhausanlagen werden v. a. in der frz.Gotik reiche Fassaden ausgebildet, die ähnl. der Westfassade gegliedert sind. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Querhausfront</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_df84ddba -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_df84ddba">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
