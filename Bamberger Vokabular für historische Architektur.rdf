        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-20T15:05:40.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T16:27:36.000</terms:modified>
        <skos:altLabel xml:lang="de">Ritualbuch</skos:altLabel>
        <skos:altLabel xml:lang="la">liber de ritibus ecclesiasticis</skos:altLabel>
        <skos:altLabel xml:lang="la">liber ritualis</skos:altLabel>
        <skos:definition xml:lang="de">Buch, liturgisches n, auch Ritualbuch n, liber de divinis officiis, liber de ritibus ecclesiasticis, liber ritualis: Buch mit den Lesungen, Gebeten, Gesängen und rituellen Anweisungen für den Gottesdienst; oft reich illuminiert und mit kostbarem Bucheinband versehen. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="la">liber de divinis officiis</skos:prefLabel>
        <skos:prefLabel xml:lang="en">liturgical book</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">liturgická kniha</skos:prefLabel>
        <skos:prefLabel xml:lang="de">liturgisches Buch</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">livre liturgique</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_3c003cd1 -->


