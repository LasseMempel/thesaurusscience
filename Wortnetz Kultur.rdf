		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk017567"/>
		<skos:definition xml:lang="de">Die Trauer ist ein Gefühl, das durch Verlust von Lebewesen oder Dingen, zu denen eine persönliche Bindung bestand, entsteht oder auch infolge eines Unglücks, das die jeweilige Person betrifft, hervorgerufen wird.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4060742-2"/>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300055162"/>
