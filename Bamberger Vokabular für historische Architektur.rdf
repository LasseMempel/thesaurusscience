    <!-- https://hist-arch-vocab.org/bvha#c_b8c8f8bb -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b8c8f8bb">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_c495fe17"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-11-05T10:32:35.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-11-05T10:41:42.000</terms:modified>
        <skos:definition xml:lang="de">In einigem Abstand unter der Firstpfette angeordnetes Längsholz, das durch Windstreben mit der Spitzsäule verbunden ist. Das über die Giebelwand vorstehende Kopfstück wurde im Salzburger Land und in Bayern oft mit einem Katzenkopf geziert, davon leiten sich auch Bezeichnungen wie Katzenbaum, Katzenpfette oder Katzenbalken ab. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Unterfirstpfette</skos:prefLabel>
        <skos:prefLabel xml:lang="en">beam running below the ridge</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">sous-faîte</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_b8d6a0c3 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b8d6a0c3">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_8b0a1aab"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b2356bd0"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c7b144d0"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-23T08:09:26.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-08T17:20:48.000</terms:modified>
        <skos:definition xml:lang="de">Deckleiste, Fugenleiste, flache, meist hölzerne Leiste zur Überdeckung der Anschlussfuge zweier Bauteile oder Bauelemente verschiedenen Materials. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Eine Leiste in einfacher oder profilierter Form zum Abdecken vom Zwischenraum zweier angrenzender Bauteile, z.B. zwischen Fensterrahmen und Wand in Form einer Bekleidung. [Pax - Fenster &amp; Türen Fachbegriffe]</skos:definition>
        <skos:prefLabel xml:lang="de">Deckleiste</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_b8d96614 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b8d96614">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b5206255"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-19T08:22:56.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T12:32:24.000</terms:modified>
        <skos:definition xml:lang="de">Beichtkapelle, anfangs Beichtkammer oder Beichtzelle, kleiner Nebenraum an einer Kirche zumeist hinter dem Hauptaltar, der vor der Einführung der dreiteiligen Gehäuse-Beichtstühle nach dem Konzil von Trient 1563 zum Beichten diente, bes. in Südeuropa verbreitet. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Beichtkapelle</skos:prefLabel>
        <skos:prefLabel xml:lang="es">capilla para la confesión </skos:prefLabel>
        <skos:prefLabel xml:lang="it">cappella confessionale</skos:prefLabel>
        <skos:prefLabel xml:lang="en">chapel for confession</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">chapelle de la pénitence</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_b5206255"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_b8d9d8ae -->


