    skos:prefLabel "COLUMBARIUM"@en ;
    skos:scopeNote "A wall with niches in a CREMATORIUM to display the urns containing ashes. Use only when related to funerary site."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70079> a skos:Concept ;
