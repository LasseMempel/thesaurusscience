<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/35> a skos:Concept ;
    skos:exactMatch <https://vocabs.dariah.eu/bbt/Concept/000026> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Roles of interpersonal relations"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2607> ;
    skos:scopeNote "This term classifies attitudes and/ or behaviors that characterize the interpersonal relations of people who are linked through kinship, marriage or adoption. It also comprises the types of attitudes and/ or behaviors of people linked through religious, spiritual, friendly, rivalrous and/ or antagonistic relations."@en ;
    skos:topConceptOf <https://humanitiesthesaurus.academyofathens.gr> .

