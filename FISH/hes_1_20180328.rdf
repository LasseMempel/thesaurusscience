		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1409">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1409</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">DÙN BALAIST</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Torr air an deach balaist a thilgeil o shoithichean mharsantan mus deach carago a luchdadh orra. Gheibhear iad seo ann an inbhirean faisg air calaidhean mar is trice.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BALLAST MOUND</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-08-31T07:10:50</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1382" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1390" />
		<skos:scopeNote xml:lang="en">A spoil tip of dumped ballast, deposited from merchant vessels prior to loading cargo, and usually found in estuarine contexts near harbours.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1420">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
