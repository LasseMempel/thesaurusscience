	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk019087">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Linsenboden</skos:prefLabel>
		<skos:altLabel xml:lang="de">Linsenböden</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk018464"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk012084"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk018464"/>
		<skos:definition xml:lang="de">Ein Linsenboden ist ein Gefäßboden, der am Übergang zur Wandung abgerundet oder geknickt erscheint. Im Unterschied zum Kugelboden ist er weniger gerundet und nicht durch Druck geformt sondern durch Beschneiden.</skos:definition>
