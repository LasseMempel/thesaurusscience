  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93750">
    <skos:scopeNote xml:lang="en">A pit or tank where the chemicals used in tanning are washed from the animal hides.</skos:scopeNote>
  </rdf:Description>
