		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/504282" />
		<skos:scopeNote xml:lang="en">A vessel, usually made of stone, which contains the consecrated water for baptism. Use a broader monument type if possible.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
