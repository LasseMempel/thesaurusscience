        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_0963b01a"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_c4c56103"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-05T12:17:34.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T18:01:15.000</terms:modified>
        <skos:definition xml:lang="de">Ponderation (lat.), bei Statuen die ausgeglichene Verteilung des Körpergewichts auf die Beine. Sonderformen: Kontrapost; Gotischer Schwung. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">U soch vyvážené rozdělení váhy těla na nohy, zvláštní typy: kontrapost, gotické zakřivení. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Ponderation</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">ponderace</skos:prefLabel>
    </owl:NamedIndividual>
    


