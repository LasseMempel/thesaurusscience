    skos:exactMatch <http://eurovoc.europa.eu/1229> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Elemente der Gruppe VII"@de,
        "element of group VII"@en .

