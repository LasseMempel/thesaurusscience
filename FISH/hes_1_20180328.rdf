		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1082" />
		<skos:scopeNote xml:lang="en">A factory used for the production of red lead used in glass manufacture, or white lead used as the pigment in white paint.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1084">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1084</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">DÙN-SGUDAIL LEAGHADAIREAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Torr cartaidh sa bheil, gu sònraichte, treamsgal agus pìosan de sgudal a dh'èirich an cois leaghadh meatailte à clach-mhèinnir.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SLAG HEAP</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
