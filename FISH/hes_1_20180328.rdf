		<skos:prefLabel xml:lang="gd">PÒLA TELEAGRAF</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Crann àrd fiodha a chumas an àirde uèirichean teileagraif.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TELEGRAPH POLE</skos:prefLabel>
