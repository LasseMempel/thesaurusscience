        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-11-07T12:55:34.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T20:00:14.000</terms:modified>
        <skos:altLabel xml:lang="de">Feuchtezone</skos:altLabel>
        <skos:altLabel xml:lang="en">moist spot</skos:altLabel>
        <skos:altLabel xml:lang="en">moist zone</skos:altLabel>
        <skos:altLabel xml:lang="cs">oblasti s viditelnou vlhkostí</skos:altLabel>
        <skos:altLabel xml:lang="de">sichtbare Durchfeuchtung</skos:altLabel>
        <skos:altLabel xml:lang="fr">tache d’humidité</skos:altLabel>
        <skos:altLabel xml:lang="en">visible damp area</skos:altLabel>
        <skos:altLabel xml:lang="de">vlhké zóny</skos:altLabel>
        <skos:altLabel xml:lang="fr">zone humide visible</skos:altLabel>
        <skos:definition xml:lang="en">Corresponds to the darkening (lower hue) of asurface due to dampness. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="de">Feuchtebereich bezieht sich auf die Dunklung (geringere Farbhelligkeit) der Oberfläche durch Feuchtigkeit. [ICOMOS-ISCS] </skos:definition>
        <skos:definition xml:lang="cs">Koresponduje se ztmavnutím (nižší barevnýodstín) povrchu v důsledku zvlhnutí. [ICOMOS-ISCS] </skos:definition>
        <skos:definition xml:lang="fr">Un assombrissement du à l’humidité est considérée comme une altération chromatique (baisse de saturation). [ICOMOS-ISCS]</skos:definition>
        <skos:prefLabel xml:lang="de">Feuchtebereich</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">assombrissement du à l’humidité</skos:prefLabel>
        <skos:prefLabel xml:lang="en">moist area</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">vlhká oblast</skos:prefLabel>
    </owl:NamedIndividual>
    


