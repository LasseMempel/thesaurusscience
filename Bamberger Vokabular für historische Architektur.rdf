        <skos:altLabel xml:lang="de">Pönitenzkreuz</skos:altLabel>
        <skos:definition xml:lang="de">Bußkreuz n; auch Pönitenzkreuz n: ein dem religiösen Brauchtum angehörendes Prozessionskreuz, an dem die Passionswerkzeuge Christi befestigt sind, z. B. Schwamm, Martersäule, Dornenkrone, Leiter, Tunika und Würfel. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Bußkreuz</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">croix de pénitence</skos:prefLabel>
        <skos:prefLabel xml:lang="en">penitential cross</skos:prefLabel>
    </owl:NamedIndividual>
    


