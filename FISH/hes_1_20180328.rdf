		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/536" />
		<skos:scopeNote xml:lang="en">A model village, built to provide accommodation for workers in a specific coal mine.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
