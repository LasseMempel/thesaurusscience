	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/919">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/919</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">MUILEANN-CÀRDAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Ceàrdach far a bheilear a' snìomh snàth airson luchd-nam beart-bheag air einnseanan-làimhe càrdaidh is air Jenny làimhe.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CARDING MILL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/917" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1285" />
		<skos:scopeNote xml:lang="en">A workshop where hand-operated carding engines and hand jennies are used to spin yarn for handloom weavers.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/920">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/920</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">MUILEANN-COTAIN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Mar is trice factaraidh snìomha ged a tha cuid a mhuileannan ann ris a bheil taighean-beairt ri cuid dhiubh agus mas ann mar sin a tha e, 's e aodach ullamh am bathar deireannach 's chan e snàth a-mhàin.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">COTTON MILL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1291" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/917" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1293">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1293</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">MUILEANN-CAILLEAGO</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Muileann-aodaich a nì cailleago, cotan garbh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">CALICO MILL</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/920" />
				<skos:scopeNote xml:lang="en">A textile mill producing calico, coarse cotton.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:scopeNote xml:lang="en">Usually a cotton spinning factory, although some mills have weaving sheds attached, in which case the end product is completed cloth, not yarn only.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/921">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/921</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BÙTH SGUIDSEADH LÌN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach far an robhar ag ullachadh lìon, le bhith a' sgaradh teudagan-stapaill goirid is fada ann an cìrean. Faodaidh bùithtean sguidseadh lìn no seiclidh a bhith an dà chuir air làrach muilinn no far na làraich.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">FLAX DRESSING SHOP</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">HACKLING HOUSE</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1296" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/917" />
		<skos:scopeNote xml:lang="en">A building used for the preparatory processes in which long and short staple flax fibres were separated by passing through combs. Flaxdressing or 'heckling' shops may be located both on and off mill sites.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/922">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/922</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">MUILEANN-LÌN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Muileann far a bheilear a' giullachd lìon gus lìon-aodach is snàth a dhèanamh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">FLAX MILL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">FLAX SPINNING WORKS</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/917" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1296" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1299" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1320" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501691" />
		<skos:scopeNote xml:lang="en">A mill where flax is processed to make linen, thread and yarn.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
