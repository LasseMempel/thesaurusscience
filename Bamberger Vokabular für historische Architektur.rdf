    <!-- https://hist-arch-vocab.org/bvha#c_05127c72 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_05127c72">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_4880e8cc"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_15f1e180"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-21T11:52:25.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T16:22:24.000</terms:modified>
        <skos:altLabel xml:lang="cs">chór</skos:altLabel>
        <skos:altLabel xml:lang="es">santuario</skos:altLabel>
        <skos:altLabel xml:lang="it">santuario</skos:altLabel>
        <skos:altLabel xml:lang="cs">svatostánek</skos:altLabel>
        <skos:definition xml:lang="de"> Der Raum mit dem Heiligtum, bei christl. Kirchen der Chor mit dem Hochaltar, aber auch der ganze der Messhandlung vorbehaltene Raum, der mittels Schranken, Gitter oder eines Lettners vom Laienraum abgetrennt ist, also Chor, Querhaus mit Vierung und auch vereinzelt das erste Langhausjoch. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Sanktuarium</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kněžiště</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">sanctuaire</skos:prefLabel>
        <skos:prefLabel xml:lang="en">sanctuary</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_0515f73a -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_0515f73a">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0e469ac8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-22T10:31:03.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-21T16:13:18.000</terms:modified>
        <skos:altLabel xml:lang="en">Serlian motif</skos:altLabel>
        <skos:altLabel xml:lang="de">Serliana</skos:altLabel>
        <skos:altLabel xml:lang="en">Serliana</skos:altLabel>
        <skos:altLabel xml:lang="en">Venetian motif</skos:altLabel>
        <skos:altLabel xml:lang="fr">baie à la Serlio</skos:altLabel>
        <skos:altLabel xml:lang="fr">baie à rythme ternaire</skos:altLabel>
        <skos:altLabel xml:lang="cs">benátské okno</skos:altLabel>
        <skos:altLabel xml:lang="cs">serliana</skos:altLabel>
        <skos:definition xml:lang="de">Auch Venezianisches Fenster, in England - weil auf Serlios »Architettura« zurückgehend - Serliomotiv oder Serliana genannte Wandöffnung, bei der eine auf Säulen oder Pfeilern stehende Bogenöffnung von 2 schmalrechteckigen Öffnungen flankiert wird, deren Gebälk in Höhe des Bogenkämpfers verläuft. Von Palladio und seinen Nachfolgern oft verwendet. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Bereits von Serlio entwickelte und von Palladio (Basilika in Vicenza) weiterentwickelte Komposition in der Spätrenaissance: Verbindung eines mittleren, breiteren Bogens mit zwei schmaleren Seitenöffnungen, die von einem Gebälk in Höhe des Bogenkämpfers abgeschlossen sind. [Koepf/Binding 2016] </skos:definition>
        <skos:definition xml:lang="cs">PALLADIOVSKÝ MOTIV, též benátské okno, v Anglii - jelikož vycházel ze Serliova díla &quot;Architettura&quot; - též nazývaný serliovský motiv nebo &quot;serliana&quot;; obloukový otvor ve stěně spočívající na sloupech nebo pilířích, který má po stranách 2 úzké obdélníkové otvory, jejichž kladí probíhá ve výši patky oblouku. Tento motiv často používal Palladio a jeho následovníci. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Von Sebastiano Serlio (1475-1554) entwickelte und von Andrea Palladio (1505-1580) weiter ausgestaltete Form der Wand- oder Fenstergliederung, bei der ein mittlerer, breiterer Bogen von zwei schmaleren Öffnungen flankiert wird, die von einem Gebälk (Architrav) in Höhe des Kämpfers überdeckt sind. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="en">Palladian motif</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Palladio-Motiv</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">baie palladienne</skos:prefLabel>
        <skos:prefLabel xml:lang="es">composición desarrollada por Serlio y Palladio</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">palladiovský motiv</skos:prefLabel>
        <skos:prefLabel xml:lang="it">serliana</skos:prefLabel>
    </owl:NamedIndividual>
    


