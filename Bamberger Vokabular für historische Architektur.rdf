        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-30T21:20:38.000</terms:modified>
        <skos:definition xml:lang="de">Decke, in Felder eingeteilte Deckengestaltung eines Raumes, die durch profilierte Stege voneinander getrennt sind und durch Füllungen geschlossen werden. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:prefLabel xml:lang="de">Kassettendecke</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kazetový strop</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_ce0ef4f6 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_ce0ef4f6">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_049c4c22"/>
