		<skos:altLabel xml:lang="de">Erdmittelzeit</skos:altLabel>
		<skos:altLabel xml:lang="en">Mesozoic</skos:altLabel>
		<skos:prefLabel xml:lang="en">Mesozoic Era</skos:prefLabel>
