    skos:prefLabel "Kanalisierung"@de,
        "channelling"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/7244> ;
    skos:relatedMatch <http://dbpedia.org/resource/Channeling> .

<http://www.eionet.europa.eu/gemet/concept/12893> a skos:Concept ;
