        <skos:scopeNote xml:lang="cs">Tyto výstupky, stejně jako bočnice, uzavírající zboku řady sedadel, bývaly zdobeny drsně světskými výjevy zvanými drolerie. [Koch 2008]</skos:scopeNote>
    </owl:NamedIndividual>
    


