		<skos:prefLabel xml:lang="gd">GRUNND SÌOLAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Tanca no linn sa bheil breath gainmhich no rud mar sin airson tòrr mòr uisge a shìoladh.</skos:scopeNote>
