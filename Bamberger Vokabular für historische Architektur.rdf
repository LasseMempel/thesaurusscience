        <skos:altLabel xml:lang="de">Stufenbogen</skos:altLabel>
        <skos:definition xml:lang="de">Einem Staffelgiebel ähnelnde Überdeckung einer Öffnung, vergleichbar dem Kragbogen, jedoch von bewusst erstrebter künstlerischer Form. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Treppenbogen</skos:prefLabel>
