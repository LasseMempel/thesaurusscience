	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1951">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1951</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">STRUCTAR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Rud a chaidh a thogail ach aig nach eil feum soilleir, co-dhiù an-diugh no a-rèir fianais àrc-eòlaich. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">STRUCTURE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
