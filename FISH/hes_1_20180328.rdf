				<skos:prefLabel xml:lang="gd">STRUCTAR DÌON TRÀGHAD</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Structar a tha a' dol a-steach dhan mhuir gus casg a chur air sìor-ghluasad gainmhich no moil a chaidh fhàgail ann leis a' mhuir.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">GROYNE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-27T16:04:46</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-27T16:05:09</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1431" />
				<skos:scopeNote xml:lang="en">A structure extending into the sea for the purpose of preventing further movement of washed up sand and shingle.</skos:scopeNote>
