		<skos:prefLabel xml:lang="en">cast iron</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Gusseisen</skos:prefLabel>
		<skos:prefLabel xml:lang="de-1901">Gußeisen</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk005807"/>
