				<skos:prefLabel xml:lang="gd">TALLA NAN SAOR-CHLACHAIREAN</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Àite-coinneachaidh airson saor-chlachairean.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">MASONIC HALL</skos:prefLabel>
