        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-04T14:15:14.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T22:47:11.000</terms:modified>
        <skos:altLabel xml:lang="de">Lichtkrone</skos:altLabel>
        <skos:altLabel xml:lang="de">Radkrone</skos:altLabel>
        <skos:altLabel xml:lang="de">Reifenkrone</skos:altLabel>
        <skos:altLabel xml:lang="la">corona</skos:altLabel>
        <skos:altLabel xml:lang="fr">couronne ardente</skos:altLabel>
        <skos:definition xml:lang="de">Radleuchter m; Reifenkrone f; auch Radkrone f; Lichtkrone f; lat. rota; corona: ein kreisförmiger Hängeleuchter, Vorläufer des KronIeuchters. Er war meist aus Bronze, seltener aus vergoldetem Kupfer gefertigt und mit Zinnen, Türmen und Toren verziert. Er sollte die Heilige Stadt symbolisieren (Apk 21, 10-21) und wurde deshalb auch Himmlisches Jerusalem (n) genannt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Radleuchter</skos:prefLabel>
        <skos:prefLabel xml:lang="en">corona</skos:prefLabel>
        <skos:prefLabel xml:lang="la">rota</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">roue de lumière</skos:prefLabel>
    </owl:NamedIndividual>
    


