	<dct:spatial rdf:resource="http://dbpedia.org/resource/Scotland"/>
	<dct:spatial rdf:resource="http://vocab.getty.edu/tgn/7002444"/>
	<skos:altLabel xml:lang="en">Pre-Clearance</skos:altLabel>
	<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/PM"/>
	<skos:editorialNote xml:lang="en">We use pre-improvement in a rural context but could be applied to urban environment as well</skos:editorialNote>
	<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/scapa"/>
	<skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PIMP</skos:notation>
	<skos:prefLabel xml:lang="en">Pre-Improvement</skos:prefLabel>
	<skos:prefLabel xml:lang="gd">(todo)</skos:prefLabel>
	<skos:scopeNote xml:lang="en">In Archaeology, largely applied to traces of the rural settlement and landscape documented or surviving the sweeping agricultural changes of the Age of Improvement.</skos:scopeNote>
</rdf:Description>

