        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-04T13:02:38.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T14:09:58.000</terms:modified>
        <skos:altLabel xml:lang="de">inonisches Kymation</skos:altLabel>
        <skos:definition xml:lang="cs">Dekorativní motiv vejčitého tvaru. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Konvexe Zierleiste aus wechselnd senkrecht stehenden, eiförmigen und pfeilspitzartigen Gebilden, unten und auch oben von einer Perlschnur (Astragal) abgeschlossen, in der röm. Architektur und in der Renaissance bevorzugtes Schmuckglied (Kyma). [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Eierstab</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">vejcovec</skos:prefLabel>
    </owl:NamedIndividual>
    


