    <!-- https://hist-arch-vocab.org/bvha#c_2b91385d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_2b91385d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a9967019"/>
