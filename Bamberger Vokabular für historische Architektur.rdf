    <!-- https://hist-arch-vocab.org/bvha#c_c0557847 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_c0557847">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0dc5882f"/>
