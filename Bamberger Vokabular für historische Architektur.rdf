        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-24T15:59:32.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T13:15:58.000</terms:modified>
        <skos:definition xml:lang="de">(Offener) Gartensaal eines Schlosses. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">(Otevřený) zahradní sál zámku. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Sala terrena (ital.), Gartensaal im Erdgeschoss eines Schlosses oder Palastes, meist im Mittelrisalit unter dem Hauptsaal als Übergang zum Park angeordnet. Die S.t. war urspr. offen und auch als Grotte ausgestaltet. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Sala terrena f (ital., ›ebenerdiger Saal‹), zum Garten hin offener und manchmal als Grotte (Schloss Weißenstein / Pommersfelden BY) ausgebildeter Saal im barocken Schloss. Sie ist entweder unter dem Hauptsaal des Schlosses (Waldsteinpalais/Prag CZ) oder als Vorhalle zur Haupttreppe angelegt (Oberes Belvedere / Wien). B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:prefLabel xml:lang="de">Sala terrena</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">sala terrena</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_e329150d"/>
    </owl:NamedIndividual>
    


