        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a9967019"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_19d56a39"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-23T12:22:43.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T11:46:16.000</terms:modified>
        <skos:altLabel xml:lang="cs">tažná vzpěra</skos:altLabel>
        <skos:definition xml:lang="de">Auf Zug belastetes schräg verlaufendes Holz, häufig bei Vordächern und weit auskragenden Walmen eingesetzt; als Zugstiel vertikal verbaut. [Eißing et al. 2012]</skos:definition>
        <skos:prefLabel xml:lang="de">Zugstrebe</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">táhlo</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_9e3fea21 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_9e3fea21">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_d2c7cee1"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_9fcb19ed"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_808d370a"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_aa4112f7"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_adf814f2"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-02T12:55:45.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-31T00:00:40.000</terms:modified>
        <skos:prefLabel xml:lang="de">kleinformatiges Retabel</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Kleinformatige Retabel liegen in ihren Höhen- und Breitenmaßen unter den Standardmaßen des großformatigen Brabanter Retabels (Höhe 220cm, Breite 185cm) und zeichnen sich durch eine reduzierte Ikonographie aus. Die Definition bezieht sich vor allem auf den südniederländischen Raum. [Gliesmann 2011]</skos:scopeNote>
    </owl:NamedIndividual>
    


