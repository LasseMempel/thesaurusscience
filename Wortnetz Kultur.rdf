		<skos:altLabel xml:lang="de">Menagen (Behältersets)</skos:altLabel>
		<skos:altLabel xml:lang="de">Plattmenage</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk008305"/>
