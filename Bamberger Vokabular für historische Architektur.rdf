    <!-- https://hist-arch-vocab.org/bvha#c_30dfd42a -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_30dfd42a">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f651ce64"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_4c8229cd"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_76777dff"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_7bf74d65"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_90d527bd"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_a0a031c3"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_b2698f75"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-23T16:22:21.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T11:04:01.000</terms:modified>
        <skos:altLabel xml:lang="fr">lobe lancéolé</skos:altLabel>
        <skos:altLabel xml:lang="fr">pétale lancéolée</skos:altLabel>
        <skos:definition xml:lang="de">1. im Holzbau der Ausschnitt in zwei Balken oder Sparren zum Zweck ihrer Überkreuzung, Verlängerung oder Eckverbindung in derselben Ebene; der sich ergänzende Einschnitt des einen Holzes, der das Blatt des anderen aufnimmt, wird Blattsasse genannt (An-, Ver-, überblattung, Holzverbindung). 2. Beim got. Maßwerk spitzbogig abgeschlossenes Element, das hauptsächl. in krummlinig begrenzte (sphär.) Dreiecke oder Quadrate eingesetzt ist (Dreib., Vierb. u. dergl.). [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Do kruhu nebo zakřiveného troj-, čtyř- nebo mnohoúhelníka zasazený prvek gotické kružby ze 3 nebo více hrotitých tvarů mezi výstupky. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">In einen Kreis oder ein krummlinig begrenztes Drei-, Vier- oder Vieleck eingesetztes Element des gotischen Maßwerks aus 3 oder mehr Ogiv-Formen zwischen Nasen. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Maßwerkfigur, die einem stilisierten, spitzbogig geformten Blatt ähnelt und vor allem in krummlinig begrenzte Dreiecke oder Quadrate eingesetzt ist. Je nach Anzahl der Blattformen unterscheidet man Dreiblatt, Vierblatt, Fünfblatt etc. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Blatt</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">feuille lancéolée</skos:prefLabel>
        <skos:prefLabel xml:lang="it">foglia</skos:prefLabel>
        <skos:prefLabel xml:lang="en">leaf</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">list</skos:prefLabel>
        <skos:prefLabel xml:lang="es">tracería lanceolada</skos:prefLabel>
    </owl:NamedIndividual>
    


