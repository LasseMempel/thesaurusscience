	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk001945">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">canon (religious order)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Kanonikerkongregation</skos:altLabel>
		<skos:prefLabel xml:lang="de">Kanonikerorden</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003837"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk003839"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk005752"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019759"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk003837"/>
		<skos:definition xml:lang="de">Ein Kanonikerorden ist ein christlicher Orden, der aus Klerikern aller Weihestufen besteht, die in Gemeinschaft eines Domkapitels oder eines Stiftskapitels zusammenleben.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003837"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk005752"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003839"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019759"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk001898"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk001948"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk001981"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002050"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002051"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-11-08T16:50:33+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk001946">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Benediktiner (Orden)</skos:altLabel>
		<skos:prefLabel xml:lang="de">Benediktinerorden</skos:prefLabel>
		<skos:altLabel xml:lang="de">Orden der Benediktiner</skos:altLabel>
		<skos:prefLabel xml:lang="en">Order of Saint Benedict</skos:prefLabel>
		<skos:altLabel xml:lang="de">Ordo Sancti Benedicti</skos:altLabel>
		<skos:altLabel xml:lang="de">OSB</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk001944"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010288"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013677"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019845"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk020384"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk001944"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk002042"/>
		<xe:explanation_temp xml:lang="de">Der Orden wurde zu Beginn des 6. Jahrhunderts von Benedikt von Nursia mit eigener Ordensregel (Regula Benedicti) gegründet.</xe:explanation_temp>
		<skos:definition xml:lang="de">Der Benediktinerorden ist ein Monastischer Orden der römisch-katholischen Kirche (auch der anglikanischen Kirche und vereinzelt der evangelisch-lutherischen Kirche), dem ausschließlich männliche Mitglieder angehören.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk001944"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010288"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk013677"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019845"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk020384"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-05-12T15:53:44+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk001947">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">Carthusian Order</skos:prefLabel>
		<skos:altLabel xml:lang="de">Kartäuser (Orden)</skos:altLabel>
		<skos:prefLabel xml:lang="de">Kartäuserorden</skos:prefLabel>
		<skos:altLabel xml:lang="de">OCart</skos:altLabel>
		<skos:altLabel xml:lang="de">Orden der Kartäuser</skos:altLabel>
		<skos:altLabel xml:lang="en">Order of Saint Bruno</skos:altLabel>
		<skos:altLabel xml:lang="de">Ordo Cartusiensis</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk001944"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010288"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019845"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk020384"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk001944"/>
		<xe:explanation_temp xml:lang="de">Er wurde um 1100 durch den Heiligen Bruno von Köln bei La Chartreuse (bei Grenoble, Frankreich) gegründet.</xe:explanation_temp>
		<skos:definition xml:lang="de">Der Kartäuserorden ist ein monastischer Orden, der der römisch-katholischen Kirche zugehört und dem ausschließlich männliche Mitglieder angehören.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk001944"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010288"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019845"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk020384"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
