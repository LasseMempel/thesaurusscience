	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk018659">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">object genre (object classification)</skos:prefLabel>
		<skos:altLabel xml:lang="en">object genres (object classifications)</skos:altLabel>
		<skos:prefLabel xml:lang="de">Objektgattung (Objektklassifikation)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Objektgattungen (Objektklassifikationen)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000228"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000228"/>
		<skos:definition xml:lang="de">Eine Objektgattung ist eine sehr allgemeine, übergeordnete Objektklassifikation, mit der Objekte anhand gemeinsamer grundlegender Eigenschaften klassifiziert werden, unabhängig von ihrem spezifischen Typ oder Kontext. Objektgattungen dienen dazu, materielle Dinge nach Kriterien wie Form, Funktion, Material, Herkunft oder kultureller Bewertung zu gruppieren und können kontextübergreifend auf verschiedene Objektarten angewendet werden. So können unter einer Objektgattung beispielsweise sowohl Kunstwerke als auch Alltagsgegenstände oder Fragmente zusammengefasst werden, je nachdem, welche Eigenschaft im jeweiligen Zusammenhang im Vordergrund steht.</skos:definition>
		<skos:mappingRelation rdf:resource="http://vocab.getty.edu/aat/300185712"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000228"/>
