	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/115">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/115</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">COILLTEACH AIR A MANAIDSEADH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Fearann coillteach fo stiùireadh far a bheilear a' fàs fiodh a thèid a chleachdadh ann an diofar dòighean.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MANAGED WOODLAND</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-31T14:58:55</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/118" />
