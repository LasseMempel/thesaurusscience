	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk012714">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">jam</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Konfitüre</skos:prefLabel>
		<skos:altLabel xml:lang="de">Konfitüren</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk009645"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk014976"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk018431"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk009645"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk014976"/>
		<xe:explanation_temp xml:lang="de">Streichfähige Zubereitungen aus frischen Früchten oder Fruchtpulpen mit Zucker, Pektinen, Wein, Milch- oder Citronensäure. Sie können Obststücke aus einer Fruchtsorte oder verschiedenen Fruchtsorten enthalten außer Citrusfrüchten, da diese dann, rechtlich gesehen, als Marmeladen bezeichnet werden.
Es wird unterschieden zwischen Konfitüre &amp;quot;extra&amp;quot; mit einem Fruchtanteil je 100g von mindestens 45g und einem Gesamtzuckergehalt von mindestens 60% und Konfitüre &amp;quot;einfach&amp;quot; mit einem Fruchtgehalt je 100g von 35g und einem Gesamtzuckergehalt von mindestens 50%.</xe:explanation_temp>
		<skos:definition xml:lang="de">Konfitüre ist Süßware, die als streichfähige Zubereitung aus frischen Früchten oder Fruchtstücken mit Zucker und Geliermittel besteht. Konfitüre können Fruchtstücke aus nur einer Fruchtsorte oder verschiedenen Fruchtsorten, nicht aber aus Zitrusfrüchten, enthalten.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4123548-4"/>
		<skos:closeMatch rdf:resource="http://zbw.eu/stw/descriptor/14946-5"/>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300389828"/>
		<skos:closeMatch rdf:resource="http://id.loc.gov/authorities/subjects/sh85069302"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk018431"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk014976"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk009645"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk015045"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk015183"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk015221"/>
		<xe:status>approved</xe:status>
		<iso-thes:status>Approved</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
