		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1200" />
		<skos:scopeNote xml:lang="en">A spoil heap located adjacent to a shale-oil mine and oil works, consisting of waste produced from the retorts in which mined shale was roasted to produce a range of oil products, such as paraffin and wax.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
