        <skos:altLabel xml:lang="fr"> gypse en fer de lance</skos:altLabel>
        <skos:altLabel xml:lang="es"> mica</skos:altLabel>
        <skos:altLabel xml:lang="de">Jungfernglas</skos:altLabel>
        <skos:altLabel xml:lang="de">Marienglas</skos:altLabel>
        <skos:altLabel xml:lang="es">espejuelo</skos:altLabel>
        <skos:altLabel xml:lang="en">selenite</skos:altLabel>
        <skos:altLabel xml:lang="it">selenite</skos:altLabel>
        <skos:definition xml:lang="de">Durch Zerspaltung von tafelförmigem Gips entstandenes perlmuttglänzendes und durchscheinendes Material, das vor der Erfindung von Glas häufig als Fensterverschluss, ähnlich wie Glimmer oder Pergament, eingesetzt wurde. [Schrader / Voigt 2003]</skos:definition>
        <skos:prefLabel xml:lang="fr"> gypse cristallin</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Alabaster</skos:prefLabel>
        <skos:prefLabel xml:lang="en">mica</skos:prefLabel>
        <skos:prefLabel xml:lang="it">mica</skos:prefLabel>
        <skos:prefLabel xml:lang="es">yeso cristalino</skos:prefLabel>
    </owl:NamedIndividual>
    


