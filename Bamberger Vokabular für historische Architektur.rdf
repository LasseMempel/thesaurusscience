        <skos:altLabel xml:lang="de">Verklauung</skos:altLabel>
        <skos:altLabel xml:lang="fr">assemblage à panne et entaille</skos:altLabel>
        <skos:definition xml:lang="de">Die Klaue (Aufklauung) ist ein winkliger Einschnitt in das Stirnholz eines Schräganschlusses und wird auf zwei Längsflächen des Gegenholzes ohne entsprechende Aussparungen aufgesetzt. Der Einschnitt kann rechtwinklig oder schräg zur Stirn erfolgen.  (Eißing et al. 2012)</skos:definition>
        <skos:definition xml:lang="de">Holzverbindung mit einer Klaue. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Aufklauung</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">chevronnage</skos:prefLabel>
        <skos:prefLabel xml:lang="es">trabazón con garra</skos:prefLabel>
        <broaderByConstruction rdf:resource="https://hist-arch-vocab.org/bvha#c_88b4f652"/>
    </owl:NamedIndividual>
    


