        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T13:42:18.000</terms:modified>
        <skos:definition xml:lang="de">Verzierung von Wänden und Decken in meist ornamentaler, aber auch figürl. Stuckatur. Einen Höhepunkt erreichte die S. in der Zeit des Barock und Rokoko, wobei verschiedene Dekorationsformen wie Bandelwerk, Blattstab, Akanthusranken und Rocaille entwickelt wurden. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Stuckdekoration</skos:prefLabel>
        <skos:prefLabel xml:lang="es">decoración en estuco</skos:prefLabel>
        <skos:prefLabel xml:lang="it">decorazione a stucco</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">décoration en stuc</skos:prefLabel>
        <skos:prefLabel xml:lang="en">stucco decoration</skos:prefLabel>
    </owl:NamedIndividual>
    


