	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk003350">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Hebetür</skos:prefLabel>
		<skos:altLabel xml:lang="de">Hebetüren</skos:altLabel>
		<skos:prefLabel xml:lang="en">lift gate</skos:prefLabel>
		<skos:altLabel xml:lang="en">lifting door</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000113"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk006054"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk014399"/>
		<xe:explanation_temp xml:lang="de">Dadurch kann die Hebetür auf einer höheren Schwelle sitzen, die Zugluft verhindert. Hebetüren werden daher vor allem in Wohnräumen als Zugang zu Balkonen und Terrassen verwendet.</xe:explanation_temp>
		<skos:definition xml:lang="de">Eine Hebetür ist eine Tür, die zum Öffnen zunächst angehoben werden muss.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk006054"/>
