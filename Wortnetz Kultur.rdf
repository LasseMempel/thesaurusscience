	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk018045">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Genisa</skos:prefLabel>
		<skos:altLabel xml:lang="de">Genisas</skos:altLabel>
		<skos:altLabel xml:lang="de">Geniza</skos:altLabel>
		<skos:prefLabel xml:lang="en">genizah</skos:prefLabel>
		<skos:altLabel xml:lang="en">genizot</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003128"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk006097"/>
		<skos:definition xml:lang="de">Eine Genisa ist ein Raum zur Aufbewahrung religiöser Schriften, Dokumente oder anderen Gegenständen, die heiligen oder rituellen Charakter haben, aufgrund von Abnutzung oder Beschädigung aber nicht mehr in Gebrauch sind. Angesichts ihres religiösen Charakters dürfen die Objekte nicht entsorgt werden. In der Regel befinden sich Genisas innerhalb einer Synagoge.</skos:definition>
		<skos:closeMatch rdf:resource="https://www.wikidata.org/wiki/Q855266"/>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4221218-2"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk006097"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-08-31T14:22:28+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk018056">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Jarmulke</skos:altLabel>
		<skos:prefLabel xml:lang="de">Kippa</skos:prefLabel>
		<skos:altLabel xml:lang="en">kippa</skos:altLabel>
		<skos:prefLabel xml:lang="en">kippah</skos:prefLabel>
		<skos:altLabel xml:lang="de">Kippah</skos:altLabel>
		<skos:altLabel xml:lang="de">Kippot</skos:altLabel>
		<skos:altLabel xml:lang="en">kippot</skos:altLabel>
		<skos:altLabel xml:lang="en">yarmulke</skos:altLabel>
		<skos:altLabel xml:lang="en">yarmulkes</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006012"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk009710"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk006012"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk009710"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk003538"/>
		<skos:definition xml:lang="de">Die Kippa ist eine kleine, runde Mütze, die von jüdischen Männern auf dem Hinterkopf getragen wird. Sie dient insbesondere während religiöser Handlungen, unter anderem dem Gebet, als Zeichen der Ehrfurcht vor Gott. Das Tragen der Kippa ist nicht verpflichtend, aber üblich, in nicht-orthodoxen jüdischen Strömungen auch unter Frauen.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300046126"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q215459"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk009710"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk006012"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<schema:image rdf:resource="https://xtree.digicult-verbund.de/imageStore/images/lvr_database/depiction_192.jpg"/>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-02-06T15:06:20+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<schema:ImageObject rdf:about="https://xtree.digicult-verbund.de/imageStore/images/lvr_database/depiction_192.jpg">
		<schema:caption xml:lang="de">Kippa</schema:caption>
		<dcterms:license rdf:resource="https://creativecommons.org/licenses/by-sa/3.0/de/"/>
		<dcterms:rightsHolder>Wikimedia Commons</dcterms:rightsHolder>
		<schema:creator>Jonn Leffmann</schema:creator>
	</schema:ImageObject>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk018059">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">crown (headdress)</skos:prefLabel>
		<skos:altLabel xml:lang="en">crowns (headdresses)</skos:altLabel>
		<skos:prefLabel xml:lang="de">Krone (Kopfschmuck)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Kronen (Kopfschmuck)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006012"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk019973"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk006012"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk019973"/>
		<skos:definition xml:lang="de">Eine Krone ist ein Kopfschmuck in Form eines Rings oder Kranzes aus kostbaren Materialien, oft Gold, und oft reich mit Ornamenten und Edelsteinen verziert. Sie kann nach oben hin offen oder geschlossen sein, der Ring kann oben unter anderem Zacken, Blätter oder ein Kreuz tragen. Sie kennzeichnet den Rang oder Status ihres Trägers.</skos:definition>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4033267-6"/>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300046020"/>
