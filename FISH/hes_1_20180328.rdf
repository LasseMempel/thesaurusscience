		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/355">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/355</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÀRACH RAON-ADHAIR AN AIRM</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalaichean, structaran is làraichean aig a bheil ceangal dìreach ri obrachadh raointean-adhair an airm.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MILITARY AIRFIELD SITE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/354" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/357" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/358">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/358</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">SEACHADAN PHLÈANAICHEAN</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Àite-seasaimh airson plèana a phàirceadh ach am bi e deiseil ri chleachdadh, mar is trice mun cuairt air raon-adhair.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">DISPERSAL BAY</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/355" />
				<skos:scopeNote xml:lang="en">An area of hardstanding for parking aircraft in a state of readiness, usually around the perimeter of an airfield.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/359">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/359</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TOGALACH PHARAISIUTAN</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Togalach far a bheilear a' pacadh, a' sgrùdadh 's a' càradh paraisiutaichean.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">PARACHUTE PACKING BUILDING</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/355" />
				<skos:scopeNote xml:lang="en">A building where parachutes are packed for use, checked and maintained.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/507402" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/507362" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/353" />
		<skos:scopeNote xml:lang="en">Buildings, structures and sites directly associated with the operation of military airfields. See also AIR TRANSPORT SITE in the TRANSPORT Class.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/357">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/357</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">STÒR BHOMAICHEAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Aitreabh thogalaichean, gu tric le ballachan-onfhaidh, a chaidh a dhealbhadh mar stòradh bhomaichean.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BOMB STORE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/355" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/368" />
		<skos:scopeNote xml:lang="en">A complex of buildings, often with accompanying blast walls, designed for the storage of bombs.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/360">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/360</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">IONAD-AIRM</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach no grunn thogalaichean, gu tric le rian daingneachaidh mun cuairt orra, a chleachdas buill nam feachdan armaichte mar àite-còmhnaidh 's làrach trèanaidh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MILITARY BASE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/354" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/361" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/365" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500515" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/508163" />
		<skos:scopeNote xml:lang="en">A building or group of buildings, often surrounded by a system of fortifications, used as a residential and training site by members of an armed force.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/361">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/361</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CAMPA AIRM</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far a bheil àite-còmhnaidh aig feachd, gu buan no rè seal, le no as aonais dìgean is daingneachadh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MILITARY CAMP</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/364" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/360" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/362" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/363" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/184" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/351" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/387" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502889" />
		<skos:scopeNote xml:lang="en">A site where a body of troops is temporarily or permanently lodged, with or without entrenchments and fortifications.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/362">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/362</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CAMPA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Campa sealach an airm. Mas e fear leis na Ròmanaich a tha ann, cleachd CAMPA SEALACH.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ENCAMPMENT</skos:prefLabel>
