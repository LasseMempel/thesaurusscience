    <!-- https://hist-arch-vocab.org/bvha#c_d2fca7f7 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_d2fca7f7">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1192c84c"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_f10222e0"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_290bd3f2"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-18T12:10:01.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-18T14:08:06.000</terms:modified>
        <skos:definition xml:lang="de">Die Zahnfläche wird [...] nach dem Spitzen eingesetzt. Je nach Lage der zu bearbeitenden Oberfläche und der Steinhärte ergeben sich ganz unterschiedliche Hiebwinkel. Die effektivste Bearbeitung erreicht man bei schräg liegender Oberfläche (etwa 30° - 40° ). [Voelkle 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Zahnflächen</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_d3128179 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_d3128179">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_89b7da10"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-04T14:52:06.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T14:31:40.000</terms:modified>
        <skos:altLabel xml:lang="de">Treppenschnitt</skos:altLabel>
        <skos:altLabel xml:lang="de">stratigrafische Freilegung</skos:altLabel>
        <skos:note xml:lang="de">Stufenweise Freilegung von Malschichten zum Nachweis und zur Bestimmung der chronologischen Abfolge von aufeinander folgenden Malschichten. [EwaGlos]</skos:note>
        <skos:note xml:lang="en">The stepwise removal of covering paint layers for analysis and determination of the chronological order of successive paint layers. [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="de">stratigrafische Untersuchung</skos:prefLabel>
        <skos:prefLabel xml:lang="en">stratigraphic investigation</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_d31f7a11 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_d31f7a11">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_2e37477e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_08f5cf10"/>
