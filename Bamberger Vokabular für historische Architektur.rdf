        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-07T11:46:21.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-12-01T08:55:45.000</terms:modified>
        <skos:altLabel xml:lang="de">Vollmauer</skos:altLabel>
        <skos:altLabel xml:lang="de">Vollmauerwerk</skos:altLabel>
        <skos:definition xml:lang="de">Massiver Mauerkörper im Unterschied zur  Hohlmauer. (Glossarium Artis, Bd. 3, Bögen und Mauerwerk)</skos:definition>
        <skos:definition xml:lang="de">Massives Mauerwerk, im Gegensatz zum Hohlmauerwerk. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Massivmauer</skos:prefLabel>
        <skos:prefLabel xml:lang="es">mampostería maciza</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">maçonnerie pleine</skos:prefLabel>
        <skos:prefLabel xml:lang="it">muratura piena</skos:prefLabel>
