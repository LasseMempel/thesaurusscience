        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-13T13:31:46.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:56:27.000</terms:modified>
        <skos:altLabel xml:lang="fr">dôme à pendentifs (courbes)</skos:altLabel>
        <skos:altLabel xml:lang="en">squinch arch</skos:altLabel>
        <skos:definition xml:lang="de">1. Die in ein Gewölbe einschneidenden Zwickel (Stichkappen). 2. Die zwischen einem Gewölbe und seinem Unterbau vermittelnden Wölbungen. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Wölbfläche, die nur einen Ausschnitt aus einem voll ausgebildeten Gewölbe darstellt, z. B. Pendentif und Trompe, oder ein Gewölbe, das mit einem anderen Gewölbe konstruktiv eng verbunden ist, z. B. die Stichkappe. [Glossarium Artis] </skos:definition>
        <skos:prefLabel xml:lang="de">Teilgewölbe</skos:prefLabel>
        <skos:prefLabel xml:lang="es">bóveda con pechinas</skos:prefLabel>
        <skos:prefLabel xml:lang="en">partial vault</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">samostatně použitá část klenby</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte partielle</skos:prefLabel>
    </owl:NamedIndividual>
    


