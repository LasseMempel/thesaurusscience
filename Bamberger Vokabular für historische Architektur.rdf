    <!-- https://hist-arch-vocab.org/bvha#c_c9dbc494 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_c9dbc494">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b61960cd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_c1de9e31"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-22T17:52:33.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T16:46:55.000</terms:modified>
        <skos:definition xml:lang="de">Kommunion f unter beiden Gestalten; lat. communio sub utraque: die Gabe von Brot und Wein bei der Eucharistie, bis zum 12.Jh. die übliche Form der Kommunion (Doppelkommunion f). In den prot. Kirchen und in den Ostkirchen wird das Abendmahl immer unter beiderlei Gestalt, Brotgestalt (f) und Weingestalt (f), gespendet. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Kommunion unter beiden Gestalten</skos:prefLabel>
        <skos:prefLabel xml:lang="la">communio sub utraque</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">communion sous les deux espèces</skos:prefLabel>
        <skos:prefLabel xml:lang="en">holy communion in both kinds </skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_c9e20fdd -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_c9e20fdd">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_6ca61a95"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_1b2278c2"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_1d666449"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-22T17:45:07.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T16:41:57.000</terms:modified>
        <skos:altLabel xml:lang="fr">rituel de bénédictions</skos:altLabel>
        <skos:definition xml:lang="de">Grube oder Behälter südl. neben dem Altar oder in der südl. Sakristei zur Aufnahme unbrauchbar gewordener geweihter Gegenstände (Baumwolle, Kerzen, Asche) sowie des zu liturg. Waschungen (Lavabo) verwendeten Wassers. Das S. ist häufig mit durchlochter Steinplatte oder kleinem Puteal (Eingussbecken) abgedeckt. Auch neben oder unter dem Taufstein soll ein S. sein. Verbreitet im frühen MA, in der weiteren Entwicklung des 13./ 14. Jhs. als Piscina in der Südwand des Chors oder der Sakristei. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Sacrarium n: Buch mit den Vorschriften für die Weihe der liturgischen Geräte, des Wassers, der Kerzen usw. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Sacrarium</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">sacrarium</skos:prefLabel>
    </owl:NamedIndividual>
    


