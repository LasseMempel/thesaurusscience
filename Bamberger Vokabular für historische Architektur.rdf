        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-25T09:53:23.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T12:08:32.000</terms:modified>
        <skos:definition xml:lang="de">Befestigungssystem mit Trennung von Fern- und Nahverteidigung. Das P. verzichtet auf die Längsflankierung entlang des Walls und die Brechung der Walllinien und ist auf die niedrige Flankierung aus Kasematten und Grabenwehren angewiesen. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="en"> polygonal system</skos:prefLabel>
        <skos:prefLabel xml:lang="es"> sistema defensivo poligonal</skos:prefLabel>
        <skos:prefLabel xml:lang="it"> sistema poligonale</skos:prefLabel>
        <skos:prefLabel xml:lang="fr"> système polygonal</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Polygonalsystem</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">polygonální system opevnění</skos:prefLabel>
    </owl:NamedIndividual>
    


