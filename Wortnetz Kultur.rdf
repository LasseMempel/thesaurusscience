		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk003041"/>
		<skos:definition xml:lang="de">Eine Hofkapelle ist eine administrative Körperschaft, die alle am Königshof tätigen Kleriker zusammenfasst, die sowohl religiösen als auch weltlichen Tätigkeiten nachgehen.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/7791079-5"/>
