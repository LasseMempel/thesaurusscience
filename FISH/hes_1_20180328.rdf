		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/504640">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/504640</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TAIGH DEALAICHTE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Taigh a sheasas leis fhèin 's nach eil balla ri balla ri taigh eile.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">DETACHED HOUSE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-08-06T14:06:45</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-08-06T14:08:49</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/422" />
				<skos:scopeNote xml:lang="en">A free-standing house, not joined to another on either side.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/503621">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/503621</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TAIGH CÙIRT-LIOS</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Togalach no togalaichean a tha mun cuairt air cùirt-lios, air co-dhiù trì taobhan dheth. Nochd iad ann an Linn an Iarainn ach bha buaidh mhòr aig taighean dhen t-seòrsa seo air planaichean thaighean a-mach on 15mh linn. Cuir an linn iomchaidh air a' chlàr-amais.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">COURTYARD HOUSE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-23T12:03:48</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-23T12:05:20</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:altLabel xml:lang="en">YARD HOUSE</skos:altLabel>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/422" />
				<skos:scopeNote xml:lang="en">A building or buildings ranged around a courtyard on at least three sides. They occur in the Iron Age, as well as being an influential plan type of house from the 15th century onwards. Index with appropriate period.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/406" />
