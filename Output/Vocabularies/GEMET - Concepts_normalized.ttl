    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Energie auf Kohlebasis"@de,
        "coal-based energy"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/1503> .

<http://www.eionet.europa.eu/gemet/concept/1503> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2606> ;
    skos:closeMatch <http://data.uba.de/umt/_00014578> ;
    skos:definition "Power plant which is fuelled by coal."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Kohlekraftwerk"@de,
        "coal-fired power plant"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/1502> ;
    skos:relatedMatch <http://dbpedia.org/resource/Fossil_fuel_power_station> .

<http://www.eionet.europa.eu/gemet/concept/15030> a skos:Concept ;
    skos:altLabel "emissions to air"@en ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2663> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "emission to air"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15088> .

<http://www.eionet.europa.eu/gemet/concept/15044> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15041>,
        <http://www.eionet.europa.eu/gemet/concept/15069>,
        <http://www.eionet.europa.eu/gemet/concept/15313>,
        <http://www.eionet.europa.eu/gemet/concept/883> ;
    skos:definition "all living matter composed of trees defined as generally five cm or greater diameter at breast height (4.3 feet above ground)"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "above-ground tree biomass"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15043> .

<http://www.eionet.europa.eu/gemet/concept/15054> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/394> ;
    skos:definition """A naturally occurring biochemical process in which organic
material is broken down by bacteria in an oxygen-free environment."""@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "anaerobic digestion"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/391> .

<http://www.eionet.europa.eu/gemet/concept/15059> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/505> ;
    skos:definition "group of interacting organisms dependent on one another and their water environment for nutrients (e.g., nitrogen and phosphorus) and shelter"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "aquatic system"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/8685> .

<http://www.eionet.europa.eu/gemet/concept/15062> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12008> ;
    skos:definition "suspensions of solids and/or liquid particles in the air that we breathe, as dust, smoke and haze, measured by the mass concentration of aerosol particles or by an optical measure"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "atmospheric aerosol loading"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15288> .

<http://www.eionet.europa.eu/gemet/concept/15063> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1168> ;
    skos:definition "primary source of carbon in life on Earth and its concentration in Earth's pre-industrial atmosphere since late in the Precambrian was regulated by photosynthetic organisms and geological phenomena"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "atmospheric carbon dioxide"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15064> .

<http://www.eionet.europa.eu/gemet/concept/15064> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15240>,
        <http://www.eionet.europa.eu/gemet/concept/5605> ;
    skos:definition "Atmospheric deposition or flux of total reactive nitrogen (N) to the Earth’s surface, calculated for example as kilograms N per hectare and year (kg N ha-1 yr-1). Reactive N from the atmosphere can be deposited as gases (= dry deposition) and in precipitation (= wet deposition). Total reactive N includes oxidised N compounds as well as reduced N compounds. Oxidised compounds are here mainly nitrogen oxides (NOx; gases) and nitrate (NO3-; in precipitation). The main reduced compounds are ammonia (NH3; gas) and ammonium (NH4+; in precipitation)"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "atmospheric nitrogen load"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15063> .

<http://www.eionet.europa.eu/gemet/concept/15065> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/543> ;
    skos:definition "Gebiet zwischen Nowaja Semlja im Osten und der Achse Norwegen–Bäreninsel–Südspitzbergen im Westen"@de,
        "area between Novaya Zemlia, in the east, and the line Norway–Bear Island–South Spitsbergen, in the west  area"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Barentssee"@de,
        "Barents Sea"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/14843> ;
    skos:scopeNote "Improved definition (EN only): The region of the Arctic Ocean lying between Novaya Zemlia on its eastern side and a hypothetical line from Norway, through Bear Island to South Spitsbergen on its western perimeter"@en .

<http://www.eionet.europa.eu/gemet/concept/1507> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14837> ;
    skos:closeMatch <http://dbpedia.org/resource/Coal_mining> ;
    skos:definition "The technical and mechanical job of removing coal from the earth and preparing it for market."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/5387> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Kohlebergbau"@de,
        "coal mining"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/1500> .

<http://www.eionet.europa.eu/gemet/concept/15071> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15182>,
        <http://www.eionet.europa.eu/gemet/concept/2124> ;
    skos:definition "ambient temperature under mild reaction conditions and use of special aerobic anaerobic microorganisms"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "bio desulfurization"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15101> .

<http://www.eionet.europa.eu/gemet/concept/15078> a skos:Concept ;
    skos:definition "The variability among living organisms from all sources including, inter alia, terrestrial, marine and other aquatic ecosystems and the ecological complexes of which they are part; this includes diversity within species, between species and of ecosystems"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "biological diversity"@en ;
    skos:topConceptOf <http://www.eionet.europa.eu/gemet/gemetThesaurus> .

<http://www.eionet.europa.eu/gemet/concept/15079> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Any organic matter in waste which can be broken down into carbon dioxide, water, methane or simple organic molecules by micro-organisms and other living things using composting, aerobic digestion, anaerobic digestion or similar processes"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Biologically degradable waste"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15174> .

<http://www.eionet.europa.eu/gemet/concept/15082> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/899> ;
    skos:definition "effects that the organisms in a community have on one another that are fundamental to the survival of that organism and the functioning of the ecosystem as a whole"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "biotic interactions"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15134> .

<http://www.eionet.europa.eu/gemet/concept/15083> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1160>,
        <http://www.eionet.europa.eu/gemet/concept/15084> ;
    skos:definition "Carbon captured by the world's oceans and coastal ecosystems.The carbon captured by living organisms in oceans is stored in the form of biomass and sediments from mangroves, salt marshes, seagrasses and potentially algae."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "blue carbon"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15084> .

<http://www.eionet.europa.eu/gemet/concept/15089> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15092>,
        <http://www.eionet.europa.eu/gemet/concept/4731> ;
    skos:definition "The situation that may occur if, for reasons of costs related to climate policies, businesses were to transfer production to other countries with laxer emission constraints. This could lead to an increase in their total emissions. The risk of carbon leakage may be higher in certain energy-intensive industries."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "carbon leakage"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/1160> .

<http://www.eionet.europa.eu/gemet/concept/15090> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1160>,
        <http://www.eionet.europa.eu/gemet/concept/15086> ;
    skos:definition "total of carbon emissions and carbon sequestration over a period of time for a defined area, project or sector"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "carbon mass balance"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15086> .

<http://www.eionet.europa.eu/gemet/concept/15094> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Abfälle aus Handel, Gewerbe, Industrie- oder Geschäftstätigkeiten"@de,
        "waste arising from any trade or business, industrial or commercial activities"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Abfälle der chemischen Industrie"@de,
        "chemical commercial waste"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15104> .

<http://www.eionet.europa.eu/gemet/concept/15101> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15182>,
        <http://www.eionet.europa.eu/gemet/concept/2124> ;
    skos:definition ""@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "coal gas desulfurization"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15071> .

<http://www.eionet.europa.eu/gemet/concept/15104> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Waste from premises used mainly for the purposes of a trade or business or for the purpose of sport, recreation, education or entertainment, but excluding household, agricultural or industrial waste"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "commercial waste"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15094> .

<http://www.eionet.europa.eu/gemet/concept/15105> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "mineralische Stoffe, die bei Abriss-, Renovierungs- oder Umbauarbeiten an Gebäuden und Gebäudeteilen anfallen"@de,
        "mineral materials occurring in the process of demolition, renovation and alteration works on edifices and building parts"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bauabfälle"@de,
        "construction waste"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/1731> ;
    skos:scopeNote "Improved definition (EN only): Waste stream which arises from activities such as the construction of buildings and civil infrastructure, total or partial demolition of buildings and civil infrastructure, road planning and maintenance"@en .

<http://www.eionet.europa.eu/gemet/concept/15106> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1745> ;
    skos:definition "study of individuals, groups, or organizations and the processes they use to select, secure, use, and dispose of products, services, experiences, or ideas to satisfy needs and the impacts that these processes have on the consumer and society"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "consumption behaviour"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15302> .

<http://www.eionet.europa.eu/gemet/concept/15108> a skos:Concept ;
    skos:definition "Materials left in an agricultural field or orchard after the crop has been harvested. These residues include stalks and stubble (stems), leaves, and seed pods. The residue can be ploughed directly into the ground, or burned first. Good management of field residues can increase efficiency of irrigation and control of erosion."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "crop residue"@en ;
    skos:topConceptOf <http://www.eionet.europa.eu/gemet/gemetThesaurus> .

<http://www.eionet.europa.eu/gemet/concept/15112> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11227> ;
    skos:definition "matter composed of organic compounds that has come from the remains of organisms such as plants and animals and their waste products in the environment"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "dead organic matter"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/5913> .

<http://www.eionet.europa.eu/gemet/concept/15119> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5605> ;
    skos:definition "The sum of nitrate, nitrite, and ammonium"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "dissolved inorganic nitrogen"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15240> .

<http://www.eionet.europa.eu/gemet/concept/15122> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15221>,
        <http://www.eionet.europa.eu/gemet/concept/5007> ;
    skos:definition "solid storage, dry feedlots, deep pit stacks, and daily spreading of the manure, as well as unmanaged manure from animals grazing on pasture"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "dry manure management system"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/5009> .

<http://www.eionet.europa.eu/gemet/concept/15123> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13236>,
        <http://www.eionet.europa.eu/gemet/concept/15204> ;
    skos:definition "ice sheet disintegration via sliding towards the sea accelerated by warming and precipitaion increase amounts"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "dynamical ice loss"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/2782> .

<http://www.eionet.europa.eu/gemet/concept/15132> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15133>,
        <http://www.eionet.europa.eu/gemet/concept/2440> ;
    skos:definition "Social process through which the findings of science concerning the causes of ecosystem change, their consequences for human well-being, and management and policy options are brought to bear on the needs of decision-makers"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "ecosystem assessment"@en .

<http://www.eionet.europa.eu/gemet/concept/15133> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15132>,
        <http://www.eionet.europa.eu/gemet/concept/2519>,
        <http://www.eionet.europa.eu/gemet/concept/2522> ;
    skos:definition "räumliche Abgrenzung eines Ökosystems, in der Regel basierend auf Unterbrechungen in der Verteilung der Organismen, der biophysikalischen Umgebung (Bodenarten, Einzugsgebiete, Tiefe eines Wasserkörpers) und den räumlichen Interaktionen (Reviere, Wanderverhalten, Stoffflüsse)"@de,
        "Spatial delimitation of an ecosystem, typically based on discontinuities in the distribution of organisms, the biophysical environment (soil types, drainage basins, depth in a water body), and spatial interactions (home ranges, migration patterns, fluxes of matter)"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Ökosystemgrenze"@de,
        "ecosystem boundary"@en .

<http://www.eionet.europa.eu/gemet/concept/15138> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2519> ;
    skos:definition "Vorteile, die Menschen dadurch erhalten, dass Ökosysteme zu ihrem Wohl beitragen"@de,
        "benefits that people obtain from ecosystems contributing to human well-being"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Ökosystemdienstleistungen"@de,
        "ecosystem services"@en .

<http://www.eionet.europa.eu/gemet/concept/15143> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3012> ;
    skos:definition "Vergleich der Auswirkungen einer Maßnahme, ihrer Ergebnisse und/oder Folgen mit ihren ausdrücklich festgelegten Zielen"@de,
        "comparing the effects of a measure, its outcomes and/or impacts, to its explicitly stated objectives"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Effektivitätsbewertung"@de,
        "effectiveness evaluation"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/3013> ;
    skos:scopeNote "Improved definition (EN only): comparing the effects of a measure (i.e., outcomes and/or impacts) to its explicitly stated objectives"@en .

<http://www.eionet.europa.eu/gemet/concept/15151> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2877> ;
    skos:definition "Programm, das den Rahmen für die Tätigkeit der Europäischen Union im Umweltbereich bildet"@de,
        "programme which provides the framework for European Union action in the field of the environment"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Umweltaktionsprogramm"@de,
        "environment action programme"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15161> .

<http://www.eionet.europa.eu/gemet/concept/15153> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2944> ;
    skos:definition "any activity affecting the environment or any consequence of such activity which, exclusively or simultaneously, has caused or continues to cause environmental pollution, environmental risk or the use of a natural asset"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "environmental burden"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15160> .

<http://www.eionet.europa.eu/gemet/concept/1516> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/505> ;
    skos:closeMatch <http://data.uba.de/umt/_00049781> ;
    skos:definition "Marine environments bounded by the coastal land margin (seashore) and the continental shelf 100-200 m below sea level. Ecologically, the coastal and nearshore zones grade from shallow water depths, influenced by the adjacent landmass and input from coastal rivers and estuaries, to the continental shelf break, where oceanic processes predominate. Among the unique marine ecosystems associated with coastal and nearshore waterbodies are seaweed-dominated communities, coral reefs and upwellings."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Küstenökosystem"@de,
        "coastal ecosystem"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/1517> .

<http://www.eionet.europa.eu/gemet/concept/15160> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2944> ;
    skos:definition "Pressures resulting from human activities which bring about changes in the state of the environment"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "environmental pressure"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15153> .

<http://www.eionet.europa.eu/gemet/concept/1517> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5498> ;
    skos:definition "The areas where the land masses meet the seas. Coastal environments include tidal wetlands, estuaries, bays, shallow near-shore waters, mangrove swamps, and in-shore reef systems. The critical habitats of these zones are: feeding, breeding, nursery, and resting areas. Coastal areas throughout the world are under enormous environmental stress, which is caused by a wide range of factors, including pollution and the destruction and deterioration of marine habitats."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Küstenregion"@de,
        "coastal environment"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/1516> .

<http://www.eionet.europa.eu/gemet/concept/15189> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2440> ;
    skos:definition "the chemical status required to meet the environmental objectives for surface waters established in Article 4(1)(a), that is the chemical status achieved by a body of surface water in which concentrations of pollutants do not exceed the environmental quality standards established in Annex IX and under Article 16(7), and under other relevant Community legislation setting environmental quality standards at Community level."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "good chemical status"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15130> .

<http://www.eionet.europa.eu/gemet/concept/15190> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15130>,
        <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:definition "Status, when the values of the biological quality elements for the surface water body type show low levels of distortion resulting from human activity, but deviate only slightly from those normally associated with the surface water body type under undisturbed conditions."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "good ecological status"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15129> .

