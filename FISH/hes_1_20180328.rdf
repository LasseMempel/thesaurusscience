		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500669" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/504720">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
