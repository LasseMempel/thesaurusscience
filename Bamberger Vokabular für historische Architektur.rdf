    <!-- https://hist-arch-vocab.org/bvha#c_907a8b38 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_907a8b38">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b320e26f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-27T15:20:45.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-18T15:08:37.000</terms:modified>
        <skos:definition xml:lang="de">(frz. courtine ›Zwischenfassade‹), Das zwischen zwei Türmen, Rondellen oder Bastionen gelegene Teilstück der Mauer bzw. des Walles. Da lange gerade Mauerstrecken ohne flankierende Werke relativ schlecht zu verteidigen und zudem gegen Beschuss vergleichsweise schwer zu sichern waren, versuchten die Befestigungstheoretiker und Ingenieure in der Frühen Neuzeit oft, die K. zu verkürzen (Manier). M. L. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:prefLabel xml:lang="de">Kurtine</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kurtina</skos:prefLabel>
    </owl:NamedIndividual>
    


