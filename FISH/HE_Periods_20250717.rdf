        <skos:altLabel xml:lang="en">Commonwealth</skos:altLabel>
        <skos:altLabel xml:lang="en">Protectorate</skos:altLabel>
        <skos:broader rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/MC17"/>
        <time:hasBeginning xml:lang="en">1649</time:hasBeginning>
        <time:hasEnd xml:lang="en">1660</time:hasEnd>
        <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_period"/>
        <dc:identifier>http://purl.org/heritagedata/schemes/eh_period/concepts/COM</dc:identifier>
