	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1011">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1011</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">EINNSEAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Inneal a tha ag obair air cumhachd smùide, gas, dealain no tùs cumhachd eile a chruthaicheas lùths gluasaid. Cleachd airson einnseanan gnìomhachais suidhichte seach feadhainn a thathar a' cleachdadh ann an còmhdhail.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ENGINE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">GAS ENGINE</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1010" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1012" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1014" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1016" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500673" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1230" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1242" />
		<skos:scopeNote xml:lang="en">A machine, powered by steam, gas, electricity or other energy source, which produces energy of movement. Use for stationary industrial engines rather than transport use.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1012">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1012</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">EINNSEAN HAIDREOLAIG</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Einnsean a tha ag obair air uisge fìor-dhùmhlaichte 's a chaidh a chleachdadh o thùs gus mèinnean a thraoghadh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HYDRAULIC ENGINE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1013">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1013</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">EINNSEAN PUMPAIDH HAIDREOLAIG</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Einnsean-pumpaidh a tha ag obair air cumhachd-uisge.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">HYDRAULIC PUMPING ENGINE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1012" />
				<skos:scopeNote xml:lang="en">A pumping engine driven by water power.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1011" />
		<skos:scopeNote xml:lang="en">An engine powered by high pressure water, originally used in mine drainage.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
