		<skos:prefLabel xml:lang="gd">MUILEANN FIODHRAICH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Muileann far a bheilear a' giullachd fiodh amh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TIMBER MILL</skos:prefLabel>
