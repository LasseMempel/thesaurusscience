	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021302">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">arthropod</skos:prefLabel>
		<skos:prefLabel xml:lang="mul">Arthropoda</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Arthropode</skos:prefLabel>
		<skos:altLabel xml:lang="de">Arthropoden</skos:altLabel>
		<skos:altLabel xml:lang="en">arthropods</skos:altLabel>
		<skos:altLabel xml:lang="de">Gliederfüßer</skos:altLabel>
		<skos:altLabel xml:lang="de">Gliederfüßler</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk001769"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk001769"/>
		<skos:definition xml:lang="de">Ein Arthropode ist ein mehrzelliges wirbelloses Tier, welches ein Exoskelett aus Chitin besitzt. Die Arthropoden bilden den artenreichsten Stamm der Tierwelt und kommen weltweit fast in allen Lebensräumen vor. Sie sind generell deutlich in verschiedene Segmente gegliedert. Sehr charakteristisch für die Arthropoden ist ihre Häutung (Ecdysis).</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4021279-8"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1360"/>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300265687"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk001769"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk021305"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk021304"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-05-22T10:41:27+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021304">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="mul">Chelicerata</skos:prefLabel>
		<skos:prefLabel xml:lang="en">chelicerate</skos:prefLabel>
		<skos:altLabel xml:lang="de">Cheliceraten</skos:altLabel>
		<skos:altLabel xml:lang="en">chelicerates</skos:altLabel>
		<skos:altLabel xml:lang="de">Fühlerlose</skos:altLabel>
		<skos:prefLabel xml:lang="de">Kieferklauenträger</skos:prefLabel>
		<skos:altLabel xml:lang="de">Scherenfüßer</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk021302"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk021302"/>
		<skos:definition xml:lang="de">Ein Kieferklauenträger (Chelicerata) ist ein Arthropode, der keine Antennen besitzt. Als wichtigstes gemeinsames Merkmal haben alle Kieferklauenträger ein Mundwerkzeug aus Cheliceren, welches zur Nahrungsaufnahme dient. Chelicerata bilden eine sehr formenreiche Gruppe und sind daher auch stark unterschiedlich in Form und Lebensweise. Die größten ausgestorbenen Vertreter wurden bis zu 1,8 m lang, die kleinsten nur wenige Millimeter groß. Die meisten Formen leben terrestrisch, es sind jedoch sowohl rezente als auch ausgestorbene Cheliceraten aus marinen und aquatischen Lebensräumen bekannt. Sie entstanden im späten Kambrium und sind mit den Trilobiten verwandt.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300310466"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1359"/>
		<skos:mappingRelation rdf:resource="http://d-nb.info/gnd/4155568-5"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk021302"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-08-06T12:44:43+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021305">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="mul">Crustacea</skos:prefLabel>
		<skos:prefLabel xml:lang="en">crustacean</skos:prefLabel>
		<skos:altLabel xml:lang="en">crustaceans</skos:altLabel>
		<skos:altLabel xml:lang="de">Crustacee</skos:altLabel>
		<skos:altLabel xml:lang="de">Crustaceen</skos:altLabel>
		<skos:altLabel xml:lang="de">Krebs (Crustacea)</skos:altLabel>
		<skos:altLabel xml:lang="de">Krebse (Crustacea)</skos:altLabel>
		<skos:prefLabel xml:lang="de">Krebstier</skos:prefLabel>
		<skos:altLabel xml:lang="de">Krebstiere</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk021302"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk021302"/>
		<skos:definition xml:lang="de">Ein Krebstier ist ein Arthropode, der sich durch zwei Paar Antennen und einen meist in Kopf, Brust und Hinterleib gegliederten Körper auszeichnet. Krebstiere besiedeln vor allem aquatische, aber auch einige terrestrische Lebensräume und umfassen weltweit über 50.000 bekannte Arten, darunter Garnelen, Krabben, Hummer und Flohkrebse.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4073783-4"/>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300310469"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q25364"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk021302"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk021257"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-05-22T10:32:11+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021308">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Panzerfisch</skos:prefLabel>
		<skos:altLabel xml:lang="de">Panzerfische</skos:altLabel>
		<skos:altLabel xml:lang="de">Placoderm</skos:altLabel>
		<skos:prefLabel xml:lang="en">placoderm</skos:prefLabel>
		<skos:prefLabel xml:lang="mul">Placodermi</skos:prefLabel>
		<skos:altLabel xml:lang="en">placoderms</skos:altLabel>
		<skos:altLabel xml:lang="de">Plakodermen</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk018611"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk018611"/>
		<skos:definition xml:lang="de">Ein Panzerfisch ist ein ausgestorbenes Wirbeltier mit einem Panzer aus Knochenplatten, das ausschließlich aquatisch lebte. Mit den Fischen ist er nur eng verwandt. Fossilien dieser Gruppe kommen vom Silur bis zum Ende des Devons vor. Panzerfische waren die ersten kiefertragenden Wirbeltiere.</skos:definition>
		<skos:mappingRelation rdf:resource="http://d-nb.info/gnd/4519819-6"/>
		<skos:mappingRelation rdf:resource="http://www.wikidata.org/entity/Q130932"/>
		<skos:mappingRelation rdf:resource="http://vocab.getty.edu/aat/300310221"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk018611"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-08-26T14:02:06+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021311">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">cartilaginous fish</skos:prefLabel>
		<skos:altLabel xml:lang="en">chondrichthian</skos:altLabel>
		<skos:altLabel xml:lang="de">Chondrichthyer</skos:altLabel>
		<skos:prefLabel xml:lang="mul">Chondrichthyes</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Knorpelfisch</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk009286"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk009286"/>
		<skos:definition xml:lang="de">Ein Knorpelfisch ist ein Fisch, der im Gegensatz zu den Knochenfischen kein Skelett aus Knochen, sondern aus Knorpel bildet. Zu den Knorpelfischen gehören Haie, Rochen und Chimären (Seekatzen). Fast alle Knorpelfische sind marin, nur wenige Vertreter leben im Süßwasser. Sie besitzen keine Schwimmblase. Die frühesten fossilen Knorpelfische treten im Silur auf.</skos:definition>
		<skos:mappingRelation rdf:resource="http://www.wikidata.org/entity/Q25371"/>
		<skos:mappingRelation rdf:resource="http://d-nb.info/gnd/4135828-4"/>
		<skos:mappingRelation rdf:resource="http://vocab.getty.edu/aat/300310592"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk009286"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-08-05T15:36:21+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021313">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Fleischflosser</skos:prefLabel>
		<skos:prefLabel xml:lang="en">lobe-finned fish</skos:prefLabel>
		<skos:altLabel xml:lang="en">lobe-finned fishes</skos:altLabel>
		<skos:altLabel xml:lang="de">Muskelflosser</skos:altLabel>
		<skos:altLabel xml:lang="en">sarcopterygian</skos:altLabel>
		<skos:altLabel xml:lang="de">Sarcopterygier</skos:altLabel>
		<skos:prefLabel xml:lang="mul">Sarcopterygii</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk009286"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk009286"/>
		<skos:definition xml:lang="de">Ein Fleischflosser ist ein Fisch, der paarige, fleischige Flossen besitzt, die intern durch ein einziges proximales Skelettelement (den Humerus) gestützt werden. Die Fleischflosser bilden ein paraphyletisches Taxon, da sie in der Kladistik sowohl die eigentlichen Fische als auch die von ihnen abstammenden Landwirbeltiere (Tetrapoda) umfassen.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300310219"/>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4701614-0"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q160830"/>
