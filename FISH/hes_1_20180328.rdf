		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1864" />
		<skos:scopeNote xml:lang="en">A shallow place in a river or other stretch of water, where people, animals and vehicles may cross.</skos:scopeNote>
