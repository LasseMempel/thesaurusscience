	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk005732">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Gartenböden</skos:altLabel>
		<skos:altLabel xml:lang="de">Gartenboden</skos:altLabel>
		<skos:prefLabel xml:lang="de">Hortisol</skos:prefLabel>
		<skos:altLabel xml:lang="de">Hortisole</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000522"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk008310"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019790"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000522"/>
		<xe:explanation_temp xml:lang="de">Die anthropogene Einflussnahme durch Düngemittelauftrag, Umgraben und Bewässerung führt dazu, dass der ursprüngliche Bodentyp nicht mehr erkennbar ist. Hortisole können Hinweise auf alte und verlassene Siedlungsplätze geben.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Hortisol ist ein anthropogener Boden, der durch langjährige Nutzung als Gartenboden entsteht und daher im Oberboden Rückstände anthropogen aufgebrachter Düngemittel wie Jauche oder Mist enthält.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4263171-3"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000522"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk008310"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019790"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
