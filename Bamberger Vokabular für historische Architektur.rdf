        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_043fca8d"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_6dd959ea"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_xh1ezgu0"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-06T20:08:53.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T14:58:56.000</terms:modified>
        <skos:altLabel xml:lang="de">custode</skos:altLabel>
        <skos:altLabel xml:lang="de">custodia</skos:altLabel>
        <skos:definition xml:lang="de">Custodia f (lat.): eine spanische Sonderform der Monstranz, ein oft mehrgeschossiges, turmartiges Gehäuse, eine Art Sakramentshaus, das in einer festen Kapsel oder tragbarem Gerät verborgen ist und bei Prozessionen auf einem Wagen mitgeführt wird. Beispiel: die 3,33m hohe silberne Custodia der Kathedrale von Sevilla. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Custodia (eucharistische Monstranz)</skos:prefLabel>
        <skos:prefLabel xml:lang="en">monumental monstrance</skos:prefLabel>
