        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_76706966"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_0596a3fc"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-21T18:05:07.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T16:03:36.000</terms:modified>
        <skos:altLabel xml:lang="de">Wandarkade</skos:altLabel>
        <skos:altLabel xml:lang="es">arcada simulada</skos:altLabel>
        <skos:altLabel xml:lang="fr">arcade engagée</skos:altLabel>
        <skos:altLabel xml:lang="fr">arcade simulée</skos:altLabel>
        <skos:altLabel xml:lang="it">arcata finta</skos:altLabel>
        <skos:altLabel xml:lang="cs">lichá arkáda</skos:altLabel>
        <skos:altLabel xml:lang="en">surface arcade</skos:altLabel>
        <skos:definition xml:lang="de">Blendarkade, Blendarkatur, als Gliederung einer Wandfläche aufgelegte Arkade ohne Zwischenraum zwischen Arkade und Wand, bes. in roman. und got. Zeit angewandt. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Einer Mauerfläche direkt aufgelegte Bogenstellung ohne dahinterliegenden Gang. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Reihe von durch Säulen oder Pfeiler getragenen Bögen (Arkade), die einer Wand als Gliederung direkt aufgelegt sind. In der Wehrarchitektur werden konstruktiv ausgebildete B.n häufig als Subkonstruktionen eingesetzt. Die vor die Innenseite von Stadt- oder Ringmauern gelegten Strebepfeiler werden durch Rundbögen verbunden, wie an der im 14. Jh. entstandenen Nürnberger Stadtmauer BY noch zu sehen. Diese B. trägt den Wehrgang. Im Schlossbau können B.n auch schmale Gebäude tragen. Am Schloss Chambord F, beg. 1519, erheben sich die Seitenflügel über B.n. 	B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:definition xml:lang="cs">SLEPÁ ARKÁDA, (též lichá), stěnu neotvírá, pouze ji dekorativně člení. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Blendarkade</skos:prefLabel>
        <skos:prefLabel xml:lang="es">arcada ciega</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">arcade aveugle</skos:prefLabel>
        <skos:prefLabel xml:lang="it">arcata cieca</skos:prefLabel>
        <skos:prefLabel xml:lang="en">blind arcade</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">slepá arkáda</skos:prefLabel>
    </owl:NamedIndividual>
    


