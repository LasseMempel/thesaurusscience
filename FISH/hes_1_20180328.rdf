		<skos:prefLabel xml:lang="gd">CAISTEAL</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach dìonach no sreath thogalaichean nam meadhan-aoisean a bhiodh nan àitichean-fuirich aig rìgh no baran no nan aonad rianachd.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CASTLE</skos:prefLabel>
