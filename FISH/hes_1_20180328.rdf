		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/503179" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/855" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/886" />
		<skos:scopeNote xml:lang="en">A building or site where boat sails are manufactured from processed cloth.</skos:scopeNote>
