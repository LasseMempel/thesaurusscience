		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1260" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1382" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1976" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1978" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1971" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1980" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1249" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1437" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1439">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1439</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">ACARSAID THIORAM</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Amar no cala nach ruigear aig àirde an làin no nach gabh a sheòladh ach aig àirde an làin.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">TIDAL BASIN</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1436" />
				<skos:scopeNote xml:lang="en">A basin or harbour, which is accessible or navigable only at high tide.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500506" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500920">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500920</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TÙR BHALBHAN</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Tùr iarainn, cloiche no concrait a chaidh a thogail air grunnd uisgeadan. Thathar ag obrachadh tuil-dhorsan nam pìoban a leigeas a-mach uisge aig diofar àirdean uaithe.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">VALVE TOWER</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-12-11T09:34:55</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-12-11T09:37:13</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1436" />
				<skos:scopeNote xml:lang="en">An iron, stone or concrete tower built up from the bed of a reservoir. From it the control valves of the pipes which draw off water at different levels are operated.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501073" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501074" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502190" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502213" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/504182">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/504182</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">GEATA DOCA</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Geata a dhùineas an t-slighe a-steach do dhoca gus an t-uisge a chumail a-staigh ann an doca-fliuch no gus a chumail a-muigh o dhoca-tioram.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">DOCK GATE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-04-24T11:57:49</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-04-24T11:57:55</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1436" />
				<skos:scopeNote xml:lang="en">A gate used to seal the entrance to a dock to prevent water escaping from a wet dock or entering a dry dock.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/504302" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502954" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502953" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/504343">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/504343</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">BHALBH-LEIGIDH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Duilleag-dhoras am broinn dama a chumas smachd air an uisge a dh'fhàgas an t-uisgeadan. Nì seo an dearbh-obair a nì tùr a-mach ach tha seo na phàirt de structar an dama, seach rud a sheasas leis fhèin san uisgeadan.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">OUTLET VALVE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-05-08T14:32:08</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-05-08T14:57:08</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1436" />
				<skos:scopeNote xml:lang="en">Valve set within a dam to control the issue of water from a reservoir. It fulfills the same function as an outlet tower, but is integral to the structure of the dam, rather than being free-standing within the reservoir.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/504121">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/504121</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TOBAR SÌOLAIDH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Structar fon uisge aig a bheil pìoban a-steach agus sgrìnichean copair tron a thèid uisge on uisgeadan a chur gus a shìolachadh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">STRAINING WELL</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-04-07T12:10:04</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-04-07T12:12:32</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1436" />
				<skos:scopeNote xml:lang="en">A sunken structure with inlet pipes and copper screens into which water from from a reservoir for filtration.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/508624" />
		<skos:scopeNote xml:lang="en">Buildings, structures and sites for regulating the flow of water.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1437">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1437</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LOC</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Earrann de chanal no abhainn le tuil-dhoras aig a dà cheann sa bheil tuill gus uisge a leigeil aiste no gus uisge a chur innte, rud a bheir an àirde no a-bhàn bàta o ìre gu ìre. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">LOCK</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">ENTRANCE LOCK</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1869" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1436" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1438">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1438</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">LOC BEUL-MARA</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Amar air an t-slighe a-steach on t-sàl gu canal no abhainn, le geata aig gach ceann agus gleus air choireigin a lùghdaicheas no a dh'àrdaicheas ìre an uisge.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">SEA LOCK</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1437" />
				<skos:scopeNote xml:lang="en">An entrance chamber from tidal water to a canal or river basin, with gates at each end and a means of raising or lowering the water level.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500531">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500531</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">CEANN-LOC</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Loc aig ceann canail a tha aig an dàrna chompanaidh far a bheil e a' coinneachadh ris a' chanal aig a' chompanaidh eile.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">STOP LOCK</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-26T15:09:24</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-26T15:09:49</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1437" />
				<skos:scopeNote xml:lang="en">A lock at the end of one company's canal where it joins another company's canal.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1874" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1875" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/455" />
		<skos:scopeNote xml:lang="en">A section of the water channel on a canal or river shut off above and below by lock gates provided with sluices to let the water out and in, and thus raise or lower boats from one level to another. Use more specific type where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1442">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1442</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CARRAGH-CUIMHNE</skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<skos:prefLabel xml:lang="en">MONUMENT (BY FORM)</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-07-18T08:27:47</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1448" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1535">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1535</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">LORG-IONAD</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">An t-àite mu thuaiream far an deach sgapadh de nithean a lorg. Cuir ainm an nì air a' chlàr-amais.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">FINDSPOT</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1442" />
				<skos:scopeNote xml:lang="en">The approximate location at which stray finds of artefacts were found. Index with object name.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1536" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1537" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/422" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1574" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1459">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1459</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">BOTHAN</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Àite beag, mun a bheil structar air choireigin gu tric, airson aonan mar is trice. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">BOOTH</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1442" />
				<skos:scopeNote xml:lang="en">A small, often enclosed compartment, usually accommodating only one person. Use specific term where known.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
