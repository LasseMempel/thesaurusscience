        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-05T22:01:39.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T18:04:31.000</terms:modified>
        <skos:definition xml:lang="de">Abscheiden einer Flüssigkeit (oder eines Feststoffes) aus seinem Dampf, in der Regel auf einer Oberfläche, die kälter ist als das angrenzende Gas. [EwaGlos]</skos:definition>
        <skos:definition xml:lang="en">Deposition of a liquid (or a solid) from its vapour, generally upon a surface that is cooler than the adjacent gas. [EwaGlos]</skos:definition>
        <skos:prefLabel xml:lang="de">Kondensation</skos:prefLabel>
        <skos:prefLabel xml:lang="en">condensation</skos:prefLabel>
    </owl:NamedIndividual>
    


