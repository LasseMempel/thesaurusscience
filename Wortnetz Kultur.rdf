	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021021">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Attrappe</skos:prefLabel>
		<skos:altLabel xml:lang="de">Attrappen</skos:altLabel>
		<skos:altLabel xml:lang="en">dummies</skos:altLabel>
		<skos:prefLabel xml:lang="en">dummy</skos:prefLabel>
		<skos:altLabel xml:lang="de">Dummy</skos:altLabel>
		<skos:altLabel xml:lang="de">Dummys</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk010651"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk010651"/>
		<skos:definition xml:lang="de">Eine Attrappe ist eine Imitation eines realen Objekts, die oft für praktische, dekorative oder täuschende Zwecke verwendet wird. Attrappen können in verschiedenen Formen, Größen und Materialien auftreten und werden häufig eingesetzt, um etwas zu imitieren, zu simulieren oder den Anschein von etwas zu erwecken, ohne dessen Funktion zu erfüllen. Sie können sowohl in alltäglichen Kontexten als auch in speziellen Bereichen wie Theater, Film, Ausstellungen oder militärischen Übungen Verwendung finden.</skos:definition>
		<skos:relatedMatch rdf:resource="http://www.wikidata.org/entity/Q3545649"/>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4756643-7"/>
