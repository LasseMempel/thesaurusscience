  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/90947">
    <skos:scopeNote xml:lang="en">A roughly circular monument featuring a low, more or less level platform of stones surrounded or retained by a low stone kerb. Some may feature a small central open area, thus resembling a ring cairn.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/86509">
    <skos:scopeNote xml:lang="en">A hopper for the storage of ash.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170632">
    <skos:scopeNote xml:lang="en">A plaque attached onto, or a line incised into, a wall face or other surface to indicate the height of flood water inundation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91270">
    <skos:scopeNote xml:lang="en">A waterwheel in which the incoming water is directed onto the periphery below the top of the wheel.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92070">
    <skos:scopeNote xml:lang="en">A crane mounted on a large metal gantry, used for the lifting of large-scale building materials, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167081">
    <skos:scopeNote xml:lang="en">A command post used to direct the guns of a coastal battery.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91532">
    <skos:scopeNote xml:lang="en">A circular, metal or wooden cover, covering a hole in the pavement where domestic coal deliveries were dropped into a store below.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87956">
    <skos:scopeNote xml:lang="en">A group of buildings containing machinery for the production in bulk of butter or related dairy products.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/147527">
    <skos:scopeNote xml:lang="en">An inn temporarily used for the performance of plays and other public entertainment.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140321">
    <skos:scopeNote xml:lang="en">A building housing material used to explain the significance of a site or landscape to the public e. g. an archaeological site or nature reserve.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94387">
    <skos:scopeNote xml:lang="en">A building or structure used for the storage of sugar.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71775">
    <skos:scopeNote xml:lang="en">A building or site for the manufacture of livestock fodder.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71540">
    <skos:scopeNote xml:lang="en">A university or college building set apart for residence or instruction of students. They can be located either on or off campus.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68690">
    <skos:scopeNote xml:lang="en">A freestanding public call box, containing a telephone and usually operated by inserting coins.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/144467">
    <skos:scopeNote xml:lang="en">A pond used for dissipating heat by evaporation from steam engine condensate. Mid 19th century to mid 20th century.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91863">
    <skos:scopeNote xml:lang="en">The residence of an engineer.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/104173">
    <skos:scopeNote xml:lang="en">A building that housed humans and cattle under one roof, with a shared entrance providing access to the cattle housing (usually downslope) and the dwelling area.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/88199">
    <skos:scopeNote xml:lang="en">An office used by a qualified pilot, expert in ship-handling and with local knowledge, who assists the captain or master to take a vessel in or out of a harbour or through narrow waters.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160319">
    <skos:scopeNote xml:lang="en">A natural ditch the depth and/or width of which has been increased so as to prevent the progress of a tank or armoured vehicle.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94296">
    <skos:scopeNote xml:lang="en">The approximate location at which stray finds of artefacts were found. Index with object name.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140358">
    <skos:scopeNote xml:lang="en">A type of military aircraft hangar of the Cold War, hardened and therefore protected against the effects of nuclear weapons. It comprises a semi-circular structure built of corrugated-steel supporting a reinforced-concrete skin. Three NATO designs.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143439">
    <skos:scopeNote xml:lang="en">An establishment used to serve ice cream to the general public.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69285">
    <skos:scopeNote xml:lang="en">An engineering site where railway carriages are manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69160">
    <skos:scopeNote xml:lang="en">A large-scale site where medicinal drugs are maufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68895">
    <skos:scopeNote xml:lang="en">A site where a body of troops is temporarily or permanently lodged, with or without entrenchments and fortifications.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/135262">
    <skos:scopeNote xml:lang="en">A site used for the manufacture of lasts, shoemaker's models of the foot for shaping and repairing footwear. Lasts can be from a variety of materials, such as wood or iron.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91050">
    <skos:scopeNote xml:lang="en">An area within a hospital concerned with the care and medical treatment of expectant mothers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99559">
    <skos:scopeNote xml:lang="en">A place of worship for members of the New Connexion of General Baptists,an orthodox Baptist church which broke away from the General Baptists in 1770 when the latter became influenced by Unitarianism.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93740">
    <skos:scopeNote xml:lang="en">A place where paper, frequently printed in ornamental designs, used for covering the interior walls of buildings, is manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92007">
    <skos:scopeNote xml:lang="en">A building in which an organization or society is instituted to promote foreign languages in England such as French and German, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91608">
    <skos:scopeNote xml:lang="en">The premises of a police officer for a parish or township who was appointed to act as a conservator of the peace within the district.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78163">
    <skos:scopeNote xml:lang="en">A site where metal is worked. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/146437">
    <skos:scopeNote xml:lang="en">A civilian settlement outside a Roman fort.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93058">
    <skos:scopeNote xml:lang="en">A crane located on a quayside used for the loading and unloading of goods and materials to and from vessels.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/163256">
    <skos:scopeNote xml:lang="en">A building housing a Russian-style steam bath or banya.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68679">
    <skos:scopeNote xml:lang="en">An Anglo-Saxon fortified town or other defended site, not necessarily urban.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93440">
    <skos:scopeNote xml:lang="en">A place where pieces of stone are crushed and ground.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/84590">
    <skos:scopeNote xml:lang="en">A small house or a portion of a house used as a self-contained apartment.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69401">
