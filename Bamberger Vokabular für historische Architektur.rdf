        <skos:definition xml:lang="de">Schubverteilungsband: am Sparrenfuß die Schubkräfte aufteilendes Holz, das steiler als der Sparren geneigt ist und zwischen Dachbalken bzw. Dachfußbalken verläuft. [Eißing et al. 2012]</skos:definition>
        <skos:prefLabel xml:lang="de">Schubverteilungsband</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_bd280e01 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_bd280e01">
