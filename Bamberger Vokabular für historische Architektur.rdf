        <skos:prefLabel xml:lang="en">conical corbel vault</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte conique</skos:prefLabel>
        <broaderByConstruction rdf:resource="https://hist-arch-vocab.org/bvha#c_049c4c22"/>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_049c4c22"/>
