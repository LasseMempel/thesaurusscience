        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-07T14:21:44.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T18:03:21.000</terms:modified>
        <skos:altLabel xml:lang="fr">oeil (d\&apos;escalier)</skos:altLabel>
        <skos:definition xml:lang="de">Auge, Lichtspindel, offene Spindel einer Wendeltreppe. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Treppenauge</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">jour (d\&apos;escalier)</skos:prefLabel>
        <skos:prefLabel xml:lang="es">ojo central de la escalera caracol</skos:prefLabel>
        <skos:prefLabel xml:lang="it">pozzo di scala elicoidale</skos:prefLabel>
        <skos:prefLabel xml:lang="en">round staircase well</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">schodišt\&apos;ové zrcadlo</skos:prefLabel>
    </owl:NamedIndividual>
    


