		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk009978"/>
		<xe:explanation_temp xml:lang="de">Pergament wird bereits seit dem 2. Jahrhundert vor Christus verwendet. Heute wird Pergament in der Regel aus ungeleimtem Lumpenpapier hergestellt.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Pergament ist ein verarbeitetes tierisches Material in Form von getrockneten, nicht gegerbten Tierhäuten, das zum Beschreiben genutzt wird.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300011851"/>
