				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-08-06T10:19:11</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1897" />
				<skos:scopeNote xml:lang="en">A boulder or rock cut and shaped into the form of a seat.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/504284">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/504284</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">COILEACH-GAOITHE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Bidh dà shlat a thèid thairis air a chèile aig coileach-gaoithe mar is trice 's iad a' sealltainn na ceithir àirdean. Cleachdar seo airson 's gum bi fios dè an taobh às a bheil a' ghaoth a' tighinn.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">WEATHER VANE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-05-05T14:02:35</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-05-05T14:02:41</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1897" />
				<skos:scopeNote xml:lang="en">A vane usually combined with crossed rods to show the four compass points. Used to indicate the direction of the wind.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/504120">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/504120</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">SEÒMAR TUNAIL</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Àite mò ann an tunail fon talamh, mar is trice nas leatha na an tunail fhèin, a chleachdar mar stòras is msaa.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">TUNNEL CHAMBER</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-04-07T11:39:06</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-04-07T11:39:17</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1897" />
				<skos:scopeNote xml:lang="en">A large space in an underground tunnel, usually wider than the tunnel itself, used for storage, etc.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/504241">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/504241</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">SOIGHNE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Bòrd, dealbh-balla no structar eile a thaisbeanas comhairle, fiosrachadh no stiùireadh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">SIGN</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-04-29T12:49:15</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-04-29T12:49:21</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1897" />
				<skos:scopeNote xml:lang="en">A board, wall painting or other structure displaying advice, giving information or directions</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/506241" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/507583" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/507222">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/507222</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">CARGU</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Cleachd airson fuigheall carago a chaidh air chall aig muir no a chaidh a leigeil leis a' chliathach a dh'aona-ghnothach agus am fuigheall an aon lorg fiosaigeach a tha air an t-soitheach.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">CARGO</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2012-12-04T13:50:42</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2012-12-04T13:52:22</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1897" />
				<skos:scopeNote xml:lang="en">Use for the remains of a cargo which has been accidentally lost at sea, or purposefully dumped, and which consists the only physical evidence of a vessel.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:scopeNote xml:lang="en">This is the top term for the class. See UNASSIGNED Class List for narrow terms.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1898">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1898</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FEART ÀRC-EÒLAIS</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Rud a tha cudromach a thaobh àrc-eòlais. Cleachd briathar pongail ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ARCHAEOLOGICAL FEATURE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1899" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1903" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1900" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1901" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1902" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1907" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1908" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1909">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1909</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">CLACH-LOISGTE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Clach a tha glaineach, co-leaghta ri linn teas anabarrach mòr.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">VITRIFIED STONE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-27T14:45:25</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1898" />
				<skos:scopeNote xml:lang="en">Stone with a glassy, fused character caused by extreme heat.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1897" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502706" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/505501">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/505501</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">UACHDAR TALMHAINN FO-THALAMH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Seann-uachdar talmhainn a tha a-nis fo uchdan-ùir no breathan eile de stuth a chaidh fhàgail os a chionn (tha seo a' gabhail a-steach pailleo-ùir, loidhnichean sgratha).</skos:scopeNote>
				<skos:prefLabel xml:lang="en">BURIED LAND SURFACE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-10-13T15:40:45</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-10-13T15:41:37</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:altLabel xml:lang="en">BURIED GROUND SURFACE</skos:altLabel>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1898" />
				<skos:scopeNote xml:lang="en">A former ground surface buried beneath an earthwork or other sequence of deposits. (includes palaeosoils, turf lines).</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:scopeNote xml:lang="en">A feature of archaeological significance. Use specific term wherever possible.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
