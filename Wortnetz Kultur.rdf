	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk000380">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Pfahlgründung</skos:prefLabel>
		<skos:altLabel xml:lang="de">Pfahlgründungen</skos:altLabel>
		<skos:prefLabel xml:lang="en">pile foundation</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000382"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010187"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk014952"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk017413"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000382"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk011592"/>
		<skos:definition xml:lang="de">Eine Pfahlgründung ist eine Tiefgründung, bei der Pfähle in den Baugrund gebohrt oder gerammt werden, bis eine ausreichend tragfähige Bodenschicht oder Gesteinsschicht erreicht ist.</skos:definition>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4173981-4"/>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300000923"/>
