	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/569">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/569</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TOGALACH GÀRRAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach no structar ann an gàrradh. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GARDEN BUILDING</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/570" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/474" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/583">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/583</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TAIGH-SAMHRAIDH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Togalach ann an gàrradh no pàirc a chaidh a dhealbhadh gus daoine a sgàileadh o theas na grèine.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">SUMMERHOUSE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-31T15:45:07</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/569" />
				<skos:scopeNote xml:lang="en">A building in a garden or park designed to provide a shady retreat from the heat of the sun.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
