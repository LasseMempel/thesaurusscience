        <skos:altLabel xml:lang="es">alfarda de la escalera</skos:altLabel>
        <skos:altLabel xml:lang="en">string</skos:altLabel>
        <skos:altLabel xml:lang="en">stringer</skos:altLabel>
        <skos:altLabel xml:lang="es">zanca</skos:altLabel>
        <skos:definition xml:lang="de">Begrenzen den Treppenlauf seitlich (Wand- und Lichtwange). [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Schodnice vymezují bočně schodišťové rameno (schodnice u zdi nebo u čela schodů). [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Seitl. Begrenzung einer Treppe. Man unterscheidet Wandwange und Lichtwange, die das Geländer trägt. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Treppenwange</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">limon d\&apos;escalier</skos:prefLabel>
