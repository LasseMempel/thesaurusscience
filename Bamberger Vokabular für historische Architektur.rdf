        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-25T12:29:56.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T16:08:00.000</terms:modified>
        <skos:definition xml:lang="de">Durchgang zwischen Höfen oder zwischen bzw. unter Bauwerken (Unterführung), der mit Läden ausgestattet sein kann. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Passage</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">pasáž, průchod</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_b5997041 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b5997041">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_d3971ceb"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-04T11:53:19.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-07T09:34:41.000</terms:modified>
        <skos:altLabel xml:lang="de">Mutulus</skos:altLabel>
        <skos:definition xml:lang="de">Dielenkopf (lat. mutulus), viereckige Platte an der Unterseite des Geisons gr. Tempel (Dorische Ordnung), je eine über jeder Triglyphe und Metope, besetzt mit drei Reihen von je sechs zylindr. &gt;Tropfen&lt; (lat. guttae), deren Form auf den Holzbau zurückweist (Holznägel). [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Mutulus, Dielenkopf, Hängeplatte unter dem dorischen Geison. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Závěsná deska pod dórským geisonem s kapkami. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Dielenkopf</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">mutulus</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_b5a6557d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b5a6557d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_cfb37b4e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_2c9de681"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_e22e5f20"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_fea07b3b"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_3da3c0b4"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-22T15:34:48.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T23:17:33.000</terms:modified>
        <skos:altLabel xml:lang="de">Ehrengrabmal</skos:altLabel>
        <skos:altLabel xml:lang="de">Grabmonument</skos:altLabel>
        <skos:altLabel xml:lang="de">Kenotaph</skos:altLabel>
        <skos:altLabel xml:lang="de">Scheingrab</skos:altLabel>
        <skos:definition xml:lang="de">Grabdenkmal, Kenotaph, im Gegensatz zum raumschaffenden Grabbau ist das G. lediglich ein Erinnerungsmal an einen Toten, doch sind die Übergänge fließend. Reicher geschmückte Formen sind einem Sarg (Sarkophag, ohne Bestattung: Kenotaph) oder der Liegestatt für einen Toten (Tumba) nachgebildet. Eine Sonderform ist das Heilige Grab. Das G. kann ferner in der Form einer Säule, einer aufrecht stehenden (Stele) oder liegenden Platte (Grabplatte) oder als eine in die Wand eingelassene Platte (Epitaph) ausgebildet sein. Die Tumben können wie die Sarkophage einen architekton. Überbau (Baldachin, Baldachingrabmal) haben und durch Plastik geschmückt sein. Griechen und Römer stellten ihre G.er oft an Straßen auf. Im MA finden wir G.er hauptsächl. im Inneren der Kirchen und Kapellen, manchmal auch in der Form eines Nischengrabes, das auch an der Außenwand einer Kirche vorkommen kann. In der Renaissance und in der Barockzeit wurden aufwendigere G.er mit zahlr. Skulpturen, Putten und allegor. Gestalten geschaffen. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Kenotaph, ein Grab, in dem niemand bestattet ist. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Řec. kenotafion = prázdný hrob. Náhrobek nezvěstného nebo na jiném místě pohřbeného člověka. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Grabdenkmal</skos:prefLabel>
        <skos:prefLabel xml:lang="es">cenotafio</skos:prefLabel>
        <skos:prefLabel xml:lang="it">cenotafio</skos:prefLabel>
        <skos:prefLabel xml:lang="en">cenotaph</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">cénotaphe</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kenotaf</skos:prefLabel>
    </owl:NamedIndividual>
    


