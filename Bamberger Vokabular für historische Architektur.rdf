        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_4faff988"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-22T21:43:23.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T16:21:45.000</terms:modified>
        <skos:definition xml:lang="de">Portal an der Seitenfront einer Kirche, bei mehreren Portalen an der Fassade auch die Eingänge seitl. des Hauptportals. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Seitenportal</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">portail latéral</skos:prefLabel>
        <skos:prefLabel xml:lang="es">portal lateral</skos:prefLabel>
        <skos:prefLabel xml:lang="it">portale laterale</skos:prefLabel>
        <skos:prefLabel xml:lang="en">side portal</skos:prefLabel>
        <broaderByPosition rdf:resource="https://hist-arch-vocab.org/bvha#c_6a7d7ddc"/>
    </owl:NamedIndividual>
    


