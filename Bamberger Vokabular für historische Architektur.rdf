        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-13T14:58:09.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T16:38:52.000</terms:modified>
        <skos:prefLabel xml:lang="de">Aushöhlung</skos:prefLabel>
        <skos:prefLabel xml:lang="en">coving</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">creusement</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">vykotlání</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Aushöhlung ist eine Form des Materialverlusts, die aus einer einzelnen Alveole besteht und sich von der Kante eines Steinquaders aus entwickelt. [ICOMOS-ISCS] </skos:scopeNote>
        <skos:scopeNote xml:lang="fr">S’applique à la formation d’une seule alvéoleaffectant la surface de la pierre à partir de ses arêtes. [ICOMOS-ISCS]</skos:scopeNote>
        <skos:scopeNote xml:lang="en">erosion feature consisting in a single alveole developingfrom the edge of the stone block. [ICOMOS-ISCS]</skos:scopeNote>
        <skos:scopeNote xml:lang="cs">erozní tvar sestávající z jedné alveoly, vytvořený na hraně (rohu) kamenného bloku. [ICOMOS-ISCS] </skos:scopeNote>
    </owl:NamedIndividual>
    


