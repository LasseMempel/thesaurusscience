    <!-- https://hist-arch-vocab.org/bvha#c_9f043547 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_9f043547">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_17d46f99"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_962574f8"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a014710c"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_c10d78d5"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_cf792a3c"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_f5f8994f"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_df84ddba"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-05T09:57:47.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T14:37:32.000</terms:modified>
        <skos:altLabel xml:lang="de">Vorsatzkreuz</skos:altLabel>
        <skos:altLabel xml:lang="en">crucifix</skos:altLabel>
        <skos:definition xml:lang="de">Altarkreuz n; auch Vorsatzkreuz n; Iat. crux altaris: ein großes Standkreuz aus kostbarem Material, oft ein Kruzifix (Altarkruzifix n ), das immer auf dem Altar stehen muss (seit 11. Jh.) . In prot. Kirchen gibt es das Altarkreuz nur bei den Lutheranern. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Unter Altarkreuz versteht man ein Kreuz, das nach liturgischer Vorschrift bei der Feier der Messe hinten in der Mitte der Mensa dem zelebrierenden Priester gegenüber, sei es unmittelbar auf derselben, sei es erhöht auf einem Untersatz, stehen muss. [RDK Labor]</skos:definition>
        <skos:prefLabel xml:lang="de">Altarkreuz</skos:prefLabel>
        <skos:prefLabel xml:lang="en">altar cross</skos:prefLabel>
        <skos:prefLabel xml:lang="it">croce d\&apos;altare</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">croix d\&apos;autel</skos:prefLabel>
        <skos:prefLabel xml:lang="la">crux altaris</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">oltářní kříž</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_c10d78d5"/>
    </owl:NamedIndividual>
    


