        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_5fe7fa51"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_e89d507a"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-05T18:33:43.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T15:03:34.000</terms:modified>
        <skos:altLabel xml:lang="de">Landbischof</skos:altLabel>
        <skos:definition xml:lang="de">Chorbischof m; von gr. chora = Land; auch Landbischof m: seit frühchristlicher Zeit ein Bischof, der für die Gemeinden auf dem Lande zuständig und dem Stadtbischof bzw. Diözesanbischof unterstellt war. Diese Unterscheidung wurde vor allem vom 8. bis zum 12. Jh. gemacht und ist nicht mehr üblich. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Chorbischof</skos:prefLabel>
        <skos:prefLabel xml:lang="en">chorepiscopus</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">chorévêque</skos:prefLabel>
    </owl:NamedIndividual>
    


