        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-18T12:23:08.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T18:27:14.000</terms:modified>
        <skos:altLabel xml:lang="de">Biberschwanzziegel</skos:altLabel>
        <skos:altLabel xml:lang="de">Plattenziegel</skos:altLabel>
        <skos:altLabel xml:lang="cs">obyčejná taška</skos:altLabel>
        <skos:definition xml:lang="de">Flacher Dachziegel, der mittels einer Nase an die Dachlatte gehängt wird, meist rechteckig, am unteren Ende leicht abgerundet oder spitz, seit dem 12. Jh. nachgewiesen, bes. in Süddeutschland verbreitet. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="fr"> tuile plate</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Biberschwanz</skos:prefLabel>
        <skos:prefLabel xml:lang="en">flat tile</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">střešní taška obyčejná</skos:prefLabel>
        <skos:prefLabel xml:lang="es">teja plana</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_22870fcf -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_22870fcf">
