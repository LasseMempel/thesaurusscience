    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "HARD"@en ;
    skos:scopeNote "A firm beach or foreshore used for landing and loading of ships and other vessels. In more recent times hards have been reinforced with concrete."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/100515> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94354> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "ANTENNA ARRAY"@en ;
