        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_ff9ff443"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-16T14:47:05.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T18:22:46.000</terms:modified>
        <skos:altLabel xml:lang="fr">remplage simulé</skos:altLabel>
        <skos:altLabel xml:lang="es">tracería simulada</skos:altLabel>
        <skos:definition xml:lang="de">Blendmaßwerk, einer nicht durchbrochenen Mauerfläche (z. B. Giebel) vorgeblendetes, d. h. aufgelegtes Maßwerk, häufig in Verbindung mit einem Blendfenster oder zur Füllung einer Blende, auch bei Holzvertäfelungen und anderem Holz- und Metallwerk, in der Gotik und im 19. Jh. angewandt. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Slepá kružba je umístěna na plné stěně. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Blendmaßwerk</skos:prefLabel>
        <skos:prefLabel xml:lang="en">blind tracery</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">remplage aveugle</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">slepá kružba</skos:prefLabel>
        <skos:prefLabel xml:lang="es">tracería falsa</skos:prefLabel>
        <skos:prefLabel xml:lang="it">traforo cieco</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Einer geschlossenen Wand vorgeblendetes Maßwerk. [Koch 2009]</skos:scopeNote>
    </owl:NamedIndividual>
    


