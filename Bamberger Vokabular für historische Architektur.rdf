    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_66febd5b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_66febd5b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_fbedadd4"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_b41bd73a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-18T07:48:46.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-18T07:50:03.000</terms:modified>
        <skos:definition xml:lang="de">Am Schiebefenster an der Innenseite des unteren Querholzes befindliche Leiste, auf der der Schiebeflügel beim Verschieben entlangläuft. I. d. R. ist das untere Querholz und das Laufbrett aus einem Holz gefertigt. In Sachsen ist das Laufbrett selten zu finden, in Thüringen aber verbreitet. [Noky 1996]</skos:definition>
        <skos:prefLabel xml:lang="de">Laufbrett</skos:prefLabel>
    </owl:NamedIndividual>
    


