		<skos:altLabel xml:lang="en">QUAKER MEETING HOUSE</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1748" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/188" />
		<skos:scopeNote xml:lang="en">A place of worship for members of the Society of Friends, a denomination founded by George Fox in c.1650 who believed in passivist principles and a rejection of the sacrament.</skos:scopeNote>
