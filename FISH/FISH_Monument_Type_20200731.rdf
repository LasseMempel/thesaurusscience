    <skos:scopeNote xml:lang="en">A stone-faced enclosure, with entrance closed by a floatable caisson or by gates, which can be pumped dry for inspection, maintenance, or repair of the hull or underwater fittings of a ship or ships.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141874">
