        <skos:prefLabel xml:lang="es">corte de piedras</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kamenořez</skos:prefLabel>
        <skos:prefLabel xml:lang="it">lotomia</skos:prefLabel>
        <skos:prefLabel xml:lang="en">stone cutting</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">stéréotomie</skos:prefLabel>
    </owl:NamedIndividual>
    


