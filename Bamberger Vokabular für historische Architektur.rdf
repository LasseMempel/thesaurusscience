        <skos:altLabel xml:lang="la">pectorale</skos:altLabel>
        <skos:altLabel xml:lang="la">tassellus</skos:altLabel>
        <skos:definition xml:lang="de">Chormantelschließe f, Pluvialschließe f, Pektorale n, formale, pectorale, monile, morsus, tassellus: große, reich verzierte Spange oder Agraffe, die das Pluviale vorne zusammenhält oder als Zierstück auf das Verbindungsband aufgesteckt wird. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Chormantelschließe</skos:prefLabel>
        <skos:prefLabel xml:lang="la">formale</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">mors de pluvial</skos:prefLabel>
        <skos:prefLabel xml:lang="en">morse</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">spona chórového pláště</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_12e34719 -->


