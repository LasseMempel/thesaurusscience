    <!-- https://hist-arch-vocab.org/bvha#c_d44a416f -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_d44a416f">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1df9f722"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_0bff99b5"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_552d3e37"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_9ecfe12c"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_a8d91455"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T17:25:22.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-18T14:12:17.000</terms:modified>
        <skos:definition xml:lang="de">Kunsthandwerkliche Verarbeitung von Eisen, aus Mittelalter und Renaissance besonders als Tür- und Truhenbeschläge, Standleuchter, Kaminböcke, Laternen, Gitter erhalten. Die Waffenschmiedekunst wendet zur Verzierung auch das Gravieren und Ätzen an. Hauptleistungen der sakralen Schmiedekunst sind die barocken Chorgitter (Doxale - Chor) des 17. und 18. Jhs. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Uměleckořemeslné zpracování železa, ze středověku a renesance se zachovalo zvl. jako kování dveří a truhel, svícny, kozlíky ke krbu, lucerny a mříže. Umělecké zbrojířství používalo k výzdobě též gravírování a leptání. Nejvýznamnějšími výrobky sakrálního uměleckého kovářství jsou barokní chórové mříže (doxale - viz chór) ze 17. a 18. stol. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Schmiedekunst</skos:prefLabel>
        <skos:prefLabel xml:lang="la">opus fabrile</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">umělecké kovářství</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_d44c63bd -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_d44c63bd">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_89b7da10"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_813ed136"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-22T19:49:25.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T14:31:08.000</terms:modified>
        <skos:altLabel xml:lang="de">Aufmaß</skos:altLabel>
        <skos:altLabel xml:lang="de">Bauaufmaß</skos:altLabel>
        <skos:altLabel xml:lang="en">measured drawings</skos:altLabel>
        <skos:altLabel xml:lang="cs">proměřování</skos:altLabel>
        <skos:altLabel xml:lang="cs">vyměřování</skos:altLabel>
        <skos:altLabel xml:lang="cs">zaměření území</skos:altLabel>
        <skos:note xml:lang="en">Any measurement that is performed on wall paintings, a building or its surroundings which is then presented as a collection of spatial information within a bi- (plans, cross-sections, elevations, etc.) or tri- (point cloud, polygonal mesh, etc.) dimensional representation. (EwaGlos)</skos:note>
        <skos:note xml:lang="de">Die Fundamente wurden nach den Bauplänen auf dem Baugelände (area) mit rechtwinklig (norma), kreuzförmig gespannten Richt - schnüren (linea, funiculus) und 12 oder 10 Fuß langen Messlatten (pertica, decempeda), auch mit der (durch Dehnung ungenauen) Messschnur, dem Bodenzirkel ( circinus) oder der Zirkelschnur eingemessen. Das aufgehende Mauerwerk wurde kontrolliert mit der geraden Holzlatte, dem Richtscheit (regula), dem seit Rivius 1548 so genannten Winkelhaken, der Setz- oder Lotwaage (libella) und dem Bleilot (perpendiculum), dessen Schnur durch ein Holzklötzchen geführt wurde. [Koepf / Binding 2016]</skos:note>
        <skos:note xml:lang="de">Messungen, die an Wandmalereien, einem Bau oder seiner Umgebung vorgenommen werden und als Sammlung von räumlichen Informationen innerhalb einer zwei- (Ansichten, Querschnitte, Aufrisse etc.) oder drei- (Punktewolke, Polygonnetz etc.) dimensionalen Darstellung präsentiert werden. (EwaGlos)</skos:note>
        <skos:prefLabel xml:lang="de">Vermessung</skos:prefLabel>
        <skos:prefLabel xml:lang="en">metric survey</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">měření</skos:prefLabel>
    </owl:NamedIndividual>
    


