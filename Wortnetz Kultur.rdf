	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk019213">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">factory lamp</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Firmalampe</skos:prefLabel>
		<skos:altLabel xml:lang="en">Firmalampe</skos:altLabel>
		<skos:altLabel xml:lang="de">Firmalampen</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004790"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk008673"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk006046"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk012111"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk008673"/>
		<skos:definition xml:lang="de">Eine Firmalampe ist eine römische Leuchte mit kreisrundem Lampenkörper und mehr oder weniger langgezogener Brennschnauze. Die Lampen wurden mit flüssigem Brennstoff befüllt und aus Ton hergestellt. Sie sind mit einem Bodenstempel mit Herstellernamen versehen.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300190772"/>
		<skos:mappingRelation rdf:resource="https://www.wikidata.org/wiki/Q1419089"/>
