		<skos:scopeNote xml:lang="en">A series of ditches designed to prevent enemy gliders from being able to land safely.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/282">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/282</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">PUIST ANTI-GHLAIGHDEARAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Puist fiodha no concrait, mar is trice san t-seal-mhara no àite còmhnard sam bith, cha ruigear iad an-diugh gu math tric nuair a bhios an làn àrd.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ANTI GLIDER POSTS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/279" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/281" />
		<skos:scopeNote xml:lang="en">Wooden or concrete posts usually laid in the inter-tidal zone or any flat area, now often cut off at high tide level.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/283">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/283</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÀRACH BHAILIÙNAICHEAN-BACAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far an robh bailiùn mòr ceangailte ris an talamh le càballan mar bhacadh san adhar an aghaidh carbadan-adhair an nàmhad.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BARRAGE BALLOON SITE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/310" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/279" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/313" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500515" />
		<skos:scopeNote xml:lang="en">A site where a single large balloon was attached by wire cables to the ground to form an aerial obstruction to attacking enemy aircraft.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/285">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/285</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BATARAIDH SHOLASAN-SIRIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far an robh co-dhiù aon solas-siridh a bhiodh a' lorg plèanaichean no soithichean nàmhad ach am faiceadh bataraidhean is plèanaichean-cogaidh oidhche iad.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SEARCHLIGHT BATTERY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/287" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/279" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500653" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501052" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/280" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/289" />
		<skos:scopeNote xml:lang="en">A site in which one or more searchlights were positioned to locate enemy aircraft or surface vessels for the benefit of batteries and night fighter aircraft.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
