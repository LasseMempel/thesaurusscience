	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk019513">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">cage cup</skos:prefLabel>
		<skos:altLabel xml:lang="en">cage cups</skos:altLabel>
		<skos:altLabel xml:lang="de">Diatret</skos:altLabel>
		<skos:altLabel xml:lang="de">Diatrete</skos:altLabel>
		<skos:prefLabel xml:lang="de">Diatretglas (Gefäß)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Diatretgläser (Gefäße)</skos:altLabel>
		<skos:altLabel xml:lang="en">vas diatretae</skos:altLabel>
		<skos:altLabel xml:lang="en">vas diatretum</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000203"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000203"/>
		<skos:definition xml:lang="de">Ein Diatretglas ist ein doppelwandiges Gefäß, dessen Außenseite als filigranes, durchbrochenes Glasnetz gearbeitet ist. Der Netzdekor oder auch figürliche Verzierungen heben sich vom Glaskörper ab. Diatrete dienten in römischer Zeit wahrscheinlich vorrangig als Trinkgefäße zu besonderen Anlässen, ein Gebrauch als Lampe ist ebenfalls denkbar. Auf Grund der höchst anspruchsvollen Herstellungstechnik galten Diatrete besonders in der Spätantike als äußerst wertvoll.</skos:definition>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4200444-5"/>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300201844"/>
		<skos:closeMatch rdf:resource="https://www.wikidata.org/wiki/Q448190"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000203"/>
