    skos:prefLabel "Bone Working Debris"@en ;
    skos:scopeNote "Debris resulting from the manufacture of tools and other artifacts from bone."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141189> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96002> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Wall Plaster"@en ;
    skos:scopeNote "Rendering material containing lime and sand spread on walls as a pliable mixture before drying to a hard surface."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141191> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/141190> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Terracotta"@en ;
    skos:scopeNote "A hard, unglazed earthenware, characteristically reddish-brown in colour, used in decoration and construction."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141197> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/141195> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Bryozoan Remains"@en ;
    skos:scopeNote "Remains of Bryozoa, which are small animals, usually marine, that form colonies producing coral-like skeletons or jelly-like masses."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141198> a skos:Concept ;
    skos:altLabel "Earthworm Remains"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/141195> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Annelid Remains"@en ;
    skos:scopeNote "Remains of animals characterized as having bodies made up of annular segments, such as worms and leeches. Earthworm eggs and granule comonly occur. Bristle worms are found associated with marine molluscs."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141202> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/141195> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Echinoderm Remains"@en ;
    skos:scopeNote "Remains of the group of animals characterized as being radially symmetrical in form, such as sea urchins, sea cucumbers and starfish."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141228> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97115> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Animal Brooch"@en ;
    skos:scopeNote "An enamelled plate brooch, dating from the second and third centuries AD, depicting an animal often with religious significance, such as hares, birds, fish and horses, sometimes with rider."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141229> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96662> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Aucissa Brooch"@en ;
    skos:scopeNote "Imported Roman brooch with a wide, highly arched flat backed bow, one end rolled forward onto the head to form a hinge for the the pin. Named for the head inscription assumed to be a maker's name. Dated to first half of 1st entury AD."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141230> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96662> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Bow And Fantail Brooch"@en ;
    skos:scopeNote "A Roman brooch dating from approximately 50 to 150 AD. Derived from the earlier Aesica Brooch, and fitted with a hinged pin, the body widens to a triangular plate below the bow."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141231> a skos:Concept ;
    skos:altLabel "Ansate Brooch"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96662> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Caterpillar Brooch"@en ;
    skos:scopeNote "Anglo-Saxon two-piece bow brooch, dating from the 8th to 9th centuries AD, so named for the distinctive bow shaped like the arching body of a caterpillar."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141233> a skos:Concept ;
    skos:altLabel "Bugelknopffibeln"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96662> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Crossbow Brooch"@en ;
    skos:scopeNote "Roman bow brooch, dating from the third to fifth centuries AD, with a P-shaped profile and a characteristic crossbar, often adorned with knobs at its end and on the head. Shown in contemporary illustrations as being worn by high ranking males."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141235> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/141234> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Cruciform Brooch"@en ;
    skos:scopeNote "An Anglo-Saxon cruciform Long Brooch, often ornamented with knobs across and terminating its crossbar and head, and frequently with its foot shaped into a zoomorphic motif."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141236> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96662> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Dolphin Brooch"@en ;
    skos:scopeNote "Roman, mid-1st century AD two-piece Bow Brooch, derived from the Colchester Brooch, with a winged, transverse head  protecting a spring mechanism held by a rear facing hook over the chord, its profile evoking a leaping dolphin."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141237> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96665> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Dragonesque Brooch"@en ;
    skos:scopeNote "Roman mid-first to third century AD S or reverse-S shaped brooch. Often enamelled, with its central section expanded for decoration, the brooch depicted stylised creatures derived from Celtic art. The pin was looped over the neck of the brooch."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141238> a skos:Concept ;
    skos:altLabel "Lamberton Moor Brooch"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96662> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Headstud Brooch"@en ;
    skos:scopeNote "A two-piece Bow Brooch, derived from the Colchester Brooch, dating from the later first and second centuries AD and so called due to the decorative stud on the upper bow."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141239> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96662> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Hod Hill Brooch"@en ;
    skos:scopeNote "Roman, mid to late 1st century, hinged  Bow Brooch, related to the Aucissa Brooch, with side knobs on the upper bow, the curvature of which is confined to the brooch's top half, the lower half being straight. Frequently tinned to give a silver appearance."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141240> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96662> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Knee Brooch"@en ;
    skos:scopeNote "A Roman Bow Brooch dating from the mid-second to mid-third centuries AD, characterized by the pronounced curvature of the bow, resembling a knee. Usually used by military personnel."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141241> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96662> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Langton Down Brooch"@en ;
    skos:scopeNote "A two-piece Bow Brooch dating from the early to mid-first century AD in Britain, originating in Gaul. Featuring a wide flat reeded bow, this and the Thistle Brroch were the first to conceal the spring mechanism with a cylindrical or semi-cylindrical hood."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141242> a skos:Concept ;
    skos:altLabel "Simple One-Piece Brooch"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96662> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Nauheim Derivate Brooch"@en ;
    skos:scopeNote "A simple, one-piece Bow Brooch with a spring of four coils, sometimes  less, its chord tucked beneath its head and variations to bow and catchplate. Dating from the first century AD."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141243> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/141227> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Saucer Brooch"@en ;
    skos:scopeNote "An Anglo-Saxon disc brooch featuring an upturned rim. Usually decorated with zoomorphic or geometric designs either chip-carved directly on the face or applied to a thin bronze plate affixed to the brooch's floor."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141244> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/141234> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Square Headed Brooch"@en ;
    skos:scopeNote "A highly decorated Anglo-Saxon Long Brooch, often made of silver or bronze, worn by women. Contemporary with the Cruciform Brooch, it features a large, square head plate and usually three rounded foot-terminals."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141245> a skos:Concept ;
    skos:altLabel "Rosette Brooch"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96662> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Thistle Brooch"@en ;
    skos:scopeNote "Early to mid-1st century AD Bow Brooch with a P-shaped profile, a cylindrical or semi-cylindrical spring cover and a round or lozenge-shaped centre plate with a short bow above and a flat leg below, both of which are reeded like the Langton Down Brooch."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141247> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96662> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Trumpet Brooch"@en ;
    skos:scopeNote "A Roman Bow Brooch, dating from the later 1st and 2nd centuries often worn in pairs with a linking chain. Characterized by its distinctive head, sometimes enamelled, and resembling the mouth of a trumpet."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141250> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97090> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Playing Card"@en ;
    skos:scopeNote "One of a pack, or deck, of cards used to play games, each distinguished from the others by markings on its face."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141434> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96662> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Polden Hill Brooch"@en ;
    skos:scopeNote "Bow Brooch derived from the Colchester type in the mid to late 1st and 2nd centuries AD. Typically the spring is held in a semi-cylindrical crossbar with closed ends and holding the axial bar and a hook or lug on the head to hold the chord."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141435> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96662> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "T-Shaped Brooch"@en ;
    skos:scopeNote "1st or 2nd century Bow Brooch derived from the Colchester. It typically has a pin hinged on a bar held in a cylindrical crossbar, the bow tapering and commonly decorated. Developed examples often have a headloop and enamelled panels."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141436> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/141232> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Two-Piece Colchester Brooch"@en ;
    skos:scopeNote "Derived from the Colchester in the mid to late 1st century, particularly in south and east Britain. Characterized by the attachment of the separate spring and pin through two holes in a lug behind the head, which projects to form a crest atop the bow."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141439> a skos:Concept ;
    skos:altLabel "Hook Norton Brooch"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96662> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Aesica Brooch"@en ;
    skos:scopeNote "A mid-1st century AD brooch influenced by the Thistle type, commonly with projections on the upper bow and widening to a triangular plate, often described as a fantail, below."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141441> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/141234> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Small Long Brooch"@en ;
    skos:scopeNote "A small, often of about two inches or less in length, version of the Long Brooch usually made of less expensive materials than other brooch types and frequently worn in pairs."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142087> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/142086> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Aerial Mine"@en ;
    skos:scopeNote "A mine designed specifically to be dropped from an aircraft, often into the sea."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142089> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/142088>,
        <http://purl.org/heritagedata/schemes/mda_obj/concepts/160139> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Aircraft Engine"@en ;
    skos:scopeNote "The engine housed within the fuselage of an aircraft that powers its flight."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142869> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/95144> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Bar Shot"@en ;
    skos:scopeNote "A pair of cannon balls joined by a solid bar."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142872> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97673> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Dice Shot"@en ;
    skos:scopeNote "Cube-shaped shot."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142873> a skos:Concept ;
    skos:altLabel "Spider Shot"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/142871> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Flail Shot"@en ;
    skos:scopeNote "A type of chain shot characterized by a number of chains attached to the main shot, causing maximum damage. Sometimes known as a Spider shot."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142874> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/95144> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Grape Shot"@en ;
    skos:scopeNote "A number of small iron balls, each about the size of a cricket ball, often numbering nine, wired together and bound in a canvas bag."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142875> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/95144> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Round Shot"@en ;
    skos:scopeNote "A solid, spherical projectile, originally made of stone but later iron."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142877> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/95070> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Rubble"@en ;
    skos:scopeNote "Pieces of undressed stone, waste fragments of stone or fragments of slate."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142878> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97593> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Shoe Making Waste"@en ;
    skos:scopeNote "Waste resulting from the processes associated with the making of shoes."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142879> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97593> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Wood Working Waste"@en ;
    skos:scopeNote "waste resulting from the working of wood or associated with a carpenter's workshop."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142881> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97225> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Wine Glass"@en ;
    skos:scopeNote "A drinking vessel, made of glass, designed expressly to be used for the consumption of wine."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142882> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/95070> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Log"@en ;
    skos:scopeNote "An unhewn piece of felled tree, or similar rough mass of wood."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142884> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/142895> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Mussel Shell"@en ;
    skos:scopeNote "The remains of a shell of a mussel."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142891> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/141201> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Mite Remains"@en ;
    skos:scopeNote "Use for ticks and true mites. Related to spiders, mites are widely present in archaeological deposits but are rarely studies in detail as they can prove difficult to identify."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142893> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/141200> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Cladoceran Remains"@en ;
    skos:scopeNote "Group of fresh water crustaceans which include the water fleas (Daphnia ssp.) the egg cases (ephippia) of which are found in archaeological deposits."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142894> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/141200> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Ostracod Remains"@en ;
    skos:scopeNote "Small crustaceans ranging in size from 0.2mm to 30mm and possessing a bivalve carapace or 'shell'."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142899> a skos:Concept ;
    skos:altLabel "Microfauna Remains"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/100098> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Small Mammal Remains"@en ;
    skos:scopeNote "Use for Insectivores (hedgehogs, shrews, moles), Chiroptera (bats) and rodents (squirrels, rats, voles, mice, dormice)."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142900> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97085> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Bacteria"@en ;
    skos:scopeNote "Microscopic living things, usually unicellular, occasionally multi-cellular. They lack cell nuclei."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142901> a skos:Concept ;
    skos:altLabel "Microfossil"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97085> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Diatoms"@en ;
    skos:scopeNote "Algae usually found as a silica skeleton. They obtain their food by photosynthesis and are used in ecological reconstruction."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142902> a skos:Concept ;
    skos:altLabel "Microfossil"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97085> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Dinoflagellates"@en ;
    skos:scopeNote "Simple organisms, mostly single celled, that move by means of two flagella (complex cellular projections). Most live as marine plankton, but some occur in fresh water. Members of the Kingdom Protista."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142903> a skos:Concept ;
    skos:altLabel "Microfossil"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97085> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Foraminifera"@en ;
    skos:scopeNote "Single celled marine organisms. Some form calcareous tests (shells). They are used archaeologically to study the nature of marine environments or establish the presence of marine conditions or products (e.g. imported seaweed)."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142904> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97085> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Fungi"@en ;
    skos:scopeNote "Kingdom of living things, lacking chlorophyll, that obtain their food from organic matter, usually by absorption. They include mushrooms, moulds and yeasts."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142907> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97085> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Food Residue"@en ;
    skos:scopeNote "Traces of food observed adhering to, or found within, an object or another material."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142909> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/100094> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Moss"@en ;
    skos:scopeNote "A simple type of plant. For most of their lifecycle they exist as haploids (i.e. only one set of genes as opposed to two). Most have clearly differentiated stems and leaves."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142910> a skos:Concept ;
    skos:altLabel "Microfossil"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97085> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Testate Amoebae"@en ;
    skos:scopeNote "Amoebae which are partially enclosed in external shells, or tests. Found in wet soils, freshwater, decaying organic matter and on vegetation such as mosses. Used to examine environmental factors such as water acidity and moisture content."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142913> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/142912> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Coversand"@en ;
    skos:scopeNote "Wind-blown sand."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142914> a skos:Concept ;
    skos:altLabel "Brickearth"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/142912> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Loess"@en ;
    skos:scopeNote "Wind-blown silt."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142915> a skos:Concept ;
    skos:altLabel "Alluvial Deposit"@en,
        "Waterlain Silt"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/142911> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Alluvium"@en ;
    skos:scopeNote "Deposits laid down as the result of river action."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142917> a skos:Concept ;
    skos:altLabel "Boulder Clay"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/142916> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Till"@en ;
    skos:scopeNote "Unsorted sediment (i.e. containing everything from clay to boulders) laid down directly by a glacier."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142919> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/142946> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Solifluction Deposit"@en ;
    skos:scopeNote "Deposits formed by the mass downward movement of surface deposits over underlying frozen ground under periglacial conditions."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142920> a skos:Concept ;
    skos:altLabel "Colluvial Deposit"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/142911> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Colluvium"@en ;
    skos:scopeNote "Deposits that accumulate at the bottom of a slope, at a break in a slope, or where a barrier is encountered."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142921> a skos:Concept ;
    skos:altLabel "Buried Soil"@en,
        "Palaeosol"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/142911> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Paleosol"@en ;
    skos:scopeNote "A soil, which may be buried or exposed, that has developed in a past landscape."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142922> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/142911> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Peat"@en ;
    skos:scopeNote "Material consisting of at least 90% organic matter by dry weight. Formed from plant material under damp, wet or acid conditions where the rate of accumulation is greater than the rate of decay."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142923> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/142911> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Tufa"@en ;
    skos:scopeNote "A rock-like deposit consisting largely of calcium carbonate, formed by the precipitation of calcium carbonate out of calcium-rich water bodies such as springs."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142925> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/142924> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Tephra"@en ;
    skos:scopeNote "Volcanic ash."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142926> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/142911> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Estuarine Deposit"@en ;
    skos:scopeNote "Use for deposits formed in estuaries."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142928> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/142927> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Gyttja"@en ;
    skos:scopeNote "Fine-grained, non-humified, organic mud formed under water. Principally composed of plant material, typically of faecal origin."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142929> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/142911> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Marine Deposit"@en ;
    skos:scopeNote "Use for deposits formed by the action of the sea or under marine conditions."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142930> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/142911> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Cave Deposit"@en ;
    skos:scopeNote "Use for deposits formed in caves."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142931> a skos:Concept ;
    skos:altLabel "Cultivation Soil"@en,
        "Garden Soil"@en,
        "Plough Soil"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/142911> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Agricultural Deposit"@en ;
    skos:scopeNote "Use for deposits formed as a result of the modification of soils by humans for agricultural purposes."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142932> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/142911> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Construction Deposit"@en ;
    skos:scopeNote "Use for deposits formed as a result of construction activities undertaken by humans or animals."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142933> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/142911> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Waste Deposit"@en ;
    skos:scopeNote "Use for deposits representing material discarded or remaining as a result of a process or processes."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/142976> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96360> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Staddle Stone"@en ;
    skos:scopeNote "One of several stones used to raise a farm building, such as a granary, above the ground surface."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/143006> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/95055> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Mill Paddle"@en ;
    skos:scopeNote "A paddle blade, typically of wood, from a horizontal or vertical mill wheel."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/143019> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96975> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Palm"@en ;
    skos:scopeNote "A sailmaker's thimble used in the sewing of canvas, consisting of a flat thimble in a canvas or leather strip with a thumb hole. The whole is worn across the palm of the hand, which gives it its name."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/143020> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/95305> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Octant"@en ;
    skos:scopeNote "An astonomical instrument, and navigational aid, in the form of one eighth of a circle and used to measure the angular altitude of heavenly bodies. Invented in 1731 and used into the 19th Century, it was superceded by the sextant."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/143024> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/143023> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Bouncing Bomb"@en ;
    skos:scopeNote "A cylindrical bomb, designed by Barnes Wallis in 1941, containing hydrostatic pistols measuring water pressure for detonation at a depth of 30 feet.  Dropped whilst fast revolving at a height of 60 feet at 240-250 mph to maximise the bouncing effect."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/143026> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/95831> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Nameboard"@en ;
    skos:scopeNote "An ornamental (carved and/or painted) frieze carved into, or attached to, the planking either side of a vessel's bow carrying the vessel's name and often illustrating some aspect of the name, port/country of origin etc."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/143027> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96321> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Deadlight"@en ;
    skos:scopeNote "A hinged plate of brass, iron or wood inboard of a ship's scuttle or porthole which can be lowered and secured with a butterfly nut to prevent damage to glass in heavy weather or mask internal light from enemy vessels."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/143028> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96256> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Hatchway Cover"@en ;
    skos:scopeNote "A water-tight cover that closes and opening in a vessel's deck used for the ingress and egress of persons and cargo."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/143029> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97692> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Porthole"@en ;
    skos:scopeNote "A hole or opening in a ship's hull to allow light and air to enter the vessel, or to aim a weapon through."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/143030> a skos:Concept ;
    skos:altLabel "Hosepipe"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96982> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Hose"@en ;
    skos:scopeNote "A flexible pipe, usually fixed to a pump or tap, for the conveying of water."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/143031> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97692> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Sheathing"@en ;
    skos:scopeNote "A covering of thin copper plates secured, on top of a layer of tar and horsehair, to the bottom of wooden ships to protect the hull against weeds, barnacles and especially Teredo navalis, a wood-boring worm prevalent in tropical seas."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/143225> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97227> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Griddle (Plate)"@en ;
    skos:scopeNote "A flat, circular plate, usually made of iron, on which food items are baked."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/143235> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97233> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Watch Glass"@en ;
    skos:scopeNote "A concave glass dish used to hold material for observation or experimentation; so named for its resemblance to the disc covering the face of a watch."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/143239> a skos:Concept ;
