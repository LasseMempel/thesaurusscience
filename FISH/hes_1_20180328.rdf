		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500526" />
		<skos:scopeNote xml:lang="en">A bridge over a canal.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
