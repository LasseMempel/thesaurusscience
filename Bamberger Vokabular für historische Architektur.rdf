        <skos:altLabel xml:lang="de">Agenda</skos:altLabel>
        <skos:altLabel xml:lang="de">Messbuch</skos:altLabel>
        <skos:altLabel xml:lang="fr">livre de messe</skos:altLabel>
        <skos:definition xml:lang="de">Missale n, auch Messbuch n, Agenda f: Buch für den zelebrierenden Priester, worin sämtliche Rubriken, alle Gebetstexte, Lesungen und Gesänge für die Messfeier verzeichnet sind; das Missale entstand aus der Zusammenfassung von Sakramentar, Lektionar und Graduale. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Missale</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">missel</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">misál</skos:prefLabel>
    </owl:NamedIndividual>
    


