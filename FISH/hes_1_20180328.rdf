		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/532">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/532</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH FO-THALAMH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Seòmar no trannsa a tha gu tur no gu ìre fon talamh. Gu tric co-cheangailte ri structar air uachdar na talmhainn.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SOUTERRAIN</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">EARTH HOUSE</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/405" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1952" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/406" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/409" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/445" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/458" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/461" />
		<skos:scopeNote xml:lang="en">A subterranean or partly subterranean chamber or passage. Often associated with an above ground structure.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
