        <skos:definition xml:lang="de">Historismus, hier besonders die Vermischung von Elementen verschiedener historischer Stile an einem einzigen Bauwerk. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Viz historismus, zde zvl. směšování prvků různých historických slohů v jednom architektonickém díle. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Eklektizismus</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">eklektismus</skos:prefLabel>
    </owl:NamedIndividual>
    


