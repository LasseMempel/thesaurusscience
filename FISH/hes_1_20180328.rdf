		<skos:prefLabel xml:lang="gd">CUARAIDH FELDSPAR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Dàrna roghainn a bhriathar. Cleachd CUARAIDH FELDSPAR.</skos:scopeNote>
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/501712">
