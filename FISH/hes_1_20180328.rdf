		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/35" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502174" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/578" />
