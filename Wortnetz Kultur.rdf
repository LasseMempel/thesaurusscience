		<skos:altLabel xml:lang="de">Garnhülsen</skos:altLabel>
		<skos:prefLabel xml:lang="de">Hülse (Gerät zur Textilerzeugung)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Hülsen (Geräte zur Textilerzeugung)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk016344"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk016344"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk009949"/>
		<skos:definition xml:lang="de">Eine Hülse ist eine Gerätschaft zur Textilerzeugung in Form einer Rolle aus meist Holz, Karton, Kunststoff oder Metall, auf die Faden oder Garn aufgewickelt wird. Die Hülse kann zylindrisch sowie mit oder ohne seitliche Begrenzungsscheiben oder konisch sein.</skos:definition>
		<skos:scopeNote xml:lang="de">Benutzt für den Tragkörper ohne das aufgewickelte Material. Für auf Hülsen aufgewickeltes Garn benutze &amp;quot;Spule (Gerät zur Textilerzeugung)&amp;quot; (wk009949).</skos:scopeNote>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300023485"/>
