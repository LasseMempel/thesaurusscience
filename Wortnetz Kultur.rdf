		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019757"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019937"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk005964"/>
		<xe:explanation_temp xml:lang="de">Es handelt sich oft um Relikte von Waldweidebeständen, die gezielt zur Viehmast mit Bucheckern oder Eicheln gepflanzt werden. Hutebäume zeichnen sich durch ihre großen, stark verzweigten und ausladenden Baumkronen aus.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Hutebaum ist ein Baum, der in Zusammenhang mit intensiver Beweidung durch Schweine, Kühe und Ziegen zu sehen ist.</skos:definition>
		<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1432660"/>
