        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_eieuwx7k"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-01T13:02:21.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T12:32:56.000</terms:modified>
        <skos:definition xml:lang="de">Kreuzerhöhung f; lat. exaltatio crucis: die Wiederaufrichtung des Kreuzes am 14. September 335 nach der Weihe der byzantinischen Doppelkirche und die dritte Aufrichtung durch den Kaiser Heraklios III. von Byzanz am 14. September 628. Gelegentlich auch Bezeichnung für die Kreuzauffindung. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Kreuzerhöhung</skos:prefLabel>
        <skos:prefLabel xml:lang="la">exaltatio crucis</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">exaltation de la Vraie Croix</skos:prefLabel>
        <skos:prefLabel xml:lang="en">exaltation of the True Cross</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_e213415e -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_e213415e">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
