    skos:closeMatch <http://d-nb.info/gnd/4174511-5>,
        <http://vocab.getty.edu/aat/300028484> ;
    skos:definition "Eine Fotokopie ist eine Reprografie, die durch elektrofotografische Verfahren mit elektrisch geladenem Farbpulver auf Papier erzeugt wird. Zur Herstellung von Fotokopien werden Kopiergeräte eingesetzt. Seit Mitte des 20. Jahrhunderts existiert dafür quasi ausschließlich das Verfahren der Xerokopie, davor gab es noch einige andere Verfahren zur Herstellung von Fotokopien."@de ;
    skos:exactMatch <http://vocab.getty.edu/aat/300136847>,
        <http://www.wikidata.org/entity/Q8011558> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Fotokopie"@de,
        "xerographic copy"@en .

