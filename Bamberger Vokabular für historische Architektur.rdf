        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-04T10:45:52.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T13:57:11.000</terms:modified>
        <skos:altLabel xml:lang="en">porch </skos:altLabel>
        <skos:altLabel xml:lang="cs">zádveří</skos:altLabel>
        <skos:definition xml:lang="de">Vorraum oder Vorbau an einer Außentür, der das Hausinnere gegen das Eindringen von Kälte schützt. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Windfang</skos:prefLabel>
        <skos:prefLabel xml:lang="en">draft lobby</skos:prefLabel>
        <skos:prefLabel xml:lang="it">ingresso protetto</skos:prefLabel>
        <skos:prefLabel xml:lang="es">porche</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">tambour (de porte)</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">závětří</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_bbb9e89b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_bbb9e89b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_2b8c8e23"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T14:04:20.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T14:21:39.000</terms:modified>
        <skos:altLabel xml:lang="de">Triumphwagen</skos:altLabel>
        <skos:definition xml:lang="cs">Kvadriga (lat. quadrigae = čtyřspřeží), řecký bojový vůz vzadu otevřený a tažený čtyřmi koňmi zapřaženými vedle sebe, v Římě používán jako závodní a triumfální vůz, od 4. stol. př. Kr. (mauzoleum v Helikarnasu) jako dekorativní zakončení staveb. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Quadriga (lat. quadrigae = Viergespann), von vier nebeneinander gespannten Pferden gezogener, nach hinten offener Streitwagen der Griechen. In Rom als Renn- und Triumphwagen verwendet. Seit dem 4. Jh. v. Chr. (Mausoleum von Halikarnassos) als dekorative Bekrönung auf Bauwerken. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Viergespann, bronzenes Gespann mit vier Pferden vor einem Streitwagen. Die Q. war oft auf einem Triumphbogen angebracht, doch sind nur die vier Pferde einer einzigen Q. aus der Antike erhalten (heute über dem Eingang von S. Marco in Venedig). Eine Q. aus klassizist. Zeit befindet sich z.B. auf dem Brandenburger Tor zu Berlin. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Quadriga</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kvadriga</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_bbbf2b23 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_bbbf2b23">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1f8af5be"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_98ebb48d"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-27T20:34:56.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T14:44:33.000</terms:modified>
        <skos:definition xml:lang="de">Pestblatt n: ein Einblattholzschnitt (seit 15. Jh.) mit der Darstellung eines Pestheiligen und mit Gebeten um Schutz gegen die Krankheit. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Pestblatt</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_bbc1878c -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_bbc1878c">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_ef163f2f"/>
