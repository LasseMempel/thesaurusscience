    <!-- https://hist-arch-vocab.org/bvha#c_a03ff29f -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_a03ff29f">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_c2e5f00d"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-16T10:55:20.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T16:22:32.000</terms:modified>
        <skos:altLabel xml:lang="de">Ehrenhof</skos:altLabel>
        <skos:altLabel xml:lang="cs">čestný dvůr</skos:altLabel>
        <skos:definition xml:lang="de">Cour d\&apos;honneur (frz.), der vom Corps de logis und den Communes (Nebenflügeln) dreiseitig umschlossene &gt;Ehrenhof&lt; eines Barock-Schlosses oder Hotelbaus, ausgebildet im frz. Renaissance-Schloss. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Hof, Corps de logis und zwei weitere Flügel umfassen den Cour dhonneur oder E. einer Dreiflügelanlage. In ihm fuhren die Wagen vor das Hauptportal, wo die Gäste das Schloss betraten. Der E. war meist an der vierten Seite von einem Gitter abgeschlossen. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:definition xml:lang="de">Von 3 Flügeln umschlossener Ehrenhof an der Stadtseite des Barockschlosses. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Čestný dvůr obklopený 3 křídly na městské straně barokního zámku. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Cour d\&apos;honneur</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">cour d\&apos;honneur</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_a04114a3 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_a04114a3">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0a02c60b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-03T14:36:11.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T16:14:48.000</terms:modified>
        <skos:definition xml:lang="de">Kleine Glattquader, die lediglich Längen von 20–40 cm und Höhen von 10–20 cm erreichen (max. 30 ─ 50 cm), d. h. handliche Formate. H. kennzeichnen das Mauerwerk an Burgen des 11. und 12. Jh.s (bis etwa 1180), wobei es auch später noch vereinzelt Mauerwerke mit H.n gibt. Manche Burgen des späten 12. und 13. Jh.s zeigen außen große Glattquader oder Buckelquader, innen dagegen H.; sie illustrieren dadurch den Übergang bzw. Wechsel in den Steinformaten. J. Z. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:prefLabel xml:lang="de">Handquader</skos:prefLabel>
    </owl:NamedIndividual>
    


