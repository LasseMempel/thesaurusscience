			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/501724">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/501724</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">ROILEAR-SMÙIDE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Còmhnardaiche rathaid a' thathar a' cleachdadh gus uachdar na talmhainn a dhèanamh rèidh 's e ag obair air cumhachd-smùide.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">STEAM ROLLER</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-04-12T16:32:52</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-10-02T11:56:08</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1010" />
				<skos:scopeNote xml:lang="en">A road roller powered by steam and used to level surfaces.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
