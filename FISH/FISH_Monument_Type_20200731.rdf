  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141944">
    <skos:scopeNote xml:lang="en">Place for the Home Guard to store equipment and amunition, either structural or subterranean during the defence of Britain.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/109354">
    <skos:scopeNote xml:lang="en">A missile base armed with the Thor Intermediate Range Ballistic Missile. Thor Missiles were deployed in Britain under joint British/US control between 1959 and 1964.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167078">
    <skos:scopeNote xml:lang="en">A non-profit making restaurant administered by a Local Food Committee which provided customers with good quality and wholesome food which could be purchased without ration coupons.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160235">
    <skos:scopeNote xml:lang="en">A distinctive, clerestory-roofed building of five 10ft bays, used for the drying, storage and packing of military parachutes and built to Air Ministry drawing number 11137/41.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142968">
    <skos:scopeNote xml:lang="en">A former ground surface buried beneath an earthwork or other sequence of deposits. (includes palaeosoils, turf lines)</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142083">
    <skos:scopeNote xml:lang="en">A tank found on hop farms in which creosote was held, heated from below by a fire with a chimney. The ends of hop poles were dipped in the tar to prevent rotting in soil.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68880">
    <skos:scopeNote xml:lang="en">A major fortified place, often a town, capable of containing a large force. If Roman use LEGIONARY FORTRESS.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160353">
    <skos:scopeNote xml:lang="en">A camp used for the accommodation of members of the Womens Auxiliary Air Force who undertook a variety of essential roles within the RAF to enable their male counterparts to fight more effectively.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/135318">
    <skos:scopeNote xml:lang="en">A court of summary jurisdiction formally recognized by statute in 1848. Renamed Magistrates Court, following legislation, in 1949.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92766">
    <skos:scopeNote xml:lang="en">A reinforced concrete structure, often sited underground, used as a shelter from the threat of nuclear attack.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68650">
    <skos:scopeNote xml:lang="en">An earthen bank indicating the limit of a plantation.</skos:scopeNote>
  </rdf:Description>
