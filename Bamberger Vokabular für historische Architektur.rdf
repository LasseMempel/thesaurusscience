        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:19:59.000</terms:modified>
        <skos:altLabel xml:lang="fr">berceau en quart-de-cercle</skos:altLabel>
        <skos:altLabel xml:lang="de">einschenklige Tonne</skos:altLabel>
        <skos:altLabel xml:lang="en">quadrant barrel vault</skos:altLabel>
        <skos:definition xml:lang="de">Asymmetrisches, von einem Viertelkreis gebildetes Tonnengewölbe. Zu unterscheiden vom Horngewölbe. [Glossarium Artis]</skos:definition>
