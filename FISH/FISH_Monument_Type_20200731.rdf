    <skos:scopeNote xml:lang="en">A garden house situated to provide a commanding view.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/145102">
    <skos:scopeNote xml:lang="en">A layer underneath the topsoil containing rubble or fragments of building material, e.g. mortar, tile, flint.</skos:scopeNote>
  </rdf:Description>
