    <!-- https://hist-arch-vocab.org/bvha#c_cad6a69f -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_cad6a69f">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
