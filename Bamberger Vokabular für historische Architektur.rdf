        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-07T11:48:40.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T00:00:31.000</terms:modified>
        <skos:definition xml:lang="de">Ein vom Hauptgebäude entfernter Parkpavillon. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Trianon</skos:prefLabel>
        <skos:prefLabel xml:lang="es">trianon</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">trianon</skos:prefLabel>
        <skos:prefLabel xml:lang="it">trianon</skos:prefLabel>
    </owl:NamedIndividual>
    


