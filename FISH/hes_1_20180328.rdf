		<skos:prefLabel xml:lang="gd">TAIGH EINNSEIN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach sa bheil einnsean. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
