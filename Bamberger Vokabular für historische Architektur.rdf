        <skos:prefLabel xml:lang="de">Rauchloch</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">dýmník, dýmný otvor</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_afa66dbe -->


