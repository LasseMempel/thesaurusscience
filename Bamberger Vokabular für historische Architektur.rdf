        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-14T15:54:08.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T17:50:25.000</terms:modified>
        <skos:note xml:lang="en">Change in colour or chemical structure by means of a chemical or physical reaction. [EwaGlos]</skos:note>
        <skos:note xml:lang="de">Veränderung der Farbe oder der chemischen Struktur durch chemische oder physikalische Reaktion. [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="de">Pigmentveränderung</skos:prefLabel>
        <skos:prefLabel xml:lang="en">pigment alteration</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_zy6firmv -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_zy6firmv">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_2b8c8e23"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_owbgpkqx"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-27T22:54:01.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T21:11:30.000</terms:modified>
        <skos:definition xml:lang="cs">1. Okrasný štít nad gotickými okny a portály, často na bocích s fiálami, vyplněný předsazenou slepou nebo prolamovanou kružbou, osazený kraby a kytkou. 2. Zubovitý nástavec na parapetní stěně cimbuří. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Wimperg, -e, 1. Ziergiebel über gotischen Fenstern und Portalen, oft von Fialen flankiert, mit vorgeblendetem oder durchbrochenem Maßwerk gefüllt, mit Krabben und Kreuzblume besetzt, verstärkt den Höhendrang der Gotik. 2. zahnartiger Aufsatz der Brüstungsmauer einer Zinne. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Wimperg, Giebelgebänk, giebelartige Bekrönung got. Portale und Fenster, die oft Maßwerkschmuck zeigt. Der W. wird von Krabben und Fialen gerahmt und von einer Kreuzblume abgeschlossen. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Wimperg</skos:prefLabel>
        <skos:prefLabel xml:lang="it">ghimberga</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">guimberge</skos:prefLabel>
        <skos:prefLabel xml:lang="es">remate hastial gótico</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">vimperk</skos:prefLabel>
    </owl:NamedIndividual>
    


