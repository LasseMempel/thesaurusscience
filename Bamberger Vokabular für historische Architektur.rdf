        <skos:altLabel xml:lang="fr">liturgie des heures canoniales</skos:altLabel>
        <skos:altLabel xml:lang="la">ministerialis liber</skos:altLabel>
        <skos:definition xml:lang="de">Brevier n, Breviarium n, liber breviarius, ministerialis liber, liturgia horarum: für den Geistlichen bestimmtes Buch mit dem Text des kirchlichen Stundengebetes; mancherorts sind im B. auch die Ordines für die Meßfeier enthalten. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="la"> [fr] liber breviarius</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Brevier</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">breviář</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">bréviaire</skos:prefLabel>
    </owl:NamedIndividual>
    


