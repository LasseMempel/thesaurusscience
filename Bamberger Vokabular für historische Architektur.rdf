        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-07T16:35:06.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-13T14:50:08.000</terms:modified>
        <skos:altLabel xml:lang="fr">fumée d\&apos;aromates</skos:altLabel>
        <skos:altLabel xml:lang="la">incensum</skos:altLabel>
        <skos:altLabel xml:lang="en">smoke of aromates</skos:altLabel>
        <skos:definition xml:lang="de">Weihrauch m; gr. thymiama; lat. incensum; russ. lada n: der duftende Rauch, der beim Verbrennen von Weihrauchkörnern, Thymian und Myrrhe etc. entsteht und der seit dem 4. Jh. bei liturgischen Inzensationen verwendet wird. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Weihrauch</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">fumée d\&apos;encens</skos:prefLabel>
        <skos:prefLabel xml:lang="ru">ladan</skos:prefLabel>
        <skos:prefLabel xml:lang="en">smoke of incense</skos:prefLabel>
        <skos:prefLabel xml:lang="la">thymiama</skos:prefLabel>
    </owl:NamedIndividual>
    


