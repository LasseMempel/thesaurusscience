        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T13:33:16.000</terms:modified>
        <skos:definition xml:lang="de">Turm über dem östl. oder westl. Joch des Seitenschiffs vor dem östl. oder westl. Querhaus. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Querhauswinkelturm</skos:prefLabel>
    </owl:NamedIndividual>
    


