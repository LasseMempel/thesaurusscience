	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1939">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1939</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CÒMHNARD LEACAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Uachdar rèidh, mar is trice airson coisichean no beathaichean, a tha nan leacan cloiche, concrait no stuth cruaidh rèidh eile.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PAVING</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1897" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1925" />
		<skos:scopeNote xml:lang="en">A level surface, usually for pedestrian or animal use, composed of flat slabs of stone, concrete or other hard material.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1940">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1940</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">POST-STÈIDHE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Co-phàirt structarail a tha na phost mòr dìreach (mar is trice fear fiodha) a chaidh a stobadh san talamh gus taic a chumail ri ùrlar togalaich no os-structar. Cleachd seòrsa nas mionaidiche de làrach ma tha fios cò tè.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PILE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-10-08T10:35:55</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1897" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1943" />
		<skos:scopeNote xml:lang="en">A structural component in the form of a substantial upright, usually wooden, driven into the ground to support a building platform or superstructure. Use more specific site type where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1943">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1943</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">POST</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Co-phàirt fiodha no meatailt airson togalach, gu tric na sheasamh dìreach san talamh 's e a' cumail suas mullach no os-structar eile. Cleachd seòrsa nas mionaidiche de làrach ma tha fios cò tè.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">POST</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-10-11T09:10:38</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1897" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1902" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1940" />
		<skos:scopeNote xml:lang="en">A building component of timber or metal placed vertically in the ground, often to support a roof or other superstructure. Use more specific site type where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1945">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1945</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">SUIDHEACHAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar air an taobh a-muigh air an dèanar suidhe.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SEAT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-12-06T11:11:30</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1897" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/506141" />
		<skos:scopeNote xml:lang="en">An external structure used to sit on.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1946">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1946</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TOLL</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Slighe dhìreach suas no sìos a bheir inntrigeadh no adhar gu cladhach no seòmar fon talamh. Na cleachd seo ach mur eil fios cò air a shon a bha e 's cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SHAFT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1948" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1897" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1947" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1196" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1197" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1955" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1989" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/826" />
		<skos:scopeNote xml:lang="en">A vertical passage which provides access or ventilation to an underground excavation or chamber. Use only if function is unknown, otherwise use specific term.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1947">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1947</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TOLL-ÈADHRACHAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Sloc gaothrachaidh fuadain.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">AIR SHAFT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
