        <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
        <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
        <skos:prefLabel xml:lang="en">Antonine</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Referring to the reign of the Roman emperor Antoninus Pius and his successors (from 138 CE) until the late 2nd century. Circa 138 CE to 192 CE.</skos:scopeNote>
        <skos:notation xml:lang="en">ROAN</skos:notation>
      </skos:Concept>
    </skos:narrower>

    <skos:narrower>
