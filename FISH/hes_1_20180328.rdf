		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/154" />
		<skos:scopeNote xml:lang="en">A building designed to house a lifeboat, usually with a stone ramp to launch the boat into the sea.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
