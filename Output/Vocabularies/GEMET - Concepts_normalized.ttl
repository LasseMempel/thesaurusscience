<http://www.eionet.europa.eu/gemet/concept/4262> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:closeMatch <http://data.uba.de/umt/_00022004> ;
    skos:definition "A justifiable claim granted by government or some other authority that offers protection or excludes others from making, using or selling an invention, a unique design of an article of manufacture or some other creation or discovery."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/2816> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Schutzrecht"@de,
        "industrial property right"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Intellectual_property> .

<http://www.eionet.europa.eu/gemet/concept/4268> a skos:Concept ;
