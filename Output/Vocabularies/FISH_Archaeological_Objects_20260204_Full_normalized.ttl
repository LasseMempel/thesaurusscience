    skos:prefLabel "Hollow Based Arrowhead"@en ;
    skos:scopeNote "An arrowhead with its base hollowed to allow it to fit onto the shaft of an arrow rather than having a tang that fits into the shaft."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141186> a skos:Concept ;
    skos:altLabel "Butchered Animal Bone"@en ;
