    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_1fa2b97f -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_1fa2b97f">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_ssnnb9kq"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-20T17:05:42.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-31T00:09:03.000</terms:modified>
        <skos:prefLabel xml:lang="de">Außenkanzel</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">venkovní kazatelna</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Kanzel am Außenbau einer Kirche, oft bei Wallfahrtskirchen. </skos:scopeNote>
        <skos:scopeNote xml:lang="de">Kanzel an der Außenwand einer Kirche, meist durch eine Tür vom Kircheninneren her, seltener über eine Treppe von außen zugängl., zur Predigt und Reliquienvorweisung, daher meist an Wallfahrtskirchen. Auch ein dem gleichen Zweck dienender offener Altan oder Balkon über einem Kirchenportal wird A. genannt. [Koepf / Binding 2016]</skos:scopeNote>
        <skos:scopeNote xml:lang="cs">Kazatelna zvl. v Itálii, rovněž u kostelů na poutních místech. [Koch 2008]</skos:scopeNote>
    </owl:NamedIndividual>
    


