    <skos:scopeNote xml:lang="en">A building used as a meeting place by a synod, an assembly of the clergy.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/132753">
