    <!-- https://hist-arch-vocab.org/bvha#c_867058de -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_867058de">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
