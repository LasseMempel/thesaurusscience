    <!-- https://hist-arch-vocab.org/bvha#c_84b25607 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_84b25607">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_63c4e0f5"/>
