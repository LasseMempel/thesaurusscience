        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-25T11:36:02.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T17:17:47.000</terms:modified>
        <skos:altLabel xml:lang="cs">kanelura</skos:altLabel>
        <skos:altLabel xml:lang="fr">pipe</skos:altLabel>
        <skos:altLabel xml:lang="cs">přípora</skos:altLabel>
        <skos:altLabel xml:lang="cs">výžlabek</skos:altLabel>
        <skos:definition xml:lang="de">Verstäbung, kleiner Rundstab, hauptsächl. am Säulenschaft, aber auch am Kapitell (P.kapitell) vorkommend und manchmal den unteren Teil der Kanneluren einer Säule füllend. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="fr"> godron</skos:prefLabel>
        <skos:prefLabel xml:lang="it"> rudente</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Pfeife</skos:prefLabel>
        <skos:prefLabel xml:lang="es">gallón</skos:prefLabel>
        <skos:prefLabel xml:lang="en">pipe</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">píštala</skos:prefLabel>
    </owl:NamedIndividual>
    


