        <skos:altLabel xml:lang="de">Ritsche</skos:altLabel>
        <skos:prefLabel xml:lang="de">Schiebeladen</skos:prefLabel>
        <skos:prefLabel xml:lang="it">imposta scorrevole</skos:prefLabel>
        <skos:prefLabel xml:lang="es">postigo corredizo</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">posuvná okenice</skos:prefLabel>
        <skos:prefLabel xml:lang="en">sliding shutter</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">volet à coulisse</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Horizontal oder vertikal verschiebarer Fensterladen.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Laden zum Verschluss einer Maueröffnung (Fenster), der im Gegensatz zum vertikal bewegten Fallladen horizontal verschiebbar ist. [Koepf /Binding 2016]</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_5db4dd70 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_5db4dd70">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
