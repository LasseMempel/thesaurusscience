<http://thesauri.dainst.org/_a131aa76> a skos:Concept ;
    skos:altLabel "Menschenaffen"@de ;
    skos:broader <http://thesauri.dainst.org/_054735bc> ;
    skos:definition "Der Term „Hominiden“ beinhaltet Familien von zweibeinigen Säugetieren, welche der Ordnung der Primaten zugehörig sind und sowohl den jüngsten Menschen als auch die ausgestorbenen Ahnen und verwandte Formen einfassen. (nach Wikipedia“ Lebewesen“ (https://de.wikipedia.org/wiki/Lebewesen 02.05.2018))"@de ;
    skos:inScheme <http://thesauri.dainst.org/scheme> ;
    skos:prefLabel "Hominiden"@de .

<http://thesauri.dainst.org/_e3a93fec> a skos:Concept ;
    skos:altLabel "Organic material"@en ;
    skos:broader <http://thesauri.dainst.org/_06103ab8> ;
    skos:definition "Aufgezählt sind Materialien, die Kohlenstoff beinhalten und solche, die von lebenden Organismen stammen (Getty AAT “organic material” ID 300011792)."@de ;
    skos:inScheme <http://thesauri.dainst.org/scheme> ;
    skos:prefLabel "Organische Materialien "@de,
        "other animal and vegetable materials"@en ;
    skos:related <http://thesauri.dainst.org/_9d8c9587> .

