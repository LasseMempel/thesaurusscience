<http://www.eionet.europa.eu/gemet/concept/12446> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7740> ;
    skos:closeMatch <http://data.uba.de/umt/_00021783> ;
    skos:definition "Usually anaerobic sludge digestion, a treatment that stabilizes raw sludge. Fully digested sludge has little readily biodegradable organic matter. It is not smelly and about 50% of the solids are inorganic. Sludge can also be digested aerobically."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Schlammstabilisierung"@de,
        "sludge stabilisation"@en .

