        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-13T13:51:36.000</terms:modified>
        <skos:definition xml:lang="de">Beim primitiven Dachhaus reichten die Rofen – Stangenrofen – bis auf den Erdboden. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Stangenrofen</skos:prefLabel>
