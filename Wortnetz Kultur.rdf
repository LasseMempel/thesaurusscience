		<skos:prefLabel xml:lang="de">Haarnadel</skos:prefLabel>
		<skos:altLabel xml:lang="de">Haarnadeln</skos:altLabel>
		<skos:altLabel xml:lang="en">hair pin</skos:altLabel>
