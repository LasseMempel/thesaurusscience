				<dcterms:identifier>http://purl.org/heritagedata/schemes/2/concepts/505642</dcterms:identifier>
				<skos:prefLabel xml:lang="en">BOUNCING BOMB</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-12-10T09:55:41</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-12-10T09:56:27</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:56:41</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/2/concepts/505641" />
				<skos:scopeNote xml:lang="en">A cyclindrical bomb, designed by Barnes Wallis in 1941, containing hydrostatic pistols measuring water pressure for detination at a depth of 30 feet. Dropped whilst fast revolving at a height of 60 feet at 240-250 mph to maximise the bouncing effect.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:scopeNote xml:lang="en">A hollow case containg explosive, incendiary, smoke-producing, poisonous or other offensive material, designed to be deposited, dropped, thrown or shot froma mortar.</skos:scopeNote>
