    <!-- https://hist-arch-vocab.org/bvha#c_4517cd1a -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_4517cd1a">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
