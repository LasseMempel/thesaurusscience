        <skos:altLabel xml:lang="de">Bundsäule</skos:altLabel>
        <skos:definition xml:lang="de">Säule mit durch ringförmige Zwischenglieder (Schaftring, Bund, Wirtel) unterteiltem Schaft. [Koepf/Binding 2016]</skos:definition>
