<https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme/concept417> a skos:Concept ;
    skos:broader <https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme/concept416> ;
    skos:definition "Over the past decades, the spatial resolution of satellite imagery has improved considerably from equivalent ground pixel sizes of 80m for ERTS, to 0.41m for the latest products from the GeoEye-1 satellite. This dramatic improvement in the quality of satellite remote sensed products, together with the increasing improvements in access to satellite image archives over the Internet, has resulted in satellite imagery becoming an important component of the aerial archaeologist’s toolkit."@en ;
    skos:inScheme <https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme> ;
    skos:prefLabel "Satellitenbilder"@de,
        "satellite imaging"@en .

