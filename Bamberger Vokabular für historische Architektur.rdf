        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-14T12:44:05.000</terms:modified>
        <skos:definition xml:lang="de">Fest mit der Mauer verbundener Teil des Fensters, Fensterstock, an dem die Flügel befestigt sind. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Holzgerüst, das in die Fensteröffnung eingesetzt ist. Es wird von Schenkeln und der Innenkonstruktion gebildet und ist Träger der Fensterflügel und der Festverglasung. [Noky 1996]</skos:definition>
        <skos:prefLabel xml:lang="de">Fensterrahmen</skos:prefLabel>
    </owl:NamedIndividual>
    


