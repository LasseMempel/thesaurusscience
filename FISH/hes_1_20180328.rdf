		<skos:prefLabel xml:lang="gd">BATARAIDH TRÈANAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far a bheil gunnachan no gunnachan-mòra air am munntachadh airson trèanadh. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PRACTICE BATTERY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
