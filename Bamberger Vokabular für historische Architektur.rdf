    <!-- https://hist-arch-vocab.org/bvha#c_5d9b780a -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_5d9b780a">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_70f41797"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_dd883e1f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_b9e0a442"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_bdf7b7aa"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-28T15:04:36.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T14:32:23.000</terms:modified>
        <skos:altLabel xml:lang="de">Ausschuss</skos:altLabel>
        <skos:altLabel xml:lang="de">Schusserker</skos:altLabel>
        <skos:altLabel xml:lang="de">Wehrerker</skos:altLabel>
        <skos:definition xml:lang="de">Erkerartiger, gemauerter oder hölzerner Vorbau mit Schießscharten, auch mit Senkscharten, ähnl. dem auf der Ecke angebrachten und zumeist höheren Scharwachtturm [Koepf /Binding 2016]. </skos:definition>
        <skos:definition xml:lang="de">Unten offener Erker an der Feldseite der Wehrmauer oder eines Gebäudes, häufig über dem Tor, um den Feind von oben direkt zu bekämpfen (z. B. durch Steinwürfe). Aufgrund der im 19. Jh. aufgekommenen irrigen Vorstellung, man hätte heißes Pech aus ihnen gegossen, häufig fälschlich als »Gusserker« (»Pechnase«) mit »Gussloch« bezeichnet. Im Scheitel eines Torgewölbes hat der W. eher die Funktion einer Kommunikationsöffnung (Marksburg RP), da durch solch kleine Öffnungen keine effektive Bekämpfung eingedrungener Angreifer möglich war. S. a. Maschikuli. M. L. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:prefLabel xml:lang="de">Schießerker</skos:prefLabel>
        <skos:prefLabel xml:lang="it">bertesca</skos:prefLabel>
        <skos:prefLabel xml:lang="es">salidizo de tiro</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_5d9e176d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_5d9e176d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
