  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71668">
    <skos:scopeNote xml:lang="en">A garden consisting primarily of rocks and rock plants.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68943">
    <skos:scopeNote xml:lang="en">A building or buildings ranged around a courtyard on at least three sides. They occur in the Iron Age, as well as being an influential plan type of house from the 15th century onwards. Index with appropriate period.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69259">
    <skos:scopeNote xml:lang="en">A building containing mechanically powered ore crushers or rollers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/100023">
