        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_3d4de19b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_89abf723"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-27T19:13:27.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T16:54:04.000</terms:modified>
        <skos:definition xml:lang="de">Ablassbrief m: eine Bescheinigung der Kirchenbehörde, die bei Kirchenfesten, Wallfahrten und HeiItumsweisungen ausgegeben und in der für einen festgelegten Zeitraum ein Ablass erteilt wurde. Man erhielt z. B. beim Besuch des Großmünsters in Zürich am Tage der Kirchweihe einen vierzigtägigen Ablass. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Ablassbrief</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">bulle d\&apos;indulgence</skos:prefLabel>
        <skos:prefLabel xml:lang="en">letter of indulgence</skos:prefLabel>
    </owl:NamedIndividual>
    


