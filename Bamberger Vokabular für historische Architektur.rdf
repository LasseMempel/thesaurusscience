        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-05T21:44:29.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T18:12:03.000</terms:modified>
        <skos:definition xml:lang="en">External factors, which may be natural or anthropogenic, bringing about deterioration. [EwaGlos]</skos:definition>
        <skos:definition xml:lang="de">Externe Faktoren, die natürlich oder anthropogen sein können, verursachen Zerfall. [EwaGlos]</skos:definition>
