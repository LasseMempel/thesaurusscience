	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502127">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502127</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">DÙDACH CEÒTHA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar a gheibhear air taighean-solais, làimhrigean is msaa a tha comasach air fuaim àrd a dhèanamh mar rabhadh do bhàtaichean nuair a bhios an aimsir ceòthach.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">FOG HORN</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-15T08:45:17</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-15T08:46:03</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">FOG SIGNAL</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1425" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/260" />
		<skos:scopeNote xml:lang="en">A structure found on lighthouses, piers, etc, capable of emitting a loud noise to warn shipping in foggy weather.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
