	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004141">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Calefactoria</skos:altLabel>
		<skos:altLabel xml:lang="de">Calefactorien</skos:altLabel>
		<skos:prefLabel xml:lang="de">Calefactorium</skos:prefLabel>
		<skos:prefLabel xml:lang="es">calefactorium</skos:prefLabel>
		<skos:altLabel xml:lang="en">calefactory</skos:altLabel>
		<skos:prefLabel xml:lang="it">calefattorio</skos:prefLabel>
		<skos:prefLabel xml:lang="fr">chauffoir</skos:prefLabel>
		<skos:altLabel xml:lang="de">Wärmestube</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003128"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk006097"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk014413"/>
		<gvp:aat2801_conjuncted_with rdf:resource="http://lvr.vocnet.org/wnk/wk000782"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk004142"/>
		<skos:scopeNote xml:lang="de">Benutzt für einen verhältnismäßig kleinen Raum neben dem Refektorium; für große, beheizbare Räume unter dem Dormitorium, die zugleich als Aufenthalts- und Arbeitsraum dienen, wird Pisalis (wk004142) verwendet.</skos:scopeNote>
		<skos:definition xml:lang="de">Ein Calefactorium ist ein Raum, der einem Kloster als Wärmestube dient und im Mittelalter häufig der einzige beheizbare Raum des Klosters ist.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk006097"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk014413"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-08-11T14:20:25+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004142">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Auditorium</skos:altLabel>
		<skos:altLabel xml:lang="de">Bruderhalle</skos:altLabel>
		<skos:altLabel xml:lang="de">Brüdersaal</skos:altLabel>
		<skos:altLabel xml:lang="de">Fraternei</skos:altLabel>
		<skos:altLabel xml:lang="de">Mönchssaal</skos:altLabel>
		<skos:altLabel xml:lang="de">Pisale</skos:altLabel>
		<skos:prefLabel xml:lang="de">Pisalis</skos:prefLabel>
		<skos:prefLabel xml:lang="en">pisalis</skos:prefLabel>
		<skos:altLabel xml:lang="de">Pysale</skos:altLabel>
		<skos:altLabel xml:lang="de">pysalis</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003128"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk006098"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk014413"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk000782"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk004141"/>
		<xe:explanation_temp xml:lang="de">Zunächst liegt er im gesamten Ostflügel unter dem Dormitorium (St. Galler Klosterplan). Anscheinend nimmt der Kapitelsaal ab dem 11. Jahrhundert (Cluny 2) einen Teil des Ostflügels ein. Die Pisalis ist vom Calefactorium zu unterscheiden, das vornehmlich in Zisterzienserklöstern als nur kurzzeitig zu nutzende Wärmestube dient, deutlich kleiner ist als die Pisalis und neben dem Refektorium im Südflügel liegt.</xe:explanation_temp>
		<skos:definition xml:lang="de">Eine Pisalis ist ein Raum, der beheizbar ist, sowohl dem Aufenthalt als auch der Arbeit dient und sich vor allem in Klöstern findet.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk006098"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk014413"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-11-08T16:51:20+01:00+01:00</dcterms:modified>
	</skos:Concept>
