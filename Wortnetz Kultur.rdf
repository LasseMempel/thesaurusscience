		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004143"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk001962"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk005956"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk005927"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk008194"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk020441"/>
