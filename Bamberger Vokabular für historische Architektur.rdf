        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-13T14:02:08.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T15:28:43.000</terms:modified>
        <skos:altLabel xml:lang="de">Fleckling</skos:altLabel>
        <skos:definition xml:lang="de">Kanthölzer (regional: Fleckling) sind stärker dimensioniert als Latten und weisen quadratische oder leicht rechteckige Querschnitte auf. [Eißing et al. 2012]</skos:definition>
        <skos:prefLabel xml:lang="de">Kantholz</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_f99ea647"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_e2da6bd0 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_e2da6bd0">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_66eeb4d6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_qojdlphd"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T15:29:49.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T15:31:52.000</terms:modified>
        <skos:definition xml:lang="de">Die geistige Haltung in den germanischen Ländern in der 1. Hälfte des 19. Jhs., die dem rational gerichteten Klassizismus eine oft schwärmerische Natur- und Gefühlsbetonung entgegensetzt. Sie bringt keinen eigenen umfassenden Kunststil zustande. Ihre Begeisterung für die Geschichte versucht ohne Glück, vergangene Architektur-Stile neu zu beleben (Historismus). [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Kulturní směr první poloviny 19. stol., který proti racionálně zaměřeného klasicismu staví často až vášnivé zdůrazňování přírody a citů; nevytvořil žádný vlastní celkový umělecký sloh, jeho nadšení pro historii vyústilo v neúspěšné pokusy o oživení historických architektonických slohů (viz historismus). [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Romantik</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">romantismus</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_e2e144d7 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_e2e144d7">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_9f0efb23"/>
