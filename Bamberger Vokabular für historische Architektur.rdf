    <!-- https://hist-arch-vocab.org/bvha#c_58a24ed4 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_58a24ed4">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_4mgalztg"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_7hgs39ux"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_9jb9am2u"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_4f3228a9"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_bbe43d47"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_pjvitn4h"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-15T17:44:07.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T14:58:43.000</terms:modified>
        <skos:altLabel xml:lang="de">Binder</skos:altLabel>
        <skos:altLabel xml:lang="de">Medium</skos:altLabel>
        <skos:note xml:lang="de">Im Bauwesen pulverförmige mineral. Stoffe (Zement, Kalk, Gips) zur dauerhaften Verbindung von Baumaterialien, die, mit einer Flüssigkeit, zumeist Wasser, zu Mörtel angemacht, aufgrund chem. Vorgänge erhärten: hydraul. B. erhärten auch unter Wasser, während nichthydraul. B. nur an der Luft erhärten und auch keine wasserbeständigen Verbindungen bilden. [Koepf / Binding 2016]</skos:note>
        <skos:note xml:lang="de">Material mit adhäsiven und kohäsiven Eigenschaften, das alle Partikel eines Füllstoffes oder Pigmentes benetzt und eine zusammenhängende Masse bildet. [EwaGlos]</skos:note>
        <skos:note xml:lang="en">Material with adhesive and cohesive properties, which coats all particles of a filler or pigment and builds a coherent mass. [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="de">Bindemittel</skos:prefLabel>
        <skos:prefLabel xml:lang="en">binder</skos:prefLabel>
    </owl:NamedIndividual>
    


