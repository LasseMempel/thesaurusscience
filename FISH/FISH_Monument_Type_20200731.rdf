  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141166">
    <skos:scopeNote xml:lang="en">A place where telephones and their components are manufactured</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87934">
    <skos:scopeNote xml:lang="en">A laundry built in conjunction with a PUBLIC BATHS.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/111213">
    <skos:scopeNote xml:lang="en">An inn, with an integral courtyard, for the lodging and entertainment of travellers. Often with open galleried wings overlooking the courtyard.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91436">
    <skos:scopeNote xml:lang="en">The residence of a chauffeur or driver</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70123">
    <skos:scopeNote xml:lang="en">A residence used during short visits by an official and attendants of the Knights Templars for administrative purposes on their estates.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93538">
    <skos:scopeNote xml:lang="en">To mark the end of a turnpike road.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69253">
    <skos:scopeNote xml:lang="en">Building or structure housing a buddle.</skos:scopeNote>
  </rdf:Description>
