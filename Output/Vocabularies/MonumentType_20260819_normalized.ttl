    skos:scopeNote "Any factory used for the manufacture of textiles."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/102872> a skos:Concept ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "MONUMENT <BY FORM>"@en ;
    skos:scopeNote "Sites, buildings, structures & features categorized by their form rather than their function, where this has been deemed to be useful for retrieval purposes. Careful consideration will be given to the inclusion of new terms within this class."@en ;
    skos:topConceptOf <http://purl.org/heritagedata/schemes/eh_tmt2> .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93090> a skos:Concept ;
    skos:altLabel "Transport Site"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70204> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "RAILWAY TRANSPORT SITE"@en ;
    skos:scopeNote "Buildings, sites and structures associated with railway transport."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68808> a skos:Concept ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "DEFENCE"@en ;
    skos:scopeNote "Sites, buildings, structures & features used in the defence of the civilian population. Includes civil defence sites, weapons stores, training sites, military signals & active defence structures such as anti-aircraft sites."@en ;
    skos:topConceptOf <http://purl.org/heritagedata/schemes/eh_tmt2> .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70416> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99961> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "STREET FURNITURE"@en ;
    skos:scopeNote "Structures erected on or near a public highway."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69047> a skos:Concept ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "INDUSTRIAL"@en ;
    skos:scopeNote "Sites, buildings, structures & features related to the extraction, processing & manufacture of finished goods. Includes structures associated with the supply, storage &/or transmission of power."@en ;
    skos:topConceptOf <http://purl.org/heritagedata/schemes/eh_tmt2> .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68543> a skos:Concept ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "AGRICULTURE AND SUBSISTENCE"@en ;
    skos:scopeNote "Sites, buildings, structures, features and areas of land associated with cultivation, the rearing of livestock, gathering, hunting & fishing. Includes farm based processing of foodstuffs & storage of agricultural produce."@en ;
    skos:topConceptOf <http://purl.org/heritagedata/schemes/eh_tmt2> .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68675> a skos:Concept ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "CIVIL"@en ;
    skos:scopeNote "Sites, buildings, structures etc associated with the civil administration of settlements & enforcement of the laws of the land. Includes local & central government, settlements granted by the crown or ruling administration does not manorial settlements."@en ;
    skos:topConceptOf <http://purl.org/heritagedata/schemes/eh_tmt2> .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70551> a skos:Concept ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "RECREATIONAL"@en ;
    skos:scopeNote "Sites, buildings, structures, features & areas of land associated with sport, leisure & entertainment. Includes sports grounds, hunting forests, cinemas, theatres etc."@en ;
    skos:topConceptOf <http://purl.org/heritagedata/schemes/eh_tmt2> .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70306> a skos:Concept ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "UNASSIGNED"@en ;
    skos:scopeNote "Sites, buildings, structures, features & areas of land, both natural & man-made, which cannot be assigned to a particular class (for example, railings)."@en ;
    skos:topConceptOf <http://purl.org/heritagedata/schemes/eh_tmt2> .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93153> a skos:Concept ;
