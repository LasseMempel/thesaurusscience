<http://lvr.vocnet.org/wnk/wk021257> a skos:Concept ;
    skos:altLabel "Muschelkrebs"@de,
        "Muschelkrebse"@de,
        "Ostracoden"@de,
        "Ostrakoden"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk021305> ;
    skos:definition "Ein Ostrakode ist ein kleines Krebstier mit einem zweiklappigen Gehäuse. Ostrakoden bewohnen fast alle aquatischen Biotope und sind in der Paläontologie wichtige Leitfossilien."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Ostrakode"@de .

