    <!-- https://hist-arch-vocab.org/bvha#c_03b12eaf -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_03b12eaf">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_6c44457b"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_7a3e643f"/>
