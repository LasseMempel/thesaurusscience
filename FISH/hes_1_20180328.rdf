		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1231" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1233" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1235" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1242" />
