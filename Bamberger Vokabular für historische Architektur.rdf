    <!-- https://hist-arch-vocab.org/bvha#c_e8565f86 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_e8565f86">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_541f6da4"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_7c0b4654"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_c11523f4"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T15:15:52.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-20T15:08:47.000</terms:modified>
        <skos:definition xml:lang="de">Scherzhafte Verbindung von V. v. Scheffels »Biedermann« und »Bummelmaier«, zwei deutschen Philistertypen (1848 in den » Fliegenden Blättern«). Bezeichung für den Lebens- und Wohnstil im deutschen »Vormärz« (1815-48). Das Biedermeier entwickelt zwar keine eigene Architektur oder Großplastik, wohl aber eigene Möbelkunst und Malerei. Das klassizistische Empire-Möbel wird zweckmäßig vereinfacht, vorzügliche Verarbeitung gemaserter Hölzer (Kirsche, Mahagoni, hell getönt) und gestreifter oder geblümter Bezugsstoffe sowie ein weicher Schwung der Linien geben ihm das bis heute beliebte Gepräge. In der Malerei vertreten Spitzwegs gütiger Kleinstadt-Humor, Waldmüllers unpathetische Naturbilder und Oldachs Bildnisse gediegener Bürgertypen den Biedermeierstil. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Žertovné spojení dvou německých šosáckých typů od spisovatele V. v. Scheffela „Biedermann&quot; a „Bummelmeier&quot; (1848 v časopise Fliegende Blatter). Označení zvl. pro styl života a bydlení v Německu v tzv. předbřeznovém období (1815-48). Biedermeier sice nerozvinul žádnou vlastní architekturu ani velkou plastiku, ale vytvořil vlastní umění nábytku a malířství. Klasicistický empírový nábytek byl účelně zjednodušen, vynikající zpracování žilkovaného dřeva (třešeň, mahagon, světlé tónování) a pruhované, nebo květované potahové látky, a rovněž citlivé zakřivení linií mu dodalo dodnes oblíbený charakter. V malířství zastupuje biedermeier Spitzwegův dobromyslný maloměstský humor, Waldmiillerovy nepatetické přírodní obrazy a Oldachovy portréty podařených měšťanských typů. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Biedermeierstil</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">biedermeier</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_e859abdb -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_e859abdb">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0a8ac0b9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_ca605999"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-05T12:47:30.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T11:50:22.000</terms:modified>
