        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-18T16:43:39.000</terms:modified>
        <skos:definition xml:lang="de">Profiliertes Holz zur Gestaltung ohne konstruktive Aufgabe, z. B. Pfostenzierholz, Querzierholz. [Noky 1996]</skos:definition>
