    <!-- https://hist-arch-vocab.org/bvha#c_89024b9b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_89024b9b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_7acece55"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_d6df06d8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-24T18:34:39.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-18T14:01:02.000</terms:modified>
        <skos:definition xml:lang="de">Ölmalerei, Farbpigmente in flüchtigen Ölen (Terpentinöl), Benzin usw. gelöst. Bindemittel: Lein-, Mohn-, Nussöl. Lasierend oder deckend aufgetragen. Trocknet durch Verdunsten des Lösungsmittels und Oxydation des Öls zu hygroskopischem Linoxyn. Seit 15. Jh., besonders für Tafelmalerei, zunächst nur auf Holz, später auf Leinen, auch Pappe, Kupfer, für Wandmalerei auf trockenen Putz. Bei den modernen Binderfarben werden Kunstharze als Bindemittel verwendet. [Koch 2009]</skos:definition>
        <skos:note xml:lang="en">A technique which uses pigments mixed with drying oils (e.g. linseed or walnut oil), sometimes with the addition of resin and siccative. [EwaGlos]</skos:note>
        <skos:note xml:lang="de">Eine Maltechnik, für die Pigmente, vermischt mit trocknenden Ölen (z.B. Leinöl oder Walnußöl), verwendet werden, die manchmal mit Harz und Sikkativ versetzt sind. [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="en">oil painting</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">olejomalba</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Ölmalerei</skos:prefLabel>
    </owl:NamedIndividual>
    


