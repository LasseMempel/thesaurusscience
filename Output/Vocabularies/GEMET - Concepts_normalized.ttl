    skos:related <http://www.eionet.europa.eu/gemet/concept/6884> .

<http://www.eionet.europa.eu/gemet/concept/7044> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:closeMatch <http://data.uba.de/umt/_00015325>,
        <http://dbpedia.org/resource/Refrigeration> ;
    skos:definition "The cooling of substances, usually food, below the environmental temperature for preservative purposes. Refrigeration is responsible for the largest and fastest-growing use of CFCs in the developing world. The industrial countries, and some developing countries, have taken exceptional steps to control and, eventually, ban the production of CFCs and other ozone-depleting materials by the year 2000. However, many developing nations have not signed the Montreal Protocol because they are afraid that the cost of changing over to alternative, ozone-friendly technology will be too high."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_6485> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Kühlung"@de,
        "refrigeration"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/1781> .

<http://www.eionet.europa.eu/gemet/concept/7050> a skos:Concept ;
    skos:broadMatch <http://eurovoc.europa.eu/4654> ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5390> ;
    skos:closeMatch <http://data.uba.de/umt/_00017552> ;
    skos:definition "Special vehicles designed and equipped for the collection of wastes and their transportation to a waste disposal site."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Müllsammelfahrzeug"@de,
