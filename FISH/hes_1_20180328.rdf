				<skos:scopeNote xml:lang="gd">Togalach beag sa bheil duille-dhoras a chumas smachd air sruthadh an uisge à uisgeadan slighe cladhan inbhir canail a dh'ionnsaigh canail.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">VALVE HOUSE</skos:prefLabel>
