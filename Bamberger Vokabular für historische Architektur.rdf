        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T22:46:28.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T17:39:11.000</terms:modified>
        <skos:altLabel xml:lang="de">Fächerbogen</skos:altLabel>
        <skos:altLabel xml:lang="de">Zackenbogen</skos:altLabel>
        <skos:altLabel xml:lang="fr">arc (à réseau d\&apos;intrados) polylobé</skos:altLabel>
        <skos:altLabel xml:lang="fr">arc chevronné</skos:altLabel>
        <skos:altLabel xml:lang="es">arco encabriado</skos:altLabel>
        <skos:altLabel xml:lang="en">chevron arch</skos:altLabel>
        <skos:altLabel xml:lang="cs">laločnatý oblouk</skos:altLabel>
        <skos:altLabel xml:lang="en">multifoiled arch</skos:altLabel>
        <skos:altLabel xml:lang="en">quatrefoil arch</skos:altLabel>
        <skos:definition xml:lang="de">Eine dem Kleeblattbogen ähnelnde Bogenform mit mehreren, symmetrisch angesetzten, konvexen Kreisbogen, die auch unterschiedlich dimensioniert sein können. Manchmal wird diese Form auch nach den kleinen Vorsprüngen zwischen den Pässen Nasenbogen oder vielnasiger Kleeblattbogen genannt. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Fächerbogen, Vielpass- oder Zackenbogen, aus mehreren, fächerförmig angeordneten Kreisbogen bestehender Bogen, bes. in der islam. und spätroman. Baukunst. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Vielpass-, Fächerbogen; Bogen mit zahlr. rahmenden Pässen an der Laibung (Bogenformen). [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Zacken- oder Fächerbogen, eine Bogenform mit zahlr. rahmenden Pässen an der Laibung. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Vielpassbogen</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">arc polylobé</skos:prefLabel>
        <skos:prefLabel xml:lang="it">arco polilobato</skos:prefLabel>
        <skos:prefLabel xml:lang="es">arco polilobulado</skos:prefLabel>
        <skos:prefLabel xml:lang="en">multifoil arch</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">vícelaločný oblouk</skos:prefLabel>
    </owl:NamedIndividual>
    


