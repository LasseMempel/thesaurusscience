    <!-- https://hist-arch-vocab.org/bvha#c_cd3792f1 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_cd3792f1">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1fcb2666"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-25T10:29:00.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-26T13:56:47.000</terms:modified>
        <skos:altLabel xml:lang="cs">žebrový strop</skos:altLabel>
        <skos:definition xml:lang="de">Massivdecke aus Stahlbeton. Die an der Untersicht in kurzen Abständen vortretenden schlanken Rippen und die quer darüber verlegte Deckenplatte bilden eine stat. Einheit. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="es"> cielo nervado</skos:prefLabel>
        <skos:prefLabel xml:lang="fr"> plancher à nervures</skos:prefLabel>
        <skos:prefLabel xml:lang="en"> ribbed ceiling</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Rippendecke</skos:prefLabel>
        <skos:prefLabel xml:lang="it">soletta nervata</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">žebírkový strop</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_cd3a4921 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_cd3a4921">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0a18e053"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_64dd3656"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_aa790c5e"/>
