		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/629" />
		<skos:scopeNote xml:lang="en">A building used for the storage and recharging of battery-powered miners lamps.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
