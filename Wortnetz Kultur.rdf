	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk020776">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Boxhandschuh</skos:prefLabel>
		<skos:altLabel xml:lang="de">Boxhandschuhe</skos:altLabel>
		<skos:prefLabel xml:lang="en">boxing glove</skos:prefLabel>
		<skos:altLabel xml:lang="en">boxing gloves</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk009370"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk009370"/>
		<skos:definition xml:lang="de">Ein Boxhandschuh ist ein Sportgerät, das für den Einsatz beim Boxen entwickelt wurde. Boxhandschuhe haben in der Regel eine dicke Polsterung aus Schaumstoff oder Gel, die den Aufprall von Schlägen abfängt und in erster Linie die Hände schützt. Oft werden sie aus Leder oder synthetischen Materialien wie Vinyl oder Kunstleder gefertigt. Sie werden entweder mit einem Schnürverschluss, häufig aber auch mit einem Klettband geschlossen. Zum Verschließen benötigt man stets eine zweite Person.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/page/aat/300421034"/>
		<skos:exactMatch rdf:resource="https://www.wikidata.org/w/index.php?title=Q895679&amp;oldid=1828256464"/>
