        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-17T10:42:12.000</terms:modified>
        <skos:definition xml:lang="de">Mauerwerk, bei dem nur die Außenseiten im Steinverband (zweihäuptig) ausgeführt sind. Das Innere ist mit lose geschichteten, unregelmäßigen Steinen, mit Schotter, Kies oder Asche etc. ausgefüllt. (Glossarium Artis, Bd. 3, Bögen und Mauerwerk)</skos:definition>
        <skos:prefLabel xml:lang="cs">dvouplášťové zdivo</skos:prefLabel>
        <skos:prefLabel xml:lang="de">zweischaliges Mauerwerk</skos:prefLabel>
