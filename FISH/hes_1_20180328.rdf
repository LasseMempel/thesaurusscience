		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/266" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/347" />
		<skos:scopeNote xml:lang="en">A turf platform attached to a Roman military installation, and thought to be a beacon stance.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
