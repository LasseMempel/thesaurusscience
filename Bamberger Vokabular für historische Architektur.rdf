        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T12:29:43.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T16:21:42.000</terms:modified>
        <skos:altLabel xml:lang="de">Oblationarium</skos:altLabel>
        <skos:definition xml:lang="de">Urspr. ein Tisch neben dem Altar für die Opfergaben, dann auch kleiner Raum auf der Evangelienseite nördl. neben dem Chor zur Vorbereitung des Messopfers (Diakonikon), bes. in orthodoxen Kirchen mit reichen Ausmalungen versehen. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="fr"> prothèse</skos:prefLabel>
        <skos:prefLabel xml:lang="es"> prótesis</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Prothesis</skos:prefLabel>
    </owl:NamedIndividual>
    


