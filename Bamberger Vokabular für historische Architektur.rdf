        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-21T13:39:59.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-18T15:10:45.000</terms:modified>
        <skos:definition xml:lang="de">Abschnittswall, auch kleines Verteidigungswerk auf der Contrescarpe. [Koepf/Binding 2016]</skos:definition>
