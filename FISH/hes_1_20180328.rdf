		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/507323" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/515" />
		<skos:scopeNote xml:lang="en">An enclosure defined by one or more rows of closely-spaced vertical timbers embedded in a narrow foundation trench.</skos:scopeNote>
