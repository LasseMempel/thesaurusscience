        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-03T11:19:59.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T10:56:05.000</terms:modified>
        <skos:definition xml:lang="de">Bei mehrteiligen Burgen Hauptburg (innere Burg) neben der bzw. den äußeren Vorburgen. Die meist architektonisch besonders hervorgehobene, oft sehr kompakte und wehrtechnisch besser ausgestattete K. umfasste (mit oder ohne Innenhof) häufig die wichtigsten Wohn- und Wehrbauten wie Saal oder Palas, Wohnturm oder Bergfried. Sie bildete mehrheitlich einen besonderen Rechtsbezirk. H. W. B. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:prefLabel xml:lang="de">Kernburg</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_1f4b2c34 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_1f4b2c34">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_78eff904"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-25T11:34:54.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T14:09:39.000</terms:modified>
        <skos:definition xml:lang="de">Bei Steinbauten des MAs haben die Fensterleibungen häufig eine A. nach innen, so dass bei dicken Mauern die innere Fensteröffnung größer ist als die äußere, wodurch der Lichteinfall vergrößert wird und das Fenster opt. größer erscheint, bes. wenn die A. weiß verputzt ist. Bei sehr dicken Mauern und kleinen Fensteröffnungen können die Leibungen auch nach innen und nach außen ausgeschrägt sein. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Ausschrägung</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_1f562dde -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_1f562dde">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a9967019"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-01T09:49:33.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-10T13:04:02.000</terms:modified>
        <skos:definition xml:lang="de">Eine nur mit einem Laden verschließbare, der Lüftung dienende Dachöffnung; häufig wird so auch fälschl. ein kleines Dachfenster (Gaube) bezeichnet. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Dachluke</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">střešní okno</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_1f5fe269 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_1f5fe269">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b74ef5d3"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_470aa971"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-15T16:28:03.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T14:02:22.000</terms:modified>
        <skos:definition xml:lang="de">Eigentl. Gewächshaus für nicht winterharte Pflanzen (Palmenhaus) in barocken Parkanlagen, allg. ebenerdiges, barockes Gartenhaus mit großen Fenstertüren, meist am Ende der Mittelachse eines Parks. [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Orangerie f (pers.-arab.-span.-frz.), meist einstöckiges Gebäude mit großen Südfenstern, in dem nicht frostfeste Pflanzen auch nördlich der Alpen überwintern können. Im französischen Schlossbau des 16. Jhs. taucht die O. das erste Mal als Bauaufgabe auf (Entwurf für Anet F, von Jacques-Androuet Du Cerceau). Im barocken Schlossbau gehört die O. zu den repräsentativen Aufgaben (Schwetzingen BW). Architekturgeschichtlich hat die O. Bedeutung, weil sie den ersten, wesentlich durch Glas bestimmten Gebäudetyp darstellt. Vgl. auch Garten. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:prefLabel xml:lang="de">Orangerie</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">oranžerie</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_1f650c8a -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_1f650c8a">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0501a8fc"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-25T12:57:11.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T11:22:01.000</terms:modified>
        <skos:definition xml:lang="de">Ausschachtung für ein Bauwerk oder dessen Fundamente. Das anfallende Material heißt Aushub. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Baugrube</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_1f8af5be -->


