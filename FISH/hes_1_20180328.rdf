		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1322">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1322</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">FACTARAIDH PRIONTADH STUTHAN-AODAICH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Làrach far a bheilear a' clò-bhualadh aodach. Airson clò-bhualadh pàipeir, faic FACTARAIDH CLÒ-BHUALAIDH:</skos:scopeNote>
				<skos:prefLabel xml:lang="en">TEXTILE PRINT WORKS</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
