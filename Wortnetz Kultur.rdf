	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021102">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="en">chromophotography</skos:altLabel>
		<skos:prefLabel xml:lang="en">color photography</skos:prefLabel>
		<skos:altLabel xml:lang="en">colour photography</skos:altLabel>
		<skos:prefLabel xml:lang="de">Farbfotografie (fotografische Technik)</skos:prefLabel>
		<skos:prefLabel xml:lang="de-1901">Farbfotographie (fotografische Technik)</skos:prefLabel>
		<skos:altLabel xml:lang="de-1901">Farbphotografie (fotografische Technik)</skos:altLabel>
		<skos:altLabel xml:lang="de">Farbphotographie (fotografische Technik)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk020478"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk020478"/>
		<skos:definition xml:lang="de">Farbfotografie ist eine fotografische Technik, die die Verwendung von Farben zur Bildgestaltung und Bildkomposition umfasst. Sie ermöglicht es Fotografen, Stimmungen und Emotionen durch die gezielte Auswahl und Kombination von Farben auszudrücken. Diese Technik erfordert Kenntnisse über Farbtheorie, Lichtführung und die Wirkung von Farben auf den Betrachter.</skos:definition>
		<skos:mappingRelation rdf:resource="http://www.wikidata.org/entity/Q166509"/>
		<skos:mappingRelation rdf:resource="http://d-nb.info/gnd/4016464-0"/>
		<skos:mappingRelation rdf:resource="http://vocab.getty.edu/aat/300134530"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk020478"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-12-18T16:53:48+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021103">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="en">black and white photography</skos:altLabel>
		<skos:prefLabel xml:lang="en">black-and-white photography</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Schwarz-Weiß-Fotografie (fotografische Technik)</skos:prefLabel>
		<skos:prefLabel xml:lang="de-1901">Schwarz-Weiß-Fotographie</skos:prefLabel>
		<skos:altLabel xml:lang="de-1901">Schwarz-Weiß-Photografie</skos:altLabel>
		<skos:altLabel xml:lang="de">Schwarz-Weiß-Photographie</skos:altLabel>
		<skos:altLabel xml:lang="de">Schwarzweißfotografie (fotografische Technik)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk020478"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk020478"/>
		<skos:definition xml:lang="de">Schwarz-Weiß-Fotografie ist eine fotografische Technik, die sich auf die Aufnahme und Bearbeitung von Bildern in Graustufen und monochromen Tönungen konzentriert. Sie hebt Kontraste, Texturen und Formen hervor, indem sie die Abwesenheit von Farbe nutzt, um emotionale Tiefe und visuelle Klarheit zu schaffen. Diese Technik erfordert ein feines Gespür für Licht und Schatten sowie eine bewusste Komposition.</skos:definition>
		<skos:mappingRelation rdf:resource="http://vocab.getty.edu/aat/300162056"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk020478"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
