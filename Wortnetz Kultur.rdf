	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021041">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Particell</skos:prefLabel>
		<skos:altLabel xml:lang="de">Particella</skos:altLabel>
		<skos:altLabel xml:lang="de">Particelle</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006010"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk006010"/>
		<skos:definition xml:lang="de">Eine Particell ist ein Dokument, in dem die wichtigsten musikalischen Stimmen auf wenigen Notensystemen zusammengefasst werden. Sie dient als Übersicht für Dirigent*innen und Komponist*innen, um die grobe melodische, rhythmische und harmonische Struktur eines Werkes zu erfassen. Particelle werden häufig in der Kompositionsphase oder bei der Analyse von Musikstücken verwendet.</skos:definition>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q2054514"/>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/1071331124"/>
