        <skos:altLabel xml:lang="de">Pfarrer</skos:altLabel>
        <skos:altLabel xml:lang="fr">pasteur</skos:altLabel>
        <skos:definition xml:lang="de">Pastor m, lat.; Pfarrer m: der Seelsorger einer Gemeinde; heute unterschiedliche Verwendung im kath. und prot. Sprachgebrauch. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Pastor</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">curé</skos:prefLabel>
