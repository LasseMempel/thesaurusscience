        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-25T15:13:01.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T15:56:50.000</terms:modified>
        <skos:definition xml:lang="de">Scheibenreliquiar n: 1. eine dünne, oft als Vierpass geformte und mit Blattgold bekleidete Holzscheibe mit einem Behälter für die Reliquie in der Mitte (seit 12. Jh.). Beispiel: das Reliquiar des hl. Franz von Assisi in Limoges, um 1228. 2. eine Reliquienmonstranz mit rundem Schaugefäß. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Scheibenreliquiar</skos:prefLabel>
        <skos:prefLabel xml:lang="en">disc-shaped reliquary</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">reliquaire discoïdal</skos:prefLabel>
    </owl:NamedIndividual>
    


