	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1460">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1460</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CRÌOCH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Na crìochan aig raon a tha air an comharradh air mapa no air an talamh air dòigh air choireigin, m.e. le BALLA-CRÌCHE. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BOUNDARY</skos:prefLabel>
