				<skos:prefLabel xml:lang="gd">TAIGH-SALAINN</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Togalaichean sa bheil dìon mòr an aghaidh taiseachd airson salann a stòradh ann.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">SALT STORE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
