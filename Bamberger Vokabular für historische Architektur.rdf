        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_092150d8"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-16T15:38:29.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-18T15:02:38.000</terms:modified>
        <skos:definition xml:lang="de">Im Festungsbau ein häufig halbrundes Bollwerk, ähnl. der Bastion. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Oft undifferenziert benutzter Begriff in der militärischen Fachsprache des 19. Jh.s. Albrecht Dürers »aus dem Thurm der alten Stadtbefestigung für die Geschützaufstellung umgestaltetes geräumiges Hauptwerk der Front«, d. h. das von der modernen Festungsforschung als Rondell bezeichnete Werk. M. L. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:prefLabel xml:lang="de">Bastei</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">bašta</skos:prefLabel>
    </owl:NamedIndividual>
    


