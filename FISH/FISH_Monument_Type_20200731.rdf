    <skos:scopeNote xml:lang="en">A factory or complex containing machinery for the manufacture of printed materials.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/147333">
    <skos:scopeNote xml:lang="en">A house used to accommodate Llamas at a zoo or wildlife park.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92433">
    <skos:scopeNote xml:lang="en">A decorative building in the form of a dairy, used for recreation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/144508">
    <skos:scopeNote xml:lang="en">Series of machines for mechanically slaking lime. 20th century.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93956">
    <skos:scopeNote xml:lang="en">An explosive-proof vaulted chamber used for the storage or ordnance.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69320">
    <skos:scopeNote xml:lang="en">A mill where flax is processed to make linen, thread and yarn.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93045">
    <skos:scopeNote xml:lang="en">A factory where putty, used as a means of securing windows and for setting plumbing fixtures, is produced from a combination of whiting and oil.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140439">
    <skos:scopeNote xml:lang="en">A mutiple role hangar for aircraft and general storage, manufactured in the USA as a kit for on-site assembly  during WWII and post-war. It comprises a steel box frame and a canvas covering.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/103613">
    <skos:scopeNote xml:lang="en">Sites and structures associated with the storage of water and waste water. Use only where the exact form or function is unknown otherwise use more specific term.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99539">
    <skos:scopeNote xml:lang="en">A purpose-built trench used to test chemical warfare weapons.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69237">
    <skos:scopeNote xml:lang="en">A site where iron is smelted or iron goods made.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71787">
