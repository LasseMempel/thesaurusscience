        <skos:altLabel xml:lang="de">Dossierung</skos:altLabel>
        <skos:altLabel xml:lang="de">Talus</skos:altLabel>
        <skos:definition xml:lang="de">(auch Talus), Schrägstellung bzw. Anböschung des Mauersockels, vom Burgenbau des (vorderen) Orients übernommen (Krak des Chevaliers SYR); ursprünglich zur Verbesserung der Standfestigkeit, später wohl auch als bloßes Motiv gedacht (Mandráki / Insel Nísyros GR: Kástro, spätes Mittelalter). M. L. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:prefLabel xml:lang="de">Böschung</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_ef222f43 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_ef222f43">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_86c8b719"/>
