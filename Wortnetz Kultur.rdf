		<gvp:aat2801_conjuncted_with rdf:resource="http://lvr.vocnet.org/wnk/wk001397"/>
		<skos:definition xml:lang="de">Ein Querhauswinkelturm ist ein Kirchturm, der im Winkel zwischen Langhaus und Querhaus, in der Regel über dem östlichsten Joch eines Seitenschiffs, steht.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk001253"/>
