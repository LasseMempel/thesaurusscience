    <!-- https://hist-arch-vocab.org/bvha#c_d344a51a -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_d344a51a">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_fbedadd4"/>
