	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/505381">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/505381</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">IONAD-NIGHE BHEATHAICHEAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite no togalach far an gabh beathaichean a nighe. Gu math tric bidh seo na amar le balla a tha coltach ri fuineall a stiùireas na beathaichean dhan amar.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ANIMAL WASH</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-08-25T13:50:23</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-08-25T13:52:07</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/138" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1" />
		<skos:scopeNote xml:lang="en">A place or building where animals can be washed. Often in the form of a pool with a walled funnel-like structure enabling animals to be guided into the pool.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
