        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T15:37:41.000</terms:modified>
        <skos:definition xml:lang="de">Von einer Hauptmauer ausgehendes und vor die Mauerflucht vorspringendes, kurzes Mauerstück. [Glossarium Artis, Bd. 3, Bögen und Mauerwerk]</skos:definition>
        <skos:prefLabel xml:lang="de">Mauerzunge</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">embranchement d\&apos;un mur</skos:prefLabel>
        <skos:prefLabel xml:lang="es">lengüeta de muro</skos:prefLabel>
        <skos:prefLabel xml:lang="en">projecting wall</skos:prefLabel>
        <skos:prefLabel xml:lang="it">sporgenza del muro</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_a42a5521 -->


