    skos:scopeNote "Τools used for removing smaller pieces of stone, to give the monument its final form and smooth the surface for cutting."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/336> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/26> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Secondary groups"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/127>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/208>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/75> ;
    skos:scopeNote "Groups of persons with common interests, oriented towards the accomplishment of collectively endorsed purposes, which regulate the frequency and define the framework of the interactions between the members of these groups."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/34> a skos:Concept ;
    skos:exactMatch <https://vocabs.dariah.eu/bbt/Concept/000025> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Offices"@en ;
    skos:scopeNote "This term classifies official roles attributed to persons or social groups which grant rights and/or dictate obligations in relation to either the functioning of these rights and/or to the performing of administrative and management duties of institutional bodies. These properties are institutionally and socially recognized and acquire meaning only in the context of an organized community."@en ;
    skos:topConceptOf <https://humanitiesthesaurus.academyofathens.gr> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/342> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/26> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Descent groups"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/108>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/339> ;
    skos:scopeNote "Groups of persons who acknowledge their common descent. Descent groups constitute collective entities whose social functionality involves the inheritance of titles, ranks, priviledges and/or obligations."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/348> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
