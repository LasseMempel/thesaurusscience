        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_d7d2cec4"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-27T19:35:31.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T14:44:22.000</terms:modified>
        <skos:altLabel xml:lang="de">Benediktuspfennig</skos:altLabel>
        <skos:definition xml:lang="de">BenediktusmedaiIle f; auch Benediktuspfennig m: eine geweihte Medaille, die als Schutzzeichen gilt (seit 14. Jh.). Sie trägt auf einer Seite das Bild des hl. Benedikt und die Worte: Eius in obitu nostro praesentia muniamur. Auf der anderen Seite zeigt sie ein Kreuz, auf dessen Längsbalken die Anfangsbuchstaben des Benediktussegens stehen: C(rux) S(acra) S(it) M(ihi) L(ux). Der Querbalken trägt die Buchstaben n(on) d(raco) s(it) m(ihi) d(ux). [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Benediktusmedaille</skos:prefLabel>
        <skos:prefLabel xml:lang="en">medal of St. Benedict</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">médaille de Saint-Benoît</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_1a5060af -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_1a5060af">
