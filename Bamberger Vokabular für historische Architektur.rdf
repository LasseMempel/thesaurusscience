    <!-- https://hist-arch-vocab.org/bvha#c_2874cded -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_2874cded">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
