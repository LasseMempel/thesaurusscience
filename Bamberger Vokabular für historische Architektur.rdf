        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-26T15:28:30.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T23:47:06.000</terms:modified>
        <skos:definition xml:lang="de">Angelusglocke f: eine Glocke, die morgens, nachmittags und abends geläutet wird und bei deren Erklingen zur Erinnerung an die Verkündigung Mariae das Angelus gebetet wird. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="en">Angelus-bell</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Angelusglocke</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">cloche l\&apos;Angélus</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_6cd597b5"/>
    </owl:NamedIndividual>
    


