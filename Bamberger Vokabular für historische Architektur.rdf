    <!-- https://hist-arch-vocab.org/bvha#c_6dff99ee -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_6dff99ee">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_6a7d7ddc"/>
