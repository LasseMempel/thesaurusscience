        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T16:25:19.000</terms:modified>
        <skos:altLabel xml:lang="en">eye</skos:altLabel>
        <skos:altLabel xml:lang="cs">kouřový otvor</skos:altLabel>
        <skos:definition xml:lang="de">In einfachen Wohnhütten und Rauchhäusern eine Öffnung im Dach, die zum Abziehen des Rauchs über der offenen Feuerstelle dient. [Koepf/Binding 2016]</skos:definition>
