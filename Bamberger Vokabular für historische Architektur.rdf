    <!-- https://hist-arch-vocab.org/bvha#c_912427c6 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_912427c6">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_36969a5d"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_fbc27934"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-24T14:40:55.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-31T00:37:48.000</terms:modified>
        <skos:altLabel xml:lang="de">Wandbehang</skos:altLabel>
        <skos:altLabel xml:lang="es">gobelino</skos:altLabel>
        <skos:altLabel xml:lang="cs">gobelín</skos:altLabel>
        <skos:altLabel xml:lang="cs">nástěnný koberec</skos:altLabel>
        <skos:altLabel xml:lang="fr">tapisserie, gobelin</skos:altLabel>
        <skos:altLabel xml:lang="en">wall hanging</skos:altLabel>
        <skos:definition xml:lang="de">1. gewebt = rechtwinklige Kreuzung von Kett- und Schussfäden (z.B. Jacquard-Teppiche); 2. gewirkt = bunte Schussfäden werden mit Nadel oder Spule in die Kette eingeflochten, besonders für Bildteppiche (Gobelins); 3. geknüpft = die Kettfäden werden mit kurzen bunten Fäden verknüpft (Orientteppich). [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Wandbehang m; auch Wandteppich m: an der Wand, vorzugsweise der Chorwand, hängender Teppich, oft ein gewirkter oder gestickter Bildteppich. Vielfach werden Szenen zur Begleitung des Kirchenjahres dargestellt. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Wandteppich, Tapisserie, ein Teppich zum Schmuck oder zur Bekleidung (Bespannung) der Wand. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Wandteppich</skos:prefLabel>
        <skos:prefLabel xml:lang="it">arazzo</skos:prefLabel>
        <skos:prefLabel xml:lang="en">tapestry</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">tapiserie</skos:prefLabel>
        <skos:prefLabel xml:lang="es">tapiz</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">tenture murale</skos:prefLabel>
    </owl:NamedIndividual>
    


