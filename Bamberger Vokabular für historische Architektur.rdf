        <skos:prefLabel xml:lang="fr">chapelle latérale</skos:prefLabel>
        <skos:prefLabel xml:lang="en">side chapel</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_b09ab7d7 -->


