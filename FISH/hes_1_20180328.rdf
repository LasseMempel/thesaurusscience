	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/560">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/560</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FUARAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Fosgladh a chaidh a dhèanamh 's uisge a' tighinn às. Tha seo na bhall-maise ann an gàrradh, pàirc no àite poblach gu math tric.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">FOUNTAIN</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/552" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1993" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/504200" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/585" />
		<skos:scopeNote xml:lang="en">An artificial aperture from which water springs, commonly used as an ornament in a garden, park or public space.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
