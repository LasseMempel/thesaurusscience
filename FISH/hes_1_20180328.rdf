		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1034" />
		<skos:scopeNote xml:lang="en">A site with equipment and structures for the extraction of antimony, a metallic element added to alloys to increase strength and hardness. Antimony was once thought to have medicinal properties.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
