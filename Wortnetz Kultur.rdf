		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk002783"/>
		<skos:definition xml:lang="de">Das Bathonium ist ein geochronologisches Alter des Mitteljuras, das vor etwa 168,2 Millionen Jahren begann und vor etwa 165,3 Millionen Jahren endete.</skos:definition>
		<skos:mappingRelation rdf:resource="https://d-nb.info/gnd/4144120-5"/>
