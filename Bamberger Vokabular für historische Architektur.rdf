    <!-- https://hist-arch-vocab.org/bvha#c_702ac87f -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_702ac87f">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_47v6axo2"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-26T15:45:00.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T23:44:53.000</terms:modified>
        <skos:altLabel xml:lang="de">Schellenrad</skos:altLabel>
        <skos:altLabel xml:lang="la">circulus nolarum</skos:altLabel>
        <skos:altLabel xml:lang="la">rota nolarum</skos:altLabel>
        <skos:definition xml:lang="de">Glockenrad n; Schellenrad n; lat. rota cum tintinnabulis; rotanolarum; circulus nolarum:ein Rad, das mit kleinen Glöckchen besetzt ist, die durch Ziehen an einer Schnur zum Klingen gebracht werden. Es diente zum Signalisieren der Wandlung und war entweder an einer Stange befestigt oder in einem geschnitzten Gehäuse an der Chorwand angebracht. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Glockenrad</skos:prefLabel>
        <skos:prefLabel xml:lang="la">rota cum tintinnabulis</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">roue à sonnettes </skos:prefLabel>
        <skos:prefLabel xml:lang="en">wheel of bells</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_702f391a -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_702f391a">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_8fc667ec"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_d6e112fb"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-10T15:51:59.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T11:54:00.000</terms:modified>
        <skos:altLabel xml:lang="de">Altis (griech.)</skos:altLabel>
        <skos:altLabel xml:lang="de">Peribolos</skos:altLabel>
        <skos:altLabel xml:lang="de">Temenos (griech.)</skos:altLabel>
        <skos:altLabel xml:lang="cs">chrámový okrsek</skos:altLabel>
        <skos:prefLabel xml:lang="de">Tempelbezirk (Gebäude)</skos:prefLabel>
        <skos:prefLabel xml:lang="it">area sacra</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">peribolos</skos:prefLabel>
        <skos:prefLabel xml:lang="es">recinto del templo</skos:prefLabel>
        <skos:prefLabel xml:lang="en">temple precinct</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Altis, auch Peribolos; der durch eine Mauer oder Säulenhalle begrenzte und durch ein Propylon zugängl. gr. Tempelbezirk. [Koepf / Binding 2016]</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Der einen Tempel umgebende, oft durch Säulenhallen begrenzte Bezirk. [Koepf/Binding 2016]</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Ein heiliger Bezirk, in dessen Zentrum einer oder mehrere Tempel stehen und der von einer Mauer umgeben wird, an deren Innenseite Kammern (Schatzhäuser) oder Säulenhallen liegen können. Der T. ist durch einen oder mehrere Torbauten (Propylon) zugängl. In Griechenland wird der T. Temenos, Altis oder Peribolos, in Rom häufig Kapitol genannt. Auch in Indien, Ostasien und in Altamerika gibt es große T.e, die durch eine Einfriedung (Prakdra, Vedika) abgeschlossen und durch Torbauten (in Indien: Gopuram) zugängl. sind und in denen mehrere Tempel, Pagoden oder andere Kultbauten stehen, manchmal auch heilige Teiche (in Indien: Teppakulam) liegen. [Koepf / Binding 2016]</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Temenos, Altis, ummauerter griechischer Tempel-, Kultbezirk. [Koch 2009]</skos:scopeNote>
        <skos:scopeNote xml:lang="cs">Temenos, altis, řecký chrámový a kultovní okrsek obehnaný hradbou. [Koch 2008]</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_703140dc -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_703140dc">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_237c1721"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
