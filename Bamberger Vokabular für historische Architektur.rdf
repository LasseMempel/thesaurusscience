    <!-- https://hist-arch-vocab.org/bvha#c_7d44c553 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_7d44c553">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_8a7df20d"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a7484f12"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T09:20:19.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T01:21:17.000</terms:modified>
        <skos:definition xml:lang="de">Megaron (griech. das Geräumige), 1. Hauptraum des griechischen Wohnhauses mit Herd und Vorhalle; 2. Thronsaal der kretisch-mykenischen Burg. Das Megaron ist Vorform des griechischen Tempels. Steinzeitliche Herkunft (Ost- und Mitteleuropa). [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Megaron</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">megaron</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_7d464cc4 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_7d464cc4">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f88a153a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c7b144d0"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-23T08:05:26.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-19T13:24:16.000</terms:modified>
        <skos:definition xml:lang="de">Großflächiges, speziell konstruiertes Erker- oder Kastenfenster, das in den 1920er Jahren entwickelt wurde. Es konnte auch Glasbausteine an der Decke, einen schrägen Boden mit Wasserbecken und Wasserzulauf, Lüftungsflügel, ein Lamellenstore als Sonnenschutz sowie als Abgrenzung zum Wohnraum ein Schiebefester aufweisen. In Wohn- und Siedlungsbauten waren z.B. die Blumenfenster von Auefeld und Helleböhn berühmt. [Pax - Fenster &amp; Türen Fachbegriffe]</skos:definition>
        <skos:prefLabel xml:lang="de">Blumenfenster</skos:prefLabel>
        <broaderByConstruction rdf:resource="https://hist-arch-vocab.org/bvha#c_f88a153a"/>
    </owl:NamedIndividual>
    


