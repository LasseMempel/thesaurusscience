  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69205">
    <skos:scopeNote xml:lang="en">A type of calcining kiln used in arsenic manufacture.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91707">
    <skos:scopeNote xml:lang="en">A hospital department where surgical and medical dental treatment takes place.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69209">
    <skos:scopeNote xml:lang="en">A pit, sometimes found close to a church or cathedral, where bells were cast in medieval times.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92960">
    <skos:scopeNote xml:lang="en">A piece of prepared ground on which the game of polo is played.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70213">
    <skos:scopeNote xml:lang="en">A hangar for the storage and maintenance of dirigible motor-driven balloons.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/86499">
    <skos:scopeNote xml:lang="en">A spatially discrete scatter of mixed artefactual material found on the ground, seabed or riverbed which may have been deposited over time rather than resulting from one particular event. Index particular types where appropriate.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143173">
    <skos:scopeNote xml:lang="en">Submerged obstacles to stop the landing of Seaplanes</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/88556">
    <skos:scopeNote xml:lang="en">A college where specialist skills, relating to a particular subject, are taught. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160352">
    <skos:scopeNote xml:lang="en">A camp used to accommodate members of the Womens Land Army who undertook essential agricultural work during the Second World War.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140108">
    <skos:scopeNote xml:lang="en">Site associated with the testing of nuclear material or its containers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70237">
    <skos:scopeNote xml:lang="en">A building used to house railway engines.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92235">
    <skos:scopeNote xml:lang="en">A place used to hide something or someone.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/76581">
    <skos:scopeNote xml:lang="en">A small building housing a mechanism used for winding a cable.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70130">
    <skos:scopeNote xml:lang="en">A residence of two or three monks of the Gilbertine order dependent on an English mother house.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91195">
    <skos:scopeNote xml:lang="en">A factory where lengths of soft, woollen cloth, loosely woven to retain heat, used as a bed covering, were manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91237">
    <skos:scopeNote xml:lang="en">A tower at the mouth of the harbour to defend the end of the harbour boom.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92345">
    <skos:scopeNote xml:lang="en">The residence of the supervisor of an inclined plane.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/103853">
    <skos:scopeNote xml:lang="en">An institution for the detention of prisoners considered to be a major threat to public safety and/or to the security of the nation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92279">
    <skos:scopeNote xml:lang="en">An educational establishment where the art of garden cultivation is taught.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91914">
    <skos:scopeNote xml:lang="en">A building where animals are deliberately fattened before being killed for their meat.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69128">
    <skos:scopeNote xml:lang="en">A factory where flour was produced for use in food products.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167324">
    <skos:scopeNote xml:lang="en">A building, either purpose-built or modified, used for the co-ordination of the Fire Service.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92634">
    <skos:scopeNote xml:lang="en">Buildings, sites and structures associated with the drainage and/or ventilation of mines.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69992">
    <skos:scopeNote xml:lang="en">A cross erected within a town, usually funded by the inhabitants.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68738">
    <skos:scopeNote xml:lang="en">A post set up, to which offenders were tied to be whipped.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68725">
    <skos:scopeNote xml:lang="en">A building in which a judicial court is held.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93320">
    <skos:scopeNote xml:lang="en">A signalling station which used a series of shutters to indicate various messages.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78875">
    <skos:scopeNote xml:lang="en">A garden in which a variety of plants are grown to encourage butterflies.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69317">
    <skos:scopeNote xml:lang="en">Any factory used for the manufacture of textiles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70384">
    <skos:scopeNote xml:lang="en">A subterranean feature entered from a hillside, cliff face, etc. A cave may have been used for occupation, storage, burial, refuse, or as a hide-away. Index with site type or objects where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71828">
    <skos:scopeNote xml:lang="en">A building used for the preparatory processes in which long and short staple flax fibres were separated by passing through combs. Flax dressing or 'heckling' shops may be located both on and off mill sites.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94358">
    <skos:scopeNote xml:lang="en">Sites and structures for the transport of military personnel, vehicles and armaments.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68812">
    <skos:scopeNote xml:lang="en">A fortified tower found at the angle of a castle wall.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93532">
    <skos:scopeNote xml:lang="en">A communal room or building attached to flats.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69426">
    <skos:scopeNote xml:lang="en">A building where timber was allowed to dry and harden, to render it fit for use as a working material.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164194">
    <skos:scopeNote xml:lang="en">A communication system in which cylindrical containers are propelled through a network of tubes either by compressed air or partial vacuum. They are used for transporting solid objects, as opposed to conventional pipelines, which transport fluids.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167311">
    <skos:scopeNote xml:lang="en">A system of defensive works such as anti-tank obstacles, ditches and pillboxes, designed to stop the advance of an enemy. Defence lines were constructed across and around strategic areas of ground and sites such as industrial towns.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69290">
    <skos:scopeNote xml:lang="en">A site or building where silver was processed and/or worked and fashioned into objects.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70226">
    <skos:scopeNote xml:lang="en">A bridge consisting of a lattice girder spanning the distance between the tops of two towers. Designed to transport vehicles across the gap in a container suspended at road level by ropes under a travelling crane on the girder.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70326">
    <skos:scopeNote xml:lang="en">A ditch that indicates the limit of an area or a piece of land.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/133659">
    <skos:scopeNote xml:lang="en">A mine used for the extraction of uranium bearing ores.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71471">
    <skos:scopeNote xml:lang="en">A separate compartment for livestock in which they are free to move about.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71815">
    <skos:scopeNote xml:lang="en">Place where a smith works iron. May be for small scale local use or within a larger industrial complex.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91496">
    <skos:scopeNote xml:lang="en">Purpose-built structure with thick walls used to store clay before transportation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/133073">
    <skos:scopeNote xml:lang="en">A mill which ground clinker in the cement production process. During cement production a mixture of lime and clay is burnt which forms a clinker which is then ground into powder. When mixed with water it solidifies to hard cement.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93253">
    <skos:scopeNote xml:lang="en">A hospital where patients would bathe daily in the sea or in indoor salt-water swimming baths.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93878">
    <skos:scopeNote xml:lang="en">A path across a road marked with black and white stripes where pedestrians may cross.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93077">
    <skos:scopeNote xml:lang="en">A small eating and drinking establishment or refreshment bar at a railway station for the use of passengers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69283">
    <skos:scopeNote xml:lang="en">A site or building used for the manufacture of goods made from pewter, an alloy of tin and lead.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92020">
    <skos:scopeNote xml:lang="en">A garden specifically planted with sweet smelling, fragrant plants.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71779">
    <skos:scopeNote xml:lang="en">A place where specific skills are taught on short courses.</skos:scopeNote>
  </rdf:Description>
