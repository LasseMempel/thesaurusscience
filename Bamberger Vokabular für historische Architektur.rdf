        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-02T16:26:51.000</terms:modified>
        <skos:definition xml:lang="de">Eine diagonal einen Ständer überblattende Verstrebung im Fachwerkbau. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Steigband: schräges geschosshohes Holz, das von der Schwelle bis zum Rähm bzw. Geschossriegel reicht und einen Bund- oder Zwischenständer überblattet; im Dachgerüst auch zwischen Dachbalken und Kehlbalken oder -riegel. [Eißing et al. 2012]</skos:definition>
        <skos:prefLabel xml:lang="de">Steigband</skos:prefLabel>
        <skos:prefLabel xml:lang="es">apoyo diagonal de un ensamble de media madera</skos:prefLabel>
        <skos:prefLabel xml:lang="it">fascia controvento</skos:prefLabel>
    </owl:NamedIndividual>
    


