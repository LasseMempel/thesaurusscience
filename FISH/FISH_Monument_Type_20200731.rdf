  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78852">
    <skos:scopeNote xml:lang="en">A building forming part of a colliery ventilation system exhausting stale air from shafts and headings.</skos:scopeNote>
  </rdf:Description>
