	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk000575">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Busta</skos:altLabel>
		<skos:prefLabel xml:lang="de">Bustum</skos:prefLabel>
		<skos:prefLabel xml:lang="en">bustum</skos:prefLabel>
		<skos:altLabel xml:lang="de">Bustumgrab</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000209"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010203"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010276"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019833"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000209"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk000244"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk008645"/>
		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk011745"/>
		<xe:explanation_temp xml:lang="de">Der Leichnam wurde in einem Scheiterhaufen über der späteren Grabgrube verbrannt, die Brandreste fielen dabei in die Grube. Daher sind die Ränder dieser Gräber durch das Feuer rot verziegelt. Nach der Einäscherung des Leichnams konnten die Reste ausgelesen, in eine Urne gefüllt und getrennt von dem Brandschutt bestattet werden. Zusätzlich konnten unverbrannte Beigaben mitgegeben werden.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Bustum ist ein Brandgrab, in dem der Leichnam verbrannt und bestattet wird.</skos:definition>
		<skos:exactMatch rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70040"/>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300005874"/>
