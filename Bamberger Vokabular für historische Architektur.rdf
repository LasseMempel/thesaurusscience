    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_3060c2c8 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_3060c2c8">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a4d58de0"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-07T11:00:48.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T17:42:02.000</terms:modified>
        <skos:definition xml:lang="de">Verengung des Querschnitts, bezogen auf die Längsachse. So kann z.B. der Chor einer Kirche gegenüber dem breiteren Langhaus &gt;eingezogen&lt; sein. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Einziehung</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_3063aeac -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_3063aeac">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_4708d89a"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_927173eb"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f88a153a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_b41bd73a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c7b144d0"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-18T08:09:05.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T16:12:52.000</terms:modified>
        <skos:altLabel xml:lang="es"> claraboya</skos:altLabel>
        <skos:altLabel xml:lang="fr"> imposte</skos:altLabel>
        <skos:altLabel xml:lang="fr"> lanterneau</skos:altLabel>
        <skos:altLabel xml:lang="en">fanlight</skos:altLabel>
        <skos:altLabel xml:lang="cs">horní osvětlení</skos:altLabel>
        <skos:altLabel xml:lang="cs">horní světlo</skos:altLabel>
        <skos:altLabel xml:lang="cs">nadsvětlik</skos:altLabel>
        <skos:altLabel xml:lang="cs">vrchní světlo</skos:altLabel>
        <skos:definition xml:lang="de">Bei Fenstern mit mehreren Etagen, bei denen die oberste Etage nicht wie die unteren geteilt ist, heißt diese Oberlicht. Es gibt das feststehende, nicht zu öffnende Oberlicht und das bewegliche. Von Oberlicht spricht man vorwiegend beim Galgenfenster. [Noky 1996]</skos:definition>
        <skos:definition xml:lang="de">In der Decke liegende Fensteröffnung, die Oberlicht einlässt. Schon in ägypt. Tempeln kommt neben Obergadenfenstern die 0. vor. Sie hat sich in der Architektur bes. bei Ausstellungs- und Industriebauten bewährt (Lichthof). Eine Sonderform der 0. ist die ringförmige Öffnung (Auge, Opäum, Nabel) im Scheitel einer Kuppel. 2. Seltener für Fenster, die im obersten Teil der Umfassungswände eines Raums oder über dem Fensterkämpfer angebracht sind und hohes Seitenlicht hereinlassen. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="fr"> jour d\&apos;en haut</skos:prefLabel>
        <skos:prefLabel xml:lang="it"> lucernario</skos:prefLabel>
        <skos:prefLabel xml:lang="es"> tragaluz</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Oberlicht</skos:prefLabel>
        <skos:prefLabel xml:lang="en">skylight</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">světlík</skos:prefLabel>
        <broaderByPosition rdf:resource="https://hist-arch-vocab.org/bvha#c_f88a153a"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_3065d503 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_3065d503">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1514fd0f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_8cf58090"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-04-10T15:43:17.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-26T15:31:50.000</terms:modified>
        <skos:altLabel xml:lang="en"> rustication</skos:altLabel>
        <skos:altLabel xml:lang="fr"> rustique</skos:altLabel>
        <skos:altLabel xml:lang="de">Bossenmauerwerk</skos:altLabel>
        <skos:altLabel xml:lang="de">Rustikamauerwerk</skos:altLabel>
        <skos:altLabel xml:lang="cs">bosáž</skos:altLabel>
        <skos:altLabel xml:lang="ko">opus rusticum</skos:altLabel>
        <skos:altLabel xml:lang="cs">rustika</skos:altLabel>
        <skos:definition xml:lang="de">Quader, deren Ansichtsflächen in der Hauptsache als Bossen unbearbeitet stehen bleiben: unbearbeitete Buckelquader, die in der Regel nur Saum- bzw. Kantenschläge (Randschlag) erhalten. Bereits in antiken Bauten vorkommend, bes. in der ital. Renaissance (Toskana) verbreitet, erhalten bis zum Barock, im Verputz nachgeahmt und im 19./20. Jh. bei Repräsentationsbauten wiederaufgenommen. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Quadermauerwerk, bei dem die Vorderseite der Steine einen schmalen      Randschlag      hat, ansonsten aber nur grob behauen ist.  Die Mauerfläche hat ein sehr unregelmäßiges Aussehen. Wegen ihres wehrhaften Charakters finden sich Rustikamauern oft bei Burgen der Stauferzeit und bei Palästen der Frührenaissance. (Glossarium Artis, Bd. 3, Bögen und Mauerwerk)</skos:definition>
        <skos:prefLabel xml:lang="de">Buckelquadermauerwerk</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">appareil à bossages </skos:prefLabel>
        <skos:prefLabel xml:lang="es">construcción rústica</skos:prefLabel>
        <skos:prefLabel xml:lang="it">opus rusticum</skos:prefLabel>
        <skos:prefLabel xml:lang="en">rusticated  masonry</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_307446d8 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_307446d8">
