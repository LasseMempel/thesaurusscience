    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_3453>,
        <http://eurovoc.europa.eu/2425> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Gips"@de,
