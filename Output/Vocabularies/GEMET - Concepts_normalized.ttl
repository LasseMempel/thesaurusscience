    skos:prefLabel "Umweltzeichen"@de,
        "ecolabel"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/2435> .

<http://www.eionet.europa.eu/gemet/concept/11034> a skos:Concept ;
