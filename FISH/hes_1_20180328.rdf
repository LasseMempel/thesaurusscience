	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502034">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502034</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CREAG CHEARCALL</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Co-dhiù aon bhad a chearcallan co-mheadhanach a chaidh a shnaidheadh air uachdar lomain chreagaich nàdarra. Gheibhear seo an cois CLOICHE CHUACHACH mar is trice.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">RING MARKED ROCK</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-10T14:53:30</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-10T14:58:26</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502663" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1505" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502028" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502030" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502031" />
		<skos:scopeNote xml:lang="en">One or more concentric circles cut into the surface of a natural rock outcrop. Usually found with CUP MARKS.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502047">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502047</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">STRUCTAR CONCRAIT</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar an airm a tha cha mhòr gu tur de choncrait ach gun chinnt dè feum a bha ann.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CONCRETE STRUCTURE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-11T11:08:11</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-18T13:05:34</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502050" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502048" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502049" />
		<skos:scopeNote xml:lang="en">A construction of indeterminate military function made largely from concrete.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502048">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502048</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BLOCA CONCRAIT</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Bloca concrait ceàrnagach no ceart-cheàrnach sa bheil tuill bholtaichean, slotaichean no fiotaidhean a tha co-cheangailte ris ionadan no structaran an airm. Tha sgrìobhadh air cuid dhiubh. Na cleachd airson BLOCAICHEAN ANTI-THANCAICHEAN.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CONCRETE BLOCK</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-11T11:10:56</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-18T13:19:12</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502050" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502047" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502049" />
		<skos:scopeNote xml:lang="en">A square or rectangular concrete block with bolt holes, slots or fitments, associated with military installations or establishments. Some bear inscriptions. Do not use for ANTI TANK BLOCKS.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502049">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502049</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">ÙRLAR CONCRAIT</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Ùrlar concrait ceàrnagach no ceart-cheàrnach a tha gu tric na bhun-stèidh bothan Nissen no bothain shealaich eile ach uaireannan airson solas-luirg, gunna aotrom an aghaidh phlèanaichean, lòinsear socraichte airson rocaidean no beairt-ghunna trom.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CONCRETE PLATFORM</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-11T12:47:42</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-18T13:00:39</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502050" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502047" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502048" />
		<skos:scopeNote xml:lang="en">A square or rectangular concrete platform, often the base for a Nissen or other type of temporary hut, but sometimes for a searchlight, light anti-aircraft gun, fixed rocket projectile launcher or heavy machine-gun.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502050">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502050</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">STRUCTAR-AIRM NEO-SHEÒRSAICHTE AIRM</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar an airm ach gun chinnt dè feum a bha ann. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">INDETERMINATE MILITARY STRUCTURE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-11T13:53:52</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-18T12:54:47</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/278" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502048" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502049" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502047" />
		<skos:scopeNote xml:lang="en">A construction of indeterminate military function. Use specific term where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502087">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502087</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">AMPHITÈATAR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach ugh-chruthach no cearcallach sa bheil suidheachaidh ann an sreathan a tha a' dol an àirde mun cuairt air àite fosgailte sa mheadhan. Chaidh an cleachdadh airson deas-ghnàthan cràbhach, fèisteas, trèanadh is còmhrag armaichte.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">AMPHITHEATRE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-14T10:31:32</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-14T10:31:50</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1645" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1640" />
		<skos:scopeNote xml:lang="en">An oval or circular building with seats rising in tiers around a central open space. Used for religious ceremonies, entertainment, training and armed combat contests.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502095">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502095</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CIDHE CANÀIL</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar mòr fiodha a chaidh a thogail ri taobh canail far a bheil acarsaid do bhàtaichean caola airson bathar a luchdadh orra no airson bathar a thoir far nam bàtaichean.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CANAL WHARF</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-14T11:53:20</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-14T11:53:26</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1874" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1406" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501054" />
		<skos:scopeNote xml:lang="en">A large wooden structure built alongside the edge of a canal where narrow boats may lie for the loading and unloading of goods.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502107">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502107</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">MÈINN-CHRÈADHA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far a bheilear a' dùsgadh criadh às an talamh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CLAY MINE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-14T13:16:58</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-14T13:17:03</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1105" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1170" />
		<skos:scopeNote xml:lang="en">A site where clay is mined from the ground.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502108">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502108</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TOM CHLACHAN-ACHAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Càrn de chlachan a chaidh a ghlanadh à fearann ri linn leasachadh nam fearann san 18mh agus san 19mh linn.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CONSUMPTION CAIRN</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-14T13:20:02</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-27T11:01:16</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1442" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/42" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502109" />
		<skos:scopeNote xml:lang="en">A cairn built to consume stone cleared from the land as part of the agricultural improvements of the 18th and 19th centuries.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502109">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502109</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BALLA CHLACHAN-ACHAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Dìg, gu math tric gu math tiugh, de chlachan a chaidh a ghlanadh à fearann ri linn leasachadh nam fearann san 18mh agus san 19mh linn.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CONSUMPTION DYKE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-14T13:20:19</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-27T11:06:56</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/105" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/318" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1464" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502108" />
		<skos:scopeNote xml:lang="en">A dyke, often of great thickness, built to consume stone cleared from the land as part of the agricultural improvements of the 18th and 19th centuries.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502113">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502113</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LEAC-FAID</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Clach Ròmanach le sgrìobhadh oirre a chomharraicheas faid earrainn de Bhalla Antoninus a chaidh a thogail le diofar lèigiuin.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">DISTANCE SLAB</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-14T14:44:50</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-14T14:56:24</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/207" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1556" />
		<skos:scopeNote xml:lang="en">Roman inscribed stone recording the length of the section of the Antonine Wall built by different legions.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
