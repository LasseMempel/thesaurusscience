        <skos:prefLabel xml:lang="de">Antwerpener Schema</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Beim Antwerpener Schema schließen Schrein und Retabelflügel auf einer Höhe ab. Der Schrein verfügt über einen Fries. [Gliesmann 2011]</skos:scopeNote>
    </owl:NamedIndividual>
    


