        <skos:prefLabel xml:lang="de">Gotischer Verband</skos:prefLabel>
        <skos:prefLabel xml:lang="it">concatenamento polacco</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">vazba polská</skos:prefLabel>
    </owl:NamedIndividual>
    


