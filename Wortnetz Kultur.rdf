	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk003634">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">arrowslit</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Bogenscharte</skos:prefLabel>
		<skos:altLabel xml:lang="de">Bogenscharten</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk002504"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk002504"/>
		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk003635"/>
		<skos:definition xml:lang="de">Eine Bogenscharte ist eine Schießscharte, die die Form eines langen senkrechten Schlitzes hat, jedoch nicht für den Einsatz von Fernwaffen dient, da die dahinterliegende Schießnische fehlt, sondern ausschließlich der Belichtung und Belüftung des Turminneren dient.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002504"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-11-08T16:51:09+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk003635">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Armbrustscharte</skos:prefLabel>
		<skos:altLabel xml:lang="de">Armbrustscharten</skos:altLabel>
		<skos:altLabel xml:lang="en">crossbow  slit</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk002504"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk002504"/>
		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk003634"/>
		<xe:explanation_temp xml:lang="de">Manche Armbrustscharten besitzen zusätzlich kurze horizontale Schlitze (z. B. die Kreuzscharte). </xe:explanation_temp>
		<skos:definition xml:lang="de">Eine Armbrustscharte ist eine Schießscharte, die eine senkrechte Schlitzform hat, jedoch niedriger und breiter als Bogenscharten ist und bei der auch die zugehörige Nische breiter ist, um der horizontal gehaltenen Waffe genügend Raum zu geben.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002504"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-11-08T16:51:09+01:00+01:00</dcterms:modified>
	</skos:Concept>
