    <!-- https://hist-arch-vocab.org/bvha#c_62f9df73 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_62f9df73">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_df30c1bf"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_cca0de59"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-04T11:57:20.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-12-01T11:02:23.000</terms:modified>
        <skos:altLabel xml:lang="en">helicline</skos:altLabel>
        <skos:altLabel xml:lang="fr">rampe helicoïdale</skos:altLabel>
        <skos:definition xml:lang="de">Rampe mit gewendeltem Lauf. Von der Wendeltreppe unterscheidet sie sich durch das Fehlen der Stufen und durch flachere Steigung. Die W. kann um eine massive Spindel angeordnet sein (Eselsturm), ist jedoch meist um eine Lichtspindel größeren Durchmessers angeordnet (Parkhaus). Manchmal führt die W. auch außen um einen Turm (Spiralturm) herum. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Wendelrampe</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kruhová rampa</skos:prefLabel>
        <skos:prefLabel xml:lang="it">rampa elicoidale</skos:prefLabel>
        <skos:prefLabel xml:lang="es">rampa helicoidal</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">rampe en vis</skos:prefLabel>
        <skos:prefLabel xml:lang="en">spiral ramp</skos:prefLabel>
    </owl:NamedIndividual>
    


