        <skos:altLabel xml:lang="cs">posun</skos:altLabel>
        <skos:altLabel xml:lang="cs">posuv</skos:altLabel>
        <skos:altLabel xml:lang="es">presión</skos:altLabel>
        <skos:altLabel xml:lang="cs">střih</skos:altLabel>
        <skos:altLabel xml:lang="en">thrust</skos:altLabel>
        <skos:definition xml:lang="de">Schub, Seitenschub, horizontale Komponente eines Kraftverlaufs innerhalb des Mauerwerks, der durch Gewölbe oder Dachkonstruktionen hervorgerufen wird. Man begegnet dem S. durch Verstärkung des Mauerwerks oder im Innenraum durch Anordnen von Ankern. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Schub</skos:prefLabel>
        <skos:prefLabel xml:lang="es">empuje</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">poussée</skos:prefLabel>
        <skos:prefLabel xml:lang="en">push</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">smyk</skos:prefLabel>
        <skos:prefLabel xml:lang="it">spinta</skos:prefLabel>
    </owl:NamedIndividual>
    


