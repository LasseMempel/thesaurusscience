				<skos:scopeNote xml:lang="gd">Àite far a bheilear a' teagasg sgilean sònraichte air cùrsaichean goirid.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">TRAINING CENTRE</skos:prefLabel>
