				<skos:prefLabel xml:lang="gd">AQUARIUM</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Togalach sutha sa bheil linneachan no tancaichean fuadaich far a bheilear a' cumail lusan-uisge agus beathaichean airson rannsachadh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">AQUARIUM</skos:prefLabel>
