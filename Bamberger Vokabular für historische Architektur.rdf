    <!-- https://hist-arch-vocab.org/bvha#c_e2947912 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_e2947912">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1abb44b3"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_19d56a39"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-27T17:49:10.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-29T15:30:26.000</terms:modified>
        <skos:definition xml:lang="de">Der den Grat unterstützende, diagonal von der ausspringenden Ecke einer Traufe zum First verlaufende Sparren eines Walmdaches (Dachkonstruktion), dessen Oberfläche zwei, den beiden Dachflächen entsprechende, Neigungsflächen hat, deren Winkel nach außen weist (im Gegensatz dazu Kehlsparren). [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Gratsparren/Gratrofen: Sparren/Rofen, der an der Nahtstelle schräg aneinanderstoßender Dachflächen verläuft; der Sparren- bzw. Rofenquerschnitt kann rhombisch ausgeformt sein. (Eißing et al. 2012)</skos:definition>
        <skos:prefLabel xml:lang="de">Gratsparren</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">nárožní krokev</skos:prefLabel>
    </owl:NamedIndividual>
    


