        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_8b960cda"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_917c02e2"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_b96470ae"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_cdbad89b"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_dc2d8545"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_e17b4532"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_e2947912"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-23T12:34:45.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-02T13:51:12.000</terms:modified>
        <skos:altLabel xml:lang="fr">chevron-arbalétrier</skos:altLabel>
        <skos:altLabel xml:lang="en">rafter</skos:altLabel>
        <skos:definition xml:lang="de">Dachhauttragendes Holz, das am Fußpunkt immer Horizontalkräfte freisetzt; tritt in der Regel paarweise im First verbunden (Sparrenpaar) auf; im Gegensatz zum Rofen selbsttragend. Als Stocksparren stockhoch abgebunden im mehrstöckigen Dachwerk. [Eißing et al. 2012]</skos:definition>
        <skos:definition xml:lang="de">Geneigte, einander gegenüber angeordnete Hölzer einer Dachkonstruktion, die die Dachhaut tragen. Sie sind mit den Dach- oder Sattelbalken verzapft, verblattet oder versatzt oder stehen auf einer S.schwelle oder Fußpfette (Mischkonstruktion). An Graten und Kehlen der Dächer sind die Grat- bzw. Kehls.zu finden. An diese anlaufende S. heißen Schifts. Unters. sind in der Gespärreebene mit Abstand unter den S. parallel zu diesen angeordnet. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Sparren</skos:prefLabel>
        <skos:prefLabel xml:lang="es">cabio</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">chevron</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">krokev</skos:prefLabel>
        <skos:prefLabel xml:lang="it">puntone</skos:prefLabel>
        <skos:prefLabel xml:lang="en">spar</skos:prefLabel>
    </owl:NamedIndividual>
    


