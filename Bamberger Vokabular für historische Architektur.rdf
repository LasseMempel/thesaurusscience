        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_6fd46e6e"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-05T15:09:56.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T17:38:52.000</terms:modified>
        <skos:altLabel xml:lang="de">Cheirotonie</skos:altLabel>
        <skos:altLabel xml:lang="de">Konsekration</skos:altLabel>
        <skos:altLabel xml:lang="de">Weihe</skos:altLabel>
        <skos:altLabel xml:lang="la">benedictio constitutiva</skos:altLabel>
        <skos:altLabel xml:lang="en">sacrament of Consecration </skos:altLabel>
        <skos:altLabel xml:lang="fr">sacrement de consécration</skos:altLabel>
        <skos:definition xml:lang="de">Weihe f; Weihesakrament n; Konsekration f; ostk. Cheirotonie f; gr. cheirotonia; lat. sacramentum ordinis ; benedictio constitutiva ; russ. chirotonija: das Sakrament der Einführung, Ordination (f), zu einem klerikalen Amt (Diakon, Priester, Bischof). - Im weiteren Sinne auch die Aussonderung einer Sache aus dem profanen Gebrauch durch eine konstitutive Segnung. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="en">Orders</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Weihesakrament (katholisch)</skos:prefLabel>
        <skos:prefLabel xml:lang="el">cheirotonia</skos:prefLabel>
        <skos:prefLabel xml:lang="ru">chirotonija</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">ordination</skos:prefLabel>
        <skos:prefLabel xml:lang="la">sacramentum ordinis</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_666015ca -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_666015ca">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_5615a6bf"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-21T10:30:26.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T17:41:25.000</terms:modified>
        <skos:definition xml:lang="de">Heilige Stiege, Pilatusstiege; als Aufgang zu einer Kapelle dienende Treppe mit drei Armen zu je 28 Stufen, in die Reliquien eingelassen sein können. Den breiteren mittleren Arm begleiten zwei schmalere Arme. Sie ist eine Nachbildung der Treppe am Haus des Pilatus, die Christus erstiegen haben soll, bzw. der S.s. in Rom. Im Barock bei Wallfahrtsanlagen verbreitet. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Scala sancta</skos:prefLabel>
    </owl:NamedIndividual>
    


