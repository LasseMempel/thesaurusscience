	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk003849">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Intrusiva</skos:altLabel>
		<skos:altLabel xml:lang="de">Intrusivgestein</skos:altLabel>
		<skos:altLabel xml:lang="de">Intrusivgesteine</skos:altLabel>
		<skos:prefLabel xml:lang="en">plutonic rock</skos:prefLabel>
		<skos:altLabel xml:lang="de">Plutonit</skos:altLabel>
		<skos:altLabel xml:lang="de">Plutonite</skos:altLabel>
		<skos:prefLabel xml:lang="fr">roche plutonique</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Tiefengestein</skos:prefLabel>
		<skos:altLabel xml:lang="de">Tiefengesteine</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk002539"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010560"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019940"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk002539"/>
		<skos:definition xml:lang="de">Ein Tiefengestein ist ein Magmatisches Gestein, das in großer Tiefe im Erdinneren bei hohem Druck und hohen AusgangstTemperaturen aus langsam erstarrendem Magma entsteht.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002539"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010560"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019940"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003850"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003851"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003852"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003853"/>
