        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T14:40:39.000</terms:modified>
        <skos:note xml:lang="en">An assessment of the state of conservation of a building or site and a study of its environment, based on observations and simple measurements. (EwaGlos)</skos:note>
        <skos:note xml:lang="de">Eine Auswertung des Zustandes eines Gebäudes oder einer Stätte und eine Untersuchung ihrer Umgebung, die auf Beobachtungen und einfachen Messungen basiert. (EwaGlos)</skos:note>
        <skos:note xml:lang="fr">Evaluation de l’état de conservation d’un bâtiment ou d’un site et de son environnement à partir d’observations et de mesures simples. (EwaGlos)</skos:note>
        <skos:prefLabel xml:lang="de">Bauaufnahme</skos:prefLabel>
        <skos:prefLabel xml:lang="tr">bina ve alan incelemesi</skos:prefLabel>
        <skos:prefLabel xml:lang="en">building and site survey</skos:prefLabel>
        <skos:prefLabel xml:lang="es">inspección de edificios y de su entorno</skos:prefLabel>
        <skos:prefLabel xml:lang="ro">monitorizarea sitului și a Ro monumentului</skos:prefLabel>
        <skos:prefLabel xml:lang="pl">oględziny budynku i otoczenia</skos:prefLabel>
        <skos:prefLabel xml:lang="hr">pregled građevine i mjesta</skos:prefLabel>
        <skos:prefLabel xml:lang="it">sondaggi sull’edificio e sul sito</skos:prefLabel>
        <skos:prefLabel xml:lang="hu">épület- és helyszínfelmérés</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">étude diagnostic des bâtiments et sites (état sanitaire du bâti)</skos:prefLabel>
        <skos:prefLabel xml:lang="bg">Визуално проучване на сгради и забележителни места</skos:prefLabel>
    </owl:NamedIndividual>
    


