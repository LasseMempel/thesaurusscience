    <!-- https://hist-arch-vocab.org/bvha#c_461322aa -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_461322aa">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_ff5ae73d"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_4b0fc1fe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-12-18T15:46:04.000</terms:created>
