		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk005407"/>
		<skos:definition xml:lang="de">Eine Waschküche ist ein Arbeitsraum, der zur Wäschereinigung bestimmt ist.</skos:definition>
