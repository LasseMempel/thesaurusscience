		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500622" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/99" />
		<skos:scopeNote xml:lang="en">The residence and outbuildings of an outlying farm or estate, especially that held by a monastery or other religious order.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
