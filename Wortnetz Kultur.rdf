		<skos:prefLabel xml:lang="de">Alkoholfreies Getränk</skos:prefLabel>
		<skos:altLabel xml:lang="de">Nichtalkoholisches Getränk</skos:altLabel>
		<skos:prefLabel xml:lang="en">Non-alcoholic beverage</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk008874"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk008874"/>
		<skos:definition xml:lang="de">Ein alkoholfreies Getränk ist ein Getränk, das in der Regel maximal 0,5 Volumenprozent Alkohol beinhaltet.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4001216-5"/>
