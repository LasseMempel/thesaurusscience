        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_42f07927"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-26T18:38:29.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T16:22:06.000</terms:modified>
        <skos:definition xml:lang="de">Historienbibel f: reich illustrierte Bearbeitung der heiligen Schrift, welche nur die biblischen Geschichten, nicht die belehrenden und prophetischen Bücher enthält; vor allem zwischen dem 13. und 15. Jh. verbreitet. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Historienbibel</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">recueil des récits de la Bible</skos:prefLabel>
    </owl:NamedIndividual>
    


