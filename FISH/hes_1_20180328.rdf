		<skos:prefLabel xml:lang="gd">DOCA-TIORAM</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Lann cloiche no concrait aig a bheil doras a thathar a' dùnadh le caisson air fleòd no geataichean agus a ghabhas a thraoghadh ach an urrainnear sligean longan no acainnean a tha fon loidhne-shnàimh a sgrùdadh, a ghlèidheadh no a chàradh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">DRY DOCK</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1387" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1018" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1024" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1398" />
		<skos:scopeNote xml:lang="en">A stone- or concrete-faced enclosure, with entrance closed by a floatable caisson or by gates, which can be pumped dry for inspection, maintenance or repair of hull or underwater fittings.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
