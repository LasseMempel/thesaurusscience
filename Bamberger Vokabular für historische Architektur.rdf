        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-11-04T18:16:18.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T14:57:13.000</terms:modified>
        <skos:altLabel xml:lang="de">Keilladen</skos:altLabel>
        <skos:definition xml:lang="de">Boden- bzw. Deckenbohlen werden entweder fassadensichtig auf die Deckenblockkränze verlegt oder in Nuten derselben eingeschoben. Bei Letzterem wird eine keilförmige Bohle (Schließbohle, Keilladen) von außen durch eine Öffnung im Deckenblockholz eingetrieben und verspannt die bereits verlegten Deckenbohlen. Das Ende der Schließbohle kann außen aus der Wand vorstehend belassen werden oder es wird abgesägt und die Öffnung im Blockholz verschlossen oder sichtbar gelassen. [Eißing et al. 2012]</skos:definition>
        <skos:prefLabel xml:lang="de">Schließbohle</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_1cb81a92"/>
    </owl:NamedIndividual>
    


