	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk018226">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Büchsenmilch</skos:altLabel>
		<skos:altLabel xml:lang="en">condensed milk</skos:altLabel>
		<skos:altLabel xml:lang="de">Dosenmilch</skos:altLabel>
		<skos:prefLabel xml:lang="en">evaporated milk</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Kondensmilch</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk009647"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013756"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk009647"/>
		<xe:ter01221 rdf:resource="http://lvr.vocnet.org/wnk/wk017318"/>
		<skos:definition xml:lang="de">Kondensmilch ist ein Milchprodukt, das durch das Entfernen von Wasser aus Frischmilch hergestellt wird, was zu einer dickflüssigen und haltbaren Substanz führt. Kondensmilch gibt es in verschiedenen Fettgehaltsstufen mit oder ohne Zucker und wird oft für Kaffee verwendet.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4240772-2"/>
