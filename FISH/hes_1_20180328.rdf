	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1524">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1524</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">UCHDAN-RATHAID</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Druimean ùir, cloiche no grinneil fada a chaidh a thogail gu sònraichte mar bhunait do rathad.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">EMBANKMENT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-31T14:16:41</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1442" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1796" />
		<skos:scopeNote xml:lang="en">A long ridge of earth, rocks or gravel primarily constructed to carry a roadway.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1525">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1525</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">GEÀRRAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite mun a bheil crìochan soilleir. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ENCLOSURE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1528">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1528</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">GEÀRRAIDH CHRUINN</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Pìos talmhainn cruinn mun a bheil dìg, uchdan, balla, sonnach no crìoch eile mar sin.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">CIRCULAR ENCLOSURE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1525" />
				<skos:scopeNote xml:lang="en">A circular shaped area of land enclosed by a boundary ditch, bank, wall, palisade or similar barrier.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
