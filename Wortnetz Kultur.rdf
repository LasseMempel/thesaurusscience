		<skos:altLabel xml:lang="de">Amtlicher Fachassistent</skos:altLabel>
		<skos:prefLabel xml:lang="de">Fleischbeschauer</skos:prefLabel>
		<skos:altLabel xml:lang="de">Fleischkontrolleur</skos:altLabel>
		<skos:prefLabel xml:lang="en">meat inspector</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk008906"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk009791"/>
