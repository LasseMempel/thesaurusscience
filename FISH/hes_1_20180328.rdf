		<skos:prefLabel xml:lang="gd">TAIGH-DROCHAID</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Taigh-còmhnaidh neach na drochaid.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BRIDGE KEEPERS COTTAGE</skos:prefLabel>
