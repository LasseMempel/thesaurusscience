        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T14:24:48.000</terms:modified>
        <skos:altLabel xml:lang="es">claraboya</skos:altLabel>
        <skos:altLabel xml:lang="cs">patro</skos:altLabel>
        <skos:altLabel xml:lang="cs">poschodí</skos:altLabel>
        <skos:altLabel xml:lang="cs">stěna s okny nad bočni lodí basiliky</skos:altLabel>
        <skos:altLabel xml:lang="fr">étage clair</skos:altLabel>
        <skos:definition xml:lang="cs">1. Německý výraz pro horní okenní stěnu baziliky. 2. Vysunuté dřevěné horní patro obranné věže, podsebití. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Nach allen Seiten ausladender, hölzerner Aufbau auf Bergfriedenmit der Wohnung des Türmers. [Koepf/Binding 2016]</skos:definition>
