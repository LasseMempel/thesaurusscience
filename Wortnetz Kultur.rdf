	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk017869">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Sammeltassen Set</skos:altLabel>
		<skos:prefLabel xml:lang="de">Sammeltassen-Set</skos:prefLabel>
		<skos:altLabel xml:lang="de">Sammeltassenset</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk008305"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013716"/>
