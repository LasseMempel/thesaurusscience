		<skos:prefLabel xml:lang="en">breast beam</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Brustbaum</skos:prefLabel>
		<skos:altLabel xml:lang="de">Brustbäume</skos:altLabel>
		<skos:altLabel xml:lang="de">Pinnebaum</skos:altLabel>
		<skos:altLabel xml:lang="de">Spannbaum</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk018661"/>
