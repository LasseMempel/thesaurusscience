    <skos:scopeNote xml:lang="en">An excavation used as a means of concealment, protection or both.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159184">
    <skos:scopeNote xml:lang="en">A chapel within a parish church or other religious building for use by the lord of the manor and his family</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70423">
    <skos:scopeNote xml:lang="en">An underground channel with a vaulted roof. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
