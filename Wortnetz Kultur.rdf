	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004287">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">clergy</skos:prefLabel>
		<skos:altLabel xml:lang="de">Geistlicher Stand</skos:altLabel>
		<skos:altLabel xml:lang="de">Kleriker (Gemeinschaft)</skos:altLabel>
		<skos:altLabel xml:lang="de">Klerikerstand</skos:altLabel>
		<skos:prefLabel xml:lang="de">Klerus</skos:prefLabel>
		<skos:altLabel xml:lang="de">Priesterstand</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk009555"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019472"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk009555"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk006405"/>
		<xe:explanation_temp xml:lang="de">Der Begriff findet – in Abgrenzung zu den Laien – vornehmlich für das römisch-katholische Priestertum Anwendung, kann aber auch auf Verhältnisse anderer Religionen übertragen verwendet werden. Die übertragene Verwendung des Begriffs &amp;quot;Klerus&amp;quot; für die Geistlichen anderer Konfessionen und Religionen ist lediglich umgangssprachlich.</xe:explanation_temp>
		<skos:definition xml:lang="de">Der Begriff Klerus bezeichnet Personen, die die Gemeinschaft der unter Kirchenrecht lebenden Angehörigen des Priesterstandes bilden.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk009555"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019472"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-12-07T18:28:31+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004289">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">Lourdes grotto</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Lourdesgrotte</skos:prefLabel>
		<skos:altLabel xml:lang="de">Lourdesgrotten</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003189"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk005847"/>
