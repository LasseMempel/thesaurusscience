        <skos:altLabel xml:lang="fr">voûte d\&apos;ogives surbaissée </skos:altLabel>
        <skos:definition xml:lang="de">Gedrücktes Kreuzgewölbe, gelegentlich mit Stich, Busung und Stichkappen. Zu unterscheiden von der Kreuzkappe als Abschnitt eines Kreuzgewölbes. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Kreuzkappengewölbe</skos:prefLabel>
        <skos:prefLabel xml:lang="en">surbased cross vault</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte d\&apos;arêtes surbaissée</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_5f9418c5"/>
    </owl:NamedIndividual>
    


