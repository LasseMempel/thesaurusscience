    <!-- https://hist-arch-vocab.org/bvha#c_23c4d45c -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_23c4d45c">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_55c4eb4e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_f10222e0"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-18T16:24:40.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T14:42:12.000</terms:modified>
        <skos:definition xml:lang="de">Nach dem exakten Ausarbeiten der Fehlstelle sowie der passgenauen Vierung wird die Harzmischung langsam in einem geeigneten Metallbehälter erhitzt und gut umgerührt. [...] Der flüssige Kleber wird mit einem feinen Spachtel aufgetragen, und die Vierung wird sofort eingesetzt und gut festgedrückt. [Voelkle 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Vierungseinsatz mit Kleber</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_23c647ef -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_23c647ef">
