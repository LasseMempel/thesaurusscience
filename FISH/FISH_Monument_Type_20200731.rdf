    <skos:scopeNote xml:lang="en">A tall wooden pole used to support telegraph wires.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159197">
