		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/506101" />
		<skos:scopeNote xml:lang="en">An artificial mound used to farm rabbits. Usually flat-topped and rectangular, and often surrounded by a shallow ditch.</skos:scopeNote>
