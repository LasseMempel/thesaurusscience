        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-04T15:42:13.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T14:31:18.000</terms:modified>
        <skos:altLabel xml:lang="de">Schräglicht</skos:altLabel>
        <skos:altLabel xml:lang="de">Seitenlicht</skos:altLabel>
        <skos:altLabel xml:lang="de">Streiflicht</skos:altLabel>
        <skos:note xml:lang="en">The surface is lit, preferably using daylight-spots at a specific angle, in order to show the relief through shadow effects. [EwaGlos]</skos:note>
        <skos:note xml:lang="de">Um ihr Relief durch Schatteneffekte zu zeigen, wird die Oberfläche, am besten mit Tageslichtleuchten, in einem bestimmten Winkel beleuchtet. [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="de">Streifbelichtung</skos:prefLabel>
        <skos:prefLabel xml:lang="en">raking light</skos:prefLabel>
    </owl:NamedIndividual>
    


