    <!-- https://hist-arch-vocab.org/bvha#c_525aa32e -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_525aa32e">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_694d7977"/>
