        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-14T13:08:49.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T16:44:56.000</terms:modified>
        <skos:altLabel xml:lang="de">Kelchknospenkapitell</skos:altLabel>
        <skos:altLabel xml:lang="de">Knollenkapitell</skos:altLabel>
        <skos:altLabel xml:lang="en">crocket capital</skos:altLabel>
        <skos:definition xml:lang="de">Knospenkapitell, Knollenkapitell, ein Kelch- oder Kelchblockkapitell, das mit plast. volutenartigen Knospenstengel geziert ist, bes. in der Spätromanik und Frühgotik häufig (Kapitell). [Koepf / Binding 2016]</skos:definition>
