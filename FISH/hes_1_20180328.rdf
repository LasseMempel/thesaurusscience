		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501707" />
		<skos:scopeNote xml:lang="en">A building, suite of rooms or hall, within a larger building such as a tollbooth or a town-house, in which meetings of the burgh were held.</skos:scopeNote>
