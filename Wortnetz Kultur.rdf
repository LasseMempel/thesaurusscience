	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk012892">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">festive dishes</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Festspeise</skos:prefLabel>
		<skos:altLabel xml:lang="de">Festspeisen</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk008333"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk018622"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk008333"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk006601"/>
		<skos:definition xml:lang="de">Eine Festspeise ist eine Speise, die an Feiertagen oder zu Festen gegessen wird und die es nicht jeden Tag gibt.</skos:definition>
		<xe:explanation_temp xml:lang="de">Sie ist oft aufwendiger herzustellen und/oder kann aus kostspieligeren Zutaten bestehen. Festspeisen sind häufig mit Tradition verbunden.</xe:explanation_temp>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk018622"/>
