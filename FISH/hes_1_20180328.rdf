		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/855" />
		<skos:scopeNote xml:lang="en">A factory where tarpaulins are produced, usually from canvas.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
