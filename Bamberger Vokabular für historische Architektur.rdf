        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T01:40:30.000</terms:modified>
        <skos:definition xml:lang="de">Atelier (artiliara v. lat. ars: Kunst, altfrz. artelier), Werkstatt, insbes. Künstlerwerkstatt; heute auch jeder Raum von bedeutenderer Größe und spezieller Beleuchtung für bes. handwerkliche Tätigkeit. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Atelier</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">ateliér</skos:prefLabel>
    </owl:NamedIndividual>
    


