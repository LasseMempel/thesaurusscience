		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-11-27T11:11:14+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk001950">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Bettelorden</skos:prefLabel>
		<skos:prefLabel xml:lang="en">mendicant order</skos:prefLabel>
		<skos:altLabel xml:lang="en">mendicant orders</skos:altLabel>
		<skos:altLabel xml:lang="de">Mendikanten</skos:altLabel>
		<skos:altLabel xml:lang="de">Mendikanten-Orden</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003837"/>
