        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T18:02:17.000</terms:modified>
        <skos:definition xml:lang="cs"> V umění se používá mnohem méně, než se obecně předpokládá: kvadratura, čtverec jako jednotka míry. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="cs">1. proporční systém, 2. rajský dvůr s ambitem (křížovou chodbou). [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Proportionsschlüssel zur Bestimmung der Maßverhältnisse von Bauteilen untereinander und in Bezug auf das Ganze. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="es"> cuadratura</skos:prefLabel>
        <skos:prefLabel xml:lang="fr"> quadrature</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Quadratur (Proportion)</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kvadratura (proporce)</skos:prefLabel>
        <skos:prefLabel xml:lang="en">quadratura</skos:prefLabel>
        <skos:prefLabel xml:lang="it">quadratura</skos:prefLabel>
    </owl:NamedIndividual>
    


