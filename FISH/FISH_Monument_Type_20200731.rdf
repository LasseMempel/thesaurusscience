  </skos:Concept>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70283">
    <skos:scopeNote xml:lang="en">A post bearing one or more signs indicating the direction, and often the distance, to specified locations or routes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70279">
    <skos:scopeNote xml:lang="en">A track inlaid into the road surface of a street or road, on which tram cars run for the conveyance of passengers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70182">
    <skos:scopeNote xml:lang="en">A sacred area of a building or a consecrated piece of land.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/152525">
    <skos:scopeNote xml:lang="en">Material, stone or wood, lining the inside of a grave.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68656">
    <skos:scopeNote xml:lang="en">A tract of land with trees, sometimes acting as a boundary or barrier, usually smaller and less wild than a forest.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159254">
    <skos:scopeNote xml:lang="en">A vertical shaft, usually with an internal ladder, allowing access to a sewer or underground counduit for inspection and maintenance.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87819">
    <skos:scopeNote xml:lang="en">An underground passageway for cables, pipes and pedestrians to allow passage beneath an over ground obstacle.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140547">
    <skos:scopeNote xml:lang="en">A control tower constructed on RNAS stations by the Royal Marine Engineers. Built to a common ground floor plan they could be built with one, two or three storeys above this depending on the requirements of the station.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140186">
    <skos:scopeNote xml:lang="en">A pit where calcium oxide (Quicklime) has been hydrated to produce calcium hydroxide, known as slaked lime.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69307">
    <skos:scopeNote xml:lang="en">A factory or site where wooden clogs are manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142071">
    <skos:scopeNote xml:lang="en">An intrusive feature cut for the purpose of containing a cremation burial within it.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68742">
    <skos:scopeNote xml:lang="en">An outdoor meeting place.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69110">
    <skos:scopeNote xml:lang="en">A site where jet is extracted from the surface of the ground.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94047">
    <skos:scopeNote xml:lang="en">A roadside telephone box for use by motorists in need of assistance.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99535">
    <skos:scopeNote xml:lang="en">A large hilltop or hillslope enclosure in South West England, located close to rock outcrops, and surrounded by one or more circuits of stone built walls. All are prehistoric; some are definitely Neolithic.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69067">
    <skos:scopeNote xml:lang="en">A site incorporating all of the production processes for the manufacture of plaster.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68696">
    <skos:scopeNote xml:lang="en">A hall used for housing public displays.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93391">
    <skos:scopeNote xml:lang="en">An area of prepared ground on which a sport is played. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170658">
    <cc:attributionURL rdf:resource="http://www.historicengland.org.uk"/>
    <skos:prefLabel xml:lang="en">Curling Pond</skos:prefLabel>
    <dcterms:identifier>http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170658</dcterms:identifier>
    <cc:license rdf:resource="http://creativecommons.org/licenses/by/3.0"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-17T14:18:30</dcterms:issued>
    <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
    <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2"/>
    <dcterms:publisher rdf:resource="http://www.historicengland.org.uk"/>
  </skos:Concept>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94054">
    <skos:scopeNote xml:lang="en">Use for distinct structure on a large scale.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92605">
    <skos:scopeNote xml:lang="en">A post or pillar set up alongside a road to mark the miles from or to a place.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93193">
    <skos:scopeNote xml:lang="en">A type of warehouse found in naval victualling yards, used for the storage of rum, a ration of which was given on a daily basis to members of the Royal Navy, up until the 1980s, when this practice ceased.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92325">
    <skos:scopeNote xml:lang="en">A hydraulically-powered crane where the jib and windlass are mounted on a central pillar.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/146405">
    <skos:scopeNote xml:lang="en">A building or subterranean structure used for the storage of meat.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68702">
    <skos:scopeNote xml:lang="en">A school for instruction in the art of horsemanship.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140389">
    <skos:scopeNote xml:lang="en">A military storage aircraft hangar built  in the late 1930s. It comprises a semicircular concrete structure with reinforced concrete columns, featuring a curved roof and straight walls.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91837">
    <skos:scopeNote xml:lang="en">A refractory lined furnace in which an electric arc is struck between the electrode and the metal to be melted.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/139095">
    <skos:scopeNote xml:lang="en">A boat roofed over and fitted up as a home for living in permanently or temporarily.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69410">
    <skos:scopeNote xml:lang="en">A factory or works housing machinery used to produce stockings and socks, using mechanized knitting processes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/100226">
    <skos:scopeNote xml:lang="en">A building with an aisle on one side only.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92934">
    <skos:scopeNote xml:lang="en">A burial ground for victims of the plague.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142084">
    <skos:scopeNote xml:lang="en">A hut provided as accommodation for hop pickers and may also be know as a Hop Pickers' Hut</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68571">
    <skos:scopeNote xml:lang="en">Pasture to which animals were driven for grazing, with associated temporary huts for domestic or agricultural use.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170637">
    <skos:prefLabel xml:lang="en">Whetstone Mine</skos:prefLabel>
    <dcterms:publisher rdf:resource="http://www.historicengland.org.uk"/>
    <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93044">
    <skos:scopeNote xml:lang="en">A stone used to instruct a coachman to take an extra trace horse to assist on roads of a steep gradient.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69441">
    <skos:scopeNote xml:lang="en">A beacon used for coastal navigation. Many date from the Medieval period.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93066">
    <skos:scopeNote xml:lang="en">A structure which allows aircraft fitted with radar equipment to 'home' in on an airfield in the dark or in poor visibility, and land safely. Radar beacons can also be used as navigation aids.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167073">
    <skos:scopeNote xml:lang="en">An underground hideout containing radio equipment to be used by the Special Duties sections of the Auxiliary Units to recieve coded information from the out-stations in the surrounding area for relaying to headquarters via direct phone line.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68549">
    <skos:scopeNote xml:lang="en">A large barn used to store the tithe (a tenth part of the annual produce of agriculture etc.) which was paid by the tenants of ecclesiastical lands.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160407">
    <skos:scopeNote xml:lang="en">A bungalow joined to another to form one building.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160262">
    <skos:scopeNote xml:lang="en">A two-storey, all-concrete construction with a watch office and additional rooms given over to the meteorological section, including a forecast room and met store. A concrete parapet all around the roof differentiates it from 5845/39.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159266">
    <skos:scopeNote xml:lang="en">A body of water placed in such a way as to reflect a building or landscape feature.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/100515">
    <skos:scopeNote xml:lang="en">A structure used for the transmission and interception of radio signals. Usually composed of a number of different elements such as aerials, receiving equipment and supporting pylons.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164189">
    <skos:scopeNote xml:lang="en">A building manufacturing bandages.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141906">
    <skos:scopeNote xml:lang="en">A depot for the depositing, storage and dispatch of plant or other resources associated with the delivery of local government public services.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93344">
    <skos:scopeNote xml:lang="en">A specialist hospital for the medical treatment of skin diseases.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70291">
    <skos:scopeNote xml:lang="en">A place where canal boats are built and maintained.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70146">
    <skos:scopeNote xml:lang="en">A friary belonging to the Friars of the Sack also known as Friars of Penance or Penitentia.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159210">
    <skos:scopeNote xml:lang="en">A telescope which is mounted so as to allow the observation of only those objects in the sky which are passing over a local meridian, an event known as transit.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68990">
    <skos:scopeNote xml:lang="en">A Palaeolithic or Mesolithic occupation site, excluding occupations of caves and rock shelters. Evidence for occupation may include traces of hearths and other structures.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87522">
    <skos:scopeNote xml:lang="en">Finishing process for cloth, especially linen, running the cloth between heavy rollers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93777">
    <skos:scopeNote xml:lang="en">A prime mover in which a central wheel with curved vanes, enclosed in a chamber, receives water directed onto the curved vanes by a ring of fixed guide vanes, causing the wheel to rotate about its axis.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94114">
    <skos:scopeNote xml:lang="en">A house having four rooms of equal height on each of two floors; in larger houses there are often two parallel and equal roofs.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70381">
    <skos:scopeNote xml:lang="en">A cairn erected to mark a particular spot in the landscape. Can be used for various reasons.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99547">
    <skos:scopeNote xml:lang="en">A place of worship for Primitive Methodists, a group founded in Manchester who broke away from the Methodists in 1806.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/146356">
    <skos:scopeNote xml:lang="en">An offshoot of the Wesleyan movement founded in 1838 by John Banyard at Rochford, Essex. In 1956 it changed name to the Union of Evangelical Churches. There are 17 chapels in Essex and London.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70045">
    <skos:scopeNote xml:lang="en">A Neolithic burial monument comprising a stone-built chamber within a mound of stones. Use more precise term where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69223">
    <skos:scopeNote xml:lang="en">Any factory or site using machine tools in a manufacturing or processing capacity.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141942">
    <skos:scopeNote xml:lang="en">Stop-line against invading tanks in form of a ditch during the defence of Britain.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71794">
    <skos:scopeNote xml:lang="en">An office for the payment of wages, especially in industrial or commercial complexes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/132373">
    <skos:scopeNote xml:lang="en">Workshop, as part of a gunpowder works complex, in which explosive is loaded into shells. Also used for expense magazine, where powder was stored between work processes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160269">
    <skos:scopeNote xml:lang="en">A two-storey, brick construction with a watch office and additional rooms given over to the meteorological section, including a forecast room and met store. A brick parapet on the roof differentiates it from 2328/39.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92310">
    <skos:scopeNote xml:lang="en">A place of worship for members of the French Protestant church of the 16th and 17th centuries.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92691">
    <skos:scopeNote xml:lang="en">A place of worship for Protestant followers of Hussite doctrines which accept the Bible as the only source of faith.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/166985">
    <skos:scopeNote xml:lang="en">Casing for electrical connections: an enclosed and protected box inside which electrical circuits are interconnected or branched for distribution.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68998">
    <skos:scopeNote xml:lang="en">A settlement without any obvious evidence for a boundary. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68994">
    <skos:scopeNote xml:lang="en">A settlement, usually enclosed, on a sloping hillside containing a number of oval or circular scopped house floors separated by walls or unexcavated ridges.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/103032">
    <skos:scopeNote xml:lang="en">A market consisting of stalls erected in the street and selling a variety of goods.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69000">
    <skos:scopeNote xml:lang="en">Small discreet rural settlements which do not provide the commercial, legal or ecclesiastical services typically found within medieval urban areas.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93622">
    <skos:scopeNote xml:lang="en">A pillar housing a transformer to convert AC electricity supply, for use by electrified transport systems or for domestic purposes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71774">
    <skos:scopeNote xml:lang="en">Traditionally a mew was a building housing hawks when they were moulting, however since the C16th the term has been used for a series of stables grouped around an open yard or alley, often with rooms above. Use only for stables otherwise use FALCONRY.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/144469">
    <skos:scopeNote xml:lang="en">A site, building or factory where seawater is used in the production of salt.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94388">
    <skos:scopeNote xml:lang="en">A place of residence and worship for Anglican monks.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71498">
    <skos:scopeNote xml:lang="en">Purpose-built housing for railway workers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93932">
    <skos:scopeNote xml:lang="en">A site where small electrical goods such as radios, lamps and heaters are manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91239">
    <skos:scopeNote xml:lang="en">A small metal bar for the cleaning of dirty footwear before entering a house, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140331">
    <skos:scopeNote xml:lang="en">A defensive construction situated in the sea, designed to protect the land from seabourne attack. The term applies mainly to those monuments built from around 1860 onwards.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69168">
    <skos:scopeNote xml:lang="en">A pit dug for the extraction of brine.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170658">
    <skos:scopeNote xml:lang="en">A shallow outdoor pool, usually rectangular in shape filled with water which when frozen was used for the sport of Curling.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92249">
    <skos:scopeNote xml:lang="en">A building where merchandise and goods are temporarily stored before or after transportation by rail.</skos:scopeNote>
  </rdf:Description>
  <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170624">
    <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2"/>
    <skos:prefLabel xml:lang="en">Renewable Energy Park</skos:prefLabel>
    <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-17T14:18:30</dcterms:issued>
    <cc:license rdf:resource="http://creativecommons.org/licenses/by/3.0"/>
    <cc:attributionURL rdf:resource="http://www.historicengland.org.uk"/>
    <dcterms:identifier>http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170624</dcterms:identifier>
    <dcterms:publisher rdf:resource="http://www.historicengland.org.uk"/>
  </skos:Concept>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92346">
    <skos:scopeNote xml:lang="en">A stone edge-runner grinding machine or mill used for mechanically grinding and mixing the ingredients of gunpowder.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164357">
    <skos:scopeNote xml:lang="en">Factory where yarn is made from paper.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91495">
    <skos:scopeNote xml:lang="en">Buildings, sites and structures associated with the extraction of clay.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68545">
    <skos:scopeNote xml:lang="en">A building where animals are slaughtered.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71363">
    <skos:scopeNote xml:lang="en">A canopy or building to cover the platforms in a railway station.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143956">
    <skos:scopeNote xml:lang="en">Any building or site in which silver was refined and/or extracted by smelting, cupellation, liquation or by the Parkes Process. IA-C20. Don't use for lead or copper smelters at which silver has been extracted unless silver-related features survive.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92508">
    <skos:scopeNote xml:lang="en">The masonry beneath a lock gate, sometimes projecting several feet from the gate.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91813">
    <skos:scopeNote xml:lang="en">A boundary post for the payment of tax or duty.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91434">
    <skos:scopeNote xml:lang="en">A school used by the children of settlers at a Chartist Colony.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68832">
    <skos:scopeNote xml:lang="en">A target range used for rifle and small arms practice and recreational purposes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143389">
    <skos:scopeNote xml:lang="en">A picture or pattern produced by either by cementing together small pieces of stone or glass of various colours or by painting directly onto a wall.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93429">
    <skos:scopeNote xml:lang="en">A terrace of houses built on a slope giving the roofline a stepped appearance.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70432">
    <skos:scopeNote xml:lang="en">An artificial water channel for carrying water over long distances. Use also for bridge-like structures that carry the channel or canal across a valley, river or other obstacle.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92835">
