<http://www.eionet.europa.eu/gemet/concept/2696> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2286> ;
    skos:definition "A comprehensive, often multivolume, reference work containing articles on a wide rage of subjects or on various aspects of a particular field, usually, alphabetically arranged."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/4137> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Enzyklopädie"@de,
        "encyclopaedia"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Encyclopedia> .

<http://www.eionet.europa.eu/gemet/concept/2704> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9166> ;
    skos:closeMatch <http://data.uba.de/umt/_00011996> ;
    skos:definition "Threat to the quality and quantity of groundwater by activities related to the use of land. As some activities (e.g. landfill) present a particular risk of pollution, the closer an activity is to a well or borehole, the greater the risk of the pumped water being polluted. The type of soil, the geology, the rainfall and the amount of water pumped out of the ground must all be taken into consideration."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Grundwassergefährdung"@de,
        "groundwater endangering"@en .

<http://www.eionet.europa.eu/gemet/concept/2705> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/406> ;
    skos:closeMatch <http://data.uba.de/umt/_00047749>,
        <http://dbpedia.org/resource/Endocrine_system> ;
    skos:definition "The chemical coordinating system in animals, that is, the endocrine glands that produce hormones."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:narrowMatch <http://eurovoc.europa.eu/5720> ;
    skos:prefLabel "Endokrines System"@de,
        "endocrine system"@en .

<http://www.eionet.europa.eu/gemet/concept/2706> a skos:Concept ;
