		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019909"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-08-01T15:38:28+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004219">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">numerus fort</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Numeruskastell</skos:prefLabel>
		<skos:altLabel xml:lang="de">Numeruskastelle</skos:altLabel>
		<skos:altLabel xml:lang="de">Numeruslager</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004216"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010526"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk016332"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019909"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004216"/>
		<skos:definition xml:lang="de">Ein Numeruskastell ist ein römisches Auxiliarlager, in dem eine Numerus-Einheit, eine meist kleinere und weniger standardisierte Hilfstruppe, stationiert ist. Es ist in der Regel kleiner als andere Auxiliarlager und die Bebauung kann stärker vom Standard abweichen. Dies zeigt sich oft in einer einfacheren oder weniger normierten Infrastruktur, die der meist geringeren Truppengröße und den speziellen Aufgaben der Numeri angepasst ist.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004216"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010526"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk016332"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019909"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
