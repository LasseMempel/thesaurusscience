        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-05T18:42:49.000</terms:modified>
        <skos:altLabel xml:lang="de">Lebende Last</skos:altLabel>
        <skos:altLabel xml:lang="de">Nutzlast</skos:altLabel>
        <skos:altLabel xml:lang="fr">charge roulante</skos:altLabel>
        <skos:definition xml:lang="de">Die aus Kräften und Gewichten resultierende Last, die nur vorübergehend wirksam ist, z.B. durch Witterungseinflüsse, verkehrsbedingte Erschütterungen oder Arbeiten am Gebäude. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Die veränderliche oder bewegliche Belastung des Bauteils (z.B. Personen, Einrichtungsstücke, Lagerstoffe, Riemenantriebe, Kranlasten, Wind und Schnee). [BVHA]</skos:definition>
        <skos:prefLabel xml:lang="de">Verkehrslast</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">charge variable</skos:prefLabel>
        <skos:prefLabel xml:lang="en">life load</skos:prefLabel>
    </owl:NamedIndividual>
    


