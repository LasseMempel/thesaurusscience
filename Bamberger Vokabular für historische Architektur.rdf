        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-28T09:32:53.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T13:01:58.000</terms:modified>
        <skos:definition xml:lang="de">Ein in die seitlichen Wände einer Schießscharte eingelassenes waagerechtes Holz, vor dem der Haken der Hakenbüchse lag, um den Rückstoß aufzunehmen. Das P. war 6 x 6 bis 12 x 12 cm stark und konnte manchmal auch in der Höhe verstellt werden. E. B. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:prefLabel xml:lang="de">Prellholz</skos:prefLabel>
    </owl:NamedIndividual>
    


