    <!-- https://hist-arch-vocab.org/bvha#c_336d5c5d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_336d5c5d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_7860420e"/>
