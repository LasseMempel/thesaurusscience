        "polycyclic aromatic hydrocarbon"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/1182> .

<http://www.eionet.europa.eu/gemet/concept/6528> a skos:Concept ;
    skos:broadMatch <http://eurovoc.europa.eu/1773> ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2060> ;
    skos:closeMatch <http://data.uba.de/umt/_00004777> ;
    skos:definition "The direction of change in the total number of persons inhabiting a country, city, district or area."@en ;
