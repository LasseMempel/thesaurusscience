		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/470" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/476" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/477">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/477</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">GLÌB</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Pìos fearainn aig eaglais paraiste no oifis eaglaise no fearann a gheibh i cìs dheth. Tha seo na ionaltradh faisg air eaglais no mansa gu tric.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">GLEBE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/405" />
				<skos:scopeNote xml:lang="en">A plot of land belonging, or yielding revenue, to a parish church or ecclesiastical office. Often pasture land adjacent to a church or manse.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/478" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/481" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/482" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/483" />
