        <skos:altLabel xml:lang="en">hairline crack</skos:altLabel>
        <skos:definition xml:lang="fr">Fissure d’ouverture inférieure à 0,1 mm. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="en">Minor crack with width dimension &lt; 0.1 mm [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="de">Schmaler Riss mit einer Breite von &lt; 0,1 mm. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="cs">prasklina o šíři menší než 0,1 mm. [ICOMOS-ISCS]</skos:definition>
        <skos:note xml:lang="en">A minor, individual discontinuity that is visible on the surface. [EwaGlos]</skos:note>
