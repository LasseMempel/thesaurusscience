        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-20T15:12:03.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T18:16:20.000</terms:modified>
        <skos:altLabel xml:lang="fr">triforium aveugle</skos:altLabel>
        <skos:definition xml:lang="de">Zwischen Arkaden und Obergadenfenstern einer dreischiffigen Basilika in den Dachraum der Seitenschiffe geöffnete Arkaden. [Koepf / Binding 2016]</skos:definition>
