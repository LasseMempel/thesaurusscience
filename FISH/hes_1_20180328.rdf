		<skos:prefLabel xml:lang="gd">RÈILE-THRAMAICHEAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Traca a chaidh a laighe ann an uachdar air a bheil tramaichean a' falbh 's iad a' gluasad luchd-siubhail agus/no bathar is bathar amh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TRAMWAY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
