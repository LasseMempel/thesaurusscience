	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk008216">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Relief (Bildwerk)</skos:prefLabel>
		<skos:prefLabel xml:lang="en">relief (sculpture)</skos:prefLabel>
		<skos:altLabel xml:lang="en">relief sculpture</skos:altLabel>
		<skos:altLabel xml:lang="de">Reliefbild</skos:altLabel>
		<skos:altLabel xml:lang="de">Reliefdarstellung</skos:altLabel>
		<skos:altLabel xml:lang="de">Reliefe (Bildwerke)</skos:altLabel>
		<skos:altLabel xml:lang="de">Reliefs (Bildwerke)</skos:altLabel>
		<skos:altLabel xml:lang="en">reliefs (sculptures)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000742"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000742"/>
		<skos:definition xml:lang="de">Ein Relief ist ein Bildwerk, das sich plastisch von einem flachen Hintergrund abhebt. Es kann erhaben aus der Fläche hervortreten oder in diese eingesenkt sein. Reliefs können figürliche oder abstrakt-ornamentale Darstellungen aufweisen und aus verschiedenen Materialien gefertigt werden, etwa Stein, Holz, Metall, Elfenbein oder Keramik. Sie können gemeißelt, geschnitzt, gegossen, geprägt oder anders geformt werden. In der Architektur und Kunst finden sich Reliefs häufig an Gebäuden, Denkmälern, Münzen und als eigenständige Kunstwerke.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300047230"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q245117"/>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4049373-8"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000742"/>
