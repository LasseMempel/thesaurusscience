	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/638">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/638</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">OSPADAL LOBHAR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Ospadal far a bheilear a' gabhail cùram lobharan. Rè nam meadhan-aoisean, bhiodh seo a' gabhail a-steach eaglais agus àite-fuirich fa leth dha na lobharan.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">LEPER HOSPITAL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-10-29T11:24:55</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">LEPER HOUSE</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/505561" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/494" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/519" />
		<skos:scopeNote xml:lang="en">A hospital where people with leprosy are cared for. During the medieval period, this usually comprised a church and separate accommodation for lepers.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/640">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/640</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">OSPADAL</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Aonad sònraichte am broinn aitreabh ospadail. Dh'fhaoidte gum bi seo na thogalach fa leth no gu bheil trannsa no slighe le mullach a' dol ann on phrìomh-thogalach.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HOSPITAL BLOCK</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/624" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/636" />
		<skos:scopeNote xml:lang="en">A specialist unit within a hospital complex. It may be a separate building or sometimes linked by a corridor or covered walkway to a main building.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/641">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/641</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH-EIRIDINN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach far am faigh daoine a tha tinn cùram. Cleachd seo ma tha e na phàirt de dh'aitreabh nas motha air neo cleachd OSPADAL.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">INFIRMARY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/624" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/167" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1757" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/544" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/636" />
		<skos:scopeNote xml:lang="en">A building where the sick are cared for. Use where part of a wider complex, otherwise use HOSPITAL.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
