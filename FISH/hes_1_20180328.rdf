	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/174">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/174</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CROICH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar a bhathar a' cleachdadh airson daoine a chur gu bàs le bhith gan crochadh. Mar is trice dà chrann dìreach agus pìos tarsainn orra a bhite a' crochadh an eucoirich air a' mhuineal aige no aice.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GALLOWS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/173" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/175" />
		<skos:scopeNote xml:lang="en">A structure used for execution by hanging. Usually two uprights and a cross-piece, from which the offender is suspended by the neck.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/175">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/175</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CNOC A’ CHROCHADAIR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Torr ùir nàdarra no fear a chaidh a dhèanamh le daoine 's air an deach croich a thogail.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GALLOWS MOUND</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-12-07T10:24:12</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1564" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/173" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/174" />
		<skos:scopeNote xml:lang="en">A natural or man-made earth mound on which a gallows was erected.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
