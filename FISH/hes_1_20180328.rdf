		<skos:prefLabel xml:lang="gd">FÙIRNEIS MHEATAILTEAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Fùirneis far a bheilear a' dèanamh meatailte de chlachan-mèinn.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">METAL PRODUCTION FURNACE</skos:prefLabel>
