    <!-- https://hist-arch-vocab.org/bvha#c_29fed5f3 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_29fed5f3">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_69593e2e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-18T16:30:34.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T17:30:44.000</terms:modified>
        <skos:altLabel xml:lang="de">Basilikaschirm</skos:altLabel>
        <skos:altLabel xml:lang="en">umbellina</skos:altLabel>
        <skos:definition xml:lang="de">Padiglione n, it.; auch Basilikaschirm m; Conopeum n der Basiliken: schirmähnliches Holzgestell, das mit gelb-weiß oder rot-gold gestreifter Seide bezogen ist und an den Seiten gleichartige Behänge hat. Auf der Spitze des Tragschaftes befindet sich eine Kugel oder ein Kreuz. Es wird im Chor der Basiliken aufgestellt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Padiglione</skos:prefLabel>
        <skos:prefLabel xml:lang="en">basilical pavillon</skos:prefLabel>
        <skos:prefLabel xml:lang="it">padiglione</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">pavillon basilical</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">pavilon</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_2a019ea6 -->


