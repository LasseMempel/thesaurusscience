	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021073">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en-US">jump suit</skos:prefLabel>
		<skos:altLabel xml:lang="en-US">jump suits</skos:altLabel>
		<skos:prefLabel xml:lang="de">Jumpsuit</skos:prefLabel>
		<skos:prefLabel xml:lang="en-UK">jumpsuit</skos:prefLabel>
		<skos:altLabel xml:lang="de">Jumpsuits</skos:altLabel>
		<skos:altLabel xml:lang="en-UK">jumpsuits</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk007760"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk007760"/>
		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk008170"/>
		<skos:definition xml:lang="de">Ein Jumpsuit ist Oberbekleidung, die als einteiliges Kleidungsstück sowohl den Oberkörper als auch die Beine bedeckt. Er kann ärmellos, kurzärmelig oder langärmelig sein und kommt in verschiedenen Stilen und Materialien, wie Baumwolle, Seide oder Denim vor.</skos:definition>
		<skos:exactMatch rdf:resource="ttp://vocab.getty.edu/aat/300209835"/>
		<skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q16472452"/>
