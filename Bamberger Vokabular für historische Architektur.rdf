    <!-- https://hist-arch-vocab.org/bvha#c_3c76f533 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_3c76f533">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_ac93c02d"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_19d56a39"/>
