    <!-- https://hist-arch-vocab.org/bvha#c_78638388 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_78638388">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_eea5235b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-16T08:42:47.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-07T13:21:58.000</terms:modified>
        <skos:altLabel xml:lang="fr">arc en ellipse</skos:altLabel>
        <skos:altLabel xml:lang="de">elliptischer Bogen</skos:altLabel>
        <skos:definition xml:lang="de">Bogen, dessen Krümmung einer Halbellipse folgt. Er entsteht z. B. als Diagonalbogen bei Kreuzgewölben über rechteckigem Grundriss. Man unterscheidet je nach Lage der großen Ellipsenachse den liegenden elliptischen Bogen und den stehenden elliptischen Bogen. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Ein Bogen, dessen Krümmung aus einer in der Längsrichtung halbierten Ellipse besteht. Im Gewölbebau kommt der E. v.a. als Diagonalbogen des Kreuzgewölbes über rechteckigem Grundriss vor. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Ellipsenbogen</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">arc elliptique</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">eliptický oblouk</skos:prefLabel>
        <skos:prefLabel xml:lang="en">elliptical arch</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_eea5235b"/>
    </owl:NamedIndividual>
    


