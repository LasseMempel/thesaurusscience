		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1213</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">EINNSEAN EICH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Cuibhle a tha ga thionndadh le each. Gheibhear seo ann am mèinnearachd, saothrachadh is àiteachas.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HORSE ENGINE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">HORSE GIN</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1211" />
