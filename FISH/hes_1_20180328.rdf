		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/361" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/364" />
		<skos:scopeNote xml:lang="en">A temporary military camp. If Roman use TEMPORARY CAMP.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
