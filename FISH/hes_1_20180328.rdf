		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1257</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CÙRSA-UISGE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Cladhan a tha ga chleachdadh gus uisge a ghiùlan o àite gu àite no fear a chaidh a chruthachadh ri linn giùlan uisge. Faodaidh seo a bhith na rud nàdarra, m.e. abhainn, no na rud fuadain, m.e. duct-uisge. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">WATERCOURSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
