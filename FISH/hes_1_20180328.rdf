	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/539">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/539</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">COLAISTE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Ionad àrd-fhoghlaim, gu math tric bheirear seachad oideachadh sònraichte an-seo, m.e. colaiste nan ealan; colaiste ciùil.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">COLLEGE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/537" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502203" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502195" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/544" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/551" />
		<skos:scopeNote xml:lang="en">An institution of higher learning, often providing specialised tuition, e.g. college of art; college of music.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/540">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/540</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">INSTITIUD</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach far a bheil buidheann stèidhichte a tha a' brosnachadh saidheans, ealain, litreachas, foghlam is msaa. Cleachd seòrsa nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">INSTITUTE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">INSTITUTION</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/537" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/504184">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/504184</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">INSTITIÙD NAM FEAR-OBRACH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Àite far am b' urrainn do dh'fhireannaich a bha ag obair foghlam fhaighinn dhaibh fhèin ann an òraidean agus san t-seòmar-leughaidh san robh pàipearan-naidheachd is rudan mar sin.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">WORKING MENS INSTITUTE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-04-24T16:09:41</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-04-24T16:09:47</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/540" />
				<skos:scopeNote xml:lang="en">A place where working men could educate themselves through lectures and the use of a reading room with newspapers, etc.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/504100" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/504240">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/504240</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">INSTITIUD NAM MEACANAIG</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Togalach far am b' urrainn do dhaoine barrachd ionnsachadh mun cheàrd aca agus na prionnsabalan teòirigeach ann 's iad ag èisteachd ri òraidean agus a' cleachdadh nan goireasan san t-seòmar-leughaidh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">MECHANICS INSTITUTE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-04-29T12:19:16</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-04-29T12:19:40</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/540" />
				<skos:scopeNote xml:lang="en">A building where artisans could learn more about their craft, and the scientific and theoretical principles behind it, by attending lectures and the use of the reading room facilities.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/504381" />
		<skos:scopeNote xml:lang="en">A building in which a society or organisation is instituted to promote science, art, literature, education, etc. Use more specific type where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/541">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/541</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LEABHARLANN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach no àite far a bheilear a' cumail cruinneachadh de sgrìobhainnean no clàran litreachais, dealbhan, filmichean no clàraidhean as urrainn do dhaoine coimhead orra airson fiosrachadh no a thoirt a-mach air iasad.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">LIBRARY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1588" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/537" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/504381" />
		<skos:scopeNote xml:lang="en">A building or space which houses a collection of literary documents or records, photographs, films or recordings kept for reference or borrowing.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/542">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/542</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH-TASGAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach, grunn thogalaichean no àite far a bheilear a' cruinneachadh, a' glèidheadh, a' rannsachadh, a' sealltainn 's a' mìneachadh rudan aig a tha cudromach a thaobh saidheans, eachdraidh no nan ealan.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MUSEUM</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1588" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/537" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1590" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1644" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500499" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/504127" />
		<skos:scopeNote xml:lang="en">A building, group of buildings or space devoted to the acquisition, conservation, study, exhibition, and educational interpretation of objects having scientific, historical, or artistic value.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/543">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/543</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">AMHARCLANN SPEURA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach sa bheil prosbaigean speura a bheir comas do dhaoine coimhead air rudan sna speuran no air an aimsir.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">OBSERVATORY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/537" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1420" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1589" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1914" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/215" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/217" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/231" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/244" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/544" />
		<skos:scopeNote xml:lang="en">A building containing celestial telescopes in which astronomical or meteorological phenomena may be observed.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/544">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/544</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">SGOIL</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Ionad far am faigh daoine, mar is trice a' chlann, sgoil.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SCHOOL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">ACADEMY</skos:altLabel>
		<skos:altLabel xml:lang="en">GRAMMAR SCHOOL</skos:altLabel>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/546" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/537" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500636" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500652" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/504180" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/504122" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1914" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/447" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502187" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502241" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/503312" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/503641" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/539" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/543" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/551" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/641" />
		<skos:scopeNote xml:lang="en">An establishment in which people, usually children, are taught.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/546">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/546</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">SGOIL TRÈANAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Sgoil far a bheilear a' teagasg sgilean sònraichte, mar is trice feadhainn co-cheangailte ri cuspair àraidh. Cleachd seòrsa nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TRAINING SCHOOL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/544" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/547" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/503660">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/503660</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">SGOIL-GNÌOMHACHAIS</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Sgoil-chòmhnaidh no sgoil-latha do chlann a rinn eucoirean beaga no a bha a' fuireach ann an suidheachadh 's iad buailteach a bhith ri eucoir ann.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">INDUSTRIAL SCHOOL</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-10-06T14:39:22</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-10-06T14:39:38</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/546" />
				<skos:scopeNote xml:lang="en">A boarding or day school for children who had committed minor crimes or who lived in circumstances where they were likely to commit crime.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:scopeNote xml:lang="en">A school where specialist skills, relating to a particular subject, are taught. Use specific type where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
