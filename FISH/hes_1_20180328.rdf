		<skos:prefLabel xml:lang="gd">CLACH CHEARCALL</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Clach a chaidh co-dhiù aon bhad a chearcallan co-mheadhanach a shnaidheadh air a h-uachdar.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">RING MARKED STONE</skos:prefLabel>
