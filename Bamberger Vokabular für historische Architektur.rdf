        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_27923945"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-21T18:22:13.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-21T18:27:36.000</terms:modified>
        <skos:altLabel xml:lang="de">Tracht der Franziskaner-Minoriten</skos:altLabel>
        <skos:altLabel xml:lang="de">Tracht der Minderbrüder</skos:altLabel>
        <skos:altLabel xml:lang="de">Tracht der Minderen Brüder</skos:altLabel>
        <skos:altLabel xml:lang="de">Tracht der fratres minores</skos:altLabel>
        <skos:definition xml:lang="de">Minoriten m pl, Minderbrüder m pl, Mindere Brüder m pl, fratres minores: Kutte aus schwarzem Tuch mit weißem Cingulum, vorne bis zum Gürtel reichende, hinten spitz auslaufende Mozetta mit kleiner Kapuze. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Tracht der Minoriten</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">vêtements des frères mineurs</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_0bcfc4c1 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_0bcfc4c1">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
