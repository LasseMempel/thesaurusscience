	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021337">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">blowtorch</skos:prefLabel>
		<skos:altLabel xml:lang="en">blowtorches</skos:altLabel>
		<skos:prefLabel xml:lang="de">Lötlampe</skos:prefLabel>
		<skos:altLabel xml:lang="de">Lötlampen</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk021339"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk021339"/>
		<skos:definition xml:lang="de">Eine Lötlampe ist ein handgeführter Brenner, der zur Erzeugung einer offenen Flamme dient und überwiegend zum Löten, Erhitzen oder Schmelzen von Materialien eingesetzt wird. Historisch wurden Lötlampen mit flüssigen Brennstoffen wie Benzin, Petroleum oder Kerosin betrieben. Moderne Varianten verwenden meist gasförmige Brennstoffe wie Butan oder Propan. Lötlampen sind typische Werkzeuge in Handwerk, Industrie und Haushalt.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/7718343-5"/>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300023316"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1445068"/>
