        <skos:altLabel xml:lang="de">Almosenschaufel</skos:altLabel>
        <skos:altLabel xml:lang="de">Bedel</skos:altLabel>
        <skos:altLabel xml:lang="de">Bettelbrett</skos:altLabel>
        <skos:altLabel xml:lang="de">Klappe</skos:altLabel>
        <skos:definition xml:lang="de">Almosenbrett n; Almosenschaufel f; auch Bettelbrett n; Klappe f; im Ostseegebiet Bedel n: eine schaufelartige, vorne offene und an der Rückseite oft mit Reliefs verziert Lade mit Griff; eine Sonderform des Kollektentellers. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Almosenbrett</skos:prefLabel>
        <skos:prefLabel xml:lang="en">collection-plate</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">plateau à aumônes</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_34f98e4b -->


