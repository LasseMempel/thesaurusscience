    <!-- https://hist-arch-vocab.org/bvha#c_f687386b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_f687386b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_7acece55"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
