	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk012971">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Anis (Pflanze)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Anise (Pflanzen)</skos:altLabel>
		<skos:prefLabel xml:lang="en">anise</skos:prefLabel>
		<skos:prefLabel xml:lang="mul">Pimpinella anisum</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk009629"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk014752"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013755"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk009629"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk014752"/>
		<xe:explanation_temp xml:lang="de">Als Gewürz werden die Anisfrüchte vor allem für Spirituosen und Liköre wie beispielsweise Ouzo, Sambuca oder Pastis genutzt, finden aber auch bei der Zubereitung von Brot, Backwaren und Süßwaren Verwendung.
Als Naturheilmittel werden die Anisfrüchte oder Auszüge daraus vor allem schleimlösend bei Husten oder krampflösend und blähtreibend bei Magen-Darm-Beschwerden angewendet.</xe:explanation_temp>
		<skos:definition xml:lang="de">Anis ist ein Doldenblütler, der Pimpinella anisum. Es ist eine krautige stark aromatische Pflanze mit verschiedengestaltigen Blättern und weißen Blüten. Die Früchte werden getrocknet oder als Öl in der Speisenzubereitung und Heilkunde verwendet.</skos:definition>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4142493-1"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk013755"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk014752"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk009629"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
