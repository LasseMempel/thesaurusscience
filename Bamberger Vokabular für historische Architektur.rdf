        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-05T19:11:48.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T15:02:07.000</terms:modified>
        <skos:altLabel xml:lang="de">Schleppenträger</skos:altLabel>
        <skos:altLabel xml:lang="fr">porte-traîne </skos:altLabel>
        <skos:definition xml:lang="de">Ein Geistlicher oder ein Laie, der einem hohen Würdenträger bei einem feierlichen Auftritt die Schleppe seines Gewandes trägt. [Glossarium Artis] </skos:definition>
        <skos:prefLabel xml:lang="de">Caudatarius</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">caudataire</skos:prefLabel>
        <skos:prefLabel xml:lang="en">trainbearer</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_609c0173 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_609c0173">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_9ecfe12c"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-05T10:05:10.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-18T14:13:49.000</terms:modified>
        <skos:altLabel xml:lang="de">Filigranarbeit</skos:altLabel>
        <skos:definition xml:lang="de">Filigran (]at. filum = Faden, granum = Korn), seit 2000 v. Chr. aus Troja bekannte Goldschmiedetechnik. Glatte, gekörnte oder gezwirnte Drähte aus Gold oder Silber werden in Ziermustern auf einen mit Gold- oder Silberkörnchen bedeckten Metallgrund gelötet. In neuerer Zeit gern ohne Unterlage zu einem feinen, durchbrochenen Gespinst geflochten und nur an den Berührungspunkten gelötet. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Lat. filum = nit, granum = zrno. Zlatnická technika známá již roku 2000 př. Kr. v Tróji; hladké, drsné nebo splétané drátky ze zlata nebo stříbra se letují v ozdobných vzorech na kovový podklad pokrytý zrníčky zlata nebo stříbra, v novější době většinou bez podkladu propletené do jemného přediva a sletované pouze na místech styku. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Filigran</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">filigrán</skos:prefLabel>
        <skos:prefLabel xml:lang="la">opus veneticum ad filum</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_60a06338 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_60a06338">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_11ec36ef"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_380577c3"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-05T21:01:47.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-17T10:18:52.000</terms:modified>
        <skos:altLabel xml:lang="de">Terrakotta</skos:altLabel>
        <skos:altLabel xml:lang="de">terra cotta</skos:altLabel>
        <skos:note xml:lang="en">Any kind of baked or semi-fired clay used to create utilitarian or decorative objects, or structural forms such as: floor tiles, roof tiles or decorative architectural elements. [EwaGlos]</skos:note>
        <skos:note xml:lang="de">Jede Art von gebranntem oder niedrig gebranntem Ton zur Herstellung von Gebrauchsoder Dekorationsobjekten und Bauelementen, wie Bodenfliesen, Dachziegeln oder dekorativen architektonischen Elementen. [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="de">Terracotta (Baumaterial)</skos:prefLabel>
        <skos:prefLabel xml:lang="en">terracotta</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_60abeeae -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_60abeeae">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_213c2236"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_e5de1856"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-13T16:54:06.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T18:37:55.000</terms:modified>
        <skos:definition xml:lang="de">Ein Mauerverband, bei dem die Steinschichten schräg zur Gewölbeachseliegen, im Gewölbescheitel also V-förmig aufeinander treffenund sich gegenseitig verspannen (Scheitelverzahnung). Die Lagerfugen sind durchgehend, die Stoßfugen versetzt. Die Mauerung beginnt in der Regel in den Ecken des Raumes. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Wölbung auf Schwalbenschwanz</skos:prefLabel>
        <skos:prefLabel xml:lang="en">laying of voussoirs in a dovetailed pattern</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte appareillée en chevrons</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_60b9ca7a -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_60b9ca7a">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_pnlagwip"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
