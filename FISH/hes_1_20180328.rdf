				<skos:prefLabel xml:lang="gd">TAIGHEADAS AIRM</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Taighean-còmhnaidh do bhuill nam feachdan armaichte. Tha seo a' gabhail a-steach dachaighean theaghlaichean taobh a-muigh bunait an airm.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">MILITARY HOUSING</skos:prefLabel>
