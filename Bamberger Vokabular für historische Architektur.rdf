        <skos:definition xml:lang="de">Neurenaissance, Neorenaissance, Wiederaufnahme von Bau- und Möbelformen der Renaissance im letzten Drittel des 19. Jhs. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Též novorenesance. Oživení renesančních architektonických a nábytkových prvků v poslední třetině 19. stol., historismus. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Neurenaissance</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">neorenesance</skos:prefLabel>
    </owl:NamedIndividual>
    


