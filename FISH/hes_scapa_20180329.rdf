	<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300019276"/>
	<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/scapa"/>
	<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/CH"/>
	<skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EBA</skos:notation>
	<skos:prefLabel xml:lang="en">Early Bronze Age</skos:prefLabel>
	<skos:prefLabel xml:lang="gd">Linn an Umha Tràth</skos:prefLabel>
	<skos:scopeNote xml:lang="en">The earliest subdivision of the Bronze Age often defined by artefact types. Pottery includes late Beakers, Food vessels, Collared and Cordoned Urns while the metal work evolves from simple to more complex forms.</skos:scopeNote>
</rdf:Description>

