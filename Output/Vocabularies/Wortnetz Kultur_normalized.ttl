        <http://lvr.vocnet.org/wnk/wk000349> ;
    skos:closeMatch <http://d-nb.info/gnd/4185705-7> ;
    skos:definition "Ein Topas ist ein Mineral, das in der chemischen Zusammensetzung Al2(SiO4)(F,OH)2 auftritt. Mit einer Mohshärte von 8 gehört Topas zu den harten Mineralen. Er kommt in prismatischen Kristallen vor, die transparent und glänzend sind und eine weiße, gelbe, braune, blassblaue, rosafarbene, rote oder blassgrüne Farbe haben können."@de ;
    skos:exactMatch <http://vocab.getty.edu/aat/300011162>,
        <http://www.wikidata.org/entity/Q134985> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
