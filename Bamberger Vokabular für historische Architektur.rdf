    <!-- https://hist-arch-vocab.org/bvha#c_bfe84c57 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_bfe84c57">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_162d82c1"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_f10222e0"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-03T10:42:45.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T13:28:13.000</terms:modified>
        <skos:definition xml:lang="de">Die typischen Spuren des Abkeilens [von Steinblöcken] vom Untergrund [im Steinbruch]. [Voelkle 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Keiltasche</skos:prefLabel>
        <skos:scopeNote xml:lang="de">[M]an [haute] mit dem Zweispitz oder Spitz- und Schlageisen an der vorgesehenen Stelle im Abstand von etwa 10 - 20 cm Keillöcher- die sogenannten Keiltaschen - ein. Diese müssen exakt den gleichen Winkel wie die verwendeten Keile besitzen, da sich nur dann die gewünschte Keilwirkung entfalten kann. Die Keile werden nach dem Ansetzen mit einem großen Hammer gleichmäßig in die Keillöcher getrieben [...]. [Voelkle 2016]</skos:scopeNote>
    </owl:NamedIndividual>
    


