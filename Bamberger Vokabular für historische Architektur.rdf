        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-08T19:28:20.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T16:26:30.000</terms:modified>
        <skos:altLabel xml:lang="de">Fragmentierung</skos:altLabel>
        <skos:altLabel xml:lang="de">Zerbrechen</skos:altLabel>
        <skos:altLabel xml:lang="cs">rozlomení</skos:altLabel>
        <skos:definition xml:lang="de">Das vollständige oder teilweise Auseinanderbrechen eines Gesteins in Bruchstücke verschiedener Größe, welche eine unregelmäßige Form, Dicke und Volumen haben. [ICOMOS-ISCS] </skos:definition>
        <skos:definition xml:lang="fr">Fracturation partielle ou complète de la pierre enfragments de dimensions variables dont la forme,l’épaisseur et le volume sont irréguliers. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="en">The complete or partial breaking up of a stone, intoportions of variable dimensions that are irregular inform, thickness and volume. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="cs">Úplné nebo částečné rozlámání kamene na různě velké částice nepravidelného tvaru, tloušťky a objemu. [ICOMOS-ISCS] </skos:definition>
        <skos:prefLabel xml:lang="de">Fragmentation</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">fragmentace</skos:prefLabel>
        <skos:prefLabel xml:lang="en">fragmentation</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">fragmentation</skos:prefLabel>
    </owl:NamedIndividual>
    


