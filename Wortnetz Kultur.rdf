		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-03-28T11:14:32+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk003853">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="es">el gabro</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Gabbro</skos:prefLabel>
		<skos:prefLabel xml:lang="en">gabbro</skos:prefLabel>
		<skos:prefLabel xml:lang="fr">gabbro</skos:prefLabel>
		<skos:altLabel xml:lang="es">roca trucha</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003849"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019456"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk003849"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk003855"/>
		<skos:definition xml:lang="de">Ein Gabbro ist ein Tiefengestein, das eine grobkörnige Struktur aufweist und meist dunkelgrün bis schwarz gefärbt ist.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003849"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019456"/>
