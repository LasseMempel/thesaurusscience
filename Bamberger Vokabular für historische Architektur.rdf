        <skos:altLabel xml:lang="en">groin vault</skos:altLabel>
        <skos:definition xml:lang="de">Ein Gewölbe, dessen Kappen in sichtbaren Graten zusammentreffen, z.B. das KreuzgratgewöIbe und das Zellengewölbe. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Mit Graten versehenes Gewölbe, wie das Kreuzgrat und das Zellengewölbe. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Gratgewölbe</skos:prefLabel>
        <skos:prefLabel xml:lang="en">groined vault</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte à arêtes </skos:prefLabel>
        <broaderByConstruction rdf:resource="https://hist-arch-vocab.org/bvha#c_049c4c22"/>
