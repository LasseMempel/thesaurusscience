		<skos:prefLabel xml:lang="en">land consolidation</skos:prefLabel>
		<skos:prefLabel xml:lang="fr">remembrement</skos:prefLabel>
		<skos:prefLabel xml:lang="nl">ruilverkaveling</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk020401"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk020401"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk011968"/>
		<skos:definition xml:lang="de">Flurbereinigung ist ein hoheitlicher Aufgabenbereich, bei der landwirtschaftliche und forstwirtschaftliche Flächen in ihrem Zuschnitt verändert und neu zugeteilt werden. Sie hat eine Verbesserung der Erreichbarkeit und eine effizientere Bewirtschaftung zum Ziel.</skos:definition>
