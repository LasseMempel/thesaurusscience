  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69159">
    <skos:scopeNote xml:lang="en">A fuel store for the storage of dried peat.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92250">
    <skos:scopeNote xml:lang="en">A place with organized amusements for people on holiday.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162620">
    <skos:scopeNote xml:lang="en">Regular courtyard farmsteads where the buildings are arranged as an E-shaped plan around two cattle yards. Cattle housing and stabling typically extend as three ranges from the longer main range which includes a barn or mixing house.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70398">
    <skos:scopeNote xml:lang="en">A hole or cavity in the ground, either natural or the result of excavation. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71501">
    <skos:scopeNote xml:lang="en">A site where vinegar is manufactured from soured beer, wine or cider.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/102692">
    <skos:scopeNote xml:lang="en">A dump for wasters; pieces of pottery spoiled in the manufacturing process.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70332">
    <skos:scopeNote xml:lang="en">Any wall enclosing a building or complex of buildings, eg. prisons, dockyards, factories, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93582">
    <skos:scopeNote xml:lang="en">A residence of two or three monks of the Order of Tiron dependent on a foreign mother house.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167016">
    <skos:scopeNote xml:lang="en">Dummy construction in the form of a battery used during WWII to provide a counterfeit target for enemy aircraft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68649">
    <skos:scopeNote xml:lang="en">An enclosure used for the cultivation of fruit trees.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68801">
    <skos:scopeNote xml:lang="en">A place where refreshments or meals may be obtained.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91993">
    <skos:scopeNote xml:lang="en">A structure used for the drying of food using an indirect source of heat.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70915">
    <skos:scopeNote xml:lang="en">A conical brick structure in which glass articles were made.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170635">
    <skos:scopeNote xml:lang="en">A kiln in the form of a pit dug into the earth which was used for the the production of white coal prior to the Industrial Revolution.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/147270">
    <skos:scopeNote xml:lang="en">A residential home for adults with learning difficulties and/or physical disabilities.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71756">
    <skos:scopeNote xml:lang="en">The dwelling of a blacksmith, nailer, sword cutler, etc, often adjacent to, or containing, a BLACKSMITHS WORKSHOP.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159183">
    <skos:scopeNote xml:lang="en">A wide street, traditionally lined with trees.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71278">
    <skos:scopeNote xml:lang="en">Form of ore crushing machinery associated with tin mines often wooden and water-powered.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68684">
    <skos:scopeNote xml:lang="en">A box in which letters are posted or deposited for dispatch.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70330">
    <skos:scopeNote xml:lang="en">A stone or metal post that indicates the limit of an area or piece of land.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91600">
    <skos:scopeNote xml:lang="en">A tall chimney terminating a CONDENSING FLUE, used to extract metal from the smoke produced by a lead smelter.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71866">
    <skos:scopeNote xml:lang="en">A building used by the church to promote Christianity through lectures, study, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/118893">
    <skos:scopeNote xml:lang="en">A building designed to house insects.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68907">
    <skos:scopeNote xml:lang="en">A small protective fortification, such as an earthwork.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69154">
    <skos:scopeNote xml:lang="en">A site where petroleum is drawn.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68745">
    <skos:scopeNote xml:lang="en">A site with one or more defensive earthworks, often at a river crossing incorporating natural features which define parts of the curtilage.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71384">
    <skos:scopeNote xml:lang="en">An isolated barn, cow house or shelter shed with a hayloft. Typically found in areas where farmsteads and fields were sited at a long distance from each other.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87459">
    <skos:scopeNote xml:lang="en">A tall, metal structure erected as a support for electric power cables.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140350">
    <skos:scopeNote xml:lang="en">A building or part of a building, sometimes attached to a religious community, where religious activities such as worshipping, meetings, teaching about the faith and conferences take place. It can also provide accommodation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71241">
    <skos:scopeNote xml:lang="en">A farm on which liquid sewage was regularly used for irrigation as a means of sewage disposal.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160232">
    <skos:scopeNote xml:lang="en">A gun emplacment which conforms to Department of Fortification and Works drawing number 55503</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91917">
    <skos:scopeNote xml:lang="en">An establishment where the art of sword fencing is taught.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69935">
    <skos:scopeNote xml:lang="en">A lake, often artifical, in a park or open space, used for the recreational rowing and sailing of boats.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94001">
    <skos:scopeNote xml:lang="en">A usually south-facing wall used for the cultivation of fruit plants.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68865">
    <skos:scopeNote xml:lang="en">A small, Iron Age/Romano-British enclosed settlement found in South West England.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93709">
    <skos:scopeNote xml:lang="en">Small furnace, used to create an upward draught of air in mine workings.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93377">
    <skos:scopeNote xml:lang="en">A school for pupils with physical or learning difficulties.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91088">
    <skos:scopeNote xml:lang="en">Court where sessions were held periodically in each county in England, for the purpose of administering civil and criminal justice. Presided over by itinerant judges acting under certain special commissions. Abolished 1971 and in 1972 replaced by Crown C.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93840">
    <skos:scopeNote xml:lang="en">A site where unprocessed wood is used to manufacture goods.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92257">
    <skos:scopeNote xml:lang="en">A barn used to store hops.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143325">
    <skos:scopeNote xml:lang="en">Range used by the Navy with reinforced observation huts which housed quadrant equipment to record accuracy and damage.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/109673">
    <skos:scopeNote xml:lang="en">A chemical works engaged in the production or refining of toluene, a substance extracted from coal tar or specific types of crude oil, and used in the production of explosives during WW1.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/104193">
    <skos:scopeNote xml:lang="en">A mill in which barytes concentrates were ground to fine white powder, normally by use of flat millstones similar to those of a corn mill.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94187">
    <skos:scopeNote xml:lang="en">A three-sided structure for the production and storage of silage.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70329">
    <skos:scopeNote xml:lang="en">A plate, usually of wood or metal, used to indicate the limit of an area or piece of land.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143415">
    <skos:scopeNote xml:lang="en">A building housing computers and information technology equippment e.g. for a business, factory or other instituion.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70358">
    <skos:scopeNote xml:lang="en">An oval shaped area of land enclosed by a boundary ditch, bank, wall, palisade or similar barrier.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92706">
    <skos:scopeNote xml:lang="en">A crane which is driven by a petrol or diesel engine and travels on either crawler tracks or rubber tyres.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69955">
    <skos:scopeNote xml:lang="en">A large, manmade pool, usually lined with tiles, rubber or similar. Can be placed in the open air, eg. a LIDO, or built as part of a covered sports centre.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159389">
    <skos:scopeNote xml:lang="en">A small pond, usually circular and serving as a feature at the centre of a walled garden, used for the purpose of filling watering cans.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91651">
    <skos:scopeNote xml:lang="en">A hall or chamber in which justice is administered.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71627">
    <skos:scopeNote xml:lang="en">A school run by a Christian church.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69938">
    <skos:scopeNote xml:lang="en">A building where people pay to see films and 'moving pictures'.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71658">
    <skos:scopeNote xml:lang="en">A place of worship for members of a guild.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91907">
    <skos:scopeNote xml:lang="en">A pulley block and metal ring used to guide a line or rope and cause it to run easily without chafing.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91122">
    <skos:scopeNote xml:lang="en">A training school where ballet is taught.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70012">
    <skos:scopeNote xml:lang="en">A round barrow featuring a mound surrounded by a ditch, with no intervening berm. The ditch may be accompanied by an external bank.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69261">
    <skos:scopeNote xml:lang="en">A mill used for the sizing and drying of warp threads before they were wound onto warp beams as part of the power-weaving process.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92244">
    <skos:scopeNote xml:lang="en">A playing area for the game of hockey. May be a grass or artificial surface.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93573">
    <skos:scopeNote xml:lang="en">A building constructed with a basic timber framework; between the members are panels which can be infilled with timber, wattle and daub, plaster, brick or other materials.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69187">
    <skos:scopeNote xml:lang="en">A furnace used for smelting or re-heating of iron, either for casting or for further working.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68692">
    <skos:scopeNote xml:lang="en">A building from which the administration of a county is carried out by the County Council. It is also, historically, the site where the county quarter sessions and assizes were held.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93382">
    <skos:scopeNote xml:lang="en">A sculptured, carved or moulded representation of an imaginary creature with a human head and breast combined with the body of a lion.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68808">
    <skos:scopeNote xml:lang="en">Sites, buildings, structures &amp; features used in the defence of the civilian population. Includes civil defence sites, weapons stores, training sites, military signals &amp; active defence structures such as anti-aircraft sites.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92285">
    <skos:scopeNote xml:lang="en">A specialist unit within a hospital complex. It may be a separate building or sometimes linked by a corridor or covered walkway to a main building.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71591">
    <skos:scopeNote xml:lang="en">Workshop for the construction and maintenance of boilers within an industrial complex.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162623">
    <skos:scopeNote xml:lang="en">Regular courtyard farmsteads where the buildings are arranged as an H-shaped plan, commonly with cattle housing to two or more cattle yards.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/169858">
    <skos:scopeNote xml:lang="en">Linear earthwork boundary denoting furlongs</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70152">
    <skos:scopeNote xml:lang="en">Houses specifically of monks, canons or religious men but not friars.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143712">
    <skos:scopeNote xml:lang="en">A linear open working along a lode vein, worked directy from the surface. Survives as a gully or ravine, normally with closed ends.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93962">
    <skos:scopeNote xml:lang="en">A building where sugar is stored.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68949">
    <skos:scopeNote xml:lang="en">A substantial house in a town or the country (particularly associated with medieval London). Use more specific monument types where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92952">
    <skos:scopeNote xml:lang="en">A municipal pawnshop.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93996">
    <skos:scopeNote xml:lang="en">A factory where biscuits are manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71455">
    <skos:scopeNote xml:lang="en">A building which houses the administrative functions of a local authority.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140557">
    <skos:scopeNote xml:lang="en">An informal encampment, usually near a military establishment, set up as a public protest against that establishment or against some aspect of military policy.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69068">
    <skos:scopeNote xml:lang="en">An excavation from which stone for building and other functions, is obtained by cutting, blasting, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/146357">
    <skos:scopeNote xml:lang="en">A building or area where stone is stored for industrial or agricultural use.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92583">
    <skos:scopeNote xml:lang="en">The official residence of the chief officer of the municipal corporation of a city or borough in England.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/136632">
    <skos:scopeNote xml:lang="en">A factory where packaging products, such as cardboard boxes, are produced.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70174">
    <skos:scopeNote xml:lang="en">A manor or estate owned and run by an order of knights and governed by a preceptor.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/102872">
    <skos:scopeNote xml:lang="en">Sites, buildings, structures &amp; features categorized by their form rather than their function, where this has been deemed to be useful for retrieval purposes. Careful consideration will be given to the inclusion of new terms within this class.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69252">
    <skos:scopeNote xml:lang="en">A stone-lined pit or tank, sometimes circular,  for concentrating ores by sedimentation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/90983">
    <skos:scopeNote xml:lang="en">A place where abrasive mediums such as sand-paper and grinding wheels are manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/139339">
    <skos:scopeNote xml:lang="en">Garden or open-air enclosure, usually connected to commercial premises, where tea and other refreshments are served to the public.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71515">
    <skos:scopeNote xml:lang="en">The dwelling place of a farm worker.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160243">
    <skos:scopeNote xml:lang="en">The standard RFC power house built to Air Ministry drawing number 476/18 and comprising an engine room with a small workshop and driver's room.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70065">
    <skos:scopeNote xml:lang="en">A form of Neolithic burial monument primarily found in Cornwall and the Scilly Isles. It comprises a round cairn, usually with a retaining wall or kerb, and an entrance leading directly into a chamber.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/97264">
    <skos:scopeNote xml:lang="en">A building used to coordinate civil defence in times of war. Can also be utilized as aid centres in times of national emergency.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143495">
