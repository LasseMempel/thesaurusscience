	<skos:prefLabel xml:lang="gd">(todo)</skos:prefLabel>
	<skos:scopeNote xml:lang="en">Arbitarily commences with the accession of James VI to the English throne until the start of the 20th century.</skos:scopeNote>
</rdf:Description>

