        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-12T11:17:26.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T13:00:53.000</terms:modified>
        <skos:definition xml:lang="de">Bodenfläche zwischen Cella und Säulenkranz des antiken Tempels. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Plocha podlahy mezi cellou a sloupořadím kolem antického chrámu. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Umgang zwischen dem Säulenkranz und der Cellawand über dem Pteron des antiken Tempels. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Peridromos</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">peridromos</skos:prefLabel>
    </owl:NamedIndividual>
    


