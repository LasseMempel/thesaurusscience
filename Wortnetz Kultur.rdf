	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk019010">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Panoramakarte</skos:prefLabel>
		<skos:altLabel xml:lang="de">Panoramakarten</skos:altLabel>
		<skos:prefLabel xml:lang="en">panoramic map</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004520"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004520"/>
		<skos:definition xml:lang="de">Eine Panoramakarte ist eine Landkarte, die einen bildhaften Rundblick über eine Landschaft zeigt. Oft sind Panoramakarten in einem breiten, horizontalen Format gestaltet, um die Ausdehnung einer Landschaft zu betonen. In der Regel ist eine Panaromakarte nicht maßstabsgetreu.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004520"/>
