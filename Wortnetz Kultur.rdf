	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk019248">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="en-US">bleeding cup</skos:altLabel>
		<skos:altLabel xml:lang="en-US">bleeding cups</skos:altLabel>
		<skos:prefLabel xml:lang="en-UK">cupping glass</skos:prefLabel>
		<skos:altLabel xml:lang="en-UK">cupping glasses</skos:altLabel>
		<skos:altLabel xml:lang="en-US">cupping horn</skos:altLabel>
		<skos:altLabel xml:lang="en-US">cupping horns</skos:altLabel>
		<skos:prefLabel xml:lang="en-US">cupping vessel</skos:prefLabel>
		<skos:altLabel xml:lang="en-US">cupping vessels</skos:altLabel>
		<skos:altLabel xml:lang="en-UK">cupping-glass</skos:altLabel>
		<skos:altLabel xml:lang="en-UK">cupping-glasses</skos:altLabel>
		<skos:altLabel xml:lang="de">Schröpfglas</skos:altLabel>
		<skos:altLabel xml:lang="de">Schröpfgläser</skos:altLabel>
		<skos:prefLabel xml:lang="de">Schröpfkopf</skos:prefLabel>
		<skos:altLabel xml:lang="de">Schröpfköpfe</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk019093"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk019093"/>
		<xe:explanation_temp xml:lang="de">Das Schröpfen wird in der Regel durchgeführt, indem ein Schröpfkopf auf die Haut gesetzt und durch Erhitzen oder durch einen Pumpmechanismus ein Unterdruck erzeugt wird. Dadurch wird die Haut in die Vorrichtung hineingezogen, was zu einer verstärkten Durchblutung der betroffenen Stelle führt. Diese Durchblutungsförderung soll dazu beitragen, Schmerzen zu lindern.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Schröpfkopf ist ein medizinisches Gerät in Form einer kleinen, kugelförmigen Vorrichtung, häufig mit einer Öffnung. Traditionell bestehen Schröpfköpfe aus Glas, es gibt sie jedoch auch aus Kunststoff oder Silikon. In der Antike wurden sie aus Horn oder sogar aus Metall gefertigt. Schröpfköpfe werden als Hilfsmittel bei der Schröpftherapie verwendet.</skos:definition>
		<skos:mappingRelation rdf:resource="http://d-nb.info/gnd/4680747-0"/>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300262816"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q111259703"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019093"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
