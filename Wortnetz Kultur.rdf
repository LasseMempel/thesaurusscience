		<skos:altLabel xml:lang="de">Bast (Faser)</skos:altLabel>
		<skos:prefLabel xml:lang="en">bast fiber</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Bastfaser</skos:prefLabel>
		<skos:altLabel xml:lang="de">Phloemfaser</skos:altLabel>
		<skos:altLabel xml:lang="de">Sklerenchymfaser</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003022"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk012046"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk018391"/>
