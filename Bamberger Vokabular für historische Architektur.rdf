    <!-- https://hist-arch-vocab.org/bvha#c_5be854ee -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_5be854ee">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_effad513"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
