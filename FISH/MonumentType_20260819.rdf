    <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2"/>
    <skos:prefLabel xml:lang="en">SINTER PLANT</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A plant where iron ore is prepared prior to its use in a blast furnace. Ground iron ores are blended with coke dust, fluxes and furnace dust and heated at over 1,000 degrees Celsius to form a clinker-type material which is charged into the furnace with coke and limestones to reduce the quantity of coke needed and to utilise waste materials.</skos:scopeNote>
