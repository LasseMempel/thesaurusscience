	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021129">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Wachstafel</skos:prefLabel>
		<skos:altLabel xml:lang="de">Wachstafeln</skos:altLabel>
		<skos:prefLabel xml:lang="en">wax tablet</skos:prefLabel>
		<skos:altLabel xml:lang="en">wax tablets</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk021130"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk021130"/>
		<skos:definition xml:lang="de">Eine Wachstafel ist eine Schreibtafel, die aus Holz oder Knochen besteht und mit einer Schicht Wachs überzogen ist, auf der mit einem Griffel geschrieben oder geritzt werden kann. Sie wurde besonders im antiken Rom und im Mittelalter verwendet und war ein verbreitetes Schreibmedium für Notizen und Lernzwecke.</skos:definition>
		<skos:mappingRelation rdf:resource="https://d-nb.info/gnd/4188801-7"/>
		<skos:mappingRelation rdf:resource="http://vocab.getty.edu/aat/300192670"/>
		<skos:mappingRelation rdf:resource="http://www.wikidata.org/entity/Q1428312"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk021130"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-04-07T12:23:06+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021130">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Schreibtafel</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk002500"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk002500"/>
		<skos:definition xml:lang="de">Eine Schreibtafel ist eine flache, meist rechteckige Tafel, die als Oberfläche zum Schreiben, Zeichnen oder Markieren dient. Sie kann mit traditionellen Geräten wie einem Griffel, Stift oder Marker sowie mit digitalen Eingabegeräten, wie beispielweise wie Touch-Stiften oder Stylus, auf interaktiven Bildschirmen bearbeitet werden. Schreibtafeln können aus verschiedenen Materialien bestehen, wie Wachs, Schiefer, Holz, Papier oder auch digitale Displays.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002500"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk018581"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk005511"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk021129"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-04-07T12:35:52+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021133">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">drag (performing arts)</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Drag (Darstellende Kunst)</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk005903"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013601"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk018387"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk005903"/>
		<gvp:aat2311_performed_by rdf:resource="http://lvr.vocnet.org/wnk/wk021140"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk005391"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk021018"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk009489"/>
		<skos:definition xml:lang="de">Drag ist eine Form der darstellenden Kunst, die sich verschiedener Stilmittel (Schminke, Kleidung, Perücken etwa) bedient, um mit gesellschaftlichen Geschlechterrollen zu spielen. Auftritte finden vor allem auf Bühnen, im Fernsehen oder im Internet statt und können unter anderem Tanz, Gesang und Sprache beinhalten.</skos:definition>
		<xe:explanation_temp xml:lang="de">Drag und Travestie werden von einigen Künstlern synonym verwendet, gelegentlich aber auch voneinander abgegrenzt, unter anderem anhand ästhetischer Stilmittel. Der Begriff Travestie wird im deutschsprachigen Raum schon länger verwendet als der aus dem Englischen übernommene Begriff Drag.</xe:explanation_temp>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4185968-6"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q3410369"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk005903"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk013601"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk018387"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<schema:image rdf:resource="https://xtree.digicult-verbund.de/imageStore/images/lvr_database/depiction_183.jpg"/>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-02-06T13:33:39+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<schema:ImageObject rdf:about="https://xtree.digicult-verbund.de/imageStore/images/lvr_database/depiction_183.jpg">
		<schema:caption xml:lang="de">Drag (Darstellende Kunst)</schema:caption>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:rightsHolder>LVR-Institut für Landeskunde und Regionalgeschichte</dcterms:rightsHolder>
		<schema:creator>Brass, Jana</schema:creator>
	</schema:ImageObject>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021134">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">blackface</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Blackfacing</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk005899"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013672"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013777"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013778"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk005899"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk009489"/>
		<skos:definition xml:lang="de">Blackfacing ist ein gesellschaftliches Thema, das von Praktiken der Kostümierung und Maskerade ausgehend Fragen nach rassistischer Diskriminierung und kultureller Aneignung stellt. Blackfacing umfasst Praktiken, die darauf abzielen, nicht-schwarze Personen als schwarze Personen erscheinen zu lassen, insbesondere unter Verwendung von dunkler Gesichtsschminke, Perücken und anderer Mittel, unter anderem zu Zwecken der Unterhaltung und im Kontext von Brauchhandlungen.</skos:definition>
		<xe:explanation_temp xml:lang="de">Das Blackface als Theater- und Unterhaltungsmaskerade war bereits in Unterhaltungs-Shows des 18. und 19. Jahrhunderts in den Vereinigten Staaten populär, in denen mittels Blackfacing weiße Darsteller schwarze Rollen spielten. In Deutschland wird verstärkt seit den 2010er Jahren von Blackfacing gesprochen, unter anderem im Bezug auf die Kostümierung nicht-schwarzer Menschen als „Afrikaner“ im Karneval und auf die Figur des schwarzen Königs Caspar als Teil der Sternsinger, wenn er von einem nicht-schwarzen Kind oder Jugendlichen mit schwarzer Gesichtsschminke dargestellt wird. In den Niederlanden wird der Begriff auf die Brauchfigur des Zwarte Piet (Helfer des Sinterklaas, des Heiligen Nikolaus) angewandt. Blackfacing ist eine deutschsprachige Wortschöpfung in Entlehnung des englischen Substantivs blackface (schwarzes / geschwärztes Gesicht). Es wurde in Deutschland zum Anglizismus des Jahres 2014 gekürt. Praktiken des Blackfacing werden von vielfältigen gesellschaftlichen Gruppen kritisiert, da sie durch die bewusste, übersteigerte Reproduktion von Klischees auf rassistische Weise abwertende Stereotype bedienen und Menschen(-gruppen) diskriminieren.</xe:explanation_temp>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/1149977590"/>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300448122"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk005899"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk013672"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk013777"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk013778"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
