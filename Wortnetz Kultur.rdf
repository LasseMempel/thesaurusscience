		<skos:prefLabel xml:lang="de">Fachwerkständerbau</skos:prefLabel>
		<skos:altLabel xml:lang="de">Fachwerkständerbauten</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000443"/>
