	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk007493">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Arzneiflasche</skos:altLabel>
		<skos:prefLabel xml:lang="en">medicine bottle</skos:prefLabel>
		<skos:altLabel xml:lang="en">medicine bottles</skos:altLabel>
		<skos:altLabel xml:lang="de">Medizinfläschchen</skos:altLabel>
		<skos:prefLabel xml:lang="de">Medizinflasche</skos:prefLabel>
		<skos:altLabel xml:lang="de">Medizinflaschen</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004610"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004610"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk021241"/>
		<skos:definition xml:lang="de">Eine Medizinflasche ist eine kleine Flasche, in der Arzneimittel an Endverbraucher abgegeben (verkauft) werden. Dies umfasst Flaschen, die ab Werk abgefüllt und solche, die in einer Apotheke befüllt werden. Sie bestehen meist aus Glas und hier insbesondere aus Braunglas.</skos:definition>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q111490452"/>
