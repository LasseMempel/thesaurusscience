    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1457>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1658>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2439>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2448>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2469>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2529>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2540> ;
    skos:scopeNote "Institutions of science formation and organisation. They include institutions for the organisation (professional or other) of the scientific community and institutions for the pursuit of scientific research and/or the dissemination of science-related information to scientific or broader audiences."@en .

