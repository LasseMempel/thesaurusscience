    <!-- https://hist-arch-vocab.org/bvha#c_bba082cf -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_bba082cf">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1b21ae94"/>
