	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1173">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1173</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">MÈINN BOGSAIT</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far a bheil acainnean is structaran airson bauxite (clach-almain) a tharraing à clach-mhèinnir.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BAUXITE MINE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1170" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1041" />
		<skos:scopeNote xml:lang="en">A site with equipment and structures for the extraction of bauxite (aluminium ore).</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
