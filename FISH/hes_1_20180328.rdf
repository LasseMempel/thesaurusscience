		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/503290" />
		<skos:scopeNote xml:lang="en">A shopping complex, usually indoors, comprised of a number of separate retail outlets surrounding an open space. Often on more than one level.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
