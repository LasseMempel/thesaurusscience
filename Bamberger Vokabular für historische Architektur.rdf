    <!-- https://hist-arch-vocab.org/bvha#c_c76a0778 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_c76a0778">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0ce8c69b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
