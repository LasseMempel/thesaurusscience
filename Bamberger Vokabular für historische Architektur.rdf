        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T16:43:28.000</terms:modified>
        <skos:altLabel xml:lang="en">bell-shaped capital</skos:altLabel>
        <skos:definition xml:lang="de">Kapitell, das wie eine Glocke oben konvex und unten konkav ist. Das G. kommt in der ägypt. Baukunst vor. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Glockenkapitell</skos:prefLabel>
        <skos:prefLabel xml:lang="en">bell capital</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">chapiteau campaniforme</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_c59721ba -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_c59721ba">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1192c84c"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
