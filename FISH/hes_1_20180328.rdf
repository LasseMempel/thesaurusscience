		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/945" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/730" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/970" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/976" />
		<skos:scopeNote xml:lang="en">Any factory or site using machine tools in a manufacturing or processing capacity.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
