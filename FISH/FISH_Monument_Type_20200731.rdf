  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71532">
    <skos:scopeNote xml:lang="en">A purpose-built hall (usually 19th century) which was available for public hire and could be used for a variety of activities, eg. lectures, meetings, balls and concerts.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70412">
