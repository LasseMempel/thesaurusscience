        "Stockschwellen"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002554> ;
    skos:definition "Eine Stockschwelle ist eine Schwelle, die auf Etagenniveau liegt."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Stockschwelle"@de,
        "head plate"@en .

<http://lvr.vocnet.org/wnk/wk002563> a skos:Concept ;
    skos:altLabel "Waldsäume"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk001767> ;
