	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021336">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">10. Stufe (Kambrium)</skos:altLabel>
		<skos:altLabel xml:lang="en">Cambrian Stage 10</skos:altLabel>
		<skos:prefLabel xml:lang="en">Cambrian Stage 10 Age</skos:prefLabel>
		<skos:altLabel xml:lang="de">Kambrium 10. Stufe</skos:altLabel>
		<skos:altLabel xml:lang="de">Kambrium Stufe 10</skos:altLabel>
		<skos:prefLabel xml:lang="de">Kambrium-Stufe 10</skos:prefLabel>
