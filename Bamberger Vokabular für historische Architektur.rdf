        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-08-19T13:35:12.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T18:30:44.000</terms:modified>
        <skos:definition xml:lang="de">Durch Beimengung von Gerberlohe, die beim Brennen Hohlräume hinterlässt, bes. leichter Backstein, in der Gotik für Gewölbe verwendet. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Lohstein, got. Gewölbestein aus gebranntem Ton (Backstein), bes. leicht durch Beimengung von Gerberlohe, die durch den Brennvorgang zerstört wird und dadurch Hohlräume entstehen lässt. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Velmi lehká cihla, vzniklá přimísením koželužského třísla, které při vypalování zanechává dutiny, používaná v gotice ke stavbu klenby. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="fr"> brique tanisée</skos:prefLabel>
        <skos:prefLabel xml:lang="es"> ladrillo artificialmente poroso</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Lohstein</skos:prefLabel>
        <skos:prefLabel xml:lang="en">perforated brick</skos:prefLabel>
        <skos:prefLabel xml:lang="it">pietra artificialmente porosa</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">tříslová cihla</skos:prefLabel>
    </owl:NamedIndividual>
    


