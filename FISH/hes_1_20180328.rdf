	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/181">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/181</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">IONAD-MÒID</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite a-muigh airson cruinneachadh ann.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MOOT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/151" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/182">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/182</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TOM A' MHÒID</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Tom nàdarra no fuadain a bhite a' cleachdadh mar àite cruinneachaidh, ionad cùirte ionadail gu math tric.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">MOOT HILL</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/181" />
				<skos:scopeNote xml:lang="en">A natural or artificial hill used as a meeting place, often the site of a local court.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/180" />
		<skos:scopeNote xml:lang="en">An outdoor meeting place.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
