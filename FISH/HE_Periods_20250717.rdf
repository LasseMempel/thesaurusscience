    <skos:altLabel xml:lang="en">Eneolithic</skos:altLabel>
    <skos:broader rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/EBA"/>
    <skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/CH"/>
