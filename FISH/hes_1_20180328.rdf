				<skos:prefLabel xml:lang="gd">EAGLAIS PARAISTE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">A' phrìomh-eaglais ann am paraiste.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">PARISH CHURCH</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
