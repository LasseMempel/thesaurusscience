	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1900">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1900</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FEART LOIDHNEACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Feart àirc-eòlach dìreach no lùbach. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">LINEAR FEATURE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">LINEAR CROPMARK</skos:altLabel>
		<skos:altLabel xml:lang="en">LINEAR SOILMARKS</skos:altLabel>
