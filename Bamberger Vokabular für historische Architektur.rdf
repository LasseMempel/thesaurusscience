    <!-- https://hist-arch-vocab.org/bvha#c_3d2503fe -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_3d2503fe">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f4e2bee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-18T12:34:03.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-30T10:11:26.000</terms:modified>
        <skos:altLabel xml:lang="de">Konsoldach</skos:altLabel>
        <skos:definition xml:lang="de">Kragdach, Konsoldach, auskragendes und nur an einer Seite eingespanntes Dach, hauptsächl. über Rampen, Freitreppen u. dergleichen. [Koepf / Binding 2016] </skos:definition>
        <skos:prefLabel xml:lang="de">Kragdach</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_f4e2bee8"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_3d2af3d8 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_3d2af3d8">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_41d94569"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a9967019"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_19d56a39"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-23T12:35:32.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-02T15:38:26.000</terms:modified>
        <skos:altLabel xml:lang="de">Anschieber</skos:altLabel>
        <skos:altLabel xml:lang="de">Anschiebling</skos:altLabel>
        <skos:definition xml:lang="de">Auf einen Sparren oder Rofen aufgeschobenes Holz, das die Dachfläche über den Dachfuß führt, wodurch die Traufe angehoben bzw. eine weit vorstehende Traufe gebildet wird und dabei einen charakteristischen Knick in der Dachfläche erzeugt. [Eißing et al. 2012]</skos:definition>
        <skos:definition xml:lang="de">Aufschiebling, Anschieber, Anschiebling, deckt bei Sparrendächern das Vorholz, das bei der Versatzung zur Sicherung des Sparrenfußes stehenbleibt, und gleicht bei genügender Länge den Vorsprung für eine einheitl. Dachfläche aus, seitl. an die Sparren angenagelt als Anschiebling. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Aufschiebling</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">námětek</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_3d2f62e9 -->


