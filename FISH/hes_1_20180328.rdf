				<skos:prefLabel xml:lang="gd">TAIGH-POILIS</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Togalach far am faigh constabalan a' phoileis àite-fuirich.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">POLICE HOUSE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-09T11:25:31</dcterms:created>
