        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-16T16:10:17.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T12:04:48.000</terms:modified>
        <skos:altLabel xml:lang="en">chevron</skos:altLabel>
        <skos:altLabel xml:lang="cs">cimbuří</skos:altLabel>
        <skos:altLabel xml:lang="cs">horní zubovité ukončení zdi</skos:altLabel>
        <skos:altLabel xml:lang="fr">zigzag</skos:altLabel>
        <skos:definition xml:lang="de">Deutsches Band, aus hochkantigen, übereckgestellten Backsteinen bestehender Fries. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Zahnschnitt, Zahnfries aus Backsteinen, deren Vorderkanten in der Bauflucht liegen. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Zubořez, zubovité ukončení zdi z cihel, jejichž přední hrany leží v líci zdiva. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Deutsches Band, Zahnfries</skos:prefLabel>
        <skos:prefLabel xml:lang="it">fregio a zig-zag</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">frise dentée</skos:prefLabel>
        <skos:prefLabel xml:lang="es">friso dentado</skos:prefLabel>
        <skos:prefLabel xml:lang="en">zigzag</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">zubový vlys</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_6a422d06 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_6a422d06">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_d96402bc"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-27T19:17:40.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-27T19:20:32.000</terms:modified>
        <skos:definition xml:lang="de">Amulett n; lat. amuletum: ein Medaillon oder ein anderer kleiner Gegenstand, dem besondere apotropäische Kraft zugeschrieben wird. Es wird als Anhänger am Hals oder am Arm getragen. Seit dem 4. Jh. wurden oft Christusmonogramme oder christliche Symbole auf dem Amuletten abgebildet (Beispiel: die Abraxasgemme mit dem Henkelkreuz). Auch Kreuze mit dem Bild eines verehrten Heiligen oder mit der Darstellung von Ereignissen aus seinem Leben wurden als Amulett getragen. Beispiele: das UIrichskreuz, das Valentiuskreuz und das Theresienkreuz. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Amulett</skos:prefLabel>
        <skos:prefLabel xml:lang="en">amulet</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">amulette</skos:prefLabel>
        <skos:prefLabel xml:lang="la">amuletum</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_6a4a0ca9 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_6a4a0ca9">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_01e49620"/>
