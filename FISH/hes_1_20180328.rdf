		<skos:altLabel xml:lang="en">ROMAN DITCH</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/278" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1442" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1463" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1518" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/394" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/400" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/402" />
		<skos:scopeNote xml:lang="en">A long, narrow channel dug in the ground, used for irrigation or drainage, as a boundary or as part of a defensive barrier.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
