        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-31T00:49:11.000</terms:modified>
        <skos:altLabel xml:lang="de">Wärmebecken</skos:altLabel>
        <skos:altLabel xml:lang="la">calorificum</skos:altLabel>
        <skos:altLabel xml:lang="la">scutia</skos:altLabel>
        <skos:altLabel xml:lang="la">scutra</skos:altLabel>
        <skos:definition xml:lang="de">Wärmepfanne f; Wärmebecken n; lat. calefactorium; calorificum; scutra; scutia: ein metallenes, durchbrochen gearbeitetes Gefäß mit einem Becken für glühende Kohlen. Es diente in der kalten Jahreszeit als Wärmequelle beim Altardienst. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Wärmepfanne</skos:prefLabel>
        <skos:prefLabel xml:lang="la">calefactorium</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">chauffoir d\&apos;autel</skos:prefLabel>
        <skos:prefLabel xml:lang="en">warming-pan</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_499b374b -->


