    <!-- https://hist-arch-vocab.org/bvha#c_2c9de681 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_2c9de681">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b5a6557d"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_b641aad9"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-06T23:13:44.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T14:30:24.000</terms:modified>
        <skos:definition xml:lang="de">Ein rechteckiges Grabdenkmal, auf dem die Grabplatte, oft mit einem Relief oder einer vollplast. Darstellung des Toten, liegt. Die Grabplatte kann auf Füßen oder auf einem geschlossenen und mit Plastik geschmückten Unterbau ruhen. Manchmal ist auch ein Baldachin über der T. angeordnet. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Obdélníková zdobená nástavba nad hrobem, která nese náhrobní desku, často s ležící figurou zemřelého, někdy mívá baldachýnovou nadstavbu, rytířské hroby často s funerálními zbraněmi (středověk). [Koch 2008]  </skos:definition>
        <skos:prefLabel xml:lang="de">Tumba</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">tumba</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_2ca91d01 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_2ca91d01">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
