		<skos:prefLabel xml:lang="gd">SEÒMAR-FEITHEIMH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Seòmar a chleachdas na daoine a bhios a' fuireach aig stèisean-rèile, stèisean bhusaichean is msaa.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">WAITING ROOM</skos:prefLabel>
