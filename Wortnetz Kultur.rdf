	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk007511">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">beer bottle</skos:prefLabel>
		<skos:altLabel xml:lang="en">beer bottles</skos:altLabel>
		<skos:prefLabel xml:lang="de">Bierflasche</skos:prefLabel>
		<skos:altLabel xml:lang="de">Bierflaschen</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004610"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk018443"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk020392"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013632"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004610"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk018443"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk020392"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk009207"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk007412"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk007376"/>
		<skos:definition xml:lang="de">Eine Bierflasche ist eine Flasche mit zylindrischem Bauch, in die Bier vom Hersteller zum Transport und zur Aufbewahrung abgefüllt wird. Typischerweise sind Bierflaschen als Verkaufsverpackungen aus braunem, grünem oder auch weißem Glas, fassen 0,25 bis 1 Liter und tragen eine Beschriftung der Brauerei als Etikett oder Embossing. Nach dem Befüllen werden sie normalerweise mit Bügelverschluss oder Kronkorken luftdicht verschlossen, um das Bier bis zu seinem Verzehr vor äußeren Einflüssen zu schützen.</skos:definition>
		<xe:explanation_temp xml:lang="de">Frühe Bierflaschen entsprachen den Sektflaschen und wurden ebenso mit Korken verschlossen. Moderne Varianten sind aus Kunststoff und besitzen einen Schraubverschluss. Außerdem kommen weitere Materialien vor, etwa Steingut.</xe:explanation_temp>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4208864-1"/>
		<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q23668"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk013632"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004610"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk020392"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk018443"/>
		<xe:status>approved</xe:status>
		<iso-thes:status>Approved</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
