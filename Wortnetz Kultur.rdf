		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk002252"/>
		<xe:explanation_temp xml:lang="de">Das Kaffgesims ist eine Besonderheit der Gotik und gotisierender Stile.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Kaffgesims ist ein Gesims, das an der Oberseite stark abgeschrägt, in der Unteransicht profiliert und mit einer Wassernase versehen ist.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002252"/>
