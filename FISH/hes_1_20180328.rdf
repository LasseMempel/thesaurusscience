		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/504442">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/504442</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TAIGH LETH-DHEALAICHTE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Togalach sa bheil dà thaigh a tha ri balla a chèile..</skos:scopeNote>
				<skos:prefLabel xml:lang="en">SEMI DETACHED HOUSE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-06-30T14:37:37</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-06-30T14:40:19</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/422" />
				<skos:scopeNote xml:lang="en">A house joined to another to form one building.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
