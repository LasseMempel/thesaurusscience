		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/350">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/350</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BOTHAN CONNADH-LÀMHAICH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar concrait no bhreigean ath-neartaichte, air falbh o thogalaichean eile, gu tric le acainnean togail meatailt.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">AMMUNITION STORAGE HUT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/349" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/369" />
		<skos:scopeNote xml:lang="en">Reinforced concrete and brick structures set apart from other buildings, often with metal hoist equipment.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/351">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/351</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGHEAN-FEACHD</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach far a bheilear a' toirt còmhnaidh dha feachdan no luchd-obrach an airm.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BARRACKS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-06-12T10:37:00</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">GARRISON</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/503173" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/493" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/184" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/361" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/363" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/385" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/387" />
		<skos:scopeNote xml:lang="en">A building, or group of buildings, used to house troops or military personnel.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
