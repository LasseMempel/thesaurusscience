    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_c518257a">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_16f51c9b"/>
