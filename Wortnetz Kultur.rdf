	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk018441">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Bildwerfer</skos:altLabel>
		<skos:prefLabel xml:lang="en">projector (image projectors)</skos:prefLabel>
		<skos:altLabel xml:lang="en">projectors (image projectors)</skos:altLabel>
		<skos:altLabel xml:lang="de">Projektionsapparat</skos:altLabel>
		<skos:altLabel xml:lang="de">Projektionsgerät</skos:altLabel>
		<skos:prefLabel xml:lang="de">Projektor</skos:prefLabel>
		<skos:altLabel xml:lang="de">Projektoren</skos:altLabel>
