        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-12-18T18:14:31.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T14:27:17.000</terms:modified>
        <skos:prefLabel xml:lang="de">Johannes der Täufer sendet aus dem Kerker die Jünger zu Jesus</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_61930c96 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_61930c96">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0gcqi8ey"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T09:54:19.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T10:31:47.000</terms:modified>
        <skos:definition xml:lang="de">(Alpha und Omega, erster und letzter Buchstabe des griech. Alphabets) für die Unendlichkeit Gottes. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Alpha und Omega: der erste und letzte Buchstabe des griechischen Alphabets, christologisch interpretiert als Name Gottes (Apk 1,8), der Erste und der Letzte, der Anfang und das Ende (seit 2. Hälfte 4. Jh.). Die Buchstaben begleiten oft das Chri stusmonogramm, das Gotteslamm und andere Symbole. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="cs">První a poslední písmeno řecké abecedy, symbol nekonečnosti Boží. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Alpha und Omega</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">alfa a omega</skos:prefLabel>
        <skos:prefLabel xml:lang="en">alpha and omega</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">alpha et oméga </skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_6193f765 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_6193f765">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_162d82c1"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_f10222e0"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_8d662389"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-22T18:20:36.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T13:23:59.000</terms:modified>
        <skos:definition xml:lang="de">[Man überarbeitete] die Sichtfläche [des Werksteins] nach dem Abflächen mit dem etwa 4 - 5 cm breiten Breit- oder Scharriereisen, [...], das man mit einem Holzknüpfel schlug. [...] Durch die Hieb-an-Hieb-Führung entstanden oft deutlich sichtbare Bahnen, fast immer in einem Winkel von etwa 45 - 60° geführt. Die Hiebe waren, natürlich abhängig vom Material, meist recht breit und gleichmäßig und gaben damit der Oberfläche ein einheitliches Bild. [Voelkle 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Scharrierung</skos:prefLabel>
    </owl:NamedIndividual>
    


