    <!-- https://hist-arch-vocab.org/bvha#c_dadc7c1c -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_dadc7c1c">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
