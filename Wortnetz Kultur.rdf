	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk001944">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">monastic order</skos:prefLabel>
		<skos:altLabel xml:lang="de">Monastische Orden</skos:altLabel>
		<skos:prefLabel xml:lang="de">Monastischer Orden</skos:prefLabel>
		<skos:altLabel xml:lang="de">Mönchsorden</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003837"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk003839"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019759"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk003837"/>
		<xe:explanation_temp xml:lang="de">Die als Mönche bzw. Nonnen bezeichneten Mitglieder monastischer Orden legen feierliche Gelübde ab (im Gegensatz zu einfachen Gelübden bei Angehörigen von Kongregationen).</xe:explanation_temp>
		<skos:definition xml:lang="de">Der Monastische Orden ist ein christlicher Orden, dessen Angehörige in einer mönchischen Lebensform in der klösterlichen Abgeschiedenheit der Klausur leben.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003837"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003839"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019759"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk001897"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk001946"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk001947"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk001979"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002042"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002043"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002044"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
