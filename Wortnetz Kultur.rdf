		<skos:altLabel xml:lang="de">Fliegenfangglas</skos:altLabel>
		<skos:altLabel xml:lang="de">Fliegenfanggläser</skos:altLabel>
		<skos:prefLabel xml:lang="de">Fliegenglas</skos:prefLabel>
		<skos:altLabel xml:lang="de">Fliegengläser</skos:altLabel>
		<skos:prefLabel xml:lang="en">fly bottle</skos:prefLabel>
		<skos:altLabel xml:lang="en">fly bottles</skos:altLabel>
		<skos:altLabel xml:lang="de">Wespenglas</skos:altLabel>
		<skos:altLabel xml:lang="de">Wespengläser</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk002924"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013658"/>
