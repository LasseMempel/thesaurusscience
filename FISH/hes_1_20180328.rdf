		<skos:prefLabel xml:lang="gd">LOIDSE-GEATA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach aig geata no doras oighreachd, pàirce no pìos talmhainn iadhta eile.</skos:scopeNote>
