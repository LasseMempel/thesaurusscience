	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk007276">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">crucible</skos:prefLabel>
		<skos:altLabel xml:lang="en">crucibles</skos:altLabel>
		<skos:prefLabel xml:lang="de">Tiegel</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000203"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk021348"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019145"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000203"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk021348"/>
		<skos:definition xml:lang="de">Ein Tiegel ist ein meist rundes, oft unten verjüngtes Gefäß aus feuerfestem und chemisch beständigem Material wie Keramik, Porzellan, bestimmten Metallen oder Glas, das vor allem zum Erhitzen, Schmelzen oder chemischen Umsetzen von Stoffen in Labor, Handwerk oder Industrie verwendet wird.</skos:definition>
		<skos:exactMatch rdf:resource="http://purl.org/heritagedata/schemes/mda_obj/concepts/96851"/>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300196462"/>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4341220-8"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q390417"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019145"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk021348"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000203"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk007278"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
