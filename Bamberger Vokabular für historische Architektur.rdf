    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_9195e574 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_9195e574">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_298d4e12"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-05T12:36:53.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T14:04:38.000</terms:modified>
        <skos:definition xml:lang="de">Ornament mit zartem Rankenwerk und phantasievollen Menschen-, Tier-, Fabelwesen, römisch-antiken Ursprungs. Um 1500 an grottenartigen Ausgrabungsstellen wiederentdeckt (Rom, Domus aurea des Nero), seit Raffael bis zum 19. Jh. oft verwendet. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Ornament římsko-antického původu s jemnými úponky a fantastickými lidskými, zvířecími a bájnými postavami, kolem r. 1500 znovu objevena v jeskyňovitých vykopávkách (Řím, Domus aurea císaře Nerona), často používána od dob Raffaelových až do 19. stol. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Groteske</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">groteska</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Groteske (ital.), aus der hellenist.röm. Antike stammende Dekoration. [Koepf / Binding 2016]</skos:scopeNote>
    </owl:NamedIndividual>
    


