        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/69> ;
    skos:scopeNote "Inscription text layout, according to which the direction of the text follows a path from left to right."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/861> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/702> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Akte"@de,
        "Acts"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1078> ;
    skos:scopeNote "External division of a play into more or less equal parts on the basis of time and development of the action. It may contain one or several scenes."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/888> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/491> ;
