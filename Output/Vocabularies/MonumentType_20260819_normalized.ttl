    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "ARTIFICIAL LIMB FACTORY"@en ;
    skos:scopeNote "A factory used for the production of artificial limbs. They were often located within the precincts of a hospital, to enable fittings to take place and help the amputee to get used to wearing the limb."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/100042> a skos:Concept ;
