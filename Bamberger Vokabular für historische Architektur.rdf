        <skos:altLabel xml:lang="en">skewback</skos:altLabel>
        <skos:altLabel xml:lang="en">tas-de-charge</skos:altLabel>
        <skos:altLabel xml:lang="fr">tas-de-charge</skos:altLabel>
        <skos:definition xml:lang="de">Auflager, Fläche, auf der ein tragendes Bauglied (z.B. Balken) aufliegt. Bei einem Bogen oder Gewölbe ist das A. die horizontale obere Abschlussfläche des Widerlagers. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Die waagrechte, obere Abschlussfläche des Widerlagers [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Eine Fläche, auf der das Endstück eines tragenden Baugliedes aufliegt, z.B. Konsole für einen Balken, Widerlager für einen Bogen. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Auflager</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">lit d\&apos;attente</skos:prefLabel>
        <skos:prefLabel xml:lang="en">seating</skos:prefLabel>
    </owl:NamedIndividual>
    


