<http://lvr.vocnet.org/wnk/wk021230> a skos:Concept ;
    skos:altLabel "Terreneuvian"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk001498> ;
    skos:definition "Das Terreneuvium ist die unterste Epoche des Kambriums. Sie begann vor etwa 538,8 Millionen Jahren und endete vor etwa 521 Millionen Jahren."@de ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/GeochronologicEraValue/terreneuvian>,
