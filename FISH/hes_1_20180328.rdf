	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1846">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1846</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">SNAIDHM MHÒR-RATHAIDEAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Siostam de rathaidean is drochaidean co-cheangailte a chaidh a dhealbhadh gus co-dhiù dà rathad-mòr is rathaidean eile a cheangal ri chèile gu èifeachdach.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MOTORWAY INTERCHANGE</skos:prefLabel>
