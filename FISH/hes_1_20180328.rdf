				<skos:prefLabel xml:lang="gd">FACTARAIDH GRÀBHALAIDH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Factaraidh far a bheilear a' gràbhaladh litrichean is dealbhadh eile ann am meatailtean no stuthan eile.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">ENGRAVING WORKS</skos:prefLabel>
