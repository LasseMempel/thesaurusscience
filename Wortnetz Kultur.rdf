		<skos:altLabel xml:lang="de">Hängesprengwerke</skos:altLabel>
		<skos:prefLabel xml:lang="en">hanging truss</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006916"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk006916"/>
		<skos:definition xml:lang="de">Ein Hängesprengwerk ist ein Bauteil und der Bestandteil eines Fachwerks, der aus einer von zwei Sprengstreben unterstützten Hängesäule besteht, an der ein Spannbalken hängt.</skos:definition>
