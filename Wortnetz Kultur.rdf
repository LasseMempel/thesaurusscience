		<skos:prefLabel xml:lang="es">dolomía</skos:prefLabel>
		<skos:prefLabel xml:lang="it">dolomia</skos:prefLabel>
		<skos:prefLabel xml:lang="fr">dolomie</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Dolomit (Gestein)</skos:prefLabel>
		<skos:prefLabel xml:lang="en">dolomite (rock)</skos:prefLabel>
