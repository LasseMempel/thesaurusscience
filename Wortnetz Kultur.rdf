	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021263">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">green alga</skos:prefLabel>
		<skos:altLabel xml:lang="en">green algae</skos:altLabel>
		<skos:prefLabel xml:lang="de">Grünalge</skos:prefLabel>
		<skos:altLabel xml:lang="de">Grünalgen</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk011045"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk011045"/>
		<skos:definition xml:lang="de">Grünalgen sind Algen, die überwiegend im Süßwasser, aber auch im Salzwasser und auf feuchten Landflächen vorkommen. Sie enthalten Chlorophyll a und b und sind dadurch grün gefärbt.</skos:definition>
		<skos:mappingRelation rdf:resource="http://d-nb.info/gnd/4072124-3"/>
		<skos:mappingRelation rdf:resource="http://www.wikidata.org/entity/Q271844"/>
