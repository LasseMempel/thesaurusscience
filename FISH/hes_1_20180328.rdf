				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1913" />
				<skos:scopeNote xml:lang="en">A room or group of rooms usually below the ground level and usually under a building, often used for storing fuel, provisions or wines.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
