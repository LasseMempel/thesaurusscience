		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/185" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500642">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500642</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TALLA PHOBLACH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Talla a chaidh a thogail a dh'aona-ghnothach (mar is trice san 19mh linn) a bhiodh ri fhaighinn air mhàl agus a chaidh a chleachdadh airson diofar rudan, m.e. òraidean, coinneamhan, bàlaichean is consartan.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">PUBLIC HALL</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-30T11:24:36</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-30T11:24:58</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/188" />
				<skos:scopeNote xml:lang="en">A purpose-built hall (usually 19th century) which was available for public hire and could be used for a variety of activities, eg. lectures, meetings, balls and concerts.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/504841">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/504841</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TALLA NAN CIÙIRD</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Togalach far an cruinnich aonaidhean-ciùird no far an dèan iad obair còmhla fo bhuidheann riochdachaidh ionadail air a bheil comhairle-obrach no comhairle talla nan ceàrd.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">TRADES HALL</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-04-23T13:50:30</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-04-23T13:51:20</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:altLabel xml:lang="en">TRADES UNION HALL</skos:altLabel>
				<skos:altLabel xml:lang="en">TRADE UNION HALL</skos:altLabel>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/188" />
				<skos:scopeNote xml:lang="en">A building where trade unions meet together, or work from cooperatively, under a local representative organisation, known as a Labour Council or Trades Hall Council.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/503580">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/503580</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TALLA LÈIGIAN BHREATAINN</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Àite far an coinnich buill Lèigiun Bhreatainn.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">BRITISH LEGION HALL</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-10T13:35:19</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-10T13:35:24</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/188" />
				<skos:scopeNote xml:lang="en">A place where members of the British Legion meet.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
