    <!-- https://hist-arch-vocab.org/bvha#c_c2cec9dd -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_c2cec9dd">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
