		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500671" />
		<skos:scopeNote xml:lang="en">A piece of machinery on which a railway engine, carriage or wagon can be rotated at a railway terminal.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
