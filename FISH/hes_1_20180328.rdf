	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1106">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1106</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">POLL-CRÈADHA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far a bheilear a' buain crèadha.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CLAY PIT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1157" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1105" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1134" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1135" />
