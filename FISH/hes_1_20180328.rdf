		<skos:prefLabel xml:lang="gd">IONAD-DEALACHAIDH GUAIL</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Factaraidh far a bheilear a' giullachd gual le bhith ga chur air bhog. Thathar a' cur gual ann an speinsean de mhagnataid ann an uisge agus leigidh seo le sgudal tuiteam gun ghrunnd agus bidh an gual air fleòd air uachdar agus ga thoirt às.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">DENSE MEDIUM PLANT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/827" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/828" />
		<skos:scopeNote xml:lang="en">A plant in which coal is treated by flotation. Coal is placed in a suspension of magnetite in water, which allows dirt to sink and coal to float to the surface for removal.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
