        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_83a6e08e"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_883057f1"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_8b9a8a53"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_94e58233"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_9957d8a8"/>
