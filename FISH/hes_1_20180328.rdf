		<skos:prefLabel xml:lang="gd">FÙIRNEIS</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Seòmar anns an cuirear meatailtean no clachan-mèinnir fo bhuaidh teasa mhòir. Cleachd seòrsa nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">FURNACE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
