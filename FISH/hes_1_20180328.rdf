		<skos:scopeNote xml:lang="en">A stone that indicates the limit of an area or piece of land.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1471">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1471</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TOGALACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar aig a bheil mullach a bheir fasgadh on aimsir do dhaoine no rudan. Cleachd seòrsa nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BUILDING</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">BUILDING FOOTINGS</skos:altLabel>
		<skos:altLabel xml:lang="en">BUILDING FOUNDATIONS</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1897" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1918">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1918</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TAIGH A-MUIGH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Fo-thogalach dealaichte. Cleachd seòrsa nas mionaidiche ma tha fios air, m.e. TAIGH-BAINNE.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">OUTBUILDING</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:altLabel xml:lang="en">OUTHOUSE</skos:altLabel>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1471" />
				<skos:scopeNote xml:lang="en">A detached subordinate building. Use specific type where known, e.g. DAIRY.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1475" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1913" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1919" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1442" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/474" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1476" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1478" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1480" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1477" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1917" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500574" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500668" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500708" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500879" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/501025">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/501025</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TOGALACH LE ÙRLAR ÌSLICHTE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Togalach aig an robh ùrlar nas ìsle na an talamh 's a dh'aithnichear air comharra-barra a tha ceàrnagach/ceart-cheàrnach is soladach.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">SUNKEN FLOORED BUILDING</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-02-20T14:47:42</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-02-21T07:48:28</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1471" />
				<skos:scopeNote xml:lang="en">A building defined by a sunken hollow, usually identified as a solid square or rectangular cropmark.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/501046">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/501046</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TOGALACH PEIT CHARMAIG</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Togalach a tha cha mhòr ceart-cheàrnach à toiseach nam meadhan-aoisean, mar is trice nas caoile air an dàrna cheann na aig a' cheann eile agus uaireannan le taobhan cama. Bidh ùrlar ìslichte aig a' cheann chaol gu math tric.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">PITCARMICK BUILDING</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-02-21T09:29:39</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-02-21T11:52:02</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1471" />
				<skos:scopeNote xml:lang="en">A roughly rectangular building of early medieval date, usually narrower at one end than the other and sometimes bow-sided. In many cases the floor at the narrow end is sunken.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/501047">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/501047</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TOGALACH STUAGHAN CRUINN</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Togalach a tha cha mhòr ceart-cheàrnach aig a bheil co-dhiù aon cheann cruinnte.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">ROUND ENDED BUILDING</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-02-21T10:08:53</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-02-21T10:10:16</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1471" />
				<skos:scopeNote xml:lang="en">A roughly rectangular building with one or both ends rounded.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/503823" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/503037" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/503416">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/503416</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TOGALACH CEALLACH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Togalach cobhaireachd cearcallach no cha mhòr cearcallach, mar is trice le mullach coirbealta agus ballachan tiugha agus uaireannan le còmhdachadh agus/no mullach sgratha. Faodaidh gum bi fo-cheallan ann a tha ri taobh a chèile.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">CELLULAR BUILDING</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-06-20T10:43:20</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-06-20T14:35:36</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1471" />
				<skos:scopeNote xml:lang="en">A circular or subcircular drystone building usually with a corbelled roof and thick walls, and sometimes clad and/or roofed in turf. Can have adjoining subsidiary cells.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1951" />
		<skos:scopeNote xml:lang="en">A structure with a roof to provide shelter from the weather for occupants or contents. Use specific type where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1475">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1475</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TOGALACH  BACAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach ceart-cheàrnach a chaidh a thogail air ùrlar fuadain, mar is tric air ceàrn dìreach ris an leathad.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PLATFORM BUILDING</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1471" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1576" />
		<skos:scopeNote xml:lang="en">A rectangular building constructed on an artificial platform, usually set at right angles to the slope.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1476">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1476</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">SEADA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach no sgailpean beag aotrom a chleachdar mar stòras, fasgadh fad greis is msaa.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SHED</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1471" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1367" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1812" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1813" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1830" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1836" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1919" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1958" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/250" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/30" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/657" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/740" />
		<skos:scopeNote xml:lang="en">A small building or lean-to of light construction, used for storage, temporary shelter etc.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1477">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1477</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">STÌOPALL</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Tùr àrd sgeadachail, mar is trice mar phàirt de dh'eaglais, teampall no togalach eile.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">STEEPLE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1471" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1480" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1744" />
		<skos:scopeNote xml:lang="en">A tall, ornamental tower, which usually forms part of a church, temple or other building.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1478">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1478</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TOGALACH FIODHA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach a tha sa mhòrchuid de dh'fhiodh. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TIMBER BUILDING</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1471" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/468" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1584" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1902" />
		<skos:scopeNote xml:lang="en">A building constructed largely from wood. Use specific term where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1480">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1480</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TÙR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach àrd, air pàtran cruinn, ceart-cheàrnach no ioma-cheàrnach 's a chleachdar airson iomadh adhbhar, a' gabhail a-steach dìon, mar chomharra-tìre, airson clagan a chrochadh ann, airson obair gnìomhachais is msaa. Cleachd briathar nas mionaidiche ma tha fhios cò fear.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TOWER</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1483" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1482">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1482</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">CLOC-THÙR</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Tùr a chaidh a thogail gus aodann uaireadair a shealltainn.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">CLOCK TOWER</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1480" />
				<skos:scopeNote xml:lang="en">A tower built to display a clock face.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1471" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1481" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1239" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1477" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/267" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/277" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/296" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/424" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/503640" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/669" />
		<skos:scopeNote xml:lang="en">A tall building, either round, rectangular or polygonal in plan, used for a variety of purposes, including defence, as a landmark, for the hanging of bells, industrial functions, etc. Use more specific term where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1481">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1481</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CLAG-THÙR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Tùr no turaid sa bheil clagan crochte.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BELL TOWER</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1645" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1480" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1744" />
		<skos:scopeNote xml:lang="en">A tower or turret in which bells are hung.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1483">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1483</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TÙR CRUINN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Tùr àrd caol a tha cruinn air a roinn-tharsainn. Mar is trice às na meadhan-aoisean agus co-cheangailte ri eaglais no manachainn ged a bhios e dealaichte uapa.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ROUND TOWER</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">ROUNDTOWER</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1480" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1645" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1744" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1757" />
		<skos:scopeNote xml:lang="en">A tall, narrow tower, circular in cross section. Usually of early Medieval date and associated with, although detached from, a church or monastery.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1484">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1484</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">STÈIDH TOGALAICH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">An earrann ìochdarach aig bunachar togalaich. Cleachd le briathar pongail ma tha fios air.</skos:scopeNote>
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1487">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1487</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BARPA   TÒRRAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Torr creagach sa bheil iarsmaidhean daonna no a tha gam falach. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BURIAL CAIRN</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">SMALL CAIRN</skos:altLabel>
		<skos:altLabel xml:lang="en">BURIAL MOUND</skos:altLabel>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1488" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1667" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1684">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1684</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">BARPA FADA</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Torr creagach ceart-cheàrnach no trapasoideach neo-mheagailiteach à Linn Ùr na Cloiche le iarsmaidhean daonna ann an cisteachan seach ann an seòmar mòr. Tha nàdar a thogail agus na structaran co-cheangailte ris gu math eadar-dhealaichte a thaobh seòrsa agus iom-fhillteachd.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">LONG CAIRN</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1487" />
				<skos:scopeNote xml:lang="en">A rectangular or trapezoidal non-megalithic stony mound of Neolithic date, with human remains in cists rather than a large chamber. Mound construction and associated features vary considerably in type and complexity.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1491" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/42" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1495" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1494" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1668" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1699" />
		<skos:scopeNote xml:lang="en">A stony mound containing or concealing deliberately deposited human remains. Use specific term where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1488">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1488</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BARPA SEÒMARACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Cuimhneachan tìodhlacaidh à Linn Ùr na Cloiche sa bheil seòmar cloiche am broinn torr chlachan.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CHAMBERED CAIRN</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">STALLED CAIRN</skos:altLabel>
		<skos:altLabel xml:lang="en">HEEL CAIRN</skos:altLabel>
		<skos:altLabel xml:lang="en">PASSAGE GRAVE</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1487" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1703" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500733">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500733</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">BARPA SEÒMARACH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Cuimhneachan tìodhlacaidh à Linn Ùr na Cloiche sa bheil torr creagach ceart-cheàrnach no trapasoideach sa bheil trannsa aig an dàrna cheann dheth le seòmraichean (no as an aonais) air a thaobh no co-dhiù aon seòmar nas lugha a ruigear o thaobh an torra.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">CHAMBERED LONG CAIRN</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-31T11:33:35</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-31T11:34:16</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1488" />
				<skos:scopeNote xml:lang="en">A Neolithic burial monument comprising a rectangular or trapezoidal stony mound which contains either a passage at one end with or without lateral chambers, or one or more smaller chambers entered from the side of the mound.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1491" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1495" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1727" />
		<skos:scopeNote xml:lang="en">A Neolithic burial monument comprising a stone-built chamber within a mound of stones.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1491">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1491</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CÀRN CEARCALLACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Càrn cearcallach le cùirt na mheadhan.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">RING CAIRN</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1487" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1488" />
		<skos:scopeNote xml:lang="en">A circular cairn with a central court.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1494">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1494</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CÀRN OIREACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Cuimhneachan ro-eachdraidheil a tha na thom ìseal no càrn chlachan mun a bheil oir chlachan agus a tha, mar is trice, nas àirde na an tom no an càrn e fhèin.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">KERB CAIRN</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1667" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/42" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1487" />
		<skos:scopeNote xml:lang="en">A prehistoric monument comprising a low mound or stone cairn ringed by a prominent kerb of stones, which is usually taller than the mound or cairn itself.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1495">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1495</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BARPA  CEÀRNAGACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Torr ceàrnagach de chlachan, gu tric le oir mun cuairt air, a chaidh a thogail os cionn tìodhlacaidh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SQUARE CAIRN</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1487" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1488" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1672" />
		<skos:scopeNote xml:lang="en">A square mound of stones, often bounded by a kerb, raised over a burial.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1497">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1497</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CÀRN CISTE-LAIGHE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Càrn far am b' urrainnear ciste-laighe a chur 's e ga ghiùlan gu àite-tìodhlacaidh 's an luchd-giùlain a' gabhail anail.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">COFFIN CAIRN</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-04-12T16:14:41</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1667" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1655" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501718" />
		<skos:scopeNote xml:lang="en">A cairn on which a coffin could be laid whilst being carried on its way to a burial, to allow the bearers to rest.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1499">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1499</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CLACH SHNAIGHTE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Clach a chaidh a sgeadachadh le dealbhaidhean snaidhte no comharran eile nach eil nàdarra. Cleachd briathar nas mionaidiche ma bhios sin iomchaidh. Cleachd CLACH SHNAIDHTE ma chaidh dealbhaidhean a shnaidheadh air loman no balla uamha.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CARVED STONE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-25T11:42:01</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">SCULPTURED STONE</skos:altLabel>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1500" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1504" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1501" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1503" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1502" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502028" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1660" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1721" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1505" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1556" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1910" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/588" />
		<skos:scopeNote xml:lang="en">A stone decorated with carved designs or other artificial markings. Use more specific term where applicable. Use ROCK CARVING when designs are carved on outcrop or a cave wall.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1500">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1500</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LEAC CROISE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Leac cloiche, na seasamh no na laighe, air an deach crois a sgrìobadh. Gheibhear seo ann an co-cheangal ri tìodhlacadh mar is trice. Ma tha comharran Cruithneach ann cuideachd, cuir LEAC SHNAIDHTE CHRUITHNEACH air a' chlàr-amais cuideachd.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CROSS SLAB</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-25T14:03:54</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">PICTISH CROSS SLAB</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1499" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1645" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1462" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1503" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1656" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1660" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502664" />
		<skos:scopeNote xml:lang="en">A slab of stone, either standing or recumbent, inscribed with a cross. Usually found in association with burials. If Pictish symbols are included, index as PICTISH SYMBOL STONE as well.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1501">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1501</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CLACH CUPA IS CEARCALL</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Clach air a bheil co-dhiù aon lagan a tha caran leth-chruinn is mun a bheil gròban fàinneach no beàrn-fhàinneach is co-mheadhanach. Chithear pàtranan nas toinnte cuideachd.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CUP AND RING MARKED STONE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-04-20T13:51:19</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1499" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502663" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1502" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502028" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502030" />
		<skos:scopeNote xml:lang="en">A stone bearing one or more small, roughly hemispherical depressions surrounded by a concentric arrangement of annular or penannular grooves. More complex designs may also occur.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1502">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1502</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CLACH CUPA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Clach air a bheil co-dhiù aon lagan beag a tha cha mhòr leth-chruinn; mar is trice le bhith ga sgealbadh no ga piocadh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CUP MARKED STONE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1499" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502663" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1501" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502028" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502030" />
		<skos:scopeNote xml:lang="en">A stone bearing one or more small, roughly hemispherical depressions, generally created by chipping or pecking.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1503">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1503</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CLACH SHNAIGHTE CHRUITHNEACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Clach air an deach comharran Cruithneach, mar bheathaichean, cruthan is pàtranan eas-chruthach, a shnaidheadh. Ma tha crois air cuideachd, cuir LEAC CROISE air a' chlàr-amais cuideachd.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PICTISH SYMBOL STONE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-25T10:40:14</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">PICTISH CROSS SLAB</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1499" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502664" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1500" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1769" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502029" />
		<skos:scopeNote xml:lang="en">A stone bearing Pictish symbols such as carved animals, figures and abstract designs. If a cross is included, index as CROSS SLAB as well.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1504">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1504</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">OBAIR-SNAIGHIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Cruth duine no dealbhadh a chaidh a shnaidheadh air clach. Cleachd briathar nas mionaidiche ma bhios gin iomchaidh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CARVING</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-11-18T12:49:20</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1499" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1556" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/507583" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1505" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502025">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502025</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">LORG-COISE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Lorg no oir-loidhne cas mac an duine air clach no loman creagach.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">FOOTPRINT</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-02T10:47:39</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-25T11:08:24</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:altLabel xml:lang="en">FOOT MARKED STONE</skos:altLabel>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1504" />
				<skos:scopeNote xml:lang="en">The mark or outline of a human footprint visible on stone or rock outcrop.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502145" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1910" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/588" />
		<skos:scopeNote xml:lang="en">A carved figure or design in stone. Use more specific term as appropriate.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1505">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1505</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">ÌOMHAIGH  SHNAIGHTE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Cruth duine no dealbhadh a chaidh a sgrìobadh air creag nàdarra no balla uamha.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ROCK CARVING</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-25T11:40:39</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1504" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502029" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502030" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502031" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502032" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502034" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1499" />
		<skos:scopeNote xml:lang="en">A figure or design cut into natural outcrop or a cave wall.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1515">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1515</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">GÀRRADH CÙL-CHINN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Dìg a tha na chrìoch eadar talamh àiteachais aig baile agus an t-ionaltradh bochd.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HEAD DYKE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/318" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1464" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1516" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/504824" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/524" />
		<skos:scopeNote xml:lang="en">A dyke used to separate the agricultural land of a township from rough grazing.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1516">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1516</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BALLA-TREAB</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Balla-ùir loidhneach ro-eachdraidheil nach fhaighear ach sna h-Eileanan a Tuath.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TREB DYKE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
