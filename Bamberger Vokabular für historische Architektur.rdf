        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-18T13:42:19.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-27T17:32:03.000</terms:modified>
        <skos:altLabel xml:lang="fr">plafond bordé de moulures</skos:altLabel>
        <skos:altLabel xml:lang="cs">zrcadlová klenba</skos:altLabel>
        <skos:definition xml:lang="de">Eine Decke, deren mittleres Feld (Deckenspiegel) von Profilen gerahmt ist. Der Übergang zur Wand erfolgt mittels Kehlen (Deckenkehle, Voute) oder mit einem Deckengesims. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Spiegeldecke</skos:prefLabel>
        <skos:prefLabel xml:lang="es">cielo raso bordeado de molduras</skos:prefLabel>
        <skos:prefLabel xml:lang="en">mirrored ceiling</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">plafond en arcde cloître</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">rovová klenba</skos:prefLabel>
    </owl:NamedIndividual>
    


