<http://www.eionet.europa.eu/gemet/concept/6143> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8047> ;
    skos:closeMatch <http://data.uba.de/umt/_00050893> ;
    skos:definition "A norm or measure applicable in legal cases pertaining to the production, dissemination or use of substances designed to mitigate or eliminate insects or small animals that harm vegetation."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Schädlingsbekämpfungsnorm"@de,
        "pesticide control standard"@en .

<http://www.eionet.europa.eu/gemet/concept/6144> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6402> ;
    skos:closeMatch <http://data.uba.de/umt/_00050894> ;
    skos:definition "The specific or known route or vector of any chemical substance released into the environment to prevent, destroy or mitigate any pest that is directly or indirectly detrimental to harvest crops and other human interests."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Pestizidpfad"@de,
        "pesticide pathway"@en .

<http://www.eionet.europa.eu/gemet/concept/6146> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7156> ;
    skos:closeMatch <http://data.uba.de/umt/_00019108> ;
    skos:definition "A pesticide remaining in the environment for a fairly long time, continuing to be effective for days, weeks, and months."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/3469> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Pestizidrückstand"@de,
        "residual pesticide"@en .

<http://www.eionet.europa.eu/gemet/concept/6149> a skos:Concept ;
