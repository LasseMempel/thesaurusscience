		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk009698"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk009698"/>
		<skos:definition xml:lang="de">Ein Zylinder ist ein Hut, der eine hohe, zylindrische Form mit einer festen, gewölbten Krempe besitzt. Er wird klassischerweise in Schwarz gefertigt und besteht traditionell aus Filz, Seide oder Seidenplüsch.</skos:definition>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q110304"/>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300046113"/>
		<skos:exactMatch rdf:resource="https://d-nb.info/gnd/4373143-0"/>
