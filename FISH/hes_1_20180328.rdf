	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/123">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/123</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">ÀIRIGH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Ionaltradh bràighe a chaidh crodh iomain ann a-rèir na ràithe. Cleachd BOTHAN ÀIRIGH airson structaran a tha co-cheangailte ri àirigh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SHIELING</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/98" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/31" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501051" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/524" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/9" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/99" />
		<skos:scopeNote xml:lang="en">Upland pasture to which animals were driven on a seasonal basis. For structures associated with shielings use SHIELING HUT.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/124">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/124</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAC BHEAG</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Tac a tha nas lugha na tuathanas.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SMALLHOLDING</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/98" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/45" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501712" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/99" />
		<skos:scopeNote xml:lang="en">A holding on a smaller scale than a farm.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/127">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/127</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">VILLA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Ainm air diofar thaighean a-rèir na linne. Bhitheadh villas nan taighean-baile dealaichte gu tric ann an linn Rìgh Sheòrais agus às a dhèidh sinn ach ann an linn an Ròmanach bhitheadh villas nan taighean àrd-inbheach air an dùthaich aig an robh fearann a ghnàth.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">VILLA</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/98" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/422" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/100" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/452" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/99" />
		<skos:scopeNote xml:lang="en">A term for a type of house, with varying definitions according to period. Georgian and later period villas were often detached town houses, whereas Roman villas were high-status and usually associated with a rural estate.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/128">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/128</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">SITIG</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Dùnan sgudail, mar is trice co-cheangailte ri togalach no tuineachadh.</skos:scopeNote>
