    <!-- https://hist-arch-vocab.org/bvha#c_32a962f6 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_32a962f6">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_eea5235b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_57442c81"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-16T15:30:13.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-07T14:16:44.000</terms:modified>
        <skos:altLabel xml:lang="de">Mauerbogen</skos:altLabel>
        <skos:altLabel xml:lang="de">Versteifungsbogen</skos:altLabel>
        <skos:altLabel xml:lang="fr">arc de renfort</skos:altLabel>
        <skos:altLabel xml:lang="en">discharging arch</skos:altLabel>
        <skos:definition xml:lang="de">Im Mauerwerk über Wandöffnungen liegender Bogen, der einen Fenster- oder Türsturz oder auch einen anderen Bogen überspannt und die auf ihm liegende Last abfängt. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Im Unterschied zu dem einer Mauer aufgelegten Blendbogen ein in der Mauer liegender, gemauerter, konstruktiver Bogen zur Lastabtragung über einer Maueröffnung. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Entlastungsbogen</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">arc de décharge</skos:prefLabel>
        <skos:prefLabel xml:lang="en">relieving arch</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_eea5235b"/>
    </owl:NamedIndividual>
    


