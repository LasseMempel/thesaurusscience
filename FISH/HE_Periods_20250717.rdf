    <time:hasBeginning xml:lang="en">-0800</time:hasBeginning>
    <time:hasEnd xml:lang="en">0043</time:hasEnd>
    <skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/IA"/>
    <skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/11/concepts/505125"/>
    <skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300019279"/>
    <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_period"/>
    <dc:identifier>http://purl.org/heritagedata/schemes/eh_period/concepts/IA</dc:identifier>
    <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-17T16:46:30</dc:issued>
    <cc:license rdf:resource="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"/>
    <cc:attributionURL rdf:resource="https://historicengland.org.uk/"/>
    <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
    <dc:publisher rdf:resource="https://historicengland.org.uk/"/>
    <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
    <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
    <skos:prefLabel xml:lang="en">Iron Age</skos:prefLabel>
    <skos:scopeNote xml:lang="en">This period follows on from the Bronze Age and is characterized by the use of iron for making tools and monuments such as hillforts and oppida. The Iron Age is taken to end with the Roman invasion. Circa -800 BCE to 43 CE.</skos:scopeNote>
    <skos:notation xml:lang="en">IA</skos:notation>
  </skos:Concept>

