	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/363">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/363</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CAMPA PHRÌOSANACH COGAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach prìosain far an cumar buill-sheirbheise a chaidh an glacadh ann an cogadh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PRISONER OF WAR CAMP</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/361" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/167" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/351" />
		<skos:scopeNote xml:lang="en">A prison site for the containment of servicemen captured in war.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/364">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/364</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CAMPA SEALACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Campa oidhche daingnichte am broinn dìge eu-domhain, uchdan agus sonnaich, air a thogail le feachd Ròmanach air iomairt no eacarsaich.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TEMPORARY CAMP</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/361" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/2322" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/347" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/362" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/398" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500482" />
		<skos:scopeNote xml:lang="en">A fortified overnight camp enclosed within a shallow ditch, bank and palisade, constructed by Roman troops on campaigns or manoeuvres.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/365">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/365</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">PRÌOMH-OIFIS AN AIRM</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Ionad-stiùiridh gnìomhachdan an airm.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MILITARY HEADQUARTERS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/360" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/507402" />
		<skos:scopeNote xml:lang="en">The command centre of military operations.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/366">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/366</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CABHSAIR AIRM</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Rathad no ceum os cionn talmhainn ìseal, fliuch no garbh mun cuairt air a chaidh a thogail gu sònraichte airson adhbharan armailteach.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MILITARY CAUSEWAY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1796" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/354" />
		<skos:scopeNote xml:lang="en">A road or pathway raised above surrounding low, wet or uneven ground, and constructed and used for a primarily military purpose.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/367">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/367</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">STÒR AIRM</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach no grunn thogalaichean, gu math tric le rian daingneachaidh mun cuairt orra, a tha ga chleachdadh le feachd airson acainnean an airm a stòradh 's a sgaoileadh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MILITARY DEPOT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/368" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/354" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/184" />
		<skos:scopeNote xml:lang="en">A building or group of buildings, often enclosed by a system of fortifications, used by an armed force for the storage and distribution of military equipment.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/368">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/368</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">STÒR ARMACHD</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach an airm far an cumar airm agus connadh-gunna.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ARMAMENT DEPOT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">MUNITIONS DEPOT</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/367" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/369" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/357" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/371" />
		<skos:scopeNote xml:lang="en">A military building used for the storage of weapons and ammunition.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/369">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/369</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">ARMLANN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite far a bheilear a' cumail buill-airm.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ARMOURY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/368" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/350" />
		<skos:scopeNote xml:lang="en">A place where weapons are kept.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/371">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/371</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">ARMLANN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach far a bheilear a' stòradh buill-airm, connadh-gunna is biadh airson feachdan an airm.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MAGAZINE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/372">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/372</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TAIGH-FÙDAIR</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Àite far a bheilear a' stòradh mòran fùdair-ghunna 's stuthan-spreadhaidh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">POWDER MAGAZINE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:altLabel xml:lang="en">POWDER HOUSE</skos:altLabel>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/371" />
				<skos:scopeNote xml:lang="en">A place in which gunpowder and other explosives are stored in large quantities.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/368" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/667" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/706" />
		<skos:scopeNote xml:lang="en">A building in which a supply of arms, ammunition and provisions for armed forces is stored.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/374">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/374</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÀRACH FAIRE AIRM</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalaichean, structaran is làraichean leis am mothaichear do nàmhaid a' tighinn dlùth.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MILITARY OBSERVATION SITE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/377" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/278" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/378" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/277" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500626" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/501700">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/501700</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">RAINNSE-FUAIM FO UISGE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Sreath de mhicreofonaichean is mothaichearan fon uisge a chleachdar gus nàdar fuaimearra de longan-cogaidh is bàtaichean-tumaidh fhiosrachadh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">UNDERWATER NOISE RANGE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-04-12T13:05:38</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-04-12T13:06:44</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/374" />
				<skos:scopeNote xml:lang="en">A series of underwater microphones and sensors used to determine the acoustic signature of warships and submarines.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502185" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502171" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/503540">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/503540</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">IONAD-FAIRE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Togalach no làrach far am faigh luchd-obrach an airm no luchd-obrach catharra (a tha a' cumail smachd air na thig a-steach no a thèid a-mach aig làraichean an airm no an riaghaltais) àite-fuirich.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">SENTRY POST</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-03T11:52:26</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-10-06T15:34:01</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/374" />
				<skos:scopeNote xml:lang="en">A building or site used for the accommodation of military or civilian personnel controlling access to and from military or government property.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/2303" />
		<skos:scopeNote xml:lang="en">Buildings, structures and sites for the detection of encroaching enemy forces.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/377">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/377</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">IONAD-FAIRE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach no làrach airson sùil a chumail air gnìomhachdan sònraichte an airm no gluasad feachdan nàmhad is msaa.</skos:scopeNote>
