  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91744">
    <skos:scopeNote xml:lang="en">Horizontal masonry or timber work at the entrance to a dock.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91887">
    <skos:scopeNote xml:lang="en">A house built using experimental building techniques and materials.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70097">
    <skos:scopeNote xml:lang="en">A late Neolithic/Early Bronze Age earthwork enclosure distinguished from a henge primarily by its larger size, irregular shape, and greater complexity of internal features.</skos:scopeNote>
  </rdf:Description>
