        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T20:09:58.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-27T09:20:49.000</terms:modified>
        <skos:altLabel xml:lang="de">Schildgurt</skos:altLabel>
        <skos:altLabel xml:lang="it">arco perimetrale</skos:altLabel>
        <skos:altLabel xml:lang="en">wall arch</skos:altLabel>
        <skos:altLabel xml:lang="en">wall rib</skos:altLabel>
        <skos:altLabel xml:lang="cs">čelní pás (klenby)</skos:altLabel>
        <skos:altLabel xml:lang="cs">čelo klenby</skos:altLabel>
        <skos:definition xml:lang="de">Der Bogen am Anschluss eines Gewölbes an die Mauer (Schildwand). [Koepf /Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Der Bogen, der sich bei der Verschneidung von Gewölbe- und Wandfläche bildet, begrenzt das Joch seitlich und ist häufig durch einen Längsgurt oder eine Schildrippe markiert. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Im Anlauf eines Kreuz- oder Tonnengewölbes auf eine Wand entstehender Bogen. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="cs">Oblouk, který vznikne rozříznutím plochy klenby a stěny, vymezuje klenební pole po straně a bývá. často vyznačen podélným pásem nebo čelním žebrem. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Schildbogen</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">arc formeret</skos:prefLabel>
        <skos:prefLabel xml:lang="es">arco en nicho</skos:prefLabel>
        <skos:prefLabel xml:lang="it">arco laterale</skos:prefLabel>
        <skos:prefLabel xml:lang="en">formeret</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">čelní oblouk</skos:prefLabel>
        <broaderByPosition rdf:resource="https://hist-arch-vocab.org/bvha#c_eea5235b"/>
    </owl:NamedIndividual>
    


