    <skos:scopeNote xml:lang="en">A free-standing cross made of stone in the form of a cross with a ring surrounding the intersection. Often used as a grave marker</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143502">
