        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-15T14:48:57.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-15T14:49:45.000</terms:modified>
        <skos:definition xml:lang="de">Verbindungsart von meist im rechten Winkel aneinanderstoßenden Brettern und Leisten, z.B. Futterteilen. Die Schwalben des einen Futterteils werden in die Zinken des anderen Futterteils eingepaßt. [Pax - Fenster &amp; Türen Fachbegriffe]</skos:definition>
        <skos:prefLabel xml:lang="de">Verzinkung (Fenster)</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_e7101127 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_e7101127">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
