				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-07-19T07:17:02</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:56:41</dcterms:issued>
				<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/2/concepts/501127" />
				<skos:scopeNote xml:lang="en">This is the top term for the class covering objects forming fragments or parts of a building's fabric, structures and associated services, eg drain pipes. Where an object is a fixture or fitting use the separate class. See ARCHITECTURE Class List for narrow terms.</skos:scopeNote>
