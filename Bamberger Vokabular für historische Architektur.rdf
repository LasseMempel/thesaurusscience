        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_5f7da97c"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-12T11:02:48.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-06T15:02:33.000</terms:modified>
        <skos:definition xml:lang="de">Dekorative Marmoreinlegearbeit unter Verwendung von Mosaiksteinen, Glas und Goldauflage in der ital. Baukunst des 12.-14. Jhs., an antike Vorbilder anknüpfend von den magistri cosmacini zur höchsten Pracht entfaltet. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Inkrustace mramorem této skupiny umělců 12.-14. stol. se nacházejí v Římě, Neapoli a okolí, u jejich signatur se často vyskytuje jméno Cosmas. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Marmorinkrustationen einer Künstlergruppe des 12.-14. Jhs. in und um Rom und Neapel, bei deren Signaturen der Name Cosmas häufig auftritt. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Cosmaten-Arbeit</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kosmaté</skos:prefLabel>
    </owl:NamedIndividual>
    


