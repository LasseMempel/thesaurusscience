        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T13:04:25.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-12T17:02:35.000</terms:modified>
        <skos:altLabel xml:lang="en">stepped pyramid</skos:altLabel>
        <skos:definition xml:lang="de">Abgestufte Pyramide. S.n kommen in Ägypten, Mesopotamien (Zikkurat), Hinterindien (Prang) und bei den altamerikan. Kulturen vor. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Stufenpyramide</skos:prefLabel>
        <skos:prefLabel xml:lang="it">piramide a gradini</skos:prefLabel>
        <skos:prefLabel xml:lang="es">pirámide escalonada</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">pyramide à gradins</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">stupňovitá pyramida, zikurat</skos:prefLabel>
        <skos:prefLabel xml:lang="en">ziggurat</skos:prefLabel>
    </owl:NamedIndividual>
    


