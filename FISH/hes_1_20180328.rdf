		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/470" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/496" />
		<skos:scopeNote xml:lang="en">A small building used by huntsmen to store equipment and as temporary lodgings.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
