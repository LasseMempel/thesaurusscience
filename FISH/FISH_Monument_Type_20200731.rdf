  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140776">
    <skos:scopeNote xml:lang="en">A railway yard with associated buildings used for the maintenance and storage of locomotive engines and rolling stock.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92243">
    <skos:scopeNote xml:lang="en">A temporary fence of boards, often enclosing a building on which posters and bills are attached.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68586">
    <skos:scopeNote xml:lang="en">A pond or pool with arms covered with nets into which wild birds, are lured and then caught. Monument type includes water feeder channels.</skos:scopeNote>
  </rdf:Description>
