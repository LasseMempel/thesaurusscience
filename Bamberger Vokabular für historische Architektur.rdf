        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T16:10:36.000</terms:modified>
        <skos:altLabel xml:lang="de">Polsterbuckelquader </skos:altLabel>
        <skos:definition xml:lang="de">Buckelquader mit einer kissenförmig bearbeiteten Oberfläche, die nur gering vorspringt und eine aufwändige Steinbearbeitung erfordert. Bedeutendes Beispiel einer Burg mit K. ist der Trifels RP; wird mitunter auch als Polsterbuckelquader bezeichnet. J. Z. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:prefLabel xml:lang="de">Kissenbuckelquader</skos:prefLabel>
    </owl:NamedIndividual>
    


