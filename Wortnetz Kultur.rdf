	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021241">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">apothecary bottle</skos:prefLabel>
		<skos:altLabel xml:lang="en">apothecary bottles</skos:altLabel>
		<skos:altLabel xml:lang="de">Apothekenflasche</skos:altLabel>
		<skos:altLabel xml:lang="de">Apothekenfläschen</skos:altLabel>
		<skos:altLabel xml:lang="de">Apothekenflaschen</skos:altLabel>
		<skos:prefLabel xml:lang="de">Apothekerflasche</skos:prefLabel>
		<skos:altLabel xml:lang="de">Apothekerflaschen</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004610"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk019046"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004610"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk019046"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk007493"/>
		<skos:definition xml:lang="de">Eine Apothekerflasche ist eine Flasche, die historisch in Apotheken und Laboren zur Aufbewahrung von Arzneimitteln und Chemikalien verwendet wurde. Sie ist meist aus dickwandigem, braunem oder klarem Glas gefertigt, zylindrisch oder vierkantig mit kurzem Hals und wird oft mit einem Stopfen aus Glas oder Kork verschlossen. Typischerweise hat sie ein Volumen zwischen 50 und 500 ml. Der Name der enthaltenen Substanz steht üblicherweise auf dem Glaskörper.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300378929"/>
		<skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q63813700"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019046"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004610"/>
