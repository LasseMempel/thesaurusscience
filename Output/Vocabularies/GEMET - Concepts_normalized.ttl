    skos:closeMatch <http://data.uba.de/umt/_00021448> ;
    skos:definition "The physical, chemical or biological breakdown of a complex polluting material into simpler components."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Schadstoffabbau"@de,
        "pollutant degradation"@en ;
