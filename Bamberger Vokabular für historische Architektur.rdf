        <skos:prefLabel xml:lang="it"> capitello a fungo</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Pilzkapitell</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">hřibová hlavice</skos:prefLabel>
    </owl:NamedIndividual>
    


