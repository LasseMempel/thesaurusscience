    <!-- https://hist-arch-vocab.org/bvha#c_ea442afc -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_ea442afc">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1df9f722"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_5bf6bcac"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_bdc53f59"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-20T17:49:14.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-18T14:09:45.000</terms:modified>
        <skos:definition xml:lang="de">(1) Auftragen eines Lacküberzuges. (2) Direktes Einfärben in geeigneten Färbelösungen nach festgelegten Rezepturen. Besonders Kupfer und Kupferlegierungen, aber auch Stahl, Aluminium, Zink und Zinn werden zum Färben herangezogen. Einige wichtige Verfahren sind die Altsilberfärbung, Barbediennefärbung und das Brünieren. [Schrader / Voigt 2003]</skos:definition>
        <skos:prefLabel xml:lang="de">Metallfärbung</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_ea481c5c -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_ea481c5c">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
