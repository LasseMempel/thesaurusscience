    <!-- https://hist-arch-vocab.org/bvha#c_ff1964fa -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_ff1964fa">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
