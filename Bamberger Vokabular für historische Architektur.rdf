        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T11:24:25.000</terms:modified>
        <skos:definition xml:lang="de">Schwelle im Quer- bzw. Längsbund unter Stuhständern oder Stuhlstreben. [Eißing et al. 2012]</skos:definition>
        <skos:definition xml:lang="de">Waagerechtes, rechtwinklig auf den Dachbalken verlaufendes Holz, das die Druckkräfte von Stuhlsäulen auf mehrere Balken überträgt. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Stuhlschwelle</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_60639975 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_60639975">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_wdriolje"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-07T18:06:30.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T15:53:58.000</terms:modified>
        <skos:altLabel xml:lang="de">Berapp</skos:altLabel>
        <skos:altLabel xml:lang="de">Grob(ver)putz</skos:altLabel>
        <skos:altLabel xml:lang="de">Rauhputz</skos:altLabel>
        <skos:altLabel xml:lang="de">Strukturputz</skos:altLabel>
        <skos:altLabel xml:lang="fr">crépissure</skos:altLabel>
        <skos:altLabel xml:lang="cs">drsná omítka</skos:altLabel>
        <skos:altLabel xml:lang="it">intonaco rustico</skos:altLabel>
        <skos:altLabel xml:lang="en">pebbledash</skos:altLabel>
        <skos:altLabel xml:lang="en">rough plaster</skos:altLabel>
        <skos:altLabel xml:lang="en">roughcast plaster</skos:altLabel>
        <skos:definition xml:lang="en">Decorative surface and protective coating with a very rough surface, mainly used for exterior walls. [EwaGlos]</skos:definition>
        <skos:definition xml:lang="de">Dekorative Oberfläche und Schutzschicht mit einer sehr rauen Oberfläche, hauptsächlich für Außenwände. [EwaGlos]</skos:definition>
        <skos:definition xml:lang="de">Putz mit rauer Oberfläche durch Verwendung grobkörniger Zuschlagstoffe oder auch durch spätere künstl. Aufrauung (Spritz- oder Graupelputz, Besenputz). Der R. dient meist als Unterputz (Anwurf), auf dem der Feinputz aufgetragen wird. [Koepf/Binding 2016] </skos:definition>
        <skos:prefLabel xml:lang="de">Rauputz</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">crépi</skos:prefLabel>
        <skos:prefLabel xml:lang="es">enlucido áspero</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">hrubá omítka</skos:prefLabel>
        <skos:prefLabel xml:lang="en">rough cast</skos:prefLabel>
    </owl:NamedIndividual>
    


