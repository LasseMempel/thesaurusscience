        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T15:08:21.000</terms:modified>
        <skos:definition xml:lang="de">Prälat m; lat. praelatus: in der kath. Kirche Titel eines hohen geistlichen Würdenträgers, z. B. Bischof oder Abt, Inhaber eines hohen Ehrenamtes der römischen Kurie oder Träger eines vom Papst verliehenen Ehrentitels. Seine Rangfarbe ist Violett bzw. Magenta. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Prälat (katholisch)</skos:prefLabel>
        <skos:prefLabel xml:lang="la">praelatus</skos:prefLabel>
        <skos:prefLabel xml:lang="en">prelate</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">prélat</skos:prefLabel>
    </owl:NamedIndividual>
    


