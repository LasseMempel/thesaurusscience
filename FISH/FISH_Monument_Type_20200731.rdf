  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68818">
    <skos:scopeNote xml:lang="en">A fortified tower designed to house a number of artillery pieces and a small garrison. Artillery towers first appear in England in the 16th century.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/151827">
    <skos:scopeNote xml:lang="en">An impression made in soft ground by a passing animal or human. The soft ground may have subsequently hardened.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159196">
    <skos:scopeNote xml:lang="en">A planned, self-contained, community incorporating green open spaces and containing housing, industrial and agricultural zones.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91181">
    <skos:scopeNote xml:lang="en">A place of worship for Bible Christians, a group who split from the Wesleyan Methodists to form their own church in the South West of England. They were amalgamated into the United Methodist Church in 1907.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69092">
    <skos:scopeNote xml:lang="en">A structure, composed of oven and hovel, used for the firing of pottery ware.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143533">
    <skos:scopeNote xml:lang="en">A building or site used to assess the mechanical state of a vehicle.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69939">
    <skos:scopeNote xml:lang="en">A building occupied by a club or commonly used for club activities.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71637">
    <skos:scopeNote xml:lang="en">A complex of buildings using Radar or satellite tracking to monitor and detect enemy missile launches early enough to allow a counterattack or defensive measures to be taken.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70089">
    <skos:scopeNote xml:lang="en">A subrectangular earthen enclosure defined by a ditch, usually with an internal bank, assumed to have been used for the primary exposure or burial of human remains in the Neolithic period prior to secondary burial elsewhere.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143539">
    <skos:scopeNote xml:lang="en">A venue, with a boxing ring and associated facilities, which is used to train for and undertake amateur or professional boxing.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143003">
    <skos:scopeNote xml:lang="en">An Iron Age round defended house, found mainly in the north and west of Scotland. Brochs have a tapering profile and thick, usually hollow dry stone walls which contain galleries, cells and a stairway, with guard cells at the entrance.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93318">
    <skos:scopeNote xml:lang="en">A plantation of shrubs.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160511">
    <skos:scopeNote xml:lang="en">A shelter on a firing range from which the wepaons testing can be viewed in safety.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70700">
    <skos:scopeNote xml:lang="en">A rampart or other defensive entrenchment.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70608">
    <skos:scopeNote xml:lang="en">A structure extending into the sea for the purpose of preventing further movement of washed up sand and shingle.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71579">
    <skos:scopeNote xml:lang="en">A purpose-built dwelling for the manager of a factory, works, textile mill, etc, often found within the complex itself.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69318">
    <skos:scopeNote xml:lang="en">A small workshop, employing up to 10 men, working on hand-operated carding engines and hand jennies, spinning yarn for handloom weavers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93523">
    <skos:scopeNote xml:lang="en">An optical instrument for making distant objects appear nearer and larger, often found on the promenade or pleasure pier at a seaside resort or at a site of scenic beauty.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69141">
    <skos:scopeNote xml:lang="en">A building or buildings used for the manufacture of candles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70551">
    <skos:scopeNote xml:lang="en">Sites, buildings, structures, features &amp; areas of land associated with sport, leisure &amp; entertainment. Includes sports grounds, hunting forests, cinemas, theatres etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/129043">
    <skos:scopeNote xml:lang="en">A pit used for the prolonged steeping of the flax plant in water to separate the fibres from the wood.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143376">
    <skos:scopeNote xml:lang="en">Non-specific building type associated with an airfield.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167072">
    <skos:scopeNote xml:lang="en">A site used for the safe storage of the art held in the national collections. During the Second World War many paintings, sculptures and works of art were moved to modified mines for safe keeping to protect them against bomb damage.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92867">
    <skos:scopeNote xml:lang="en">A small paved area attached to a building.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141889">
    <skos:scopeNote xml:lang="en">A temporary settlement or shanty-town erected by railway construction workers or "navvys".</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91346">
    <skos:scopeNote xml:lang="en">A factory where preserved food is canned.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69277">
    <skos:scopeNote xml:lang="en">A small dwelling providing living accommodation for a tin miner.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71594">
    <skos:scopeNote xml:lang="en">Workshop for the manufacture of master parts from working drawings which are then used as patterns for mass manufacture.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93522">
    <skos:scopeNote xml:lang="en">An optical instrument for making distant objects appear nearer and larger, usually found at an observatory, through which astronomical or meteorological phenomena may be observed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69071">
    <skos:scopeNote xml:lang="en">A place where sandstone is excavated.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93074">
    <skos:scopeNote xml:lang="en">A mill in which textile rags were ground, either to enable the fibres to be respun or to use the pulp in the manufacture of paper.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91594">
    <skos:scopeNote xml:lang="en">A steam engine that uses the same steam successively to drive pistons in high and then low pressure cylinders.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71788">
    <skos:scopeNote xml:lang="en">An endowed school providing a liberal education for such as can afford it.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/103212">
    <skos:scopeNote xml:lang="en">A column, in the form of a female figure, used to support an entablature.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91636">
    <skos:scopeNote xml:lang="en">An informal garden attached to a cottage where flowers, vegetables and fruit trees are grown.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71300">
    <skos:scopeNote xml:lang="en">A mill used for the processing of tin ore by crazing, stamping or smelting.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160228">
    <skos:scopeNote xml:lang="en">A gun emplacement which conforms to Department of Fortification and Works drawing number 55415.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159265">
    <skos:scopeNote xml:lang="en">A body of water, building or structure found in a park or garden used as a water supply or ornament. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91301">
    <skos:scopeNote xml:lang="en">The premises of a builders merchant where building materials such as stone, cement, bricks, tiles and timber could be bought.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142989">
    <skos:scopeNote xml:lang="en">A privately-funded home for the care of the elderly.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/151826">
    <skos:scopeNote xml:lang="en">A small cold water bath, often known as a natatio when part of a Roman bath complex.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92927">
    <skos:scopeNote xml:lang="en">A vertical, pointed structure usually resembling a pyramid or cone. Use for component of a larger building type where it is now used as a freestanding ornament.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160370">
    <skos:scopeNote xml:lang="en">A concrete, cylindrical pedestal on which a spigot mortar was mounted. The pedestal is often the only evidence for a Spigot Mortar emplacement to survive.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69453">
    <skos:scopeNote xml:lang="en">An enclosure in which ships are built and repaired, and all sorts of ships' stores are brought together.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68640">
    <skos:scopeNote xml:lang="en">Grassland fertilized by allowing floodwater to cover it in winter.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/130193">
    <skos:scopeNote xml:lang="en">A mill used for the manufacture of walking sticks.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92862">
    <skos:scopeNote xml:lang="en">A building or cage in which parrots are bred and kept.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/86501">
    <skos:scopeNote xml:lang="en">Originally a large tract of wooded country, owned by the Monarchy, for the purpose of hunting. The royal parks of London, eg. Greenwich, are all open to the public and have been for centuries.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68791">
    <skos:scopeNote xml:lang="en">A separate residence for guests, a house on a private estate or a monastery building specifically for receiving visitors.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94083">
    <skos:scopeNote xml:lang="en">A hole in the ground which has been created by driving or hammering an upright stake into the ground. As a feature of some archaeological sites they may often represent the only surviving evidence for the former presence of an above-ground structure.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91767">
    <skos:scopeNote xml:lang="en">A range of buildings used to house abandoned or stray dogs.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91053">
    <skos:scopeNote xml:lang="en">When secondary product use with major product and MINE, eg. COPPER MINE.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160505">
    <skos:scopeNote xml:lang="en">A house which has been altered to increase its defensive characteristics.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/151881">
    <skos:scopeNote xml:lang="en">A burial ground for victims of cholera.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/169962">
    <skos:scopeNote xml:lang="en">A chapel for a prison, either attached or in a separate building.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/88482">
    <skos:scopeNote xml:lang="en">A shed in which delicate plants are reared from seedlings for planting out later.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91032">
    <skos:scopeNote xml:lang="en">A place where ambulances are serviced and maintained.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143482">
    <skos:scopeNote xml:lang="en">A large tract of land covered with trees and interspersed with open areas of land. Traditionally forests were owned by the monarchy and had their own laws.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69240">
    <skos:scopeNote xml:lang="en">A marker stone showing the extent of a measure of land containing a vein of ore.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68829">
    <skos:scopeNote xml:lang="en">A temporary fieldwork, usually a few feet in height, constructed for defence against enemy forces.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87802">
    <skos:scopeNote xml:lang="en">A high building at an airport from which air traffic is controlled by radio.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/97466">
    <skos:scopeNote xml:lang="en">A hospital department concerned with the reconstruction or repair of parts of the human body using transferred tissue, either in the treatment of injury or for cosmetic reasons.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/151875">
    <skos:scopeNote xml:lang="en">A rural cross erected to show the way.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142018">
    <skos:scopeNote xml:lang="en">A building or site used for the manufacture of whiting either from crushed chalk, limestone, marble or through chemical preparation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70809">
    <skos:scopeNote xml:lang="en">A long, wooden, metal or stone vessel holding drinking water for horses.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92144">
    <skos:scopeNote xml:lang="en">A path covered in a layer of water-worn or pounded stones.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159202">
    <skos:scopeNote xml:lang="en">A structure composed of two large upright stone supporting a third, lintel stone.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92260">
    <skos:scopeNote xml:lang="en">A specially marked ground used by children for the game of hopscotch.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70374">
    <skos:scopeNote xml:lang="en">The slab or place on which a fire is made.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160366">
    <skos:scopeNote xml:lang="en">A site, usually with an airfield, hangars and control buildings, used for the storage and deployment of military aircraft or the administration of the Royal Air Force. May also include accommodation buildings for personnel.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69260">
    <skos:scopeNote xml:lang="en">The place where metallic ores were crushed and washed to remove waste, forming a concentrate which could be used in a smelter.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143811">
    <skos:scopeNote xml:lang="en">Mine for the extraction of bismuth, which usually occurs in small quantities in the ores of other metal ores, particularly lead, and some copper ores.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92800">
    <skos:scopeNote xml:lang="en">An excavation open to the sky, caused by the extraction of coal, stone or similar. Use with product type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93758">
    <skos:scopeNote xml:lang="en">A place where watches and timepieces are manufactured and mended.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71652">
    <skos:scopeNote xml:lang="en">A specialist hospital for the medical and surgical treatment of children.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/90116">
    <skos:scopeNote xml:lang="en">A residential establishment for the care and accommodation of children and young people.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140154">
    <skos:scopeNote xml:lang="en">A building used for a variety of administrative purposes, usually at a naval dockyard.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70363">
    <skos:scopeNote xml:lang="en">An enclosure where the boundary consists of a line of discrete pits, as opposed to a continuous ditch. Use with a term that describes the shape of the monument.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68781">
    <skos:scopeNote xml:lang="en">A cheap eating and drinking establishment usually serving snacks and non-alcoholic drinks.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70375">
    <skos:scopeNote xml:lang="en">A mechanical lift or elevator, used to lift goods, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143444">
    <skos:scopeNote xml:lang="en">A building, usually housing electrical or electronic equipment, used for gathering and disseminating information. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140237">
    <skos:scopeNote xml:lang="en">A monument consisting of an area enclosed by a ditch, bank, wall, palisade or similar barrier, where the barrier follows an almost rectangular course.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93621">
    <skos:scopeNote xml:lang="en">The entrance to a tramway tunnel.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68947">
    <skos:scopeNote xml:lang="en">The rural residence of a country gentleman.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69469">
    <skos:scopeNote xml:lang="en">A waterside depot for coals brought from the collieries for shipment, furnished with staging and chutes for loading vessels.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68979">
    <skos:scopeNote xml:lang="en">A monument consisting of a small (generally less than 100m diameter) subcircular enclosure with a narrow approach way consisting of parallel ditches (thus banjo shaped). Believed to be associated with stock management in the Later Prehistoric period.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70002">
    <skos:scopeNote xml:lang="en">A Neolithic burial monument comprising a stone-built chamber within an earthen mound. Use more precise term where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99570">
    <skos:scopeNote xml:lang="en">A chemical works engaged in the manufacture of the coal tar derivative, picric acid, often associated with the textile industry where it was used as a dye, but more commonly with the explosives industry where it was used as the shell filling Lyddite.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140630">
    <skos:scopeNote xml:lang="en">A building where advice and aid appertaining to physical and economic wellbeing of disadvantaged members of a community are made available.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68854">
    <skos:scopeNote xml:lang="en">A site used primarily for domestic purposes on at least a semi-permanent or seasonal basis, and which has been surrounded by a bank and ditch, palisade, or some other form of enclosure. Use more specific type(s) where appropriate.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/139027">
    <skos:scopeNote xml:lang="en">A building or site used for the production of anchors.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/168344">
    <skos:scopeNote xml:lang="en">A factory making baize for snooker and gaming tables.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91730">
    <skos:scopeNote xml:lang="en">A group of buildings, or part of a works, housing apparatus used in the process of distilling.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71422">
    <skos:scopeNote xml:lang="en">A slight structure built for shelter or storage, or for use as a workshop, either attached as a lean-to to a permanent building or separate. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68706">
    <skos:scopeNote xml:lang="en">Traditionally, the hall of a crafts, trade, or merchants' guild. Nowadays, often used to describe a TOWN HALL.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92760">
    <skos:scopeNote xml:lang="en">A place of worship for members of Protestant sects dissenting from the established Church.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/152568">
    <skos:scopeNote xml:lang="en">Buildings used in the production of animal food.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93132">
    <skos:scopeNote xml:lang="en">Model village built as a holiday resort.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93419">
    <skos:scopeNote xml:lang="en">A building housing a steam engine.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69304">
    <skos:scopeNote xml:lang="en">Mill for grinding bark usually for use in the tanning industry. Use with power type(s), eg. WATERMILL where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87705">
    <skos:scopeNote xml:lang="en">A large wooden gate, positioned at either end of a canal or river lock, equipped with sluices to let water through.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160220">
    <skos:scopeNote xml:lang="en">A centre used by the Air Raid Precautions network to co-ordinate reports of air raids in an area.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70014">
    <skos:scopeNote xml:lang="en">A form of round barrow intermediate between the Bell Barrow and the Disc Barrow. Only use where it is not possible to determine specific type.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93062">
    <skos:scopeNote xml:lang="en">A building situated next to a horse racing course with facilities for participants and spectators.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160386">
    <skos:scopeNote xml:lang="en">A fortifed position, often including fieldworks or defensive structures, designed to keep enemy forces engaged to allow reinforcements to be mobilized.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91996">
    <skos:scopeNote xml:lang="en">Buildings, sites and structures associated with the processing of foodstuffs.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91763">
    <skos:scopeNote xml:lang="en">A long stone or metal vessel for dogs to drink water from.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70461">
    <skos:scopeNote xml:lang="en">The gate of a sluice which can be opened or shut to let out or retain the water.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94170">
    <skos:scopeNote xml:lang="en">A factory, or group of buildings, containing apparatus used to extract specific properties, e.g flavour or scent, from natural ingredients.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71558">
    <skos:scopeNote xml:lang="en">A building licensed for the sale of beer.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68654">
    <skos:scopeNote xml:lang="en">An area of land and associated buildings where vines are cultivated. The grapes produced are then used to make wine.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164168">
    <skos:scopeNote xml:lang="en">A type of textile mill found in Lancashire in the 19th century. Small businesses paid the owner rent for space for their machines, and power from the mill engine or waterwheel.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164143">
    <skos:scopeNote xml:lang="en">Central two-storeyed tower surmounted by an octagonal glazed control room giving a 360 degree view. Flanked by single-storey wings.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93257">
    <skos:scopeNote xml:lang="en">A port, dock or harbour where ferries, hovercraft, ocean liners and cargo vessels can load and unload. May include road and/or rail terminals for transportation to the port.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70315">
    <skos:scopeNote xml:lang="en">A picture or pattern produced by cementing together small pieces of stone or glass of various colours. May be in the form of a floor.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91045">
    <skos:scopeNote xml:lang="en">A burial site for an animal, usually commemorated by a gravestone or other structure.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93275">
    <skos:scopeNote xml:lang="en">A small structure providing cover and protected accommodation for a sentry.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93300">
    <skos:scopeNote xml:lang="en">A bridge decorated with shells forming an ornamental feature.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159305">
    <skos:scopeNote xml:lang="en">A prefabricated timber structure similar to Sectional hutting that was used by the Air Ministry for accommodation at airfields during WWII. Manufactured by Gerrard and Sons from 1939 to 1941.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93215">
    <skos:scopeNote xml:lang="en">A room or building used for curing fish or meat.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/100022">
    <skos:scopeNote xml:lang="en">A system of trenches dug by troops for practice purposes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78242">
    <skos:scopeNote xml:lang="en">A place where boats are stored.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143370">
    <skos:scopeNote xml:lang="en">A centre used by the Territorial Army, the volunteer reserve of the British army.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68569">
    <skos:scopeNote xml:lang="en">A structure providing accommodation for poultry.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/100233">
    <skos:scopeNote xml:lang="en">The remains of a vessel which has either sunk or suffered structural damage to the extent where it can no longer function.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71721">
    <skos:scopeNote xml:lang="en">An educational institution, introduced in the 1960s. Distinguished from universities by traditionally training technicians in business, industry and commerce for an immediate local area, and offering more part-time classes, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70293">
    <skos:scopeNote xml:lang="en">An enclosure containing a dock, boat yard, warehouse, etc, in which canal vessels are built and repaired, and all sorts of stores and merchandise for transportation brought together.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/132733">
    <skos:scopeNote xml:lang="en">A building within a gunpowder works complex, where the mill cake (pulverised and incorporated ingredients of gunpowder) was broken down. It was crushed or broken down by passing it between pairs of revolving gunmetal rollers in a breaking-down machine.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/139024">
    <skos:scopeNote xml:lang="en">An alignment of stakes or stakeholes of unknown function</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/118913">
    <skos:scopeNote xml:lang="en">An enclosure for wild cats such as Lions and Tigers</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/144464">
    <skos:scopeNote xml:lang="en">A building housing an electric powered mine ventilation fan.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70242">
    <skos:scopeNote xml:lang="en">A railway worked by the propulsive force of compressed air or by the formation of a vacuum.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78191">
    <skos:scopeNote xml:lang="en">A group of planted trees or shrubs, generally of uniform age and of a single species.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70768">
    <skos:scopeNote xml:lang="en">A cross erected by the side of the road.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140501">
    <skos:scopeNote xml:lang="en">A site or building associated with active or passive defence of the landing ground and buildings of an airfield.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159307">
    <skos:scopeNote xml:lang="en">A prefabricated structure of cant sided lightweight timber wall sections bolted together. Externally the walls were clad with plasterboard covered with felt. Designed for use as barrack accommodation during WWII.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71394">
    <skos:scopeNote xml:lang="en">A type of clothier's house, consisting of TOPSHOP and dwelling, used for hand-weaving of textiles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92354">
    <skos:scopeNote xml:lang="en">A boarding or day school for children who had committed minor crimes or who lived in circumstances where they were likely to commit crime.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92887">
    <skos:scopeNote xml:lang="en">An institution for convicted prisoners held under a regime which strove to reform by means of silent isolation and labour.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93868">
    <skos:scopeNote xml:lang="en">A building associated with rope manufacture, especially in naval dockyards.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91530">
    <skos:scopeNote xml:lang="en">A coal-burning power station where domestic electricity for an area is produced, eg. Battersea Power Station, London.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69082">
    <skos:scopeNote xml:lang="en">A mill for grinding or crushing bones, in the process of making bone china, for example.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69950">
    <skos:scopeNote xml:lang="en">A piece of ground on which athletes race.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70498">
    <skos:scopeNote xml:lang="en">A site where alum (hydrous sulphate or salt and alumina) is quarried.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91423">
    <skos:scopeNote xml:lang="en">A Swiss-styled house, usually with steeply pitched and projecting roof.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69188">
    <skos:scopeNote xml:lang="en">A furnace used for the smelting or reheating of lead.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71622">
    <skos:scopeNote xml:lang="en">A church established by a religious community to propogate its faith.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91186">
    <skos:scopeNote xml:lang="en">An ornamental receptacle to catch rainwater for birds to drink from and bathe in. Sometimes mounted on a column or plinth.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91342">
    <skos:scopeNote xml:lang="en">An often stately and ornate entrance to a canal tunnel.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93094">
    <skos:scopeNote xml:lang="en">A bed raised above the level of the surrounding walks. A common feature of medieval and Renaissance gardens.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93000">
    <skos:scopeNote xml:lang="en">A workshop for printing textiles in a CALICO PRINTING WORKS.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91979">
    <skos:scopeNote xml:lang="en">A plot of earth used for the raising of flowers and shrubs.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69258">
    <skos:scopeNote xml:lang="en">An area used for crushing mineral ore or stone. Often includes mechanically powered ore crushers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/146407">
    <skos:scopeNote xml:lang="en">A room containing a boiler, used to provide heating.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69995">
    <skos:scopeNote xml:lang="en">A stone, either in situ or part of a monument, bearing one or more small, roughly hemispherical depressions surrounded by a concentric arrangement of annular or pennanular grooves. More complex designs may also occur.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70053">
    <skos:scopeNote xml:lang="en">An area of ground, set apart for the burial of the dead.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71460">
    <skos:scopeNote xml:lang="en">A machine used in a mill to remove bran scales and flour from grits or middlings.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142031">
    <skos:scopeNote xml:lang="en">Refers to art, whether carving or painting, applied to free -standing stones or cave walls.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70037">
    <skos:scopeNote xml:lang="en">An inhumation, usually Roman, which has been covered by tiles to form a tent-like structure over the body; the apex is covered by ridge tiles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160237">
    <skos:scopeNote xml:lang="en">A distinctive, clerestory-roofed building of five 10ft bays, used for the drying, storage and packing of military parachutes and built to Air Ministry drawing number 17865/39.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92023">
    <skos:scopeNote xml:lang="en">The dwelling and workshop of a framework knitter.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68882">
    <skos:scopeNote xml:lang="en">A system of fortifications constructed along a national frontier to contain the local population, as well as keep out undesirable raiders eg. Offa's Dyke. Use with more specific monument type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170065">
    <skos:scopeNote xml:lang="en">A device, monogram or symbol incised in stonework by a mason as a means of identifying his work. Particularly common in Romanesque and Gothic buildings.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91781">
    <skos:scopeNote xml:lang="en">A textile factory where the process of doubling, the twisting together of two spun yarns, takes place.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68863">
    <skos:scopeNote xml:lang="en">A defensive enclosure created by constructing one or more lines of ramparts across a neck of land, in order to defend, or restrict access to, a spur or promontory, either inland or on the coast.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94206">
    <skos:scopeNote xml:lang="en">A bridge supported by large beams or girders, originally of wood or iron, now usually of steel or reinforced concrete.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70136">
    <skos:scopeNote xml:lang="en">A mixed house of nuns and religious men of the Benedictine order.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/152613">
    <skos:scopeNote xml:lang="en">A car park on the roof of a building.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68991">
    <skos:scopeNote xml:lang="en">An enclosed settlement surrounded by a single or double row of close-set timbers embedded in a foundation trench, without ditches or banks.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91709">
    <skos:scopeNote xml:lang="en">An educational establishment where dentistry is taught.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93181">
    <skos:scopeNote xml:lang="en">A terrace house sharing a common wall with its neighbours.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71440">
    <skos:scopeNote xml:lang="en">A small-scale railway, often for the transportation of children at a place of recreation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170056">
    <skos:scopeNote xml:lang="en">A place in which turpentine is produced.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91882">
    <skos:scopeNote xml:lang="en">A government office used for the collecting of excise tax/duty.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164368">
    <skos:scopeNote xml:lang="en">An engineering works that produces machinery specially for use in textile making.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92527">
    <skos:scopeNote xml:lang="en">A building housing machinery.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140088">
    <skos:scopeNote xml:lang="en">A boiling vessel used in the direct boiling process, or the sleeching process, used for the manufacture of salt. For evaporating features associated with SOLAR and PARTIAL SOLAR sites use SALT POND.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92122">
    <skos:scopeNote xml:lang="en">A building in a zoo or wildlife park used to accommodate giraffes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160517">
    <skos:scopeNote xml:lang="en">Based on a typical 18ft span, 40ft long temporary brick hut but with two bay windows in the front elevation, one for the watch office and one for the chief instructor.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164171">
    <skos:scopeNote xml:lang="en">A building in which moist guncotton is dried by warm air for use in nitroglycerine manufacture.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70036">
    <skos:scopeNote xml:lang="en">A burial in which the body is placed in, or covered by a boat, which is then covered with earth. Use with barrow type where relevant.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92639">
    <skos:scopeNote xml:lang="en">A shaft, separate to the main working shaft, used to pump water out of the mine workings.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69482">
    <skos:scopeNote xml:lang="en">One of a pair of large circular stones used for grinding corn in a mill.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160359">
    <skos:scopeNote xml:lang="en">A command centre used to co-ordinate information received from Royal Observer Corps observation and monitoring posts.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91550">
    <skos:scopeNote xml:lang="en">A road or street covered with small, rounded cobble stones.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160523">
    <skos:scopeNote xml:lang="en">A building in which photographers, taken for aerial reconnaissance purposes, are analysed and interpreted to provide intelligence on enemy activities.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/151939">
    <skos:scopeNote xml:lang="en">A mill used to dress ore by means of a jigging machine.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91443">
    <skos:scopeNote xml:lang="en">Sites for the manufacture of substances or items by controlled chemical reactions.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92323">
    <skos:scopeNote xml:lang="en">An engine house used to pump water to the top of an ACCUMULATOR TOWER.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92432">
    <skos:scopeNote xml:lang="en">A chapel dedicated to our Blessed Lady, often placed to the east of the High Altar, sometimes in other positions.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/103614">
    <skos:scopeNote xml:lang="en">Sites and structures associated with the disposal of waste water and waterborne refuse.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/103052">
    <skos:scopeNote xml:lang="en">A warehouse used for the storage of fruit and/or vegetables.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141084">
    <skos:scopeNote xml:lang="en">A cleansing house associated with Jewish burial ceremonies</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69933">
    <skos:scopeNote xml:lang="en">A pit or enclosed area used for cockfighting.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69184">
    <skos:scopeNote xml:lang="en">A furnace composed of two fire brick boxes: the fire was in the lower box and the upper box held the crucibles. Used in the manufacture of steel.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70353">
    <skos:scopeNote xml:lang="en">Earthworks of uncertain date and purpose, consisting of cross-shaped banks sometimes with an accompanying ditch. Their distribution is largely confined to North Yorkshire.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68732">
    <skos:scopeNote xml:lang="en">A place where a yearly or half-yearly court of record is held by lords of certain manors.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70361">
    <skos:scopeNote xml:lang="en">An area of land enclosed by one or several boundary ditches. Double index with a term to indicate the shape of the enclosure where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141328">
    <skos:scopeNote xml:lang="en">Residence for retired people, often in the form of an apartment complex, differing from a nursing home as the residents live independently.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141020">
    <skos:scopeNote xml:lang="en">A small brewery, often situated in a public house, producing limited quantities of beer, for consumption locally and/or on the premises.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91357">
    <skos:scopeNote xml:lang="en">An inclined concrete ramp on which cars can move from one level to another.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91016">
    <skos:scopeNote xml:lang="en">A factory where aircraft engines are assembled.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160400">
    <skos:scopeNote xml:lang="en">A radar station with sets operating on a wavelenght of 1.5m established to provide radar plotting of both shipping and aircraft movements.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70368">
    <skos:scopeNote xml:lang="en">An area of land, roughly shaped like a trapezoid and enclosed by a boundary ditch, bank, wall, palisade or similar barrier.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164390">
    <skos:scopeNote xml:lang="en">A missile or aircraft that obtain its thrust from a rocket engine. Some rockets will exist as monuments for example, in the form of gate guardians. Double index with the monument type where appropriate.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160392">
    <skos:scopeNote xml:lang="en">A system of lights, controlled fires or dummy constructions, used to simulate a dockyard and thus confuse enemy aircraft into bombing these counterfeit targets.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/144573">
    <skos:scopeNote xml:lang="en">A building housing one end of an underwater telegraph cable.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91169">
    <skos:scopeNote xml:lang="en">A finishing process for cloth involving the pounding of the cloth with heavy weights.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93466">
    <skos:scopeNote xml:lang="en">A building or site where phosphorous-based fertilizers are produced by controlled chemical reactions.</skos:scopeNote>
  </rdf:Description>
