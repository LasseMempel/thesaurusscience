    skos:prefLabel "QF SITE"@en ;
    skos:scopeNote "A decoy fire positioned close to a legitimate target which would be lit in the event of an incendiary attack in the hope that subsequent bombs would be drawn to the area of the decoy."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160296> a skos:Concept ;
