        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-06T11:40:38.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T13:55:36.000</terms:modified>
        <skos:definition xml:lang="cs">Lambrekýn (franc. obloukový závěs, čabraka), horní ukončení okna, lůžkových nebes nebo dveří v podobě závěsu s krajkami nebo třásněmi (baroko), často bývá imitován ze štuku nebo kamene. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Lambrequin (frz. Bogenbehang), oberer Abschluss eines Fensters, Betthimmels, einer Tür in Form eines Behangs mit Spitzen oder Quasten (Barock). Der Lambrequin wird auch oft aus Stuck oder Stein nachgebildet. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="it"> lambrecchini</skos:prefLabel>
        <skos:prefLabel xml:lang="fr"> lambrequin</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Lambrequin</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">lambrekýn</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_55a8722a -->


