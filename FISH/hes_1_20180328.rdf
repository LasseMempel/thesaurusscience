		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/592" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/338" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1457">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1457</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">BALLA-TAIC</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Balla a chaidh a thogail gus taic a chumail ri uchdan ùir.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">REVETMENT</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-31T15:12:38</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1454" />
				<skos:scopeNote xml:lang="en">A wall built to retain a bank of earth.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1458">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1458</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">BALLA-CHEAP</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Balla a chaidh a thogail de sgrath.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">TURF WALL</skos:prefLabel>
