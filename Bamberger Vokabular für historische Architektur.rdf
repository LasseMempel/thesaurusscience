        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T20:15:44.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T17:41:15.000</terms:modified>
        <skos:altLabel xml:lang="de">Sternbogen</skos:altLabel>
        <skos:altLabel xml:lang="fr">arc en contrecourbe</skos:altLabel>
        <skos:altLabel xml:lang="fr">arc infléchi</skos:altLabel>
        <skos:altLabel xml:lang="it">arco a controcurve</skos:altLabel>
        <skos:altLabel xml:lang="es">arco en contracurva</skos:altLabel>
        <skos:altLabel xml:lang="cs">závěsový oblouk</skos:altLabel>
        <skos:definition xml:lang="de">Bogen mit einer aus mehreren kleineren konkaven Kreissegmenten zusammengesetzten Bogenlinie, gewissermaßen ein umgekehrter Kleeblattbogen, gelegentlich mit Lambrequins und anderen dekorativen Formen. Besonders in der spätgotischen Profanarchitektur eine beliebte Ausbildung des Fenstersturzes. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Sternbogen, ein Bogen, der von konvexen Bogenlinien begrenzt wird. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Vorhangbogen</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">arc à inflexions multiples</skos:prefLabel>
        <skos:prefLabel xml:lang="it">arco a tenda</skos:prefLabel>
        <skos:prefLabel xml:lang="es">arco torcido</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">draperiový oblouk</skos:prefLabel>
        <skos:prefLabel xml:lang="en">inflected arch</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_1cf0c7ce"/>
    </owl:NamedIndividual>
    


