    <skos:scopeNote xml:lang="en">A building or building complex where municipal offices and other public buildings are situated.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71597">
