    <!-- https://hist-arch-vocab.org/bvha#c_338ae31c -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_338ae31c">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a7484f12"/>
