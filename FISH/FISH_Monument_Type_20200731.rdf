  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92263">
    <skos:scopeNote xml:lang="en">A water mill where the waterwheel directly drives a vertical shaft with grindstones on.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71489">
