        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-11-04T16:28:17.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T14:51:04.000</terms:modified>
        <skos:definition xml:lang="de">Im Gegensatz dazu [zum Mantelständer] steht der eingebundene Ständer (wandhoch) mit Nut, der in gleicher Stärke wie die Blockwand ausgebildet ist. An den Balkenköpfen sind Zapfen angeschnitten, die von der Nut des Ständers umfasst werden. [Eißing et al. 2012]</skos:definition>
        <skos:prefLabel xml:lang="de">eingebundener Ständer</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_1cb81a92"/>
        <broaderByPosition rdf:resource="https://hist-arch-vocab.org/bvha#c_1cb81a92"/>
    </owl:NamedIndividual>
    


