    <skos:prefLabel xml:lang="en">ANTIQUITY SITE EXCLUSION MARKER</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Antiquity stars were used on training ranges to indicate areas off limits to troops. They marked the locations of scheduled archaeological features such as barrows, promontory forts and Iron Age forts.</skos:scopeNote>
