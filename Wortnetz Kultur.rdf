	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk008600">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Grapen</skos:prefLabel>
		<skos:altLabel xml:lang="en">pipkin</skos:altLabel>
		<skos:altLabel xml:lang="en">pipkins</skos:altLabel>
		<skos:altLabel xml:lang="en">tripod pipkin</skos:altLabel>
		<skos:altLabel xml:lang="en">tripod pipkins</skos:altLabel>
		<skos:prefLabel xml:lang="en">tripod skillet</skos:prefLabel>
		<skos:altLabel xml:lang="en">tripod skillets</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk015390"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk012069"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk017961"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk015390"/>
		<skos:definition xml:lang="de">Ein Grapen ist ein bauchiger Kochtopf mit drei Standfüßen. Mit Henkel oder Griff versehen, wurden Grapen über die heiße Glut gestellt oder gehängt und dienten in erster Linie zum Kochen von Speisen. Frühe Exemplare wurden aus Irdenware, spätere Gefäße auch aus Metall hergestellt.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/7743840-1"/>
