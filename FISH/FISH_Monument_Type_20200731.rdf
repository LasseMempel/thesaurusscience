    <skos:scopeNote xml:lang="en">A fortified structure used to protect civilians and military personnel from enemy bombing.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93338">
    <skos:scopeNote xml:lang="en">A wealden house with only one end being jettied.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68704">
    <skos:scopeNote xml:lang="en">A garden or park, with ancilliary buildings, in which wild animals are kept and reared for public exhibition.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93683">
    <skos:scopeNote xml:lang="en">A place of worship for members of the United Reformed Church, a group formed in 1972 by the amalgamation of most of the Congregational Churches in England and Wales with the Presbyterian Church in England.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70360">
