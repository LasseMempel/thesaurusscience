				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/2/concepts/502150">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/2" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/2/concepts/502150</dcterms:identifier>
				<skos:prefLabel xml:lang="en">LEAF ARROWHEAD</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-15T11:00:05</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-15T11:00:23</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:56:41</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/2/concepts/501140" />
				<skos:scopeNote xml:lang="en">A leaf or diamond-shaped arrowhead with shallow retouching at the edges.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
