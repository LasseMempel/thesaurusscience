    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70000> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "POND BARROW"@en ;
    skos:scopeNote "A monument featuring an artificial circular shallow depression surrounded by a bank which runs around the rim of the depression."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70009> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70000> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "RING BARROW"@en ;
    skos:scopeNote "A circular bank surrounding an area where burials were placed."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70011> a skos:Concept ;
    skos:altLabel "Fancy Barrow"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70010> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "BELL BARROW"@en ;
    skos:scopeNote "A round barrow in which the mound and ditch are separated from each other by a berm. The ditch may be accompanied by an external (or occasionally internal) bank."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70012> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70010> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "BOWL BARROW"@en ;
    skos:scopeNote "A round barrow featuring a mound surrounded by a ditch, with no intervening berm. The ditch may be accompanied by an external bank."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70014> a skos:Concept ;
    skos:altLabel "Fancy Barrow"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70010> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "BELL DISC BARROW"@en ;
    skos:scopeNote "A form of round barrow intermediate between the Bell Barrow and the Disc Barrow. Only use where it is not possible to determine specific type."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70015> a skos:Concept ;
    skos:altLabel "Fancy Barrow"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70010> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "DISC BARROW"@en ;
    skos:scopeNote "A round barrow featuring a small mound separated from a ditch of much greater diameter by a wide berm. The ditch may be accompanied by an external (or occasionally internal) bank."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70016> a skos:Concept ;
    skos:altLabel "Fancy Barrow"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70010> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "SAUCER BARROW"@en ;
    skos:scopeNote "A round barrow featuring a low, wide mound surrounded by a ditch which may be accompanied by an external bank."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70017> a skos:Concept ;
    skos:altLabel "Square Barrow Cemetery"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70000> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "SQUARE BARROW"@en ;
    skos:scopeNote "A burial monument, usually of Iron age date, comprising a small square ditched enclosure surrounding a central interment, which may also have been covered by a mound."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70019> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70018> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "ANIMAL BURIAL"@en ;
    skos:scopeNote "Deliberate interment of a complete, or substantially complete, animal. Use the object type thesaurus term ANIMAL REMAINS where skeleton is fragmentary."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70024> a skos:Concept ;
    skos:altLabel "Bog Body"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70018> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "BOG BURIAL"@en ;
    skos:scopeNote "A body which has been interred in boggy or marshy ground or other similarly waterlogged environment. Interment may have been deliberate or accidental."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70026> a skos:Concept ;
    skos:altLabel "Chariot Burial"@en,
        "Wagon Burial"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70018> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "CART BURIAL"@en ;
    skos:scopeNote "A high status Iron Age grave in which a two or four wheeled vehicle accompanies a frequently richly furnished inhumation burial. A barrow may overlie the grave."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70027> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70018> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "CHARCOAL BURIAL"@en ;
    skos:scopeNote "Inhumation rite in which charcoal is included with the buried corpse, possibly in an attempt to preserve the body. Thought to be associated with high status burials of the early medieval and medieval period."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70029> a skos:Concept ;
    skos:altLabel "Urned Cremation"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70028> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "CINERARY URN"@en ;
    skos:scopeNote "Urn containing a cremation. Where component use with wider site type."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70030> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70018> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "GYPSUM BURIAL"@en ;
    skos:scopeNote "An inhumation burial in which the body is covered by a shroud, placed in a coffin of stone, wood or lead and covered with gypsum, plaster or lime. Roman and early Medieval."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70032> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70031> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "CONTRACTED INHUMATION"@en ;
    skos:scopeNote "A form of inhumation in which the skeleton is interred, usually on its side, with the knees brought up against the chest. This is a more extreme form of crouched inhumation."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70033> a skos:Concept ;
    skos:altLabel "Crouched Burial"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70031> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "CROUCHED INHUMATION"@en ;
    skos:scopeNote "A form of inhumation in which the skeleton is interred, usually on its side, with hip and knee joints bent through an angle of more than 90 degrees."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70034> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70031> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "EXTENDED INHUMATION"@en ;
    skos:scopeNote "A form of inhumation in which the skeleton is laid out in an approximately straight line, whether face up, face down, or on its side."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70035> a skos:Concept ;
    skos:altLabel "Flexed Burial"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70031> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "FLEXED INHUMATION"@en ;
    skos:scopeNote "A form of inhumation in which the skeleton is interred, usually on its side, with hip and knee joints bent through an angle of less than 90 degrees."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70036> a skos:Concept ;
    skos:altLabel "Boat Burial"@en ;
