		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/413" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/345" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/422" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500706" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/508" />
		<skos:scopeNote xml:lang="en">A small, sometimes partly artificial, island with evidence of buildings and other structures related to domestic occupation, generally of medieval date.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/463">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/463</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÙCHAIRT</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach a tha na àite-còmhnaidh oifigeach aig rìgh no neach-eaglais àrd-inbheach, can àrd-easbaig. Mòr agus air a sàr-sgeadachadh gu tric.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PALACE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/413" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/464" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/465" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/424" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/452" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/479" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500570" />
		<skos:scopeNote xml:lang="en">A building used as the official residence of royalty or of a high-ranking religious leader such as an Archbishop. Often large and richly furnished.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/464">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/464</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÙCHAIRT EASBAIG</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite-còmhnaidh oifigeach aig riaghlair na sgìre-easbaig.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BISHOPS PALACE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">EPISCOPAL PALACE</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1645" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/463" />
		<skos:scopeNote xml:lang="en">The ecclesiastical residence of the governor of diocese.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/465">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/465</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÙCHAIRT RÌOGHAIL</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach mòr is air a shàr-sgeadachadh a tha ga chleachdadh mar àite-còmhnaidh oifigeach le ball de theaghlach rìoghail.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ROYAL PALACE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/463" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/424" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/452" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/475" />
		<skos:scopeNote xml:lang="en">A large, luxuriously appointed house used as an official residence by a member of royalty.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/466">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/466</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FASGADH CREIGE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">An t-àite fo aomadh nàdarra aig bonn bearraidh no creige. Dh'fhaoidte gun deach seo a chleachdadh mar àite-fuirich, àite-tìodhlacaidh is msaa.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ROCK SHELTER</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1566" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/413" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/414" />
		<skos:scopeNote xml:lang="en">The area beneath a natural overhang at the base of a cliff or crag. This may have been used for occupation, burial, etc.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/467">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/467</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TEANAMAINT</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach mòr sa bheil grunn sheòmraichean no fhlataichean a ruigear air staidhir choitcheann mar is trice.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TENEMENT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/503181" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/421" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/503121" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/504641" />
		<skos:scopeNote xml:lang="en">A large building containing a number of rooms or flats, access to which is usually gained via a common stairway.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/468">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/468</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TALLA-FIODHRAICH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach mòr ceart-cheàrnach is àrd-inbheach, cuid mhòr dheth air a thogail de dh'fhiodh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TIMBER HALL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/413" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1478" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/432" />
		<skos:scopeNote xml:lang="en">A large, rectangular building of high status, constructed largely of wood.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
