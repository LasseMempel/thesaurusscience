    <!-- https://hist-arch-vocab.org/bvha#c_0edb1fea -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_0edb1fea">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
