	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502553">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502553</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">DÙN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Lann, gu math tric air mullach cnuic, a tha co-dhiù aon uchdan, dìg, rampair no balla mun cuairt air. Cleachd airson làraichean ro-eachdraidheil agus tràth-eachdraidheil.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">FORT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-08T09:26:58</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-07-16T13:27:45</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">HILLFORT</skos:altLabel>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/327" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500509" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/2322" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1525" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/320" />
		<skos:scopeNote xml:lang="en">An enclosure, often located on a hilltop, bounded by one or more banks, ditches, ramparts or walls. Use for prehistoric and early historic sites.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502637">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502637</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CLACH OGHAM</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Loman creagach air a bheil rudeigin sgrìobhte ann an Ogham, aibidil aig a bheil litrichean a tha nan loidhnichean no eagan a-rèir oir no ceàrn.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">OGHAM INSCRIBED ROCK</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-20T13:03:29</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-20T13:03:47</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502145" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502662" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1558" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1559" />
		<skos:scopeNote xml:lang="en">A rock outcrop bearing an inscription in the Ogham alphabet, in which letters are represented by lines or notches along an edge or angle.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502640">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502640</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">COMHARRA-PLANNTRAIS</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Rudan a thathar dhen bheachd gur e mac an duine a chruthaich iad agus a chithear mar comharran-planntais air dealbhan-adhair.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">VEGETATION MARK</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-22T10:56:24</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-22T10:58:45</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1899" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500476" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500477" />
		<skos:scopeNote xml:lang="en">Features thought to be of anthropogenic origin visible as vegetation marks on aerial photographs.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502660">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502660</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">RAON CLACH-SPOR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Co-chàrnadh nàdarra de chlach-theine an cruth grinneil, molagan, nòidealan is ulpagan. Air a chlàradh a chionn 's gu bheil e freagarrach airson saothrachadh innealan.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">FLINT DEPOSIT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-22T12:31:27</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-27T14:34:21</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1566" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502687" />
		<skos:scopeNote xml:lang="en">A natural accumulation of flint in the form of gravel, pebbles, nodules and boulders. Recorded for its suitability for tool manufacture.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502662">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502662</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CREAG CUIMHNEACHAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Loman creagach no balla uamha a chomharraicheas duine no tachartais.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">COMMEMORATIVE ROCK</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-25T13:24:12</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-25T13:24:52</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/203" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502637" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502189" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/207" />
		<skos:scopeNote xml:lang="en">A rock outcrop or cave wall which commemorates a person or event.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502663">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502663</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">COMHARRAN CHUPAN IS CHEARCALL</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Clach no loman creagach air a bheil lagan a tha cha mhòr leth-chruinn agus/no gròban fàinneach no beàrn-fhàinneach co-mheadhanach. Chithear pàtranan toinnte cuideachd. Cleachd briathar nas mionaidiche. Dèan diofar eadar dealbhaidhean air clachan/ulpagan agus lomain chreagach.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CUP AND RING MARKINGS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-25T13:30:10</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-07-18T08:29:38</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1645" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502030" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1501" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502031" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1502" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502034" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502028" />
		<skos:scopeNote xml:lang="en">A stone or rock outcrop bearing roughly hemispherical depressions and/or concentric annular or penannular grooves. Complex designs also occur. Use more specific term. Differentiate between designs on stones/boulders and rock outcrop.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502664">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502664</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">SNAIGHEADH CRUITHNEACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Clach no loman creagach air an deach comharran Cruithneach, mar bheathaichean, cruthan is pàtranan eas-chruthach, a shnaidheadh. Cleachd briathar nas mionaidiche. Dèan diofar eadar dealbhaidhean air clachan/ulpagan agus lomain chreagach. Ma tha crois air cuideachd, cuir LEAC CROISE air a' chlàr-amais cuideachd.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PICTISH SYMBOL CARVING</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-25T13:50:31</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-28T10:12:28</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1645" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502029" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1503" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1500" />
		<skos:scopeNote xml:lang="en">Stones or rock outcrop bearing Pictish symbols such as carved animals, figures and abstract designs. Use more specific term. Differentiate between designs on stones/boulders and rock outcrop. If a cross is included, index as CROSS SLAB as well.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502665">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502665</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CLACH SHNAIGHTE</skos:prefLabel>
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502685">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502685</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH-RATHAID</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Fàrdach aig a bheil cead deoch-làidir a reic, mar is trice air prìomh-rathad taobh a-muigh baile no cathrach 's a sholaireas biadh is dibhearsan.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ROADHOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-26T13:48:51</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-07-12T13:49:29</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1831" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/232" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/234" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/240" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/241" />
		<skos:scopeNote xml:lang="en">A licensed premises, usually located on a main road outside a town or city, providing meals and entertainment.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502686">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502686</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BOTHAN-TUGHAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Bothan air a bheil tughadh chuilcean, connlaich no fraoich, ann am breathan is ceangailte còmhla.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">THATCHED COTTAGE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-27T11:21:28</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-27T11:22:38</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/2101" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/21" />
		<skos:scopeNote xml:lang="en">A cottage with a roof of reeds, straw or heather, layered and fastened together.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502687">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502687</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">RAON CLACH-CIÙIRDE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Tional nàdarra de chlachan a chaidh a chlàradh a chionn 's gu bheil e freagarrach airson saothrachadh innealan.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">STONE DEPOSIT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-27T14:28:43</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-27T14:31:03</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1566" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502660" />
		<skos:scopeNote xml:lang="en">A natural deposit of stone recorded for its suitability for tool manufacture.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502706">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502706</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TOM CHLACHAN-ACHAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Torr chlachan nach eil àrsaidh gu cinnteach; uaireannan chaidh fhàgail ann ach am bi iad ullamh airson obair togalaich no drèanaidh ach nas trice, chan eil cinnt cò às a thàinig iad agus dè feum a bha annta. Airson torran de chlachan a chaidh a ghlanadh air falbh air sgàth àiteachais, cleachd CÀRN CARTAIDH.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">STONE HEAP</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-28T08:16:36</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-28T08:46:22</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1898" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1442" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/42" />
		<skos:scopeNote xml:lang="en">A pile of stones of doubtful antiquity, sometimes dumped in preparation for building or drainage, but more often of unknown purpose or origin. For piles of stone cleared for agricultural purposes use CLEARANCE CAIRN.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502707">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502707</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÀRACH IASGAICH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">ùrlar a chleachdas iasgairean, gu math tric bidh seo air a dhèanamh de chlachan-càsaidh tràghad agus air an t-seal-mhara.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">FISHING STAND</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-07-13T09:29:07</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-07-13T09:32:27</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/60" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/67" />
		<skos:scopeNote xml:lang="en">A platform used by fishermen, often made of beach cobbles, and located on the foreshore.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502708">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502708</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">AMBASAID</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Taigh-còmhnaidh agus oifis tosgaire.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">EMBASSY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-07-13T12:36:41</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-07-13T12:37:48</dcterms:modified>
