        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-20T13:55:50.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-27T08:44:25.000</terms:modified>
        <skos:altLabel xml:lang="cs">haklíkové zdivo</skos:altLabel>
        <skos:altLabel xml:lang="cs">kopákové zdivo</skos:altLabel>
        <skos:altLabel xml:lang="fr">maçonnerie en assises</skos:altLabel>
        <skos:definition xml:lang="de">Ein Mauerwerk aus unregelmäßigen Bausteinen, bei dem Ausgleichsschichten aus regelmäßigem Material eingefügt sind, auch Wechsel von verschiedenartigem oder verschiedenfarbigem Material (z.B. Backstein-Werkstein, Polychromie). [Koepf /Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Schichtmauerwerk</skos:prefLabel>
        <skos:prefLabel xml:lang="es">mamposteria de piedras talladas</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">maçonnerie appareillée</skos:prefLabel>
        <skos:prefLabel xml:lang="it">muratura a ricorsi</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">řádkové zdivo</skos:prefLabel>
    </owl:NamedIndividual>
    


