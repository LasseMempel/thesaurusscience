        <skos:altLabel xml:lang="de">Pektoralschild</skos:altLabel>
        <skos:altLabel xml:lang="de">Rationale</skos:altLabel>
        <skos:altLabel xml:lang="en">breastplate</skos:altLabel>
        <skos:altLabel xml:lang="en">rational</skos:altLabel>
        <skos:altLabel xml:lang="fr">rational</skos:altLabel>
        <skos:definition xml:lang="de">Brustschild n; Rationale n; auch PektoralschiId n; gr. logion: ein bischöflichen Brustschmuck in Form einer rechteckigen, mit zwölf Steinen besetzten Platte. Ihr Vorläufer war das Brustschild des jüdischen Hohepriesters mit den Namen der Stämme Israels. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Brustschild</skos:prefLabel>
        <skos:prefLabel xml:lang="el">logion</skos:prefLabel>
        <skos:prefLabel xml:lang="en">pectoral</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">pectoral</skos:prefLabel>
    </owl:NamedIndividual>
    


