    <skos:scopeNote xml:lang="en">A farmstead where mostly detached buildings have developed around four sides of an open cattle yard.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167328">
    <skos:scopeNote xml:lang="en">The area of a military base where engineering and maintenance functions are grouped.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69250">
    <skos:scopeNote xml:lang="en">When secondary product use with major product and MINE, eg. COPPER MINE.</skos:scopeNote>
  </rdf:Description>
