	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021350">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Haarbürste</skos:prefLabel>
		<skos:altLabel xml:lang="de">Haarbürsten</skos:altLabel>
		<skos:prefLabel xml:lang="en">hairbrush</skos:prefLabel>
		<skos:altLabel xml:lang="en">hairbrushes</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk015228"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk021078"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk015228"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk021078"/>
		<skos:definition xml:lang="de">Eine Haarbürste ist eine Bürste, die zur Pflege, zum Frisieren und zum Stylen der Kopfhaare verwendet wird. Sie besteht typischerweise aus einem Bürstenkörper, häufig mit Griff, und darin eingelassenen Borsten aus natürlichen oder synthetischen Materialien wie Naturborsten oder Stiften aus Holz, Metall oder Kunststoff mit und ohne Noppen. Die Hauptfunktion einer Haarbürste ist das Entwirren, Glätten und Formen der Haare sowie das Massieren der Kopfhaut.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300236713"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1642980"/>
