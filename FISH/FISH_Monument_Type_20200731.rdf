  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71754">
    <skos:scopeNote xml:lang="en">An open space or area, usually square in plan, in a town or city, enclosed by residential and/or commercial buildings, frequently containing a garden or laid out with trees.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/127613">
    <skos:scopeNote xml:lang="en">A centre attached to a prison where families and friends can visit with the inmates.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93809">
    <skos:scopeNote xml:lang="en">A workshop with a forge for the melting and working of white metal, ie. low-melting alloys. Also used for a smith specializing in decorative or finely finished wrought iron work.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68612">
    <skos:scopeNote xml:lang="en">A monument featuring a bank or mound constructed primarily of stone. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93399">
    <skos:scopeNote xml:lang="en">A farmyard or enclosure containing regularly built stacks of hay, corn, peas etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70038">
    <skos:scopeNote xml:lang="en">A place where dead bodies are buried together. Often unconsecrated ground.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91171">
    <skos:scopeNote xml:lang="en">A building housing a set of bellows used to provide the blast of air to a blast furnace or similar installation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69406">
    <skos:scopeNote xml:lang="en">A large factory or series of workshops for the manufacture of clothing.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92573">
    <skos:scopeNote xml:lang="en">The residence of a master ropemaker.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/111173">
    <skos:scopeNote xml:lang="en">A gun battery used to signal warnings to ships during bad weather.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70167">
    <skos:scopeNote xml:lang="en">An abbey or priory for nuns ofthe Benedictine order.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160520">
    <skos:scopeNote xml:lang="en">A tall, usually steel, structure used to receive and transmit radio telegraphy signals.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91856">
    <skos:scopeNote xml:lang="en">A house with a pitched roof with a double slope and gables on the side elevations of the building.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71644">
    <skos:scopeNote xml:lang="en">A building used to pump sewage from the sewers to the filter beds of a sewage works.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/84014">
    <skos:scopeNote xml:lang="en">A wall in a flower or kitchen garden, containing conduits or pipes for heating the wall.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92302">
    <skos:scopeNote xml:lang="en">A building in which people are held in a state of imprisonment or confinement as punishment. Usually associated with military and political offenders.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/111593">
    <skos:scopeNote xml:lang="en">A pit in a road or trackway covered with a grid, usually of metal poles (but can be of wood or stone) with sufficient space between the poles to prevent animals from crossing, without restricting access for vehicles and people.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91929">
    <skos:scopeNote xml:lang="en">Building used for field studies and outdoor pursuits in the countryside and in an urban context.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68660">
    <skos:scopeNote xml:lang="en">A pen, often circular and stone-walled, for rounding up livestock.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71458">
    <skos:scopeNote xml:lang="en">A short piece of track lying parallel to the main railway line enabling trains and trucks to pass one another. Sidings can also be used to park trains which are not in use.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78238">
    <skos:scopeNote xml:lang="en">A house, the inhabitant of which keeps an official register e.g. a registrar's house near a cemetery would keep an official record of deaths and burials.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70155">
    <skos:scopeNote xml:lang="en">A residence of the Bonhommes brethren, who followed the Augustinian rule.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69284">
    <skos:scopeNote xml:lang="en">An engineering works producing items for the railway other than rolling stock, such as signals, tracks, points, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/118613">
    <skos:scopeNote xml:lang="en">A building, or group of buildings, deliberately designed for rhinos.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/148438">
    <skos:scopeNote xml:lang="en">A cast iron post similar to a lamp post, with revolving top to carry either coloured plates, or an oil lamp with coloured glass at night. Associated with canal or river navigation locks.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70380">
    <skos:scopeNote xml:lang="en">Area feature visible as an earthwork or cropmark with no known function.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70356">
    <skos:scopeNote xml:lang="en">A circular shaped area of land enclosed by a boundary ditch, bank, wall, palisade or similar barrier.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71697">
    <skos:scopeNote xml:lang="en">A small, usually inexpensive, restaurant with a limited menu of light meals served at counters or tables.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91066">
    <skos:scopeNote xml:lang="en">The residence and office of an archdeacon.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70116">
    <skos:scopeNote xml:lang="en">A wall enclosing a precinct.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93433">
    <skos:scopeNote xml:lang="en">A building housing equipment for the process of distillation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162638">
    <skos:scopeNote xml:lang="en">Mass produced iron framed shed usually clad in metal sheeting.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68958">
    <skos:scopeNote xml:lang="en">The place where a house stood or had once stood, often adjoining a garth or croft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68851">
    <skos:scopeNote xml:lang="en">A building or site used for the exercise and training of military personnel.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92268">
    <skos:scopeNote xml:lang="en">An area of ground in which horses can be exercised.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140222">
    <skos:scopeNote xml:lang="en">Saxon rectangular burial chamber comprising a large sunken 'room' lined with wood. 6th and 7th century AD.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164190">
    <skos:scopeNote xml:lang="en">Factory making slippers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69987">
    <skos:scopeNote xml:lang="en">A free-standing structure, in the form of a cross (+), symbolizing the structure on which Jesus Christ was crucified and sacred to the Christian faith. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92882">
    <skos:scopeNote xml:lang="en">A path across a road, usually marked as a crossing for pedestrians.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93082">
    <skos:scopeNote xml:lang="en">A semaphore signalling tower on a railway.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/118974">
    <skos:scopeNote xml:lang="en">An underground cell, usually hidden and accessed only through a trapdoor, in which a prisoner was confined and then allegedly forgotten about.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92083">
    <skos:scopeNote xml:lang="en">Ornamental wrought iron screen associated with gate lodges or entrance lodges.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99582">
    <skos:scopeNote xml:lang="en">A works or factory where shells or projectiles were machined before they were dispatched to a filling factory to be filled with explosives.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/139340">
    <skos:scopeNote xml:lang="en">House, where destitute Jews converted to Christianity after the expulsion. Latin for "House of Converts".</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70267">
    <skos:scopeNote xml:lang="en">A way, path or road through a cutting.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160317">
    <skos:scopeNote xml:lang="en">A road block formed by placing curved rails, "hairpins", in sockets in the road surface.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/100192">
    <skos:scopeNote xml:lang="en">A strategic food store, directly operated by, or on behalf of, the government. The stores were used to store a variety of foodstuffs. They were in operation from the end of the Second World War until the early 1990's.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159261">
    <skos:scopeNote xml:lang="en">A large tent which can be used as accommodation for parties and exhibitions.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93325">
    <skos:scopeNote xml:lang="en">A tower in a semaphore communication system. Often a three-storey building on a hill in line-of-sight, signal towers provided working and living space, usually for two crewmen with their families.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93981">
    <skos:scopeNote xml:lang="en">A house in a terrace built on top of another, with access at high and low level to either side.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91379">
    <skos:scopeNote xml:lang="en">A floor area, covered in sand, onto which hot metal from a furnace is cast.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70305">
    <skos:scopeNote xml:lang="en">A large wooden structure built alongside the edge of a river where boats may lie for the loading and unloading of goods and passengers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91276">
    <skos:scopeNote xml:lang="en">Buildings and structures associated with the process of brewing and malting.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93251">
    <skos:scopeNote xml:lang="en">A garden designed to display sculpture, publicly or privately.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/144605">
    <skos:scopeNote xml:lang="en">An area of managed countryside designated for visitors to enjoy recreations, such as walking specified parks and trails, in a rural environment. Often provides public facilities such as parking, toilets, cafes and visitor information.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71586">
    <skos:scopeNote xml:lang="en">An area of a garden with a semi-circular backdrop formed by an ornamental, architectural structure or a natural feature grown to the required shape eg. a hedge</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91964">
    <skos:scopeNote xml:lang="en">A building used to dry flax.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141936">
    <skos:scopeNote xml:lang="en">A concrete structure, based on drawing number (11008/41), intended to be the headquarters for the coordination of an airfield's defences. Constructed partially underground it was considered less vulnerable than the (3329/41).</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70741">
    <skos:scopeNote xml:lang="en">A managed small wood or thicket of underwood grown to be periodically cut to encourage new growth providing smaller timber.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93118">
    <skos:scopeNote xml:lang="en">A depot for the transfer of town refuse to river barges before transportation to the REFUSE DEPOT.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/122516">
    <skos:scopeNote xml:lang="en">A bridge whose trusses or girders form parapets on either side of the deck.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92073">
    <skos:scopeNote xml:lang="en">A decorative garden ornament, usually of stone, in the form of a wide, shallow dish.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143808">
    <skos:scopeNote xml:lang="en">A building housing a double inlet fan that was used for the ventillation of mine shafts</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69988">
    <skos:scopeNote xml:lang="en">A sculpted cross, or a cross incised into stone or trees, to mark a parish boundary.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70187">
    <skos:scopeNote xml:lang="en">An enclosure surrounded by a wooden stockade. A rare site type of Neolithic date.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/147273">
    <skos:scopeNote xml:lang="en">A residential home for children with physical and/or learning disabilities, sensory impairment and/or mental health issues who need medical intervention and/or care provided by registered nurses.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143261">
    <skos:scopeNote xml:lang="en">A plinth or pedestal, usually of concrete, to which an anti aircraft or coastal battery gun was fitted. Holdfasts are often the only evidence for a weapon which survive.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/151869">
    <skos:scopeNote xml:lang="en">A working tunnel or gallery in a mine used for the extraction of ironstone.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87480">
    <skos:scopeNote xml:lang="en">Recovery and removal of grease (lanolin) from raw wool.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/147331">
    <skos:scopeNote xml:lang="en">A small narrow rectilinear enclosure with high hedges boundaries for the cultivation and shelter of flowers, particularly Daffodils and Narcissi.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70151">
    <skos:scopeNote xml:lang="en">An outlying farm or estate belonging to the Cistercian order.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93790">
    <skos:scopeNote xml:lang="en">A lid for a well. Well covers are often ornate and can be made of various materials.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71434">
    <skos:scopeNote xml:lang="en">A library for use of the public.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140113">
    <skos:scopeNote xml:lang="en">A trench dug in order to receive the foundations of a structure such as a stone wall etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68729">
    <skos:scopeNote xml:lang="en">A structure used for execution by hanging. Usually two uprights and a cross-piece, from which the offender is suspended by the neck.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69415">
    <skos:scopeNote xml:lang="en">A place where sails are manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92372">
    <skos:scopeNote xml:lang="en">A sewer or irrigation channel designed to avoid blockage.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70163">
    <skos:scopeNote xml:lang="en">An abbey or priory belonging to the Tironian order.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70366">
    <skos:scopeNote xml:lang="en">A rectangular shaped area of land enclosed by a boundary ditch, bank, wall, palisade or similar barrier.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140220">
    <skos:scopeNote xml:lang="en">A mill for the processes of grinding, balling, couching, drying and packing of woad. The mill can be demountable, enabling it being located close to the fields, as woad crop has to be rotated and move to new fields as soon as the ground is exhausted.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164127">
    <skos:scopeNote xml:lang="en">A flour mill using both stones and rollers to produce flour and, perhaps mainly from the stones, animal feed from grains other than wheat.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71485">
    <skos:scopeNote xml:lang="en">An apparatus for burning refuse to ashes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69965">
    <skos:scopeNote xml:lang="en">A tower or turret in which bells are hung.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68999">
    <skos:scopeNote xml:lang="en">A settlement located on or near to the shores of a lake. Buildings associated with lake villages are usually raised on piles to prevent them from being flooded.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91809">
    <skos:scopeNote xml:lang="en">A plant where freshly mined coal was washed down and any dust removed before loading for transport away from the colliery.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159241">
    <skos:scopeNote xml:lang="en">A building or complex where soft skins are produced by tanning with alum.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93521">
    <skos:scopeNote xml:lang="en">A building, similar in style to a telephone exchange but smaller. They were used to compensate for the inadequacies of 1920's and 30's equipment over long distances, by repeating the signal every 200 miles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92160">
    <skos:scopeNote xml:lang="en">A shop selling tea, butter, flour, sugar, spices, tinned foods and miscellaneous household stores.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160241">
    <skos:scopeNote xml:lang="en">A power house built to Air Ministry drawing number 1380/24.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/168338">
    <skos:scopeNote xml:lang="en">A chemical works producing mordants for the dying industry.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/119013">
    <skos:scopeNote xml:lang="en">Buildings, sites and structures associated with the retrieval, refining, processing and storage of petroleum oil.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70173">
    <skos:scopeNote xml:lang="en">A priory of the female Order of Knights Hospitallers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69375">
    <skos:scopeNote xml:lang="en">The line of a flat rod system transmitting power from an engine or waterwheel.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93128">
    <skos:scopeNote xml:lang="en">A chamber built into the side of a covered reservoir to enable the water level to be inspected.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/83692">
    <skos:scopeNote xml:lang="en">An outlying farm or estate belonging to the Gilbertine order.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91315">
    <skos:scopeNote xml:lang="en">An indoor or outdoor market where butter was sold.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91665">
    <skos:scopeNote xml:lang="en">A nursery for infants, where they are taken care of while their mothers are at work.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68750">
    <skos:scopeNote xml:lang="en">An assemblage of public and private buildings, larger than a village and having more complete and independent local government.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70720">
    <skos:scopeNote xml:lang="en">A place where coal is mined.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143480">
    <skos:scopeNote xml:lang="en">A room used for the ritual cleaning of the body prior to burial</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68655">
    <skos:scopeNote xml:lang="en">A cultivated plantation of watercress, usually situated near springs or small running streams.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92255">
    <skos:scopeNote xml:lang="en">A hospital where more 'natural' means of treatment are used rather than conventional methods.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69421">
    <skos:scopeNote xml:lang="en">A place where products are manufactured from wood.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87957">
    <skos:scopeNote xml:lang="en">An iron, stone or concrete tower built up from the bed of a reservoir. From it the control valves of the pipes which draw off water at different levels are operated.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70905">
    <skos:scopeNote xml:lang="en">An institution for the imprisonment of felons and debtors.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71752">
    <skos:scopeNote xml:lang="en">A model village established by the chartists.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92677">
    <skos:scopeNote xml:lang="en">A factory built as a pattern for improved design.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70259">
    <skos:scopeNote xml:lang="en">An outbuilding used for the storage and maintenance of horse-drawn carriages.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70117">
    <skos:scopeNote xml:lang="en">A hiding place for a (Roman Catholic) priest.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143953">
    <skos:scopeNote xml:lang="en">A long building with a louvred roof in which silver is refined using the Pattinson Process, which had been developed in the 1830s.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/103092">
    <skos:scopeNote xml:lang="en">An anti aircraft battery armed with 3 inch rockets with a ceiling of 22,000 feet. Both single and multiple launchers were designed. Single launchers being used to defend vulnerable points such as coastal batteries with multiple launchers defending town.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93841">
    <skos:scopeNote xml:lang="en">A barn used for the storage and drying of wool.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71530">
    <skos:scopeNote xml:lang="en">A structure in a garden used to house gardening implements, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92175">
    <skos:scopeNote xml:lang="en">A workshop for testing guns, incorporating louvred sheds to serve as firing ranges.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/163172">
    <skos:scopeNote xml:lang="en">A commercially manufactured air raid shelter, using prefabricated parabolic concrete panels which could be combined to produce any length of shelter.Usually semi-sunken and covered with earth they were mainly used on RAF sites.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78137">
    <skos:scopeNote xml:lang="en">A place of worship for Wesleyan Methodists. This was the original Methodist church from which the other denominations seceded. In 1932 they joined the United Methodists and the Primitive Methodists to form the Methodist church.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159251">
    <skos:scopeNote xml:lang="en">A shaft allowing access to an area. Often used as an additional escape route to the main shaft in a mine or as an air shaft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93280">
    <skos:scopeNote xml:lang="en">A winding walk, common in early 18th century Rococo gardens and parks.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87955">
    <skos:scopeNote xml:lang="en">A place where pheasants are reared and kept.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93773">
    <skos:scopeNote xml:lang="en">A water point with a device to regulate the flow of water.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140549">
    <skos:scopeNote xml:lang="en">A four-storey RNAS control tower. The first floor contained offices for the commander flying and meteorological offices and the upper two floors, in the form of a central tower, provided offices for air traffic control.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70143">
    <skos:scopeNote xml:lang="en">A house of friars of the order of St Dominic. Also known as Friars Preachers or 'Black Friars'.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140109">
    <skos:scopeNote xml:lang="en">A building or site used for the production of frameworks of beds.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99670">
    <skos:scopeNote xml:lang="en">An area of land, with associated buildings and targets, used for practicing the dropping of bombs and other aspects of air warfare.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143534">
    <skos:scopeNote xml:lang="en">An area of a site or building providing a stable base for the firing of artillery pieces.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69310">
    <skos:scopeNote xml:lang="en">A type of tower mill, either with turbine-type sails able to take wind from any direction, or with sails working with shrouds to direct wind from one direction. The sails directly drove millstones set beneath them.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160396">
    <skos:scopeNote xml:lang="en">A coastal battery containing one or more artillery pieces for to defend the coast against hostile motor torpedo boats.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68559">
    <skos:scopeNote xml:lang="en">A building used to accommodate ducks.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93150">
    <skos:scopeNote xml:lang="en">A place where two or more roads meet.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94002">
    <skos:scopeNote xml:lang="en">A friary of the Order of the Friar servants of the Blessed Virgin Mary or Servites. The Servite Fathers came to England in 1864.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91022">
    <skos:scopeNote xml:lang="en">A large metal pylon structure used to tether airships.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160253">
    <skos:scopeNote xml:lang="en">A stand by set house built with a steel-framed pitched roof. Built to drawing number 8760/42 it was intended to supersede all earlier designs and was cheaper to produce. Both the transformer and fuel tanks were located outside the main building.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140524">
    <skos:scopeNote xml:lang="en">A square pillbox with loopholes for four light machine guns with 18 in thick walls. Probably designed by DFW branch 3 although it may have been adapted from an external source as Southern Command correspondence refers to the type as 'Stento'.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93372">
    <skos:scopeNote xml:lang="en">A light, ornamental building or structure built to incorporate, or in association with, a mineral spring.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70252">
    <skos:scopeNote xml:lang="en">A track inlaid into a surface, on which tram cars run for the conveyance of passengers and/or goods or raw materials.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91400">
    <skos:scopeNote xml:lang="en">An enclosure for cattle.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162872">
    <skos:scopeNote xml:lang="en">A lime kiln where the fuel is not mixed with the limestone but burnt below it.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93306">
    <skos:scopeNote xml:lang="en">A canal that can accommodate ocean-going ships, usually built across an isthmus or to give access to a river port e.g. Manchester ship canal</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69960">
    <skos:scopeNote xml:lang="en">An elevated table or podium on which to place or sacrifice offerings to the deities.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160528">
    <skos:scopeNote xml:lang="en">A platform, usually in concrete, on which radar equipment was mounted to assist the targetting of artillery guns. The platform is often the only evidence surviving in the landscape.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93068">
    <skos:scopeNote xml:lang="en">A place where radio programmes are produced and broadcast.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69174">
    <skos:scopeNote xml:lang="en">A building or buildings used for the manufacture of all types of wax.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68856">
    <skos:scopeNote xml:lang="en">A hilltop enclosure bounded by a double line of ramparts.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69391">
    <skos:scopeNote xml:lang="en">A site where artefacts are manufactured from jet.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143223">
    <skos:scopeNote xml:lang="en">An area, often a village, with fixed defences such as pillboxes, anti tank ditches and gun emplacements, designed to stop the advance of an enemy force and to hold out for an agreed period of time.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140525">
    <skos:scopeNote xml:lang="en">A large octagonal pillbox, with a projecting entrance, equipped with loopholes for eight light machine guns and a light anti-aircraft mounting sited in a central well which was accessed from inside the pillbox. Designed by DFW branch 3.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71574">
    <skos:scopeNote xml:lang="en">A wall constructed for the purpose of confining or supporting a mass of earth or water.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68689">
    <skos:scopeNote xml:lang="en">One in a chain of stations with semaphore shutters and telescopes which could relay messages according to a planned code. Used from the 1790s by the British Admiralty to speed up communications from London to the ports of Deal, Portsmouth and Plymouth.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68602">
    <skos:scopeNote xml:lang="en">A weekend retreat for Royal parties and others, when hunting in the Royal forests, or as a viewing station for the chase.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87145">
    <skos:scopeNote xml:lang="en">A building or site for watching specific military activities or the movement of enemy forces, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92446">
    <skos:scopeNote xml:lang="en">A place where vessels can land passengers and goods.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162654">
    <skos:scopeNote xml:lang="en">A medieval high status farmstead, acting as the centre of the estate, directly controlled by the lord and used for the benefit of his household and dependents.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/163212">
    <skos:scopeNote xml:lang="en">Platform or structure used for viewing performances.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70052">
    <skos:scopeNote xml:lang="en">A circular bank of stones and turf, sometimes accompanied by a ditch, surrounding a natural outcrop of rock, usually a tor, or an earthfast boulder.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140499">
    <skos:scopeNote xml:lang="en">A central tower with a single-storey wing either side. The tower contained the watch office on the ground floor, observation room on the second with each wing containing an office for the Chief Flying Instructor or the officer commanding and their aides.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94356">
    <skos:scopeNote xml:lang="en">An ancilliary building or structure associated with a military base. Use only where exact function is unknown otherwise use more specific term.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70309">
    <skos:scopeNote xml:lang="en">A structure over an opening usually formed of wedge-shaped blocks of brick or stone held together by mutual pressure and supported at the sides; they can also be formed from moulded concrete/ cast metal. A component; use for free-standing structure only.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162645">
    <skos:scopeNote xml:lang="en">A fire station built for use by the Auxiliary Fire Service, established in 1938 to supplement existing local brigades.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91111">
    <skos:scopeNote xml:lang="en">A small yard attached to the rear of a house or other building.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71417">
    <skos:scopeNote xml:lang="en">A refreshment house in a public park or country house garden.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92356">
    <skos:scopeNote xml:lang="en">A school where young children, usually under the age of seven, are taught.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69367">
    <skos:scopeNote xml:lang="en">A horse-powered winding engine used at mining sites.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92220">
    <skos:scopeNote xml:lang="en">An artificial, sometimes temporary, platform on which helicopters can take off and land.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91337">
    <skos:scopeNote xml:lang="en">A post set up alongside a canal to mark the miles to and from a place.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78213">
    <skos:scopeNote xml:lang="en">A site where gypsum and anhydrate is mined.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91895">
    <skos:scopeNote xml:lang="en">Use wider site type where known. Only use term where no other part of original building survives.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140114">
    <skos:scopeNote xml:lang="en">A pit filled with rubble, etc., into which rain or waste water flows in order to disperse into the surrounding soil.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162570">
    <skos:scopeNote xml:lang="en">A building combining a pigsty at ground level with a poultry house in a loft over.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70256">
    <skos:scopeNote xml:lang="en">A building, with adjacent open areas, in which buses are maintained, usually having an extensive area free from upright columns or stanchions to permit overnight storage, repair bays, stores and an office.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93410">
    <skos:scopeNote xml:lang="en">The residence of a station master.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/82940">
    <skos:scopeNote xml:lang="en">A harbour constructed from floating pontoons or caissons connected end to end.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70233">
    <skos:scopeNote xml:lang="en">A plate, usually of wood or metal, set up on a road, canal or railway to mark the miles from or to a place.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91560">
    <skos:scopeNote xml:lang="en">For the collection of money by charities, churches, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142969">
    <skos:scopeNote xml:lang="en">Debris consisting of excess construction material used in the building of a nearby site or structure. If unsure of whether debris is from construction or demolition, index with both terms.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/122494">
    <skos:scopeNote xml:lang="en">A bridge, carrying a footpath or road, usually across marshy or waterlogged ground.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/84776">
    <skos:scopeNote xml:lang="en">A water-filled structure for experimental research.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140115">
    <skos:scopeNote xml:lang="en">A type of temporary military aircraft hangar introduced in 1940; of steel welded and bolted construction typically clad in galvanized corrugated iron sheets. The T2 became the standard temporary hangar for the RAF in World War Two.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68773">
    <skos:scopeNote xml:lang="en">A tree named after a person or event associated with it, e.g. Byron's Oak at Newstead.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70331">
    <skos:scopeNote xml:lang="en">A stone that indicates the limit of an area or piece of land.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87493">
    <skos:scopeNote xml:lang="en">Posts with hooks attached to allow drying new cloth to be stretched out between them.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164172">
    <skos:scopeNote xml:lang="en">Land which has been temporarily taken over for use by the military or civilian authorities. During wartime land was requisitioned for various purposes, such as for argriculture or for military training/events etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140122">
    <skos:scopeNote xml:lang="en">A type of transportable aircraft hangar patented by Miskins and Sons in 1939. The arched hangar was constructed of steel or wooden ribs and generally clad in steel sheets. The hangar did not require any foundations and could be anchored by iron stakes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159285">
    <skos:scopeNote xml:lang="en">A water feature intended to play a trick on a visitor by drenching them unexpectedly. The device would be triggered by the visitors foot or remotely. Italian for 'water jokes'.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159185">
    <skos:scopeNote xml:lang="en">A garden building usually in a secluded spot, resembling a hermit's dwelling and built as a resting place, retreat or viewing point.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94401">
    <skos:scopeNote xml:lang="en">A building used by an organization instituted to promote the needs and rights of the blind.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69122">
    <skos:scopeNote xml:lang="en">A factory concerned with the commercial manufacture of cider, as opposed to domestic production.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/144624">
    <skos:scopeNote xml:lang="en">A building or part of a building used for the storage of furniture or furniture related materials.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71561">
    <skos:scopeNote xml:lang="en">A building containing a number of single roomed cells used for detaining prisoners.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/103877">
    <skos:scopeNote xml:lang="en">A machine in which a heavy block of metal is used for beating, breaking or driving something.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71344">
    <skos:scopeNote xml:lang="en">Sites, buildings, structures &amp; features associated with the transmission &amp; receiving of information. Includes signalling, broadcasting &amp; telecommunications; does not include transport except where there is a specific connection with communication.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91413">
    <skos:scopeNote xml:lang="en">Buildings, sites and structures associated with the production of cement.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69450">
    <skos:scopeNote xml:lang="en">An office, particularly at a seaport, at which customs are collected.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/103713">
    <skos:scopeNote xml:lang="en">A factory for the manufacture of vehicles</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160271">
    <skos:scopeNote xml:lang="en">Based on the previous all-timber design 2423/39 and the temporary brick and timber design 518/40, the 8936/40 was built with pre-cast concrete slabs replacing the timber floors and staircases with only the balcony and watch office roof in timber.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92288">
    <skos:scopeNote xml:lang="en">A separate functional unit of a hospital not necessarily on the same site.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69941">
    <skos:scopeNote xml:lang="en">An establishment where musical performances take place.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91500">
    <skos:scopeNote xml:lang="en">A central office dealing with financial accounts.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70908">
    <skos:scopeNote xml:lang="en">A substantial structure supporting or surrounding a gate. May be ornate or monumental, and have associated structures such as lodges, tollbooths, guard houses etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91261">
    <skos:scopeNote xml:lang="en">A timber framed house comprising horizontal and vertical timbers, forming the walls of the building and directly supporting the roof.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/149209">
    <skos:scopeNote xml:lang="en">A matzevah from the Sephardi group of Jews descended from medieval Jewish communities of the Iberian Peninsular and Northern Africa.  Characterised by flat slabs with Hebrew Inscriptions</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160391">
    <skos:scopeNote xml:lang="en">A system of lights, controlled fires or dummy constructions, used to simulate an airfield and thus confuse enemy aircraft into bombing these counterfeit targets.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/129047">
    <skos:scopeNote xml:lang="en">A type of drying house, usually circular with a conical roof.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141860">
    <skos:scopeNote xml:lang="en">A place where a group of people live together sharing accomodation and goods, forming their own community based upon common ideals.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93578">
    <skos:scopeNote xml:lang="en">A structure for visually communicating the exact time to ships in anchorage. A ball slides down a mast at the top of the tower, usually at noon or one o'clock exactly.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91592">
    <skos:scopeNote xml:lang="en">A bakehouse built in association with a group of dwellings who shared the baking facilities. Often found in model settlements.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92441">
    <skos:scopeNote xml:lang="en">A large drainage channel used for improving the land.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/146403">
    <skos:scopeNote xml:lang="en">A boundary marker for the payment of tax or duty.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140338">
    <skos:scopeNote xml:lang="en">A structure consisting of different cells equipped with instrument posts which supported finders. These provided range and bearing of the projected position of the target to guns emplaced in a nearby battery. Errected along the coast in the late 1870s.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140519">
    <skos:scopeNote xml:lang="en">A rectangular pillbox with an enclosed square plan section for three light machine guns and an adjacent open area housing a mounting for a light anti-aircraft weapon. Designed by DFW branch 3.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69048">
    <skos:scopeNote xml:lang="en">Horizontal tunnel opening from the surface used for haulage or access to a mine. It can also be used for drainage.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70323">
    <skos:scopeNote xml:lang="en">The limit to an area as defined on a map or by a marker of some form, eg. BOUNDARY WALL. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162633">
    <skos:scopeNote xml:lang="en">A farmstead where the house and working buildings are attached and in-line. Can include Bastles, Longhouses and Laithe houses.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143012">
    <skos:scopeNote xml:lang="en">A factory where security safes are manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/103933">
    <skos:scopeNote xml:lang="en">Buildings, sites and structures associated with the extraction of metal ores.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160378">
    <skos:scopeNote xml:lang="en">A building, on an airfield, used to house a fire engine designed to Air Ministry drawing number 5342/42.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93574">
    <skos:scopeNote xml:lang="en">A house constructed with a basic timber framework; between the members are panels which can be infilled with timber, wattle and daub, plaster, brick or other materials.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91640">
    <skos:scopeNote xml:lang="en">A building in which the buying of raw cotton and finished goods took place.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93842">
    <skos:scopeNote xml:lang="en">A building used to dry wool in.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/139857">
    <skos:scopeNote xml:lang="en">Standard dwelling of the non-ruling classes of Japan until the mid twentieth century. Minkas are timber-framed houses with mud-plastered panels and thatched roofs. The design varies from region to region. Minkas served as home as well as workplace.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91879">
    <skos:scopeNote xml:lang="en">An educational building where examinations are held.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167609">
    <skos:scopeNote xml:lang="en">Works where yarn is prepared prior to spinning.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71823">
    <skos:scopeNote xml:lang="en">A place where architectural ornaments such as stone vases and urns are manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92611">
    <skos:scopeNote xml:lang="en">A place of worship for military personnel.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93301">
    <skos:scopeNote xml:lang="en">A fountain decorated with shells forming an ornamental feature.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/127354">
    <skos:scopeNote xml:lang="en">An area of hardstanding on which ammunition is stored.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91686">
    <skos:scopeNote xml:lang="en">A tower containing a curfew bell. The bell was rung in the evening, as a signal that fires were to be extinguished.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70179">
    <skos:scopeNote xml:lang="en">A shaft which appears to have been dug for, or which contains objects apparently deposited for, reasons other than storage, disposal or extraction (eg. of stone, water, etc). Index with principal object types.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140782">
    <skos:scopeNote xml:lang="en">A reservoir or tank used to hold a supply of water for fire-fighting purposes in the event of the main supply being damaged or cut off.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92587">
    <skos:scopeNote xml:lang="en">An establishment where the theory and practice of medicine is taught.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71685">
    <skos:scopeNote xml:lang="en">A building or room where railway tickets may be bought and administrative duties associated with a railway are conducted.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93078">
    <skos:scopeNote xml:lang="en">Buildings, sites and structures associated with the construction and maintenance of railways and rolling stock.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141947">
    <skos:scopeNote xml:lang="en">Chamber built into underside of a structure to exercise demolition.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92832">
    <skos:scopeNote xml:lang="en">A department devoted to the curing or correcting of physical deformities.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70139">
    <skos:scopeNote xml:lang="en">A priory of Gilbertine double order of nuns and canons.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70033">
    <skos:scopeNote xml:lang="en">A form of inhumation in which the skeleton is interred, usually on its side, with hip and knee joints bent through an angle of more than 90 degrees.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159387">
    <skos:scopeNote xml:lang="en">A small enclosure containing cold frames, often of brick and glass construction, usually situated against the exterior of a walled garden's south-facing garden.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/144568">
    <skos:scopeNote xml:lang="en">A building or group of buildings used for the raising of mink, a semi-aquatic mammal which is farmed for its fur.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92983">
    <skos:scopeNote xml:lang="en">Buildings, sites and structures associated with the generation and transmission of power.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160289">
    <skos:scopeNote xml:lang="en">An operations room, built to drawing number 3395/40, to control the lighting arrays of the 'T' type of bombing decoy in use during the Second World War. It was semi-sunken for added protection and then covered in earth</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70142">
    <skos:scopeNote xml:lang="en">A house of friars, originally hermits from Mount Carmel. Also known as ' white friars'.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93105">
    <skos:scopeNote xml:lang="en">A hall built as part of a complex and used for the recreation of the workers or inhabitants. Usually associated with model estates, factories, flats etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69032">
    <skos:scopeNote xml:lang="en">An enclosed piece of land, generally large in area, used for hunting, the cultivation of trees, for grazing sheep and cattle or visual enjoyment. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167092">
    <skos:scopeNote xml:lang="en">A building or site used for the storage of goods or equipment.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92596">
    <skos:scopeNote xml:lang="en">Buildings, sites and structures associated with the metal industry.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140770">
    <skos:scopeNote xml:lang="en">A hospital which has been built either wholly, or partially, underground in order to protect it from attacks by enemy aircraft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159252">
    <skos:scopeNote xml:lang="en">A series of locks usually with short reaches between them allowing boats to travel up and down a steep incline.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93660">
    <skos:scopeNote xml:lang="en">A mill which is powered by a turbine.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/163246">
    <skos:scopeNote xml:lang="en">Purpose built or modified structure or building used for scenery in a television program.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91300">
    <skos:scopeNote xml:lang="en">A small eating and drinking establishment or refreshment bar.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143179">
    <skos:scopeNote xml:lang="en">A site used for the butchery of animals.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91191">
    <skos:scopeNote xml:lang="en">An official residence of a bishop used during the summer months.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70359">
    <skos:scopeNote xml:lang="en">A site consisting of, usually two, sub-circular enclosures linked by a linear ditch running tangentially to the enclosure boundaries. Characteristic of the later prehistoric period in the Wessex region.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170006">
    <skos:scopeNote xml:lang="en">Trees, hedges and shrubs planted in the form of a medieval cathedral sometimes used as a memorial.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143958">
    <skos:scopeNote xml:lang="en">A building housing a steam driven ventilation fan used in mines</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164370">
    <skos:scopeNote xml:lang="en">A factory manufacturing billiard tables.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143413">
    <skos:scopeNote xml:lang="en">Buildings and structures associated with the acquisition of electronic signals for the purpose of intelligence gathering.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69424">
    <skos:scopeNote xml:lang="en">A place where tree trunks were sawn into planks by hand.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/103252">
    <skos:scopeNote xml:lang="en">An area within a hospital where patients receiving privately-funded medical and surgical treatment are accommodated. Often includes separate rooms.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167318">
    <skos:scopeNote xml:lang="en">A hut, usually built as part of a complex on a military base or airfield and used for the recreation of military personnel.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/139357">
    <skos:scopeNote xml:lang="en">Shelter on military airfield to provide night time accommodation for airmen during WWII.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68554">
    <skos:scopeNote xml:lang="en">A HORSE GIN used for domestic cider manufacture, especially on farms.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/144462">
    <skos:scopeNote xml:lang="en">A ventilating fan house with an expanding chimney.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160393">
    <skos:scopeNote xml:lang="en">A system of lights, controlled fires or dummy constructions, used to simulate a domestic site such as a city and thus confuse enemy aircraft into bombing counterfeit targets.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93036">
    <skos:scopeNote xml:lang="en">An open area, often paved or cobbled, surrounded by buildings and accessible to the public.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69321">
    <skos:scopeNote xml:lang="en">A mill for beating and cleaning cloth, using soap or fullers earth.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68950">
    <skos:scopeNote xml:lang="en">A large, luxuriously appointed building used as an official residence by a member of royalty.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68736">
    <skos:scopeNote xml:lang="en">An elevated platform on which a criminal is executed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68839">
    <skos:scopeNote xml:lang="en">A Norman keep, in the form of a circular or polygonal enclosure surrounded by a wall.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141994">
    <skos:scopeNote xml:lang="en">A mill used for the preparation and production of Calamine.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71593">
    <skos:scopeNote xml:lang="en">An industrial site or building where the machinery is powered by a steam engine.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92111">
    <skos:scopeNote xml:lang="en">A place of worship for General Baptists, a movement established by John Smyth in 1603 and which grew out of the original Baptist church. They believed in free will and are often referred to simply as Baptists.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160333">
    <skos:scopeNote xml:lang="en">A circular pillbox designed by the Croft Granite, Brick and Concrete Company, with six loopholes. With no roof or door access was gained through the roof.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/110554">
    <skos:scopeNote xml:lang="en">A factory used for the processing of isinglass, a product obtained from the swim bladders of sturgeon and used in the brewing industry as part of the  process for clearing wine and beer.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87929">
    <skos:scopeNote xml:lang="en">A building within a complex, such as a leisure centre, school, industrial site etc, often containing toilet and washing facilities, where individuals can change their clothes. For a changing room within a larger building, see Components.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/139025">
    <skos:scopeNote xml:lang="en">An alignment of trees planted as part of a designed landscape. For a belt lining a road use TREE AVENUE.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71375">
    <skos:scopeNote xml:lang="en">A workshop in which textile fibres were spun into yarn by hand.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91558">
    <skos:scopeNote xml:lang="en">A structure, often within a CHURCHYARD or LYCH GATE, on which a coffin could rest prior to burial.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160390">
    <skos:scopeNote xml:lang="en">A purpose-built building with a brick tower constructed on one end, based on drawing number (9294/42). Used for the drying of parachutes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91673">
    <skos:scopeNote xml:lang="en">A house in which a passage runs across the building, usually adjacent to a hall, between front and back entrance doors.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70403">
    <skos:scopeNote xml:lang="en">A hole dug to provide a firm base for an upright post, often with stone packing. Use broader monument type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92484">
    <skos:scopeNote xml:lang="en">Structures used for the lifting or hoisting of goods, machinery, vehicles, people and livestock.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/82828">
    <skos:scopeNote xml:lang="en">A fall of water. Use for artificial waterfalls if naturalistic in form, otherwise use CASCADE.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71041">
    <skos:scopeNote xml:lang="en">A box in which letters are deposited on delivery.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140803">
    <skos:scopeNote xml:lang="en">A sundial capable of giving an accurate reading of standard time to the minute.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91570">
    <skos:scopeNote xml:lang="en">Railway constructed specifically for the movement of coal around the pithead of a coal mine.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91108">
    <skos:scopeNote xml:lang="en">A type of back to back house built on a hillside, of four storeys and with entrances at different levels.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/144606">
    <skos:scopeNote xml:lang="en">A building or site incorporating sonar equipment used for detecting the presence of enemy ships or submarines.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141255">
    <skos:scopeNote xml:lang="en">A structure, often sunk into the ground, for the purpose of allowing total bodily immersion in mineral sprinwater or similarly beneficial substances.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142092">
    <skos:scopeNote xml:lang="en">A building used as the headquarters for the Home Guard during the Second World War.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71673">
    <skos:scopeNote xml:lang="en">A meeting place for freemasons.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69330">
    <skos:scopeNote xml:lang="en">A factory where worsted, a well-twisted woollen yarn made from long staple wool and used in the manufacture of suits and other garments, was produced.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140511">
    <skos:scopeNote xml:lang="en">A pillbox built to a design drawn up the chief engineer of Scottish Command</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91948">
    <skos:scopeNote xml:lang="en">A lock, often containing a fish ladder, which allows fish to swim upstream bypassing a weir or other obstacle.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91961">
    <skos:scopeNote xml:lang="en">A form of lock on a river, which increased the depth upstream and had a gated opening.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/103753">
    <skos:scopeNote xml:lang="en">A workshop in which products are made using wood and timber.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94405">
    <skos:scopeNote xml:lang="en">A place of worship for followers of Hinduism.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91206">
    <skos:scopeNote xml:lang="en">A terrace with windows and doors on one side only, often built facing inwards onto a burgage plot, or sometimes on a steep slope, with no apertures on the uphill side.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91833">
    <skos:scopeNote xml:lang="en">A sculptured likeness, portrait or image, often found on a tomb or other memorial.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71808">
    <skos:scopeNote xml:lang="en">A place where public sales of goods are made by competitive bidding.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162559">
    <skos:scopeNote xml:lang="en">A light anti aircraft position, usually open-walled and built of concrete, brick or sandbags used to emplace one or more machine guns mounted on pintels.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68575">
    <skos:scopeNote xml:lang="en">A garden in which bees are kept.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70026">
    <skos:scopeNote xml:lang="en">A high status Iron Age grave in which a two or four wheeled vehicle accompanies a frequently richly furnished inhumation burial. A barrow may overlie the grave.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140190">
    <skos:scopeNote xml:lang="en">A building or buildings used for the manufacture of crucibles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143001">
    <skos:scopeNote xml:lang="en">A building or settlement enclosure with a thick drystone wall, generally circular or oval in plan, usually sited in an elevated position.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71554">
    <skos:scopeNote xml:lang="en">A hall, apartment or large room, designed or used primarily for festive or state functions.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69964">
    <skos:scopeNote xml:lang="en">An area of a church, often a free-standing building, in which baptism is administered</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70086">
    <skos:scopeNote xml:lang="en">A long, narrow mound of earth or stone and of uncertain date and function. Use more appropriate term where possible.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/84015">
    <skos:scopeNote xml:lang="en">A lattice work bower or shady retreat covered with climbing plants.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99574">
    <skos:scopeNote xml:lang="en">A factory where explosives and the components of munitions of all types are brought together for assembly.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70278">
    <skos:scopeNote xml:lang="en">A set of steps or a framework of bars and steps for crossing over a fence or wall.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92992">
    <skos:scopeNote xml:lang="en">An independent school for children up to the age of 11 or 13 in which pupils are prepared for entry into a public school.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91425">
    <skos:scopeNote xml:lang="en">A building housing a board organized to protect the interests of commerce.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167071">
    <skos:scopeNote xml:lang="en">A site, including buildings and hardstandings, used for the storage and distribution of ammunition.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140189">
    <skos:scopeNote xml:lang="en">A mill where china stone is grinded.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87469">
    <skos:scopeNote xml:lang="en">A building associated with a spinning mill in which raw material is mechanically spun into yarn or thread.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162636">
    <skos:scopeNote xml:lang="en">A farmstead where the farmhouse and working buildings are attached and in-line. They can comprise the extension of linear farmsteads.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71284">
    <skos:scopeNote xml:lang="en">A natural flow or current of water issuing from a source.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159300">
    <skos:scopeNote xml:lang="en">A concrete hut produced by the Ministry of Works as a cheaper alternative to the BCF Hut as any suitable wall cladding could be employed in its construction. Usually used to form barrack blocks on airfields from 1944 onwards.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70140">
    <skos:scopeNote xml:lang="en">Houses specifically for men and of chiefly mendicant religious orders. The status of priory is represented in several friaries. Use with PRIORY if required.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70082">
    <skos:scopeNote xml:lang="en">A slab of stone, either standing or recumbent, inscribed with a cross. Usually found in association with burials.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69977">
    <skos:scopeNote xml:lang="en">An area of ground immediately surrounding a cathedral.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71610">
    <skos:scopeNote xml:lang="en">A shop where meat is sold. Often includes large cold stores for the refrigeration and storage of carcasses and a butchery where the carcass is cut up prior to sale.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91992">
    <skos:scopeNote xml:lang="en">Terms included here are for small scale agricultural production. See also FOOD AND DRINK INDUSTRY SITE grouping in INDUSTRIAL class.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70080">
    <skos:scopeNote xml:lang="en">A place of burial. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87798">
    <skos:scopeNote xml:lang="en">A double lock placed between tidal water and a canal, etc..</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91046">
    <skos:scopeNote xml:lang="en">A place or building where animals can be washed. Often in the form of a pool with a walled funnel-like structure enabling animals to be guided into the pool.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70437">
    <skos:scopeNote xml:lang="en">A head of water raised in a conduit system.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170089">
    <skos:scopeNote xml:lang="en">A dedicated room for housing the organ feeder bellows, can be an underground chamber or a free-standing building.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93394">
    <skos:scopeNote xml:lang="en">An engineering workshop for the manufacture and repair of springs.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170058">
    <skos:scopeNote xml:lang="en">The residence of a telegraph keeper, associated with a telegraph station.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68887">
    <skos:scopeNote xml:lang="en">A sunken arena used by the Romans for training cavalry horses and recruits.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71678">
    <skos:scopeNote xml:lang="en">A room or a building set aside for infants and young children.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68921">
    <skos:scopeNote xml:lang="en">Sites, buildings, structures and features used for permanent, seasonal or temporary accommodation/habitation &amp; related ancillary buildings. Includes commercial, military and religious sites used for residential purposes as well as industrial workplaces.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143165">
    <skos:scopeNote xml:lang="en">A camping place set aside for the use of caravans.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91548">
    <skos:scopeNote xml:lang="en">A tower used as a watch tower by the coastguard. Often, though not always, built as part of a Coastguard Station.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69124">
    <skos:scopeNote xml:lang="en">A site where products containing sugar or honey, such as cakes, sweets, crystallized fruits or jam, were manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92782">
    <skos:scopeNote xml:lang="en">A site used for the separation of oil into its constituent parts by heating in an enclosed vessel(s).</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93438">
    <skos:scopeNote xml:lang="en">A place where inmates of a workhouse or prison carried out stone breaking.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94123">
    <skos:scopeNote xml:lang="en">An RAF Base, used specifically for the storage and maintenance of barrage balloons.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93219">
    <skos:scopeNote xml:lang="en">A battery equipped and ready to fire salutes</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/82894">
    <skos:scopeNote xml:lang="en">A framework, often made of steel,  supporting a crane or similar structure, or for supporting a platform or stage.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/139548">
    <skos:scopeNote xml:lang="en">The residence or official premises of a consul, the official appointed by a state to protect its citizens and commercial interests in a foreign state.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92229">
    <skos:scopeNote xml:lang="en">A building or room containing a collection of preserved plants (usually pressed and dried specimens).</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92584">
    <skos:scopeNote xml:lang="en">A piece of grassland, often near a river, permanently covered with grass which is mown for use as hay.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143972">
    <skos:scopeNote xml:lang="en">A building containing pans in which salt water or brine was boiled to produce salt.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162624">
    <skos:scopeNote xml:lang="en">Regular courtyard farmsteads where the buildings are arranged as two linked ranges to create an L-shape. They can comprise a barn and an attached shelter shed to a cattle yard or an interlinked cattle housing and fodder range.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71659">
    <skos:scopeNote xml:lang="en">A building used for the education of, and as a residence for, chantry priests.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140504">
    <skos:scopeNote xml:lang="en">A pillbox which has been modified from a standard Directorate of Fortifications and Works design. Double index with specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/152713">
    <skos:scopeNote xml:lang="en">A house in which a member of the Royal Court lives.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92307">
    <skos:scopeNote xml:lang="en">An area of a port, dock or harbour, often including buildings for passport control and customs, where passengers and vehicles using hovercraft services can embark/disembark and where supplies can be taken on board.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91963">
    <skos:scopeNote xml:lang="en">A stone on which flax stems were beaten with wooden mallets, a process known as beetling.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/146333">
    <skos:scopeNote xml:lang="en">Vertical screens made of wood or steel framing mounted on concrete blocks were built to protect airships from cross winds when entering or leaving the airship sheds.</skos:scopeNote>
  </rdf:Description>
