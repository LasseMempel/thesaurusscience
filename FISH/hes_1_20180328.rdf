		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/402" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/284">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/284</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">LÀRACH TÀLADH  NÀMHAID</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Pàtran de sholais is teintean a thàlaidheas nàmhaid air falbh o thargaid cheart 's iad a' tilgeil urchraichean air. Chaidh an cleachdadh san Dàrna Chogadh Mhòr.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">DECOY SITE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:altLabel xml:lang="en">BOMBING DECOY SITE</skos:altLabel>
				<skos:altLabel xml:lang="en">DECOY</skos:altLabel>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/278" />
				<skos:scopeNote xml:lang="en">An arrangement of lights and fires, designed to draw enemy fire away from a genuine target. Used during World War Two.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
