        <skos:definition xml:lang="de">Einzelkelch m: ein Kelch, der nur von einem Gläubigen benützt wird. Er wird z . B. in prot. Gemeinden für das Abendmahl in Krankenhäusern verwendet. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Einzelkelch</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">calice à usage individuel</skos:prefLabel>
        <skos:prefLabel xml:lang="en">chalice for individual use</skos:prefLabel>
    </owl:NamedIndividual>
    


