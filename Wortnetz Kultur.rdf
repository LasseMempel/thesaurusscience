	<vocnet:FacetNode rdf:about="http://lvr.vocnet.org/wnk/wk002587">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Material (Facette)</skos:prefLabel>
		<skos:prefLabel xml:lang="en">Material (facet)</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000249"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000249"/>
		<xe:explanation_temp xml:lang="de">In der Materialfacette werden nicht nur Rohstoffe wie Flüssigkeiten, Schüttgüter, Pulver, Sand, Essigsäure, PVC oder ähnliches eingeordnet, sondern auch Werkstoffe aller Art, Bauteile, Werkstücke, Halbzeug, Rohlinge, also alles, was nicht „so, wie es ist“ verwendet wird, sondern aus dem noch etwas anderes hergestellt wird, das noch verarbeitet respektive weiterbearbeitet, zugeschnitten, aufgenäht, bemalt etc. wird.</xe:explanation_temp>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300264091"/>
