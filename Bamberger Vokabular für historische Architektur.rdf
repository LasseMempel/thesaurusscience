        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0cfd9e60"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-01T10:00:10.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T01:11:27.000</terms:modified>
        <skos:definition xml:lang="de">Zu angenehmem Aufenthalt ausgestaltetes Flachdach, oft mit Kübelpflanzen und Blumenschalen belebt und fälschl. Dachgarten genannt. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Dachterrasse</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">střešní terasa</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_fd33d05d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_fd33d05d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
