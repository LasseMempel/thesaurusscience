        <skos:altLabel xml:lang="de">Gebälk (Deckenelement)</skos:altLabel>
        <skos:definition xml:lang="de">Gesamtheit aller Balken in einer waagrechten Ebene. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Gesamtheit der zur Ausbildung einer Decke verlegten Balken. [Eißing et al. 2012]</skos:definition>
        <skos:definition xml:lang="de">Gesamtheit einer hölzernen Decken- und Dachkonstruktion. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">U řeckého chrámu souhrnný název pro architráv, vlys a korunní římsu (16nn.). [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Balkenlage</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kladí</skos:prefLabel>
