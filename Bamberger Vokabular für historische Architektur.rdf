        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-09T10:25:44.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:35:28.000</terms:modified>
        <skos:altLabel xml:lang="en">triple dome</skos:altLabel>
        <skos:altLabel xml:lang="fr">trois coupoles superposées</skos:altLabel>
        <skos:definition xml:lang="de">Beispiel: Das Pantheon in Paris und die St. Pauls Cathedral in London. (Glossarium Artis)</skos:definition>
