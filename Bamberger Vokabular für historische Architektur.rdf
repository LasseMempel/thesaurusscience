    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_c848f0c9 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_c848f0c9">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_298d4e12"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T12:17:56.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T14:02:56.000</terms:modified>
        <skos:definition xml:lang="de">Arabeske (frz.) 1. islam. Dekoration, bestehend aus rein geometr. Formen und stark entnaturalisierten Pflanzenranken (Mauresken). 2. Aus der hellenist.-röm. Antike stammendes Ornament, das seit der ital. Renaissance A. genannt wird (Groteske). Die A. der Antike, ausgezeichnet durch die plast., fast naturalist. Auffassung und organische Bewegung ihres gleichwohl stilisierten Laub- und Rankenwerks, wurde als waagerechter Fries oder in senkrechter Anordnung (symmetr. ausgerichtet) zur Dekoration von Pilastern und Sockeln verwendet; in stärkerer Stilisierung und meist in kompakteren Formen kehrt sie in der byzantin. Kunst wieder. Die ital. Frührenaissance nahm die A. in großem Umfang wieder auf und von Italien aus fand sie seit etwa 1520 Eingang in alle an der Renaissance beteiligten Länder. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Stilisiertes Rankenornament des Hellenismus und der Renaissance, naturalistischer als die Maureske. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Stylizovaný úponkový ornament z řecké antiky a renesance, naturalističtější než maureska. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Arabeske</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">arabeska</skos:prefLabel>
    </owl:NamedIndividual>
    


