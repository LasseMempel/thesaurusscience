        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-12T09:25:45.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-10T17:48:01.000</terms:modified>
        <skos:definition xml:lang="de">Taenia (griech.-lat. Kopfbinde), Leiste am Architrav der dorischen Ordnung. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Řec.-lat. čelenka, lišta na architrávu dórského řádu. [Koch 2008]</skos:definition>
