    <!-- https://hist-arch-vocab.org/bvha#c_b3f740e6 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b3f740e6">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
