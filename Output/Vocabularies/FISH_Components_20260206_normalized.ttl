    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Trapdoor"@en ;
    skos:scopeNote "A horizontal door within, and usually flush with surface of, a floor, ceiling or roof."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/139797> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/137674> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Stone Carving"@en ;
    skos:scopeNote "An inscription or illustration carved into the surface of a stone wall or other architectural element."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/139798> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/137674> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Graffito"@en ;
    skos:scopeNote "An inscription on illustration applied to a wall by carving into its plaster to reveal a different colour beneath."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/139817> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/137774> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Lamp"@en ;
    skos:scopeNote "A light, usually encased and mounted upon brackets, often used outdoors.  It may be powered by gas, electricity or house a candle."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/139826> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/137971> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Cooling Tower"@en ;
    skos:scopeNote "A large structure, usually associated with power stations, in which hot water undergoes a process of cooling before being re-used ."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/139828> a skos:Concept ;
    skos:altLabel "Lightning Rod"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/138311> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Lightning Conductor"@en ;
    skos:scopeNote "A metallic rod attached to a high point on a building and leading to the earth for the purpose of conducting lightning away from the main body of the building."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/139829> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/138063>,
