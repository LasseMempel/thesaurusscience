		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk020480"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk021102"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk021103"/>
