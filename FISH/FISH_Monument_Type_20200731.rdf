    <skos:scopeNote xml:lang="en">An establishment where chocolate was available as a beverage.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93810">
    <skos:scopeNote xml:lang="en">A market where goods are bought and sold in bulk, rather than by retail.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/146455">
    <skos:scopeNote xml:lang="en">The limit line of a township.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141126">
    <skos:scopeNote xml:lang="en">An enclosed encampment, often featuring temporary or semi-permanent structures, used for the detention of prisoners of war, refugees or other civilians detained on political or social grounds.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93704">
    <skos:scopeNote xml:lang="en">A centre where patients suffering from venereal and associated diseases receive treatment.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140769">
    <skos:scopeNote xml:lang="en">A secure, bomb-proof, undergound complex designed to be used by the government in the event of a national emergency such as nuclear war. Usually equipped with communications equipment, emergency rations and water and air filtering plants.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71463">
    <skos:scopeNote xml:lang="en">A prison for the confinement of people who owe money.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140495">
    <skos:scopeNote xml:lang="en">An aircraft hangar designed to house seaplanes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91174">
    <skos:scopeNote xml:lang="en">A residence of two or three monks of the Benedictine order dependent on a foreign mother house.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170637">
    <skos:scopeNote xml:lang="en">A place where silicate rock was extracted to be shaped for use as whetstones. Examples can be found in Derbyshire and the Blackdown Hills in Devon.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71712">
    <skos:scopeNote xml:lang="en">A large building, situated by or near a canal, used for the temporary storage of goods or merchandise awaiting transportation to or from the canal.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93425">
    <skos:scopeNote xml:lang="en">A steam powered winding gear used at a colliery or other mine.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92846">
    <skos:scopeNote xml:lang="en">An enclosed field for horses.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93228">
    <skos:scopeNote xml:lang="en">A steep bank or slope. In fortifications, the bank or wall immediately in front of and below the rampart.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/151940">
    <skos:scopeNote xml:lang="en">A mound kerbed with wooden stakes or boulders.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93787">
    <skos:scopeNote xml:lang="en">An apparatus for weighing people, animals or things.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/151492">
    <skos:scopeNote xml:lang="en">A garden associated with a crematorium where the ashes of deceased infants are scattered or buried.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91936">
    <skos:scopeNote xml:lang="en">A building containing apparatus for the removal of large pieces of detritus from a water supply.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162616">
    <skos:scopeNote xml:lang="en">A farmstead where mostly detached buildings have developed around one side of an open cattle yard.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91376">
    <skos:scopeNote xml:lang="en">An often ornate building housing the source of an ornamental cascade, eg. Chatsworth House.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167091">
    <skos:scopeNote xml:lang="en">A building, on an airfield or military base, used for the maintenance and storage of motor vehicles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70490">
    <skos:scopeNote xml:lang="en">A priory dependent on a foreign mother house. Use with narrow terms of DOUBLE HOUSE, MONASTERY or NUNNERY.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159192">
    <skos:scopeNote xml:lang="en">An enclosure, usually private, used for burial. Often found within a cemetery.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93608">
    <skos:scopeNote xml:lang="en">A hall used by the members of a trade union for meetings and social functions.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68756">
    <skos:scopeNote xml:lang="en">A hall in a village used for meetings and other functions.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68833">
    <skos:scopeNote xml:lang="en">A fortress and dwelling, usually medieval in origin, and often consisting of a keep, curtain wall and towers etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68719">
    <skos:scopeNote xml:lang="en">A public institution for the care and protection of children without parents.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162613">
    <skos:scopeNote xml:lang="en">A farmstead where the working buildings are arranged around a yard.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69327">
    <skos:scopeNote xml:lang="en">A factory where tapestries were manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91087">
    <skos:scopeNote xml:lang="en">A factory for the assembly of components. Usually associated with the manufacture of vehicles: cars, lorries, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143475">
    <skos:scopeNote xml:lang="en">Construction works for the production of rigid or dirigible airships.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91095">
    <skos:scopeNote xml:lang="en">An engine house which used air pressure to power trains on the experimental atmospheric railways of the 1840s.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78797">
    <skos:scopeNote xml:lang="en">A building containing the colliery showers. Also often containing first aid and mine rescue facilities.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/144559">
    <skos:scopeNote xml:lang="en">A building or room used for the repair and maintenance of machinery in a large complex, such as a hospital, school or factory.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160351">
    <skos:scopeNote xml:lang="en">A hostel used to accommodate members of the Womens Land Army who undertook essential agricultural work during the Second World War.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143483">
    <skos:scopeNote xml:lang="en">An arrangement of railway tracks, stations and other buildings that together form a railway transport system.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/75519">
    <skos:scopeNote xml:lang="en">A place of worship for Unitarians, a movement which does not believe in the Trinity but only in the Unity of Christ. Christ was to them just an exalted human teacher.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92649">
    <skos:scopeNote xml:lang="en">A specialist hospital where water treatment is given to patients suffering from muscular-skeletal complaints, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94122">
    <skos:scopeNote xml:lang="en">WWII secret bases, sometimes partially underground, intended for use by the British resistance in the eventuality of a foreign invasion.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170103">
    <skos:scopeNote xml:lang="en">A dam and sluice combination, associated with an aqueduct, for the extraction of water from a river to feed a reservoir or water treatment plant.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92130">
    <skos:scopeNote xml:lang="en">A building in which goods were kept prior to being cleared by customs officers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93823">
    <skos:scopeNote xml:lang="en">A licenced establishment where wine and other alcoholic drinks are sold for drinking on the premises.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71684">
    <skos:scopeNote xml:lang="en">A place where members of the British Legion meet.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92430">
    <skos:scopeNote xml:lang="en">An educational establishment, often privately funded, for young women.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87799">
    <skos:scopeNote xml:lang="en">A pier where passsengers can embark and disembark and goods can be transferred to and from vessels.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92100">
    <skos:scopeNote xml:lang="en">A street lamp in which the light is produced by the burning of coal gas. More recently natural gas has been used.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70873">
    <skos:scopeNote xml:lang="en">Manmade constructions used to prevent rivers breaking their banks and flooding the surrounding area with water. Often taking the form of a bank or wall.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78243">
    <skos:scopeNote xml:lang="en">A pond with underwater arches where the poles for masts were stored to prevent them from drying and splitting.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91328">
    <skos:scopeNote xml:lang="en">Traditionally a dock where cambering, the bending of beams for shipbuilding, took place. Now used for a small dock.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/84016">
    <skos:scopeNote xml:lang="en">A closely mown lawn used for the game of croquet.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92604">
    <skos:scopeNote xml:lang="en">A waterwheel where the water enters at the same level as the axle.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94019">
    <skos:scopeNote xml:lang="en">A monument consisting of parallel lines of spaced post- holes which appears to mark out an approach to another monument or monuments.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70040">
    <skos:scopeNote xml:lang="en">A pit over which a  corpse has been cremated on a pyre into which the remains and debris, and sometime grave goods, collapse and are buried. Generally confined to the Roman period.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91825">
    <skos:scopeNote xml:lang="en">For commercial or non commercial use. See narrow terms in each class.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160364">
    <skos:scopeNote xml:lang="en">A building or site used for the storage and distribution of the essential logistical requirements of the Royal Navy.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93116">
    <skos:scopeNote xml:lang="en">A place where domestic refuse is collected for disposal.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92811">
    <skos:scopeNote xml:lang="en">A forcing house used for various types of fruit which first appeared in the 19th century. Lean-to houses were used for wall-grown fruit and free-standing houses for fruit grown in pots or for trees planted in the ground.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68955">
    <skos:scopeNote xml:lang="en">A dwelling built on marshy, boggy or waterlogged land using timber piles driven vertically into the ground to raise the floor above the ground to prevent flooding.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70347">
    <skos:scopeNote xml:lang="en">A stone (including standing stones, natural boulders and rock outcrops) decorated with carved motifs.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93751">
    <skos:scopeNote xml:lang="en">Outdoor site for domestic washing, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69438">
    <skos:scopeNote xml:lang="en">Sites, building, structures &amp; features associated with the construction, maintenance &amp; supply of maritime craft. Includes associated ancillary structures such as navigation aids, dockyards, wharves, etc; does not include vessels.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92747">
    <skos:scopeNote xml:lang="en">A specialist hospital for the medical and surgical treatment of kidney disorders and diseases.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91023">
    <skos:scopeNote xml:lang="en">Use where the intervening arcade is closed but timber-framed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93752">
    <skos:scopeNote xml:lang="en">A building containing a range of processes for cleaning and processing metallic ores.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93028">
    <skos:scopeNote xml:lang="en">The residence of the head or president of a chapter, or community of religious persons.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92548">
    <skos:scopeNote xml:lang="en">A dock or basin, often inland, used for mooring yachts and other small pleasure craft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68824">
    <skos:scopeNote xml:lang="en">A site where guns, mortars or searchlights are mounted. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70335">
    <skos:scopeNote xml:lang="en">A fence or barrier made of metal or wooden rails.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93110">
    <skos:scopeNote xml:lang="en">A building wherein silk worm cocoons are boiled to release the silk fibres.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69043">
    <skos:scopeNote xml:lang="en">A straight road lined with trees along either side, also straight lines of trees found in parkland usually leading to a landscape feature.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70596">
    <skos:scopeNote xml:lang="en">A site where the manufacture of glass bottles takes place.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99961">
    <skos:scopeNote xml:lang="en">Planned &amp;/or landscaped areas designed for aesthetic or recreational purposes. Includes all sites, buildings, structures &amp; features normally associated with parks &amp; urban spaces including street furniture.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140101">
    <skos:scopeNote xml:lang="en">A place for sharpening metal objects like tools and weapons.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93993">
    <skos:scopeNote xml:lang="en">A public recreational complex centred around an open-air swimming pool. Use SWIMMING POOL as a component of LIDO.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92116">
    <skos:scopeNote xml:lang="en">A specialist hospital where the elderly receive medical treatment.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70857">
    <skos:scopeNote xml:lang="en">A signpost, usually placed at a juntion or crossroads, bearing a number of individual signs radiating outward from the post to indicate locations in several directions.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92290">
    <skos:scopeNote xml:lang="en">A specialist hospital for the medical and surgical treatment of fistular and rectal disorders and diseases.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162564">
    <skos:scopeNote xml:lang="en">An anti tank wall constructed specifically to be used for training purposes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70098">
    <skos:scopeNote xml:lang="en">A small, circular Late Neolithic/Early Bronze Age enclosure which bears a morphological resemblance to henges, but may belong to another category of circular earthwork-defined monuments, or is enclosed by something other than a bank and ditch.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69974">
    <skos:scopeNote xml:lang="en">The building attached to a cathedral or collegiate church where the dean, prebendaries or monks and canons met for the transaction of business.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93613">
    <skos:scopeNote xml:lang="en">A structure providing protection against the weather at tram stops.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68834">
    <skos:scopeNote xml:lang="en">A castle erected without permission, ie. without a royal licence to crenellate.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/169911">
    <skos:scopeNote xml:lang="en">A building used as a temporary form of accommodation during a holiday, which includes self-catering.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99585">
    <skos:scopeNote xml:lang="en">Buildings, sites and structures associated with the production, testing and storage of explosives.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92445">
    <skos:scopeNote xml:lang="en">A house to receive boat landings.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93151">
    <skos:scopeNote xml:lang="en">A sign, often mounted on a post next to a roadside, giving directions or other instructions.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71549">
    <skos:scopeNote xml:lang="en">A room in a school devoted to the formal instruction of pupils.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70076">
    <skos:scopeNote xml:lang="en">A prehistoric coffin made out of a hollow tree trunk.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91697">
    <skos:scopeNote xml:lang="en">A hospital where elderly people receive medical treatment, but not overnight accommodation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91290">
    <skos:scopeNote xml:lang="en">An alloy of tin, antimony and copper used as a replacement for pewter.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91552">
    <skos:scopeNote xml:lang="en">A stall where a cobbler mends shoes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/147526">
    <skos:scopeNote xml:lang="en">A purpose built theatre with a central open yard, dating to the Elizabethan period. Famous examples include The Globe and the Swan.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92939">
    <skos:scopeNote xml:lang="en">Mill for producing a smooth surface and edges on newly sawn timber.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69017">
    <skos:scopeNote xml:lang="en">A garden of regular, linear or geometrical design, often associated with the traditional Italian, French and Dutch styles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/132213">
    <skos:scopeNote xml:lang="en">A tower, consisting of one or several testing shafts, for testing lifts and for training personnel.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159198">
    <skos:scopeNote xml:lang="en">A largely residential area on the outskirts of a town or city.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91980">
    <skos:scopeNote xml:lang="en">A stone, terracotta, wooden or metal receptacle used to grow flowers in.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140099">
    <skos:scopeNote xml:lang="en">A type of large steel framed aircraft hangar introduced by the Royal Air Force in its Expansion Period with a number of designs between 1934 and 1939, to accomodate heavy bombers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69970">
    <skos:scopeNote xml:lang="en">A chapel attached to, or inside, a church, endowed for the celebration of Masses for the soul of the founder.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69022">
    <skos:scopeNote xml:lang="en">A shady cavern built as a garden feature. In the 18th century it usually took the form of an artificial rocky cave or apartment decorated with stalactites and shells in a wild part of the grounds.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141830">
    <skos:scopeNote xml:lang="en">Obstacles, including scaffolding and anti tank blocks designed to impede an enemy's attempts to land forces onto open beaches.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94213">
    <skos:scopeNote xml:lang="en">A spatially discrete, though sometimes extensive, scatter of lithic artefacts recovered from the surface, eg. by fieldwalking, rather than from a particular archaeological context. Use particular types where appropriate.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99568">
    <skos:scopeNote xml:lang="en">A chemical works engaged in the production of Ammonium Perchlorate, a product used in the explosives industry.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70711">
    <skos:scopeNote xml:lang="en">A factory containing machinery for processing clay for the manufacture of bricks, tiles or pottery.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/90995">
    <skos:scopeNote xml:lang="en">A separate hospital building, or block of an asylum, where new arrivals were segregated from old inmates for a defined period. This system was developed from the mid-19th century onwards.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159194">
    <skos:scopeNote xml:lang="en">A barn in which a central space is separated from a side aisle by posts and braces.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93200">
    <skos:scopeNote xml:lang="en">A workshop in which saggars - fire clay boxes to protect ware from direct action of flame and gases during firing - were manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143529">
    <skos:scopeNote xml:lang="en">This is a pit used in the glass industry for the production of cylinder glass. The only surviving examle in England is at the Hartley Wood Glasworks, Sunderland. It is a feature of 19th century and later glassworks</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92213">
    <skos:scopeNote xml:lang="en">Buildings and structures associated with good health and recreation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92842">
    <skos:scopeNote xml:lang="en">A waterwheel turned by the force of water falling upon the top of the wheel into buckets placed round the circumference.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71478">
    <skos:scopeNote xml:lang="en">A light, ornamental building or structure situated close to the sea.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92663">
    <skos:scopeNote xml:lang="en">Buildings and structures associated with the mining industry.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/139028">
    <skos:scopeNote xml:lang="en">A building or site used in the production of enamelled goods.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68959">
    <skos:scopeNote xml:lang="en">A house by a toll gate or toll bridge where tolls are collected.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71836">
    <skos:scopeNote xml:lang="en">Engineering workshop intended either for final adjustments of new machinery or the fitting of replacement parts to machinery under repair.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/144509">
    <skos:scopeNote xml:lang="en">A quarry for the extraction of Soapstone (also known as steatite or soaprock), a metamorphic rock largely composed of the mineral talc and rich in magnesium.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160355">
    <skos:scopeNote xml:lang="en">A designated area of water in which the perfromance of torpedoes can be evaluated.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160518">
    <skos:scopeNote xml:lang="en">A building housing the generator set and associated equipment supplying electricity to a radar station.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/146354">
    <skos:scopeNote xml:lang="en">A Very High Frequency device to allow aircraft to pinpoint their position as an aid to naviagation. Built as part of the Rotor programme.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94173">
    <skos:scopeNote xml:lang="en">A structure or building used in the manufacture of the explosive cordite. After the cordite had been pressed to extract moisture it was placed on racks within the stove prior to being taken to the reeling house for winding.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143172">
    <skos:scopeNote xml:lang="en">A purpose built indoor cricket facility for training and playing matches</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93420">
    <skos:scopeNote xml:lang="en">Buildings, sites and structures associated with the production and use of steam power.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93731">
    <skos:scopeNote xml:lang="en">A building or complex, often associated with a historic site or place of interest, containing interpretation panels and information for visitors to the site or area.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/100539">
    <skos:scopeNote xml:lang="en">A structure, building or room within a building, used by a local authority for the continuance of local government in the event of a military or civil emergency.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70178">
    <skos:scopeNote xml:lang="en">A pit which appears to have been dug for, or which contains, objects apparently deposited for reasons other than storage, disposal or extraction. Index with principal object types.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164103">
    <skos:scopeNote xml:lang="en">A building, often converted from its original use, for use as a temporary accommodation by members of the Women's Land Army during the First and Second World Wars.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68641">
    <skos:scopeNote xml:lang="en">An enclosed piece of ground devoted to the cultivation of flowers, fruit or vegetables and/or recreational purposes. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91699">
    <skos:scopeNote xml:lang="en">A hospital block where patients come for day-care medical treatment.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162618">
    <skos:scopeNote xml:lang="en">A farmstead where mostly detached buildings have developed around two sides of an open cattle yard.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141169">
    <skos:scopeNote xml:lang="en">A horizontal surface separating the base of a rampart or earthwork from an associated ditch or moat. Can also refer to a continuously sloping bank of earth against a wall, as in a fortified city wall.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70400">
    <skos:scopeNote xml:lang="en">A spatially discrete group of pits usually containing artefactual material with little or no accompanying evidence for structural features.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/163227">
    <skos:scopeNote xml:lang="en">A grave marker in the form of a casket.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93397">
    <skos:scopeNote xml:lang="en">A place of accommodation for a stablehand.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160347">
    <skos:scopeNote xml:lang="en">A building used for the daily administration of an army.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93414">
    <skos:scopeNote xml:lang="en">A lock or a dam in a river.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68853">
    <skos:scopeNote xml:lang="en">A linear earthwork, usually a bank accompanied by a ditch, which runs across rather than along an area or ridge of higher ground.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69362">
    <skos:scopeNote xml:lang="en">A building housing an engine. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91832">
    <skos:scopeNote xml:lang="en">A device with a funnel-shaped entrance designed for catching eels.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68733">
    <skos:scopeNote xml:lang="en">A wooden frame with holes, through which the head and hands of an offender were thrust, in which state they would be exposed to public ridicule and assault.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99577">
    <skos:scopeNote xml:lang="en">A factory or works engaged in the manufacture of the explosive guncotton. They may be found as separate factories or form part of a cordite factory.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92236">
    <skos:scopeNote xml:lang="en">A waterwheel where the water enters below the top of the wheel but above the axle.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/139032">
    <skos:scopeNote xml:lang="en">A kiln used for extracting salt through the evaporation of salt water.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71335">
    <skos:scopeNote xml:lang="en">A medieval house with central open hall and two storey bays, jettied at first floor level, on either side.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70195">
    <skos:scopeNote xml:lang="en">A place of worship for Jewish people.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70920">
    <skos:scopeNote xml:lang="en">A building or structure for the storage of processed minerals, chemicals or agricultural products, etc. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87656">
    <skos:scopeNote xml:lang="en">A warehouse, usually under the charge of CUSTOM HOUSE officials, in which goods were stored before the duty had been paid. Often found in dockyards, harbours, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71784">
    <skos:scopeNote xml:lang="en">A commercial building used primarily as a trading place for wool merchants.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92861">
    <skos:scopeNote xml:lang="en">A building in which a parliament meets and conducts the business of government.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162894">
    <skos:scopeNote xml:lang="en">A pit containing the waste product form iron working.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140264">
    <skos:scopeNote xml:lang="en">The limit line of a medieval local administrative unit of a hundred.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140543">
    <skos:scopeNote xml:lang="en">A fighter satellite station watch office built to Air Ministry design drawing number 18441/40.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70464">
    <skos:scopeNote xml:lang="en">A receptacle for the storage of water.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93563">
    <skos:scopeNote xml:lang="en">A gate which allows water to pass into a dock, etc, at flood tide, and by which it is retained during the ebb tide.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70328">
    <skos:scopeNote xml:lang="en">An earthwork used as a boundary marker.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159264">
    <skos:scopeNote xml:lang="en">Device for extracting juice from apples, usually crab apples, for use in cooking and medicine. Consists of a stone base carved with channels in the upper surface which was used with an upper weight, often secured with a wooden beam wedged into position.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92529">
    <skos:scopeNote xml:lang="en">Apparatus used for applying a mechanical force, or to perform a particular function. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68727">
    <skos:scopeNote xml:lang="en">A chair fixed to the end of a plank, in which scolds or dishonest people were tied and ducked in water as a punishment.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170104">
    <skos:scopeNote xml:lang="en">A gate, made of wood, used as a livestock barrier by continuing a fence line across a river or stream. The gate usually consists of a series of  droppers, that can float up and down depending on water levels, attached to a length of cable or wooden pole.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93653">
    <skos:scopeNote xml:lang="en">A 19th century Tudor revival garden.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68748">
    <skos:scopeNote xml:lang="en">A hall built for the use of people living within a parish boundary.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143969">
    <skos:scopeNote xml:lang="en">A coastal site producing salt by solar evaporation of seawater in a series of PONDS, without any boiling stage</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69818">
    <skos:scopeNote xml:lang="en">A large stone used by cattle to rub up against and so scratch themselves.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164117">
    <skos:scopeNote xml:lang="en">A system of lights to aid aircraft when landing at night. When viewed from above the runway lights form an outline of the runway.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/151259">
    <skos:scopeNote xml:lang="en">A prefabricated structure of a steel frame clad in corrugated iron. Semi-circular in section they were used for storage and as workshops, cinemas etc during WWII. Designed at Romney House, London by the Directorate of Fortifications &amp; Works.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69386">
    <skos:scopeNote xml:lang="en">A conical or flat-topped tip of waste discarded from a mine or similar site.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69456">
    <skos:scopeNote xml:lang="en">A sheltered port for ships.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69111">
    <skos:scopeNote xml:lang="en">A place where lead ore is extracted from an open cast mine.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160515">
    <skos:scopeNote xml:lang="en">A military base used for training service personnel.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78149">
    <skos:scopeNote xml:lang="en">Prehistoric structure consisting of three or more standing stones in close proximity to each other, forming an unroofed approximately rectangular structure open in one direction.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93831">
    <skos:scopeNote xml:lang="en">A factory or works used for the production of turpentine, wood alcohol and similar chemicals by the distillation of pulped wood.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91497">
    <skos:scopeNote xml:lang="en">A factory where tobacco pipes made of clay are manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70336">
    <skos:scopeNote xml:lang="en">A structure with a roof to provide shelter from the weather for occupants or contents. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69411">
    <skos:scopeNote xml:lang="en">A factory where lace is manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/135095">
    <skos:scopeNote xml:lang="en">A manufacturing site producing weaving shuttles for the textile industry.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68685">
    <skos:scopeNote xml:lang="en">A building, department or shop where postal business is carried on.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92968">
    <skos:scopeNote xml:lang="en">The residence of an admiral of a port.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71809">
    <skos:scopeNote xml:lang="en">A site including a pitch, stands and other ancillary buildings associated with the game of football.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68971">
    <skos:scopeNote xml:lang="en">A dwelling, located at the entrance, or gates, to an estate or park, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70365">
    <skos:scopeNote xml:lang="en">An area of land, roughly shaped like a polygon and enclosed by a boundary ditch, bank, wall, palisade or similar barrier.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71293">
    <skos:scopeNote xml:lang="en">A house in a line of houses attached to and adjoining one another and planned and built as one unit.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71667">
    <skos:scopeNote xml:lang="en">A barracks including stables and associated buildings housing a cavalry regiment.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140137">
    <skos:scopeNote xml:lang="en">A type of steel framed transportable British military aircraft hangar developed from 1941onwards. The hangar had a steel frame, some versions used commercially available sheeting for cladding. It was similar to but smaller than the arcraft hangar type T2.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160298">
    <skos:scopeNote xml:lang="en">Blocks of concrete with four protruding arms so that, whichever way up the caltrop is placed, one arm will always point upward. Used in imitation of the iron caltrops thrown on the ground to impede cavalry.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93734">
    <skos:scopeNote xml:lang="en">A school built and/or supported by voluntary contributions.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68633">
    <skos:scopeNote xml:lang="en">A group or complex of fields which appear to form a coherent whole. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/163053">
    <skos:scopeNote xml:lang="en">A workshop used in the manufacture and preparation of cotton</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91957">
    <skos:scopeNote xml:lang="en">A crane fixed to a quay, used for the unloading of ships cargoes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93510">
    <skos:scopeNote xml:lang="en">A building used to dry teazle heads in. Teazles were used to raise the nap on cloth in teazle shops.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/146350">
    <skos:scopeNote xml:lang="en">A coupled timber built end-opening First World War aircraft hangar.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160248">
    <skos:scopeNote xml:lang="en">A portable stand by set house built to Air Ministry drawing number 3527/43.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93411">
    <skos:scopeNote xml:lang="en">A board indicating the name of the railway station.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94351">
    <skos:scopeNote xml:lang="en">Sites, buildings and structures for the defence of the coastline from sea and air invasion.</skos:scopeNote>
  </rdf:Description>
