        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-12T15:24:25.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:03:17.000</terms:modified>
        <skos:altLabel xml:lang="en"> chevet vault </skos:altLabel>
        <skos:altLabel xml:lang="de">Chorgewölbe </skos:altLabel>
        <skos:definition xml:lang="de">Gewölbe über dem Chor einer Kirche, häufig ein mehrteiliges Kreuzgewölbe oder eine HaIbkuppel (Konche). [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Chorhauptgewölbe</skos:prefLabel>
