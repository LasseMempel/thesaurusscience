        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-15T15:43:02.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T14:53:12.000</terms:modified>
        <skos:altLabel xml:lang="de">Farbabstraktion</skos:altLabel>
        <skos:note xml:lang="de">Mit vier reinen Farben auf hellem Grund aufgetragen entsteht mit kurzen, überkreuzten Strichen eine abstrakte Farbstruktur, die sich optisch mit dem angrenzenden Original verbindet. (EwaGlos)</skos:note>
        <skos:note xml:lang="fr">Structure abstraite créée au moyen de quatre couleurs pures appliquées avec de courtes lignes hachurées sur un fond clair. Cette structure se fond optiquement avec l’original contiguë. (EwaGlos)</skos:note>
        <skos:note xml:lang="en">Using four pure colours on a light background applied with short hatched lines, an abstract structure is created. This structure merges optically with the contiguous original. (EwaGlos)</skos:note>
        <skos:prefLabel xml:lang="de">Astrazione cromatica</skos:prefLabel>
        <skos:prefLabel xml:lang="es">abstracción cromática</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">abstraction chromatique</skos:prefLabel>
        <skos:prefLabel xml:lang="ro">abstracție cromatică</skos:prefLabel>
        <skos:prefLabel xml:lang="pl">abstrakcja chromatyczna</skos:prefLabel>
        <skos:prefLabel xml:lang="en">astrazione cromatica</skos:prefLabel>
        <skos:prefLabel xml:lang="hr">astrazione cromatica</skos:prefLabel>
        <skos:prefLabel xml:lang="it">astrazione cromatica</skos:prefLabel>
        <skos:prefLabel xml:lang="tr">renk soyutlaması</skos:prefLabel>
        <skos:prefLabel xml:lang="hu">színabsztrakció</skos:prefLabel>
        <skos:prefLabel xml:lang="bg">Хроматична абстракция</skos:prefLabel>
    </owl:NamedIndividual>
    


