    <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
    <dc:publisher rdf:resource="https://historicengland.org.uk/"/>
    <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
    <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
    <skos:prefLabel xml:lang="en">Chalcolithic</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The transitional period at the end of the Neolithic when metal is first used to make tools and weapons. New burial rites and artefacts appear at the same time as these copper implements appear. Circa -2500 BCE to -2200 BCE.</skos:scopeNote>
    <skos:notation xml:lang="en">CH</skos:notation>
  </skos:Concept>

