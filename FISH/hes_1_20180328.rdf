		<skos:prefLabel xml:lang="gd">SGOIL-ÀRAICH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Sgoil do chlann glè òg, mar is trice eadar 3 is 5 bliadhna a dh'aois.</skos:scopeNote>
