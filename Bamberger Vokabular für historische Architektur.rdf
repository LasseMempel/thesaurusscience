        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T14:49:24.000</terms:modified>
        <skos:altLabel xml:lang="de">Fenstergriff</skos:altLabel>
        <skos:definition xml:lang="de">Bezeichnung für den Fenstergriff. [Noky 1996]</skos:definition>
        <skos:prefLabel xml:lang="de">Handhabe</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">madlo, přítuha</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_ff8b37b5 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_ff8b37b5">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
