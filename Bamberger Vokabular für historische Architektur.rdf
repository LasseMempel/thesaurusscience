        <skos:altLabel xml:lang="de">Strahlengewölbe</skos:altLabel>
        <skos:altLabel xml:lang="en">fan groning </skos:altLabel>
        <skos:altLabel xml:lang="en">fan tracery vault </skos:altLabel>
        <skos:altLabel xml:lang="de">stehendes Trichtergewölbe</skos:altLabel>
        <skos:altLabel xml:lang="fr">voûte en calice </skos:altLabel>
        <skos:altLabel xml:lang="fr">voûte à nervures rayonnantes</skos:altLabel>
        <skos:altLabel xml:lang="cs">vějířová klenba</skos:altLabel>
        <skos:definition xml:lang="de">Im weiteren Sinne [Im Bezug auf Fächergwölbe] Bezeichnung für Gewölbe, bei denen sich die Rippenbündel strahlenförmig von freistehenden Stützen aus entfalten. Wie der Grundriß zeigt, handelt es sich hierbei jedoch eigentlich um Sterngewölbe. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="es">bóveda en abanico</skos:prefLabel>
        <skos:prefLabel xml:lang="en">fan vault (broader context)</skos:prefLabel>
        <skos:prefLabel xml:lang="de">fächerartige Sterngewölbe</skos:prefLabel>
        <skos:prefLabel xml:lang="it">volta a ventaglio</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte en éventails (contexte plus large)</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_2effa5cc"/>
    </owl:NamedIndividual>
    


