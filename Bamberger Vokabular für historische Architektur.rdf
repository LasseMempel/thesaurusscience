        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T17:54:28.000</terms:modified>
        <skos:altLabel xml:lang="fr">chasuble en entonnoir</skos:altLabel>
        <skos:altLabel xml:lang="fr">chasuble en forme de cloche</skos:altLabel>
        <skos:definition xml:lang="de">Glockenkasel f; rundherum gleich langer, weiter, ärmelloser, geschlossener Mantel mit Kopfdurchschlupf; die Naht auf der Vorderseite ist durch Vertikalbesatz (—&gt; Kaselstab) verdeckt, den Rückenteil verziert bisweilen ein Kaselkreuz; bis etwa zum 13. Jh. war die Glockenkasel die übliche Form der Kasel. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Glockenkasel</skos:prefLabel>
        <skos:prefLabel xml:lang="en">bell chasuble</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">chasuble conique</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_d1a705c6"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_eb774bdc -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_eb774bdc">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
