	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk002383">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">cabinet niche</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Schranknische</skos:prefLabel>
