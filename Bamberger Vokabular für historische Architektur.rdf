    <!-- https://hist-arch-vocab.org/bvha#c_c962ed1e -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_c962ed1e">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_694d7977"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_f10222e0"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-30T16:28:39.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-03T15:48:12.000</terms:modified>
        <skos:definition xml:lang="de">Dieser Flächentyp [scheint] das ganze Mittelalter über in Gebrauch gewesen zu sein. [...] So kommen im 13. Jahrhundert geschwungene und im beginnenden 16. Jahrhundert auch Exemplare mit schmal ausgeschmiedetem Mittelstück und breiter ausgeschmiedeten Schneiden vor. [...] Eine typische Größe dürfte bei etwa 20 cm Kopflänge und 5 - 6 cm Schneidebreite gelegen haben. [Voelkle 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Doppelglattfläche</skos:prefLabel>
    </owl:NamedIndividual>
    


