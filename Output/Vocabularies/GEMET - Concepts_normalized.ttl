    skos:definition "renewable and environmentally safe energy"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "soft energy"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15271>,
