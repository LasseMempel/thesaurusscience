		<skos:prefLabel xml:lang="gd">EINNSEAN-GAOITHE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Inneal a tha ag obair air cumhachd na gaoithe 's a nì diofar rudan, a' gabhail a-steach bualadh arbhair, pumpadh is gintinn dealain.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">WIND ENGINE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
