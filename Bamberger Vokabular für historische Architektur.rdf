        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-23T20:11:50.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-23T20:21:39.000</terms:modified>
        <skos:altLabel xml:lang="de">Heiligenschrein</skos:altLabel>
        <skos:altLabel xml:lang="de">Schreinreliquiar</skos:altLabel>
        <skos:altLabel xml:lang="en">shrine</skos:altLabel>
        <skos:altLabel xml:lang="fr">écrin reliquaire</skos:altLabel>
        <skos:definition xml:lang="de">Reliquienschrein m; auch Schrein(chen)reliquiar n; Heiligenschrein m; lat. scrin(i)um; area (cum reliquiis); capsa; feretrum: bis etwa zum 12. Jh. ein kleinerer, tragbarer Reliquienbehälter mit einem sattel- oder walmdachförmigen Deckel, später meist ein ortsfester Schrein aus Holz oder Metall, der mit Edelsteinen verziert und oft auch architektonisch gestaltet ist. Die bevorzugte Form des Reliquiars. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Reliquienschrein</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">châsse</skos:prefLabel>
        <skos:prefLabel xml:lang="en">feretory</skos:prefLabel>
    </owl:NamedIndividual>
    


