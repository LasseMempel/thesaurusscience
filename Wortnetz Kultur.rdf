	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021120">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">fan (equipment)</skos:prefLabel>
		<skos:altLabel xml:lang="en">fans (equipment)</skos:altLabel>
		<skos:prefLabel xml:lang="de">Ventilator</skos:prefLabel>
		<skos:altLabel xml:lang="de">Ventilatoren</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006132"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013707"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk006132"/>
		<skos:definition xml:lang="de">Ein Ventilator ist ein Gerät, das in der Regel aus einem elektrisch angetriebenen rotierenden Flügel- oder Schaufelrad besteht. Dadurch wird die Luft in Bewegung versetzt, was für Belüftung und Kühlung sorgt.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300209970"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q6498398"/>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4062522-9"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk006132"/>
