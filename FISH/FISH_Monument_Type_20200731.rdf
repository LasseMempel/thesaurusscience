  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68976">
    <skos:scopeNote xml:lang="en">A house for storing or drying saddles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71834">
    <skos:scopeNote xml:lang="en">A place of worship for members of the Congregational Church. These churches, the first of which was founded in 1616 in Southwark, practised self government. Most of them were merged to form the United Reformed Church in 1972.</skos:scopeNote>
  </rdf:Description>
