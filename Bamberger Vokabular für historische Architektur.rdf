        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-05T14:11:19.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T16:40:03.000</terms:modified>
        <skos:definition xml:lang="de">Ein Bauschaden, der z.B. in den Gurtbogen mittelalterlicher Gewölbe auftritt, deren Form sich unter Einwirkung des Druckes verändert. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Bruchverformung</skos:prefLabel>
        <skos:prefLabel xml:lang="en">deformation by stress</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">déformation par pression</skos:prefLabel>
    </owl:NamedIndividual>
    


