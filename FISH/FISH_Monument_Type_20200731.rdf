    <skos:scopeNote xml:lang="en">A building used for the care of the sick. Only to be used where part of a complex, eg. a workhouse. In such cases use with appropriate monument type.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160418">
    <skos:scopeNote xml:lang="en">An emplacement mounting a small, portable electrically-powered searchlight.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91004">
