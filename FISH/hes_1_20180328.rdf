		<skos:prefLabel xml:lang="gd">TAIGH-SGOILE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite-còmhnaidh a tha co-cheangailte ri sgoil, mar is trice bhiodh tidsear na sgoile a' fuireach ann.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SCHOOLHOUSE</skos:prefLabel>
