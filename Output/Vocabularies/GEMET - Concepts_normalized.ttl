    skos:definition "A formulated or systematic method for following or tracing environmentally related issues or concerns."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Zielverfolgungsplan"@de,
