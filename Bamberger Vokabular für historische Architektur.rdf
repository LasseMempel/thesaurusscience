        <skos:altLabel xml:lang="de">Cochlearium</skos:altLabel>
        <skos:altLabel xml:lang="de">Heiliger Löffel</skos:altLabel>
        <skos:altLabel xml:lang="fr">cuiller de calice</skos:altLabel>
        <skos:definition xml:lang="de">Kelchlöffelchen n; heiliger Löffel m; Cochlearium n (lat.): ein langstieliger, meist siIbervergoldeter Löffel, mit dem bei der Messe dem Messwein einige Tropfen Wasser beigefügt werden. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Kelchlöffelchen, ein Löffelchen zur Entnahme des dem Wein beizufügenden Wassers. [RDK Labor]</skos:definition>
        <skos:prefLabel xml:lang="de">Kelchlöffel</skos:prefLabel>
        <skos:prefLabel xml:lang="la">cochlear</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">cuiller eucharistique</skos:prefLabel>
        <skos:prefLabel xml:lang="en">eucharistic spoon </skos:prefLabel>
        <skos:prefLabel xml:lang="cs">lžička</skos:prefLabel>
    </owl:NamedIndividual>
    


