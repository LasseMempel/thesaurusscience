    skos:closeMatch <http://data.uba.de/umt/_00019548>,
        <http://dbpedia.org/resource/Polychlorinated_terphenyl> ;
    skos:definition "Compounds consisting of three benzene rings linked to each other in either ortho, meta or para positions and substituted with chlorine atoms."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Polychlorterphenyle"@de,
        "polychlorinated terphenyl"@en .

