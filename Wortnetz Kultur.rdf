		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk014765"/>
		<skos:definition xml:lang="de">Eine Karaffe ist eine bauchige, gläserne Flasche, in der Regel mit Stöpsel verschließbar. Antike Karaffen sind häufig verziert, beispielsweise durch Bemalung, Emaildekor oder eine Gravur.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300198495"/>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4684947-6"/>
		<skos:closeMatch rdf:resource="https://www.wikidata.org/wiki/Q1104430"/>
