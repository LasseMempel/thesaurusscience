        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-26T17:34:36.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T16:20:31.000</terms:modified>
        <skos:altLabel xml:lang="de">Speculum humanae salvationis</skos:altLabel>
        <skos:altLabel xml:lang="fr">Speculum humanae salvationis</skos:altLabel>
        <skos:definition xml:lang="de">Heilsspiegel m, Speculum humanae salvationis n: Buch mit Text und Bilderfolgen (Holzschnitten), in dem das Erlösungswerk Christi dem Alten Testament typologisch gegenübergestellt wird; im 14. und 15. Jh. sehr verbreitet. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Heilsspiegel</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">miroir du Salut</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">zrcadlo lidského spasení</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_5b1728ea -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_5b1728ea">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_3e25acca"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-18T16:39:06.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T13:17:52.000</terms:modified>
        <skos:altLabel xml:lang="en">panel</skos:altLabel>
        <skos:altLabel xml:lang="en">vaulting cell</skos:altLabel>
        <skos:definition xml:lang="de">Der durch Rippen oder Grate begrenzte, kleinste Abschnitt der Leibung. Zu unterscheiden vom Gewölbefeld. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Gewölbefach</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">compartiment de l\&apos;intrados</skos:prefLabel>
        <skos:prefLabel xml:lang="en">vaulting compartment</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_3e25acca"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_5b2c8533 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_5b2c8533">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b320e26f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-16T14:26:03.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-18T15:03:45.000</terms:modified>
        <skos:altLabel xml:lang="cs">bašta</skos:altLabel>
        <skos:altLabel xml:lang="cs">val</skos:altLabel>
        <skos:definition xml:lang="de">Eine mit Bohlen befestigte, zumeist runde Erdaufschüttung als behelfsmäßiges, flankierendes, vor dem Hauptwall vorspringendes Verteidigungswerk, danach allg. eine vorgeschobene Verteidigungsanlage (Barbakane, Bastille, Bastion). [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">In der älteren Burgen- und Festungsforschung undifferenziert für Geschützturm, Rondell, Bastion und teils auch für andere Festungswerke genutzte Bezeichnung. Schon zeitgenössisch nicht fest definiert, wird in der neueren Festungsforschung weitgehend auf diesen Begriff verzichtet. M. L. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:prefLabel xml:lang="de">Bollwerk</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">bašta </skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_5b3bc666 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_5b3bc666">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b61e4876"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T12:44:02.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T17:59:36.000</terms:modified>
        <skos:definition xml:lang="cs">Obrácená perspektiva, která se často používala v raně křesťanském a středověkém malířství, předměty zkracuje perspektivně nikoliv ve směru od pozorovatele k pozadí, nýbrž z pohledu hlavní postavy na obraze ve směru k pozorovateli. Tyto zdánlivě navzájem si odporující formy perspektivy je třeba chápat méně matematicky a více duchovně historicky: Rané křesťanství a středověk spatřovaly v uctívaném, a proto zobrazovaném, předmětu podobenství božského řádu, který byl zároveň východiskem (i perspektivního) řádu světa. Proto se také postavy v popředí, které mají menší význam, objevují jako menší než postavy ve středu nebo v pozadí (,,významová perspektiva&quot;). Až renesance učinila pozorujícího člověka měřítkem všech věcí. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Umgekehrte Perspektive</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">obrácená perspektiva</skos:prefLabel>
    </owl:NamedIndividual>
    


