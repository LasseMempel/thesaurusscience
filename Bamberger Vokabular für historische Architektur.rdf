    <!-- https://hist-arch-vocab.org/bvha#c_7ce7b01c -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_7ce7b01c">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1655dbba"/>
