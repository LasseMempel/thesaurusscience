    <!-- https://hist-arch-vocab.org/bvha#c_de3d0514 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_de3d0514">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_ed000bbf"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-22T10:22:58.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-28T09:04:32.000</terms:modified>
        <skos:definition xml:lang="de">Schauseite der Orgel. In der Gotik ähnlich dem Flügelaltar oft mit Gesprenge und bemalten Flügeltafeln versehen, im Barock zu gewaltigen Ausmaßen gesteigert, mit marmoriertem Holzgehäuse, Schmiedeeisen, Zimbelstern ( = sternförmiges, drehbares Glockenspielwerk) und Figurenschmuck ausgestattet. Die überreiche Ornamentik, Putten u. ä. des Rokoko lösen die architektonische Klarheit auf. Heute setzt sich der »offene« Orgelprospekt durch, der allein durch die harmonische Anordnung der Pfeifen wirkt. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">VARHANNÍ PROSPEKT, pohledová strana varhan, v gotice podobně jako křídlový oltář často s nástavcem a malovanými křídelními deskami, v baroku zvětšena do rozsáhlých rozměrů, s mramorovanou dřevěnou skříní, kováním, talířovou hvězdou (= hvězdicovou, otočnou zvonkohrou) a figurální výzdobou. V rokoku pak nadměrná ornamentika, putti a jiné prvky narušují architektonickou čistotu. Dnes se prosazuje &quot;otevřený&quot; varhanní prospekt, který působí výhradně harmonickým uspořádáním píšťal. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Orgelprospekt</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">varhanní prospekt</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_de42b256 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_de42b256">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f331bfd9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-05T18:16:23.000</terms:created>
