        <skos:definition xml:lang="de">Bei Holzverbindungen der Einschnitt eines Holzes, in den sich der Ausschnitt des anderen einfügt, z.B. Blattsasse. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Sasse</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_ea2b41ae -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_ea2b41ae">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_cee0b345"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_19d56a39"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-18T12:37:19.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-30T10:24:27.000</terms:modified>
        <skos:altLabel xml:lang="de">Glockenhelm</skos:altLabel>
        <skos:altLabel xml:lang="fr">toit en cloche</skos:altLabel>
        <skos:definition xml:lang="de">Turmdächer mit geschweifter Kontur werden Haubendach oder Kuppeldach genannt. Hierzu gehören die Welsche Haube, das Zwiebeldach und – bei kreisförmiger Grundfläche – das Glockendach. [Eißing et al. 2012]</skos:definition>
        <skos:prefLabel xml:lang="de">Glockendach</skos:prefLabel>
        <skos:prefLabel xml:lang="en">bell roof</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">coupole campanulée</skos:prefLabel>
        <skos:prefLabel xml:lang="es">techo acampanado</skos:prefLabel>
        <skos:prefLabel xml:lang="it">tetto a campana</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">zvonová střecha</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Glockendach, Dachform, die oben konvex, unten konkav ausschwingt und hauptsächl. bei Turmbekrönungen vorkommt. [Koepf / Binding 2016]</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_ea3b29a9 -->


