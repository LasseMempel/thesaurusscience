        <skos:altLabel xml:lang="fr">Père</skos:altLabel>
        <skos:altLabel xml:lang="la">pater monasterii</skos:altLabel>
        <skos:definition xml:lang="de">Abt m; lat. abbas; pater monasterii: Vorsteher einer klösterlichen Gemeinschaft. Ein infulierter Abt m ist berechtigt, die Mitra zu tragen. Seine Rangfarbe ist Schwarz bzw. Violett. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Abt</skos:prefLabel>
        <skos:prefLabel xml:lang="la">abbas</skos:prefLabel>
        <skos:prefLabel xml:lang="en">abbot</skos:prefLabel>
