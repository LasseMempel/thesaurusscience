	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk007278">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">melting pot</skos:prefLabel>
		<skos:altLabel xml:lang="en">melting pots</skos:altLabel>
		<skos:prefLabel xml:lang="de">Schmelztiegel</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk007276"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019145"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk020718"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk007276"/>
		<skos:definition xml:lang="de">Ein Schmelztiegel ist ein Tiegel, der zum Verflüssigen von Metallen oder anderen Stoffen durch Hitze dient. Dabei kann auch eine Raffination oder Mischung der Schmelze stattfinden. In den meisten Fällen wird das geschmolzene Material auch direkt aus dem Tiegel gegossen, bei manchen Anwendungen wird die Schmelze aber auch auf andere Weise entnommen, etwa beim Glasblasen mithilfe einer Glasmacherpfeife, oder auch nach dem Abkühlen durch mechanische Verfahren, etwa durch Zerstören des Schmelztiegels. Daher gibt es flachere und höhere Schmelztiegel ebenso wie solche mit und ohne Ausguss. Schmelztiegel kommen etwa in Gießereien, Münzstätten, Maschinenfabriken oder der Schmuckherstellung zur Anwendung.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4339107-2"/>
		<skos:mappingRelation rdf:resource="http://vocab.getty.edu/aat/300417959"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk007276"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019145"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk020718"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-06-10T12:35:57+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk007288">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">gas mask tin</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Gasmaskenbehälter</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000202"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk004498"/>
		<skos:definition xml:lang="de">Ein Gasmaskenbehälter ist ein Behälter, der zur Aufbewahrung einer Gasmaske dient. Seine Form ist  zylindrisch, er wird mit einem Deckel verschlossen ist und ist an der Außenseite mit Vorrichtungen versehen ist, die es ermöglichen ihn am Gürtel zu tragen.</skos:definition>
