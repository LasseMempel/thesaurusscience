        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-06T18:26:16.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T22:43:53.000</terms:modified>
        <skos:altLabel xml:lang="de">Bugia</skos:altLabel>
        <skos:altLabel xml:lang="de">Palmatoria</skos:altLabel>
        <skos:altLabel xml:lang="fr">bougeoir épiscopal</skos:altLabel>
        <skos:altLabel xml:lang="la">bugia</skos:altLabel>
        <skos:altLabel xml:lang="la">palmatoria</skos:altLabel>
        <skos:altLabel xml:lang="en">pontifical candlestick</skos:altLabel>
        <skos:definition xml:lang="de">Pontifikalleuchter m; auch Bugia f (lat.); Palmatoria f (lat.); lat. lumen fidei: ein silberner Handleuchter mit einem großen Lichtteller. Er wird mit einer brennenden Kerze als zusätzlicher Lichtquelle vom Messdiener während der Lesungen beim PontifikaIamt gehalten. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Pontifikalleuchter</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">bougeoir pontifical</skos:prefLabel>
        <skos:prefLabel xml:lang="en">bugia</skos:prefLabel>
        <skos:prefLabel xml:lang="la">lumen fidei</skos:prefLabel>
    </owl:NamedIndividual>
    


