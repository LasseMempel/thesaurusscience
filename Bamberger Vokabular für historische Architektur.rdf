    <!-- https://hist-arch-vocab.org/bvha#c_15137f46 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_15137f46">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_4f3228a9"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_7hgs39ux"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_9jb9am2u"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_bci8b96z"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_46f2f1d7"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_a9c01a56"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_f861ef30"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-05T21:20:48.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T14:59:16.000</terms:modified>
        <skos:note xml:lang="en">A solid or semi-solid, slightly greasy, water-insoluble, organic substance, principally containing compounds of high molecular weight. They are derived from animals, plants, petroleum or are synthetic in origin. [EwaGlos]</skos:note>
        <skos:note xml:lang="de">Eine feste oder halbfeste, leicht fettige, wasserunlösliche, organische Substanz, die hauptsächlich aus Verbindungen mit hohem Molekulargewicht besteht. Diese werden aus Tieren und deren Absonderungen, Pflanzen und Erdöl gewonnen oder synthetisch hergestellt. [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="de">Wachs</skos:prefLabel>
        <skos:prefLabel xml:lang="en">wax</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_1514fd0f -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_1514fd0f">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_80695e85"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_3065d503"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_36c13f23"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_5c247607"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_831298e5"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_c5fe527e"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-04-10T15:42:07.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-26T09:14:23.000</terms:modified>
        <skos:altLabel xml:lang="en">Ashlar stone masonry</skos:altLabel>
        <skos:altLabel xml:lang="de">Maçonnerie de pierre de taille</skos:altLabel>
        <skos:altLabel xml:lang="de">Werksteinmauer</skos:altLabel>
        <skos:altLabel xml:lang="cs">kvádříkové zdivo</skos:altLabel>
        <skos:altLabel xml:lang="la">opus romanum</skos:altLabel>
        <skos:altLabel xml:lang="cs">zdivo z tesaného kamene</skos:altLabel>
        <skos:definition xml:lang="de"> Konstruktion aus natürlichen, groben Steinen, selbsttragend (Trockenmauerwerk) oder mit Mörtel zusammengefügt (als Schichtenmauerwerk oder in wildem Mauerwerksverband) (EwaGlos)</skos:definition>
        <skos:definition xml:lang="cs">= opus romanum: a) obdelníkové kvádry ve vodorovných vrstvách běhounů a vazáků = opus quadratum; b)vrstvy o stejné výšce = opus isodomum; c) proměnlivá výška vrstvy = opus pseudoisodomum, opus vittatum; d) rustikové, bosované z. = opus rusticum, hrubě opracované basové kvadry (pohledová strana = bosa, odtud bosáž); e) s lemováním kamenného kvádru stezkou; f) diamantový kvádr; g) kvádr s polštářovou bosou. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Mauerwerk aus Quadersteinen. [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Mauerwerk aus steinmetzmäßig bearbeiteten Natursteinen, bei dem Ansichts-, Lager- und Stoßfläche der Steine rechtwinklig zueinanderstehen. Lager- und Stoßfugen müssen in ganzer Tiefe bearbeitet sein. Die Ansichtsfläche der Quader, der Spiegel m, kann unterschiedlich bearbeitet sein. (Glossarium Artis, Bd. 3, Bögen und Mauerwerk)</skos:definition>
        <skos:note xml:lang="en">A type of stone masonry which uses regularly cut blocks of stones, of almost uniform size, usually bigger than bricks (selfsustaining or properly bonded with mortar with very thin and uniform joints). It is also finely dressed. [EwaGlos]</skos:note>
        <skos:note xml:lang="de">Mauerwerk aus regelmäßig bearbeiteten Natursteinblöcken, die annähernd gleich groß sind, häufig größer als Ziegel (mit oder ohne Mörtel, mit sehr dünnen, gleichmäßigen Fugen). Es ist sorgfältig bearbeitet. [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="de">Quadermauerwerk</skos:prefLabel>
        <skos:prefLabel xml:lang="en">ashlar wall</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kvádrové zdivo</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">mur de pierres de taille </skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_151d9517 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_151d9517">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_ad800342"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-28T23:16:01.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:30:39.000</terms:modified>
        <skos:altLabel xml:lang="fr">coupole en cul-de-four plein-cintre</skos:altLabel>
        <skos:altLabel xml:lang="en">cul-de-four</skos:altLabel>
        <skos:altLabel xml:lang="fr">cul-de-four</skos:altLabel>
        <skos:altLabel xml:lang="fr">demi-coupole</skos:altLabel>
        <skos:altLabel xml:lang="en">semi-dome</skos:altLabel>
        <skos:definition xml:lang="de">Eine Kuppel mit viertelkreisförmigem Querschnitt über halbkreisförmigem Grundriss. Die H. wird oft zur Überwölbung von Apsiden oder halbrunden Nischen verwandt. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Größere, jedoch nur über einem Halbkreis bzw. einem halben Polygon errichtete Kuppel mit unterschiedlicher Wölblinie. Beispiel: Die Hagia Sophia in Istanbul. Die kleinere, einer Muschel ähnliche Halbkuppel über einer Apsis wird auch Konche oder Concha genannt. (Glossarium Artis)</skos:definition>
        <skos:prefLabel xml:lang="de">Halbkuppel</skos:prefLabel>
        <skos:prefLabel xml:lang="en">half dome</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte en cul-de-four</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_ad800342"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_1529f46b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_1529f46b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_by6rxabl"/>
