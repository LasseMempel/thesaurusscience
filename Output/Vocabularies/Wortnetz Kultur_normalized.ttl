    skos:prefLabel "Klostergarten"@de,
        "cloister garden"@en ;
    skos:scopeNote "Benutzt für den bewirtschafteten Garten eines Klosters; für den auf dem Gelände eines säkularisierten oder aufgegebenen Klosters angelegten Park siehe Klosterpark."@de .

