    skos:inScheme <http://purl.org/heritagedata/schemes/38076> ;
    skos:prefLabel "Average temperature patterns"@en ;
    skos:scopeNote "Changing diurnal and seasonal temperature patterns."@en .

<http://purl.org/heritagedata/schemes/38076/concepts/10101> a skos:Concept ;
