        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-14T16:00:37.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T17:53:13.000</terms:modified>
        <skos:note xml:lang="de">Die langsame Abnutzung oder der Abrieb von Architekturoberflächen oder Wandmalereien, die üblicherweise durch den natürlichen Einfluss von windgetragenen Partikeln (wie z.B. Staub, Sand) verursacht werden. [EwaGlos]</skos:note>
        <skos:note xml:lang="en">The slow surface attrition or wear of architectural surfaces or mural paintings, which is usually caused by the natural action of wind-blown particles (e.g. dust, sand). [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="de">Winderosion</skos:prefLabel>
        <skos:prefLabel xml:lang="en">wind erosion</skos:prefLabel>
    </owl:NamedIndividual>
    


