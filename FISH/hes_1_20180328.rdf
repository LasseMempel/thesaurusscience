		<skos:prefLabel xml:lang="gd">OIFIS CHÙISEAN-MARA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach a thathar a' stiùireadh cùisean na mara uaithe.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MARITIME OFFICE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
