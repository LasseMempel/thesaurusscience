				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500486" />
				<skos:scopeNote xml:lang="en">A zoo building containing artificial ponds or tanks in which aquatic plants and animals are kept alive for purposes of observation and study.</skos:scopeNote>
