    skos:broader <http://www.eionet.europa.eu/gemet/concept/6967> ;
    skos:definition "Resources that have a natural rate of availability and yield a continual flow of services which may be consumed in any time period without endangering future consumption possibilities as long as current use does not exceed net renewal during the period under consideration."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Erneuerbare Rohstoffe"@de,
        "renewable raw material"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/7108> .

<http://www.eionet.europa.eu/gemet/concept/7091> a skos:Concept ;
