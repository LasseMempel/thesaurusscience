		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/492" />
		<skos:scopeNote xml:lang="en">A track, traditionally used to transport cut peats.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
