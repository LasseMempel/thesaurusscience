        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T14:21:01.000</terms:modified>
        <skos:definition xml:lang="de">Dachausmittlung heißt die geometr. Festlegung einer Dachform und ihrer Schnittlinien (Traufe, Ort, First, Grat, Kehle, Verfallung) über dem gegebenen Grundriss. Sie ist die Grundlage für die konstruktive Ausbilung des Dachs (Werksatz). [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Dachausmittlung</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_faf4dcc2 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_faf4dcc2">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_5b828b5f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-07T12:07:52.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T15:37:01.000</terms:modified>
        <skos:altLabel xml:lang="de">Fundamentmauer</skos:altLabel>
        <skos:definition xml:lang="de">Auf dem Baugrund lagernder, in der Regel mittels linearer Baugrube in die Erdoberfläche oder die Sohle eines Kellergeschosses versenkter unterster, &quot;gründender&quot; Abschnitt eines Mauerzuges. (Glossarium Artis, Bd. 3, Bögen und Mauerwerk)</skos:definition>
        <skos:prefLabel xml:lang="de">Grundmauer</skos:prefLabel>
    </owl:NamedIndividual>
    


