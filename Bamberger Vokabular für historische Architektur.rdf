        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T18:17:56.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T12:46:19.000</terms:modified>
        <skos:altLabel xml:lang="en">basse-nef</skos:altLabel>
        <skos:altLabel xml:lang="fr">nef latérale</skos:altLabel>
        <skos:altLabel xml:lang="cs">postranní lod\&apos;</skos:altLabel>
        <skos:definition xml:lang="de">Abseite, Raumteil, der parallel zum Mittelschiff verläuft und zu diesem (und evtl. weiteren, benachbarten Seitenschiffen) geöffnet ist. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Abseite, seitl., meist zu beiden Seiten des Mittelschiffs angeordnete Raumteile, durch Wandöffnungen (Arkaden und dergl.) mit Letzterem verbunden. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Část chrámového prostoru, která probíhá paralelně se střední lodí a je do ní (případně do dalších sousedních lodí) otevřena. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Seitenschiff</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">bas-côté</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">boční loď</skos:prefLabel>
        <skos:prefLabel xml:lang="ca">nau lateral</skos:prefLabel>
        <skos:prefLabel xml:lang="it">navata laterale</skos:prefLabel>
        <skos:prefLabel xml:lang="es">nave lateral</skos:prefLabel>
        <skos:prefLabel xml:lang="en">side aisle</skos:prefLabel>
    </owl:NamedIndividual>
    


