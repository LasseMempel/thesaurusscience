        "domestic fuel oil"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15200>,
        <http://www.eionet.europa.eu/gemet/concept/15274> .

<http://www.eionet.europa.eu/gemet/concept/2304> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4621> ;
    skos:closeMatch <http://data.uba.de/umt/_00012367> ;
