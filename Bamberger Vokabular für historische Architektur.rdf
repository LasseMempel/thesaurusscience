    <!-- https://hist-arch-vocab.org/bvha#c_fcb98df0 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_fcb98df0">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_49b400f3"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_6e774d4c"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T11:07:46.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T12:40:16.000</terms:modified>
        <skos:altLabel xml:lang="de">Orant</skos:altLabel>
        <skos:altLabel xml:lang="cs">orant</skos:altLabel>
        <skos:definition xml:lang="cs">1. Ve starokřesťanském umění postava v dlouhém oděvu a se zdviženýma rukama jako ztělesnění modlitby. 2. Adorant. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">1. in der altchristlichen Kunst eine Gestalt mit langem Gewand und erhobenen Händen als Verkörperung des Gebets; 2. Adorant. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Orans</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">orans</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_fcbdaf2c -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_fcbdaf2c">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_6096f4c9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_5bf6bcac"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_ffc8d015"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-22T14:58:33.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T15:45:22.000</terms:modified>
        <skos:definition xml:lang="cs">AGRAFA, svorníkovitě tvarovaná voluta mezi závěrem půlkruhového oblouku a kladím. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Aus dem Französischen stammende Bezeichnung für einen besonders gestalteten Schlussstein am Scheitel eines Rundbogens. [Schrader / Voigt 2003]</skos:definition>
        <skos:definition xml:lang="de">Hoher Keilstein, der zwei Steinschichten miteinander verbindet, als Schlussstein eines Bogens oft mit einer Maske o. Ä. verziert, auch volutenförmig oder als Medaillon vom Rundbogenscheitel zum Gebälk überleitend. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Schlusssteinartig ausgebildete Volute zwischen Rundbogenscheitel und Gebälk. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Agraffe (Keilstein)</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">agrafa</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">agrafe</skos:prefLabel>
        <skos:prefLabel xml:lang="en">agraffe</skos:prefLabel>
        <skos:prefLabel xml:lang="es">ágrafe</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_fcd8ccf7 -->


