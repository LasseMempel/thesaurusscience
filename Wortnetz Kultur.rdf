		<skos:prefLabel xml:lang="en">beneficiarius station</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Benefiziarierstation</skos:prefLabel>
		<skos:altLabel xml:lang="de">Benefiziarierstationen</skos:altLabel>
		<skos:altLabel xml:lang="de">Straßengendarmerieposten</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk007137"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk003743"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010133"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013552"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk017603"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019690"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk007137"/>
		<xe:explanation_temp xml:lang="de">Die Stationen liegen an Straßenkreuzungen, Flussübergängen und anderen neuralgischen Punkten, sie sind befestigt und weisen nur wenige Gebäude innerhalb der Befestigung auf.</xe:explanation_temp>
		<skos:definition xml:lang="de">Eine Benefiziarierstation ist eine militärische Anlage, in der Benefiziarier, aus ihren Stammeinheiten abkommandierte Unteroffiziere, an den Fernstraßen des Römischen Reiches Polizeifunktionen wahrnehmen.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010133"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003743"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk013552"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk017603"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019690"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk007137"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-03-18T10:27:37+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004247">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">training camp</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Übungslager (Militär)</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003521"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk003743"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010133"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010139"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019690"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk003521"/>
		<skos:definition xml:lang="de">Ein Übungslager ist ein Militärlager, das nur für Übungszwecke und Trainingsmaßnahmen errichtet wurde. Es weist zumindest eine äußere Befestigung auf. Das Vorhandensein einer Innenbebauung ist nicht zwingend, sondern abhängig vom Zweck der jeweiligen Übung.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003521"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010133"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003743"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010139"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019690"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-08-01T17:40:11+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004248">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">marching camp</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Marschlager</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003521"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk003743"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010133"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010139"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019690"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk003521"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk004307"/>
		<xe:explanation_temp xml:lang="de">Daher weist es zumindest eine äußere Befestigung, aber nur selten eine Innenbebauung aus festen Gebäuden wie Hütten, auf.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Marschlager ist ein Militärlager, das nur für einen kurzen Gebrauch während eines Marsches von Militäreinheiten errichtet wird.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003521"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010133"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003743"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010139"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019690"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-08-01T17:39:40+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004249">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Auxiliarvicus</skos:altLabel>
		<skos:prefLabel xml:lang="de">Canabae legionis</skos:prefLabel>
		<skos:prefLabel xml:lang="en">canabae legionis</skos:prefLabel>
		<skos:altLabel xml:lang="de">Lagerdorf</skos:altLabel>
		<skos:altLabel xml:lang="de">Lagervorstadt</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000122"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk000330"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk004006"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010250"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019808"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk004104"/>
		<gvp:aat2801_conjuncted_with rdf:resource="http://lvr.vocnet.org/wnk/wk004307"/>
		<xe:explanation_temp xml:lang="de">Sie besitzt eine eigene Verwaltung, diente vorwiegend der Versorgung der Militäreinheiten und weist daher gewerbliche Einrichtungen sowie Wohn-, Handwerks- und Wirtschaftsbauten auf.</xe:explanation_temp>
		<skos:definition xml:lang="de">Eine Canabae Legionis ist eine Siedlung, die außerhalb eines römischen Lagers und entlang einer zum Lager führenden Straße angelegt ist, selbst aber nicht-militärischen Charakter aufweist.</skos:definition>
		<skos:exactMatch rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/146437"/>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/7563342-5"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000330"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010250"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004006"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019808"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-02T14:12:31+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004250">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Oppida (Siedlungen)</skos:altLabel>
		<skos:prefLabel xml:lang="de">Oppidum (Siedlung)</skos:prefLabel>
		<skos:prefLabel xml:lang="en">oppidum</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000122"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk000330"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk004006"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010250"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019808"/>
		<xe:explanation_temp xml:lang="de">Es kann sich um eine Zufluchtsstätte, einen ständig bewohnten Ort oder einen Werkplatz handeln. Im Mittelalter wurde unter einem Oppidum eine kleine stadtähnliche Siedlung mit Marktfunktion verstanden, der das Marktrecht bzw. Stadtrecht fehlte.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Oppidum ist eine befestigte Siedlung aus keltischer Zeit und wurde zumeist in erhöhter oder schwer zugänglicher Lage angelegt.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300008396"/>
		<skos:exactMatch rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68744"/>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4172643-1"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000330"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010250"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004006"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019808"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-08T10:33:05+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004251">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
