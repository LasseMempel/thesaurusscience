		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1556" />
		<skos:scopeNote xml:lang="en">A stone inscribed with the initials of a bride and groom, usually accompanied by a date, and found on a lintel or set into a wall.</skos:scopeNote>
