	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk019007">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="en">aerial photo map</skos:altLabel>
		<skos:prefLabel xml:lang="de">Luftbildkarte</skos:prefLabel>
		<skos:altLabel xml:lang="de">Luftbildkarten</skos:altLabel>
		<skos:altLabel xml:lang="de">Luftbildplan</skos:altLabel>
		<skos:altLabel xml:lang="de">Luftbildpläne</skos:altLabel>
		<skos:prefLabel xml:lang="en">photomap</skos:prefLabel>
		<skos:altLabel xml:lang="en">photomaps</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004520"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk020435"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004520"/>
		<skos:definition xml:lang="de">Eine Luftbildkarte ist eine Landkarte, die aus einer Kombination von Orthophoto und ausgewählten topographisch-kartographischen Elementen, wie Kartenrahmen, Kartenzeichen, Beschriftung, Legende und Gitterkreuz besteht.</skos:definition>
