        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-05T22:22:06.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T17:59:31.000</terms:modified>
        <skos:note xml:lang="de">Das Verbrennen von Materialien (z.B. Erdöl, Holz, Plastik) setzt Gase und Partikel, einschließlich Aerosole, frei. [EwaGlos]</skos:note>
        <skos:note xml:lang="en">The burning of materials (e.g. fossil fuels, wood, plastics) which releases gases and particulate matter, including aerosols. [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="de">Luftverschmutzung</skos:prefLabel>
        <skos:prefLabel xml:lang="en">air pollution</skos:prefLabel>
    </owl:NamedIndividual>
    


