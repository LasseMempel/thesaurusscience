				<skos:prefLabel xml:lang="gd">LÈANAG-UISGICHTE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Àite feurach a thèid a mhathachadh le tuil a leigear air tron gheamhradh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">WATER MEADOW</skos:prefLabel>
