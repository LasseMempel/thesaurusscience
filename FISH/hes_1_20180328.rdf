	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/189">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/189</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TALLA EAGLAISE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Talla a tha co-cheangailte ri eaglais far an cumar coinneamhan is tachartasan agus gnothaichean na paraiste.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CHURCH HALL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/188" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/192" />
		<skos:scopeNote xml:lang="en">A hall associated with a church, used for holding functions and meetings and for conducting parish business.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/190">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/190</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TALLA NAN COMANN-CIÙIRDE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Gu tradaiseanta, seo talla aig comann-cheàrd mharsantach no luchd-chiùird. Ga chleachdadh airson TALLA-BAILE gu tric an-diugh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GUILDHALL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/188" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/211" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/187" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/191" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/236" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/478" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500625" />
		<skos:scopeNote xml:lang="en">Traditionally, the hall of a crafts, trade, or merchants' guild. Nowadays, often used to describe a TOWN HALL.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/191">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/191</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TALLA BAILE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach mòr far a bheilear ri gnothaichean poblach a' bhaile, a' cumail cùirtean an lagha, fèisteas agus tachartasan eile an dèidh a' Municipal Reform Act sa bhliadhna 1833.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TOWN HALL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">CITY HALL</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/188" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/153" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/156" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/183" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/187" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/190" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/197" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/198" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/478" />
		<skos:scopeNote xml:lang="en">A large building used for the transaction of the public business of a town, the holding of courts of justice, entertainments and other activities, following the Municipal Reform Act of 1833.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/192">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/192</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TALLA BAILE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Talla ann am baile a tha ga chleachdadh airson coinneamhan is tachartasan eile.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">VILLAGE HALL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/188" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/189" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/478" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/528" />
		<skos:scopeNote xml:lang="en">A hall in a village used for meetings and other functions.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/193">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/193</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">IONAD-RANNSACHAIDH SAIDHEANSAIL</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalaichean is structaran far a bheilear ri rannsachadh saidheansail. Dh'fhaoidte gum bi iad co-cheangailte ionad-foghlaim no ionad prìobhaideach no fear aig an riaghaltas.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SCIENTIFIC RESEARCH ESTABLISHMENT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/151" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/537" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500533">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500533</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">STÈISEAN AIMSIR</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Togalach no grunn thogalaichean no ionad far a bheilear a' dèanamh deuchainnean no sgrùdadh gus fiosrachadh a chruinneachadh 's a chlàradh mun aimsir.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">WEATHER STATION</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-26T15:11:56</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-26T15:12:20</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/193" />
				<skos:scopeNote xml:lang="en">A building, group of buildings or installation in which experiments and observations are undertaken to gather and record information about the weather.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502148" />
		<skos:scopeNote xml:lang="en">Buildings and structures where scientific research is carried out. May be attached to an educational establishment, or be a private or government sponsored facility.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/194">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/194</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FASGADH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar no àite nàdarra far am faighear dìon o na sìontan.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SHELTER</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/195">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/195</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">FASGADH MAOIM-SNEACHDA</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Togalach no structar a chaidh a dhealbhadh gus daoine, beathaichean is carbadan a dhìon o mhaoimean-sneachda.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">AVALANCHE SHELTER</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/194" />
				<skos:scopeNote xml:lang="en">A building or structure designed to protect people, animals and vehicles from avalanches.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1442" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/151" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/139" />
		<skos:scopeNote xml:lang="en">A structure or natural formation which serves as protection from the elements.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/197">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/197</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TOLL-BÙTHA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach a tha ann an teis-mheadhan rianachd, ceartas agus deas-ghnàthan a' bhuirgh ionadail.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TOLBOOTH</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/151" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/191" />
		<skos:scopeNote xml:lang="en">A building serving as a centre of local burgh administration, justice and ceremony.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/198">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/198</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BAILE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Tuineachadh aig a bheil togalaichean poblach, buidhnean malairteach agus àitichean-còmhnaidh prìobhaideach a tha nas motha na clachan agus far a bheil barrachd a' dol a thaobh riaghaltais ionadail neo-eisimeilich.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TOWN</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/151" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/507" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/191" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/399" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/400" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501707" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/508542" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/528" />
		<skos:scopeNote xml:lang="en">A settlement with public buildings, commercial establishments and private dwellings, larger than a village and having more complete and independent local government.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/199">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/199</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">STÈISEAN-TRIANTANACHAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Comharra socraichte, mar is trice air mullach cnuic, a tha na phàirt de lìonra chomharran a chleachdar airson suirbhidhean triantanachaidh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TRIANGULATION STATION</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-10-01T13:48:00</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502893" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500672">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500672</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">CARRAGH TRIANTANACHAIDH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Carragh triantanachaidh a chaidh thogail a dh'aona-ghnothach 's a chleachdadh ann an suirbhidh mheadrachail Bhreatainn leis an t-Suirbhidh Òrdanais.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">TRIANGULATION PILLAR</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-30T13:39:24</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-10-01T13:45:36</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/199" />
				<skos:scopeNote xml:lang="en">A purpose-built triangulation pillar used for the metrical survey of Britain carried out by the Ordnance Survey.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:scopeNote xml:lang="en">A fixed marker, usually at the top of a hill, forming part of a network used for surveying by triangulation.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/200">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/200</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">VICUS</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Sgìre, frith-bhaile no roinn de bhaile no clachan a bha faisg air gearastan Ròmanach 's aig an robh an inbhe laghail as ìsle am measg nan raointean togalaichte.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">VICUS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">CIVIL SETTLEMENT</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/151" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/507" />
		<skos:scopeNote xml:lang="en">A district, suburb or quarter of a town or village adjacent to a Roman fort, with the lowest legal status accorded to a built-up area.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/201">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/201</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH-FAIRE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Taigh no bothan do dh'fhear-faire; a' gabhail a-steach taighean-freiceadain sgìreil ann an cilltean is feadhainn phrìobhaideach, m.e. air docannan no ann am factaraidhean is msaa.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">WATCH HOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/151" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1653" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/170" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500608" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/848" />
		<skos:scopeNote xml:lang="en">A house or hut for a nightwatchman; including parish watch houses in churchyards and private watch houses, eg. in dockyards, factories, etc.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
