		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502298" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/758" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/759" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/857" />
		<skos:scopeNote xml:lang="en">A place from which clay is extracted.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1107">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1107</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FACTARAIDH DIATOMAIT</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far a bheilear a' dùsgadh diatomait às an talamh. Tha diatomite na mhèinnear geal no liath a chaidh a chruthachadh le cnàimhnich is sligean de bhithean beaga bìodach agus thathar gan cleachdadh ann an ionsulaideadh fuaime agus teasa, stuthan teine-dhìonach agus stuthan spreadhaidh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">DIATOMITE WORKS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1103" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/727" />
		<skos:scopeNote xml:lang="en">A site where diatomite is extracted from the ground. Diatomite, a white or grey mineral soil formed from the skeletons and shells of microscopic organisms, is used in sound and heat insulation, fireproofing materials and explosives.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1109">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1109</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CUARAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite far a bheilear a' dùsgadh mèinnearan le bhith a' gearradh, a' spreadhadh is msaa. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">QUARRY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">QUARRY WORKINGS</skos:altLabel>
		<skos:altLabel xml:lang="en">FREESTONE QUARRY</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1103" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1113" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1110" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1039" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1112">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1112</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">LAGAN  CUARAIDH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Lagan eu-domhain san talamh a nochd an cois dùsgadh beag de chlachan no mèinnearan ann.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">QUARRY SCOOP</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1109" />
				<skos:scopeNote xml:lang="en">A shallow depression in the ground, caused by the small-scale quarrying of rock or other minerals.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/501710">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/501710</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">CUARAIDH FELDSPAR</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Làrach far a bheilear a' dùsgadh feldspar.  Cleachdar feldspar gu tric ann an saothrachadh criadhadaireachd.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">FELDSPAR QUARRY</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-04-12T14:42:16</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-04-12T14:43:46</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:altLabel xml:lang="en">FELSPAR QUARRY</skos:altLabel>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1109" />
				<skos:scopeNote xml:lang="en">A site where feldspar is extracted.  Feldspar is commonly used in the production of ceramics.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/758" />
		<skos:scopeNote xml:lang="en">An excavation from which minerals are obtained by cutting, blasting, etc. Use more specific term where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1110">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1110</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CUARAIDH CHRÒMATAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite far a bheilear a' dùsgadh chromates às an talamh. Tha chromates nan salainn meatailte a chleachdar, mar is trice, ann an còmhdachadh mheatailtean.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CHROMATE QUARRY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1109" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1048" />
		<skos:scopeNote xml:lang="en">A place where chromates are extracted from the ground. Chromates are metal salts, usually used in coating processes for metals.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1113">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1113</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CUARAIDH CHLACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Cladhach far a bheilear a' dùsgadh clachan airson obair-thogail le bhith ga gearradh no ga spreadhadh is msaa.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">STONE QUARRY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1119">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1119</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">CUARAIDH CUIN-CHLACH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Làrach far a bheilear a' dùsgadh cuin-chlach (basalt no clach chruaidh theinnteach dhorch eile) às an talamh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">WHINSTONE QUARRY</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1113" />
				<skos:scopeNote xml:lang="en">A site where whinstone (basalt and other hard, dark-coloured igneous rocks) is extracted from the ground.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1109" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1118" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1116">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1116</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">CUARAIDH MARMOIR</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Làrach far a bheilear a' dùsgadh marmor às an talamh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">MARBLE QUARRY</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1113" />
				<skos:scopeNote xml:lang="en">A place where marble is extracted from the ground.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1115" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1117">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1117</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">CUARAIDH SGLÈAT</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Làrach far a bheilear a' dùsgadh sglèat às an talamh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">SLATE QUARRY</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1113" />
				<skos:scopeNote xml:lang="en">A site where slate is extracted from the ground.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
