        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_5f92f3e5"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_8e43c202"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_aedda11d"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-28T17:12:19.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T21:20:46.000</terms:modified>
        <skos:altLabel xml:lang="de">Wachskerze</skos:altLabel>
        <skos:altLabel xml:lang="de">Wachslicht</skos:altLabel>
        <skos:altLabel xml:lang="fr">bougie</skos:altLabel>
        <skos:altLabel xml:lang="la">candela</skos:altLabel>
        <skos:altLabel xml:lang="fr">cierge</skos:altLabel>
        <skos:altLabel xml:lang="en">wax-candle</skos:altLabel>
        <skos:definition xml:lang="de">Kerze f ; präzis. Wachskerze f ; auch Wachslicht n; lat. cereus; candela: ein aus naturfarbenem oder gebleichtem Bienenwachs gefertigter zylindrischer oder konischer Beleuchtungskörper mit einem Docht aus geflochtener Baumwolle (seit 4. Jh.). Bereits der hl . Hieronymus erwähnt die Kerzen, deren Brennen an Christus als das wahre Licht der Welt erinnern soll. In der kath. Kirche darf nur bei brennenden Kerzen zelebriert werden. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Kerze</skos:prefLabel>
        <skos:prefLabel xml:lang="en">candle</skos:prefLabel>
        <skos:prefLabel xml:lang="la">cereus</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">chandelle</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">svíce</skos:prefLabel>
    </owl:NamedIndividual>
    


