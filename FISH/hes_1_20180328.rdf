		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/283" />
		<skos:scopeNote xml:lang="en">An RAF Base, used specifically for the storage and maintenance of barrage balloons.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500517">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500517</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">DROCHAID GHLUASADACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Seòrsa de dhrochaid aig a bheil acainnean is eileamaidean gluasadach, m.e. gus soithichean a leigeil seachad.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MOVABLE BRIDGE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-26T11:30:32</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-26T11:30:52</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500516">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500516</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">DROCHAID-BHOGADAIN</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Drochaid aig a bheil ruigheachd no dhà a chlaoineas aig na fàrlarasan ach an gabh a gluasad suas, às an rathad de luingeas.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">BASCULE BRIDGE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-26T11:28:38</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-11-21T16:52:58</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500517" />
				<skos:scopeNote xml:lang="en">A bridge that incorporates one or two spans that tilt at the abutments, to move up and out of the way of shipping.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1786" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500559">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500559</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">DROCHAID-THOGALACH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Drochaid ghluasadach as urrainnear togail air aon cheann le slabhraidhean no ròpannan airson 's nach tèid trafaig thairis tuilleadh no airson trafaig a leigeil seachad foidhpe.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">DRAWBRIDGE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-27T13:29:39</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-27T13:30:06</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500517" />
				<skos:scopeNote xml:lang="en">A movable bridge lifted at one end by chains or ropes either to stop traffic passing over it or to let traffic pass under it.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500619">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500619</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">DROCHAID-THOGALACH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Drochaid aig a bheil ruigheachd a tha a' dol dìreach an àirde gus slighe fhosgladh do luingeas.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">LIFT BRIDGE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-30T09:39:24</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-30T09:39:47</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:altLabel xml:lang="en">LIFTING BRIDGE</skos:altLabel>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500517" />
				<skos:scopeNote xml:lang="en">A bridge that incorporates a span that moves upwards vertically to provide a passageway for navigation.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:scopeNote xml:lang="en">A type of bridge which has machinery and movable elements, eg. to allow vessels to pass.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500518">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500518</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TOLL CLAGACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Sloc clag-chumhach a chaidh a chleachdadh tràth ann am mèinnearachd guail. Cleachd seo leis an fhoincsean ma tha fhios cò fear, m.e. FACTARAIDH GUAIL.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BELL PIT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-26T11:34:32</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-10-02T14:56:35</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1103" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/825" />
		<skos:scopeNote xml:lang="en">A bell-shaped shaft used in early coal mining. Use with functional type if known, eg. COAL WORKS.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
