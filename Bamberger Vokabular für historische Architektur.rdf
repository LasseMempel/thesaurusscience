        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T19:01:06.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T13:18:12.000</terms:modified>
        <skos:definition xml:lang="de">Langbau, Longitudinalbau, im Gegensatz zum Zentralbau ein Bauwerk, bei dem die Längsachse dominiert. [Koepf / Binding 2016]</skos:definition>
