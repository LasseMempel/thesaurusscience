    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Caponier"@en ;
    skos:scopeNote "An enclosed, defensible passageway, equipped with gun ports, extending into or traversing a dry ditch."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/139775> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/138311> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Foundation"@en ;
    skos:scopeNote "The lowest part, or base, of a structure, sometimes built into the ground, on which the weight of the whole rests."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/139782> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/138311> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Water Spout"@en ;
    skos:scopeNote "A pipe or channel to carry water outwards from a gutter or behind a parapet. If decorated with grotesque heads it is called a gargoyle."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/139783> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/137674> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Strapwork"@en ;
    skos:scopeNote "A decorative feature of wood, plaster or carved masonry, often used in low relief on ceilings, panels or screens and resembling interlacing leather straps. Popular in the late 16th and early 17th centuries."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/139784> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/138311> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Glazing Bar"@en ;
    skos:scopeNote "A moulded bar or baton dividing the panes of glass within a window light."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/139792> a skos:Concept ;
