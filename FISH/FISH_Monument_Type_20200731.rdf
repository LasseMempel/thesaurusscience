  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92923">
    <skos:scopeNote xml:lang="en">A building where pins are manufactured.</skos:scopeNote>
  </rdf:Description>
