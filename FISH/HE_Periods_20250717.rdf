        <dc:publisher rdf:resource="https://historicengland.org.uk/"/>
        <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
        <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
        <skos:prefLabel xml:lang="en">Interregnum</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The period between the execution of Charles I and the restoration of the monarchy in 1660. During this time the monarchy was replaced by a political structure known as the Commonwealth led by the Lord Protector, Oliver Cromwell (1649 CE to 1660 CE).</skos:scopeNote>
        <skos:notation xml:lang="en">COM</skos:notation>
      </skos:Concept>
    </skos:narrower>

