	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk003850">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Granit</skos:prefLabel>
		<skos:prefLabel xml:lang="en">granite</skos:prefLabel>
		<skos:prefLabel xml:lang="fr">granite</skos:prefLabel>
		<skos:altLabel xml:lang="de">Granite</skos:altLabel>
		<skos:prefLabel xml:lang="it">granito</skos:prefLabel>
		<skos:prefLabel xml:lang="es">granito</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003849"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010560"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010567"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk018426"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019436"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019456"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019940"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk003849"/>
		<xe:explanation_temp xml:lang="de">Der Granit ist eines der wichtigsten Gesteine der Erde.</xe:explanation_temp>
		<skos:definition xml:lang="de">Granit ist ein Tiefengestein, das sich aus den Mineralen Feldspat, Quarz und Glimmer zusammensetzt und in verschiedenen Färbungen auftritt.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4132750-0"/>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300011183"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003849"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010560"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010567"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk018426"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019436"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019456"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019940"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
