    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "degradable plastic waste"@en .

<http://www.eionet.europa.eu/gemet/concept/15120> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8566> ;
    skos:definition "Gesamtentnahme an direkt verwertetem Material innerhalb einer Volkswirtschaft abzüglich der physischen Ausfuhren"@de,
        "total amount of materials directly used in the economy minus the materials that are exported"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "inländischer Materialverbrauch"@de,
        "domestic material consumption"@en ;
    skos:scopeNote "Improved definition (EN only): Measures the total amount of materials directly used by an economy and is defined as the annual quantity of raw materials extracted from the domestic territory, plus all physical imports minus all physical exports"@en .

<http://www.eionet.europa.eu/gemet/concept/15124> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11706> ;
    skos:definition "Zusammentragen von Informationen über die physikalischen, chemischen und biologischen Systeme auf dem Planeten Erde mit Hilfe von Fernerkundungstechnologien, meist unter Einsatz von Satelliten mit Bildaufnahmegeräten"@de,
        "gathering of information about planet Earth’s physical, chemical and biological systems via remote sensing technologies, usually involving satellites carrying imaging devices"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Erdbeobachtung"@de,
        "earth observation"@en ;
    skos:scopeNote "Improved definition (EN only): Gathering of information about planet Earth’s physical, chemical and biological systems via remote sensing technologies, usually involving satellites carrying imaging or radar devices"@en .

<http://www.eionet.europa.eu/gemet/concept/15127> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2450> ;
    skos:definition "A corridor as a narrow, linear (or near-linear) piece of habitat that connects two larger patches of habitat that are surrounded by a nonhabitat matrix, thereby facilitating movements of animals and dispersal of plants and other organsisms."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "ecological corridor"@en .

<http://www.eionet.europa.eu/gemet/concept/15136> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15134>,
        <http://www.eionet.europa.eu/gemet/concept/2519> ;
    skos:definition "intrinsic ecosystem characteristic whereby an ecosystem maintains its integrity"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "ecosystem process"@en .

<http://www.eionet.europa.eu/gemet/concept/15144> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8250> ;
    skos:definition "providing material services with less material through recyclability, element reusability and waste reduction"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "efficient material use"@en .

