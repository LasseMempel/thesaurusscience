  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91618">
    <skos:scopeNote xml:lang="en">A pit which shows evidence for having been used for cooking. Often contains charcoal, burnt bone fragments etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69414">
    <skos:scopeNote xml:lang="en">A very long, narrow, roofed building, often two-storeyed, used for the manufacture of rope. Often attached to warehousing, an engine house or offices. Can be included within the complex of a textile mill.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93633">
    <skos:scopeNote xml:lang="en">A house provided for the treasurer of a cathedral, palace or similar.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143456">
    <skos:scopeNote xml:lang="en">A site equipped for passive or active defence against an airborne enemy assault.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160368">
    <skos:scopeNote xml:lang="en">A large pillbox-like structure, often L-shaped or angular, with numerous loopholes used as a defensive position.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69027">
    <skos:scopeNote xml:lang="en">An artificial stretch of water, usually rectangular in shape, used decoratively, particularly in formal gardens, eg. Long Water, Hampton Court. Occasionally used to supply water to cascades.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143424">
