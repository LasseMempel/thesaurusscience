		<crm:P120 rdf:resource="http://lvr.vocnet.org/wnk/wk002694"/>
		<skos:definition xml:lang="de">Ein Kreuzverband ist ein Mauerverband, bei dem Binderschichten und Läuferschichten regelmäßig wechseln. </skos:definition>
		<xe:explanation_temp xml:lang="de">Anders als beim Blockverband sind jedoch die Stoßfugen einer Läuferschicht gegenüber denen der nächsten Läuferschicht um einen halben Stein versetzt.</xe:explanation_temp>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002680"/>
