		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/309</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">POST-STIÙIRIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach an airm a stiùirear gunnaichean bataraidh uaithe.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">COMMAND POST</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/278" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/287" />
		<skos:scopeNote xml:lang="en">A military building from which the guns of a battery were directed.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
