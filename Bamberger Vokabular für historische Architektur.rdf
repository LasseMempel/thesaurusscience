        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T22:40:41.000</terms:modified>
        <skos:altLabel xml:lang="it">passarella</skos:altLabel>
        <skos:definition xml:lang="de">Verbindendes Element, z. B. kleine Brücke (meist aus Holz). [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Steg (Brücke)</skos:prefLabel>
        <skos:prefLabel xml:lang="es">pasarela</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">passerelle</skos:prefLabel>
        <skos:prefLabel xml:lang="it">ponticello</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_7f20c3e6 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_7f20c3e6">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_4708d89a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-01T10:46:39.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T16:10:12.000</terms:modified>
        <skos:definition xml:lang="de">Halbkreisförmiges Fenster, das durch zwei senkrechte Sturzstützen dreigeteilt wird; erstes Auftreten an den Diokletiansthermen in Rom, daher auch als Thermenfenster bezeichnet. Wiederaufnahme im 16. Jh. durch Andrea Palladio. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Diokletianisches Fenster</skos:prefLabel>
    </owl:NamedIndividual>
    


