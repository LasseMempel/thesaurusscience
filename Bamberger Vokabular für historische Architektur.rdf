        <skos:prefLabel xml:lang="cs">chrámová loď</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">nef centrale</skos:prefLabel>
        <broaderByPosition rdf:resource="https://hist-arch-vocab.org/bvha#c_4880e8cc"/>
    </owl:NamedIndividual>
    


