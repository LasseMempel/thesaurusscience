		<skos:prefLabel xml:lang="de">Fachwerkgeschossbau</skos:prefLabel>
		<skos:altLabel xml:lang="de">Fachwerkgeschoßbau</skos:altLabel>
		<skos:altLabel xml:lang="de">Fachwerkgeschossbauten</skos:altLabel>
