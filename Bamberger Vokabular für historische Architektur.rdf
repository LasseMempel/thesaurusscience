        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T18:00:38.000</terms:modified>
        <skos:prefLabel xml:lang="de">Eckpfosten</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Neben dem Krümmling kann der Knotenpunkt zweier Treppenarme am Podest auch über einen halbrunden oder eckigen Pfosten ausgebildet sein. Ein eckiger Pfosten, als Verbindungsstück am Treppenabsatz kommt regelmäßig bei barocken Wangentreppen bis etwa 1750 vor. </skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_67db5a9d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_67db5a9d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_11426742"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_d8ee92a4"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-10T14:47:50.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:21:05.000</terms:modified>
        <skos:altLabel xml:lang="fr">berceau transversal </skos:altLabel>
        <skos:altLabel xml:lang="fr">voûte transversal</skos:altLabel>
        <skos:definition xml:lang="de"> Tonnengewölbe, dessen Scheitellinie im Gegensatz zur Längstonne quer zur Hauptachse eines Raums verläuft. [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Tonnengewölbe, dessen Achse rechtwinklig zur Raumachse des Bauwerkes verläuft. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="es"> bóveda transversal</skos:prefLabel>
        <skos:prefLabel xml:lang="it"> volta a botte disposta traversalmente</skos:prefLabel>
