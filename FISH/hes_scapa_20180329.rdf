	<skos:prefLabel xml:lang="en">Antonine</skos:prefLabel>
	<skos:prefLabel xml:lang="gd">(todo)</skos:prefLabel>
	<skos:scopeNote xml:lang="en">In a Scottish context Antonine refers to the reign of the Roman emperor Antoninus Pius and his successors (from 138 CE) until the late 2nd century</skos:scopeNote>
</rdf:Description>

