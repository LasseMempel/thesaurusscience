    <!-- https://hist-arch-vocab.org/bvha#c_17f0d74f -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_17f0d74f">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0323c693"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_34ca6582"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-14T11:52:14.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T16:43:22.000</terms:modified>
        <skos:altLabel xml:lang="cs">ztráta složek</skos:altLabel>
        <skos:definition xml:lang="en">Partial or selective elimination ofsoft (clay lenticles, nodes of limonite, etc) or compact stonecomponents (pebbles, fossil fragments, geological concretions,lava fragments). [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="de">Partielles oder selektives Auswittern von weichen Komponenten (Tonlinsen, Limonitnester, etc.) oder kompakten Komponenten (Kieselsteine, Fossilfragmente, geologische Konkretionen, Lavatrümmer). [ICOMOS-ISCS] </skos:definition>
        <skos:definition xml:lang="fr">correspond à l’élimination sélective de constituants plus tendres (ex. : lentilles d’argile, nodules de limonite) ou plus compacts (ex. : galets, fragments de fossiles, concrétions). [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="cs">částečná nebo selektivní eliminace měkkých částí (jílových čoček, hrudek limonitu, atd.) nebo kompaktních složek v kameni (valouny, úlomky fosílií, geologické konkrece, úlomky lávy, atd.) [ICOMOS-ISCS] </skos:definition>
        <skos:prefLabel xml:lang="de">Komponentenverlust</skos:prefLabel>
        <skos:prefLabel xml:lang="en">loss of components</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">perte de constituants</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">úbytek složek</skos:prefLabel>
    </owl:NamedIndividual>
    


