    <!-- https://hist-arch-vocab.org/bvha#c_0ddf326f -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_0ddf326f">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_d6e98810"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-22T13:50:15.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T12:25:44.000</terms:modified>
        <skos:altLabel xml:lang="fr"> comble transversal</skos:altLabel>
        <skos:altLabel xml:lang="de">Lukarne</skos:altLabel>
        <skos:altLabel xml:lang="de">Querdach</skos:altLabel>
        <skos:altLabel xml:lang="de">Zwerchdach</skos:altLabel>
        <skos:altLabel xml:lang="cs">příčná sedlová střecha</skos:altLabel>
        <skos:definition xml:lang="de">Der Giebel des Zwerchhauses. Er soll zwischen der langen Horizontalen des Dachs und vertikalen Formen ausgleichen. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Kleiner Giebelaufsatz an der Außenmauer der Traufseite eines Hauses, dessen First quer zum Hauptdach (Dach) verläuft. Sowohl im französischen als auch im deutschen Palast- und Schlossbau der Renaissance spielen Z., die häufig reich verziert sind, eine große Rolle. Oft sind entlang der Traufkante viele kleine Z. aneinandergereiht (Burg Mansfeld S), oder aber ein großer Z. erstreckt sich fast über die gesamte Breite des Hauses. Ist der Z. geschosshoch und befindet sich dahinter ein nutzbarer Raum, spricht man vom Z.-Haus. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen] </skos:definition>
        <skos:definition xml:lang="cs">Příčná střecha, zastřešení bočních lodí několika rovnoběžnými sedlovými střechami kolmo k podélné ose kostela, viz vikýř s obytným prostorem. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Zwerchdach, Dach mit quer zum First des Hauptdaches verlaufendem First. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Zwerchgiebel</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">příčná střecha</skos:prefLabel>
        <skos:prefLabel xml:lang="es">techo transversal</skos:prefLabel>
        <skos:prefLabel xml:lang="it">tetto trasversale</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">toit transversal</skos:prefLabel>
        <skos:prefLabel xml:lang="en">transverse roof</skos:prefLabel>
    </owl:NamedIndividual>
    


