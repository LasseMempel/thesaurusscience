    skos:closeMatch <http://data.uba.de/umt/_00050928> ;
    skos:definition "The interacting systems of the biological communities and their nonliving environmental surroundings located in the regions where the air temperature is perennially below 10° Celsius, usually at and near the North and South Poles."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Polares Ökosystem"@de,
