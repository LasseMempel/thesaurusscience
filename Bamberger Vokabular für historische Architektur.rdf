        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_26ba1dc1"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_915fda25"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_d96146d9"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-04T17:19:04.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-17T10:54:18.000</terms:modified>
        <skos:altLabel xml:lang="de">Edelstein</skos:altLabel>
        <skos:prefLabel xml:lang="de">Schmuckstein</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Schmucksteine, oder Edelsteine, sind meist Minerale, Glasschmelzen, aber auch Stoffe organischer Herkunft wie Bernstein, Pechkohle oder kleinere formschöne Fossilien, die im allgemeinen als schön empfunden werden und zu Schmuck weiterverarbeitet werden. Perlen, Perlmutt und Korallen zählen nach der Definition der Confédération International de la Bijouterie, Joaillerie, Orfèvrerie des Diamantes, Perles et Pierres (CIBJO) auch zu den Schmucksteinen. [CIBJO]</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_9c0d72b2 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_9c0d72b2">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
