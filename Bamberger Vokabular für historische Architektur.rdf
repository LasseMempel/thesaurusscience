    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_4adca0cb -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_4adca0cb">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_88b4f652"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-07T09:57:50.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T18:50:38.000</terms:modified>
        <skos:definition xml:lang="de">Verbindung von zwei im rechten Winkel zusammenstoßenden Balken mithilfe des Blatts. Die häufigsten Formen sind die gerade E., die E. mit schrägem Schnitt und die hakenförmige E. mit Schwalbenschwanz; die E. kann auch auf Gehrung geschnitten werden. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Ecküberblattung</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_4af80e17 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_4af80e17">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_00e86b9d"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T14:39:16.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T23:02:02.000</terms:modified>
        <skos:altLabel xml:lang="de">Apotropaion</skos:altLabel>
        <skos:definition xml:lang="de">Meist als Fratze ausgebildet, aus Holz oder Stein an Giebel, Mauer oder Tür eines Hauses oder Tores als Abwehrzauber angebracht. [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Neidkopf (von althochdeutsch nîd = Hass), Menschen- oder Tierkopf-Relief zur Abwehr böser Geister an Häusern, in romanischen Kirchen, an Taufsteinen und Chorgestühl. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Reliéf lidské nebo zvířecí hlavy k odvrácení zlých duchů, na domech, v románských kostelích, na křtitelnicích a chórových lavicích. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="en"> apotropaic image</skos:prefLabel>
        <skos:prefLabel xml:lang="it"> maschera apotropaica</skos:prefLabel>
        <skos:prefLabel xml:lang="fr"> tête conjuratoire</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Neidkopf</skos:prefLabel>
        <skos:prefLabel xml:lang="es">máscara apotropaica</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">ochranná hlava</skos:prefLabel>
    </owl:NamedIndividual>
    


