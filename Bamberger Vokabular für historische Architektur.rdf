    <!-- https://hist-arch-vocab.org/bvha#c_a6dba749 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_a6dba749">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
