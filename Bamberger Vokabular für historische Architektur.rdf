        <skos:altLabel xml:lang="en">loss of cohesion</skos:altLabel>
        <skos:definition xml:lang="de">Ablösung von einzelnen Körnern oder Kornaggregaten. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="en">Detachment of single grains or aggregates of grains. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="fr">Détachement de grains individuels ou d’agrégats degrains. Les particules du matériau ne sont plus liées. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="cs">Oddělování zrn nebo shluků zrn. [ICOMOS-ISCS]</skos:definition>
        <skos:prefLabel xml:lang="de"> Desegregation </skos:prefLabel>
        <skos:prefLabel xml:lang="cs">dezintegrace</skos:prefLabel>
        <skos:prefLabel xml:lang="en">disintegration</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">désagrégation</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_969ef358 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_969ef358">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_641a26d4"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_857794c1"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_f10222e0"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-11-13T13:22:19.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T16:28:01.000</terms:modified>
        <skos:altLabel xml:lang="sw">Richtschitt</skos:altLabel>
        <skos:definition xml:lang="de">Das Richtscheit diente zum Zeichnen von geraden Linien, die Länge variierte je nach Größe der Zeichnung. Eher selten, insbesondere auf Abbildungen der Spätgotik, sind deutliche Maßeintragungen zu erkennen. [Voelkle 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Richtscheit</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Als technisches Hilfsmittel der Steinbearbeitung: Das Richtscheit wird vor allem zum Ersehen des Randschlags oder dem Anreißen der Mittelachse benötigt. [Voelkle 2016]</skos:scopeNote>
    </owl:NamedIndividual>
    


