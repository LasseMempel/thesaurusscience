    skos:broader <http://www.eionet.europa.eu/gemet/concept/6279> ;
    skos:closeMatch <http://dbpedia.org/resource/Development_plan> ;
    skos:definition "The statement of local planning policies that each local planning authority is required by statute to maintain, and which can only be made or altered by following the procedures prescribed for that purpose, which include obligations to consult widely and to hold a public local inquiry into objections. The development plan includes: 1) the structure plan for the area (normally prepared by the country council); 2) an area-wide development plan for each district council area."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_2227>,
        <http://eurovoc.europa.eu/2393> ;
