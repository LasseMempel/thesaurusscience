		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/742" />
		<skos:scopeNote xml:lang="en">A building or area in a foundry, where patterns are kept. Patterns are master parts made from working drawings, used to produce moulds.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
