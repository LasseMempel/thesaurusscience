	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk008759">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Sturzbecher</skos:prefLabel>
		<skos:prefLabel xml:lang="en">sturzbecher</skos:prefLabel>
		<skos:altLabel xml:lang="en">sturzbechers</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk005915"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013716"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk005915"/>
		<skos:definition xml:lang="de">Ein Sturzbecher ist ein hoher, schlanker Becher mit gerundetem oder spitzem Boden und ohne Fuß, der also nicht aufrecht stehen kann. Frühmittelalterliche Sturzbecher sind aus Glas und eher schlicht, während spätmittelalterliche und frühneuzeitliche Sturzbecher aus Steinzeug oder Metall hergestellt wurden und insbesondere am Boden oft figürlich ausgeformt sind.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300197148"/>
		<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q2359415"/>
		<skos:exactMatch rdf:resource="http://obg.vocnet.org/20.8399"/>
