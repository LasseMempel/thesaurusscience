        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_c5ab4b1e"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_fda6b373"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-24T16:21:57.000</terms:created>
