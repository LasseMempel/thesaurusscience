    <!-- https://hist-arch-vocab.org/bvha#c_e421119f -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_e421119f">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_ad800342"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-18T14:11:27.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:28:58.000</terms:modified>
        <skos:altLabel xml:lang="de">Böhmische Kappe </skos:altLabel>
        <skos:altLabel xml:lang="de">Böhmische Kugelkappe </skos:altLabel>
        <skos:altLabel xml:lang="de">Böhmisches Kappengewölbe </skos:altLabel>
        <skos:altLabel xml:lang="de">Platzelgewölbe</skos:altLabel>
        <skos:altLabel xml:lang="de">Segmentkugel</skos:altLabel>
        <skos:altLabel xml:lang="fr">calotte</skos:altLabel>
        <skos:altLabel xml:lang="de">flaches Platzel </skos:altLabel>
        <skos:altLabel xml:lang="cs">plochá klenba</skos:altLabel>
        <skos:altLabel xml:lang="en">surbased spherical vault</skos:altLabel>
        <skos:altLabel xml:lang="it">volta a vela a sesto ribassato</skos:altLabel>
        <skos:altLabel xml:lang="fr">voûte à bohémienne plate</skos:altLabel>
        <skos:altLabel xml:lang="fr">voûte à nappes</skos:altLabel>
        <skos:altLabel xml:lang="cs">česká placka</skos:altLabel>
        <skos:definition xml:lang="de">Böhmische Kappe, Böhm. Gewölbe, Platzelgewölbe, Stutzkuppel; im Gegensatz zur Hängekuppel, bei der das Grundquadrat des zu überwölbenden Raums dem Fußkreis einer Kuppel eingeschrieben ist, versteht man unter einer B.K. ein Gewölbe über einer kleineren Fläche als dem Grundquadrat. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Gewölbe, das nur einen Ausschnitt aus einer Hängekuppel darstellt. Wegen der Form des Grundrisses oder wegen mangelnder Höhe ist die reine Kugelfläche nicht ausgebildet. Wie bei der Hängekuppel liegt der eigentliche Fußkreis außerhalb der Ecken des überwölbten Raumes. Bei quadratischem Grundriss werden die vier Schildbogen gleich hoch. Die Einwölbung erfolgt freihändig oder mit einer Brettlehre. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Böhmische Kappe</skos:prefLabel>
        <skos:prefLabel xml:lang="es">bóveda bohemia plana</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">coupole en pendentifs surbaissée</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">pruská klenba</skos:prefLabel>
        <skos:prefLabel xml:lang="en">segmental sail vault</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_ad800342"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_e4411e0d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_e4411e0d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_956c614a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-06T11:15:14.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-21T18:26:28.000</terms:modified>
        <skos:altLabel xml:lang="de">Kreuzarm (Querhaus)</skos:altLabel>
        <skos:altLabel xml:lang="de">Kreuzflügel</skos:altLabel>
        <skos:altLabel xml:lang="de">Transept</skos:altLabel>
        <skos:altLabel xml:lang="fr">bras de transept</skos:altLabel>
        <skos:altLabel xml:lang="fr">croisillon</skos:altLabel>
        <skos:definition xml:lang="de">Teil des Querhauses seitl. des Vierungsquadrats. Beim Quadratischen Schema hat der Q. die Größe des Vierungsquadrats, so dass das Querhaus drei Quadrate umschließt. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="fr"> aile de transept</skos:prefLabel>
        <skos:prefLabel xml:lang="it"> braccio del transetto</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Querhausarm</skos:prefLabel>
        <skos:prefLabel xml:lang="es">brazo de crucero</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">ramena příčné lodi</skos:prefLabel>
        <skos:prefLabel xml:lang="en">transept arm</skos:prefLabel>
    </owl:NamedIndividual>
    


