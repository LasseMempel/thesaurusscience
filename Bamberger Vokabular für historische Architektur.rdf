        <skos:definition xml:lang="de">Truhenreliquiar n; Reliquientruhe f; lat. capsa; scrin(i)um: ein Reliquienbehälter in Form einer kleinen, mit Elfenbein- oder Silberplatten bekleideten hölzernen Truhe mit einem gewölbten oder pyramidenstumpfförmigen Deckel. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Truhenreliquiar</skos:prefLabel>
        <skos:prefLabel xml:lang="en">chest-reliquary</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">coffre-reliquaire</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_4a5bb7db -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_4a5bb7db">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
