        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_9359a6eb"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-10T16:14:37.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-07T15:04:34.000</terms:modified>
        <skos:definition xml:lang="de">Estrich (gr. -mittellat. astricus: Pflaster), fugenloser Fußboden aus weich aufgetragenem Lehm, Asphalt oder Mörtel. Dieser besteht aus verschiedenen Zuschlagstoffen und Zement, Gips, Kalk oder anderen Bindemitteln (Steinholz, Terrazzo, Zemente, Gipse). [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Estrich</skos:prefLabel>
    </owl:NamedIndividual>
    


