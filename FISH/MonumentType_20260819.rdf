    <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2"/>
    <skos:prefLabel xml:lang="en">LAING HUT</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A prefabricated structure of standard lightweight timber wall sections bolted together. Externally the walls were clad with plasterboard covered with felt. Designed in 1940 for use as barrack accommodation.</skos:scopeNote>
