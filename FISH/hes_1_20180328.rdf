	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/42">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/42</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CÀRN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Cuimhneachan a tha na thom no na uchdan cloiche. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CAIRN</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">RECTANGULAR CAIRN</skos:altLabel>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1461" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1487" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1494" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1442" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/43" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/49" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502108" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502706" />
		<skos:scopeNote xml:lang="en">A monument featuring a bank or mound constructed primarily of stone. Use specific term where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
