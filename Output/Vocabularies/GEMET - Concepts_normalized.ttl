    skos:broader <http://www.eionet.europa.eu/gemet/concept/15198>,
        <http://www.eionet.europa.eu/gemet/concept/2824> ;
    skos:definition "any environmental factor that might give rise to the damage of human or animal health"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "environmental health risks"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/13321>,
        <http://www.eionet.europa.eu/gemet/concept/2564> .

<http://www.eionet.europa.eu/gemet/concept/15158> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15161> ;
    skos:definition "EU law Directive on enforcement of claims to improve the environment"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "environmental liability regulations"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15098>,
