    <skos:prefLabel xml:lang="en">LAUNDER</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A trough or gutter for conveying liquids such as water or molten metal. It can be cut in the surface or formed of wood or other materials.</skos:scopeNote>
    <dc1:identifier rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/119793"/>
