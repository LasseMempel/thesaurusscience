		<skos:altLabel xml:lang="de">Klinken (Maschinenelemente)</skos:altLabel>
		<skos:prefLabel xml:lang="en">pawl</skos:prefLabel>
		<skos:altLabel xml:lang="en">pawls</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk019465"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013760"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk019465"/>
		<skos:definition xml:lang="de">Eine Klinke ist ein Maschinenelement in Form eines Hebels, das dazu dient, die Bewegung eines anderen Maschinenteils zu hemmen oder eine Bewegung hervorzurufen. Die Klinke an einem Webstuhl sorgt beispielsweise über ein Sperrrad dafür, dass das Webtuch gespannt bleibt.</skos:definition>
		<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1352803"/>
		<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q55629301"/>
