        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_b2d9d575"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-11-04T18:28:54.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-20T00:18:33.000</terms:modified>
        <skos:altLabel xml:lang="de">Gerüst</skos:altLabel>
        <skos:definition xml:lang="de">Das Gerüst ist eine sich selbst tragende Einheit, bestehend aus den statisch relevanten Hölzern, die in ihren Grundanordnungen die Standsicherheit gewährleisten. Zum Gerüst zählen die tragenden und die aussteifenden Gerüstelemente. [Eißing et al. 2012]</skos:definition>
        <skos:definition xml:lang="de">Gesamtheit der konstruktiven Hölzer bei einem Holzgebäude. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Holzgerüst</skos:prefLabel>
    </owl:NamedIndividual>
    


