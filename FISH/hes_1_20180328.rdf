		<skos:prefLabel xml:lang="gd">BOGSA-FÒN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Bogsa-fòn poblach leis fhèin, le fòn ann.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TELEPHONE BOX</skos:prefLabel>
