    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Matchlock Musket"@en ;
    skos:scopeNote "A musket fired by a piece of burning match being held in the lock which, when the trigger was pulled, would contact with powder in the pan to set off the charge."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/100020> a skos:Concept ;
