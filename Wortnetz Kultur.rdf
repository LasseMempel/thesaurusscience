	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021282">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="mul">Bryozoa</skos:prefLabel>
		<skos:altLabel xml:lang="en">bryozoan</skos:altLabel>
		<skos:altLabel xml:lang="en">bryozoans</skos:altLabel>
		<skos:prefLabel xml:lang="de">Bryozoe</skos:prefLabel>
		<skos:altLabel xml:lang="de">Bryozoen</skos:altLabel>
		<skos:altLabel xml:lang="de">Bryozoon</skos:altLabel>
		<skos:altLabel xml:lang="de">Moostierchen</skos:altLabel>
		<skos:prefLabel xml:lang="en">moss animal</skos:prefLabel>
		<skos:altLabel xml:lang="en">moss animals</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk001769"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk001769"/>
		<skos:definition xml:lang="de">Eine Bryozoe ist ein aquatisches, überwiegend im Meer lebendes Tier, das Kolonien bildet, deren Größe von wenigen Millimetern bis zu 50 Zentimetern reicht. Bryozoen sind sessil und filtern als Strudler suspendierte Kleinnahrung aus dem Wasser. Heute sind etwa 6000 Arten von Bryozoen bekannt- Im Fossilbericht treten sie seit dem Ordovizium auf.</skos:definition>
		<skos:mappingRelation rdf:resource="http://vocab.getty.edu/aat/300265691"/>
		<skos:mappingRelation rdf:resource="http://d-nb.info/gnd/4170528-2"/>
		<skos:mappingRelation rdf:resource="http://www.wikidata.org/entity/Q148134"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk001769"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-08-06T12:03:58+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021286">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">cephalopod</skos:prefLabel>
		<skos:prefLabel xml:lang="mul">Cephalopoda</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Cephalopode</skos:prefLabel>
		<skos:altLabel xml:lang="de">Cephalopoden</skos:altLabel>
		<skos:altLabel xml:lang="en">cephalopods</skos:altLabel>
		<skos:altLabel xml:lang="de">Kopffüßer</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk013501"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk013501"/>
		<skos:definition xml:lang="de">Cephalopoden sind eine ausschließlich im Meer lebende Klasse der Weichtiere. Ihr Körperbau ist durch einen deutlich abgesetzten Kopf mit Armen gekennzeichnet, die gemeinsam der Fortbewegung und dem Beutefang dienen. Viele fossile Gruppen der Cephalopoden sowie der rezente Nautilus weisen eine äußere, gekammerte Kalkschale aus Aragonit auf. Bei anderen Cephalopoden, wie Belemniten, Sepien und Kalmaren, ist die Schale entweder ins Körperinnere verlagert oder weitgehend reduziert. Fossile Cephalopoden gehören zu den wichtigsten Leitfossilien des Paläozoikums und Mesozoikums.</skos:definition>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q128257"/>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4165260-5"/>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300250256"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk013501"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk021292"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk021288"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk021287"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-05-22T17:02:05+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021287">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Altkopffüßer</skos:prefLabel>
		<skos:prefLabel xml:lang="mul">Palcephalopoda</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk021286"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk021286"/>
		<skos:definition xml:lang="de">Ein Altkopffüßer ist ein Cephalopode, der in engerer Verwandtschaft zum modernen Nautilus steht. Die Gruppe der Altkopffüßer ist möglicherweise paraphyletisch und umfasst neben den Nautiloidea auch die ausgestorbenen Überordnungen Endoceratoidea und Actinoceratoidea. Die Altkopffüßer entstanden im Kambrium und sind heute bis auf die Nautiliden ausgestorben. Alle Vertreter besitzen ein äußeres Gehäuse, dessen Formenspektrum von geraden über gekrümmte bis zu vollständig eingerollten Schalen reicht. Die Eier der Altkopffüßer sind verhältnismäßig groß, und die Entwicklungszeit im Ei dauert lange. Die Jungtiere schlüpfen bereits weit entwickelt.</skos:definition>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q442152"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk021286"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-08-05T15:24:28+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021288">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Ammonit</skos:prefLabel>
		<skos:altLabel xml:lang="en">ammonite</skos:altLabel>
		<skos:altLabel xml:lang="de">Ammoniten</skos:altLabel>
		<skos:altLabel xml:lang="en">ammonites</skos:altLabel>
		<skos:prefLabel xml:lang="en">ammonoid</skos:prefLabel>
		<skos:prefLabel xml:lang="mul">Ammonoidea</skos:prefLabel>
		<skos:altLabel xml:lang="de">Ammonoideen</skos:altLabel>
		<skos:altLabel xml:lang="en">ammonoids</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk021286"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk021286"/>
		<skos:definition xml:lang="de">Ein Ammonit ist ein ausgestorbener Cephalopode mit einer charakteristischen, meist spiralig aufgerollten und gekammerten Außenschale aus Aragonit. Ammoniten besiedelten  vom Devon bis zum Ende der Kreide, möglicherweise noch bis zum Anfang des Paläogens, ausschließlich verschiedene Lebensräume des Meeres. Sie sind ausschließlich fossil überliefert und stellen wichtige Leitfossilien für das Paläozoikum und Mesozoikum dar.
Form und Komplexität der Lobenlinie (Naht auf der Schale an der Stelle der inneren Trennwände) ist ein zentrales Merkmal zur Unterscheidung verschiedener Ammoniten-Gruppen.</skos:definition>
		<skos:mappingRelation rdf:resource="http://www.wikidata.org/entity/Q228002"/>
		<skos:mappingRelation rdf:resource="http://d-nb.info/gnd/4001739-4"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk021286"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk021289"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk021290"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-05-22T17:34:44+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021289">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Goniatit</skos:prefLabel>
		<skos:prefLabel xml:lang="en">goniatite</skos:prefLabel>
		<skos:altLabel xml:lang="de">Goniatiten</skos:altLabel>
		<skos:altLabel xml:lang="en">goniatites</skos:altLabel>
		<skos:prefLabel xml:lang="mul">Goniatitida</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk021288"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk021288"/>
		<skos:definition xml:lang="de">Ein Goniatit ist ein Ammonit, der sich bis auf Ausnahmen durch eine einfach gebogene oder geknickte Lobenlinie auszeichnet, bei der die Loben nicht gezahnt oder stark verästelt sind, sondern sanfte Knicke oder Bögen aufweisen. Goniatiten lebten vom Devon bis zum Ende des Perm und sind vor allem für das Devon und Karbon wichtige Leitfossilien.</skos:definition>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q2116552"/>
		<skos:mappingRelation rdf:resource="http://d-nb.info/gnd/4157917-3"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk021288"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-05-27T10:22:54+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021290">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Ceratit</skos:prefLabel>
		<skos:altLabel xml:lang="de">Ceratiten</skos:altLabel>
		<skos:prefLabel xml:lang="mul">Ceratitida</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk021288"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk021288"/>
		<skos:definition xml:lang="de">Ein Ceratit ist ein Ammonit im weiteren Sinne (Ammonoidea). Ceratiten besitzen überwiegend eine ceratitische Lobenlinie, seltener auch ammonitische Lobenlinien. Wie alle Ammonoidea haben sie ein spiralförmiges Außengehäuse. Erste Vertreter entstanden im Ober-Perm. Die Ordnung starb am Ende der Trias aus.</skos:definition>
		<skos:mappingRelation rdf:resource="http://d-nb.info/gnd/4659079-1"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1054661"/>
