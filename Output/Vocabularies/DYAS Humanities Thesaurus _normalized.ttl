    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/479>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/633>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/687> ;
    skos:scopeNote "Families consisting of two parents and their socially recognized offspring."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/670> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/328> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "One man rule"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/691> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/226> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Traditional everyday costumes"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/463>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/544>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/607> ;
    skos:scopeNote "Types of workaday traditional costumes for women or men. They are ensembles of garments and materials specially selected for their comfort and practicality."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/695> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/135> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Incest taboo"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2457>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/339>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/61> ;
    skos:scopeNote "The prohibition of sexual contacts between individuals related with bonds of consanguinity or -in certain instances- through common descent."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/697> a skos:Concept ;
    skos:altLabel "Arsis (Greek metre)"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/43> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Short syllable"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/493>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/504>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/678> ;
    skos:scopeNote "A short syllable is the one whose vowel is short, provided that after the vowel there follows either a simple consonant or nothing at all. It should be noted that in ancient Greek metrics there is no grammatical rule of emphasis that prescribes that specific diphthongs are considered as short when they are at the end of an unprecedented inflected word."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/708> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/315> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Reforms"@en ;
    skos:scopeNote "Radical institutional changes within economic, political, social and other fundamental structures and functions within a state. Reforms aim at the change of the institutional framework, but not at its radical overthrow by means of revolutionary measures and practices. Reforms are enforced by political leaderships (more often by a part of them) and/or are propelled by the pressure of social movements. Their enforcement is realized with or without recourse to a wider consensus through elections or plebiscites."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/712> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/83> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Inflected"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/48> ;
    skos:scopeNote "Inflected parts-of-speech are called the grammatical categories, for which one or more inflectional suffixes are used or included."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/717> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/240> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Dramatische Genres"@de,
        "Dramatic genres"@en ;
    skos:scopeNote "The dramatic genre consists of a set of codifications that provide information about the reality the text is supposed to represent. The genre gives an immediate indication about the reality represented, provides a grid for reading/viewing, and establishes a convention between the text and its reader/ spectator. Apart from the original binary opposition of tragic/ comic, the evolution of western theatre from antiquity to the present resulted in the emergence of new genres, such as drama."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/760> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/375> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Twelvetide customs"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/295>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/345>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/613> ;
    skos:scopeNote "The customary events that take place during the Twelvetide. These events incorporate Christian and pre-Christian elements, with symbolic references to the life of Christ, the saints of the Christian tradition as well as the rebirth of nature."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/780> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/559> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Family (institution)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/101>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/301>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/731> ;
    skos:scopeNote "The socially and legally defined roles and relationships that permeate the function of families as units of biological and social reproduction."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/824> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Iambic metron"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/493>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/709>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/993> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/856> a skos:Concept ;
    skos:altLabel "Greek drama"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/717> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Griechische Drama"@de,
        "Ancient drama"@en ;
    skos:scopeNote "A literary genre initially intended to be performed, it was one of the three genres of ancient Greek poetry together with epos and lyric poetry. Deriving from Dionysian rituals, during the classical times it evolved into a theatre genre and became an integral part of the institutional structure of Athenian democracy. It comprised three genres: tragedy, comedy and satyr play. Their performances were presented during the drama festivals."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/87> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/17> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Orchester"@de,
        "Orchestra"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/146>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2173>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/966> ;
    skos:scopeNote "The orchestra was the central circular part of the ancient Greek theatre, populated by the Chorus and – during the first period – the actors as well."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/874> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/475> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Revolutions"@en ;
    skos:scopeNote "Expressions of collective action with a broad participation by subordinate social groups or strata, which aim at the radical change of social, political and economic relations through the use of violence."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/968> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/670> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Kingship"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/969> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Trochaic metron"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/652>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/666>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/997> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/978> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/584> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Athletic games inscriptions"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Inscriptions related to athletic games. Their content could range from the introduction of athletic games and the elevation of local games to a rank equaling that of the four major games (Olympia, Pythia, Nemea, Isthmia) to the recording of the names of the winners in the contests."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/997> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/727> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Trochee"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/652>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/666>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/969> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1078> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/89> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Dramaturgie (Kunst)"@de,
        "Dramaturgy (art)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1306>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2205>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/426>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/861> ;
    skos:scopeNote "Dramaturgy is the art of dramatic composition of the theatre play. Classical dramaturgy aims at establishing its writing principles, entailing a set of specific theatre rules and techniques required to write a play. Since the formulation of the Epic Theatre theory, the concept of dramaturgy was broadened. It comprises the confluence of the performance text’s components and how they are constructed to generate meaning for the audience."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1085> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/597> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Darstellende Künste"@de,
        "Performing arts"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2205> ;
    skos:scopeNote "The term denotes the arts based on the performance (representation) or re-presentation of their materials. They are characterised by their dual structure: the representing (the stage etc.) and the represented (figurative or symbolised reality). They comprise arts that produce performances or performing events such as theatre, dance, music, opera, operetta, circus, puppet theatre, but also mass media arts using mechanical devices and multimedia such as cinema television or radio."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1140> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1093> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ephebic catalogues"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2090>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2091>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2092>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Inscriptions that recorded catalogues of names of ephebes (adolescents). These lists appeared either autonomously or as parts of honorary resolutions or votive inscriptions. The catalogues usually include the names of the sophronestes or guardian (the head of each section of adolescents), the cosmetes or director (the leader of all the adolescents), the teachers and the ephebes."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1180> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/852> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Analepsis (Narratology-Methods)"@en ;
    skos:scopeNote "Narrative technique that involves the interruption of the chronological sequence of events by the interjection of events or scenes that took place earlier than the point in the story where we are at any given moment."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/120> a skos:Concept ;
    skos:altLabel "Modes (music theory)"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Harmoniai"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/427>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/45>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/713>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/716> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1332> a skos:Concept ;
    skos:altLabel "Anhang"@de,
        "Hinzufügung"@de ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/849> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Affix"@de,
        "Affix"@en ;
    skos:scopeNote "An affix is a morpheme that is attached to a word stem to form a new word. Affixes may be derivational, like English -ness and pre-, or inflectional, like English plural -s and past tense -ed. They are bound morphemes by definition; prefixes and suffixes may be separable affixes. Affixation is, thus, the linguistic process speakers use to form different words by adding morphemes (affixes) at the beginning (prefixation), the middle (infixation) or the end (suffixation) of words."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1446> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Drachms (ancient)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1447>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1816>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2428> ;
    skos:scopeNote "In ancient Greece the term identifies usually silver coins with variant weight, depending on the specific weight standard to which they belong. Their main multiples are the didrachm, the tridrachm, the tetradrachm, the pentadrachm, the exadrachm, the octadrachm, the decadrachm and the dodecadrachm. Their main subdivisions are the hemidrachm or triobol, the diobol, the obol and the hemiobol. Although the drachm was usually silver, some gold or even copper ones also exist."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1447> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Obols (coins)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1446>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1449>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1800> ;
    skos:scopeNote "Small silver coins equivalent to 1/6 of the drachm. According to the Attic weight standard the obol was subdivided into eight chalkoi, while according to the Aeginetan one into twelve chalkoi. Bronze obols seem also to have been in existence from the 2nd c. BCE onwards. Obols were originally spits of copper or bronze traded by weight, while six obols made a drachma or a handful, since that was as many as the hand could grasp."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1464> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/24> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Flans (Numismatics)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2481>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2483> ;
    skos:scopeNote "Disc-shaped metal objects which were transformed into coins by stamping. The flans had to be of a certain diameter and weight, factors of decisive importance for the value of the coin."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1471> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/22> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Mint marks (Numismatics)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1456>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2187> ;
    skos:scopeNote "Marks engraved, generally into the reverse die, to indicate the mint in which a coin was produced. Such marks may consist of letters, symbols or monograms."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1494> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/205> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Shipbuilding"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1495>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/192>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1949>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1950> ;
    skos:scopeNote "The technology for the construction of floating vessels, which is closely connected to the entire history and prehistory of human societies. The variations and developments of shipbuilding over time and space are evident in the various materials, the methods and facilities of construction, the means of propulsion, the size and the form of the vessels."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1496> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Antoniniani"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1491>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1498>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2351> ;
    skos:scopeNote "Roman silver coins that were first introduced by Caracalla in 215 CE. Although antoniniani were valued at 2 denarii their weight was equal only to 1.5 denarii. On the obverse of the antoniniani the emperor is depicted wearing a radiate crown and empresses are shown with a lunar crescent beneath their bust. Their weight and silver content were gradually decreased until they were totally replaced by the aureliani in 274 CE."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1501> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Aurei"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1491>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1507>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2353> ;
    skos:scopeNote "Gold Roman coins originally valued at 25 denarii. The aurei were regularly issued from the 1st c. BCE to the beginning of the 4th c. CE, when they were gradually replaced by the solidus."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1509> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/575> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Catholics"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1589>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1724>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/458> ;
    skos:scopeNote "Christians who recognize the Pope, bishop of Rome, as head of the Church and as the successor of apostle Peter. As to dogma, religious practices and clergy organisation, Catholics follow the prescriptions of the Roman Catholic Church. Catholics are the most numerous and geographically expanded Christian community in the world."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/151> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/24> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Means for the recording of inscriptions"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Means that capture on paper the inscribed surface or the entire object that bears it. These means help epigraphists study inscriptions, offering them the ability to study even when not in front of the object, since moving the object bearing an inscribed surface is often very difficult or impossible."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1539> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/575> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Protestants"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/458> ;
    skos:scopeNote "Christians who follow one of the numerous Churches, which emerged gradually after a large part of European Christianity split off from the Roman Catholic Church in the 16th century. Despite their differences, all Protestants reject the supremacy of the Pope and the Roman Catholic prescriptions as to Christian sacraments, clergy, and religious practices."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1542> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Corpora"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1566>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1727> ;
    skos:scopeNote "A corpus is a collection of written or spoken texts, especially the entire works of a particular author or a body of writing on a particular subject. Corpora “are generally assembled with particular purposes in mind, and are often assembled to be (informally speaking) representative of some language or text type. A corpus is a collection of (1) machine-readable (2) authentic texts (including transcripts of spoken data) which is (3) sampled to be (4) representative of a particular language or language variety or author or group of authors."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/164> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Hyperdiazeuxis (Harmonic science)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/279>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/599>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/641>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/642> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1707> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/26> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Monks (Christianity)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1708>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/575> ;
    skos:scopeNote "Believers who live in seclusion from secular social life and are formally included in an established community that practices an ascetic way of life and is organized under specific rules of personal and collective behaviour. Monasticism, which originates in late antiquity Egypt, developed in diverse forms in the history of Christianity. Monks, whether organised in autonomous communities, or belonging to broader groups or even monastic orders, constitute an essential part of -mainly- the Orthodox and Catholic Churches."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1709> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2158> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Languages (communication systems)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2607> ;
    skos:scopeNote "Language is a medium for the expression or exchanging of thoughts, concepts, knowledge, and information as well as the fixing and transmission of experience and knowledge. It is based on cognitive processes, subject to societal factors and subject to historical change and development. In this definition, language refers to a specific form of expression that is restricted to humans, and differs from all other possible languages, such as animal communication and artificial languages through creativity, the ability to make conceptional abstractions, and the possibility of metalinguistic reflection. A specific system of signs and combinatory rules which are arbitrary but passed on as conventions. Such linguistic systems, which F.de Saussure calls langue ( langue vs parole), are the object of structural investigations, while research oriented towards a generative understanding of language attempts to describe the underlying linguistic competence of a speaker as well as the speaker&rsquo;s creative ability to produce a potentially infinite number of sentences, depending on his/her communicative needs. Transformational grammar is based on this kind of dynamic understanding of language. Τhe following properties of human language have been argued to separate it from other communication systems:<br />(a) Arbitrariness: there is usually no rational relationship between a sound or sign and its meaning.[5] For example, there is nothing intrinsically house-like about the word &quot;house&quot;. (b) Discreteness: language is composed of small, repeatable parts (discrete units) that are used in combination to create meaning. (c) Displacement: languages can be used to communicate ideas about things that are not in the immediate vicinity either spatially or temporally. (d) Duality of patterning: the smallest meaningful units (words, morphemes) consist of sequences of units without meaning. This is also referred to as double articulation. (e) Productivity: users can understand and create an indefinitely large number of utterances. (f) Semanticity: specific signals have specific meanings."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1720> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Secretary of the Council (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1218>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1651>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/742> ;
    skos:scopeNote "An office that appears in ancient Athens. The secretary of the Council was a member of the Council belonging to a tribe other than the one of the serving prytany. He was elected for the duration of a prytany, and his task was the publication, classification and keeping of official documents. His name was recorded in the prescript of decrees for archiving purposes."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1722> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/26> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Prytanies (Ancient Greece)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1715>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1716>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1721>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1744> ;
    skos:scopeNote "A term that first appears in ancient Athens during the times of Athenian politician Cleisthenes. Prytanies are internal groups consisting of fifty members, a number resulting from the allocation of five hundred members of the Council in ten sections according to their tribe. The term of each prytany lasted for one-tenth of the year. These groups were responsible for preparing the cases for discussion in the Council."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1783> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1583> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Muslim religious offices"@en ;
    skos:scopeNote "The religious offices of Islam relate to two aspects of religious and social life. On the one hand, they refer to the interpretation of the holy law (sharia) on the level of social relations, institutions, economy, and politics. On the other hand, they relate to the support and guidance of the faithful in matters of worship, everyday practices, and behaviour in the framework of the religious community."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1806> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/31> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Chor (Griechische Drama)"@de,
        "Chorus (Ancient Greek drama)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1287>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1291>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1329>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1802> ;
    skos:scopeNote "Dramatic convention denoting players who perform vocally in unison. It appeared for the first time in the ancient Greek drama as an expression of the democratic function of the city-state (polis), descending from the dithyramb. The principal function of this antirealistic, epic feature was to provide the general mythological and ideological background for the introduction of the myth under dramatisation. Under some sort of pretext, the chorus is incorporated into and follows the action, ensuring with its presence the continuity of the dramatic flow, although the choral songs separate the episodes. It is a perfectly homogeneous group with two exceptions: The division into two groups (semi-choruses) and the detachment of the Coryphaeus who leads the chorus, while rarely are the parts distributed to more voices."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1821> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1742> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Logistai (Special committees)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1809>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1822>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/370>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/69> ;
    skos:scopeNote "Committees consisting of ten officials selected by lot, who were responsible for the audit of the financial accounts (logoi) that the special committees delivered at the end of their term of office."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1822> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Logistis (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1809>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1821>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/370>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/69> ;
    skos:scopeNote "An office that appears in ancient Athens. Logistai were officials selected by lot and were responsible for the audit of the financial accounts (logoi) that the special committees delivered at the end of their term of office."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1829> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Darics"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1851>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2360>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2368> ;
    skos:scopeNote "The Greek term for the gold coins of the Persian Empire. They were introduced by Darius I towards the end of the 6th c. BCE and they continued to circulate until the conquest of the Persian Empire by Alexander the Great in 330 BCE. On the obverse they bore the image of the Persian king armed with a bow and arrow and they were devided into 20 sigloi."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1851> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Sigloi"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1829>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2351>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2368> ;
    skos:scopeNote "The Greek term for the silver coins of the Persian Empire. They were introduced by Darius I towards the end of the 6th c. BCE and they continued to circulate until the conquest of the Persian Empire by Alexander the Great in 330 BCE. On the obverse they bore the image of the Persian king armed with a bow and arrow."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1852> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/20> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "War events"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1831> ;
    skos:scopeNote "Events that take place in the framework of war confrontations and are directly connected to military operations. Therefore, war events include types of conflicts and operations and not events related to war conditions but not belonging to military activity in its strict sense (e.g. mobilization)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1861> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Unciae (coins)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1492>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2164>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2352> ;
    skos:scopeNote "Roman bronze coins equivalent to the 1/12 of the assarius. They were minted mainly during the Republican period but they were briefly revived under Trajan and Hadrian during Imperial times."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1877> a skos:Concept ;
    skos:altLabel "Colts (coins)"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Pegasoi (coins)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2351>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2360>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2364> ;
    skos:scopeNote "The silver staters of Corinth and its colonies which bore the image of the Pegasus on their reverse. In antiquity they were known as colts."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1879> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Sextantes"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1492>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2324>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2352> ;
    skos:scopeNote "Roman bronze coins of the Republican period, equivalent to the 1/6 of an assarius. They were cast coins and they bore two pellets as a mark of value."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1953> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Archon epomymos (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1651>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1985>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2201>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/69> ;
    skos:scopeNote "An office that first appears in ancient Athens. One of the nine archons, mainly responsible for the protection of citizens' property from arbitrary actions. Ιn cases involving property inheritance, the archon protected the family and in particular orphans and heiresses. Also, he regulated certain religious festivals (such as the City Dionysia), the appointment of choregoi for drama contests, etc. The eponymous archon gave his name to the year of his term and referred to the prescripts of the decrees for archiving purposes."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2002> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/289> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Akademische Berufe"@de,
        "Professionals"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2425> ;
    skos:scopeNote "Professionals increase the existing stock of knowledge; apply scientific or artistic concepts and theories; teach about the foregoing in a systematic manner; or engage in any combination of these activities. Tasks performed by professionals usually include: conducting analysis and research, and developing concepts, theories and operational methods; advising on or applying existing knowledge related to physical sciences, mathematics, engineering and technology, life sciences, medical and health services, social sciences and humanities; teaching the theory and practice of one or more disciplines at different educational levels; teaching and educating persons with learning difficulties or special needs; providing various business, legal and social services; creating and performing works of art; providing spiritual guidance; preparing scientific papers and reports. Supervision of other workers may be included."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2040> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2253> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ecclesiastical and religious organisations"@en ;
    skos:scopeNote "Collective bodies that fulfill adiminstrative and decision-making duties, offer services and perform rituals that are believed to benefit either all believers of a religous faith or specific groups of believers. Ecclesiastical and religious organisations provide the constitutional framework of religions and are crucial in the emergence and reproduction of religious identities and practices."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/206> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Hypodiazeuxis (Harmonic science)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/279>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/619>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/641>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/642> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2081> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Euergetes (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1407>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2080>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2082>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2083> ;
    skos:scopeNote "An office that appears in ancient Athens. This is the second honorary office (apart from that of proxenos) with which the Council and the Assembly honored foreign citizens for the services they provided to the Athenian Demos. Usually the title of euergetes was conferred together with that of the proxenos in cases of prominent persons."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2087> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Enktesis"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1407>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2080>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2082>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2083> ;
    skos:scopeNote "A privilege granted to foreigners in ancient Athens. It involved the right to own land and a house in Athens given to foreigners who were awarded the office of proxenos. This right was often extended to their descendants."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2099> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Quinarii"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1491>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1492>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2351> ;
    skos:scopeNote "Roman silver coins valued at half a denarius. The quinarii were struck for a few years, along with the silver sestertius, following the introduction of the denarius in 211 BCE. At this time the quinarius was valued at 5 asses. The coin was reintroduced in 101 BCΕ, this time valued at 8 asses due to retariffing of the denarius to 16 asses in 118 BCE. The coin was produced sporadically until the 3rd c. CE."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2121> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Tremisses"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1507>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2353>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2490> ;
    skos:scopeNote "Gold coins that were originally struck at 1/216 of the Roman libra and valued at a third of a solidus. They were introduced around 383 CE and continued to be issued by the Romans until the 5th c. CE. Their minting continued during the Byzantine Empire until the 9th c. CE."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2162> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Besses"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1492>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2163>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2352> ;
    skos:scopeNote "Roman bronze coins produced during the Roman Republic. Valued at two-thirds of an assarius, they were only produced in 126 BCE by C. Cassius Longinus in combination with the dodrans."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2163> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Dodrantes"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1492>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2162>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2352> ;
    skos:scopeNote "Roman bronze coins produced during the Roman Republic. Valued at three-fourths of an assarius, they were produced only twice: in 127 BCE by M. Caecilius Metellus Q. f. and in 126 BCE by C. Cassius Longinus in combination with the bes."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2164> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Semunciae"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1492>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1861>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2352> ;
    skos:scopeNote "Roman bronze coins produced during the Roman Republic. They were valued at one twenty-fourth of an assarius or half an uncia."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2188> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/22> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Control-marks (Numismatics)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1456>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2187> ;
    skos:scopeNote "Marks or symbols of some kind, generally on the reverse of a coin, apparently indicating some aspect of the administration of coin production."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2198> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1093> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Catalogues of proxenoi"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1407>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2080>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2082>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2083> ;
    skos:scopeNote "Inscriptions comprising catalogues with the names of persons who held the office of proxenos in ancient Greece. These lists are recorded in the proxenia decrees. The decrees usually assigned the office to a citizen and prescribed that the new name be recorded in the catalogue of proxenia. Usually the names were registered by cities according to the origin of each proxenos."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/226> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/24> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Traditional costumes"@en ;
    skos:scopeNote "The local variations of costumes, as they combine garments according to a region&#39;s geological and climatic conditions, the prevailing social/aesthetic trends and the practical needs of the persons wearing them."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2356> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Epistatis (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1044>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1082>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2357>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "An office that appears in ancient Athens. The epistatis was responsible for the general supervision of public works and the management of their finances."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2357> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1742> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Epistatai (Ancient Greece)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1044>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1082>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2356>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "A committee consisting of annual officials who were responsible for the general supervision of public works and the management of their finances. After completing their term of office, the epistatai presented to the Assembly a detailed report (logos), which was then inscribed on a stele."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2369> a skos:Concept ;
    skos:altLabel "Physicians"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2190> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Medical doctors"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2102>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2371>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2373>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2377> ;
    skos:scopeNote "Health professionals who study, diagnose, treat and prevent illness, disease, injury and other physical and mental impairments in humans through the application of the principles and procedures of modern medicine. Medical doctors plan, supervise and evaluate the implementation of care and treatment plans by other health care providers, and conduct medical education and research activities."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2372> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Gold tetartera"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1507>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2353>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2375> ;
    skos:scopeNote "Light weight gold Byzantine coins that were introduced by the Emperor Nikephoros II (963-969 CE). The coins weighed 22 carats instead of the 24 of the older solidi. They continued to be struck by every successor of Nikephoros II until 1092 CE."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2375> a skos:Concept ;
    skos:altLabel "Stamena"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Histamena"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1507>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2353>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2372> ;
    skos:scopeNote "The gold Byzantine solidi that received this new name when the slightly lighter gold tetartera were introduced during the reign of Nikephoros II (963-969 CE). From the reign of Basil II (976-1025 CE) onwards the histamena changed in form from the original solidi, becoming wider and thinner, as well as concave. In the 12th c. CE the name stamenon came to be applied to a billon coin of low value."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2423> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2425> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Bioethics"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1602>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2190>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2377>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2422> ;
    skos:scopeNote "Subfield of ethics that concerns the ethical issues arising in medicine and from advances in biological science (genetics, biotechnology etc). One central area of bioethics is the ethical issues that arise in relations between health care professionals and patients (i.e. truth-telling, confidentiality, physician-assisted suicide, euthanasia). A second area focuses on broader issues of social justice in health care (i.e. justice in the allocation of health care). A third area concerns the ethical issues raised by new biological knowledge or technology (i.e. mapping of human genome, cloning)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2425> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2421> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Applied ethics"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2002>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2459> ;
    skos:scopeNote "The domain of ethics that includes professional ethics, such as business ethics, engineering ethics, and medical ethics, as well as practical (as opposed to theoretical) ethics. Practical ethics is concerned with the application of ethical principles to the consideration of real-life practical moral problems (euthanasia, abortion, animal rights, ecology, race and gender issues, the morality of war etc.), but not focused on any one discipline. One of the major disputes among those who work in applied ethics is whether or not there is a general and universal account of morality applicable both to the ethical issues in the professions and to various practical problems."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2431> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Basilica (coins)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1819>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1820>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2351> ;
    skos:scopeNote "Byzantine, silver coins. They were first introduced in 1304 CE by Andronikos II Palaiologos (1282-1328 CE). They weighed ca. 2 gr. and were officially traded at a rate of 1:12 gold hyperpyra. They were replaced towards the end of the 14th c. CE by the stavrata."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2440> a skos:Concept ;
    skos:altLabel "New sociology of knowledge"@en,
        "New sociology of science"@en,
        "SSK"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2582> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Sociology of scientific knowledge"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2439>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2448>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2469>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2529> ;
    skos:scopeNote "The research field that emerged in the early 1970s, investigating from a sociological standpoint the very content of scientific knowledge (scientific ideas, methods, procedures and practices), which had been excluded both from the sociology of knowledge that had argued that sciences and mathematics were insulated from social forces, and the traditional sociology of science that had focused on the institutional features, norms and values of the scientific community. Examining the epistemological status of scientific knowledge, sociology of scientific knowledge argues that the outcomes of scientific research are not determined (or fully determined) by the theoretical and experimental prosedures, but they are decisively affected by their social setting, shaping importantly the research field of science and technology studies."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2476> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/248> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Alchemy"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1888>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2377>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2467>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2477> ;
    skos:scopeNote "The art of ancient and medieval times intending at liberating parts of the cosmos from temporal existence to achieve perfection. Material perfection was sought through practices which aimed at the transmutation of base metals into gold and the development of the elixir of life that was supposed to lead to longevity, immortality and, finally, redemption. Spiritual ennoblement could result from the receipt of inner revelation (gnosis or other mystical experience). Although alchemy had been defined as a form of magic in the late medieval times, it is considered to have contributed importantly to the shaping of scientific methods and practices and the development of chemistry, pharmacology and medicine in the early modern times."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2516> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/20> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Globalisation"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2039>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2517>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/315>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/845> ;
    skos:scopeNote "A historical process involving a fundamental shift or transformation in the spatial scale of human social organisation that links distant communities and expands the reach of power relations across regions and continents. This radical shift&nbsp; refers to every sector of social life, such as politics, economy, technology, production, environmental issues, international law, security, human rights etc. The term is also used in a narrower sense that focuses on economy, to describe a single world economy after the collapse of communism or to define the growing integration of the international capitalist system in the post-war period."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2517> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/20> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Internationalisation"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2221>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2516>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2518>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/845> ;
    skos:scopeNote "The growing interdependence between states. The idea of internationalisation presumes that the states remain discrete national units with clearly demarcated borders, in contrast to globalisation, in which the very distinction between the domestic and the external breaks down."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2521> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2529> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Geophysics"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1610>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2501>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2520>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2548> ;
    skos:scopeNote "The science concerned with the physical properties and processes of the earth, atmosphere, and hydrosphere, as well as of planetary bodies. As a discipline it was formed around the late 19th and early 20th century, with its own societies and institutes. Some of the disciplines that are now included in geophysics are seismology, meteorology, geodesy, gravimetry and others."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2522> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2529> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Anatomy"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1602>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1603>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2362>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2377> ;
    skos:scopeNote "The study of the structure of living organisms, especially of their internal parts, by means of dissection and microscopical examination. Modern anatomy was established as a method and practice related to medicine and surgery in the early modern times, focused mostly on the dissection of the human and animal body. During that period it was also used for art. Until the 19th century, anatomy was inseparable from physiology."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2534> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/240> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Typen (Theater)"@de,
        "Stock character types (theatre)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/625> ;
    skos:scopeNote "A type is a stereotypical fictional person possessing physical, psychological, or moral attributes that are known to the audience in advance and remain constant throughout the play, appearing in several different plays. A type is created whenever individual and original characteristics are sacrificed to generalisation and magnification. The spectator identifies easily the type in question by a psychological trait, a social milieu, or an occupation, usually belonging to a certain genre. Types are found mainly in theatrical forms having a strong tradition in which the recurring stock characters represent the major human types or&nbsp;failings that are critisised&nbsp; by the dramatist."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2536> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1860> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Prose (body of works)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1731>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1732>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1733>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2635> ;
    skos:scopeNote "The body of literary compositions in prose, that is in a language that usually has no meter and rhythm, and in this respect it is mainly opposed to the term &quot;verse&quot;.&nbsp;Sometimes the boundaries between poetry and prose are blurred, as in the case of prose poems or in the case of verse novels."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2611> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/248> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cosmology"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1581>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2105>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2195>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2604> ;
    skos:scopeNote "The study of the structure and evolution of the universe. Until cosmology became a branch of modern astronomy, it had been part of ancient and medieval philosophy, and more specifically metaphysics. Geocentrism, heliocentrism, expanding universe, big-bang, cosmic strings etc. are some of the most eminent theories articulated in Western cosmology."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2626> a skos:Concept ;
    skos:altLabel "Laws of science"@en,
        "Natural laws"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Laws of nature"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1888>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2424>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2529>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2604> ;
    skos:scopeNote "The statements, typically in mathematical form, with which scientists aim to describe nature. The search for quantitative laws for the description, or also for the explanation, of natural phenomena has characterised modern science and has its origins in the Scientific Revolution of the 17th century."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/287> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
