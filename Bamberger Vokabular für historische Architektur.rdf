        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-03T20:58:08.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-03T21:01:47.000</terms:modified>
        <skos:altLabel xml:lang="de">Kästchenreliquiar</skos:altLabel>
        <skos:altLabel xml:lang="la">bursa</skos:altLabel>
        <skos:altLabel xml:lang="la">cista</skos:altLabel>
        <skos:altLabel xml:lang="la">cistula</skos:altLabel>
        <skos:altLabel xml:lang="el">theke</skos:altLabel>
        <skos:definition xml:lang="de">Reliquienkästchen n; Kästchenreliquiar n; gr. pyxis; theke; lat. ladula; bursa; cista; cistula: ein kastenförmiger Reliquienbehälter, meist aus Eichenholz gefertigt und mit Elfenbeinplatten belegt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Reliquienkästchen</skos:prefLabel>
        <skos:prefLabel xml:lang="en">box-reliquary</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">cassette-reliquaire</skos:prefLabel>
        <skos:prefLabel xml:lang="la">ladula</skos:prefLabel>
        <skos:prefLabel xml:lang="el">pyxis</skos:prefLabel>
    </owl:NamedIndividual>
    


