        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T15:57:16.000</terms:modified>
        <skos:definition xml:lang="de">Nadel f: zum Befestigen des Palliums dienend, im Mittelalter oft mit Gemmen verziert. Heute nur noch dekorativ verwendet. Der Nadelkopf ist manchmal mit Edelsteinen besetzt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Palliumnadel</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">jehlice (pallium)</skos:prefLabel>
        <skos:prefLabel xml:lang="en">pin</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">épingle</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_9169b225 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_9169b225">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_e7b7dd2d"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
