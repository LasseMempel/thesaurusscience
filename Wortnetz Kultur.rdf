	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021338">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">medical device</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Medizinprodukt</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004570"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk004627"/>
		<skos:definition xml:lang="de">Ein Medizinprodukt ist ein Gerät oder Ausrüstungsgegenstand, der gemäß rechtlicher Definition für medizinische Zwecke wie Diagnostik, Therapie, Überwachung oder Verhütung bestimmt ist.</skos:definition>
		<skos:mappingRelation rdf:resource="http://d-nb.info/gnd/4024018-6"/>
		<skos:mappingRelation rdf:resource="http://www.wikidata.org/entity/Q6554101"/>
		<skos:narrowMatch rdf:resource="http://vocab.getty.edu/aat/300247523"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004627"/>
