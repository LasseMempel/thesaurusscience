        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_9f74e321"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_da9a0c9b"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-11T17:01:10.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T17:35:24.000</terms:modified>
        <skos:altLabel xml:lang="de">Labarum</skos:altLabel>
        <skos:altLabel xml:lang="cs">korouhev s křížovým ráhnem</skos:altLabel>
        <skos:definition xml:lang="de">Kreuzfahne f : Fahne, deren Fahnentuch an einer beweglichen Querstange befestigt ist und unten entweder gerade, bogenförmig oder gezackt endet; das Fahnentuch ist meist aus schwerer Seide und reich bestickt; die Fahnenstange ist von einem Kreuz bekrönt. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Labarum, Siegeszeichen des auferstandenen Christus über den Tod: Wimpel an einem langschäftigen Kreuz. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Znamení vítězství vzkříšeného Krista. nad smrtí, korouhev (praporec) na kříži s dlouhou žerdí. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Kreuzfahne</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">bannière croisée </skos:prefLabel>
        <skos:prefLabel xml:lang="cs">labarum</skos:prefLabel>
    </owl:NamedIndividual>
    


