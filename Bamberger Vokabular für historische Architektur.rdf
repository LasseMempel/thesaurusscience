    <!-- https://hist-arch-vocab.org/bvha#c_40f7ac79 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_40f7ac79">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_57cb750d"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-29T12:19:57.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-29T12:20:52.000</terms:modified>
        <skos:definition xml:lang="de">Ein bogenförmig gekrümmtes Tragwerk mit je einem Gelenk an den beiden Kämpferpunkten. Der G. ist das einfachste, statisch unbestimmt gelagerte Fachwerksystem. Ein Tragwerk mit je einem Gelenk an den beiden Kämpferpunkten und einem dritten am Scheitel heißt Dreig. er ist statisch bestimmt und wird bei Brücken und großen Hallen verwendet. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Gelenkbogen</skos:prefLabel>
    </owl:NamedIndividual>
    


