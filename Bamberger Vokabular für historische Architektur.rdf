    <!-- https://hist-arch-vocab.org/bvha#c_48e00c0a -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_48e00c0a">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_9a214939"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T11:33:05.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T12:34:07.000</terms:modified>
        <skos:definition xml:lang="de">Entsprechend der Mullion Fortsetzung der Stäbe im Bogenfeld des Maßwerks; senkrechter Stab, der auf der Spitze des die Fensterbahnen abschließenden Bogens beginnt und bis zum Fensterbogen eines Maßwerkfensters im Perpendicular Style reicht. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Supermullion</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_48f83942 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_48f83942">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_3e0c1197"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_c0a0cd49"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_983f74c0"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_6397f79b"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_71f0541b"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_c08338d7"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-04T18:37:42.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T17:42:34.000</terms:modified>
        <skos:altLabel xml:lang="de">Cappa </skos:altLabel>
        <skos:altLabel xml:lang="de">Chorkappe</skos:altLabel>
        <skos:altLabel xml:lang="de">Chormantel</skos:altLabel>
        <skos:altLabel xml:lang="de">Rauchmantel</skos:altLabel>
        <skos:altLabel xml:lang="de">Vespermantel</skos:altLabel>
        <skos:altLabel xml:lang="la">cappa pluvialis</skos:altLabel>
        <skos:altLabel xml:lang="en">cope</skos:altLabel>
        <skos:altLabel xml:lang="la">mantus</skos:altLabel>
        <skos:altLabel xml:lang="fr">pluvial</skos:altLabel>
        <skos:definition xml:lang="de">Pluviale n. Cappa f, Chormantel m, auch Rauchmantel m, Vespermantel m, Chorkappe f: halbkreisförmig geschnittener, langer, vorne offener, ärmelloser Mantel aus Seide, häufig mit breitem, vertikalem Zierbesatz (--&gt; Stab), ursprünglich (und neuerdings wieder oft) mit Kapuze, später nur noch mit Zierbehang (--&gt; Schild); das Pallium wird bei feierlichen Anlässen außerhalb der Messe getragen und unterliegt dem Farbenkanon. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Pluviale</skos:prefLabel>
        <skos:prefLabel xml:lang="la">cappa</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">chape (pluvial)</skos:prefLabel>
        <skos:prefLabel xml:lang="en">pluvial</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">pluviál</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_48ff993a -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_48ff993a">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a09cd233"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_bkfjsv2k"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-10T10:38:49.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T15:14:29.000</terms:modified>
        <skos:altLabel xml:lang="de">Zeremonienmeister</skos:altLabel>
        <skos:altLabel xml:lang="la">magister caeremoniarum</skos:altLabel>
        <skos:altLabel xml:lang="fr">maître de cérémonie</skos:altLabel>
        <skos:altLabel xml:lang="la">praefectus caeremoniarum</skos:altLabel>
        <skos:definition xml:lang="de">Zeremoniar m; Zeremonienmeister m; lat. caeremoniarius; magister caeremoniarum; praefectus caeremoniarum: Kleriker, dem bei feierlichen liturgischen Handlungen, besonders bei der feierlichen Messe, die Sorge um die Beachtung der vorgeschriebenen Zeremonien obliegt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Zeremoniar</skos:prefLabel>
        <skos:prefLabel xml:lang="la">caeremoniarius</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">cérémonaire</skos:prefLabel>
        <skos:prefLabel xml:lang="en">master of ceremonies</skos:prefLabel>
    </owl:NamedIndividual>
    


