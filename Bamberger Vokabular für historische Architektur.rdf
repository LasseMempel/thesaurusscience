        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-12T16:55:24.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:41:58.000</terms:modified>
        <skos:definition xml:lang="de">Nebengewölbe, das ein anderes Gewölbe bei der Aufnahme großer Lasten unterstützt. Entlastungsgewölbe. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Verstärkungsgewölbe</skos:prefLabel>
        <skos:prefLabel xml:lang="en">reinforcing vault</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte de renfort</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_049c4c22"/>
    </owl:NamedIndividual>
    


