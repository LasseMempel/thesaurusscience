		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/640" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/641" />
		<skos:scopeNote xml:lang="en">A building or complex where care and treatment are provided to the sick, aged, infirm and poor. Use narrower term where possible.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
