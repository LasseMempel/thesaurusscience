    <!-- https://hist-arch-vocab.org/bvha#c_9b13a591 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_9b13a591">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_80695e85"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-04-10T16:18:50.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-26T08:32:04.000</terms:modified>
        <skos:altLabel xml:lang="de">Kyklopenmauerwerk</skos:altLabel>
        <skos:altLabel xml:lang="de">Netzmauerwerk</skos:altLabel>
        <skos:altLabel xml:lang="de">Polygonalmauerwerk</skos:altLabel>
        <skos:altLabel xml:lang="es">mampostería poligonal</skos:altLabel>
        <skos:altLabel xml:lang="fr">maçonnerie polygonale</skos:altLabel>
        <skos:altLabel xml:lang="it">opera poligonale</skos:altLabel>
        <skos:altLabel xml:lang="cs">pelasgické zdivo</skos:altLabel>
        <skos:altLabel xml:lang="de">pelasgisches  Mauerwerk</skos:altLabel>
        <skos:altLabel xml:lang="cs">polygonální zdivo</skos:altLabel>
        <skos:definition xml:lang="de">Ein aus bes. großen, unregelmäßigen, manchmal aber sehr gut gefügten Natursteinen bestehendes Mauerwerk. Z. kommt hauptsächl. in der myken. Epoche, bei den Hethitern und bei Inkabauten vor. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Mauerwerk aus besonders großen, unregelmäßig geformten, nur grob bearbeiteten Bruch-steinblöcken. In größere Zwischenräume zwischen den Steinen werden Zwicker eingefügt, um die Stabilität zu sichern. Archäologen unterscheiden u.a. den tyrrhenischen, japygischen und mykenischen Verband, die Prähistoriker den megalithischen Verband. (Glossarium Artis, Bd. 3, Bögen und Mauerwerk)</skos:definition>
        <skos:definition xml:lang="de">Mauerwerk, dessen Ansichtsfläche aus polygonalen Steinen besteht. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Zyklopenmauerwerk</skos:prefLabel>
        <skos:prefLabel xml:lang="en">cyclopean masonry</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kyklopské zdivo</skos:prefLabel>
        <skos:prefLabel xml:lang="es">mampostería ciclópea.</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">maçonnerie cyclopéenne</skos:prefLabel>
        <skos:prefLabel xml:lang="it">mura ciclopiche</skos:prefLabel>
    </owl:NamedIndividual>
    


