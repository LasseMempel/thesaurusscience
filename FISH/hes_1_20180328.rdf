		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/324" />
		<skos:scopeNote xml:lang="en">A settlement enclosed by one or more rows of closely spaced vertical timbers embedded in a narrow foundation trench.</skos:scopeNote>
