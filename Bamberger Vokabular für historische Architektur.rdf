        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-21T17:42:22.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T16:23:10.000</terms:modified>
        <skos:altLabel xml:lang="de">Laubenhof</skos:altLabel>
        <skos:definition xml:lang="de">Innenhof eines Gebäudes mit umlaufenden Bogengängen im Erdgeschoss oder auch in weiteren Geschossen; der italienische &quot;cortile&quot;. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Laubenhof, Innenhof mit meist mehrgeschossigen Bogenstellungen (Arkade), bes. häufig in Schlössern und repräsentativen Bürgerhäusern der Renaissance. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Arkadenhof</skos:prefLabel>
        <skos:prefLabel xml:lang="en">arcaded court</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">arkádové nádvoří</skos:prefLabel>
        <skos:prefLabel xml:lang="it">cortile ad arcate</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">cour à arcades</skos:prefLabel>
        <skos:prefLabel xml:lang="es">patio de arcadas</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_1df30dfb -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_1df30dfb">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_d1a8ce66"/>
