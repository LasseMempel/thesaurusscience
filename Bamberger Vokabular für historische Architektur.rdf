        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T16:07:51.000</terms:modified>
        <skos:definition xml:lang="de">Boulevard (frz.), urspr. das Bollwerk einer Festung, dann bes. in Frankreich gebräuchl. Bezeichnung für breite Straßen in großen Städten mit prachtvollen Wohn-, Geschäfts-, Restaurant- und Theaterbauten; die B.s folgen häufig den Wallinien der Stadtbefestigung, die nach dem Schleifen als breite Straßen genutzt wurden. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Boulevard</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">bulvár</skos:prefLabel>
    </owl:NamedIndividual>
    


