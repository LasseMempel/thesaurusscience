        <skos:prefLabel xml:lang="es"> soga</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Läufer (Stein)</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">běhoun (kámen)</skos:prefLabel>
        <skos:prefLabel xml:lang="en">runner (stone)</skos:prefLabel>
    </owl:NamedIndividual>
    


