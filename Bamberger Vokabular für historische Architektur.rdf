    <!-- https://hist-arch-vocab.org/bvha#c_9f4d97be -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_9f4d97be">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_41d94569"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_19d56a39"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
