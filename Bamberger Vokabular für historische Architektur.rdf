    <!-- https://hist-arch-vocab.org/bvha#c_728e1444 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_728e1444">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_dbc1e529"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-09T10:21:24.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:35:15.000</terms:modified>
        <skos:altLabel xml:lang="de">Doppelmantelkuppel</skos:altLabel>
        <skos:altLabel xml:lang="de">Doppelschalenkuppel</skos:altLabel>
        <skos:altLabel xml:lang="de">Zweischalenkuppel </skos:altLabel>
        <skos:altLabel xml:lang="fr">deux coupoles superposées</skos:altLabel>
        <skos:altLabel xml:lang="en">double dome</skos:altLabel>
        <skos:altLabel xml:lang="en">two-shelled dome</skos:altLabel>
        <skos:altLabel xml:lang="de">zweischalige Kuppel</skos:altLabel>
        <skos:definition xml:lang="de">Doppelschalenkuppel, ein kuppelförmiges Doppelgewölbe, dessen innere (untere) und äußere (obere) Schale konstruktiv durch Stege miteinander verbunden sein können, meist aber aus ästhet. Gründen getrennt sind, wobei die innere Schale den Innenraum nach oben abschließt, die äußere die Gesamtwirkung des Bauwerks nach außen wesentl. mitbestimmt. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Kuppel aus zwei konzentrischen, unabhängig voneinander errichteten und durch Stege oder durch ein Gerüst miteinander verbundenen Kuppelschalen (Innenkuppel, Außenkuppel). Die Konstruktion kann auch aus einer sogenannten Zweischalenmauer oder Hohlmauer gebildet werden, man spricht dann auch von Hohlkörperkuppel oder Zwischenschalenkuppel. Die Doppelkuppel kann leichter sein als die einschalige Kuppel, außerdem vereinfacht diese Art der Konstruktion die Inspektion und Restaurierung des Gewölbes. Es kann auch eine Kuppelkonstruktion gemeint sein, bei der durch die weiträumige Scheitelöffnung in der inneren (ersten) Kuppel eine zweite Kuppel sichtbar wird. (Glossarium Artis)</skos:definition>
        <skos:prefLabel xml:lang="de">Doppelkuppel</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">coupole à deux voûtes</skos:prefLabel>
        <skos:prefLabel xml:lang="en">double shelled dome</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_72986600 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_72986600">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_7c4af9bc"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_depjwldn"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_f7qkhf86"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T10:16:45.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T18:29:38.000</terms:modified>
        <skos:definition xml:lang="de">Mudejar (aus arab. mudaggin = wohnen bleiben [der Araber unter den Christen]), spanischer Dekorationsstil aus maurischen, gotischen und (später) Renaissanceformen. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Z arab. mudaggin = zůstat bydlet, Arabové mezi křesťany. Styl španělského dekoru z maurských, gotických a později renesančních prvků. [Koch 2008]</skos:definition>
        <skos:hiddenLabel xml:lang="de">Mudejar</skos:hiddenLabel>
        <skos:prefLabel xml:lang="de">Mudéjar</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">mudejárský sloh</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_72996021 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_72996021">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0380427d"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_34ca6582"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-20T16:23:25.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T17:31:10.000</terms:modified>
        <skos:altLabel xml:lang="de">Einschlag</skos:altLabel>
        <skos:altLabel xml:lang="cs">ztráta materiálu</skos:altLabel>
        <skos:definition xml:lang="de">Der Verlust von Steinmaterialdurch eine äußere mechanische Krafteinwirkung, welche dieGestalt eines Kraters haben kann, wenn der Gegenstand, derdie Gesteinsoberfläche trifft, hart und klein ist, z. B. ein Geschoss oder durch ein hartes Werkzeug. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="fr">Dégât mécanique dû à l’impact d’un projectile(balle, éclat d’obus etc.) ou d’un outil dur. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="cs">Kamene, způsobená mechanickým účinkemnárazu, která může mít také tvar „kráteru”, pokud jepředmět, který kamenný povrch zasáhl malý a tvrdý, např.projektil. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="en">Mechanical damage due to the impactof a projectile (bullet, shrapnel) or of a hard tool. [ICOMOS-ISCS]</skos:definition>
        <skos:prefLabel xml:lang="de">Stoßschaden</skos:prefLabel>
        <skos:prefLabel xml:lang="en">impact damage</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">poškození nárazem</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">trace d’impact</skos:prefLabel>
    </owl:NamedIndividual>
    


