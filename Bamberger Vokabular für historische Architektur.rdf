        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T13:40:18.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-02T16:18:28.000</terms:modified>
        <skos:definition xml:lang="de">Azulejos, (span. v. arab. azul: blau), vielfarbig gemusterte Fayenceplatten, deren Herstellung und Verwendung als Wandfliesen im 14. Jh. von den Mauren in Spanien eingeführt wurde (Baukeramik). [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Azulejo</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">azulejo</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_c438aa37 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_c438aa37">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
