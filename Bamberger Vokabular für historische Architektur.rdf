    <!-- https://hist-arch-vocab.org/bvha#c_0a9d5145 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_0a9d5145">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_4ba8c795"/>
