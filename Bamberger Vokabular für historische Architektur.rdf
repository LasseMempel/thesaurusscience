        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_e5eb81f8"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-06T22:31:44.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T21:04:39.000</terms:modified>
        <skos:altLabel xml:lang="fr">substratoire</skos:altLabel>
        <skos:definition xml:lang="de">Mittelstück n, substratorium: als Unterlage für das Korporale dienendes, reich verziertes Tuch, das oft mit einer Darstellung der Kreuzigung oder des Lammes Gottes bestickt ist; früher in einigen Gegenden Deutschlands gebräuchlich. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Mittelstück</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">substratorium</skos:prefLabel>
        <skos:prefLabel xml:lang="la">substratorium</skos:prefLabel>
    </owl:NamedIndividual>
    


