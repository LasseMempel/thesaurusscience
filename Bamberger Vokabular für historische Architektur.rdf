        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T11:07:53.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-31T00:01:32.000</terms:modified>
        <skos:altLabel xml:lang="cs">přenosný oltář</skos:altLabel>
        <skos:altLabel xml:lang="cs">vícekřídlový oltář</skos:altLabel>
        <skos:definition xml:lang="de">Ein Flügelaltar mit mehreren Flügelpaaren, wodurch sich mehrere Wandlungsmöglichkeiten ergeben. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Vzhled oltáře bylo možno měnit výměnnými páry křídel, což je pak proměnný oltář. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Wandelaltar</skos:prefLabel>
        <skos:prefLabel xml:lang="es">altar con aletas modificable</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">pentaptyque</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">proměnný oltář</skos:prefLabel>
    </owl:NamedIndividual>
    


