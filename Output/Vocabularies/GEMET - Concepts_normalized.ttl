    skos:broader <http://www.eionet.europa.eu/gemet/concept/4574> ;
    skos:closeMatch <http://data.uba.de/umt/_00014676> ;
    skos:definition "Any technique by which an unknown colour is evaluated in terms of standard colours; the technique may be visual, photoelectric or indirect by means of spectrophotometry."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Kolorimetrie"@de,
        "colourimetry"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Colorimetry> .

<http://www.eionet.europa.eu/gemet/concept/1575> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2606> ;
    skos:closeMatch <http://data.uba.de/umt/_00014679> ;
    skos:definition "This type of plant is flexible in response and can be built in the 100-600 MW capacity range. It produces electrical power from both a gas turbine (ca. 1300°C gas inlet temperature), fuelled by natural gas or oil plus a steam turbine supplied with the steam generated by the 500°C exhaust gases from the gas turbine. The thermal efficiency of these stations is ca. 50 per cent compared with a maximum of 40 per cent from steam turbine coal fired power stations. This type of plant can be built in two years compared with six years for a coal-fired station and 10-15 years for nuclear."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Kombikraftwerk"@de,
        "combined cycle-power station"@en .

<http://www.eionet.europa.eu/gemet/concept/1578> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1322>,
        <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:closeMatch <http://data.uba.de/umt/_00005606>,
        <http://dbpedia.org/resource/Combustibility> ;
    skos:definition "The property of a substance of being capable of igniting and burning."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Brennbarkeit"@de,
        "combustibility"@en .

<http://www.eionet.europa.eu/gemet/concept/1588> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13149> ;
    skos:definition "Holding or displaying for sale, offering for sale, selling, delivering or placing on the market in any other form."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_21547> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Kommerzialisierung"@de,
        "commercialisation"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Commercialization> .

<http://www.eionet.europa.eu/gemet/concept/1595> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8926> ;
    skos:closeMatch <http://data.uba.de/umt/_00018324>,
        <http://dbpedia.org/resource/Commercial_vehicle> ;
    skos:definition "Vehicle designed and equipped for the transportation of goods."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Nutzfahrzeug"@de,
        "commercial vehicle"@en .

<http://www.eionet.europa.eu/gemet/concept/1600> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2533> ;
    skos:closeMatch <http://dbpedia.org/resource/Common_Agricultural_Policy> ;
    skos:definition "The set of regulations and practices adopted by member countries of the European Community that consolidates efforts in promoting or ensuring reasonable pricing, fair standards of living, stable markets, increased farm productivity and methods for dealing with food supply or surplus."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/2443> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Gemeinsame Agrarpolitik"@de,
        "common agricultural policy"@en .

<http://www.eionet.europa.eu/gemet/concept/1601> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10085> ;
    skos:definition "A system of law established by following earlier judicial decisions and customs, rather than statutory or legislatively enacted law."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Gemeinsame Regeln"@de,
        "common agreement"@en .

<http://www.eionet.europa.eu/gemet/concept/1618> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/77> ;
    skos:closeMatch <http://data.uba.de/umt/_00051584> ;
    skos:definition "Involvement in public or private actions, as members or as a member of a particular ethnic, political or social group, with the purpose of exerting influence."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Kommunale Beteiligung"@de,
        "community participation"@en .

<http://www.eionet.europa.eu/gemet/concept/1619> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4752> ;
    skos:closeMatch <http://data.uba.de/umt/_00010833> ;
    skos:definition "A tenet of environmental policy, according to which the costs of ecological challenges, environmental quality improvements and the removal of environmental hazards are allotted to community groups or local corporations and, thereby, to the general public."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Gemeinlastprinzip"@de,
        "community-pays principle"@en .

<http://www.eionet.europa.eu/gemet/concept/1622> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8582> ;
    skos:definition "Traffic caused by people travelling regularly over some distance, as between a suburb and a city and back, between their place of residence and their place of work."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Pendelverkehr"@de,
        "commuter traffic"@en .

<http://www.eionet.europa.eu/gemet/concept/1628> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4255> ;
    skos:closeMatch <http://data.uba.de/umt/_00025558> ;
    skos:definition "Official guidelines or set of guidelines adopted by a company for the management of its activity."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/2469> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Unternehmenspolitik"@de,
        "company policy"@en .

<http://www.eionet.europa.eu/gemet/concept/163> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6187> ;
    skos:closeMatch <http://data.uba.de/umt/_00001329>,
        <http://dbpedia.org/resource/Aesthetics> ;
    skos:definition "Considerations, values, and judgements pertaining to the quality of the human perceptual experience (including sight, sound, smell, touch, taste, and movement) evoked by phenomena or components of the environment."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Ästhetik"@de,
        "aesthetics"@en .

<http://www.eionet.europa.eu/gemet/concept/1630> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10084> ;
    skos:closeMatch <http://data.uba.de/umt/_00020513>,
        <http://dbpedia.org/resource/Comparative_law> ;
    skos:definition "The study of the principles of legal science by the comparison of various systems of law."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/3922> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
