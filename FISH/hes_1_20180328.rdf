		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/713" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/714" />
		<skos:scopeNote xml:lang="en">Any factory used for the manufacture of textiles.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
