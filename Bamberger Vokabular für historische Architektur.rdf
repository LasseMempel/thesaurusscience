    <!-- https://hist-arch-vocab.org/bvha#c_973079e1 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_973079e1">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f4e2bee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-22T13:24:38.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-30T10:07:45.000</terms:modified>
        <skos:altLabel xml:lang="de">Haubendach</skos:altLabel>
        <skos:altLabel xml:lang="de">Kaiserdach</skos:altLabel>
        <skos:altLabel xml:lang="de">Zwiebeldach</skos:altLabel>
        <skos:altLabel xml:lang="fr">comble à l\&apos;impériale</skos:altLabel>
        <skos:altLabel xml:lang="it">t. a cipolla</skos:altLabel>
        <skos:altLabel xml:lang="es">t. persa</skos:altLabel>
        <skos:altLabel xml:lang="es">tejado imperial</skos:altLabel>
        <skos:altLabel xml:lang="it">tetto a bulbo</skos:altLabel>
        <skos:altLabel xml:lang="it">tetto all\&apos;imperiale</skos:altLabel>
        <skos:altLabel xml:lang="fr">toit à l\&apos;impériale</skos:altLabel>
        <skos:definition xml:lang="de">Ein unten konvex und oben konkav geschwungenes Haubendach. [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Předchůdce cibulové střechy, ale v dolní části konkávní, často má více zakřivených pater, které jsou někdy zakončeny lucernou (baroko). [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Vorform des Zwiebeldachs, aber im Unterteil konkav; oft Unterbau für mehrfach geschweifte Aufbauten, die gelegentlich in einer Laterne enden (Barock). [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Welsche Haube, Haubendach, Dachhelm; Turmdach mit geschweifter Kontur. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Welsche Haube</skos:prefLabel>
        <skos:prefLabel xml:lang="es">techo imperial</skos:prefLabel>
        <skos:prefLabel xml:lang="it">tetto ad elmo</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">toit en oignon</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">vlašská helmice</skos:prefLabel>
        <broaderByConstruction rdf:resource="https://hist-arch-vocab.org/bvha#c_f4e2bee8"/>
    </owl:NamedIndividual>
    


