		<skos:prefLabel xml:lang="fr">papier mâché</skos:prefLabel>
		<skos:altLabel xml:lang="en">papier-mâché</skos:altLabel>
		<skos:altLabel xml:lang="de">Papiermaché</skos:altLabel>
		<skos:prefLabel xml:lang="de">Papiermaschee</skos:prefLabel>
		<skos:altLabel xml:lang="de">Papiermaschees</skos:altLabel>
		<skos:altLabel xml:lang="de">Pappmaché</skos:altLabel>
		<skos:altLabel xml:lang="de">Pappmaschee</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk002991"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013599"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk002991"/>
		<skos:definition xml:lang="de">Papiermaschee ist ein Faserprodukt aus einer modellierbaren Masse, die aus eingeweichtem Papier, Leim, Stärke sowie weiteren Zusätzen besteht und nach dem Trocknen aushärtet.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4173210-8"/>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300014245"/>
