    skos:prefLabel "Hearth Tile"@en ;
    skos:scopeNote "One of the component tiles used in the construction of a tile hearth, being the floor of, or area in front of, a fireplace."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141185> a skos:Concept ;
