    skos:closeMatch <http://data.uba.de/umt/_00020569>,
        <http://dbpedia.org/resource/Reflection> ;
    skos:definition "The return of waves or particles from surfaces on which they are incident."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Reflexion"@de,
