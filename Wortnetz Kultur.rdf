		<skos:altLabel xml:lang="de">Nägel (Befestigungselemente)</skos:altLabel>
		<skos:prefLabel xml:lang="en">nail (fastener)</skos:prefLabel>
		<skos:altLabel xml:lang="en">nails (fasteners)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006114"/>
