    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_543fbf08 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_543fbf08">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_3e25acca"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_cdfab687"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_e14684ea"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_4de0216a"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_b424873f"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-20T15:31:52.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T13:28:50.000</terms:modified>
        <skos:altLabel xml:lang="en">coffering</skos:altLabel>
        <skos:altLabel xml:lang="en">lacunar</skos:altLabel>
        <skos:definition xml:lang="de">Ein vertieftes, gerahmtes Feld in der Decke oder in der Leibung eines Gewölbes oder Bogens. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="cs">KAZETA, hranaté zahloubené pole v plochém nebo zaklenutém stropu (&quot;kazetový strop&quot;), příp. v podhledu oblouku, který je &quot;kazetován&quot;, tj. rozdělen do pravoúhlých, mnohoúhlých či zaoblených polí; kazeta může být prázdná, nebo vyplněná ornamenty, barvami či malbami; zvl. v antice, renesanci a baroku. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Kastenförrnig vertieftes Feld einer flachen oder gewölbten Decke (» Kassettendecke«) oder einer Bogenlaibung, die »kassettiert«, d.h. in rechteckige, vieleckige oder gerundete Felder aufgeteilt ist. Die Kassette kann leer oder mit Ornamenten, Farben oder Gemälden ausgefüllt sein. Besonders in der Antike, der Renaissance und im Barock. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Kassette</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">caisson</skos:prefLabel>
        <skos:prefLabel xml:lang="en">coffer</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kazeta</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_54446646 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_54446646">
