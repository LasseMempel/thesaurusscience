    <!-- https://hist-arch-vocab.org/bvha#c_e7f0b018 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_e7f0b018">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_41d94569"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_19d56a39"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-28T08:20:05.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-26T16:10:43.000</terms:modified>
        <skos:altLabel xml:lang="fr">bois</skos:altLabel>
        <skos:altLabel xml:lang="en">corbel piece</skos:altLabel>
        <skos:altLabel xml:lang="cs">sedlo</skos:altLabel>
        <skos:altLabel xml:lang="fr">sous-longeron</skos:altLabel>
        <skos:altLabel xml:lang="it">trave a sella</skos:altLabel>
        <skos:definition xml:lang="de">Ein waagerechtes Holz  zur Verbreiterung des Auflagers über einem Ständer und zur Unterstützung eines Unterzugs. Durch Anordnung von einem oder mehreren S.ern kann die freie Spannweite von Unterzügen wie durch Kopfbüge (Büge) oder Streben verringert werden. Das S. hat auch die Aufgabe, das Hirnholz des Ständers vor dem Aufsplittern zu schützen. Formal sind auch verschiedene Kapitelle z.B. das ion. dem S. verwandt. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Sattelholz: kopfzoniges Holz über frei stehendem Ständer unter Unterzug bzw. Deckenbalken zur besseren Lastaufnahme, oft mit Kopf und/ oder von Ständerschalen umfasst; immer in Richtung des zu unterstützenden Balkens orientiert. (Eißing et al. 2012)</skos:definition>
        <skos:prefLabel xml:lang="de">Sattelholz</skos:prefLabel>
        <skos:prefLabel xml:lang="en">bolster</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">semelle</skos:prefLabel>
        <skos:prefLabel xml:lang="es">sobre viga de madera</skos:prefLabel>
        <skos:prefLabel xml:lang="it">sottotrave</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">trámové sedlo</skos:prefLabel>
    </owl:NamedIndividual>
    


