        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-28T10:55:12.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T23:16:19.000</terms:modified>
        <skos:definition xml:lang="de">Bildstock; im Freien, bes. an öffentl. Wegen errichtetes religiöses Wahrzeichen, meist in Form einer Säule oder eines Pfeilers mit einem religiösen Bildwerk in einer Nische, einem tabernakelähnl. Aufbau oder als Bekrönung. Steinerne B.n, in got. Zeit oft mit architekton. Zierrat, finden sich neben solchen aus Holz hauptsächl. in Franken, Schwaben und in den Alpenländern. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Betsäule</skos:prefLabel>
    </owl:NamedIndividual>
    


