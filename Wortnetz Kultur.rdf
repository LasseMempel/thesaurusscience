		<skos:altLabel xml:lang="de">Grabenfüllung</skos:altLabel>
		<skos:prefLabel xml:lang="de">Grabenverfüllung</skos:prefLabel>
		<skos:altLabel xml:lang="de">Grabenverfüllungen</skos:altLabel>
		<skos:prefLabel xml:lang="en-UK">trench reinstatement (infilling)</skos:prefLabel>
