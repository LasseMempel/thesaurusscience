    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "WALLED CEMETERY"@en ;
    skos:scopeNote "A high status, walled, Roman burial ground containing cremations and/or inhumations in mausolea, tombs, barrows, coffins or cists. Dating from the late 1st to the 4th Century AD. DO NOT USE for cemeteries of later dates which are walled."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/100532> a skos:Concept ;
