		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1153" />
		<skos:scopeNote xml:lang="en">A furnace for the manufacture of glass. Includes glass cones, open hearth and oil-fired furnaces.</skos:scopeNote>
