		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1218" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1224">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1224</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TAIGH SHOITHICHEAN-CRUTHACHAIDH GAS</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Prìomh ionad-obrachaidh aig FACTARAIDH gas. Tha gual ga ròstadh ann an GLAINNEachan srònach gus gas, còc agus co-bhathar eile a dhèanamh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">RETORT HOUSE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1215" />
				<skos:scopeNote xml:lang="en">Central functional building of a gas works. Coal is roasted in retorts producing gas, coke and byproducts.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
