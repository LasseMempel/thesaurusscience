		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502189" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502637" />
		<skos:scopeNote xml:lang="en">A stone on which runes have been inscribed.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1560">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1560</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">SEALLADH-TÌRE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Pìos talmhainn air a bheil làraichean, structaran no fianais eile eil gnìomhachd mac an duine.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">LANDSCAPE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/36" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1442" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/988" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501664" />
		<skos:scopeNote xml:lang="en">An area of ground containing sites, structures and other evidence for human activity.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
