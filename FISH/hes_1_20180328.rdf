		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/387">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/387</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">RAON PAIRÈIDIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite far a bheil luchd-obrach an airm ri spaistearachd no eacarsaichean màrsail, far am bi iad ag ullachadh airson màrsail no tachartasan sònraichte eile.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PARADE GROUND</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/380" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/351" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/361" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/385" />
		<skos:scopeNote xml:lang="en">A place where military personnel parade, practice marching, assemble or muster for a march or any other special purpose.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/389">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/389</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">RAINNSE-TRÈANAIDH THANCAICHEAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Pìos talmhainn, leis na togalaichean is structaran co-cheangailte ris, far am faigh an luchd-obrach trèanadh ann an draibheadh thancaichean is carbadan armailteach eile.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TANK TRAINING RANGE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/380" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/290" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/381" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/386" />
		<skos:scopeNote xml:lang="en">An area of ground, with associated buildings and structures, where personnel are trained in the operation of tanks and other military vehicles.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/390">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/390</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TARGAID</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar no rud sam bith air a bheilear a' tilgeil le airm adhair, mara no talmhainn airson cleachdadh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TARGET</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-04-20T11:52:06</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">FIRING TARGET</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/380" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500985" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/286" />
		<skos:scopeNote xml:lang="en">Any structure or object, used for the purpose of practice shooting by aerial, seaborne or land mounted weapons.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/391">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/391</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LORG-RAINNSE THARGAIDEAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far a bheilear a' losgadh gunnaichean an aghaidh phlèanaichean agus gunnaichean-mòra air targaidean a tha a' gluasad a-rèir traca gèidse chaol.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TRACKED TARGET RANGE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/380" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/290" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/381" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/386" />
		<skos:scopeNote xml:lang="en">A site where anti aircraft guns and artillery are fired at a moving target propelled along a narrow gauge track.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/392">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/392</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÀRACH CÒMHDHAIL AN AIRM</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làraichean is structaran airson giùlan luchd-obrach, carbadan is buill-airm an airm.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MILITARY TRANSPORT SITE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/393" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/278" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/507362" />
		<skos:scopeNote xml:lang="en">Sites and structures for the transport of military personnel, vehicles and armaments.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/393">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/393</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">RATHAD AIRM</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Rathad a chaidh a thogail gu sònraichte airson muinntir, carbadan is acainnean an airm a ghluasad gu luath.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MILITARY ROAD</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">MILITARY WAY</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/392" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500482" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502890" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501695" />
		<skos:scopeNote xml:lang="en">A road constructed primarily for the rapid movement of military personnel, vehicles and equipment.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/394">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/394</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">DÌDEAN  DHAINGNICHEAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Sreath de dh'uidheaman dìona, mar bhallachan, uchdain is dìgean, a dhìonas togalach no tuineachadh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">OUTWORKS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">OUT WORK</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/278" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1454" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1518" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1536" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/317" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/339" />
		<skos:scopeNote xml:lang="en">A series of defensive features, such as walls, banks and ditches, which protect a building or settlement.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/397">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/397</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">SEASTAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">An sorch concrait air an deach moirtear-spiocaide a mhunntachadh. Chaidh seo a chleachdadh le Freiceadan na Dùthcha rè an Dàrna Chogaidh Mhòir mar ghleus an aghaidh ionnsaigh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SPIGOT MORTAR MOUNTING</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/278" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/337" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501687" />
		<skos:scopeNote xml:lang="en">A concrete pedestal, or 'thimble', which was used to mount a spigot mortar. Deployed by the Home Guard during WWII as an anti-invasion measure.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/398">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/398</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">IONAD-DÌON SEALACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Ionad far a bheil co-dhiù aon togalach a tha co-cheangailte ri ionad arm nan Ròmanach le uchdan agus dìg mun cuairt air agus a chaidh a chleachdadh o àm gu àm no fad ùine ghoirid a-mhàin.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TEMPORARY COMPOUND</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/278" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/2322" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/347" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/364" />
		<skos:scopeNote xml:lang="en">A compound containing one or more buildings, attached to a Roman military installation and enclosed within a bank and ditch, which was used either intermittently or for a short period only.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/399">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/399</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">DAINGNICHEAN A' BHAILE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Daingneachadh dìona, mar rampairean, dìgean agus ballachan-cloiche, a chaidh a thogail gus baile no cathair a dhìon.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TOWN DEFENCES</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/278" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/400" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/401" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/508522">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/508522</dcterms:identifier>
				<skos:prefLabel xml:lang="en">TOWN GATE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-02-22T14:25:49</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-02-22T14:28:01</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/399" />
				<skos:scopeNote xml:lang="en">A highly defensible gateway, usually of stone with two or more storeys, built into the defensive walls of a town or city.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1454" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/198" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/331" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/333" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/346" />
		<skos:scopeNote xml:lang="en">Defensive fortifications, such as ramparts, ditches and stone walls, built to defend a town or city.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
