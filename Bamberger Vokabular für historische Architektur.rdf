        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-26T13:37:28.000</terms:modified>
        <skos:altLabel xml:lang="de">Ringbewehrung</skos:altLabel>
        <skos:altLabel xml:lang="it">armatura anulare</skos:altLabel>
        <skos:altLabel xml:lang="en">compression ring</skos:altLabel>
        <skos:altLabel xml:lang="cs">kleštinový věnec</skos:altLabel>
        <skos:altLabel xml:lang="cs">pozední věnec</skos:altLabel>
        <skos:altLabel xml:lang="cs">věncové ztužení</skos:altLabel>
        <skos:definition xml:lang="de">Kreisförmige oder auch polygonale Eisen- oder Holz einlagen, die in Schlitze gefügt und mit Blei vergossen werden. Sie dienen zur Absicherung gegen die z.B. am Fuße von Kuppeln und Klostergewölben auftretenden Ringspannungen . [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Ringanker, Anker, der ein Gebäude einen Bauteil (Turmhelm, Kuppel) ringförmig umschließt. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="es"> anclaje anular</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Ringanker</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">ancrage en anneau</skos:prefLabel>
        <skos:prefLabel xml:lang="en">tension ring</skos:prefLabel>
        <skos:prefLabel xml:lang="it">tirante anulare</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">ztužující věnec</skos:prefLabel>
    </owl:NamedIndividual>
    


