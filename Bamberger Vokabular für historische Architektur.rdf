        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-11T17:44:34.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T16:07:33.000</terms:modified>
        <skos:altLabel xml:lang="de">Kommuniontuch</skos:altLabel>
        <skos:altLabel xml:lang="la">mappula</skos:altLabel>
        <skos:altLabel xml:lang="la">tobalea</skos:altLabel>
