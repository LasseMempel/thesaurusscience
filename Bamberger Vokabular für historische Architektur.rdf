    <!-- https://hist-arch-vocab.org/bvha#c_e5121bd1 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_e5121bd1">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_2c0cce41"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_0094d807"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_418863be"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_51280541"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_db764c30"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_ceec0c04"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T18:17:13.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T12:43:29.000</terms:modified>
        <skos:altLabel xml:lang="de">Kirchenschiff</skos:altLabel>
        <skos:altLabel xml:lang="cs">lod\&apos;, chrámová</skos:altLabel>
        <skos:definition xml:lang="de">Kirchenschiff, Innenraum in Langbauten, sprachl. mit dem Naos des gr. und dem Navis (Cella) des röm. Tempels ident. Während man von einschiffigen Kirchen (Saalkirchen) sprechen kann, gibt es den Begriff des einschiffigen Raums im Profanbau nicht. Dagegen kann man von mehrschiffigen Sälen auch bei profanen Räumen sprechen. Bei mehrschiffigen Anlagen heißt der mittlere Raum Mittels. (Haupts.), die seitl., meist paarweise angeordneten und oft niedrigeren Räume Seitens.e (Abseiten). Der obere Teil eines Mittels.s heißt bei Basiliken Hochs. Das südl. Seitens. wird manchmal Männers., das nördl. Frauens., die Langhauss.e, im Gegensatz zum Chor Laiens.e genannt. Die einzelnen S.e werden durch Stützglieder (Säule, Pfeiler, manchmal Stützenwechsel) getrennt und können gleich (Halle) oder verschieden hoch sein (Basilika, Pseudobasilika, Staffelhalle). Ein S. quer zum Haupts. heißt Quers. (Querhaus). [Koepf /Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Schiff</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">loď</skos:prefLabel>
        <skos:prefLabel xml:lang="ca">nau</skos:prefLabel>
        <skos:prefLabel xml:lang="it">navata</skos:prefLabel>
        <skos:prefLabel xml:lang="en">nave</skos:prefLabel>
        <skos:prefLabel xml:lang="es">nave</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">nef</skos:prefLabel>
    </owl:NamedIndividual>
    


