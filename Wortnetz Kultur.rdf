		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004631"/>
		<skos:definition xml:lang="de">Ein Abakus ist ein Rechengerät, auf dem mit Hilfe von Rechensteinen oder Kugeln, die auf einer Führung innerhalb eines Rahmens bewegt werden, die vier Grundrechenarten sowie teilweise das Ziehen von Wurzeln ausgeführt werden, wobei der Wert der Rechensteine durch ihre Lage bestimmt wird.</skos:definition>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4000030-8"/>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300263522"/>
