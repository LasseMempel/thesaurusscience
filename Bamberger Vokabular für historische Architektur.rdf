        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-12T10:05:42.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T00:17:32.000</terms:modified>
        <skos:definition xml:lang="de">Findet sich besonders an Rathäusern und als Brückentorturm mittelalterlicher und Renaissance-Städte, oft als Waffenkammer benutzt. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Nachází se zvl. u radnic a jako mostní věž ve středověkých a renesančních městech, často sloužila jako zbrojnice. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Repräsentationsturm</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">reprezentační věž</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_da976061 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_da976061">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_eee71711"/>
