<http://www.eionet.europa.eu/gemet/concept/9278> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5194> ;
    skos:closeMatch <http://dbpedia.org/resource/Weather_forecasting> ;
    skos:definition "The act or process of predicting and highlighting meteorological conditions that are expected for a specific time period and for a specific area or portion of air space, by using objective models based on certain atmospheric parameters, along with the skill and experience of a meteorologist."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_8340> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Wettervorhersage"@de,
        "weather forecasting"@en .

<http://www.eionet.europa.eu/gemet/concept/9280> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/212> ;
    skos:closeMatch <http://data.uba.de/umt/_00025475>,
        <http://dbpedia.org/resource/Weed> ;
    skos:definition "Any plant that grows wild and profusely, especially one that grows among cultivated plants, depriving them of space, food, etc."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/5791> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Unkraut"@de,
        "weed"@en .

<http://www.eionet.europa.eu/gemet/concept/9286> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:closeMatch <http://dbpedia.org/resource/Weight> ;
    skos:definition "The gravitational force with which the earth attracts a body. By extension, the gravitational force with which a star, planet, or satellite attracts a nearby body."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_8349> ;
