	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk001951">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">Franciscans</skos:prefLabel>
		<skos:altLabel xml:lang="de">Franziskaner (Orden)</skos:altLabel>
		<skos:prefLabel xml:lang="de">Franziskanerorden</skos:prefLabel>
		<skos:altLabel xml:lang="de">Orden der Franziskaner</skos:altLabel>
		<skos:altLabel xml:lang="de">Orden der Minderen Brüder</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk001950"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010285"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019842"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk020384"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk001950"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk001952"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk001982"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk001983"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk002048"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk002049"/>
		<xe:explanation_temp xml:lang="de">Er orientiert sich an der von seinem Ordensgründer Franziskus von Assisi verfassten Ordensregel und gilt als Erster Orden der Franziskanischen Ordensgemeinschaften.</xe:explanation_temp>
		<skos:definition xml:lang="de">Der Franziskanerorden ist ein Bettelorden der römisch-katholischen Kirche, dem ausschließlich männliche Mitglieder angehören. </skos:definition>
