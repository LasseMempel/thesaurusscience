        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-27T12:06:00.000</terms:modified>
        <skos:altLabel xml:lang="cs">šikmá trhlina</skos:altLabel>
        <skos:definition xml:lang="de">Frontale Axonometrie, aus Grund- oder Aufriss entwickelte, schiefaxonometr. Darstellung eines Objekts bei beliebiger Blickrichtung. Der Kavalierriss entsteht durch Auftragen derTiefenmaße vor dem Aufriss, der Militärriss durch Auftragen der Höhenmaße über dem Grundriss. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Schrägriss</skos:prefLabel>
        <skos:prefLabel xml:lang="it">assonometria cavaliera frontale</skos:prefLabel>
        <skos:prefLabel xml:lang="en">oblique projection</skos:prefLabel>
        <skos:prefLabel xml:lang="es">proyección axonométrica oblicua</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">smyková trhlina</skos:prefLabel>
    </owl:NamedIndividual>
    


