    skos:related <http://www.eionet.europa.eu/gemet/concept/7831> .

<http://www.eionet.europa.eu/gemet/concept/7839> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1320> ;
    skos:closeMatch <http://dbpedia.org/resource/Softening> ;
    skos:definition "Reduction of the hardness of water by removing hardness-forming ions (chiefly calcium and magnesium) by precipitation or ion exchange, or sequestering them as by combining them with substances such as certain phosphates, that form soluble but non-ionized salts."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Enthärtung"@de,
        "softening"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/4485> .

<http://www.eionet.europa.eu/gemet/concept/784> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3388> ;
    skos:closeMatch <http://data.uba.de/umt/_00011355> ;
    skos:definition "Any one of various liquids for drinking, usually excluding water."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/5017> ;
