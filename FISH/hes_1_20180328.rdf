		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/40</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BOTHAN IASGAICH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach a chleachdas iasgairean mar àite-fuirich sealach.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">FISHING BOTHY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
