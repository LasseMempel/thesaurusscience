  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70851">
    <skos:scopeNote xml:lang="en">A building or structure of unknown function found on a farm. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/133534">
    <skos:scopeNote xml:lang="en">A channel which carried processed alum as liquid from the alum quarry/works to the alum house</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/132734">
    <skos:scopeNote xml:lang="en">A building within the gunpowder works complex. During the gunpowder production process, the mill cake was broken down, pressed and then corned. The remaining dust was removed from the corned powder by tumbling it in gauze-covered revolving cylinders.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92153">
    <skos:scopeNote xml:lang="en">A shop which sells vegetables and fruit.</skos:scopeNote>
  </rdf:Description>
