	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk007293">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">air pressure tank</skos:prefLabel>
		<skos:altLabel xml:lang="en">compressed air reservoir</skos:altLabel>
		<skos:prefLabel xml:lang="de">Druckluftbehälter</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000202"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk004498"/>
		<skos:definition xml:lang="de">Ein Druckluftbehälter ist ein Behälter, der der Speicherung von komprimierter Luft dient.</skos:definition>
