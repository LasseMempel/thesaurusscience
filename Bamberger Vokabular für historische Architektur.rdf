        <skos:altLabel xml:lang="de">Kugelstabkreuz</skos:altLabel>
        <skos:definition xml:lang="de">Apfelkreuz n; auch Kugelstabkreuz n; Kolbenkreuz n: ein Kreuz, dessen Arme kugelförmig enden. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Apfelkreuz</skos:prefLabel>
