        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-28T09:18:07.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T12:19:57.000</terms:modified>
        <skos:altLabel xml:lang="cs">palisádová stěna</skos:altLabel>
        <skos:definition xml:lang="de"> Befestigung aus nebeneinander  eingeschlagenen Pfählen (Schanzpfahlreihe), die  oben zugespitzt sind. Schon bei röm. Standlagern, Fliehburgen, Motten usw. verwandt und dann bei ma. Burgen und Stadtbefestigungen längs der Böschungsoberkante der Umwallung angebracht. [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">(frz. palissade ›Pfahlwerk‹) Einfachste, hölzerne Form der Brustwehr, schon in der Vorgeschichte gebräuchlich. Gelegentlich zu ebener Erde, meist aber auf einem Wall, wurden senkrechte (Rund-)Hölzer lückenlos nebeneinandergesetzt. Eine größere Schutzfunktion wurde durch die Kombination mit einem vorgelagerten Graben erreicht. Im Mittelalter konnten hölzerne P.n durchaus auch Zinnen aufweisen. Im Hochmittelalter wurden ältere P.n-Konstruktionen zuweilen durch steinerne Mauern ersetzt. R. F. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:definition xml:lang="cs">Lat.-franc., obranná hradba z kůlů. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Schutzwand aus Pfählen. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Palisade</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">palisáda</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_952784aa -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_952784aa">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f651ce64"/>
