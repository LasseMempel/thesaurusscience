        <skos:prefLabel xml:lang="es">moldura del zócalo</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">soklová římsa</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Als Sockelgesims bezeichnet man das obere Abschlussprofil am Sockel. [Koch 2009]</skos:scopeNote>
        <skos:scopeNote xml:lang="cs">Horní závěrový profil na soklu. [Koch 2008]</skos:scopeNote>
    </owl:NamedIndividual>
    


