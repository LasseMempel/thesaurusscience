	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk015439">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Orthopädie</skos:prefLabel>
		<skos:prefLabel xml:lang="en-UK">orthopaedics</skos:prefLabel>
		<skos:prefLabel xml:lang="en-US">orthopedics</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk007109"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013608"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk007109"/>
		<skos:definition xml:lang="de">Orthopädie ist eine Teildisziplin der Medizin, die sich mit der Prävention, Diagnose und Behandlung von Erkrankungen, Verletzungen und Fehlbildungen des Stütz- und Bewegungsapparates befasst. Dies umfasst beispielsweise Knochen, Gelenke, Muskeln, Sehnen, Bänder sowie die damit verbundenen Gefäße und Nerven.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4043924-0"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q216685"/>
		<skos:exactMatch rdf:resource="http://id.nlm.nih.gov/mesh/D009985"/>
