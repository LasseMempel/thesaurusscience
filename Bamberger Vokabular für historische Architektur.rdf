        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-25T10:39:05.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T23:49:18.000</terms:modified>
        <skos:definition xml:lang="de"> Mechan. Modell des Sonnensystems, vielfach Bestandteil astronom. Kunstuhren, seit dem späten 17. Jh. in bedeutender Größe geschaffen und auch in repräsentativen Gebäuden untergebracht, häufig in Verbindung mit einem Observatorium. Das P. enthält in der Regel neben dem Kuppelsaal als Hauptraum und Nebenanlagen einen Vortragssaal und Arbeitsräume. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="en"> planetarium</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Planetarium</skos:prefLabel>
        <skos:prefLabel xml:lang="es">planetario</skos:prefLabel>
        <skos:prefLabel xml:lang="it">planetario</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">planetarium</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">planétarium</skos:prefLabel>
    </owl:NamedIndividual>
    


