		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk020368"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk002319"/>
		<skos:definition xml:lang="de">Feldsteinmauerwerk ist ein Mauerwerk, das aus aufgelesenen und unbearbeiteten Steinen besteht.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002319"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010555"/>
