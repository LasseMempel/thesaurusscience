    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Walkway"@en ;
    skos:scopeNote "A pedestrian passageway, often elevated, connecting two buildings or sections within a building."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/139838> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/138311> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Grating"@en ;
    skos:scopeNote "A framework of crossed or parallel wooden or metal bars placed over an opening to prevent access but allow the passage of air, light, water etc."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/139844> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/137774> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Sign"@en ;
    skos:scopeNote "A panel, board or device bearing an inscription, symbol or image, usually describing a function, name, location, instruction, or otherwise distinguishing the object or structure on which it is placed."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/139854> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/138347> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Forebuilding"@en ;
    skos:scopeNote "A subsidiary tower or projection attached to the front of a keep containing access to its first floor entrance."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/140081> a skos:Concept ;
    skos:altLabel "Dean Hole"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/138182> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Priests Hole"@en ;
    skos:scopeNote "A concealed passage or room for the purpose of hiding and protecting a (Roman Catholic) priest during times of religious persecution."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/140089> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/137674>,
        <http://purl.org/heritagedata/schemes/eh_com/concepts/138311> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Overthrow"@en ;
    skos:scopeNote "A panel of often decorated wrought-ironwork forming the arch between two gate-piers or standards or above a gate. Also used for an arched support for a lamp-holder between two standards."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/140119> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/138311> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Fan Carriage"@en ;
    skos:scopeNote "A wheeled device supporting a windmill's fantail that moves around a trackway thus turning the windmill into the wind."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/140125> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/138311> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Striking Gear"@en ;
    skos:scopeNote "A mechanism within a windmill, attached to the striking rod, allowing the opening and closing of the shutters or vanes of patent sails."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/140135> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/138311> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Spider"@en ;
    skos:scopeNote "A four-armed metal coupling, positioned at the centre of a windmill's sails,  connected to the front of the striking rod and the shutter bars of all the sails, causing the shutters to open and close."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/140136> a skos:Concept ;
    skos:altLabel "Sail Back"@en,
        "Uplong"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/138311> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Whip"@en ;
    skos:scopeNote "The principal longitudinal member or spine of a windmill sail, extending from the stock and supporting the sailbars."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/140294> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/138182> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Boiler Room"@en ;
    skos:scopeNote "A room, usually at ground level or below, housing the tank in which water is heated as part of a building's heating system."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/140301> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/138182> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Changing Room"@en ;
    skos:scopeNote "A room within a building, such as a shop or leisure complex,sometimes equipped with cubicles or screens to allow a degree of privacy, where clothing can be tried on or changed."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/140306> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/137774>,
        <http://purl.org/heritagedata/schemes/eh_com/concepts/138311> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Grille"@en ;
    skos:scopeNote "An open grating of wrought iron, bronze, wood etc., forming a screen to a door, window or other opening, or used as a divider."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/140326> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/137489> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Easter Sepulchre"@en ;
    skos:scopeNote "A recess, usually situated in the north wall of a chancel,  often canopied, containing a decorated tomb chest representing the burial and resurrection of Christ."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/140333> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/138143> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Long And Short Work"@en ;
    skos:scopeNote "A Saxon quoin consisting of alternating horizontally and vertically laid stones."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/140342> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/138311> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Salt Pan"@en ;
    skos:scopeNote "A large shallow pan, usually metal, in which seawater or brine is evaporated for the extraction of salt. The name is also often applied to the exterior pits or ponds used for the same purpose (see Thesaurus of Monument Types)."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/140343> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/137971> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Brine Tank"@en ;
    skos:scopeNote "A tank within a salt works used for storing brine after is has been pumped from underground. The brine is then fed by gravity into the evaporating pans in the Pan House."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/140354> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/137774> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Climbing Wall"@en ;
    skos:scopeNote "An artifically constructed wall with recessed and projecting grips for hands and feet and places to attach ropes. Used for practising rock climbing. If the wall is a free-standing external structure use term for the Thesaurus of Monument Types."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/140399> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/137971> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Angle Bob"@en ;
    skos:scopeNote "A mechanical component or device that can change the direction of motion of a pump rod from the vertical to the horizontal plane and vice versa."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/140400> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/137971> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Balance Bob"@en ;
    skos:scopeNote "A counter balance designed to support the excess weight of a mineshaft's wooden beams."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/140401> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/137971> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Cheese Press"@en ;
    skos:scopeNote "A device used in the production of hard cheeses that exerts pressure upon fresh curds in order to remove and drain away excess whey."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/140403> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/138311> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Striking Rod"@en ;
    skos:scopeNote "An iron bar or rod running through the core of a windmill's windshaft that causes the opening and shutting of the vanes on patent sails."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/140406> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/137774> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Boot Scraper"@en ;
    skos:scopeNote "A device, usually cast iron and often decorative in design, placed upon, embedded in or built into a doostep facilitating the removal of mud, dirt, manure etc. from footwear before entering a building."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/140407> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/138311> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Foundation Stone"@en ;
    skos:scopeNote "A stone, usually inscribed, laid during a ceremony to commemorate the founding of a new building"@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/140430> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/137351>,
        <http://purl.org/heritagedata/schemes/eh_com/concepts/137489> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Nest Hole"@en ;
    skos:scopeNote "Niche intended for pigeons or other birds to nest in, allowing the squabs and eggs to be harvested. Found inside specially built dovecotes and in the walls of other buildings."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/140433> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/137489>,
        <http://purl.org/heritagedata/schemes/eh_com/concepts/137888> ;
