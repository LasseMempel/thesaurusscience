	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk020617">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">death certificate</skos:prefLabel>
		<skos:altLabel xml:lang="en">death certificates</skos:altLabel>
		<skos:prefLabel xml:lang="de">Sterbeurkunde</skos:prefLabel>
		<skos:altLabel xml:lang="de">Sterbeurkunden</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk005696"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk005696"/>
		<skos:definition xml:lang="de">Eine Sterbeurkunde ist eine Urkunde, die den Tod einer Person bescheinigt und in Deutschland vom Standesamt ausgestellt wird. Sie enthält Informationen wie den Vornamen und Familiennamen des Verstorbenen, Ort und Datum seiner Geburt, Wohnsitz und den Familienstand. Darüber hinaus ist auch der Sterbeort und der Zeitpunkt des Todes verzeichnet. Die Sterbeurkunde wird normalerweise benötigt, um verschiedene rechtliche und administrative Angelegenheiten zu regeln, wie zum Beispiel Erbschaftsangelegenheiten, Versicherungsansprüche oder die Beendigung von Verträgen.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk005696"/>
