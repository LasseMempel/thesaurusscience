	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021261">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="mul">Radiolaria</skos:prefLabel>
		<skos:prefLabel xml:lang="en">radiolarian</skos:prefLabel>
		<skos:altLabel xml:lang="en">radiolarians</skos:altLabel>
		<skos:prefLabel xml:lang="de">Radiolarie</skos:prefLabel>
		<skos:altLabel xml:lang="de">Radiolarien</skos:altLabel>
		<skos:altLabel xml:lang="mul">Radiolarium</skos:altLabel>
		<skos:altLabel xml:lang="de">Strahlentierchen</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk001769"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk001769"/>
		<skos:definition xml:lang="de">Strahlentierchen (Radiolarien) sind einzellige, im Meer lebende Mikroorganismen aus der Gruppe der Rhizaria. Sie besitzen meist kunstvoll gestaltete Skelette aus Siliziumdioxid. Als Eukaryoten zeichnen sie sich durch strahlenförmige Fortsätze aus, die ihnen ihren Namen geben. Nach ihrem Tod tragen ihre Skelettreste zur Bildung kieselhaltiger Meeressedimente bei.</skos:definition>
		<xe:explanation_temp xml:lang="de">Versteinert liefern diese Sedimente für die Paläontologie wichtige Hinweise zum Ablagerungsmilieu und Alter des Gesteins.</xe:explanation_temp>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4183516-5"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q107920"/>
