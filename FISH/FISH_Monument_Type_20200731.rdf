  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91107">
    <skos:scopeNote xml:lang="en">A terrace consisting of a double row of houses sharing a common back wall, characteristic of industrial cities in the North of England.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/90997">
