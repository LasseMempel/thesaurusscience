        <skos:altLabel xml:lang="de">Weihestufe</skos:altLabel>
        <skos:altLabel xml:lang="en">degrees of ordination</skos:altLabel>
        <skos:altLabel xml:lang="fr">degrés d\&apos;ordination</skos:altLabel>
        <skos:definition xml:lang="de">Weihegrade m pl; Weihestufen f pl; lat. ordines: durch die Ordination vollzogene hierarchische Ordnung aller Kleriker der kath. Kirche bis hinauf zum Papst als dem Patriarchen des Abendlandes und souveränen Pontifex der Weltkirche. Man unterscheidet niedere und höhere Weihen. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Weihegrad</skos:prefLabel>
        <skos:prefLabel xml:lang="en">order</skos:prefLabel>
        <skos:prefLabel xml:lang="la">ordines</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">ordres </skos:prefLabel>
    </owl:NamedIndividual>
    


