    <!-- https://hist-arch-vocab.org/bvha#c_49b69f36 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_49b69f36">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_8npondzn"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_19d56a39"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_bdbb2d13"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_c6454e1f"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-14T09:44:37.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T14:15:51.000</terms:modified>
        <skos:definition xml:lang="de">Zählzeichen bestehen aus einzelnen oder mehreren an einem Bauteil aufgebrachten Abbundmarken und bilden somit einen bestimmten Zahlenwert. Die vergleichsweise unübersichtliche Darstellung bei einer additiven Reihung der Marken konnte durch eine Gruppierung in Reihen oder Blöcken verbessert werden. Durch die Einführung einer römischen Fünf (V) oder Zehn (X) als Aggregationsform bzw. Hierarchisierungszeichen ist die Lesbarkeit von hohen Zahlenwerten deutlich erleichtert worden. Je mehr Bauteile in einer Abbundeinheit zusammengefasst werden mussten, desto aufwendiger wurden die Abbundzeichensysteme. [Eißing et al. 2012]</skos:definition>
        <skos:prefLabel xml:lang="de">Zählzeichen</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_49bc73f3 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_49bc73f3">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_2c0cce41"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_614533a8"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-04T11:41:30.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T13:56:22.000</terms:modified>
        <skos:definition xml:lang="de">Eine dem Bauwerk vorgelagerte Wendeltreppe mit durchbrochenem Gehäuse, in der Renaissance teilweise mit loggiaähnl. Formen. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Wendelstein</skos:prefLabel>
        <skos:prefLabel xml:lang="es">escalera caracol con caja calada</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">escalier en vis à cage ajourée</skos:prefLabel>
        <skos:prefLabel xml:lang="en">spiral stair tower</skos:prefLabel>
        <skos:prefLabel xml:lang="it">torretta con scala a chiocciola</skos:prefLabel>
    </owl:NamedIndividual>
    


