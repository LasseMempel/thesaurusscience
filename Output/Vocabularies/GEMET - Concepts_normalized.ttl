    skos:closeMatch <http://data.uba.de/umt/_00003854> ;
    skos:definition "An area where trees, shrubs, or plants are grown for transplanting, for use as stocks for budding and grafting."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Baumschule"@de,
