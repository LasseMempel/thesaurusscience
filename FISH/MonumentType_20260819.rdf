    <skos:prefLabel xml:lang="en">APPRENTICE HOUSE</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A lodging house for apprentices learning a trade or profession. This accommodation was often provided in lieu of wages.</skos:scopeNote>
