        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-23T16:14:29.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T18:23:17.000</terms:modified>
        <skos:prefLabel xml:lang="de">Plattenmaßwerk</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">dalle ajourée</skos:prefLabel>
        <skos:prefLabel xml:lang="en">plate tracery</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Durch Durchbrechung von Steinplatten erzeugtes Maßwerk. [BVHA]</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Zwei spitzbogige Lanzettfenster mit Okulus darüber öffnen ähnlich wie beim Lochscheibenfenster eine unter einem Überfangbogen zurückgestufte, glatte Mauerfläche (Chartres), in die außen flächig das Glas eingesetzt ist. [Koepf/Binding 2016]</skos:scopeNote>
    </owl:NamedIndividual>
    


