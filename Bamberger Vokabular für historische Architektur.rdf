    <!-- https://hist-arch-vocab.org/bvha#c_7303a46f -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_7303a46f">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
