		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/9" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/16" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/17" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/20">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/20</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">SABHAL NAN DEICHEAMH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Sabhal mòr far an robhar a' cumail an deicheimh (deicheamh de thoradh àiteachais na bliadhna is msaa.) a bha an luchd-màil a’ pàigheadh air talamh na h-eaglais.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">TITHE BARN</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-09-01T11:17:27</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/14" />
				<skos:scopeNote xml:lang="en">A large barn used to store the tithe (a tenth part of the annual produce of agriculture etc.) which was paid by the tenants of ecclesiastical lands.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/19" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500859">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500859</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">SABHAL-FEÒIR</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Nàdar sònraichte de shabhal aig nach eil ùrlar-bualaidh, mar is trice le ballachan fosgailte agus airson stòradh feòir thioraim a-mhàin.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">HAY BARN</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-11-20T14:52:51</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-11-20T14:53:18</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/14" />
				<skos:scopeNote xml:lang="en">A special type of barn, lacking a threshing floor, usually with open walls, intended for the storage of hay only.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
