        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-12T14:10:22.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T14:43:38.000</terms:modified>
        <skos:altLabel xml:lang="cs">klášterní cela</skos:altLabel>
        <skos:altLabel xml:lang="cs">kobka</skos:altLabel>
        <skos:prefLabel xml:lang="de">Klause</skos:prefLabel>
