	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk005969">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">cultural landscape</skos:prefLabel>
		<skos:altLabel xml:lang="en">cultural landscapes</skos:altLabel>
		<skos:prefLabel xml:lang="de">Kulturlandschaft</skos:prefLabel>
		<skos:altLabel xml:lang="de">Kulturlandschaften</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000824"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk004432"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000824"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk002705"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk001995"/>
		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk005960"/>
		<skos:definition xml:lang="de">Eine Kulturlandschaft ist eine Landschaft, die durch eine dauerhafte Nutzung oder Bewirtschaftung durch den Menschen beeinflusst wird. Das Erscheinungsbild einer Kulturlandschaft hängt von verschieden Faktoren ab, wie beispielsweise der Art und Intensität der menschlichen Nutzung, der geografischen Lage, dem Klima und der Typographie.</skos:definition>
		<xe:explanation_temp xml:lang="de">Einige Kulturlandschaften können sehr intensiv genutzt und urbanisiert sein, während andere eher ländlich und von traditionellen Landnutzungspraktiken geprägt sind. Insgesamt spiegelt das Erscheinungsbild von Kulturlandschaften die komplexen Wechselwirkungen zwischen Mensch und Natur wider und ist oft das Ergebnis einer langen und kontinuierlichen Entwicklung.</xe:explanation_temp>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300008932"/>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4033573-2"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1129474"/>
