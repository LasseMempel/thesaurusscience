        <skos:altLabel xml:lang="cs">sloupová hala</skos:altLabel>
        <skos:definition xml:lang="de">Eine Säulenhalle (Lesche), meist am Rand der Agora. Eine Säulenhalle mit geschlossener Rückwand vor einem anderen Gebäude wird auch Portikus genannt. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Griechisch-hellenistische Säulenhalle, 1- bis 2-geschossig, mit geschlossener Rückwand. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Řecká a helénistická sloupová síň, jednopodlažní až dvojpodlažní, s uzavřenou zadní stěnou. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Stoa</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">stoa</skos:prefLabel>
    </owl:NamedIndividual>
    


