    skos:prefLabel "Pfeifenbäckerei"@de,
        "clay pipe manufacture"@en ;
    skos:relatedMatch <http://d-nb.info/gnd/4331450-8> .

<http://lvr.vocnet.org/wnk/wk004176> a skos:Concept ;
    skos:altLabel "Pechhütten"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk003560> ;
    skos:definition "Eine Pechhütte ist ein Betrieb, in dem das Pech gesiedet wird."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Pechhütte"@de ;
    skos:scopeNote "Benutzt für den Betrieb und das Gebäude."@de .

<http://lvr.vocnet.org/wnk/wk004179> a skos:Concept ;
    skos:altLabel "Straßendämme"@de,
        "road embankments"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk001792> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Straßendamm"@de,
        "road embankment"@en .

<http://lvr.vocnet.org/wnk/wk004186> a skos:Concept ;
    skos:altLabel "Uferbau"@de,
        "Uferbefestigungen (Bauwerke)"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000133> ;
    skos:definition "Eine Uferbefestigung ist ein Bauwerk, das als Maßnahme gegen die Beschädigung oder Zerstörung des Gewässerufers errichtet wird."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Uferbefestigung (Bauwerk)"@de .

<http://lvr.vocnet.org/wnk/wk004188> a skos:Concept ;
    skos:altLabel "Faschinen"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000543> ;
    skos:definition "Eine Faschine ist ein Materialverbund aus Reisig und Drähten, der der Sicherung von Böschungen dient."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4555671-4> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Faschine"@de,
        "fascine"@en .

<http://lvr.vocnet.org/wnk/wk004189> a skos:Concept ;
    skos:broader <http://lvr.vocnet.org/wnk/wk004307> ;
    skos:definition "Ein Legionslager ist ein großes römisches Militärlager, das als permanenter Standort einer ganzen Legion errichtet wurde, die etwa 5000 bis 6000 Mann umfasst. Es zeichnet sich durch eine umfangreiche, standardisierte Infrastruktur mit Principia (Stabsgebäude), Wohnquartieren, Werkstätten, Trainingsplätzen sowie starken Befestigungen (Wall, Graben, Mauern) und repräsentativen Torbauten aus. Typisch sind auch Verwaltungsgebäude, Versorgungseinrichtungen und teils thermale Anlagen. Legionslager fungierten als zentrale militärische und administrative Knotenpunkte im römischen Heer und waren oft strategisch an wichtigen Verkehrsknoten oder Grenzabschnitten gelegen."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Legionslager"@de,
        "legionary fortress"@en .

<http://lvr.vocnet.org/wnk/wk004190> a skos:Concept ;
    skos:altLabel "Gartenperistyl"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk001540> ;
    skos:definition "Der Peristylgarten ist ein Gartenhof, der von einem Säulengang (Peristyl) umgeben und Bestandteil eines römischen Atriumhauses ist. "@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Peristylgarten"@de,
        "peristyle garden"@en .

<http://lvr.vocnet.org/wnk/wk004191> a skos:Concept ;
    skos:broader <http://lvr.vocnet.org/wnk/wk004192>,
        <http://lvr.vocnet.org/wnk/wk021208> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Principia (Bauwerk)"@de,
        "principia (building)"@en .

<http://lvr.vocnet.org/wnk/wk004193> a skos:Concept ;
    skos:altLabel "Atrien (Kirchengebäude)"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk006912> ;
    skos:definition "Ein Atrium ist der Gebäudeteil einer Kirche, der als säulenumstandener Vorhof dient."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Atrium (Kirchengebäude)"@de,
        "atrium (church building)"@en ;
    skos:scopeNote "Benutzt für den Vorhof von Kirchen bis in karolingische Zeit; für spätere Kirchen siehe Paradies (Gebäudeteil) (wk001846)."@de .

<http://lvr.vocnet.org/wnk/wk004194> a skos:Concept ;
    skos:broader <http://lvr.vocnet.org/wnk/wk006912> ;
    skos:definition "Ein Narthex ist ein Gebäudeteil, der als quergelagerte Vorhalle vor dem eigentlichen Kirchenraum liegt."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Narthex"@de,
        "narthex"@en ;
    skos:scopeNote "Benutzt für byzantinische und altchristliche Kirchen bis in karolingische Zeit; für mittelalterliche Kirchen siehe Paradies."@de .

<http://lvr.vocnet.org/wnk/wk004198> a skos:Concept ;
    skos:altLabel "Halbbastionen"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000312> ;
    skos:definition "Eine Halbbastion ist der Bestandteil einer Festung, der die Form einer halbierten Bastion hat und lediglich aus einer Face und einer Flanke besteht, während die der Flanke gegenüberliegende Seite in die seitliche Kurtine des jeweiligen Festungswerks übergeht."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Halbbastion"@de,
        "demi-bastion"@en .

<http://lvr.vocnet.org/wnk/wk004199> a skos:Concept ;
    skos:altLabel "Batterien (Festungen)"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000312> ;
    skos:definition "Eine Batterie ist der Bestandteil einer Festung, der der wirksamen und sicheren Aufstellung von Geschützen dient."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Batterie (Festung)"@de,
        "battery (fort)"@en .

<http://lvr.vocnet.org/wnk/wk004201> a skos:Concept ;
    skos:altLabel "Künetten"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000312> ;
    skos:definition "Eine Künette ist der Bestandteil einer Festung, der als auf der Sohle eines großen, trockenen Grabens gelegener Abflussgraben zu dessen Entwässerung dient und zugleich ein eigenes Annäherungshindernis darstellt."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Künette"@de,
        "trench (constr.)"@en .

<http://lvr.vocnet.org/wnk/wk004202> a skos:Concept ;
    skos:altLabel "Chorflankentürme"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk001253> ;
    skos:definition "Ein Chorflankenturm ist ein Kirchturm, der seitlich der Apsis oder des Chors am Übergang zum Chorjoch steht und paarweise auftritt."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Chorflankenturm"@de .

<http://lvr.vocnet.org/wnk/wk004203> a skos:Concept ;
    skos:altLabel "Chorwinkeltürme"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk001253> ;
    skos:definition "Ein Chorwinkelturm ist ein Kirchturm, der im Winkel von Chorjoch und Querhausarm steht und häufig paarweise auftritt."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Chorwinkelturm"@de,
        "choir angle tower"@en .

<http://lvr.vocnet.org/wnk/wk004204> a skos:Concept ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000313> ;
    skos:definition "Eine Verschanzung ist eine Befestigungsanlage, die aus aufgeschütteten Wällen besteht und Wallrechtecke zur Feindseite hin aufweist."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Verschanzung (Bauwerk)"@de,
        "entrenchment"@en .

<http://lvr.vocnet.org/wnk/wk004205> a skos:Concept ;
    skos:altLabel "Etoile"@de,
        "Sternschanzen"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002887> ;
    skos:definition "Eine Sternschanze ist eine Schanze, deren geschlossenes Außenwerk auf einer sternförmigen Grundfläche ruht."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Sternschanze"@de,
        "star fort"@en .

<http://lvr.vocnet.org/wnk/wk004209> a skos:Concept ;
    skos:altLabel "Fossilienlagerstätte"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002425> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Fossillagerstätte"@de,
        "fossil deposit"@en .

<http://lvr.vocnet.org/wnk/wk004213> a skos:Concept ;
    skos:altLabel "Einzelfundament"@de,
        "Punktfundamente"@de,
        "point foundation"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000673> ;
    skos:exactMatch <http://d-nb.info/gnd/4397963-4> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Punktfundament"@de,
        "isolated footing"@en .

<http://lvr.vocnet.org/wnk/wk004215> a skos:Concept ;
    skos:altLabel "Kalklöschgruben"@de,
        "lime pit"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000478> ;
    skos:closeMatch <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140186> ;
    skos:definition "Eine Kalklöschgrube ist eine Grube, in der Kalk gelöscht wird, d.h., in der Calciumoxid mit Wasser versetzt wird."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Kalklöschgrube"@de,
        "lime slaking pit"@en .

<http://lvr.vocnet.org/wnk/wk004217> a skos:Concept ;
    skos:altLabel "Kohortenkastelle"@de,
        "Kohortenlager"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk004216> ;
    skos:definition "Ein Kohortenkastell ist ein römisches Auxiliarlager, in dem eine Kohorte, also eine infanteristische Hilfstruppe, stationiert ist. Es ist in Größe und Funktion auf die Bedürfnisse der Infanterieeinheit zugeschnitten."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Kohortenkastell"@de,
        "cohort fort"@en .

<http://lvr.vocnet.org/wnk/wk004218> a skos:Concept ;
    skos:altLabel "Alenkastelle"@de,
        "Alenlager"@de,
        "Ala fort"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk004216> ;
    skos:definition "Ein Alenkastell ist ein römisches Auxiliarlager, das speziell für die Stationierung einer berittenen Einheit (Ala quingenaria oder Ala milliaria) eingerichtet wurde. Es ist in Größe und Grundriss auf die Bedürfnisse der Kavallerie ausgerichtet, etwa mit größeren Stallungen für Pferde und erweiterten Flächen als Reitplatz oder Übungsflächen."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Alenkastell"@de,
        "Roman cavalry fort"@en .

<http://lvr.vocnet.org/wnk/wk004219> a skos:Concept ;
    skos:altLabel "Numeruskastelle"@de,
        "Numeruslager"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk004216> ;
    skos:definition "Ein Numeruskastell ist ein römisches Auxiliarlager, in dem eine Numerus-Einheit, eine meist kleinere und weniger standardisierte Hilfstruppe, stationiert ist. Es ist in der Regel kleiner als andere Auxiliarlager und die Bebauung kann stärker vom Standard abweichen. Dies zeigt sich oft in einer einfacheren oder weniger normierten Infrastruktur, die der meist geringeren Truppengröße und den speziellen Aufgaben der Numeri angepasst ist."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Numeruskastell"@de,
        "numerus fort"@en .

<http://lvr.vocnet.org/wnk/wk004220> a skos:Concept ;
    skos:altLabel "Flottenkastell"@de,
        "Flottenkastelle"@de,
        "fleet station"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk004307> ;
    skos:definition "Ein Flottenlager ist ein römisches Militärlager für die Marine, das als Basis für den Einsatz, die Versorgung, die Reparatur und die Koordination von Flotteneinheiten diente. Flottenlager befanden sich an Flüssen, Seen oder Küstenregionen."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Flottenlager"@de,
        "naval fort"@en .

<http://lvr.vocnet.org/wnk/wk004224> a skos:Concept ;
    skos:altLabel "Prätorium"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000700>,
        <http://lvr.vocnet.org/wnk/wk021208> ;
    skos:definition "Das Praetorium ist ein Gebäude, das in einem römischen Militärlager liegt und in dem der Kommandeur residiert."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Praetorium"@de,
        "praetorium"@en .

<http://lvr.vocnet.org/wnk/wk004227> a skos:Concept ;
    skos:altLabel "Spitzgräben"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002765> ;
    skos:definition "Ein Spitzgraben ist ein Befestigungsgraben, der keine Sohle besitzt, sondern dessen Grabenwände stattdessen in spitzem Winkel aufeinandertreffen."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Spitzgraben"@de,
        "v-shaped ditch"@en .

<http://lvr.vocnet.org/wnk/wk004228> a skos:Concept ;
    skos:altLabel "Palisadengräben"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002765> ;
    skos:definition "Ein Palisadengraben ist ein Befestigungsgraben, der für die Aufnahme einer Palisade angelegt wird."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Palisadengraben"@de,
        "palisade trench"@en .

<http://lvr.vocnet.org/wnk/wk004231> a skos:Concept ;
    skos:altLabel "Vororte (Siedlung)"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000122>,
        <http://lvr.vocnet.org/wnk/wk001980> ;
    skos:definition "Ein Vorort ist ein Siedlungsteil, der am Rande einer größeren Stadt liegt, eine eigene Infrastruktur aufweist, ursprünglich meist dörflichen Charakter hat und auch eine selbständige Siedlung sein kann."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Vorort (Siedlung)"@de,
        "suburb"@en .

<http://lvr.vocnet.org/wnk/wk004233> a skos:Concept ;
    skos:altLabel "Steinkonzentrationen"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk007148> ;
    skos:definition "Eine Steinkonzentration ist ein allgemeiner Begriff der Archäologie, der eine Konzentration von Bruchsteinen bezeichnet."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Steinkonzentration"@de,
        "concentration of stone material"@en .

<http://lvr.vocnet.org/wnk/wk004234> a skos:Concept ;
    skos:altLabel "Oberflächenfunde"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk009593> ;
    skos:exactMatch <http://www.wikidata.org/entity/Q3538273> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Oberflächenfund"@de,
        "surface find"@en .

<http://lvr.vocnet.org/wnk/wk004237> a skos:Concept ;
    skos:altLabel "Trockenrinnen"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk004346> ;
    skos:definition "Eine Trockenrinne ist in der Geologie ein Geländeeinschnitt, der nur zeitweise bei hohem Niederschlagsaufkommen Wasser führt."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Trockenrinne"@de,
        "dry ditch"@en .

<http://lvr.vocnet.org/wnk/wk004238> a skos:Concept ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000460>,
        <http://lvr.vocnet.org/wnk/wk021208> ;
    skos:definition "Die Via principalis ist eine Straße, die in einem römischen Militärlager liegt und die, parallel zur Front der Principia verlaufend, die Verbindung der beiden seitlichen Lagertore (Portae Principales) herstellt."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Via principalis"@de,
        "via principalis"@en .

<http://lvr.vocnet.org/wnk/wk004239> a skos:Concept ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000460>,
        <http://lvr.vocnet.org/wnk/wk021208> ;
    skos:definition "Die Via quintana ist eine Straße, die in einem römischen Militärlager liegt und im rückwärtigen Teil des Lagers parallel zur rückwärtigen Front der Principia verläuft."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Via quintana"@de,
        "via quintana"@en .

<http://lvr.vocnet.org/wnk/wk004240> a skos:Concept ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000460>,
        <http://lvr.vocnet.org/wnk/wk021208> ;
    skos:definition "Die Via sagularis ist eine Straße, die in einem römischen Militärlager liegt und im Raum zwischen äußerem Befestigungsring und angrenzender Innenbebauung (Intervallum) rund um alle Baulichkeiten des Lagers führt."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Via sagularis"@de,
        "via sagularis"@en .

<http://lvr.vocnet.org/wnk/wk004243> a skos:Concept ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000989>,
        <http://lvr.vocnet.org/wnk/wk021208> ;
    skos:definition "Die Porta Principalis Sinistra ist das Tor eines römischen Lagers, das in der linken Breitseite des Lagers liegt."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Porta principalis sinistra"@de,
        "porta principalis sinistra"@en .

<http://lvr.vocnet.org/wnk/wk004244> a skos:Concept ;
    skos:altLabel "porta principalis dextra"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000989>,
        <http://lvr.vocnet.org/wnk/wk021208> ;
    skos:definition "Die Porta principalis dextra ist ein Tor, das in der rechten Breitseite eines römischen Militärlagers liegt."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Porta principalis dextra"@de,
        "porta principalis dextra"@en .

<http://lvr.vocnet.org/wnk/wk004245> a skos:Concept ;
    skos:altLabel "valetudinarium"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000945>,
        <http://lvr.vocnet.org/wnk/wk021208> ;
    skos:definition "Ein Valetudinarium ist ein Lazarett, das Bestandteil eines römischen Lagers ist, bei dem sich in der Regel eine oder zwei Reihen von Krankenzimmern, die durch Gänge verbunden sind, um einen Innenhof gruppieren und in dem sich separate Behandlungsräume, Verwaltungsräume oder Lager befinden können."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Valetudinarium"@de,
        "valetudinarium"@en .

<http://lvr.vocnet.org/wnk/wk004246> a skos:Concept ;
    skos:altLabel "Beneficiarierstation"@de,
        "Beneficiarierstationen"@de,
        "Benefiziarierstationen"@de,
        "Straßengendarmerieposten"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk007137> ;
    skos:definition "Eine Benefiziarierstation ist eine militärische Anlage, in der Benefiziarier, aus ihren Stammeinheiten abkommandierte Unteroffiziere, an den Fernstraßen des Römischen Reiches Polizeifunktionen wahrnehmen."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Benefiziarierstation"@de,
        "beneficiarius station"@en .

<http://lvr.vocnet.org/wnk/wk004247> a skos:Concept ;
    skos:broader <http://lvr.vocnet.org/wnk/wk003521> ;
    skos:definition "Ein Übungslager ist ein Militärlager, das nur für Übungszwecke und Trainingsmaßnahmen errichtet wurde. Es weist zumindest eine äußere Befestigung auf. Das Vorhandensein einer Innenbebauung ist nicht zwingend, sondern abhängig vom Zweck der jeweiligen Übung."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Übungslager (Militär)"@de,
        "training camp"@en .

<http://lvr.vocnet.org/wnk/wk004250> a skos:Concept ;
    skos:altLabel "Oppida (Siedlungen)"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000122> ;
    skos:definition "Ein Oppidum ist eine befestigte Siedlung aus keltischer Zeit und wurde zumeist in erhöhter oder schwer zugänglicher Lage angelegt."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4172643-1>,
        <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68744>,
        <http://vocab.getty.edu/aat/300008396> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Oppidum (Siedlung)"@de,
        "oppidum"@en .

<http://lvr.vocnet.org/wnk/wk004251> a skos:Concept ;
    skos:altLabel "Querhauswinkeltürme"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk001253> ;
    skos:definition "Ein Querhauswinkelturm ist ein Kirchturm, der im Winkel zwischen Langhaus und Querhaus, in der Regel über dem östlichsten Joch eines Seitenschiffs, steht."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Querhauswinkelturm"@de,
        "armpit tower"@en .

<http://lvr.vocnet.org/wnk/wk004252> a skos:Concept ;
    skos:altLabel "Steinzeugöfen"@de,
        "stone ware kiln"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk004027> ;
    skos:definition "Ein Steinzeugofen ist ein Töpferofen, in dem zumeist Steinzeug gebrannt wird."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Steinzeugofen"@de .

<http://lvr.vocnet.org/wnk/wk004253> a skos:Concept ;
    skos:broader <http://lvr.vocnet.org/wnk/wk003601> ;
    skos:definition "Ein Stehender Ofen ist ein Brennofen, bei dem Feuerung und Brennraum übereinander angeordnet sind und durch eine horizontale Lochtenne oder Schlitztenne getrennt werden, sodass das Brenngut von unten mit Heizluft bestrichen wird."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Stehender Ofen"@de,
        "updraught kiln"@en .

<http://lvr.vocnet.org/wnk/wk004254> a skos:Concept ;
