	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1950">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1950</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CLACH-SOCAID</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Clach sa bheil socaid ach gun fhios cò air a shon a bha e. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SOCKETED STONE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1897" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1659" />
		<skos:scopeNote xml:lang="en">A stone which has a socket for an unknown function. Use specific term where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
