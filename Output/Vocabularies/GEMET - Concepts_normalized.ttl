@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://www.eionet.europa.eu/gemet/concept/10008> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5305> ;
    skos:closeMatch <http://dbpedia.org/resource/Consumer_product> ;
    skos:definition "Economic good that directly satisfies human wants or desires."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Konsumprodukt"@de,
        "consumer product"@en .

<http://www.eionet.europa.eu/gemet/concept/1001> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8590> ;
    skos:closeMatch <http://data.uba.de/umt/_00028759>,
        <http://dbpedia.org/resource/Bridge> ;
    skos:definition "A structure that spans and provides a passage over a road, railway, river, or some other obstacle."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/8452> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Brücke"@de,
        "bridge"@en .

<http://www.eionet.europa.eu/gemet/concept/10018> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/406> ;
    skos:closeMatch <http://dbpedia.org/resource/Human_body> ;
    skos:definition "The entire physical structure of an human being."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Menschlicher Körper"@de,
        "human body"@en .

<http://www.eionet.europa.eu/gemet/concept/10024> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/23> ;
    skos:closeMatch <http://dbpedia.org/resource/Information_transfer> ;
    skos:definition "The communication or conveyance of data or materials for the purpose of enhancing knowledge from one person, place or position to another."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_49825>,
        <http://eurovoc.europa.eu/616> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Informationstransfer"@de,
        "information transfer"@en .

<http://www.eionet.europa.eu/gemet/concept/10031> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11148> ;
    skos:definition "Study of meteorological elements such as wind speed and direction, air temperature and humidity, atmospheric pressure, precipitation, evaporation, solar radiation, visibility and cloud cover in order to collect data for weather forecast or for specific research purposes."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Meteorologische Forschung"@de,
        "meteorological research"@en .

<http://www.eionet.europa.eu/gemet/concept/10039> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1348> ;
    skos:closeMatch <http://data.uba.de/umt/_00019360>,
        <http://dbpedia.org/resource/Physical_chemistry> ;
    skos:definition "A science dealing with the effects of physical phenomena on chemical properties."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Physikalische Chemie"@de,
        "physical chemistry"@en .

<http://www.eionet.europa.eu/gemet/concept/10040> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5119>,
        <http://www.eionet.europa.eu/gemet/concept/6467> ;
    skos:closeMatch <http://data.uba.de/umt/_00050907> ;
    skos:definition "The quantitative determination of the presence, extent or type of pollutant substances in the environment using mechanical means, including optical, electrical, acoustical and thermodynamic techniques."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Physikalische Messung von Verunreinigungen"@de,
        "physical measurement of pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/10055> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12586> ;
    skos:definition "The study of the behavior of foundations and structures relative to seismic ground motion, and the attempt to mitigate the effect of earthquakes on structures."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Seismisches Ingenieurwesen"@de,
        "seismic engineering"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Earthquake_engineering> .

<http://www.eionet.europa.eu/gemet/concept/10067> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8571> ;
    skos:closeMatch <http://data.uba.de/umt/_00027877> ;
    skos:definition "Any activity that encourages or supports the buying, selling or exchanging of goods or services with other countries, which could include marketing, diplomatic pressure or the provision of export incentives such as credits and guarantees, government subsidies, training and consultation or advice."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/2804> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Wirtschaftsförderung"@de,
        "promotion of trade and industry"@en .

<http://www.eionet.europa.eu/gemet/concept/10068> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1033> ;
    skos:closeMatch <http://data.uba.de/umt/_00029995>,
        <http://dbpedia.org/resource/Masonry> ;
    skos:definition "A construction of stone or similar materials such as concrete or brick."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Mauerwerk"@de,
        "masonry"@en .

<http://www.eionet.europa.eu/gemet/concept/1007> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2642> ;
    skos:closeMatch <http://data.uba.de/umt/_00005670>,
        <http://dbpedia.org/resource/Bromine> ;
    skos:definition "A pungent dark red volatile liquid element of the halogen series that occurs in brine and is used in the production of chemicals."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_1106>,
        <http://eurovoc.europa.eu/5046> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Brom"@de,
        "bromine"@en .

<http://www.eionet.europa.eu/gemet/concept/10071> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8386> ;
    skos:closeMatch <http://data.uba.de/umt/_00040243> ;
    skos:definition "A sandy tidal flat barren of vegetation. A tidal flat is an extensive, nearly horizontal, marshy or barren tract of land that is alternately covered and uncovered by the tide, and consisting of unconsolidated sediment (mostly mud and sand). It may form the top surface of a deltaic deposit."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Sandwatt"@de,
        "sand flat"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Mudflat> .

<http://www.eionet.europa.eu/gemet/concept/10078> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8579> ;
    skos:definition "The common beliefs, practices, customs and other cultural elements of an ethnic or social group that are rooted in the past, but are persisting into the present due to means such as arts and crafts, songs and music, dance, foods, drama, storytelling and certain forms of oral communication."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Volkstradition"@de,
        "folk tradition"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Folk_religion> .

<http://www.eionet.europa.eu/gemet/concept/10087> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5119> ;
    skos:definition "The quantitative determination of the presence, extent or type of pollutant substances in the environment by studying the actions or reactions of known chemicals to those pollutants."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Chemische Verunreinigungsmessung"@de,
        "chemical measurement of pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/10089> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6402> ;
    skos:definition "The process of cumulative reactive change following the introduction of a pollutant into the environment."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Schadstoffentwicklung"@de,
        "pollutant evolution"@en .

<http://www.eionet.europa.eu/gemet/concept/10092> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2884> ;
    skos:closeMatch <http://data.uba.de/umt/_00051411> ;
    skos:definition "Noise emitted from various sources in an urban environment."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Städtischer Lärm"@de,
        "urban noise"@en .

<http://www.eionet.europa.eu/gemet/concept/10097> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4126> ;
    skos:definition "The state of being clean and keeping healthy conditions."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Sauberkeit"@de,
        "cleanliness (hygiene)"@en ;
    skos:scopeNote "clothes, kitchenware, etc. <F>"@en .

<http://www.eionet.europa.eu/gemet/concept/10102> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7233> ;
    skos:definition "Probability of harm to human health, property or the environment posed by any aspect of the physical world other than human activity."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/4075> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Naturrisiko"@de,
        "natural risk"@en .

<http://www.eionet.europa.eu/gemet/concept/10103> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7236> ;
    skos:closeMatch <http://data.uba.de/umt/_00050796> ;
    skos:definition "Analysis of the probability of occurrence, within a specific period of time in a given area, of a potentially damaging phenomenon of nature."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Naturrisikoanalyse"@de,
        "natural risk analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/10107> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7362> ;
    skos:closeMatch <http://dbpedia.org/resource/Crisis_management> ;
    skos:definition "The technique, practice or science of handling or controlling situations of acute difficulty, danger or instability; or the total of measures taken to provide a solution for political, economic, environmental or other similar dangers and conflicts."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Krisenmanagement"@de,
        "crisis management"@en .

<http://www.eionet.europa.eu/gemet/concept/10120> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8308> ;
    skos:closeMatch <http://data.uba.de/umt/_00051294> ;
    skos:definition "A co-ordinated body of methods or plan of procedures for levying compulsory charges for the purpose of raising revenue."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/1021> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Steuersystem"@de,
        "tax system"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Tax> .

<http://www.eionet.europa.eu/gemet/concept/10126> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2778> ;
    skos:definition "The development at any level of a general notion of the surrounding ecosystem, its foundational relationship to human life and the need to preserve its integrity."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Umweltkonzept"@de,
        "concept of environment"@en .

<http://www.eionet.europa.eu/gemet/concept/10130> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10129> ;
    skos:closeMatch <http://data.uba.de/umt/_00023132>,
        <http://dbpedia.org/resource/Urban_ecology> ;
    skos:definition "Concept derived from biology: the city is viewed as a total environment, as a life-supporting system for the large number of people concentrated there, and within this people organize themselves and adapt to a constantly changing environment. Regarded as the same as human ecology."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Stadtökologie"@de,
        "urban ecology"@en .

<http://www.eionet.europa.eu/gemet/concept/10133> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12586> ;
    skos:closeMatch <http://dbpedia.org/resource/Environmental_engineering> ;
    skos:definition "Branch of engineering concerned with the environment and its proper management. The major environmental engineering disciplines regard water supply, wastewater, stormwater, solid waste, hazardous waste, noise radiology, industrial hygiene, oceanography and the like."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_331355> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Umwelttechnik"@de,
        "environmental engineering"@en .

<http://www.eionet.europa.eu/gemet/concept/10135> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10129> ;
    skos:closeMatch <http://data.uba.de/umt/_00018879> ;
    skos:definition "The application of ecological concepts to fossil and sedimentary evidence to study the interactions of Earth surface, atmosphere, and biosphere in former times."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Paläökologie"@de,
        "palaeoecology"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Paleoecology> .

<http://www.eionet.europa.eu/gemet/concept/10136> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5507> ;
    skos:definition "The inheritance and preservation of the earth's or a particular region's balanced, integrated functionality as a natural habitat, with special concern for the water resources necessary to maintain the ecosystem."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Biologisches Erbe"@de,
        "biological heritage"@en .

<http://www.eionet.europa.eu/gemet/concept/1014> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10548> ;
    skos:definition "To incubate eggs or cover the young for warmth."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_9445> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Brüten"@de,
        "brooding"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Avian_incubation> .

<http://www.eionet.europa.eu/gemet/concept/10140> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:closeMatch <http://dbpedia.org/resource/Altitude> ;
    skos:definition """1) In general, a term used to describe a topographic eminence.
2) A specific altitude or height above a given level. 
3) In surveying, the term refers to the angle between the horizontal and a point at a higher level."""@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_316> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Höhe"@de,
        "altitude"@en .

<http://www.eionet.europa.eu/gemet/concept/10142> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1512> ;
    skos:closeMatch <http://dbpedia.org/resource/Cove> ;
    skos:definition """1) A deep recess hollow, or nook in a cliff or steep mountainside, or a small, straight valley extending into a mountain or down a mountainside.
2) A valley or portion of lowland that penetrates into a plateau or mountain front."""@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Einbuchtung"@de,
        "cove"@en .

<http://www.eionet.europa.eu/gemet/concept/10143> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8887> ;
    skos:closeMatch <http://dbpedia.org/resource/Canyon> ;
    skos:definition "A long deep, relatively narrow steep-sided valley confined between lofty and precipitous walls in a plateau or mountainous area, often with a stream at the bottom; similar to, but largest than, a gorge. It is characteristic of an arid or semiarid area (such as western U.S.) where stream downcutting greatly exceeds weathering."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Schlucht"@de,
        "canyon"@en .

<http://www.eionet.europa.eu/gemet/concept/10144> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1512> ;
    skos:closeMatch <http://data.uba.de/umt/_00050216>,
        <http://dbpedia.org/resource/Headland> ;
    skos:definition "A cape or promontory jutting seawards from a coastline, usually with a significant sea cliff."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Landspitze"@de,
        "headland (geography)"@en .

<http://www.eionet.europa.eu/gemet/concept/10146> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4629> ;
    skos:closeMatch <http://data.uba.de/umt/_00500169> ;
    skos:definition "A deep steep-walled half-bowl-like recess or hollow, variously described as horseshoe- or crescent-shaped or semi-circular in plan, situated high on the side of a mountain and commonly at the head of a glacial valley and produced by the erosive activity of a mountain glacier. It often contains a small round lake, and it may or may not be occupied by ice or snow."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "geographisches Kar"@de,
        "geographic circque"@en .

<http://www.eionet.europa.eu/gemet/concept/10148> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1757> ;
    skos:closeMatch <http://dbpedia.org/resource/Continent> ;
    skos:definition "A protuberance of the earth's crustal shell, with an area of several million square miles and sufficient elevation so that much of it above sea level."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_331053> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Kontinent"@de,
        "continent"@en .

<http://www.eionet.europa.eu/gemet/concept/10149> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/751> ;
    skos:definition "An elongated sand or shingle bank which lies parallel to the coastline and is not submerged by the tide. If it is high enough to permit dune growth it is termed a barrier island."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Strandwall"@de,
        "barrier beach"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Shoal> .

<http://www.eionet.europa.eu/gemet/concept/10154> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2400> ;
    skos:closeMatch <http://dbpedia.org/resource/Fault> ;
    skos:definition "A fracture or a zone of fractures along which there has been displacement of the sides relative to one another parallel to the fracture."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Verwerfung"@de,
        "fault"@en .

<http://www.eionet.europa.eu/gemet/concept/10155> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1512> ;
    skos:closeMatch <http://dbpedia.org/resource/Cliff> ;
    skos:definition "A steep coastal declivity which may or may not be precipitous, the slope angle being dependent partly on the jointing, bedding and hardness of the materials from which the cliff has been formed, and partly on the erosional processes at work. Where wave attack is dominant the cliff-foot will be rapidly eroded and cliff retreat will take place, especially in unconsolidated materials such as clays, sands, etc., frequently leaving behind an abrasion platform at the foot of the cliff."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Klippe"@de,
        "cliff"@en .

<http://www.eionet.europa.eu/gemet/concept/10158> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7495> ;
    skos:definition "The high seas lying outside the exclusive economic zones of states. All states have equal rights to navigate, to overfly, to lay submarine cables, to construct artificial islands, to fish, and to conduct scientific research within the high seas."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/605> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Hochsee"@de,
        "open sea"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/World_Ocean> .

<http://www.eionet.europa.eu/gemet/concept/10160> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4589> ;
    skos:closeMatch <http://data.uba.de/umt/_00049862> ;
    skos:definition "A coastal stretch of shallow saltwater virtually cut off from the open sea by a coral reef."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Lagune innerhalb von Korallenriffen"@de,
        "coral reef lagoon"@en .

<http://www.eionet.europa.eu/gemet/concept/10170> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6276> ;
    skos:closeMatch <http://data.uba.de/umt/_00009917>,
        <http://dbpedia.org/resource/Alluvial_plain> ;
    skos:definition "A level or gently sloping tract or a slightly undulating land surface produced by extensive deposition of alluvium, usually adjacent to a river that periodically overflows its banks; it may be situated on a flood plain, a delta, or an alluvial fan."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Flußmarsch"@de,
        "alluvial plain"@en .

<http://www.eionet.europa.eu/gemet/concept/10175> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7034> ;
    skos:closeMatch <http://dbpedia.org/resource/Barrier_reef> ;
    skos:definition "An elongated accumulation of coral lying at low-tide level parallel to the coast but separated from it by a wide and deep lagoon or strait. The coral is thought to have formed initially on a flat surface: then as the sea-level rose in post-glacial times, thereby submerging the irregular wave-cut platform, the coral growth kept pace with the rising ocean level, so creating the great thickness witnessed today in such places as the Great Barrier Reef off the East coast of Queensland, Australia. This stretches for more than 1900 km and varies in width from about 30 km to 150 km."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_9089> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Barriereriff"@de,
        "barrier reef"@en .

<http://www.eionet.europa.eu/gemet/concept/10176> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5405> ;
    skos:closeMatch <http://dbpedia.org/resource/Terrain> ;
    skos:definition "The physical shape, configuration or general unevenness of a part of the Earth's surface, considered with reference to variation of height and slope or to irregularities of the land surface; the elevation or difference in elevation, considered collectively, of a land surface."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Relief"@de,
        "relief (land)"@en .

<http://www.eionet.europa.eu/gemet/concept/10190> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7603> ;
    skos:definition "Terrestrial or aquatic area or other fragile natural setting with unique or highly-valued environmental features."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Empfindliche Naturlandschaft"@de,
        "sensitive natural area"@en .

<http://www.eionet.europa.eu/gemet/concept/10193> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10166> ;
    skos:definition "The non-living components of the environment (rocks, minerals, soil, water and climate)."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Abiotische Umwelt"@de,
        "abiotic environment"@en .

<http://www.eionet.europa.eu/gemet/concept/10194> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5498> ;
    skos:definition "Waters, including wetlands, that serve as habitat for interrelated and interacting communities and populations of plants and animals."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_554> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Aquatische Umwelt"@de,
        "aquatic environment"@en .

<http://www.eionet.europa.eu/gemet/concept/10197> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2944> ;
    skos:definition "Any parcel of land, large or small, under public or private control, that already has, or with remedial action could achieve, desirable environmental attributes. These attributes contribute to the retention and/or creation of wildlife habitat, soils stability, water retention or recharge, vegetative cover, and similar vital ecological functions. Environmentally sensitive areas range in size from small patches to extensive landscape features. They can include rare or common habitats, plants and animals."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Empfindliche Umwelt"@de,
        "sensitive environment"@en .

<http://www.eionet.europa.eu/gemet/concept/10199> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10212> ;
    skos:closeMatch <http://dbpedia.org/resource/Marine_park> ;
    skos:definition "A permanent reservation on the seabed for the conservation of species."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_36402> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Meerespark"@de,
        "marine park"@en .

<http://www.eionet.europa.eu/gemet/concept/10200> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5513> ;
    skos:closeMatch <http://data.uba.de/umt/_00051046> ;
    skos:definition "A park operated and managed by a region."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Regionaler Naturpark"@de,
        "regional natural park"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Regional_natural_parks_of_France> .

<http://www.eionet.europa.eu/gemet/concept/10202> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7137> ;
    skos:definition "An area of land and/or of water designated as having protected status for purposes of preserving certain biological features. Reserves are managed primarily to safeguard these features and provide opportunities for research into the problems underlying the management of natural sites and of vegetation and animal populations. Regulations are normally imposed controlling public access and disturbance."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Staatliches biologisches Schutzgebiet"@de,
        "state biological reserve"@en .

<http://www.eionet.europa.eu/gemet/concept/10203> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3435> ;
    skos:closeMatch <http://data.uba.de/umt/_00051645> ;
    skos:definition "Forest areas which are protected and guarded from deforestation because of the fragility of its ecosystems, and because they provide habitats for hundreds of species of plants and animals."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Biologisches Forstreservat"@de,
        "forest biological reserve"@en .

<http://www.eionet.europa.eu/gemet/concept/10208> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5545> ;
    skos:closeMatch <http://data.uba.de/umt/_00051448> ;
    skos:definition "Area of national interest which is protected under the responsibility of its owner in order to safeguard wildlife, archeological and geological sites."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Freiwilliges Naturreservat"@de,
        "voluntary natural reserve"@en .

<http://www.eionet.europa.eu/gemet/concept/10210> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5513> ;
    skos:definition "The core area of a park or of a reserve where there can be no interference with the natural ecosystem."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Zentraler Parkbereich"@de,
        "central park area"@en .

<http://www.eionet.europa.eu/gemet/concept/10214> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5513> ;
    skos:closeMatch <http://data.uba.de/umt/_00050888> ;
    skos:definition "A zone of the park where scientific research is allowed. Beyond this there is a buffer zone which protects the whole reserve from agricultural, industrial and urban development."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Parkrandgebiet"@de,
        "peripheral park area"@en .

<http://www.eionet.europa.eu/gemet/concept/10215> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:closeMatch <http://dbpedia.org/resource/Alignment> ;
    skos:definition "The selection and detailed layout of public transport routes in the light of construction, operation, service, technology, and economic criteria."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Trassierung"@de,
        "alignment"@en .

<http://www.eionet.europa.eu/gemet/concept/10217> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/204> ;
    skos:closeMatch <http://dbpedia.org/resource/Bocage> ;
    skos:definition "The wooded countryside characteristic of northern France, with small irregular-shaped fields and many hedges and copses. In the French language the word bocage refers both to the hedge itself and to a landscape consisting of hedges. Bocage landscapes usually have a slightly rolling landform, and are found mainly in maritime climates. Being a small-scale, enclosed landscape, the bocage offers much variations in biotopes, with habitats for birds, small mammals, amphibians, reptiles and butterflies."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Boskett"@de,
        "bocage"@en .

<http://www.eionet.europa.eu/gemet/concept/10225> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3559> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Französischer Garten"@de,
        "French formal garden"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Garden_%C3%A0_la_fran%C3%A7aise> .

<http://www.eionet.europa.eu/gemet/concept/10228> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3559> ;
    skos:closeMatch <http://dbpedia.org/resource/English_garden> ;
    skos:definition "A plot of ground consisting of an orderly and balanced arrangement of masses of flowers, shrubs and trees, following British traditions or style."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Englischer Garten"@de,
        "English garden"@en .

<http://www.eionet.europa.eu/gemet/concept/10229> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3559> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Terassenförmiger Garten"@de,
        "terraced garden"@en .

<http://www.eionet.europa.eu/gemet/concept/10233> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4648> ;
    skos:definition "Landscape resulting from the method of cultivating land by cutting terraces or benches into slopes to create areas of flat land. The practice is common in mountainous areas where land is scarce and rainfall uncertain."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Terassenförmige Landschaft"@de,
        "terraced landscape"@en .

<http://www.eionet.europa.eu/gemet/concept/10237> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10032> ;
    skos:closeMatch <http://data.uba.de/umt/_00009682> ;
    skos:definition "Precautionary actions, procedures or installations undertaken to prevent or reduce harm to the environmental integrity of a physical area or location."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Flächenschutz"@de,
        "site protection"@en .

<http://www.eionet.europa.eu/gemet/concept/1024> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4233> ;
    skos:closeMatch <http://data.uba.de/umt/_00011711>,
        <http://dbpedia.org/resource/Emissions_trading> ;
    skos:definition "EPA policy that allows a plant complex with several facilities to decrease pollution from some facilities while increasing it from others, so long as total results are equal to or better than previous limits. Facilities where this is done are treated as if they exist in a bubble in which total emissions are averaged out."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Glockenpolitik"@de,
        "bubble policy (emissions trading)"@en .

<http://www.eionet.europa.eu/gemet/concept/10240> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7091> ;
    skos:closeMatch <http://data.uba.de/umt/_00046418> ;
    skos:definition "The restoration of the ecological quality of an area or location."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_330973> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Flächensanierung"@de,
        "site rehabilitation"@en .

<http://www.eionet.europa.eu/gemet/concept/10243> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10244> ;
    skos:closeMatch <http://data.uba.de/umt/_00049775> ;
    skos:definition "Site which is declared protected because of its natural, landscape, artistic or archeological features in order to guarantee its conservation, maintenance and restoration."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Nichtöffentlicher Bereich"@de,
        "classified site"@en .

<http://www.eionet.europa.eu/gemet/concept/10251> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5011> ;
    skos:closeMatch <http://data.uba.de/umt/_00051404> ;
    skos:definition "A graphic representation of a city area or other densely populated region, portraying the location of groups or select types of people in their environment through various geographic techniques."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Stadtökologieprogramm"@de,
        "urban ecology charter"@en .

<http://www.eionet.europa.eu/gemet/concept/10255> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5003> ;
    skos:definition "The state, character or behavior of a person viewed as a member of the ecosystem with attendant rights and responsibilities, especially the responsibility to maintain ecological integrity and the right to exist in a healthy environment."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Umweltbürgerschaft"@de,
        "environmental citizenship"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Environmental_contract> .

<http://www.eionet.europa.eu/gemet/concept/10256> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2877>,
        <http://www.eionet.europa.eu/gemet/concept/4985> ;
    skos:definition "Unified, combined and coordinated management of environmental problems which correlates relevant organisations, groups, individuals and disciplines by bringing the parts together for a complete approach."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_9000088> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Integriertes Management"@de,
        "integrated management"@en .

<http://www.eionet.europa.eu/gemet/concept/10260> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13242> ;
    skos:closeMatch <http://data.uba.de/umt/_00045920> ;
    skos:definition "A person, firm, organization, etc. that provides or pledges money for an undertaking or event."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/5771> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Sponsoring"@de,
        "sponsorship"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Sponsor_%28commercial%29> .

<http://www.eionet.europa.eu/gemet/concept/10263> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6279> ;
    skos:closeMatch <http://data.uba.de/umt/_00050766> ;
    skos:definition "A formulated or systematic method for the management of a city or town's natural or ecological resources."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Städtischer Umweltplan"@de,
        "municipal environment plan"@en .

<http://www.eionet.europa.eu/gemet/concept/1028> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4358> ;
    skos:closeMatch <http://data.uba.de/umt/_00047505>,
        <http://dbpedia.org/resource/Bug> ;
    skos:definition "Any of the suborder Heteroctera, having piercing and sucking mouthparts, specialized as a beak."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Wanze"@de,
        "bug"@en .

<http://www.eionet.europa.eu/gemet/concept/1031> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1041> ;
    skos:closeMatch <http://data.uba.de/umt/_00003954> ;
    skos:definition "Land and other places on, under, in or through which the temporary and permanent works are to be executed and any other lands or places needed for the purposes of construction."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Baugebiet"@de,
        "building area"@en .

<http://www.eionet.europa.eu/gemet/concept/10381> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1191> ;
    skos:definition "Predatory mammal, including cats, lions, leopards, tigers, jaguars, and cheetahs, typically having a round head and retractile claws."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Katzentiere"@de,
        "felid"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Felidae> .

<http://www.eionet.europa.eu/gemet/concept/10421> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/503>,
        <http://www.eionet.europa.eu/gemet/concept/5043>,
        <http://www.eionet.europa.eu/gemet/concept/508> ;
    skos:closeMatch <http://data.uba.de/umt/_00016785>,
        <http://dbpedia.org/resource/Marine_mammal> ;
    skos:definition "Mammals which have adapted to live in the sea, such as whales, dolphins, porpoises, etc."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/1775> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Meeressäugetier"@de,
        "marine mammal"@en .

<http://www.eionet.europa.eu/gemet/concept/10444> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8769> ;
    skos:definition "Horned ruminant mammals raised in many breeds for wool, edible flesh, or skin."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/2211> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Ovine"@de,
        "ovine"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Domestic_sheep> .

<http://www.eionet.europa.eu/gemet/concept/10495> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8262> ;
    skos:closeMatch <http://dbpedia.org/resource/Shelter> ;
    skos:definition "Cover or protection, as from weather or danger; place of refuge."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Unterschlupf"@de,
        "shelter"@en .

<http://www.eionet.europa.eu/gemet/concept/10496> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/544> ;
    skos:definition "A place where birds gather to lay eggs."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Nistgebiet"@de,
        "nesting area"@en .

<http://www.eionet.europa.eu/gemet/concept/105> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:closeMatch <http://data.uba.de/umt/_00026509> ;
    skos:definition "An authoritative decree, sanction or order issued from an office with executive or managerial authority, without necessarily having the force of law or its equivalent."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/2669> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Verwaltungszwang"@de,
        "administrative fiat"@en .

<http://www.eionet.europa.eu/gemet/concept/10510> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6740> ;
    skos:definition "Line corridors (roads, paths, and hedgerows) which lack interior habitat but may serve as movement groups for organisms. Corridors may also provide an efficient migratory pathway for animals. The presence or absence of breaks in a corridor may be a very important factor in determining the effectiveness of its conduit and barrier functions."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Tierkorridor"@de,
        "animal corridor"@en .

<http://www.eionet.europa.eu/gemet/concept/10512> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/664> ;
    skos:closeMatch <http://data.uba.de/umt/_00049667> ;
    skos:definition "The habit of many animal species of moving inside their habitats or of travelling, during migrations, to different biotopes, often considerable distances apart; in aquatic environments displacements can occur horizontally or vertically while in terrestrial environments animal populations that breed in the alpine or subalpine zones in summer, move to lower levels in winter; animal displacements usually follow circadian rhythms and are related to the necessity of finding breeding, resting and feeding areas."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Tierartenvertreibung"@de,
        "animal displacement"@en .

<http://www.eionet.europa.eu/gemet/concept/10521> a skos:Concept ;
    skos:broadMatch <http://eurovoc.europa.eu/2320> ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/501> ;
    skos:closeMatch <http://data.uba.de/umt/_00015662> ;
    skos:definition "Area of water where fish come each year to produce their eggs."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_7277> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Laichplatz"@de,
        "spawning ground"@en .

<http://www.eionet.europa.eu/gemet/concept/10535> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/415> ;
    skos:closeMatch <http://dbpedia.org/resource/Nesting> ;
    skos:definition "The building of nests for egg laying and rearing of offspring."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_5140> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Nisten"@de,
        "nesting"@en .

<http://www.eionet.europa.eu/gemet/concept/10539> a skos:Concept ;
