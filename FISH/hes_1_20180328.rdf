		<skos:prefLabel xml:lang="gd">STÈISEAN THANCAICHEAN GAS</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Ionad far a bheil co-dhiù aon tanca gas so-ataichte, gu math tric le acainn gus uiread a' ghas a thomhas a chaidh a chleachdadh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GAS HOLDER STATION</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
