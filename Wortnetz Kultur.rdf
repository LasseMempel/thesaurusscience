	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk009949">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Garnspulen</skos:altLabel>
		<skos:prefLabel xml:lang="de">Spule (Gerät zur Textilerzeugung)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Spulen (Geräte zur Textilerzeugung)</skos:altLabel>
		<skos:altLabel xml:lang="en">wound package</skos:altLabel>
		<skos:prefLabel xml:lang="en">yarn package</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk016344"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013760"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk016344"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk009731"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk017435"/>
		<skos:definition xml:lang="de">Eine Spule ist eine Gerätschaft zur Textilerzeugung in Form von meist auf eine Hülse aufgewickelten Garns oder Fadens. Das Garn kann dabei parallel oder kreuzförmig aufgewickelt sein und kann auch ganz ohne Hülse (Spulenkern) hergestellt werden.</skos:definition>
		<skos:scopeNote xml:lang="de">Benutzt für das aufgewickelte Material mit oder ohne Hülse. Für den Spulenkern ohne Wicklung benutze &amp;quot;Hülse (Gerät zur Textilerzeugung)&amp;quot; (wk017435).</skos:scopeNote>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4510218-1"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk013760"/>
