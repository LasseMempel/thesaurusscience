	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk014944">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">recipe booklet</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Rezeptheft</skos:prefLabel>
		<skos:altLabel xml:lang="de">Rezepthefte</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk017782"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013611"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk017782"/>
		<skos:definition xml:lang="de">Ein Rezeptheft ist ein Heft, in dem Rezepte abgedruckt sind. Im Gegensatz zum Rezeptbuch weist das Rezeptheft einen geringeren Seitenumfang auf und besteht wie ein Heft aus gefalzten und zumeist geklammerten Papierbögen.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk013611"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk017782"/>
