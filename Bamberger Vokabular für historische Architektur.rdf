        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_34f98b47"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_8d03eb49"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-28T18:13:35.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T11:54:48.000</terms:modified>
        <skos:altLabel xml:lang="de">Almosenteller</skos:altLabel>
        <skos:altLabel xml:lang="de">Opferteller</skos:altLabel>
        <skos:altLabel xml:lang="en">offering basin</skos:altLabel>
        <skos:definition xml:lang="de">Kollektenteller m; Opferteller m; auch Almosenteller m: ein Teller oder eine Schale zum Einsammeln von Geldspenden beim Gottesdienst. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Kollektenteller</skos:prefLabel>
        <skos:prefLabel xml:lang="en">collection-plate</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">plaeau à aumônes</skos:prefLabel>
    </owl:NamedIndividual>
    


