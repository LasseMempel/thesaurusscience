		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/87" />
		<skos:scopeNote xml:lang="en">An extensive landed property, usually in the country.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
