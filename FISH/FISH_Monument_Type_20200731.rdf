  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68630">
    <skos:scopeNote xml:lang="en">Long parallel soil ridges less than 5 metres across separated by furrows, formed by using a heavy plough capable of turning the soil.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167323">
    <skos:scopeNote xml:lang="en">A large, usually metal, container used for the storage of liquid fuels.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68927">
    <skos:scopeNote xml:lang="en">A timber building based around a sunken hollow, the floor of which may have been suspended above the hollow to counteract dampness. Grubenhauser are believed to date from the 5th to 8th centuries AD but may be earlier. Use Grubenhauser as plural.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140546">
    <skos:scopeNote xml:lang="en">A night fighter station watch office based on the standard design dor Bomber Satellite Station watch offices</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69026">
    <skos:scopeNote xml:lang="en">A gallery or building in a garden, usually south facing, used for the growing of oranges and other fruit.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91885">
    <skos:scopeNote xml:lang="en">A pavilion used for exhibitions, e.g. the exhibition pavilions at the Great Empire Exhibition, Wembley, 1925.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78158">
    <skos:scopeNote xml:lang="en">a wooden, metal or stone post used to tether a horse, or other animals.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71603">
    <skos:scopeNote xml:lang="en">The residence of a teacher, often on the site of a school.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92823">
    <skos:scopeNote xml:lang="en">A bridge built to enhance or compliment the surrounding landscape. Mainly found on estates or in parkland and usually 18th and 19th century.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92924">
    <skos:scopeNote xml:lang="en">A building or site used for the manufacture of pins.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91445">
    <skos:scopeNote xml:lang="en">Sites used for the manufacture of chemicals used as the basis for complex chemical processes or products.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68589">
    <skos:scopeNote xml:lang="en">A large park for keeping deer. In medieval times the prime purpose was for hunting.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69298">
    <skos:scopeNote xml:lang="en">A building or site used for the manufacture of swords.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92851">
    <skos:scopeNote xml:lang="en">A building, usually circular, or containing circular rooms, for the exhibition of panorama paintings.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92643">
    <skos:scopeNote xml:lang="en">Sites where minerals are extracted from the ground.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69957">
    <skos:scopeNote xml:lang="en">A building used primarily for the performing of plays.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92602">
    <skos:scopeNote xml:lang="en">A place of worship for followers of the Methodist New Connexion, a movement founded in 1791 when Alexander Kilham led the first group to split from the Methodists.</skos:scopeNote>
  </rdf:Description>
