  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71602">
    <skos:scopeNote xml:lang="en">Any church of the Anglican Communion.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91795">
    <skos:scopeNote xml:lang="en">A road/carriage way giving access from the main road to the house, stables.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69147">
    <skos:scopeNote xml:lang="en">A works used for the production of copperas, a green iron sulphate which is used as a fixative in the dyeing process.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92905">
    <skos:scopeNote xml:lang="en">A garden maintained for the study and cultivation of plants for medicinal purposes.</skos:scopeNote>
  </rdf:Description>
