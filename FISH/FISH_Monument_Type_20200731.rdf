  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/103236">
    <skos:scopeNote xml:lang="en">A large room within a hospital set aside for emergency patients.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92995">
    <skos:scopeNote xml:lang="en">A workshop containing machinery used to press textiles.</skos:scopeNote>
  </rdf:Description>
