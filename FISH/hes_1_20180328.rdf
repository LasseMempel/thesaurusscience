				<skos:prefLabel xml:lang="gd">GÀRRADH RAINICH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Àite ann an gàrradh far a bheilear a' toirt fàs air raineach.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">FERNERY (GARDEN)</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-27T13:44:12</dcterms:created>
