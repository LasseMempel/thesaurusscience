		<skos:altLabel xml:lang="en">laundry rooms</skos:altLabel>
		<skos:prefLabel xml:lang="de">Waschküche</skos:prefLabel>
		<skos:altLabel xml:lang="de">Waschküchen</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk012211"/>
