    <!-- https://hist-arch-vocab.org/bvha#c_aefad218 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_aefad218">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_5f9418c5"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-16T10:01:37.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:06:24.000</terms:modified>
        <skos:altLabel xml:lang="de">Kreuzklostergewölbe</skos:altLabel>
        <skos:altLabel xml:lang="de">Rippen-Klostergewölbe</skos:altLabel>
        <skos:altLabel xml:lang="de">Zwickeldomikal</skos:altLabel>
        <skos:altLabel xml:lang="en">domed vault</skos:altLabel>
        <skos:altLabel xml:lang="en">domical cross vault</skos:altLabel>
        <skos:altLabel xml:lang="de">gratiges Domikalgewölbe</skos:altLabel>
        <skos:altLabel xml:lang="de">kreuzgewölbtes Domikal</skos:altLabel>
        <skos:altLabel xml:lang="de">kuppelförmiges Kreuzgewölbe</skos:altLabel>
        <skos:altLabel xml:lang="de">kuppliges Kreuzgewölbe</skos:altLabel>
        <skos:altLabel xml:lang="fr">voûte bombee</skos:altLabel>
        <skos:definition xml:lang="de">Ein kuppelartig gebustes 8-teiliges Rippengewölbe (4 Kreuz-, 2 Querrippen zwischen Kämpfern und Schlussstein, 2 Scheitelrippenabschnitte) heißt Domikalgewölbe. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Kreuzgewölbe von kuppelartiger Wirkung mit stark überhöhtem Scheitel, in der Regel mit Diagonalrippen und Scheitelrippen; eine Mischform aus Rippengewölbe und Kuppel. Bei spitzbogiger Wölblinie bilden sich im Gewölbescheitel Kehlen aus.[...]. Auch die sogenannte vierkehlige Spitzkuppel kann als Domikalgewölbe bezeichnet werden. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Kuppelartig überhöhte (gebuste) Gewölbeform mit Diagonal- und Scheitelrippen, die hauptsächl. in der spätrom. Baukunst Südwestfrankreichs (Angers) und Westfalens vorkommt. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Domikalgewölbe</skos:prefLabel>
        <skos:prefLabel xml:lang="en">domical vault</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">dominikální klenba</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte domicale</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_5f9418c5"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_af099ff4 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_af099ff4">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_4e152817"/>
