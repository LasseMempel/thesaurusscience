    <!-- https://hist-arch-vocab.org/bvha#c_591ed7e5 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_591ed7e5">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_2c0cce41"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_bfa40c59"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_d03664eb"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-08-17T17:46:23.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-21T18:33:33.000</terms:modified>
        <skos:definition xml:lang="de">Gebetsnische der Moschee. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Mihrab (arab.), kleine Gebetsnische, die die Richtung nach Mekka weisen muss, gegenüber dem Eingang einer Moschee. Aus diesem Grund sind zwar alle Moscheen einheitl. nach Mekka gerichtet, jedoch nach ihrer geograph. Lage verschieden \&apos;orientiert\&apos;. Der M. ist oft durch ein Stalaktitengewölbe abgeschlossen und an den Wänden mit bunten Azulejos bekleidet. [Koepf / Binding 2016]</skos:definition>
        <skos:editorialNote xml:lang="de">gehört unter Bauelement (TAR).</skos:editorialNote>
        <skos:prefLabel xml:lang="de">Mihrab</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">mihrab</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_bfa40c59"/>
    </owl:NamedIndividual>
    


