    skos:closeMatch <http://data.uba.de/umt/_00049815> ;
    skos:definition "Controlled utilization, protection and development of  exploited and potentially exploitable sources of crude oil to meet current demand and ensure future requirements."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Schutz von Erdölressourcen"@de,
        "conservation of petroleum resources"@en .

