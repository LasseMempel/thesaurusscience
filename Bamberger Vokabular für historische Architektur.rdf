        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-02T11:13:57.000</terms:modified>
        <skos:definition xml:lang="de">Geschwungene, kurvig geführte Rippen, die ein Schwing- oder ein Schlingrippengewölbe bilden. [Koepf / Binding 2016]</skos:definition>
