	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021361">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">hand card</skos:prefLabel>
		<skos:altLabel xml:lang="en">hand carder</skos:altLabel>
		<skos:altLabel xml:lang="en">hand carders</skos:altLabel>
		<skos:altLabel xml:lang="en">hand cards</skos:altLabel>
		<skos:prefLabel xml:lang="de">Handkarde</skos:prefLabel>
		<skos:altLabel xml:lang="de">Handkarden</skos:altLabel>
		<skos:altLabel xml:lang="de">Karde (Handwerkzeug)</skos:altLabel>
		<skos:altLabel xml:lang="de">Karden (Handwerkzeuge)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk016344"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk016344"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk021372"/>
		<skos:definition xml:lang="de">Eine Handkarde ist ein manuelles Gerät zur Textilherstellung, meist bestehend aus einem rechteckigen Brett mit Griff, das auf einer Seite mit feinen, gebogenen Metallhäkchen besetzt ist. In der Regel werden Handkarden paarweise so verwendet, dass lose Rohfasern (Wolle, Baumwolle und andere Naturfasern) durch die Kardenflächen gezogen werden, um sie zu entwirren, zu reinigen und in eine grob parallele Ausrichtung zu bringen.</skos:definition>
		<skos:mappingRelation rdf:resource="http://vocab.getty.edu/aat/300422672"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q2402796"/>
		<skos:mappingRelation rdf:resource="http://www.wikidata.org/entity/Q111361204"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk016344"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-08-29T08:25:46+02:00+01:00</dcterms:modified>
	</skos:Concept>
