    <!-- https://hist-arch-vocab.org/bvha#c_473676c3 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_473676c3">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_effad513"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-08T18:46:29.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T14:43:15.000</terms:modified>
        <skos:altLabel xml:lang="de">Salzreduzierung</skos:altLabel>
        <skos:altLabel xml:lang="de">Salzverminderung</skos:altLabel>
        <skos:altLabel xml:lang="es">desalación</skos:altLabel>
        <skos:altLabel xml:lang="it">dissalazione</skos:altLabel>
        <skos:altLabel xml:lang="pl">odsalanie</skos:altLabel>
        <skos:definition xml:lang="fr">Diminution de la teneur en sel d’un materiau au moyen de differentes techniques d’extraction. (EwaGlos)</skos:definition>
        <skos:definition xml:lang="en">Diminution of the salt content of a material using different extraction techniques. (EwaGlos)</skos:definition>
        <skos:definition xml:lang="de">Reduzierung des Salzgehaltes eines Materials durch den Einsatz verschiedener Extrahierungsverfahren. (EwaGlos)</skos:definition>
        <skos:prefLabel xml:lang="it">Riduzione dei sali</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Salzminderung</skos:prefLabel>
        <skos:prefLabel xml:lang="ro">desalinizare</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">dessalement</skos:prefLabel>
        <skos:prefLabel xml:lang="hr">isoljavanje</skos:prefLabel>
        <skos:prefLabel xml:lang="es">reducción de sales</skos:prefLabel>
        <skos:prefLabel xml:lang="en">salt reduction</skos:prefLabel>
        <skos:prefLabel xml:lang="hu">sókivonás</skos:prefLabel>
        <skos:prefLabel xml:lang="tr">tuz azaltması</skos:prefLabel>
        <skos:prefLabel xml:lang="pl">usuwanie soli</skos:prefLabel>
        <skos:prefLabel xml:lang="bg">Извличане на соли</skos:prefLabel>
