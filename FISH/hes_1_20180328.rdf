	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/298">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/298</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">DÙN IS GÀRRADH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Nàdar a chaisteal tràth le tùr fiodha air tom ùir corrach air a bheil mullach rèidh agus mun a bheil foir-dhùin.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MOTTE AND BAILEY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">MOTTE AND BAILEY CASTLE</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/295" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/297" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/298" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/299" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/330" />
		<skos:scopeNote xml:lang="en">An early form of castle consisting of a flat-topped, steep-sided earthen mound, supporting a wooden tower, and accompanied by a bailey.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
