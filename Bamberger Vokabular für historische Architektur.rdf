    <!-- https://hist-arch-vocab.org/bvha#c_e1a6eab7 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_e1a6eab7">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f4ceb052"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_b41bd73a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-18T16:44:34.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-15T15:32:38.000</terms:modified>
        <skos:definition xml:lang="de">Bei der Verglasung mit Butzen, Tellerscheiben und rund zugeschnittenem Tafelglas je nach Anordnung zwischen den Ringen verbleibende drei- bzw. auch viereckige Restfelder, die dann mit zugeschnittenen Glasstücken geschlossen werden. [Noky 1996]</skos:definition>
        <skos:prefLabel xml:lang="de">Zwickel (Fensterglas)</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_e1abd01c -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_e1abd01c">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_2c0cce41"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-18T11:30:21.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T14:37:46.000</terms:modified>
        <skos:example xml:lang="de">Bei Schlossanlagen, die Nebengebäude wie Orangerien, Wirtschaftsgebäude oder Schmuckbauten in Gärten etc. besitzen, bezeichnet der &quot;Hauptbau&quot; das eigentliche Schlossgebäude.</skos:example>
        <skos:prefLabel xml:lang="de">Hauptbau</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">hlavní stavba</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Funktional, gestalterisch bzw. hinsichtlich der Lage oder Dimnesion maßgebliches Gebäude innerhalb einer aus mehreren Gebäuden zusammengesetzten Anlage [Tobias Arera-Rütenik].</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_e1b54cb0 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_e1b54cb0">
