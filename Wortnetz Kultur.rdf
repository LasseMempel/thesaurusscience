	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004636">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Abgehängte Decke</skos:prefLabel>
		<skos:altLabel xml:lang="de">Abgehängte Unterdecke</skos:altLabel>
		<skos:prefLabel xml:lang="en">suspended ceiling</skos:prefLabel>
		<skos:altLabel xml:lang="de">Unterdecke</skos:altLabel>
		<skos:altLabel xml:lang="de">Unterhängedecke</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000157"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk014407"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk014720"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000157"/>
		<skos:definition xml:lang="de">Eine Abgehängte Decke ist eine Decke, die unter einer bereits vorhandenen Decke als zweite Ebene eingezogen und häufig bei großen Raumhöhen eingesetzt wird.</skos:definition>
		<xe:explanation_temp xml:lang="de">Eine abgehängte Decke bietet die Möglichkeit im entstehenden Zwischenraum Gebäudetechnik unterzubringen und einen hohen Energieverbrauch in großen Räumen zu vermeiden.</xe:explanation_temp>
