        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T11:59:02.000</terms:modified>
        <skos:altLabel xml:lang="de">Kleeblattbogenfries</skos:altLabel>
        <skos:altLabel xml:lang="de">runder Kleezug</skos:altLabel>
        <skos:definition xml:lang="de">Die Formen des Kleeblattbogens wiederholender Fries. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Dreipassfries</skos:prefLabel>
