        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-13T09:34:59.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T12:59:47.000</terms:modified>
        <skos:altLabel xml:lang="de">Almemor</skos:altLabel>
        <skos:altLabel xml:lang="de">Bima</skos:altLabel>
        <skos:altLabel xml:lang="cs">almemor</skos:altLabel>
        <skos:prefLabel xml:lang="de">Bema (Lesekanzel)</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">bima</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Almemor (arab. al minbar: die Redestatt), Bima, erhöhter und umgrenzter Platz des Vorlesers in der Mitte der Synagoge, in neuerer Zeit auch an der Ostwand neben dem hl. Schrein, gelegentl. auch mit diesem und dem Predigtstuhl des Rabbiners zu einer chorartigen Anlage zusammengezogen. [Koepf / Binding 2016]</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Bema ist die Bezeichnung für die Lesekanzel in einer Synagoge. [Koch 2009]</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_fc8ab079 -->


