		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/400</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">DÌG A' BHAILE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Dìg a tha na pàirt de bhacadh dìona mun cuairt air baile.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TOWN DITCH</skos:prefLabel>
