        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T22:51:53.000</terms:modified>
        <skos:definition xml:lang="de"> Tumbaleuchter m: ein hoher Standleuchter, der während der Totenmesse neben dem Sarg steht. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Tumbaleuchter</skos:prefLabel>
