	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk014212">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">weaver</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Weber</skos:prefLabel>
		<skos:altLabel xml:lang="de">Weberinnen</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk008906"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk009791"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013760"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk018347"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk014157"/>
		<xe:explanation_temp xml:lang="de">Ein Weber stellt mit Hilfe eines Webstuhls aus Garnen verschiedene Gewebe her. Im Weberhandwerk wird u.a. zwischen Baumwollwebern, Seidenwebern und Teppichwebern unterschieden.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Weber ist eine Person, die den Beruf des Webens ausübt, also Garne zu Stoffen verarbeitet, indem sie Fäden nach bestimmten Techniken auf einem Webstuhl kreuzt und verknüpft.</skos:definition>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300025367"/>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4064896-5"/>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4231921-3"/>
