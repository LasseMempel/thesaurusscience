		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk002319"/>
		<skos:definition xml:lang="de">Ein Mörtelmauerwerk ist ein Mauerwerk, bei dem Kalk, Trass oder Zement als Bindemittel und auch in unterschiedlichen Mischungsverhältnissen verwendet werden.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002319"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010555"/>
