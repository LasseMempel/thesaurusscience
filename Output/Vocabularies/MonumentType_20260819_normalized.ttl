    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92286> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "MORTUARY"@en ;
    skos:scopeNote "A building or room used for holding, viewing, identifying or examining dead bodies prior to burial or cremation."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70089> a skos:Concept ;
    skos:altLabel "Long Mortuary Enclosure"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69999> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "MORTUARY ENCLOSURE"@en ;
    skos:scopeNote "A subrectangular earthen enclosure defined by a ditch, usually with an internal bank, assumed to have been used for the primary exposure or burial of human remains in the Neolithic period prior to secondary burial elsewhere."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70090> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69999> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "MORTUARY HOUSE"@en ;
    skos:scopeNote "Timber or stone built structure, traces of which are found within some long and round barrows, in which human remains were interred prior to mound construction."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70091> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69999> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "OSSUARY"@en ;
    skos:scopeNote "A building, site or container used to store the bones of the dead after they have been removed from graves to allow new burials."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70093> a skos:Concept ;
    skos:altLabel "Cadaver Tomb"@en,
        "Tomb Chest"@en ;
