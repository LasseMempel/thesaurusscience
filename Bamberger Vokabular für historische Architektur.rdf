    <!-- https://hist-arch-vocab.org/bvha#c_jquheldj -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_jquheldj">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1f0a3ce6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_2607d677"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-25T13:02:02.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T14:41:39.000</terms:modified>
        <skos:definition xml:lang="de">Urspr. identisch mit Architekt, im MA unterschieden als der die Bauerstellung leitende und auf der Baustelle mitarbeitende magister operis (Maurer, Steinmetz) im Unterschied zu dem mehr theoret. die Ikonologie des Bauwerks bestimmenden Architekten (Bauherr). Seit dem 19. Jh. hauptsächl. für den Bauleiter und Bauunternehmer verwendet, der eine Baufachschule besucht hat. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Baumeister</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_k1vkpmvw -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_k1vkpmvw">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_8b190e59"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_1408fe35"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_3d5a6c23"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_48aaf862"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_6cd8e8d8"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_790c912f"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_80695e85"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_8c34bd82"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_8fbc02e1"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_9b45ab52"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_a832bfbe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_b3f740e6"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_d0814ef3"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_d26a4890"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_df4a6e11"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_fc82637f"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_24f6ab7f"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-04-10T14:41:35.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-12-01T18:26:45.000</terms:modified>
        <skos:altLabel xml:lang="fr"> (ouvrage de).maçonnerie</skos:altLabel>
        <skos:altLabel xml:lang="fr"> muraillement</skos:altLabel>
        <skos:altLabel xml:lang="it"> muratura</skos:altLabel>
        <skos:altLabel xml:lang="fr"> murrage</skos:altLabel>
        <skos:altLabel xml:lang="en">masonwork</skos:altLabel>
        <skos:definition xml:lang="cs">Konstrukce z přírodního nebo umělého materiálu (kámen, cihla, tvárnice) buď bez pojiva (suché zdivo), nebo s pojivem z hlíny (zdivo na hliněnou maltu), resp. z vápna, trasu (zdivo na vápennou maltu); Antické římské techniky se shrnují pod názvem opus. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Konstruktion aus natürlichen oder künstlichen Steinen entweder ohne Bindemittel (Trocken-Mauerwerk) oder mit Bindemittel aus Lehm (Lehm-Mauerwerk) bzw. Kalk, Trass (Mörtel-Mauerwerk). Die römisch-antiken Techniken werden unter der Bezeichnung Opus zusammengefasst. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Mauerwerk n; lat. opus: massiver Baukörper aus natürlichen oder künstlichen Steinen, die mit Bindemittel (Kalk, Traß, Zement, Lehm etc.) oder ohne Bindemittel aufeinandergeschichtet sind. Je nach Art und Bearbeitung der Steine sowie nach der Versatztechnik wird das Mauerwerk unterschieden. Es kann unverputzt bzw. steinsichtig oder verputzt sein. Die über der Erdgleiche liegenden Teile des Mauerkörpers werden auch als aufgehendes Mauerwerk bezeichnet. [Glossarium Artis]</skos:definition>
        <skos:note xml:lang="de">Eine Konstruktion aus meist rechteckig geformten Bausteinen (Mauersteinen), die aus Feld- oder Bruchstein, aus bearbeitetem  Naturstein oder aus geformten, künstlichen Steinen aus luftgetrocknetem Lehm (Adobe), Ziegel oder Beton bestehen kann. Das Mauerwerk wird meist mit Mörtel und eventuell mit Vergussmörtel und/oder Armierungen zusammengehalten. [EwaGlos]</skos:note>
        <skos:note xml:lang="en">The art and craft of building which creates structures from building blocks (masonry units). Theseblocks can be extracted or manufactured, and include stone (rubble or ashlar), adobe, brick, and concrete. They are also bonded tagether with mortar, and possibly graut and/or reinforcement. [EwaGlos]</skos:note>
        <skos:note xml:lang="de">Unterteilung in 1. Naturstein-M. (Bruchstein-M. = opus italicum; Feldstein-M.; Haustein-M. = opus siliceum [Zyklopen-M., Polygonal-M.]; Quader-M. = opus romanum); 2. Backstein-M.; 3. Stampf- oder Guss-M.; 4. Misch-M. = opus mixtum. [Koch 2009]</skos:note>
        <skos:prefLabel xml:lang="es"> mampostería</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Mauerwerk</skos:prefLabel>
        <skos:prefLabel xml:lang="en">masonry</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">maçonnerie</skos:prefLabel>
        <skos:prefLabel xml:lang="it">opera muraria</skos:prefLabel>
        <skos:prefLabel xml:lang="la">opus</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">zdivo</skos:prefLabel>
    </owl:NamedIndividual>
    


