				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/422" />
				<skos:scopeNote xml:lang="en">A building providing lodgings for police constables.</skos:scopeNote>
