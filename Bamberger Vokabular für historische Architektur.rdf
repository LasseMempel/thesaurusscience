        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-04T09:47:22.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-31T00:16:26.000</terms:modified>
        <skos:definition xml:lang="de">Drolerie, (frz. drole: scherzhaft) im MA eine in dekorativem Zusammenhang benutzte, groteskphantast. oder satir. Darstellung wie z.B. von Gauklern, Spielern, Narren, Musikanten, Tieren, Fabel- und Mischwesen, einzeln oder zu Gruppen, bes. an roman. und got. Kapitellen, Konsolen und Schlusssteinen sowie bes. an den Miserikordien der got. Chorgestühle. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Drôlerie</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">drolerie</skos:prefLabel>
    </owl:NamedIndividual>
    


