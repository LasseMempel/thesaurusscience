	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004245">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Valetudinarium</skos:prefLabel>
		<skos:prefLabel xml:lang="en">valetudinarium</skos:prefLabel>
		<skos:altLabel xml:lang="de">valetudinarium</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000945"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk021208"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010147"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010148"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010526"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019909"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000945"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk021208"/>
		<skos:definition xml:lang="de">Ein Valetudinarium ist ein Lazarett, das Bestandteil eines römischen Lagers ist, bei dem sich in der Regel eine oder zwei Reihen von Krankenzimmern, die durch Gänge verbunden sind, um einen Innenhof gruppieren und in dem sich separate Behandlungsräume, Verwaltungsräume oder Lager befinden können.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000945"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010147"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010148"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010526"/>
