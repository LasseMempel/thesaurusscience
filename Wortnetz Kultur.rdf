		<skos:prefLabel xml:lang="de">Gießpfanne</skos:prefLabel>
		<skos:altLabel xml:lang="de">Gießpfannen</skos:altLabel>
		<skos:altLabel xml:lang="en">hot metal ladle</skos:altLabel>
		<skos:altLabel xml:lang="en">hot metal ladles</skos:altLabel>
