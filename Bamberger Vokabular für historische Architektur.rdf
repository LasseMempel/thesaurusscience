        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-11T21:08:13.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-08T15:02:27.000</terms:modified>
        <skos:altLabel xml:lang="de">Sinterhaut</skos:altLabel>
        <skos:note xml:lang="en">A thin film of calcium carbonate which forms on lime water or on a lime plaster surface as a result of the reaction of carbon dioxide from the air with calcium hydroxide (carbonation). [EwaGlos]</skos:note>
        <skos:note xml:lang="de">Eine dünne, feinkristalline Schicht aus Calciumcarbonat, die auf Kalkwasser oder auf einer Kalkputzoberfläche gebildet wird – als Ergebnis der Reaktion von Kohlendioxid aus der Luft mit Calciumhydroxid (Karbonatisierung). [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="de">Kalksinterhaut</skos:prefLabel>
        <skos:prefLabel xml:lang="en">calcite crust</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">povlak uhličitanu vápenatého</skos:prefLabel>
    </owl:NamedIndividual>
    


