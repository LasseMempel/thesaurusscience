	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk015036">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Apfelschäler</skos:prefLabel>
		<skos:altLabel xml:lang="de">Apfelschälmaschine</skos:altLabel>
		<skos:altLabel xml:lang="de">Apfelschälmaschinen</skos:altLabel>
		<skos:prefLabel xml:lang="en">apple parer</skos:prefLabel>
		<skos:altLabel xml:lang="en">apple parers</skos:altLabel>
		<skos:altLabel xml:lang="en">apple peeler</skos:altLabel>
		<skos:altLabel xml:lang="en">apple peelers</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk008385"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013697"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk008385"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk011046"/>
		<xe:explanation_temp xml:lang="de">Der Apfelschäler ist eine Vorrichtung aus Metall oder Kunststoff. Es handelt sich in der Regel um eine Art waagerecht montierte Kurbel, auf die der Apfel aufgesteckt und mit der er gleichmäßig gedreht werden kann. Unterhalb der Kurbel befindet sich eine abgewinkelte, in Richtung Kurbel ausgerichtete Klinge, die beim Drehen des Apfels unter dessen Schale dringt und ihn von ihr befreit. Manche Apfelschäler oder Apfelschälmaschinen sind speziell dafür konzipiert, gleichzeitig durch weitere angeordnete Klingen, den Apfel spiralförmig in Scheiben und/oder Ringe zu schneiden und ihn dabei zu entkernen.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Apfelschäler ist eine Schälmaschine, die dem zeitgleichen Schälen, Entkernen und Zerschneiden von Äpfeln dient.</skos:definition>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300199911"/>
		<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q14913"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk013697"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk008385"/>
		<xe:status>approved</xe:status>
		<iso-thes:status>Approved</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
