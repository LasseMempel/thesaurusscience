		<skos:altLabel xml:lang="de">Muschelkrebs</skos:altLabel>
		<skos:altLabel xml:lang="de">Muschelkrebse</skos:altLabel>
		<skos:prefLabel xml:lang="mul">Ostracoda</skos:prefLabel>
		<skos:altLabel xml:lang="de">Ostracoden</skos:altLabel>
		<skos:prefLabel xml:lang="de">Ostrakode</skos:prefLabel>
		<skos:altLabel xml:lang="de">Ostrakoden</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk021305"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk021305"/>
		<skos:definition xml:lang="de">Ein Ostrakode ist ein kleines Krebstier mit einem zweiklappigen Gehäuse. Ostrakoden bewohnen fast alle aquatischen Biotope und sind in der Paläontologie wichtige Leitfossilien.</skos:definition>
