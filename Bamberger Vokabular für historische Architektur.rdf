        <skos:prefLabel xml:lang="de">Hängesiegel</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_44b9e167 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_44b9e167">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_10840daa"/>
