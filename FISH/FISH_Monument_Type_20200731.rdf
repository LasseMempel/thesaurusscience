    <skos:scopeNote xml:lang="en">A works site making and/or maintaining drive belts for industrial power.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/100008">
