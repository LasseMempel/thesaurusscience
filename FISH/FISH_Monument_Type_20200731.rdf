  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162722">
    <skos:scopeNote xml:lang="en">Traditionally an amber-coloured globe lamp atop a tall black and white pole, acting as a signal to road users that there is a pedestrian crossing. Modern beacons may also include an outer ring of flashing LED lights.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70247">
    <skos:scopeNote xml:lang="en">A place where railway trains regularly stop for taking up and setting down passengers or for receiving goods for transport.</skos:scopeNote>
