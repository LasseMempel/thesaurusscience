    skos:closeMatch <http://data.uba.de/umt/_00017791>,
        <http://dbpedia.org/resource/Rodent> ;
    skos:definition "Any of the relatively small placental mammals that constitute the order Rodentia, having constantly growing incisor teeth specialized for gnawing."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/5874> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Nagetier"@de,
