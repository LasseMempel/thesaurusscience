    skos:definition "The ability of a substance to form a solution with another substance."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_7233> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
