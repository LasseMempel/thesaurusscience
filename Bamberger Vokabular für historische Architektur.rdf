    <!-- https://hist-arch-vocab.org/bvha#c_3b7582b1 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_3b7582b1">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a2025113"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_d03664eb"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-08-17T17:26:52.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T13:33:00.000</terms:modified>
        <skos:altLabel xml:lang="de">Minar</skos:altLabel>
        <skos:definition xml:lang="de">Gebetsturm der Moschee. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Minar, Minarett (arab. manara: Leuchtturm), Turm für den Gebetsrufer (Muezzin) einer Moschee. In Nordafrika und Spanien ist das M. meist ein quadrat. Turm mit reicher Ornamentdekoration und schlankem Aufsatz (Migalet). In der ind.-islam. Baukunst finden wir Bündelpfeilern ähnl. M.e, in der türk. nadelschlanke Türme, die nur eine oder zwei Wendeltreppen enthalten, die zu einem oder mehreren Umgängen führt. Gewöhnl. hat eine Moschee ein M., doch haben bdeutendere Anlagen zwei, vier oder sechs M.e. Nur das Heiligtum in Mekka hat sieben M.e. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Minarett</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">minar</skos:prefLabel>
        <skos:prefLabel xml:lang="ca">minaret</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">minaret</skos:prefLabel>
        <skos:prefLabel xml:lang="en">minaret</skos:prefLabel>
        <skos:prefLabel xml:lang="es">minarete</skos:prefLabel>
        <skos:prefLabel xml:lang="it">minareto</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_a2025113"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_3b768083 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_3b768083">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_6768e926"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_klbrisjd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_1ddc5f4c"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_2bcfd130"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_93611457"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_96306b6f"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_b9d3b3f4"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_d64a4389"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-16T14:22:25.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T23:25:24.000</terms:modified>
        <skos:altLabel xml:lang="en">lattice</skos:altLabel>
        <skos:altLabel xml:lang="fr">treillis</skos:altLabel>
        <skos:definition xml:lang="de">Stabwerk aus Holz-, Eisen- oder Bronze-Stäben, die in einer Fläche liegen und sich entweder überkreuzen oder nebeneinander angeordnet sind. Gitter dienen als licht- und luftdurchlässige Abschlüsse vor Tür- und Fensteröffnungen, als Einfriedungen und Brüstungen. Die Form der Gitterstäbe ist mannigfaltig,besonders bei Schmiedeeisen-Gittern; Grundform sind Flach-, Rund- oder Vierkantstäbe. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Gitter</skos:prefLabel>
        <skos:prefLabel xml:lang="es">enrejado</skos:prefLabel>
        <skos:prefLabel xml:lang="en">grate</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">grille</skos:prefLabel>
        <skos:prefLabel xml:lang="it">inferriata</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">mřížka</skos:prefLabel>
    </owl:NamedIndividual>
    


