        <skos:altLabel xml:lang="fr">anneau pastoral</skos:altLabel>
        <skos:altLabel xml:lang="la">anulus caeremonialis</skos:altLabel>
        <skos:altLabel xml:lang="la">anulus pastoralis</skos:altLabel>
        <skos:definition xml:lang="de">Bischofsring m; Pastoralring m; lat. anulus episcopalis; anulus pastoralis; anulus caeremoniaIis: ein goldener Ring mit Edelsteinen, ein liturgisches Insigne der Bischöfe, Kardinäle und apostolischen Pronotare. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Bischofsring</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Bishop\&apos;s ring</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">anneau épiscopal</skos:prefLabel>
        <skos:prefLabel xml:lang="la">anulus episcopalis</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">biskupský prsten</skos:prefLabel>
    </owl:NamedIndividual>
    


