		<skos:altLabel xml:lang="de">Mesozoisch</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk001266"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk001266"/>
		<skos:definition xml:lang="de">Das Mesozoikum ist eine geochronologische Ära der Erdgeschichte, die vor etwa 251,902 Millionen Jahren begann und vor etwa 66 Millionen Jahren endete. Sie ist die mittlere Ära des Phanerozoikums und umfasst die Perioden Trias, Jura und Kreide.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/page/aat/300391255"/>
