        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-21T15:43:56.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T13:33:09.000</terms:modified>
        <skos:definition xml:lang="de">Runder oder polygonaler Turm an der nördl. und südl. Stirnmauer des Querhauses. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="es"> torre de crucero</skos:prefLabel>
        <skos:prefLabel xml:lang="fr"> tour de transept</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Querhausturm</skos:prefLabel>
        <skos:prefLabel xml:lang="it">torre del transetto</skos:prefLabel>
        <skos:prefLabel xml:lang="en">transept tower</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_79454feb -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_79454feb">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_00e86b9d"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_cc7a1644"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_2b8c8e23"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-09T17:57:38.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T23:01:05.000</terms:modified>
        <skos:altLabel xml:lang="de">Hermenpfeiler</skos:altLabel>
        <skos:definition xml:lang="de">Herme (gr.), Bildwerk mit dem Kopf urspr. des Gottes Hermes oder auch dem ganzen Oberkörper, der sich nach unten in einen verjüngten Pfeiler fortsetzt. H.spfeiler wurden bes. in der Barockzeit gerne als figürl. Gebälkträger verwendet. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Obwohl eigentlich eine antike Freiplastik (Hermeskopf auf rechteckigem Schaft), nennt man seit der Renaissance auch eine atlasähnliche Halbfigur vor Preilern oder Pilastern Herme. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Původně antická volná plastika (Hermova hlava na obdélníkovém sloupku, od dob renesance však polofigura podobná atlantovi před pilíři nebo pilastry. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Herme</skos:prefLabel>
        <skos:prefLabel xml:lang="it">erma</skos:prefLabel>
        <skos:prefLabel xml:lang="en">herm</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">herma</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_00e86b9d"/>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_cc7a1644"/>
    </owl:NamedIndividual>
    


