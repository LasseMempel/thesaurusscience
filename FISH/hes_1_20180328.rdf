		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/503185" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/931" />
		<skos:scopeNote xml:lang="en">A place where ropes are made.</skos:scopeNote>
