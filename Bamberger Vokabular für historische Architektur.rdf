    <!-- https://hist-arch-vocab.org/bvha#c_2936911c -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_2936911c">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_59a72838"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-04-05T07:32:05.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T18:07:18.000</terms:modified>
        <skos:altLabel xml:lang="fr">courbe rampante</skos:altLabel>
        <skos:prefLabel xml:lang="de">Wange (Treppe)</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">bočnice (schody)</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">limon</skos:prefLabel>
        <skos:prefLabel xml:lang="en">stringer</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Im Gegensatz zu Holmen, auf denen z.B. die Keilstufen der Balkentreppe aufliegen, befinden sich die Wangen mit zumeist hochrechteckigem Querschnitt und geringerer Stärke seitlich an den Stufen. Zwischengewendelte Holztreppen, die im 18. Jahrhundert beliebt werden setzen in der Regel die Herstellung gebogener Wangen voraus. Bei historischen Treppen mit eingeschobenen Trittstufen sind die Wangen zwischen den Tritten häufig verziert.</skos:scopeNote>
    </owl:NamedIndividual>
    


