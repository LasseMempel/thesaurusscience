				<skos:prefLabel xml:lang="gd">GLASACH-TODHAIR</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Achadh mòr no clobhsa far a bheilear a' cur aodach ris a' ghrian gus a ghealachadh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">BLEACHFIELD</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
