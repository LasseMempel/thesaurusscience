    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Hurst"@en ;
    skos:scopeNote "The large wooden framework that supports the grinding wheels in a corn mill."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/139598> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/138386> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Poncelet Waterwheel"@en ;
    skos:scopeNote "An undershot waterwheel, developed by General Jean Victor Poncelet (1788-1867) in France, which improved efficiency through the replacement of flat, wooden paddles with curved, metal vanes."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/139603> a skos:Concept ;
