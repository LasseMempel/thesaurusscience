        <skos:altLabel xml:lang="cs">buben</skos:altLabel>
        <skos:definition xml:lang="cs">Mezi pendentivy (příp. trampy) a kupolí se často nachází válcovitý (příp. osmiboký) tambur (buben), který může být prolomen okny. [Koch 2008] </skos:definition>
        <skos:definition xml:lang="de">Torschanze, Sperrbefestigungaus Palisaden mit Schießlöchern, häufig vorhofartig vor einem Tor, Vorläufer der Barbakane. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Tambour (Wehranlage)</skos:prefLabel>
        <skos:prefLabel xml:lang="es">tambor</skos:prefLabel>
        <skos:prefLabel xml:lang="en">tambour</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">tambour</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">tambur</skos:prefLabel>
        <skos:prefLabel xml:lang="it">tamburo</skos:prefLabel>
    </owl:NamedIndividual>
    


