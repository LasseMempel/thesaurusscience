        <skos:altLabel xml:lang="es">capilla mortuoria</skos:altLabel>
        <skos:altLabel xml:lang="it">cappella mortuaria</skos:altLabel>
        <skos:altLabel xml:lang="it">cappella sepolcrale</skos:altLabel>
