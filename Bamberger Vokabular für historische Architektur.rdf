        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T01:35:59.000</terms:modified>
        <skos:definition xml:lang="de">&quot;Kleiner, fein ausgestatteter Schreib- und Studierraum mit Wand- und Deckendekorationen und Wandgemälden als Hauptschmuck, aber auch mit Skulpturen. Im 16. Jh. ging das S. zum Sammlungsraum über und damit endete seine Bedeutung für Westeuropa.&quot; [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Studiolo</skos:prefLabel>
        <skos:prefLabel xml:lang="es">pequeno estudio</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">studiolo</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">studiolo</skos:prefLabel>
        <skos:prefLabel xml:lang="it">studiolo</skos:prefLabel>
    </owl:NamedIndividual>
    


