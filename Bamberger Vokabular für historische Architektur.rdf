        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T15:58:56.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T16:01:31.000</terms:modified>
        <skos:definition xml:lang="de">Ausgleichende waagerechte Zwischenschicht im Bruchsteinmauerwerk, das bei größerer Höhe mehrere A.en haben kann, um waagerechte Flächen für das Weitermauern zu gewinnen. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Ausgleichsschicht (Zwischenschicht)</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_13bb8440 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_13bb8440">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0552ce14"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-25T12:48:26.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T13:03:02.000</terms:modified>
        <skos:altLabel xml:lang="de">parascenion</skos:altLabel>
        <skos:altLabel xml:lang="de">parascenium</skos:altLabel>
        <skos:definition xml:lang="de">hinterer Teil der Bühne im gr. Theaterbau, auch die Seitentüren der Bühnenrückwand (Skene) oder die Eingänge in die Orchestra rechts und links unmittelbar vor der Bühne, damit im röm.Theaterbau zugleich die seitl. Begrenzung der Bühne. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Paraskene</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_13ca858d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_13ca858d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b4d4b9c7"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_0ad04967"/>
