        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_8b52c299"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_b76cb227"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_bbbf2b23"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_e931f61e"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-27T17:22:55.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T23:13:33.000</terms:modified>
        <skos:altLabel xml:lang="fr">objets de dévotion</skos:altLabel>
        <skos:definition xml:lang="de">Devotionalien f pl: Gegenstände für die private religiöse Andacht, auch Erinnerungsstücke an Wallfahrten und Objekte, die als Votivgaben an WalIfahrtsorte gebracht werden. Man schreibt ihnen gelegentlich heilende und schützende Wirkung zu. Devotionalien gehören vornehmlich der volkstümlichen Kleinkunst an, manchmal werden sie auch mit besonderer kirchlicher Erlaubnis hergestellt und sind mit Ablässen verbunden. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Devotionalie</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">devocionálie</skos:prefLabel>
        <skos:prefLabel xml:lang="en">objects of devotion</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">objets de piété</skos:prefLabel>
    </owl:NamedIndividual>
    


