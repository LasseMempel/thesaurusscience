    <!-- https://hist-arch-vocab.org/bvha#c_dee2aeac -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_dee2aeac">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_bb055578"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_3617bdab"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-16T16:10:35.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T12:01:23.000</terms:modified>
        <skos:altLabel xml:lang="en">frieze of round arches</skos:altLabel>
        <skos:altLabel xml:lang="fr">frise en arceaux</skos:altLabel>
        <skos:altLabel xml:lang="fr">frise en arquée</skos:altLabel>
        <skos:altLabel xml:lang="en">round arch frieze</skos:altLabel>
        <skos:definition xml:lang="de">Fries aus kleinen, aneinandergereihten Rundbogen, die auch von Konsolen getragen werden können. R.e kommen v. a. an Gesimsen roman. Bauten vor, als Rahmung von Wandflächen zwischen Lisenen, auch als steigender R. unter Giebelschrägen. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Reihe von kurzen Rundbögen, die vor die Wand gesetzt sind. Die Bögen können schlicht gereiht auftreten oder auf kleine Konsolen gesetzt sein. Während im Sakralbau der R. auf das 12. und frühe 13. Jh. beschränkt blieb und nur höchst selten konstruktiv verwendet wurde, sind an Burgen auch noch im späten 13. und 14. Jh. R.e zu finden. Sie werden zudem zur Abstützung von Wehrgängen oder Holz- oder Fachwerkaufbauten auch konstruktiv, d. h. tragend eingesetzt (Burg Eltz RP), Fries; Bogenfries. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:definition xml:lang="de">Romanisches Ornament. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="en"> blind arcade</skos:prefLabel>
        <skos:prefLabel xml:lang="it"> fregio ad archetti</skos:prefLabel>
        <skos:prefLabel xml:lang="es"> friso arqueado</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Rundbogenfries</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">frise d\&apos;arceaux en plein cintre</skos:prefLabel>
    </owl:NamedIndividual>
    


