        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_a51d7614"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_b38ea946"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_c24d1af6"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_c62f0759"/>
