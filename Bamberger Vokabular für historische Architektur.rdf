        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_be3a4ea7"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-07T10:05:10.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T23:12:42.000</terms:modified>
        <skos:definition xml:lang="de">Kreuz unter dem Triumphbogen einer Kirche (Triumphbogen 2), das aufgehängt sein, jedoch auch auf einem Triumphbalken stehen kann. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Triumphkreuz</skos:prefLabel>
        <skos:prefLabel xml:lang="it">crocifisso sotto l\&apos;arco trionfale</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">croix triomphale</skos:prefLabel>
        <skos:prefLabel xml:lang="es">crucifijo bajo el arco de triunfo</skos:prefLabel>
        <skos:prefLabel xml:lang="la">crux triumphalis</skos:prefLabel>
        <skos:prefLabel xml:lang="en">rood cross</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_f4435c09 -->


