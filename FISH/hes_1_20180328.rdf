				<skos:altLabel xml:lang="en">TEXTILE PRINTWORKS</skos:altLabel>
				<skos:altLabel xml:lang="en">PRINT WORKS</skos:altLabel>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1318" />
				<skos:scopeNote xml:lang="en">A site where textiles are printed. For paper printing use PRINTING WORKS.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
