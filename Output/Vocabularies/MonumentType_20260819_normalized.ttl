    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "TOMBSTONE"@en ;
    skos:scopeNote "A horizontal stone placed across a grave."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70097> a skos:Concept ;
    skos:altLabel "Mount Pleasant Enclosure"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70096> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "HENGE ENCLOSURE"@en ;
    skos:scopeNote "A late Neolithic/Early Bronze Age earthwork enclosure distinguished from a henge primarily by its larger size, irregular shape, and greater complexity of internal features."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70098> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70096> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "HENGIFORM MONUMENT"@en ;
    skos:scopeNote "A small, circular Late Neolithic/Early Bronze Age enclosure which bears a morphological resemblance to henges, but may belong to another category of circular earthwork-defined monuments, or is enclosed by something other than a bank and ditch."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70099> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99962> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "HERMITAGE (RELIGIOUS)"@en ;
    skos:scopeNote "A small hut, dwelling or cave, usually in a secluded spot, in which a hermit lived. Hermits chose to live solitary lives often due to religious motives."@en .

