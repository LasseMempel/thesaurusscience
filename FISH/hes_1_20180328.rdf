	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/402">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/402</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TRAINNSE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Cladach fada caol a thathar a' cleachdadh gus rud a chur am falach no a dhìon no airson pìoban no rudan eile a chur san talamh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TRENCH</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/403" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/278" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1442" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/506381">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/506381</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">SLOC SHAIGHDEARAN</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Trainnse bheag a tha, mar is trice, do dhithis no triùir agus a chaidh a chladhach mar ionad dìon leis fhèin seach mar phàirt de rian dìonach. Structar às an dà Chogadh Mòr.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">WEAPONS PIT</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-12-20T16:09:32</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-12-20T16:10:17</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:altLabel xml:lang="en">WEAPONS SLIT</skos:altLabel>
				<skos:altLabel xml:lang="en">FOXHOLE</skos:altLabel>
				<skos:altLabel xml:lang="en">FOX HOLE</skos:altLabel>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/402" />
				<skos:scopeNote xml:lang="en">Usually a small, two or three man trench, dug as an isolated fieldwork rather than as part of a defensive system. A WWI and WWII feature.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/317" />
		<skos:scopeNote xml:lang="en">A long, narrow excavation used as a means of concealment or protection, or to insert pipes or other features into the ground.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/403">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/403</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TRAINNSE CHUMHANG</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Trainnse ghoirid a tha a' dìon feachdan no a thilgear urchraichean uaithe mar dhìon do chompanaich, air an cladhach mar eacarsaich gu tric.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SLIT TRENCH</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/402" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/336" />
		<skos:scopeNote xml:lang="en">A short trench used to protect troops or to provide defensive fire from, often dug for practice purposes.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/405">
