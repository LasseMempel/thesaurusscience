	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk003640">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Beghine</skos:altLabel>
		<skos:altLabel xml:lang="de">Beghinen</skos:altLabel>
		<skos:altLabel xml:lang="de">Begine</skos:altLabel>
		<skos:prefLabel xml:lang="de">Beginen</skos:prefLabel>
		<skos:prefLabel xml:lang="en">Beguines</skos:prefLabel>
		<skos:altLabel xml:lang="en">Beguins</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk002207"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010287"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019844"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk002207"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk003209"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk003678"/>
		<skos:definition xml:lang="de">Die Beginen sind eine Kongregation, die im 13. Jahrhundert entstanden ist und deren weibliche Mitglieder als christliche Glaubensgemeinschaft abgeschieden und ordensähnlich zusammen leben, da sie als Laien jedoch nur einfache Gelübde ablegen, nicht zu den anerkannten Ordensgemeinschaften gezählt werden.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002207"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010287"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019844"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-12-07T19:05:42+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk003641">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Eremitage</skos:prefLabel>
		<skos:altLabel xml:lang="de">Eremitagen</skos:altLabel>
		<skos:prefLabel xml:lang="en">hermitage (garden)</skos:prefLabel>
		<skos:altLabel xml:lang="en">hermitages</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk002208"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk002231"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk014674"/>
		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk002617"/>
		<gvp:aat2801_conjuncted_with rdf:resource="http://lvr.vocnet.org/wnk/wk001439"/>
		<xe:explanation_temp xml:lang="de">Die Spannweite reichte vom kapellen- oder höhlenartigen Bau - gelegentlich auch mit einem angestellten &amp;quot;Eremiten&amp;quot; besetzt - bis zum abseits gelegenen Schloss als Ort für höfische, das Landleben nachspielende Feste.</xe:explanation_temp>
		<skos:definition xml:lang="de">Eine Eremitage ist ein Gebäude, das seit dem Mittelalter Bestandteil fürstlicher Gärten und ursprünglich dem religiösen Rückzug dienen und später auch Raum für Einsamkeit und Naturverbundenheit bieten sollte. Seit dem 17. und 18. Jahrhundert tritt der religiöse Anspruch zugunsten der Funktion als Kulisse für höfische Feste in den Hintergrund.</skos:definition>
		<skos:scopeNote xml:lang="de">Benutzt für das Gebäude, das Element der Gartenkunst sein kann; für den Ort des ausschließlich religiös motivierten Rückzugs siehe Einsiedelei (wk002617).</skos:scopeNote>
		<skos:exactMatch rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159185"/>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4354208-6"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk014674"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002231"/>
		<xe:status>approved</xe:status>
		<iso-thes:status>Approved</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
