    <!-- https://hist-arch-vocab.org/bvha#c_dc8fc75b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_dc8fc75b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
