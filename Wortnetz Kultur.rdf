	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk015197">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Blätterteig</skos:prefLabel>
		<skos:altLabel xml:lang="de">Blätterteige</skos:altLabel>
		<skos:altLabel xml:lang="de">Feuilletage</skos:altLabel>
