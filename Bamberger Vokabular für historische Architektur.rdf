    <!-- https://hist-arch-vocab.org/bvha#c_6a0e9676 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_6a0e9676">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_7860420e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_f10222e0"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_a0a4566f"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_d4ca725f"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-14T11:44:20.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-03T15:30:16.000</terms:modified>
        <skos:altLabel xml:lang="de">Kröneleisen</skos:altLabel>
        <skos:altLabel xml:lang="fr">brette</skos:altLabel>
        <skos:altLabel xml:lang="fr">bretture</skos:altLabel>
        <skos:altLabel xml:lang="en">tooth axe</skos:altLabel>
        <skos:definition xml:lang="de">Der Krönel kann als eine Weiterentwicklung der Zahnflächegesehen werden. Durch sein hohes Gewicht von bis zu über 5 kg und einer Schneidebreite von etwa 8 cm [...] ist er aber wesentlich effektiver im Abtragen von Material. Die Spitzen sind meist sehr schlank ausgeschmiedet.Heute werden etwa 14 - 20 Einzelspitzen in einerlänglichen Öffnung verkeilt. [...] Als Besonderheit hat der Kröne! einen Griff aus Eisen,[...]. Die etwas gröbere Variante mit dickeren, etwa 10 - 12 Einzelspitzen nennt man heute Spitzer. [Voelkle 2016]</skos:definition>
        <skos:definition xml:lang="de">Hammerartiges Werkzeug mit gezähnten Bahnen zur Feinbearbeitung weicher Steine. [Glossarium Artis, Bd. 3, Bögen und Mauerwerk]</skos:definition>
        <skos:prefLabel xml:lang="de">Krönel</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">marteau bretté</skos:prefLabel>
        <skos:prefLabel xml:lang="en">roughing hammer</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">zrnovák</skos:prefLabel>
    </owl:NamedIndividual>
    


