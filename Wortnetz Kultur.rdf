	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk019957">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Tröte</skos:prefLabel>
		<skos:altLabel xml:lang="de">Tröten</skos:altLabel>
		<skos:altLabel xml:lang="de">Tute</skos:altLabel>
		<skos:altLabel xml:lang="de">Tuten</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003473"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013598"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk003473"/>
		<skos:definition xml:lang="de">Eine Tröte ist ein einfaches Blasinstrument, das einen trompetenartigen Klang hat. Dabei sind nur Naturtöne möglich, das heißt, die Tonhöhe kann nicht variiert werden, da das Instrument meist nur aus einem tütenartig geformten Element besteht. Dabei kann es sich beispielsweise um ein Tierhorn handeln, aber auch um entsprechend geformtes Papier, Kunststoff oder Blech. Eine Tröte dienst meist als Kinderinstrument, Signalinstrument oder zur Lärmerzeugung bei bestimmten Veranstaltungen.</skos:definition>
		<skos:closeMatch rdf:resource="http://obg.vocnet.org/lb000034"/>
