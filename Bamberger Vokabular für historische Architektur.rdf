    <!-- https://hist-arch-vocab.org/bvha#c_2a679dcf -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_2a679dcf">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_d9ade06c"/>
