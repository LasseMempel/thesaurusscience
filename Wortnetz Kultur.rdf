	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021074">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Brenneisen (Brennschere)</skos:altLabel>
		<skos:prefLabel xml:lang="de">Brennschere</skos:prefLabel>
		<skos:altLabel xml:lang="de">Brennscheren</skos:altLabel>
		<skos:altLabel xml:lang="de">Brennzange</skos:altLabel>
		<skos:prefLabel xml:lang="en">curling tongs</skos:prefLabel>
		<skos:altLabel xml:lang="en">hair iron</skos:altLabel>
		<skos:altLabel xml:lang="en">hair irons</skos:altLabel>
		<skos:altLabel xml:lang="de">Tolleisen</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk021078"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk021078"/>
		<crm:P120 rdf:resource="http://lvr.vocnet.org/wnk/wk021239"/>
		<skos:definition xml:lang="de">Eine Brennschere ist ein historisches Gerät zum Ondulieren der Haare. Das scherenähnliche Werkzeug aus Metall besitzt einen Arm mit mindestens einem rundem Stab und einen Arm mit passendem Gegenstück mit U-Profil, die ineinandergreifen. Für die Anwendung wurden die Arme erhitzt und das Haar darin so eingeklemmt, dass in ihm Wellen entstanden.</skos:definition>
		<skos:broadMatch rdf:resource="http://vocab.getty.edu/aat/300426864"/>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4679545-5"/>
		<skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q1424150"/>
