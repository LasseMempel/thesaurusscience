        <skos:altLabel xml:lang="de">Comes</skos:altLabel>
        <skos:altLabel xml:lang="de">Lektionarium</skos:altLabel>
        <skos:altLabel xml:lang="la">lectionarius liber</skos:altLabel>
        <skos:altLabel xml:lang="la">liber comicus</skos:altLabel>
        <skos:altLabel xml:lang="la">liber comitis</skos:altLabel>
        <skos:definition xml:lang="de">Lektionar n, Lektionarium n, veraltet Comes m, lectionarium, lectionarius liber, liber comitis, liber comicus: Buch mit sämtlichen Schriftlesungen (-&gt; Perikope) für die Messe in der Ordnung des Kirchenjahres; im Mittelalter enthielt der Comes oft nur die Anfangsworte der Lesungen. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Lektionar</skos:prefLabel>
        <skos:prefLabel xml:lang="la">lectionarium</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">lectionnaire</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">lekcionář</skos:prefLabel>
    </owl:NamedIndividual>
    


