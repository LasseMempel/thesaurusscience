<http://purl.org/heritagedata/schemes/eh_evd/concepts/97293> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/82790> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Implied Evidence"@en ;
    skos:scopeNote "Not to be used for indexing. Broad term to assist retreival of all monuments where nonphysical evidence is recorded."@en .

