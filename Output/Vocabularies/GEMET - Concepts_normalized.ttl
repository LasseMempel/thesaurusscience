<http://www.eionet.europa.eu/gemet/concept/7846> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/397> ;
    skos:closeMatch <http://data.uba.de/umt/_00005436> ;
    skos:definition "The use of rapid chemical analyses to determine the fertility status of a soil. It is used to identify those nutrients or substances that are present in either insufficient or excessive quantities for optimum plant growth. Analyses are also used to monitor increases or decreases in soil fertility over time."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_7198>,
        <http://eurovoc.europa.eu/6381> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bodenuntersuchung"@de,
        "soil analysis"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/4948>,
        <http://www.eionet.europa.eu/gemet/concept/7843> ;
    skos:relatedMatch <http://dbpedia.org/resource/Soil_test> .

<http://www.eionet.europa.eu/gemet/concept/7857> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13236>,
        <http://www.eionet.europa.eu/gemet/concept/15214> ;
    skos:closeMatch <http://data.uba.de/umt/_00005324> ;
    skos:definition "Soil may deteriorate either by physical movement of soil particles from a given site or by depletion of the water-soluble elements in the soil which contribute to the nourishment of crop, plants, grasses, trees, and other economically usable vegetation. The physical movement generally is referred to as erosion. Wind, water, glacial ice, animals and tools in use may be agents of erosion."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_7168> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bodendegradation"@de,
        "soil degradation"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/7855> ;
    skos:relatedMatch <http://dbpedia.org/resource/Soil_retrogression_and_degradation> .

<http://www.eionet.europa.eu/gemet/concept/7858> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7881> ;
    skos:definition "Detachment and movement of topsoil or soil material from the upper part of the profile, by the action of wind or running water, especially as a result of changes brought about by human activity, such as unsuitable or mismanaged agriculture."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bodenerosion"@de,
        "soil erosion"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/2963>,
        <http://www.eionet.europa.eu/gemet/concept/2964> ;
    skos:relatedMatch <http://dbpedia.org/resource/Erosion> .

<http://www.eionet.europa.eu/gemet/concept/7897> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:closeMatch <http://data.uba.de/umt/_00005452> ;
    skos:definition "Any activity or process in which ground surface areas are packed or plugged to prevent percolation or the passage of fluids."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bodenversiegelung"@de,
        "soil surface sealing"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15286>,
        <http://www.eionet.europa.eu/gemet/concept/7516> .

<http://www.eionet.europa.eu/gemet/concept/7905> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:closeMatch <http://data.uba.de/umt/_00022675>,
        <http://dbpedia.org/resource/Solar_collector> ;
    skos:definition "Device which converts the energy from light into electricity. The collector system contains a concentrator and a receiver. The concentrator redirects and focuses sunlight on the receiver by using mirrors or lenses, and the receiver absorbs solar radiation and converts it to heat."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_16042>,
        <http://eurovoc.europa.eu/6031> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Solarkollektor"@de,
        "solar collector"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/7907> .

<http://www.eionet.europa.eu/gemet/concept/7908> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2741> ;
    skos:closeMatch <http://data.uba.de/umt/_00022674> ;
    skos:definition "A domestic or industrial heating system that makes direct use of solar energy. The simplest form consists of a collector through which a fluid is pumped. The circuit also contains some form of heat storage tank and an alternative energy source to provide energy when the sun is not shining. The collector usually consists of a black surface through which water is piped, the black surface being enclosed behind glass sheets to make use of the greenhouse effect."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Solarheizung"@de,
        "solar heating"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/3894>,
        <http://www.eionet.europa.eu/gemet/concept/7906> ;
    skos:relatedMatch <http://dbpedia.org/resource/Solar_water_heating> .

<http://www.eionet.europa.eu/gemet/concept/7912> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2406>,
        <http://www.eionet.europa.eu/gemet/concept/6884> ;
    skos:closeMatch <http://data.uba.de/umt/_00022677> ;
    skos:definition "The electromagnetic radiation and particles emitted by the sun."@en ;
