		<skos:prefLabel xml:lang="de">Hustenbonbon</skos:prefLabel>
		<skos:altLabel xml:lang="de">Hustenbonbons</skos:altLabel>
		<skos:prefLabel xml:lang="en">throat lozenge</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk011109"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013607"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk018430"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk011109"/>
		<skos:definition xml:lang="de">Ein Hustenbonbon ist ein Bonbon, das den Husten, Halsbeschwerden und Rachenbeschwerden lindern soll. Je nach Rezeptur enthalten Hustenbonbons häufig ätherische Öle oder Kräuterextrakte.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk011109"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk013607"/>
