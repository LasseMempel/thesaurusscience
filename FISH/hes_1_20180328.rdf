	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1387">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1387</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">DOCA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Linn fhosgailte fhuadain mun a bheil breigearachd no clachaireachd agus aig a bheil geataichean doca. Tha seo na acarsaid agus airson 's gun urrainnear longan a chàradh ann, na luchdan a thoirt uapa no luchdan a chur orra.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">DOCK</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1024" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1023" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1869" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1384" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500527" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500568">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500568</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">DOCA FLEÒDRAIDH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Structar air fleòd aig a bheil dà bhalla a tha nan seasamh air tancaichean. Gabhaidh uisge a chur sna tancaichean airson soitheach a ghluasad air agus gabhaidh a phumpadh a-mach an uairsin gus am bi an deic agus an soitheach tioram.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">FLOATING DOCK</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-27T13:57:46</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-27T13:58:05</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1387" />
				<skos:scopeNote xml:lang="en">A floating structure consisting of two walls standing on pontoon tanks, the latter of which can be flooded to receive a vessel and then pumped out until the pontoon deck and the ship are dry.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1021" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1406" />
		<skos:scopeNote xml:lang="en">An artificial area of open water, enclosed by masonry and fitted with dock gates in which ships can be repaired, loaded/unloaded or berthed.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1390">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1390</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CALA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Acarsaid fhasgach do longan.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HARBOUR</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
