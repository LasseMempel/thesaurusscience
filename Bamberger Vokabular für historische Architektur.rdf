        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_93b37323"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-28T19:46:10.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T14:45:58.000</terms:modified>
        <skos:altLabel xml:lang="de">Paternoster-Perle</skos:altLabel>
        <skos:altLabel xml:lang="de">Vater-unser-Korn</skos:altLabel>
        <skos:definition xml:lang="de">Vater-unser-Perle f; auch Paternoster-Perle f; Vater-unser-Korn n: eine große Perle am Rosenkranz, die ein Vater-unser anzeigt. Manchmal werden diese Perlen durch Medaillen, sogenannte Schildchen (n pl), ersetzt oder es werden neben den Perlen noch Medaillen eingefügt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="en">Paternoster-bead</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Vater-unser-Perle</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">grain du Pater</skos:prefLabel>
    </owl:NamedIndividual>
    


