        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-04-10T16:23:47.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T19:02:15.000</terms:modified>
        <skos:definition xml:lang="de">Bei Backsteinmauern der in Deutschland neben dem Kreuzverband am weitesten verbreitete Mauer Verband. In den Ansichten wechseln Läufer- und Binderreihen (Läufer, Binder) schichtweise regelmäßig ab. Die Stoßfugen jeder zweiten Schicht liegen senkrecht übereinander. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Blockverband </skos:prefLabel>
        <skos:prefLabel xml:lang="cs">vazba polokřížová</skos:prefLabel>
    </owl:NamedIndividual>
    


