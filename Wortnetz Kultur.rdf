		<crm:P82a_begin_of_the_begin rdf:datatype="http://www.w3.org/TR/xmlschema11-2/#gYear">-491000000</crm:P82a_begin_of_the_begin>
		<crm:P82b_end_of_the_end rdf:datatype="http://www.w3.org/TR/xmlschema11-2/#gYear">-486850000</crm:P82b_end_of_the_end>
