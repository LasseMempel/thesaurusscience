        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-08T17:05:18.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T17:37:26.000</terms:modified>
        <skos:definition xml:lang="en">Crack having the form of a star. Rusting iron ormechanical impact are possible causes of this type of damage. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="de">Die Risse haben das Aussehen von einem Stern. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="fr">Fissure traversant complètement une pierre. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="cs">shluk trhlin ve tvaru hvězdicovitě se rozbíhajících paprsků. [ICOMOS-ISCS]</skos:definition>
        <skos:prefLabel xml:lang="de">Rostsprengung</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">fissuration en étoile</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">hvězdicovitá trhlina</skos:prefLabel>
        <skos:prefLabel xml:lang="en">star crack</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_bae063c7 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_bae063c7">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_4708d89a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-25T09:09:50.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T16:10:46.000</terms:modified>
        <skos:altLabel xml:lang="de">Französisches Fenster</skos:altLabel>
        <skos:definition xml:lang="de">Fenstertür, &gt;frz. Fenster&lt;, eine bes. in Frankreich anzutreffende Zwischenform von Fenster und Tür, ein bis zum Boden oder fast bis zum Boden reichendes, hochrechteckiges Fenster. Liegt die F. in einem Obergeschoss, erhält sie als Brüstung ein meist vor der Fassade liegendes Gitter. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Fenstertür</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_bae4cd11 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_bae4cd11">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b99ef53b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-22T16:49:56.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-01T14:01:57.000</terms:modified>
        <skos:definition xml:lang="de">1. Wasserablaufvorrichtung an Mauervorsprüngen oder Fensterflügeln, Kaffgesims, Wasserschlag. 2. Kleiner Wassergraben oder Kanal als Ablass zur Haus- und Straßenentwässerung. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Abschlag</skos:prefLabel>
    </owl:NamedIndividual>
    


