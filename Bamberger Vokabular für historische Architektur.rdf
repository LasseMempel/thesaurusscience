    <!-- https://hist-arch-vocab.org/bvha#c_0cfd9e60 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_0cfd9e60">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_69367952"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_3c42853f"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_fd2f0212"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-28T17:11:20.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T16:54:49.000</terms:modified>
        <skos:altLabel xml:lang="cs">stupeň</skos:altLabel>
        <skos:definition xml:lang="de">Eine nicht überdeckte, künstl. geebnete, waagerechte Fläche. Auf von der Umgebung abgehobenen T.n wurden assyr. und pers. Paläste und altamerikan. Tempelbauten errichtet. Auch in barocken Gärten spielen T.n eine bedeutende Rolle. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Künstlich eingeebnete und befestigte Fläche um oder vor einem Gebäude, die meist über dem umgebenden Landschaftsniveau liegt. T.n als Mittel der Gestaltung tauchen in Mitteleuropa zuerst im italienischen Villenbau der Renaissance auf (Villa Farnese/Caprarola I, 1547 ff.). Eine besondere Bedeutung hat die T. im Schlossbau der Barockzeit. Mittels einer oder mehrerer T.n wird die Verbindung zwischen Hauptgebäude und dem nach französischen Muster gestalteten Garten hergestellt. Auch hierfür hat Louis Le Vau mit der Gestaltung von Vaux-le-Vicomte F und Versailles F die Grundlagen gelegt. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:prefLabel xml:lang="de">Terrasse</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">terasa</skos:prefLabel>
        <skos:prefLabel xml:lang="en">terrace</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">terrasse</skos:prefLabel>
        <skos:prefLabel xml:lang="es">terraza</skos:prefLabel>
        <skos:prefLabel xml:lang="it">terrazza</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_0cffe5f6 -->


