	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1735">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1735</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">GEATA NAM MARBH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Geata le mullach far a bheilear a' dol a-steach do chill.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">LYCH GATE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1645" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1451" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1653" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1744" />
		<skos:scopeNote xml:lang="en">A covered gateway at the entrance to a churchyard.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
