	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/2/concepts/501145">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/2" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/2/concepts/501145</dcterms:identifier>
		<skos:prefLabel xml:lang="en">AXEHEAD</skos:prefLabel>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:56:41</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/2/concepts/501258" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/2/concepts/501312">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/2" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/2/concepts/501312</dcterms:identifier>
				<skos:prefLabel xml:lang="en">FLANGED AXEHEAD</skos:prefLabel>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:56:41</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/2/concepts/501145" />
				<skos:scopeNote xml:lang="en">A bronze axehead of earlier Bronze Age date the sides of which are raised, either by casting or hammering, to form flanges on both faces which aid hafting. Some types also feature a raised bar or stop between the flanges.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/2/concepts/501314">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/2" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/2/concepts/501314</dcterms:identifier>
				<skos:prefLabel xml:lang="en">FLAT AXEHEAD</skos:prefLabel>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:56:41</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/2/concepts/501145" />
				<skos:scopeNote xml:lang="en">An axehead of early Bronze Age date, made of copper or bronze, which is flat on both sides and generally lacks side flanges or other hafting aids.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/2/concepts/501452">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/2" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/2/concepts/501452</dcterms:identifier>
				<skos:prefLabel xml:lang="en">PALSTAVE</skos:prefLabel>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:56:41</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/2/concepts/501145" />
				<skos:scopeNote xml:lang="en">A bronze axehead of middle or late Bronze Age date in which the side flanges and the bar/stop on both faces are connected, forming a single hafting aid. Some types feature a side loop to further assist hafting.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/2/concepts/501477">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/2" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/2/concepts/501477</dcterms:identifier>
				<skos:prefLabel xml:lang="en">POLISHED AXEHEAD</skos:prefLabel>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:56:41</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/2/concepts/501145" />
				<skos:scopeNote xml:lang="en">An axehead of flint or other stone, commonly used for Neolithic types.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/2/concepts/501534">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/2" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/2/concepts/501534</dcterms:identifier>
				<skos:prefLabel xml:lang="en">SOCKETED AXEHEAD</skos:prefLabel>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:56:41</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/2/concepts/501145" />
				<skos:scopeNote xml:lang="en">A form of axehead where the body is hollow allowing for insertion of the haft. Usually bronze or iron and of late Bronze Age or Iron Age date. Most examples feature a side loop to further assist hafting.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
