    <!-- https://hist-arch-vocab.org/bvha#c_1a13f79c -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_1a13f79c">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_88b4f652"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_19d56a39"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-14T10:10:01.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T18:54:18.000</terms:modified>
        <skos:definition xml:lang="de">Bei einer Überkreuzverbindung werden zwei Hölzer in den horizontalen, vertikalen oder schräg gestellten Ebenen übereinandergeführt. liegen die Hölzer in verschiedenen Ebenen ohne sich zu überschneiden, entsteht erst durch den Einsatz eines Verbindungsmittels eine kraftschlüssige Verbindung. Überschneiden sich die Hölzer in verschiedenen Ebenen, handelt es sich um eine Ver- oder Überkämmung, überschneiden sie sich in der gleichen Ebene, um eine Überblattung bzw. Verschränkung.   (Eißing et al. 2012)</skos:definition>
        <skos:prefLabel xml:lang="de">Überkreuzverbindung</skos:prefLabel>
        <broaderByPosition rdf:resource="https://hist-arch-vocab.org/bvha#c_88b4f652"/>
    </owl:NamedIndividual>
    


