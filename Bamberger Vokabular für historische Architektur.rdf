    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_e02169da -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_e02169da">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0f62a529"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T15:33:22.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-31T00:12:02.000</terms:modified>
        <skos:altLabel xml:lang="de">Bischofsstuhl</skos:altLabel>
        <skos:definition xml:lang="de">Kathedra (griech. Sitz), Bischofsstuhl in der Kirche. In altchristlicher Zeit im Scheitel der Apsis hinter dem Altar, seit dem Mittelalter erhöht auf der Evangelienseite im Chor, meist prächtig verziert und mit Baldachin. »Ex cathedra (Petri)« (lat. vom Stuhle Petri herab) werden die irreforrnablen und unfehlbaren päpstlichen Dogmen verkündet. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Řec. sedadlo. Biskupský stolec v kostele, ve starokřesťanské době v závěru apsidy za oltářem, od středověku vyvýšena na evangelijní straně v chóru, většinou velkolepě vyzdobena a opatřena baldachýnem. ,,Ex cathedra (Petri)&quot; (lat. z Petrova stolce) byla vyhlašována neomylná papežská dogmata. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Kathedra</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">katedra</skos:prefLabel>
    </owl:NamedIndividual>
    


