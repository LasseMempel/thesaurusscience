    skos:closeMatch <http://data.uba.de/umt/_00022811>,
        <http://dbpedia.org/resource/Social_cost> ;
    skos:definition "The price paid or the loss incurred to acquire, produce or maintain an objective or goal in a group, community or society."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_28767>,
        <http://eurovoc.europa.eu/282> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Soziale Kosten"@de,
        "social cost"@en .

<http://www.eionet.europa.eu/gemet/concept/7788> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/961> ;
    skos:closeMatch <http://data.uba.de/umt/_00015071> ;
    skos:definition "The process of getting those who produce goods or services with adverse effects on the environment or on society to incorporate a knowledge of possible negative repercussions into future economic decisions."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Kosteninternalisierung"@de,
        "internalisation of external costs"@en .

<http://www.eionet.europa.eu/gemet/concept/7807> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6051> ;
    skos:definition "Collective, civic action shared and performed by a significant number of the community or general population."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_14373>,
        <http://eurovoc.europa.eu/2270> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Soziale Beteiligung"@de,
        "social participation"@en .

<http://www.eionet.europa.eu/gemet/concept/7809> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:closeMatch <http://data.uba.de/umt/_00022836>,
        <http://dbpedia.org/resource/Social_policy> ;
    skos:definition "A course of action adopted and pursued by government, business or some other organization, which seeks to ensure that all people have acceptable working or living conditions by providing social security, welfare, health care, insurance, fair employment practices, low cost housing or educational opportunities."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/2517> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Sozialpolitik"@de,
        "social policy"@en .

<http://www.eionet.europa.eu/gemet/concept/781> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2637> ;
    skos:closeMatch <http://data.uba.de/umt/_00004470>,
        <http://dbpedia.org/resource/Beryllium> ;
    skos:definition "A corrosion-resistant, toxic silvery-white metallic element that occurs chiefly in beryl and is used mainly in x-ray windows and in the manufacture of alloys."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_887>,
        <http://eurovoc.europa.eu/3835> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Beryllium"@de,
        "beryllium"@en .

<http://www.eionet.europa.eu/gemet/concept/7813> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7781> ;
    skos:definition "Public assistance especially financial given to persons in special need or difficulty."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/3357> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Soziale Schichtung"@de,
        "social relief"@en .

<http://www.eionet.europa.eu/gemet/concept/7819> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7823> ;
    skos:closeMatch <http://data.uba.de/umt/_00011237> ;
    skos:definition "The concept of system appears throughout the social and natural sciences and has generated a body of literature of its own (general systems theory). A system is any pattern of relationships between elements, and is regarded as having emergent properties on its own over and above the properties of its elements."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Gesellschaftssystem"@de,
        "social system"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Social_structure> .

<http://www.eionet.europa.eu/gemet/concept/782> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4491> ;
    skos:closeMatch <http://data.uba.de/umt/_00004618> ;
    skos:definition "Name given to the ionizing radiation which is produced as a stream of high speed electrons emitted by certain types of radioactive substance when they decay. The intensity of radiation energy produced in human tissue by a beta particle is a hundred times less than that produced by an alpha radiation particle, but it travels slightly deeper into tissue."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Betastrahlung"@de,
        "beta radiation"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Beta_particle> .

<http://www.eionet.europa.eu/gemet/concept/7821> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7798> ;
    skos:closeMatch <http://data.uba.de/umt/_00022816> ;
    skos:definition "Regarding social values, distinctions are often drawn between values, which are strong, semi permanent, underlying, and sometimes inexplicit dispositions, and attitudes, which are shallow, weakly held, and highly variable views and opinions. Societies can usually tolerate highly diverse attitude, whereas they require some degree of homogeneity and consistency in the values held by people, providing a common fund of shared values which shape social and political consensus."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_28770> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Sozialer Wert"@de,
        "social value"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Value_system> .

<http://www.eionet.europa.eu/gemet/concept/7826> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7798> ;
    skos:closeMatch <http://data.uba.de/umt/_00022855> ;
    skos:definition "An essential element in a society's make-up, organization or behavior that combines financial dimensions with inter-personal or inter-group dynamics."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Sozioökonomischer Faktor"@de,
        "socioeconomic factor"@en .

<http://www.eionet.europa.eu/gemet/concept/7840> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition """1) A substance added to another substance to increase its softness, pliability, or plasticity. 
2) A substance, such as a zeolite, for softening water."""@en ;
    skos:exactMatch <http://eurovoc.europa.eu/2420> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Enthärter"@de,
        "softening agent"@en .

<http://www.eionet.europa.eu/gemet/concept/7845> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7843> ;
    skos:closeMatch <http://data.uba.de/umt/_00005370> ;
    skos:definition "The air and other gases in spaces in the soil; specifically that which is found within the zone of aeration. Also known as soil atmosphere."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_7158> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bodenluft"@de,
        "soil air"@en .

<http://www.eionet.europa.eu/gemet/concept/7847> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7890> ;
    skos:closeMatch <http://data.uba.de/umt/_00005319>,
        <http://dbpedia.org/resource/Soil_biology> ;
    skos:definition "The study of the living organisms, mainly microorganisms and microinvertebrates which live within the soil, and which are largely responsible for the decomposition processes vital to soil fertility."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_7160> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bodenbiologie"@de,
        "soil biology"@en .

<http://www.eionet.europa.eu/gemet/concept/7849> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7890> ;
    skos:closeMatch <http://data.uba.de/umt/_00005322>,
        <http://dbpedia.org/resource/Soil_chemistry> ;
    skos:definition "The study of the inorganic and organic components of the soil and its life cycles."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_7161>,
        <http://eurovoc.europa.eu/6386> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bodenchemie"@de,
        "soil chemistry"@en .

<http://www.eionet.europa.eu/gemet/concept/7850> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7881> ;
    skos:closeMatch <http://data.uba.de/umt/_00030837>,
        <http://dbpedia.org/resource/Soil_compaction> ;
    skos:definition "An increase in bulk density (mass per unit volume) and a decrease in soil porosity resulting from applied loads, vibration, or pressure. More compacted soils (or other materials) can support greater loads (load-bearing capacity). Bulk density can be increased by controlling the moisture content, compaction forces and treatment procedures, as well as by manipulating the type of material being compacted."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_7163> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bodenverdichtung"@de,
        "soil compaction"@en .

<http://www.eionet.europa.eu/gemet/concept/7852> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2790> ;
    skos:closeMatch <http://data.uba.de/umt/_00005423>,
        <http://dbpedia.org/resource/Soil_conservation> ;
    skos:definition "Management of soil to prevent or reduce soil erosion and depletion by wind and water. Preservation of soil against deterioration and loss by using it within its capabilities; application of conservation practices needed for its protection and improvement."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_7165>,
        <http://eurovoc.europa.eu/2842> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bodenschutz"@de,
        "soil conservation"@en .

<http://www.eionet.europa.eu/gemet/concept/7853> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2862> ;
    skos:closeMatch <http://data.uba.de/umt/_00040834> ;
    skos:definition "A binding rule or body of rules prescribed by a government to protect and prevent the loss of an area's surface layer of decomposed rock and organic material, valued for its nutrients and ability to support life."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bodenschutzrecht"@de,
        "soil conservation legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/786> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2286> ;
    skos:closeMatch <http://data.uba.de/umt/_00004905>,
        <http://dbpedia.org/resource/Bibliography> ;
    skos:definition "A complete or selective listing of documents by a given subject, author or publisher, often including the description and identification of the editions, dates of issue, titles, authorship, publishers or other written materials."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/4864> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bibliographie"@de,
        "bibliography"@en .

<http://www.eionet.europa.eu/gemet/concept/7860> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7848> ;
    skos:closeMatch <http://data.uba.de/umt/_00005350> ;
    skos:definition "The status of a soil with respect to the amount and availability to plants of elements necessary for plant growth."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_7170> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bodenfruchtbarkeit"@de,
        "soil fertility"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Fertility_%28soil%29> .

<http://www.eionet.europa.eu/gemet/concept/7862> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7881> ;
    skos:closeMatch <http://data.uba.de/umt/_00005318> ;
    skos:definition "The combination of natural processes by which soils are formed. It is also known as pedogenesis. The most important soil-forming factors are parent material, terrain, climate, aspect, vegetation cover, microorganisms in the soil and the age of the land surface. Some pedologists would add to this list the influence of human activities. All the factors exhibit varying degrees of interrelationship and some are more important than others, with climate often being singled out as the most important."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bodenbildung"@de,
        "soil formation"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Pedogenesis> .

<http://www.eionet.europa.eu/gemet/concept/7867> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7881> ;
    skos:closeMatch <http://data.uba.de/umt/_00005312> ;
    skos:definition "In soil mechanics and civil engineering the term is used to denote the increased weight brought to bear on the ground surface."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bodenbelastung"@de,
        "soil loading"@en .

<http://www.eionet.europa.eu/gemet/concept/7868> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5011> ;
    skos:closeMatch <http://data.uba.de/umt/_00005359>,
        <http://dbpedia.org/resource/Soil_map> ;
    skos:definition "A two-dimensional representation that shows the areal extent or the distribution of soils in relation to other features of the land surface."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bodenkarte"@de,
        "soil map"@en .

<http://www.eionet.europa.eu/gemet/concept/7871> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7881> ;
    skos:closeMatch <http://data.uba.de/umt/_00005372>,
        <http://dbpedia.org/resource/Soil_mechanics> ;
    skos:definition "The study of the physical properties of soil, especially those properties that affect its ability to bear weight such as water content, density, strength, etc."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_7177> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bodenmechanik"@de,
        "soil mechanics"@en .

<http://www.eionet.europa.eu/gemet/concept/7873> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7890> ;
    skos:definition "Study of the formation, occurrence, properties, composition, and classification of the minerals present in the soil."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bodenmineralogie"@de,
        "soil mineralogy"@en .

<http://www.eionet.europa.eu/gemet/concept/7875> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7874> ;
    skos:closeMatch <http://data.uba.de/umt/_00005458> ;
    skos:definition "The water regime of the soil is determined by the physical properties and arrangement of the soil particles. The pores in a soil determine its water-retention characteristics. When all the pores are full of water, the soil is said to be saturated."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bodenwasserhaushalt"@de,
        "soil moisture regime"@en .

<http://www.eionet.europa.eu/gemet/concept/7878> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6395> ;
    skos:closeMatch <http://data.uba.de/umt/_00040286> ;
    skos:definition "Solid, liquid and gaseous substances that detrimentally alter the natural condition of the soil."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bodenschadstoff"@de,
        "soil pollutant"@en .

<http://www.eionet.europa.eu/gemet/concept/788> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8926> ;
    skos:closeMatch <http://data.uba.de/umt/_00028628>,
        <http://dbpedia.org/resource/Bicycle> ;
    skos:definition "A vehicle with two wheels in tandem, pedals connected to the rear wheel by a chain, handlebars for steering, and a saddlelike seat."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Zweirad"@de,
        "bicycle"@en .

<http://www.eionet.europa.eu/gemet/concept/7884> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2912> ;
    skos:closeMatch <http://data.uba.de/umt/_00005354>,
        <http://dbpedia.org/resource/Soil_quality> ;
    skos:definition "All current positive or negative properties with regard to soil utilization and soil functions."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bodengüte"@de,
        "soil quality"@en .

<http://www.eionet.europa.eu/gemet/concept/7889> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7376> ;
    skos:closeMatch <http://data.uba.de/umt/_00005445> ;
    skos:definition "The accumulation of soluble mineral salts near the surface of soil, usually caused by the capillary flow of water from saline ground water. Where the rate of surface evaporation is high, irrigation can exacerbate the problem by moistening the soil and causing water to be drawn from deeper levels as water evaporates from the surface. The evaporation of pure water leaves the salts behind, allowing them to accumulate, and they can reach concentrations that are toxic to plants, thus sterilizing the land."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bodenversalzung"@de,
        "soil salination"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Soil_salinity> .

<http://www.eionet.europa.eu/gemet/concept/7892> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7881> ;
    skos:closeMatch <http://data.uba.de/umt/_00047602> ;
    skos:definition "Compaction involves the close-packing of the individual grains mainly by the elimination of pore-space and expulsion of entrapped water; this is normally brought about by the weight of the overlying sediments."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bodensetzung"@de,
        "soil settling"@en .

<http://www.eionet.europa.eu/gemet/concept/7895> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7843> ;
    skos:closeMatch <http://data.uba.de/umt/_00005430>,
        <http://dbpedia.org/resource/Soil_structure> ;
    skos:definition "The combination or aggregation of primary soil particles into aggregates or clusters, which are separated from adjoining peds by surfaces of weakness. Soil structure is classified on the basis of size, shape, and distinctness into classes, types, and grades."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_7196> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bodenstruktur"@de,
        "soil structure"@en .

<http://www.eionet.europa.eu/gemet/concept/7898> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7843> ;
    skos:closeMatch <http://data.uba.de/umt/_00005432>,
        <http://dbpedia.org/resource/Soil_texture> ;
    skos:definition """1) Refers to the relative proportions of the various size groups (sand, silt and clay) of the individual soil grains in a mass of soil. 
2) Classification of soil by the proportion and graduations of the three size groups of soil grains, i.e., sand, silt and clay, present in the soil."""@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_7199> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bodentextur"@de,
        "soil texture"@en .

<http://www.eionet.europa.eu/gemet/concept/79> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4707> ;
    skos:closeMatch <http://data.uba.de/umt/_00011242>,
        <http://dbpedia.org/resource/Act> ;
    skos:definition """1) Something done voluntarily by a person, and of such a nature that certain legal consequences attach to it.
2) Documents, decrees, edicts, laws, judgments, etc."""@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Gesetze"@de,
        "act"@en .

<http://www.eionet.europa.eu/gemet/concept/7910> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2606> ;
    skos:closeMatch <http://data.uba.de/umt/_00022676> ;
    skos:definition "Plant where energy is generated using radiation from the sun."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Solarkraftwerk"@de,
        "solar power station"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/List_of_photovoltaic_power_stations> .

<http://www.eionet.europa.eu/gemet/concept/7918> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7919> ;
    skos:closeMatch <http://data.uba.de/umt/_00009445> ;
    skos:definition "A crystalline material, that is, one in which the constituent atoms are arranged in a three-dimensional lattice, periodic in three independent directions."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Feststoff"@de,
        "solid matter"@en .

<http://www.eionet.europa.eu/gemet/concept/792> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1776> ;
    skos:definition "An international agreement, especially one dealing with a specific matter, involving two or both sides, factions, or the like."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/3462> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bilaterale Konvention"@de,
        "bilateral convention"@en .

<http://www.eionet.europa.eu/gemet/concept/7921> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9062> ;
    skos:closeMatch <http://data.uba.de/umt/_00051238> ;
    skos:definition "The orderly discarding, release, collection, treatment or salvaging of unwanted or useless non-liquid, non-soluble refuse."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Beseitigung von festen Abfallstoffen"@de,
        "solid waste disposal"@en .

<http://www.eionet.europa.eu/gemet/concept/7927> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/912> ;
    skos:closeMatch <http://data.uba.de/umt/_00022584>,
        <http://dbpedia.org/resource/Songbird> ;
    skos:definition "Any passerine bird of the suborder Oscines, having highly developed vocal organs and, in most, a music call."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_14425> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Singvogel"@de,
        "songbird"@en .

<http://www.eionet.europa.eu/gemet/concept/7928> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11918> ;
    skos:closeMatch <http://data.uba.de/umt/_00024931>,
        <http://dbpedia.org/resource/Sonic_boom> ;
    skos:definition "A noise caused by a shock wave that emanates from an aircraft or other object traveling at or above sonic velocity."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Überschallknall"@de,
        "sonic boom"@en .

<http://www.eionet.europa.eu/gemet/concept/7929> a skos:Concept ;
