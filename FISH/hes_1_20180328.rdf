	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1566">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1566</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FEART NÀDARRA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Cleachd airson feartan nàdarra a bhathar dhen bheachd, gu mearachdach, gu bheil iad cudromach a thaobh àrc-eòlais no feartan nàdarra a tha cudromach a thaobh àrc-eòlais.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">NATURAL FEATURE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">PEAT MOUND</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1442" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/414" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/466" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1569">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1569</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">CLACH AN TURTAIR</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Feart nàdarra  tha na chlach, mar is trice tè mhòr agus trom, a tha na laighe air clach eile air alt 's gun gabh a ghluasad gu furasta no air alt 's gum bi e air thurraban.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">ROCKING STONE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1566" />
				<skos:scopeNote xml:lang="en">A natural feature, comprising a stone, often of great size and weight, resting upon another stone in such a way that it may be rocked, or moved slightly, with little effort.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1571" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1572" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502660" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502687" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/507243">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/507243</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">FEART GEÒLAIS</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Feartan nàdarra, a' gabhail a-steach dinneadh reòthaidh iom-eigheadail, tionalan sruthadh-leathaid, cùrsaichean-uisge trèigte is msaa agus feartan geòlasach aig a bheil cudrom no ùidh chultarail.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">GEOLOGICAL FEATURE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2012-12-19T10:32:03</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2012-12-19T10:33:24</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1566" />
				<skos:scopeNote xml:lang="en">Features of natural origin, including periglacial frost wedging, solifluction deposits, abandoned water courses, etc., and geological features of cultural importance or interest.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/509482">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/509482</dcterms:identifier>
				<skos:prefLabel xml:lang="en">PALAEOCHANNEL</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-06T10:44:51</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-06T10:44:51</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1566" />
				<skos:scopeNote xml:lang="en">The course or channel of a river or stream preserved as a geological feature.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:scopeNote xml:lang="en">Use for natural features mistakenly assumed to be of archaeological significance or natural features known to have archaeological significance.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1571">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1571</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CLACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Na cleachd ach mas e clach nàdarra a tha ann no mur eil for no fios dè feum a bha innte.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">STONE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1566" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1469" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1769" />
		<skos:scopeNote xml:lang="en">Use only where stone is natural or where there is no indication of function.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1572">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1572</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CRAOBH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Feart nàdarra. Na cleachd ach airson craobhan aig a bheil cudromachd àrc-eòlach, eachdraidheil no shòisealta.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TREE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1566" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1897" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1954" />
		<skos:scopeNote xml:lang="en">A natural feature. Use only where a tree has archaeological, historical or social significance.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1573">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1573</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">SONNACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Bacadh sa bheil co-dhiù aon sreath de phuist fhiodha faisg air a chèile 's nan seasamh ann an dìg bunait chaol.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PALISADE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1442" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1448" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/324" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/515" />
		<skos:scopeNote xml:lang="en">A barrier consisting of one or more rows of closely-spaced vertical timbers embedded in a narrow foundation trench.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1574">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1574</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BUIDHEANN SHLOCAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Grunn shlocan a tha còmhla ach air pàtran mì-riaghailteach.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PIT GROUP</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1442" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1575" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1901" />
		<skos:scopeNote xml:lang="en">An associated but irregular grouping of pits.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1575">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1575</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">SLOCAN RIAGHAILTEACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Pàtran riaghailteach de shlocan.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PIT SETTING</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1442" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1574" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1901" />
		<skos:scopeNote xml:lang="en">A regular grouping of pits.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1576">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1576</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BAC</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite rèidh a chaidh, gu math tric, a dhèanamh ann an leathad, bruthach no garbhlach. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PLATFORM</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1578" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1442" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1577" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1475" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/265" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/823" />
		<skos:scopeNote xml:lang="en">A level area, often cut into a hillside, slope or uneven ground. Use with more specific term wherever possible.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1577">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1577</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BAC TOGALAICH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite rèidh a chaidh a ghearradh à leathad, mar is trice air pàtran riaghailteach, agus air a chaidh togalach a thogail. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BUILDING PLATFORM</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1576" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1578" />
		<skos:scopeNote xml:lang="en">A levelled area cut into a slope, generally regular in shape, upon which a building was constructed. Use more specific term where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1578">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1578</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BAC TAIGHE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite air leathad a chaidh a dhèanamh rèidh agus air an deach taigh a thogail. Gu math tric seo an aon fhianais a tha air fhàgail a dh'innseas gun robh taigh ann.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HOUSE PLATFORM</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">HUT PLATFORM</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1576" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1577" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/422" />
		<skos:scopeNote xml:lang="en">A levelled area cut into a slope, on which a house was built. Often the only visible evidence of the presence of a house.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1579">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1579</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">SLOC CUARAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Sloc san deach stuthan a dhùsgadh gus RATHAD RÒMANACH a thogail. Airson slocan cuaraidh eile, cleachd CUARAIDH.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">QUARRY PIT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-08-21T13:06:17</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1442" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500482" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502890" />
		<skos:scopeNote xml:lang="en">A pit from which materials are extracted for the construction of a ROMAN ROAD. For other quarry pits use QUARRY.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
