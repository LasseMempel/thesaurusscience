        <skos:definition xml:lang="de">Als Stocksparren stockhoch abgebunden im mehrstöckigen Dachwerk. [Eißing et al. 2012]</skos:definition>
        <skos:prefLabel xml:lang="de">Stocksparren</skos:prefLabel>
    </owl:NamedIndividual>
    


