    skos:closeMatch <http://data.uba.de/umt/_00006666>,
        <http://dbpedia.org/resource/Disinfectant> ;
    skos:definition "An agent, such as heat, radiation, or a chemical, that disinfects by destroying, neutralizing, or inhibiting the growth of disease-carrying microorganisms."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_2331>,
        <http://eurovoc.europa.eu/2773> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Desinfektionsmittel"@de,
        "disinfectant"@en .

<http://www.eionet.europa.eu/gemet/concept/224> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14976> ;
    skos:closeMatch <http://data.uba.de/umt/_00051533> ;
    skos:definition "Any deposit or holdings of farm products, fertilizers, grains, feed and other related supplies in facilities or containers, often to prevent contamination or for times when production cannot meet demand."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Lagerung landwirtschaftlicher Erzeugnisse"@de,
        "agricultural storage"@en .

<http://www.eionet.europa.eu/gemet/concept/2242> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6124> ;
    skos:closeMatch <http://data.uba.de/umt/_00005169> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Begleitschein"@de,
        "dispatch note"@en .

<http://www.eionet.europa.eu/gemet/concept/2246> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3011> ;
    skos:closeMatch <http://data.uba.de/umt/_00003223> ;
    skos:definition "The calculation of pollutant dispersion is based on the use of air dispersion models that mathematically simulate atmospheric conditions and behaviour. Dispersion models can provide concentration or deposition estimates and can be used to evaluate both existing and hypothetical emissions scenarios."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Ausbreitungsrechnung"@de,
        "dispersion calculation"@en .

<http://www.eionet.europa.eu/gemet/concept/2247> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7796> ;
    skos:closeMatch <http://dbpedia.org/resource/Displaced_person> ;
    skos:definition "Persons who, for different reasons or circumstances, have been compelled to leave their homes."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Vertriebener"@de,
        "displaced person"@en .

