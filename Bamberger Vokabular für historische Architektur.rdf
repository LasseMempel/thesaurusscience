        <skos:altLabel xml:lang="de">Versehkelch</skos:altLabel>
        <skos:altLabel xml:lang="la">calix viaticus</skos:altLabel>
        <skos:altLabel xml:lang="en">chalice for communion of the sick</skos:altLabel>
        <skos:definition xml:lang="de">Krankenkelch m; lat. calix ad communicandos infirmos; Versehkelchm; lat. calix viaticus: der Kelch zur Spendung des konsekrierten Weines an Kranke (in der Devotions-Kommunion) oder an Sterbende (Viaticum) bei einer Kommunion unter beiderlei Gestalt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Krankenkelch</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">calice des malades</skos:prefLabel>
        <skos:prefLabel xml:lang="la">calix ad communicandos infirmos</skos:prefLabel>
        <skos:prefLabel xml:lang="en">viatic chalice</skos:prefLabel>
    </owl:NamedIndividual>
    


