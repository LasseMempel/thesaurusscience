        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-27T16:58:26.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T11:23:27.000</terms:modified>
        <skos:definition xml:lang="de"> Schwellenkranz: zu einem horizontalen Rahmen zusammengefügte Schwellen mit kraftschlüssigen Eckverbindungen.  (Eißing et al. 2012)</skos:definition>
        <skos:definition xml:lang="de">Die unter den vier Außenwänden eines Fachwerkhauses liegenden Schwellen. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Schwellenkranz</skos:prefLabel>
    </owl:NamedIndividual>
    


