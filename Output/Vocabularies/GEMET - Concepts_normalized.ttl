    skos:prefLabel "Freon"@de,
        "freon"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Chlorofluorocarbon> .

<http://www.eionet.europa.eu/gemet/concept/3487> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/881> ;
    skos:closeMatch <http://data.uba.de/umt/_00023910> ;
    skos:definition "The scientific study or the characteristic life processes of living organisms found in a natural body of water that does not contain significant amounts of dissolved salts and minerals, such as a lake or river."@en ;
