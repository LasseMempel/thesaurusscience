	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk002624">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">ashlar wall</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Hausteinmauerwerk</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk002319"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010555"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019935"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk002319"/>
		<skos:definition xml:lang="de">Ein Hausteinmauerwerk ist ein Mauerwerk, das aus Bruchsteinen besteht, die grob beschlagen wurden, um waagerechte Lagerfugen und durchgehende Schichthöhen zu erhalten.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002319"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010555"/>
