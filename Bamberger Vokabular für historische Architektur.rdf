        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-06T12:47:30.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-15T11:40:59.000</terms:modified>
        <skos:altLabel xml:lang="la">opus siliceum</skos:altLabel>
        <skos:definition xml:lang="cs">= opus siliceum: kyklopské zdivo, polygonální zdivo, a) režné, vyplněné drobnými kamínky, (tj. vlastně lomový kámen, resp. sbíraný kámen); b) lehce opracované, vyplněné; c) pravidelné polygonální bloky s hlazeným povrchem, bez mezer, uspořádané kolem centrálních kamenů jakoby do odlehčujících oblouků; d) trapézovitě opracované s posunutými vrstvami. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Hausteinmauerwerk</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">zdivo z tesaného kamene</skos:prefLabel>
    </owl:NamedIndividual>
    


