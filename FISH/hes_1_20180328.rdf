		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/14" />
		<skos:scopeNote xml:lang="en">A barn in which a pair of curved timbers form a bowed A-frame which supports the roof independently of the walls.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
