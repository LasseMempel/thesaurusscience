    skos:prefLabel "Basizität"@de,
        "basicity"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Base_%28chemistry%29> .

<http://www.eionet.europa.eu/gemet/concept/7312> a skos:Concept ;
