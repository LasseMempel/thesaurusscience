    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bürgerrechte"@de,
        "citizen rights"@en .

<http://www.eionet.europa.eu/gemet/concept/11489> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:closeMatch <http://dbpedia.org/resource/Notice> ;
    skos:definition "Factual information, advice or a written warning communicated to a person by an authorized source, often conveyed because of a legal or administrative rule requiring transmission of such information to all concerned parties."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/4449> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Vermerk"@de,
        "notice"@en .

<http://www.eionet.europa.eu/gemet/concept/11490> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "A memorandum, letter or notice in either paper or electronic format distributed widely throughout an organization or to a general list of interested parties."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/5995> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Rundschreiben"@de,
        "circular mail"@en .

<http://www.eionet.europa.eu/gemet/concept/11493> a skos:Concept ;
