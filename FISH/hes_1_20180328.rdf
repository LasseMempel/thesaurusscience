		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/503015" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/504103" />
		<skos:scopeNote xml:lang="en">A building where motor vehicles are housed or repaired. For petrol sales use PETROL STATION.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
