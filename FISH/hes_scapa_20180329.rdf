	<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/LNE"/>
	<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/MNE"/>
	<skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NE</skos:notation>
	<skos:prefLabel xml:lang="en">Neolithic</skos:prefLabel>
	<skos:prefLabel xml:lang="gd">(todo)</skos:prefLabel>
	<skos:scopeNote xml:lang="en">The Neolithic, or New Stone Age, sees the transition from hunter gatherer economies to farming. Monumental architecture, including chambered cairns, develops. Pottery is first used and stone tool technologies become more sophisticated.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="http://purl.org/heritagedata/schemes/scapa/concepts/NO">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
	<cc:attributionURL rdf:resource="https://www.historicenvironment.scot/"/>
	<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence"/>
