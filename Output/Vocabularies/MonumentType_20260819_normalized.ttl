    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "LONG MOUND"@en ;
    skos:scopeNote "A long, narrow mound of earth or stone and of uncertain date and function. Use more appropriate term where possible."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70087> a skos:Concept ;
    skos:altLabel "Temple Mausoleum"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159193> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "MAUSOLEUM"@en ;
    skos:scopeNote "A monumental burial place, usually for a single person or family."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70088> a skos:Concept ;
