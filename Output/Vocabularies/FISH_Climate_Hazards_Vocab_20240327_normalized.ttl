    skos:inScheme <http://purl.org/heritagedata/schemes/38076> ;
    skos:prefLabel "Extreme wind speed"@en ;
    skos:scopeNote "Wind speed above typical levels."@en .

<http://purl.org/heritagedata/schemes/38076/concepts/40201> a skos:Concept ;
    skos:altLabel "Hail storm"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/38076/concepts/4020> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/38076> ;
    skos:prefLabel "Hail"@en ;
    skos:scopeNote "Pellets of solid precipitation."@en .

<http://purl.org/heritagedata/schemes/38076/concepts/40202> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/38076/concepts/4020> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/38076> ;
    skos:prefLabel "Thunderstorm"@en ;
    skos:scopeNote "A storm with thunder and lightning. Sometimes causes hail, heavy rain, and high winds."@en .

<http://purl.org/heritagedata/schemes/38076/concepts/40203> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/38076/concepts/4020> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/38076> ;
    skos:prefLabel "Tornado"@en ;
    skos:scopeNote "A rotating column of air, connecting a cloud to the surface of the Earth."@en .

<http://purl.org/heritagedata/schemes/38076/concepts/40204> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/38076/concepts/4020> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/38076> ;
    skos:prefLabel "Derecho"@en ;
    skos:scopeNote "A group of thunderstorms causing long-lived straight-lined wind storms."@en .

<http://purl.org/heritagedata/schemes/38076/concepts/40205> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/38076/concepts/4020> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/38076> ;
    skos:prefLabel "Extratropical cyclone"@en ;
    skos:scopeNote "Low-pressure systems occuring in middle latitutdes, capable of causing extreme precipitation, storm surges, extreme winds, sea level and wave build up."@en .

