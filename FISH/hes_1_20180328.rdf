	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/501705">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/501705</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CARRAGH-CLÀIR SHEALLAIDHEAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Carragh air a bheil mullach rèidh agus pleat meatailt a tha a' sealltainn comhair is astar de dh'àitichean inntinneach.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">VIEW FINDER</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-04-12T14:27:40</dcterms:created>
