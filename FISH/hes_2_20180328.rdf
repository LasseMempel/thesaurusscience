						<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:56:41</dcterms:issued>
						<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/2/concepts/501243" />
						<skos:scopeNote xml:lang="en">A vessel used as an ornament, often to hold flowers</skos:scopeNote>
