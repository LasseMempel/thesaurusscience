    <!-- https://hist-arch-vocab.org/bvha#c_4918ee98 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_4918ee98">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_69367952"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-28T09:44:02.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T16:30:08.000</terms:modified>
        <skos:definition xml:lang="de">(frz.) Das Vorgelände vor einer Festung. Es durfte nach den jeweiligen R.-Gesetzen nicht bebaut, sondern musste freigehalten werden. Das betreffende Gebiet war oft in mehrere unterschiedliche Stufen der Freihaltung gegliedert, je näher an der Festung, desto eingeschränkter war die Nutzung; in der am weitesten entfernten Zone konnten auch leicht demontierbare Bauten errichtet werden. Im R.-Gesetz des Deutschen Reichs von 1871 wurden drei Zonen mit einer gesamten Distanz von 2250 m festgelegt. E. B. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:definition xml:lang="de">Zone um die Festung mit baul. Beschränkungen bzw. Bauverbot. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Rayon</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">rajón</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">rayon</skos:prefLabel>
        <skos:prefLabel xml:lang="es">zona restringida de una fortificación</skos:prefLabel>
    </owl:NamedIndividual>
    


