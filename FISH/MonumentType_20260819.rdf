    <skos:prefLabel xml:lang="en">OPEN AIR SCHOOL</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An early to mid 20th century school designed to effect maximum ventilation and sunlight for its pupils.</skos:scopeNote>
