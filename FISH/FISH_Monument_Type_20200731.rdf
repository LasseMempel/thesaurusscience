  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68875">
    <skos:scopeNote xml:lang="en">A house which bears signs of fortification. These often include crenellated battlements and narrow slit-like windows.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70566">
    <skos:scopeNote xml:lang="en">A building where people could bathe in salt water. Salt water was believed to have medicinal properties.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70302">
    <skos:scopeNote xml:lang="en">A section of the water channel of a river, shut off above and below by lock gates provided with sluices to let water in and out and thus raise or lower boats from one level to another. Often found situated next to a weir.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68933">
    <skos:scopeNote xml:lang="en">A residence for all clergy having the sole or subordinate charge of a living.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141943">
    <skos:scopeNote xml:lang="en">Obstacles, often semi permanent, which are placed on railway lines to prevent the enemy from using them. Set up during the defence of Britain.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140117">
    <skos:scopeNote xml:lang="en">A chamber attached to the sewer of a building to facilitate the removal of any blockage.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92397">
    <skos:scopeNote xml:lang="en">A lock at the point where two waterways join together.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160328">
    <skos:scopeNote xml:lang="en">A building, originally used as a shelter for the duty pilot or officer on watch on an airfield, incorporating an operations room.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160316">
    <skos:scopeNote xml:lang="en">A metal girder, usually of iron or steel, embedded in the ground designed to obstruct the progress of hostile tanks or armoured vehicles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/151873">
    <skos:scopeNote xml:lang="en">An enclosure used for baiting bulls.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68717">
    <skos:scopeNote xml:lang="en">A medieval hospital for lepers, usually consisting of a church and individual shelters for the lepers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92904">
    <skos:scopeNote xml:lang="en">A place where photographs are taken of people or things on a commercial basis.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69952">
    <skos:scopeNote xml:lang="en">A piece of ground used for motor racing.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68590">
    <skos:scopeNote xml:lang="en">An enclosure used for corralling deer.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143581">
    <skos:scopeNote xml:lang="en">A clock with special mechanisms and dials to display astonomical information.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140261">
    <skos:scopeNote xml:lang="en">The limit line of an area pertaining to a medieval manor.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160330">
    <skos:scopeNote xml:lang="en">Watch Office with operations room designed to Air Ministry drawing number (7345/41</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91611">
    <skos:scopeNote xml:lang="en">A jettied house where the overhanging upper storey runs along the entire length of one side.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170007">
    <skos:scopeNote xml:lang="en">Establishments responsible for the research into and the design, development and manufacture of chemical weapons</skos:scopeNote>
  </rdf:Description>
