  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71818">
    <skos:scopeNote xml:lang="en">A temporary hostel built for industrial or transport workers; for example, railway workers' hostels were provided for engine drivers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69399">
    <skos:scopeNote xml:lang="en">A site used for the manufacture of leather products.</skos:scopeNote>
  </rdf:Description>
