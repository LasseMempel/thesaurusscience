    <!-- https://hist-arch-vocab.org/bvha#c_27e66676 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_27e66676">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0f62a529"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_wyccl4ls"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-28T09:51:47.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-31T00:08:35.000</terms:modified>
        <skos:altLabel xml:lang="de">Altarkrone</skos:altLabel>
        <skos:altLabel xml:lang="la">corona pendens</skos:altLabel>
        <skos:altLabel xml:lang="en">pendent crown</skos:altLabel>
        <skos:definition xml:lang="de">Hängekrone f; auch Altarkrone f; lat. corona (altari superposita); corona pendens: ein über dem Altar oder über dem Eingang zum Chor hängender, oft mit Perlen und Edelsteinen besetzter Zierreifen, manchmal mit einem Hängekreuz in der Mitte. Hängekronen wurden oft von weltlichen Herrschern gestiftet (Votivkrone f) als Zeichen der Unterwerfung weltlicher Macht unter die göttliche. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Hängekrone</skos:prefLabel>
        <skos:prefLabel xml:lang="la">corona altari superposita</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">couronne suspendue </skos:prefLabel>
        <skos:prefLabel xml:lang="en">hanging crown</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_27f1971c -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_27f1971c">
