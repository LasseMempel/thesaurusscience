    <skos:scopeNote xml:lang="en">A concrete, circular concave dish 30 feet in diameter used as an acoustic listening device to detect approaching enemy aircraft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/139031">
    <skos:scopeNote xml:lang="en">A building or site for the industrial manufacture of locks.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159257">
    <skos:scopeNote xml:lang="en">A means of transportation where cars, chairs or cabins are carried above the ground by means of one or more cables suspended between towers or pylons.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93422">
    <skos:scopeNote xml:lang="en">A motor in which rotary motion is produced by steam power.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/146389">
    <skos:scopeNote xml:lang="en">A site on which rigs, towers and other associated structures and buildings used for the testing of helicopters and helicopter parts are located.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93576">
    <skos:scopeNote xml:lang="en">Buildings, sites and structures associated with the processing of timber.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92360">
    <skos:scopeNote xml:lang="en">A chapel for followers of Benjamin Ingham after he left the Moravians prior to joining the Sandamanians.</skos:scopeNote>
  </rdf:Description>
