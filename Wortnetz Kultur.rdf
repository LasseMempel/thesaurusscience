	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk020970">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Textblatt</skos:prefLabel>
		<skos:altLabel xml:lang="de">Textblätter</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006010"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk006010"/>
		<skos:definition xml:lang="de">Ein Textblatt ist ein Dokument, das in der Regel Gesangstexte von Vokalwerken, unter anderem von Liedern, enthält. In der Regel wird ein Textblatt zum Anlass eines musikalischen Ereignisses erstellt.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk006010"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-11-17T12:27:36+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk020971">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">album leaf</skos:prefLabel>
		<skos:altLabel xml:lang="en">album leaves</skos:altLabel>
		<skos:prefLabel xml:lang="de">Albumblatt (Dokument)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Albumblätter (Dokumente)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006010"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk006010"/>
		<skos:definition xml:lang="de">Ein Albumblatt ist ein Dokument aus Papier, auf dem ein persönlicher und in der Regel künstlerischer Gruß enthalten ist. Das Albumblatt wurde bewusst in einem Stammbuch, im Sinne eines Freundschaftsalbums, oder in einem Poesiealbum hinterlegt oder auch nur als Einzelblatt angefertigt und verschenkt.</skos:definition>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1545707"/>
