    skos:prefLabel "Solarstrahlung"@de,
        "solar radiation"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Sunlight> .

<http://www.eionet.europa.eu/gemet/concept/7923> a skos:Concept ;
