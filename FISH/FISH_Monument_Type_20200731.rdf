    <skos:scopeNote xml:lang="en">A vessel to contain holy water located near the entrance of a church.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71412">
    <skos:scopeNote xml:lang="en">A room or building in which riding tackle is stored.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92359">
