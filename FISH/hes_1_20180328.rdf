		<skos:prefLabel xml:lang="gd">SEADA GÀRRAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar ann an gàrradh far an cumar acainnean gàirnealaireachd is rudan mar sin.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GARDEN SHED</skos:prefLabel>
