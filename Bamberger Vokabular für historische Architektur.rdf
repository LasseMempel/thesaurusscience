        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-21T09:23:45.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T13:06:09.000</terms:modified>
        <skos:altLabel xml:lang="de">Schartenblende</skos:altLabel>
        <skos:altLabel xml:lang="de">Schartenschirm</skos:altLabel>
        <skos:definition xml:lang="de"> Ein vor oder in Schießscharten angebrachter, häufig mit Blech beschlagener Holzladen, der sich nach außen öffnet; er wird zumeist von Zapfen, die in Klauen liegen, gehalten und schwingt um die obere horizontale Achse. Er dient zur Deckung der Schützen. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Schartenladen</skos:prefLabel>
        <skos:prefLabel xml:lang="it">mantelletta</skos:prefLabel>
        <skos:prefLabel xml:lang="es">postigo de una tronera</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_c2805ece -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_c2805ece">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_6fd46e6e"/>
