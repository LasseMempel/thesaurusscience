    <skos:scopeNote xml:lang="en">An arena for bull-baiting, not a tethering ring.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94168">
    <skos:scopeNote xml:lang="en">A coastal battery designed for use in short range engagements with enemy vessels, minelayers, blockships ad torpedo craft.</skos:scopeNote>
  </rdf:Description>
