    <!-- https://hist-arch-vocab.org/bvha#c_277bb521 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_277bb521">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0d678652"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_4708d89a"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b38a6b54"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-22T10:14:59.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T16:06:13.000</terms:modified>
        <skos:altLabel xml:lang="de">Klangarkade</skos:altLabel>
        <skos:altLabel xml:lang="de">Schallfenster</skos:altLabel>
        <skos:altLabel xml:lang="de">Schallloch</skos:altLabel>
        <skos:altLabel xml:lang="de">Schallöffnung</skos:altLabel>
        <skos:altLabel xml:lang="fr">baie de clocher</skos:altLabel>
        <skos:altLabel xml:lang="en">louver window</skos:altLabel>
        <skos:definition xml:lang="de">Durch Arkaden gegliederte Maueröffnung in der Höhe des Glockenstuhles von Türmen, vielfach als Zwillings- oder Drillingsarkade. Häufig schützen hölzerne Läden, Schalldächer oder Schallbretter die Öffnungen gegen Regen und Wind. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Schallfenster, Klangarkade, Schallloch; unverglaste, fensterartige Maueröffnung an Türmen in der Höhe des Glockenstuhls, häufig als gekuppelte Arkaden (Schallarkaden) oder maßwerkgefüllte Fenster (Schallfenster), zur Verbreitung des Schalls dienend. Um das Eindringen von Schnee und Regen zu verhindern, wird die S. mit Schallladen, Schallbrettern oder Schalldächern versehen. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Schallöffnung in Arkadenform. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Schallarkade</skos:prefLabel>
        <skos:prefLabel xml:lang="en">bell-arcade</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">ouïe de clocher</skos:prefLabel>
        <skos:prefLabel xml:lang="it">rosa di campanile</skos:prefLabel>
        <skos:prefLabel xml:lang="es">vano del campanario</skos:prefLabel>
    </owl:NamedIndividual>
    


