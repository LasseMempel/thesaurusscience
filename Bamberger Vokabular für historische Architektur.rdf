        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-07T09:40:05.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T14:31:59.000</terms:modified>
        <skos:altLabel xml:lang="de">Versehkreuz</skos:altLabel>
        <skos:definition xml:lang="de">Krankenkreuz n: Versehkreuz n: ein kleines Kreuz mit einem Hohlraum, in den zwei vergoldete Kapseln eingefügt sind, eine größere für die Hostien, eine kleinere für das Heilige Öl. (Gegen dieses Kreuz wurden Bedenken erhoben, weil die kirchliche Vorschrift nicht eingehalten wird, wonach die Gefäße für das Öl und die Hostien getrennt zu halten sind und sogar von zwei Personen getragen werden sollen). [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Krankenkreuz</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">ciboire-chrismatoire</skos:prefLabel>
        <skos:prefLabel xml:lang="en">pyx-chrism stock </skos:prefLabel>
    </owl:NamedIndividual>
    


