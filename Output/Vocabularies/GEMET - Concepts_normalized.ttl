    skos:definition "Any kind of shelter, refuge affording protection to animals."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_432> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Tierbehausung"@de,
        "animal housing"@en .

<http://www.eionet.europa.eu/gemet/concept/4282> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:closeMatch <http://data.uba.de/umt/_00040887> ;
    skos:definition "The process of waste inertisation includes solidification and stabilisation; stabilisation is the process used for reduction of hazard potential of the waste by converting the contaminants into their least soluble, least immobile, or least toxic form. Solidification physically binds or encapsulates the waste in a monolithic solid of high structural integrity. Thus solidification may be used for powders, liquids or gases."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Inertisierung"@de,
        "inertisation"@en .

<http://www.eionet.europa.eu/gemet/concept/4283> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:closeMatch <http://dbpedia.org/resource/Inert_waste> ;
    skos:definition "Wastes that do not undergo any significant physical, chemical, or biological transformations when deposited in a landfill."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Inertabfall"@de,
        "inert waste"@en .

<http://www.eionet.europa.eu/gemet/concept/4284> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5371> ;
    skos:closeMatch <http://data.uba.de/umt/_00050398>,
        <http://dbpedia.org/resource/Infant_mortality> ;
    skos:definition "The rate of deaths occurring in the first year of life for a given population."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/1992> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Säuglingssterblichkeit"@de,
        "infant mortality"@en .

<http://www.eionet.europa.eu/gemet/concept/4286> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2232> ;
    skos:closeMatch <http://data.uba.de/umt/_00013336>,
        <http://dbpedia.org/resource/Infection> ;
    skos:definition "The entry and development or multiplication of an infectious agent in the body of a living organism."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_3852> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Infektion"@de,
        "infection"@en .

<http://www.eionet.europa.eu/gemet/concept/4289> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4163> ;
    skos:closeMatch <http://data.uba.de/umt/_00051683> ;
    skos:definition "Invasion of crop by parasites. Among vertebrate animals, many crop pests are mammals, especially in the order of rodents and birds. Among invertebrates, certain species of gastropods and a large number of roundworms from the class of nematodes harm crops. The most varied and numerous species of crop pests are arthropods-insects, arachnids and some species of millipedes and crustaceans. Diseases vary from viral, bacterial, and nutritional to fungal, environmental and non-specific. The FAO has estimated that annual worldwide losses done by plant pests and diseases amount to approximately 20-25% of the potential worldwide yield of food crops."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Pflanzenbefall"@de,
        "infestation of crops"@en .

<http://www.eionet.europa.eu/gemet/concept/4290> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4163> ;
    skos:definition "Food that has been contaminated and deteriorated by some kind of pest."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Lebensmittelbefall"@de,
        "infestation of food"@en .

<http://www.eionet.europa.eu/gemet/concept/4300> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3311> ;
    skos:closeMatch <http://data.uba.de/umt/_00028417>,
        <http://dbpedia.org/resource/Inflow> ;
    skos:definition """1) Water other than wastewater that enters a sewer system (including sewer service connections) from sources such as, but not limited to, roof leaders, cellars drains, yard drains, area drains, drains from springs and swampy areas, manhole covers, cross connections between storm sewers and sanitary sewers, catch basins, cooling towers, storm waters, surface runoff, street wash waters, or drainage. Inflow does not include, and is distinguished from, infiltration. 
2) Action of flowing in; an inflow of effluent into a river."""@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Zufluss"@de,
        "inflow"@en .

<http://www.eionet.europa.eu/gemet/concept/4301> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6373> ;
    skos:closeMatch <http://data.uba.de/umt/_00013349> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Informales Verwaltungshandeln"@de,
        "informal negotiation"@en .

