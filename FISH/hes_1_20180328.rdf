	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1391">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1391</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">IONAD-ACRACHAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar ris an ceanglar bàta.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MOORING STAGE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1869" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1384" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1401" />
		<skos:scopeNote xml:lang="en">A structure to which a boat is secured.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1392">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1392</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">DROCHAID FLEÒDAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar air fleòd, mar is trice fear sealach, air fleòdragan ìseal le druim còmhnard no feadhainn a tha falamh. Cleachdar seo ann an obair-thogail doca no calaidh agus san arm airson bathar a ghiùlan.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PONTOON</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-02-28T11:15:41</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1869" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1384" />
		<skos:scopeNote xml:lang="en">A floating structure, generally temporary, supported on low flat-bottomed or hollow floats. Used in dock or harbour construction works, as well as military supply purposes.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1393">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1393</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">PORT</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Tuineachadh air a' chladach no slighe-uisge aig a bheil cala agus goireasan eile airson luchdan a thoirt far longan agus luchdan a chur orra.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PORT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1384" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1390" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502994" />
		<skos:scopeNote xml:lang="en">A settlement on a coastline or waterway with a harbour and other facilities for loading and unloading ships.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1395">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1395</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TEIRMINEAL MARA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Port, doca no cala far a bheilear a' toirt luchdan far aiseagan, bhàtaichean-falbhain, loidhnearan agus bhàtaichean-carago agus far a bheilear a' cur luchdan orra. Dh'fhaoidte gun gabh seo a-steach tèirminealan rathaid agus/no rèile airson an giùlan gun phort.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SEA TERMINAL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1384" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1869" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1396">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1396</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TEIRMINEAL BHOGSAICHEAN-STÒRAIDH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Àite ann am port, doca no cala far a bheilear a' toirt bogsaichean-stòraidh mòra far bhàtaichean-carago agus far a bheilear a' cur feadhainn ùra orra. Dh'fhaoidte gun gabh seo a-steach tèirmineal rèile airson bogsaichean-stòraidh a chaidh an giùlan gun phort air trèan.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">CONTAINER TERMINAL</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1395" />
				<skos:scopeNote xml:lang="en">An area of a port, dock or harbour where cargo vessels can load and unload large storage containers. May include a rail terminal for containers which have been transported to the port by rail.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500479" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500565">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500565</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">PORT-AISEIG</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Raon aig port, doca no cala, gu math tric le togalaichean airson sgrùdadh nan cead-siubhail agus seirbheis na cusbainn far an urrainn do luchd-siubhail agus carbadan a chleachdas aiseagan a dhol air bòrd/a thighinn far bòrd nan aiseagan agus far an urrainnear bathar a chur air bòrd.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">FERRY TERMINAL</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-27T13:47:02</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-27T13:47:25</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1395" />
				<skos:scopeNote xml:lang="en">An area of a port, dock or harbour, often including buildings for passport control and customs, where passengers and vehicles using ferry services can embark/disembark and where supplies can be taken on board.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:scopeNote xml:lang="en">A port, dock or harbour where ferries, hovercraft, ocean liners and cargo vessels can load and unload. May include road and/or rail terminals for transportation to the port.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1398">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1398</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CREATHALL-THOGAIL</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar a chleachdar ann an doca-tioram gus soithichean a thogail le creathall.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SYNCHROLIFT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1384" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1023" />
		<skos:scopeNote xml:lang="en">A structure used in a dry dock to raise vessels by means of a cradle.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1399">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1399</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CIDHE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite far an gabh luchd-siubhail is bathar a thìreachadh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">LANDING POINT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1400" />
