		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/445" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/446" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/459" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501093" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/532" />
		<skos:scopeNote xml:lang="en">A low, circular or oval bank of turf, earth or stone, which represents the remains of a roundhouse of later prehistoric date.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
