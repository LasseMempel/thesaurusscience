        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-28T10:51:11.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T00:17:14.000</terms:modified>
        <skos:definition xml:lang="de">Belfried (frz. Beffroi) , hoher, schlanker Rathausturm, eingebaut oder freistehend in spätma. Städten Flanderns und Nordwestfrankreichs; er verkörpert die Macht der bürgerl. Selbstverwaltung. Fälschl. wird auch der Bergfried ma. Burgen B. genannt. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Belfried</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">zvonice  </skos:prefLabel>
    </owl:NamedIndividual>
    


