    skos:broader <http://www.eionet.europa.eu/gemet/concept/2944> ;
    skos:definition "Environment pertaining to the countryside."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_6702>,
        <http://eurovoc.europa.eu/1222> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Ländliche Umwelt"@de,
        "rural environment"@en .

<http://www.eionet.europa.eu/gemet/concept/7352> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4056> ;
    skos:closeMatch <http://data.uba.de/umt/_00051106> ;
    skos:definition "The total number of persons inhabiting an agricultural or pastoral region."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_6705>,
        <http://eurovoc.europa.eu/2558> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Ländliche Bevölkerung"@de,
        "rural population"@en .

<http://www.eionet.europa.eu/gemet/concept/7355> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9244> ;
    skos:closeMatch <http://data.uba.de/umt/_00051107> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Ländliche Wasserversorgung"@de,
        "rural water supply"@en .

<http://www.eionet.europa.eu/gemet/concept/736> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:closeMatch <http://data.uba.de/umt/_00006915>,
        <http://dbpedia.org/resource/Batch_process> ;
