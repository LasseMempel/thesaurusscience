        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-03T16:59:19.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-03T17:00:06.000</terms:modified>
        <skos:prefLabel xml:lang="de">Blutampulle</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Eine Sonderform der Fläschchenreliquiare sind die sogenannten Blutampullen (f pl), Behältnisse für das Blut von Märtyrern. [Glossarium Artis]</skos:scopeNote>
    </owl:NamedIndividual>
    


