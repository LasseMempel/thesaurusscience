		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/261" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500482" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/260" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/265" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/277" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/327" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/347" />
		<skos:scopeNote xml:lang="en">A turf and stone platform attached to a FRONTIER DEFENCE, and thought to be a beacon stance.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/267">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/267</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TÙR SIOGNALAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Tùr a tha na phàirt de shiostam siognaileadh shaimeaforan, gu math tric na thogalach trì-ùrlarach air cnuic agus air loidhne-amhairc. Bhiodh àite-fuirich do sgioba dithis agus an cuid theaghlaichean ann an tùr siognailidh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SIGNAL TOWER</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/261" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1480" />
		<skos:scopeNote xml:lang="en">A tower which forms part of a semaphore communication system, often a three-storey building set on a hill in line-of-sight. Signal towers usually provided accommodation for two crewmen and their families.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/268">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/268</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TOGALACH TELE-CHONALTRAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach sa bheil acainnean dealain no leatronach airson conaltradh a dhèanamh thairis air astar mòr. Cleachd seòrsa nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TELECOMMUNICATIONS BUILDING</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/269" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/270">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/270</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">STÈISEAN RÈIDIO</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Togalach no grunn thogalaichean sa bheil acainnean a tha comasach air siognailean rèidio a chraoladh 's a ghlacadh. Cleachd STÈISEAN CRAOLADH RÈIDIO airson buidhnean craolaidh, m.e. stèiseanan rèidio a' BBC.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">RADIO STATION</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/268" />
				<skos:scopeNote xml:lang="en">A building or group of buildings containing equipment capable of transmitting and receiving radio signals. Use BROADCASTING RADIO STATION for broadcasting establishments e.g. BBC Radio stations.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/271" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/258" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/509362">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/509362</dcterms:identifier>
				<skos:prefLabel xml:lang="en">SUBMARINE CABLE STATION</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-09-25T09:22:46</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-09-25T09:22:46</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/268" />
				<skos:scopeNote xml:lang="en">A building housing one end of an underwater telegraph cable.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:scopeNote xml:lang="en">A building housing electrical or electronic equipment used for communicating over long distances. Use specific type where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/269">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/269</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">STIÙIDIO CRAOLAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach no grunn sheòmraichean às an tèid rèidio no telebhisean a chraoladh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BROADCASTING STUDIO</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/268" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/506362" />
		<skos:scopeNote xml:lang="en">A building or suite of rooms from which radio or television broadcasts are disseminated.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/271">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/271</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH-SUIDSIDH FÒN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Oifis no prìomh-stèisean aig siostam ionadail nam fònaichean far a bheil na diofar loidhnichean a' tighinn còmhla air prìomh bhòrd-seinnse far an dèanar ceangal eadar na diofar fo-sgrìobhaichean.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TELEPHONE EXCHANGE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/268" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/275" />
		<skos:scopeNote xml:lang="en">An office or central station of a local telephone system where the various lines are brought to a central switchboard and communication between subscribers is achieved.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/272">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/272</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">STRUCTAR CIAN-CHONALTRAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structaran a tha co-cheangailte ri cian-chonaltradh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TELECOMMUNICATIONS STRUCTURE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/273" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/275" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/258" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/274" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502171" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/504222">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/504222</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">STIÙIDIO-CRAOLAIDH RÈIDIO</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Àite far a bheilear a' dèanamh 's a' craoladh prògraman rèidio.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">RADIO BROADCASTING STUDIO</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-04-28T14:59:57</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-04-28T15:00:17</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/272" />
				<skos:scopeNote xml:lang="en">A place where radio programmes are produced and broadcast.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/503581" />
		<skos:scopeNote xml:lang="en">Structures associated with telecommunications.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
