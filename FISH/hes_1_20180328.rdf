		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500657" />
		<skos:scopeNote xml:lang="en">A structure or enclosure, usually in a remote or upland location, which provides shelter for sheep in severe weather conditions.</skos:scopeNote>
