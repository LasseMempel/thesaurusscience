<http://www.eionet.europa.eu/gemet/concept/5992> a skos:Concept ;
    skos:broadMatch <http://eurovoc.europa.eu/2540> ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15255>,
        <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:closeMatch <http://data.uba.de/umt/_00030981>,
        <http://dbpedia.org/resource/Ozone_depletion_potential> ;
    skos:definition "A factor that reflects the ozone depletion potential of a substance, on a mass per kilogram basis, as compared to chlorofluorocarbon-11 (CFC-11). Such factor shall be based upon the substance's atmospheric life time, the molecular weight of bromine and chlorine, and the substance's ability to be photolytically disassociated, and upon other factors determined to be an accurate measure of relative ozone depletion potential."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Ozonabbaupotential"@de,
        "ozone depletion potential"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/5994> .

<http://www.eionet.europa.eu/gemet/concept/5993> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/627> ;
    skos:closeMatch <http://data.uba.de/umt/_00018846>,
        <http://dbpedia.org/resource/Ozone_layer> ;
    skos:definition "The general stratum of the upper atmosphere in which there is an appreciable ozone concentration and in which ozone plays an important part in the radiative balance of the atmosphere."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_35252> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Ozonschicht"@de,
