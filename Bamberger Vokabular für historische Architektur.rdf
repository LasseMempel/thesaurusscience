        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-20T17:43:30.000</terms:modified>
        <skos:definition xml:lang="de">Degagiert nennt man freistehende oder nur von Wirteln gehaltene Vorlagen einer Wand, Säule, eines Pilasters oder Pfeilers. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Jsou takové příložky stěny, sloupu, pilastru nebo pilíře, které stojí volně, nebo jsou pouze přidržovány prstenci. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">degagiert</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">degažovaný</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_c1834f5b -->


