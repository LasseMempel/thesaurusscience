	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk000603">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Grabgarten</skos:prefLabel>
		<skos:altLabel xml:lang="de">Grabgärten</skos:altLabel>
		<skos:prefLabel xml:lang="en">rectangular grave enclosures</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000604"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk016330"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000604"/>
		<gvp:aat2801_conjuncted_with rdf:resource="http://lvr.vocnet.org/wnk/wk002725"/>
		<xe:explanation_temp xml:lang="de">Es können mehrere Grabgärten aneinanderstoßen sowie miteinander verbunden sein. In einer der Seiten kann eine Erdbrücke den Graben unterbrechen. Grabgärten wurden vor allem in der Eisenzeit und der Römischen Kaiserzeit angelegt. Der Begriff wird darüber hinaus auch für Grabeinfriedungen anderer Zeitstellungen benutzt.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Grabgarten ist eine Grabeinfriedung, die aus einem quadratischen oder rechteckigen, vereinzelt leicht trapezförmigen Graben besteht, der als obertägig sichtbare Begrenzung eine oder mehrere Grabstellen umfasste.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000604"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk016330"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-04-05T09:14:44+02:00+01:00</dcterms:modified>
	</skos:Concept>
