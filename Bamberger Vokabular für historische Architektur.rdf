        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_4d73864a"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_6a121d5e"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_930698bf"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_a5fccf1b"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_d429307b"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-29T09:44:32.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T16:54:41.000</terms:modified>
        <skos:altLabel xml:lang="fr">pilastre</skos:altLabel>
        <skos:definition xml:lang="de">Pfeilervorlage, Halbsäule, Halbpfeiler (Wandpfeiler), Pilaster u. dergl.; einem Pfeiler zur Verstärkung oder Gliederung vorgelegt. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Pfeilervorlage</skos:prefLabel>
        <skos:prefLabel xml:lang="it">contrafuerte para pilastras</skos:prefLabel>
        <skos:prefLabel xml:lang="en">pier buttress</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_f41e7c15 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_f41e7c15">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
