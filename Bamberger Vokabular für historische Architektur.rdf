        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-21T12:11:42.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-21T12:15:06.000</terms:modified>
        <skos:definition xml:lang="de">In der Regel ein Rundbogen, auf dessen Stirn eine Schmuckform gelegt ist, die an ein gedrehtes Tau erinnert. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Kordelbogen</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">arc orné de torsades</skos:prefLabel>
        <skos:prefLabel xml:lang="en">arch decorated with cable molding</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_6ad3dc55 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_6ad3dc55">
