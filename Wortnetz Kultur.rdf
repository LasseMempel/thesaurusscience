	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk003963">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">electrum</skos:prefLabel>
		<skos:altLabel xml:lang="de">Elektron (Legierung)</skos:altLabel>
