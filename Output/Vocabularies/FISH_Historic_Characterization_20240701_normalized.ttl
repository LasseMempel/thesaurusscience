    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Wood Pasture"@en ;
    skos:scopeNote "Scattered trees within grassland, the trees providing shelter for forage as well as being harvested for timber and fuel. Now most often found within deer parks, but more widespread, especially on steep slopes, in the medieval period."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151251> a skos:Concept ;
