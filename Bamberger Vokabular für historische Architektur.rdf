        <skos:altLabel xml:lang="de">Kollegiatskirche</skos:altLabel>
        <skos:altLabel xml:lang="cs">kolegiátní kostel</skos:altLabel>
        <skos:altLabel xml:lang="cs">nadační kostel</skos:altLabel>
        <skos:definition xml:lang="de">1. Kirche einer geistlichen Anstalt, deren Insassen Weltgeistliche (keine Mönche) sind und zusammen das Stifts- oder Kollegiatskapitel bilden; 2. auch Bezeichnung für Klosterkirche. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Kirche einer geistl. Stiftung. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="fr">(église) collégiale</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Stiftskirche</skos:prefLabel>
        <skos:prefLabel xml:lang="it">collegiata</skos:prefLabel>
        <skos:prefLabel xml:lang="en">collegiate church</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">věnný kostel</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_0ea453f7"/>
    </owl:NamedIndividual>
    


