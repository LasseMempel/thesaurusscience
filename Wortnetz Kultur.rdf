		<xe:explanation_temp xml:lang="de">Gnadenbilder werden oft durch besondere Aufstellungsorte und künstlerisch gestaltete Umrahmungen hervorgehoben.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Gnadenbild ist ein visuelles Werk, das als gemaltes oder plastisches Bild einer göttlichen Person oder eines Heiligen von den Gläubigen als wundertätig verehrt wird.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4137138-0"/>
		<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1533007"/>
