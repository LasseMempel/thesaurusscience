    <skos:scopeNote xml:lang="en">A storehouse in 16th and 17th century houses.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69166">
    <skos:scopeNote xml:lang="en">A mine yielding rock salt.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92362">
    <skos:scopeNote xml:lang="en">A decorated, hanging sign, bearing the name and also often a pictorial representation of the inn or public house to which it is attached.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69091">
    <skos:scopeNote xml:lang="en">A site where all the processes for the production of glass and objects made from glass are carried out.</skos:scopeNote>
  </rdf:Description>
