	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk013274">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Schläger (Sportgerät)</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk009370"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013571"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk009370"/>
		<skos:definition xml:lang="de">Ein Schläger ist ein Sportgerät, das in verschiedenen Sportarten zum Schlagen oder Führen eines Balls, Pucks oder vergleichbarer Objekte verwendet wird. Je nach Sportart kann er eine feste, massive Schlagfläche haben, beispielsweise beim Baseball oder Tischtennis, oder eine bespannte Schlagfläche wie im Tennis, Badminton oder Squash. In Sportarten wie Feldhockey und Eishockey besitzt er eine gebogene oder abgewinkelte Schlagfläche, die speziell geformt ist, um den Ball oder Puck präzise zu führen, zu passen oder zu schlagen.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4327925-9"/>
		<skos:narrowMatch rdf:resource="http://vocab.getty.edu/aat/300211249"/>
