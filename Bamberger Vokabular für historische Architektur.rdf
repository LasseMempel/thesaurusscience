    <!-- https://hist-arch-vocab.org/bvha#c_8b1ce8d2 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_8b1ce8d2">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_040da54a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_b2ddfa45"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-18T12:36:04.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T14:21:45.000</terms:modified>
        <skos:definition xml:lang="de">Das regelmäßige A. (gr. Oktogon) ist eine wichtige geometr. Figur und wurde bei Zentralbauten als Grundrissfigur verwendet. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Oktogon (griech. Achteck), Bauwerk, das über einem regelmäßigen Achteck errichtet ist. Altorientalisch-antikes Symbol für die Vollendung des Kosmos (Athen, Turm der Winde; Spalato, Mausoleum; Albenga, Baptisterium; Aachen, Pfalzkapelle; Castel del Monte). [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Zentralbau über dem Grundriss eines regelmäßigen Achtecks. [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Řec. osmiúhelník. Objekt s půdorysem ve tvaru pravidelného osmiúhelníku, staroorientální a antický symbol dokonalosti kosmu: Atény, Věž větrů; Split, mauzoleum; Albenga, baptisterium; Cáchy, palácová kaple; Castel del Monte. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="en"> octagon</skos:prefLabel>
        <skos:prefLabel xml:lang="fr"> octogone</skos:prefLabel>
        <skos:prefLabel xml:lang="it"> ottagono</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Oktogon (Gebäude)</skos:prefLabel>
        <skos:prefLabel xml:lang="es">octógono</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">oktogon (stavba)</skos:prefLabel>
    </owl:NamedIndividual>
    


