    <skos:scopeNote xml:lang="en">An arboretum devoted mainly to the growing of conifers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68980">
