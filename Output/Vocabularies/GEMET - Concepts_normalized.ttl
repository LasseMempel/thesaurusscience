    skos:closeMatch <http://data.uba.de/umt/_00014050>,
        <http://dbpedia.org/resource/Encapsulation> ;
    skos:definition "The enclosure of any polluting product with a material that prevents its release in the environment."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_28357> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
