    <!-- https://hist-arch-vocab.org/bvha#c_9b96422c -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_9b96422c">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_2c0cce41"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_4880e8cc"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_4a84d45f"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_0ea453f7"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_9bee4cc2"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-24T16:34:29.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-21T18:27:10.000</terms:modified>
        <skos:altLabel xml:lang="de">Tres(e)kammer</skos:altLabel>
        <skos:altLabel xml:lang="fr">sacraire</skos:altLabel>
        <skos:altLabel xml:lang="it">sacrestia</skos:altLabel>
        <skos:altLabel xml:lang="en">sextry</skos:altLabel>
        <skos:definition xml:lang="cs">Místnost k uchovávání liturgických předmětů a oděvů, zároveň šatna duchovních a ministrantů, s přístupem do chóru, vyvinula se z pastoforií. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Raum zur Aufbewahrung der liturgischen Geräte und Gewänder, zugleich Ankleideraum für Geistliche und Ministranten, mit Zugang zum Chor; hervorgegangen aus den Pastophorien. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Sakristei, Treskammer, Dresekammer, Almaria, Almer, Gerkammer, Vestiarium; im 11. Jh. in der Regel von Farfa erstmals sacristia genannt. Abgesonderter, dem Presbyterium im N., später auch im S. oder gelegntl. im O. angefügter Raum, in dem liturg. Geräte, Paramente, Bücher und andere für den Gottesdienst erforderl. Gegenstände aufbewahrt und die Vorbereitungen vorgenommen werden, u.a. Anlegen der Gewänder. Anfangs waren im N. und S. für verschiedene Funktionen zwei Räume angefügt: Pastophorien. Die S. kann einen eigenen Altar haben; bei bes. Reliquienreichtum oder Nutzung als Mausoleum auch als monumentale Zentralbauten (Renaissance, Barock) ausgebildet. Im Barock wurde die S. als eine Art Requisitenkammer für die thetral. gestaltete Liturgie prunkhaft ausgestattet und mit Altar und Paramentenschränken als Gesamtkunstwerk aufgefasst. Im protestant. Kirchenbau spielt die S. nur eine untergeordnete Rolle und ist auf einen kleinen Anbau oder eine Abschrankung hinter oder neben dem Altar beschränkt. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Sakristei</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">sacristie</skos:prefLabel>
        <skos:prefLabel xml:lang="en">sacristy</skos:prefLabel>
        <skos:prefLabel xml:lang="es">sacristía</skos:prefLabel>
        <skos:prefLabel xml:lang="it">sagrestia</skos:prefLabel>
        <skos:prefLabel xml:lang="ca">sagristia</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">sakristie</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_4880e8cc"/>
    </owl:NamedIndividual>
    


