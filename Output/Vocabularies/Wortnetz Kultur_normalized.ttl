        <http://www.wikidata.org/entity/Q29353484> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Bekleidungsensemble"@de,
        "ensemble (costume)"@en .

<http://lvr.vocnet.org/wnk/wk008170> a skos:Concept ;
    skos:altLabel "Overalls"@de,
        "boiler suit"@en,
        "boiler suits"@en,
        "coveralls"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk007760> ;
    skos:definition "Ein Overall ist Oberbekleidung, die aus einem einteiligen Anzug besteht und hauptsächlich als funktionale Arbeitskleidung getragen wird, oft aus robusten Materialien wie Denim oder schwerer Baumwolle. Er zeichnet sich durch einen lockeren Schnitt und mehrere Taschen aus, die Bewegungsfreiheit und praktische Nutzung ermöglichen."@de ;
    skos:exactMatch <http://vocab.getty.edu/aat/300046157>,
        <http://www.wikidata.org/entity/Q1077396> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Overall"@de,
        "coverall"@en .

<http://lvr.vocnet.org/wnk/wk008175> a skos:Concept ;
