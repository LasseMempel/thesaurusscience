	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/934">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/934</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">MUILEANN-CLÒ</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Factaraidh far a bheilear a' dèanamh clò-mòr, aodach a nithear le bhith a' filleadh clòimh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TWEED MILL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/917" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1348" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/437" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/924" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/935" />
		<skos:scopeNote xml:lang="en">A factory where tweed, a twilled woollen fabric, is manufactured.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
