        <skos:altLabel xml:lang="la">Dominica Sancta</skos:altLabel>
        <skos:altLabel xml:lang="la">Dominicum Pascha</skos:altLabel>
        <skos:altLabel xml:lang="de">Osterfest</skos:altLabel>
        <skos:altLabel xml:lang="fr">fête de Pâques</skos:altLabel>
        <skos:definition xml:lang="de">Ostern f, Osterfest n, Dominica Resurrectionis, Dominica Sancta, Dominicum Pascha: Gedächtnis der Auferstehung Christi. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="la">Dominica Resurrectionis</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Ostern</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Pâques</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_50ba1b47 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_50ba1b47">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_049c4c22"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-12T15:33:43.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:13:36.000</terms:modified>
        <skos:altLabel xml:lang="de">Echogewölbe</skos:altLabel>
        <skos:altLabel xml:lang="de">Klanggewölbe </skos:altLabel>
        <skos:altLabel xml:lang="de">Schallgewölbe </skos:altLabel>
        <skos:altLabel xml:lang="de">Sprachgewölbe</skos:altLabel>
        <skos:altLabel xml:lang="fr">voûte acoustique</skos:altLabel>
        <skos:altLabel xml:lang="en">whispering dome</skos:altLabel>
        <skos:definition xml:lang="de">Flüstergewölbe, Flüstergalerie, Bezeichnung für einen überwölbten Raum, in dem an einer Stelle geflüsterte Worte durch Reflexion an einer entfernten Stelle deutl. vernehmbar sind, während sie im übrigen Raum nicht und aus der Nähe kaum gehört werden. Diese Erscheinung kann zufällig sein oder auf einer raffiniert ausgeklügelten Planung beruhen (meist ellipt. Raumbegrenzungen, Sprecher und Hörer in den Brennpunkten). [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Gewölbe, dessen meist elliptische Begrenzungen Schallwellen reflektieren, so dass selbst ein leise gesprochenes Wort an entfernter Stelle im Raum deutlich hörbar ist. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Flüstergewölbe </skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte à écho</skos:prefLabel>
        <skos:prefLabel xml:lang="en">whispering gallery</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_049c4c22"/>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_049c4c22"/>
    </owl:NamedIndividual>
    


