		<skos:prefLabel xml:lang="gd">CAFAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite far an gabhar biadh is deoch, mar is trice biadh beag agus deochan nach eil nan deochan-làidir.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CAFE</skos:prefLabel>
