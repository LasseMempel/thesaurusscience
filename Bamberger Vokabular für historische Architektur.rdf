    <!-- https://hist-arch-vocab.org/bvha#c_3dc21bc9 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_3dc21bc9">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_39fa2838"/>
