    <skos:scopeNote xml:lang="en">A gate leading to water, either a river or the sea. Used as a means of supplying castles, for example, with goods brought by water transport.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160226">
    <skos:scopeNote xml:lang="en">A building or structure used to provide protection to an Air Raid Warden or firewatcher during an air raid, thus enabling the identification of the locations of fires caused by incendiary bombs in comparative safety.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91094">
    <skos:scopeNote xml:lang="en">Building housing a form of early steam engine using steam at atmospheric pressure. Chiefly employed in mine pumping.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160346">
    <skos:scopeNote xml:lang="en">A building used for the daily administration of the Royal Air Force.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/83546">
    <skos:scopeNote xml:lang="en">Open yard for keeping cattle in during winter. Used from the mid-14th century in drier, Eastern, arable counties.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91696">
    <skos:scopeNote xml:lang="en">A building or room used for the practice and study of dance.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164358">
    <skos:scopeNote xml:lang="en">A tunnel used to test scale model propellers and hulls to consider the impact of caviation on wake, propulsion, vibration and noise.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70288">
    <skos:scopeNote xml:lang="en">An artificial navigable waterway used for the transportation of goods. Nowadays also used for recreational purposes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71321">
    <skos:scopeNote xml:lang="en">A monastic cattle ranch with associated buildings, paddocks and pastures.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160521">
    <skos:scopeNote xml:lang="en">A small, industrially manufactured, air raid shelter, designed to be used inside buildings and to provide cover for nightwatchmen or firewatchers remaining on site during air raids.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160411">
    <skos:scopeNote xml:lang="en">A building or site used for the storage and distribution lighter than air gases for use in barrage balloons.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71656">
    <skos:scopeNote xml:lang="en">A path that is roofed over.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162990">
    <skos:scopeNote xml:lang="en">A fairground ride, often a permanent structure, consisting of a tower with an internal staircase and an external spiral shaped slide.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68688">
    <skos:scopeNote xml:lang="en">A place where letters and parcels are sorted before being distributed. Usually found at a large general post office.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141892">
    <skos:scopeNote xml:lang="en">A type of fairground or seaside amusement, often a permanent structure, where carriages travel at high speeds on an undulating track raised some distance from the ground.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92320">
    <skos:scopeNote xml:lang="en">A hydraulically-powered crane constructed from open box girders.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69910">
    <skos:scopeNote xml:lang="en">A large mounted gun, now disused and placed in a prominent position as a piece of street furniture or as a "feature".</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93129">
    <skos:scopeNote xml:lang="en">Buildings used as non-permanent homes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/148437">
    <skos:scopeNote xml:lang="en">A Jewish graveyard headstone.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91321">
    <skos:scopeNote xml:lang="en">A cross channel telegraph office.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69326">
    <skos:scopeNote xml:lang="en">A mill or factory in which raw cotton, wool, nylon or other material is spun into yarn or thread.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69083">
    <skos:scopeNote xml:lang="en">Works producing a refractory clay, kaolin. An essential raw material of porcelain and some types of papermaking.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162568">
    <skos:scopeNote xml:lang="en">Office used by a Piermaster.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78218">
    <skos:scopeNote xml:lang="en">Use broader site type where known</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70408">
    <skos:scopeNote xml:lang="en">A manmade chamber cut into a rockface.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69303">
    <skos:scopeNote xml:lang="en">A factory used for processing raw materials. Use more specific mill type where known. See also TEXTILE MILL, for more narrow terms.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91309">
    <skos:scopeNote xml:lang="en">A building used to store navigational buoys.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93154">
    <skos:scopeNote xml:lang="en">The entrance to a road tunnel, sometimes of a grand construction.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91883">
    <skos:scopeNote xml:lang="en">A courtyard in a prison or workhouse for the inmates to take exercise.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141861">
    <skos:scopeNote xml:lang="en">A building where people congregate to undertake sustained mental contemplation or religious or spiritual reflection.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93175">
    <skos:scopeNote xml:lang="en">An engine in which the oscillating motion of the beam is translated via gearing to a rotative motion.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68731">
