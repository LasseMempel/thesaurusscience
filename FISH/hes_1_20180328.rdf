				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/507186</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">CEAPADH-IASGAICH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Rud neo-aithnichte air grunnd na mara a chaidh a chlàradh le iasgairean 's e na bhacadh iasgaich.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">FISHERMENS FASTENER</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2012-12-04T13:57:08</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2012-12-04T16:09:21</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1382" />
				<skos:scopeNote xml:lang="en">An unidentified feature on the seabed recorded by fishermen as an obstruction to trawling.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
