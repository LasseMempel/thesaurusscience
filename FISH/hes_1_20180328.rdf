		<skos:prefLabel xml:lang="gd">EAGLAIS</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach a thathar a' cleachdadh airson adhradh Crìostail poblach.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CHURCH</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
