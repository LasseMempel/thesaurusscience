	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004344">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="en">block of stone</skos:altLabel>
		<skos:prefLabel xml:lang="en">boulder</skos:prefLabel>
		<skos:altLabel xml:lang="de">Felsblock</skos:altLabel>
		<skos:prefLabel xml:lang="de">Gesteinsblock</skos:prefLabel>
		<skos:altLabel xml:lang="de">Gesteinsblöcke</skos:altLabel>
		<skos:altLabel xml:lang="de">Steinblock</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004346"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk004033"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013618"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019761"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004346"/>
		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk004347"/>
		<xe:explanation_temp xml:lang="de">Umgangssprachlich wird auch Felsblock synonym verwendet, diese Bezeichnung ist fachlich nicht korrekt, da  sie sich auf einen Gesteinskörper mit bestehender Bindung zum Ursprungsgestein bezieht</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Gesteinsblock ist ein allgemeiner Begriff der Geologie, der einen vom ursprünglichen Festgestein durch natürliche oder anthropogene Einflüsse gelösten Gesteinskörper bezeichnet.</skos:definition>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300011671"/>
