		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1406" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1405" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501054" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/508082" />
		<skos:scopeNote xml:lang="en">A place where vessels can land passengers and goods.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
