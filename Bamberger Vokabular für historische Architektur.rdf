        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-28T14:06:14.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T19:43:48.000</terms:modified>
        <skos:altLabel xml:lang="de">Gaden</skos:altLabel>
        <skos:altLabel xml:lang="de">Lichtgaden</skos:altLabel>
        <skos:altLabel xml:lang="de">Obergaden</skos:altLabel>
        <skos:altLabel xml:lang="fr">cléristère</skos:altLabel>
        <skos:altLabel xml:lang="es">sobretecho con ventanas laterales</skos:altLabel>
        <skos:altLabel xml:lang="fr">étage clair</skos:altLabel>
        <skos:definition xml:lang="de">Der über die Seitenschiffdächer erhöhte, obere Teil (O.wand) des Mittelschiffs einer Basilika, in dem die Hochschifffenster (O.fenster) liegen. [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Horní část stěny s okny nad střední lodí baziliky, níže položený pás oken bočních lodí se nazývá dolní okenní stěna. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Lichtgaden, Obergaden, der obere, durch die Hochschifffenster belichtete Wandabschnitt der Basilika. Die niedriger gelegene Fensterzone der Seitenschiffe heißt Untergaden. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Obergaden, Gaden, Lichtgaden; der über die Seitenschiffdächer erhöhte, obere Teil (Obergadenwand) des Mittelschiffs einer Basilika, in dem die Hochschifffenster (Obergadenfenster) liegen. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Obergadenwand</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">clairevoie</skos:prefLabel>
        <skos:prefLabel xml:lang="es">claraboya</skos:prefLabel>
        <skos:prefLabel xml:lang="it">claristorio</skos:prefLabel>
        <skos:prefLabel xml:lang="en">clerestory</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">horní okenní stěna</skos:prefLabel>
        <broaderByPosition rdf:resource="https://hist-arch-vocab.org/bvha#c_ab2c77c8"/>
    </owl:NamedIndividual>
    


