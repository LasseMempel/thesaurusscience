        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-14T13:12:25.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T16:42:03.000</terms:modified>
        <skos:definition xml:lang="de">Bestehend aus runden Polstern (Echinus) und quadrat. Deckplatte (Abakus); charakterist. Element der dorischen Ordnung. Die frühen D.K.e sind weit ausladend, bei den späteren schrumpft der Echinus zu einem umgekehrt flachen Kegelstumpf zusammen. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="fr">chapiteau dorique</skos:prefLabel>
        <skos:prefLabel xml:lang="en">doric capital</skos:prefLabel>
        <skos:prefLabel xml:lang="de">dorisches Kapitell</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">dórská hlavice</skos:prefLabel>
    </owl:NamedIndividual>
    


