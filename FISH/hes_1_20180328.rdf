	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/310">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/310</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BACADH DÌONACHD</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làraichean is structaran, gu math tric às aonais sgioba ann, a chuireas bacadh no breisleachadh air feachdan nàmhad.</skos:scopeNote>
