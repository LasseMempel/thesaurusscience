		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/529" />
		<skos:scopeNote xml:lang="en">A planned village or settlement.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/531">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/531</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BAILE MHÈINNEARAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Baile dealbhaichte a chaidh a thogail mar àite-fuirich dhan luchd-obrach ann am mèinn guail shònraichte.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MINERS VILLAGE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/530" />
