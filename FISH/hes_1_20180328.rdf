		<skos:prefLabel xml:lang="gd">PIOLAIR GEATA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làimhrig bhreigean no cloiche sa bheil lùdagan a tha geata a' crochadh orra.</skos:scopeNote>
