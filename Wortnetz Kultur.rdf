		<skos:prefLabel xml:lang="de">Gips</skos:prefLabel>
		<skos:altLabel xml:lang="de">Gipsspat</skos:altLabel>
		<skos:prefLabel xml:lang="en">gypsum</skos:prefLabel>
		<skos:altLabel xml:lang="de">Kalziumsulfat</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003955"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk003731"/>
