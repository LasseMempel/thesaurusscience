        <skos:altLabel xml:lang="en"> ear</skos:altLabel>
        <skos:altLabel xml:lang="fr"> oreille</skos:altLabel>
        <skos:altLabel xml:lang="it">orecchio</skos:altLabel>
        <skos:definition xml:lang="de">Festungsohr an die Face eines Werkes oder einer Bastion am Schulterpunkt sich anschließende, durch Zurückziehung eines Teils der Flanke gebildete bogen- oder kastenförmig vorspringende Schulter zur Deckung der Flanke und zur Grabenbestreichung (Ohrenbastion). [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="es"> luneta</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Festungsohr</skos:prefLabel>
        <skos:prefLabel xml:lang="en">auricle</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">oreillon</skos:prefLabel>
    </owl:NamedIndividual>
    


