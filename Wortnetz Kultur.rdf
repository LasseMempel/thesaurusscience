	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk020478">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Fotografische Technik</skos:altLabel>
		<skos:altLabel xml:lang="de">Fotografische Techniken</skos:altLabel>
		<skos:prefLabel xml:lang="de">Fototechnik</skos:prefLabel>
		<skos:altLabel xml:lang="de">Fototechniken</skos:altLabel>
		<skos:prefLabel xml:lang="en">photographic technique</skos:prefLabel>
		<skos:altLabel xml:lang="en">photographic techniques</skos:altLabel>
		<skos:altLabel xml:lang="de">Phototechnik</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk008936"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk008936"/>
		<skos:definition xml:lang="de">Fototechnik ist ein Verfahren, das gestalterische und handwerkliche Methoden zur Aufnahme, Entwicklung und Bearbeitung von Fotografien anwendet. Fototechniken umfassen sowohl die Art und Weise, wie ein Bild aufgenommen wird (etwa Nachtaufnahme, Panoramaaufnahme, Mehrfachbelichtung), als auch Methoden zur Bearbeitung und Präsentation (wie Entwicklung, Tonung, Satinieren). 
Fototechniken unterscheiden sich von Fotografieverfahren, da sie nicht primär die chemisch-physikalische Bildentstehung, sondern die praktische Anwendung und Gestaltung betreffen.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300134334"/>
		<skos:mappingRelation rdf:resource="http://www.wikidata.org/entity/Q1439691"/>
		<skos:mappingRelation rdf:resource="http://d-nb.info/gnd/4174558-9"/>
