	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/286">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/286</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CARBAD ARMAICHTE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Carbad cogaidh armach. Chithear fhathast iad mar chuimhneachain, targaidean no longan-briste air a' chladach.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ARMOURED VEHICLE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-18T10:20:22</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">ARMY TANK</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/278" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/203" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/386" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/390" />
		<skos:scopeNote xml:lang="en">An armoured fighting vehicle. Often survive as commemorative monuments,targets and coastal wrecks.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/287">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/287</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BATARAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far a bheil gunnachan, moirtearan no solais-shiridh air am munntachadh. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
