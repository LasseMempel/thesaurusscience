		<skos:prefLabel xml:lang="gd">SEADA PHLANNTRAISEAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Seata far a bheilear a' toirt fàs air lusan maotha o òganan gus an cur air an taobh a-muigh nuair a bhios iad nas sine.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">POTTING SHED</skos:prefLabel>
