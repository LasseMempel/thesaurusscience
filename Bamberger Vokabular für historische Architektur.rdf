        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_8d8645c3"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-26T16:44:58.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T23:46:51.000</terms:modified>
        <skos:definition xml:lang="de">Horaglockef; lat. horarum campana: eine Glocke, deren Geläut zum Stundengebet ruft, z. B. zur Vesper (Vesperglocke f) oder zum &quot;Salve, Regina&quot;(Salveglocke f). [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Horaglocke</skos:prefLabel>
        <skos:prefLabel xml:lang="en">bell of the Hours</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">cloche des heures canoniales</skos:prefLabel>
        <skos:prefLabel xml:lang="la">horarum campana</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_6cd8e8d8 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_6cd8e8d8">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
