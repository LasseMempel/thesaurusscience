    <!-- https://hist-arch-vocab.org/bvha#c_f8d9ab8a -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_f8d9ab8a">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f4d0075f"/>
