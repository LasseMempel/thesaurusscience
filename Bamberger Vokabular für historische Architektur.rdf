        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T18:10:38.000</terms:modified>
        <skos:definition xml:lang="de">Triumphsäule, Ehrensäule, eine freistehende monumentale Säule mit Darstellungen aus dem Leben eines röm. Kaisers in spiralförmig angeordneten Reliefbändern. Die T. wurde von einer Statue des Kaisers bekrönt. Im Innern führt eine Wendeltreppe zur oberen Plattform. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Triumphsäule</skos:prefLabel>
        <skos:prefLabel xml:lang="it">colonna commemorativa</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">colonne de triomphe, c. triomphale</skos:prefLabel>
        <skos:prefLabel xml:lang="es">columna de triunfo</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">triumfální sloup</skos:prefLabel>
        <skos:prefLabel xml:lang="en">triumphal column</skos:prefLabel>
    </owl:NamedIndividual>
    


