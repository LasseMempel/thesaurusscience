	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk003355">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="en">datum point of altitude</skos:altLabel>
		<skos:altLabel xml:lang="en">elevation mark</skos:altLabel>
		<skos:prefLabel xml:lang="de">Höhenmarke</skos:prefLabel>
		<skos:altLabel xml:lang="de">Höhenmarken</skos:altLabel>
		<skos:prefLabel xml:lang="en">site datum post</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004569"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004569"/>
