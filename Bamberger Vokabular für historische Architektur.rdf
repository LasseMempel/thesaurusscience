        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T17:22:47.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-01T18:53:42.000</terms:modified>
        <skos:altLabel xml:lang="en">circular pier</skos:altLabel>
        <skos:altLabel xml:lang="en">cylindrical pier</skos:altLabel>
        <skos:altLabel xml:lang="fr">pilier circulaire</skos:altLabel>
        <skos:definition xml:lang="de">Rundpfeiler, Pfeiler mit kreisförmigem Querschnitt. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Zvl. v pozdně gotických halových kostehch mají kruhový průřez, obvykle bez entáze; často buď nadměrně štíhlé nebo silně stlačené. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Rundpfeiler</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kruhový pilíř</skos:prefLabel>
        <skos:prefLabel xml:lang="es">pilar redondo</skos:prefLabel>
        <skos:prefLabel xml:lang="it">pilastro cilindrico</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">pilier rond</skos:prefLabel>
        <skos:prefLabel xml:lang="en">round pier</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_cc7a1644"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_6b36b369 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_6b36b369">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1d45568a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-10T11:45:26.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T16:16:10.000</terms:modified>
        <skos:definition xml:lang="de">Lateinische Kirche f: der Teil der kath. Kirche, der den lateinischen Ritus befolgt. Von den Riten der Ostkirche unterscheidet sie sich insbesondere durch die Veränderlichkeit der Priestergebete. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="fr">Eglise latine</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Lateinische Kirche</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Latin Church</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_6b5a3572 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_6b5a3572">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0a02c60b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-03T14:06:30.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T16:14:06.000</terms:modified>
        <skos:definition xml:lang="de">Quader, dessen Sichtseite glatt abgearbeitet ist, also keinen Buckel oder eine sonstige Erhebung aufweist. G. erscheinen ab dem 11. Jh. in Zusammenhang mit dem Handquader, finden sich aber noch im 13. und 14. Jh., gelegentlich zusammen mit Buckelquaderwänden ( Buckelquader). J. Z. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:prefLabel xml:lang="de">Glattquader</skos:prefLabel>
    </owl:NamedIndividual>
    


