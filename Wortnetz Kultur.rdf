		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk007120"/>
		<skos:definition xml:lang="de">Eine Feuerschaufel ist eine Schaufel, die zum Ausräumen kalter Asche aus Öfen, Kaminen oder offenen Feuerstellen dient.</skos:definition>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300411575"/>
