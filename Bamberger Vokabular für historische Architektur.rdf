        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-22T10:06:02.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T16:29:57.000</terms:modified>
        <skos:altLabel xml:lang="cs">Biskupský ceremoniál</skos:altLabel>
        <skos:altLabel xml:lang="fr">cérémonial des évêques</skos:altLabel>
        <skos:definition xml:lang="de">Caeremoniale episcoporum n: Buch mit dem Zeremoniell des Empfanges von Bischöfen und Prälaten und mit den Riten für die von ihnen vollzogenen kirchlichen Funktionen (Messe, Vesper u.a.). [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Caeremoniale episcoporum</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">caeremoniale episcoporum</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">cérémonial épiscopal</skos:prefLabel>
    </owl:NamedIndividual>
    


