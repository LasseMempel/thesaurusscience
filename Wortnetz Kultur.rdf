		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk020686"/>
		<skos:definition xml:lang="de">Ein Jackett ist Oberbekleidung mit langen Ärmeln, mindestens bis zur Taille reichend. Markant ist das Fasson und der Verschluss mit Knöpfen auf der Vorderseite. Wird häufig in Kombination mit einer Hose aus gleichem Material und Farbe getragen.</skos:definition>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/7555932-8"/>
