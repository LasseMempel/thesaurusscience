	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk006382">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">Easter egg</skos:prefLabel>
		<skos:altLabel xml:lang="en">Easter eggs</skos:altLabel>
		<skos:prefLabel xml:lang="de">Osterei</skos:prefLabel>
		<skos:altLabel xml:lang="de">Ostereier</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk005847"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk020417"/>
