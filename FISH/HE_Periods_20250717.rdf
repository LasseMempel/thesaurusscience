    <skos:prefLabel xml:lang="en">Centuries</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A period of time equal to 100-years; more specifically, around the Christian or Common era.</skos:scopeNote>
    <skos:notation xml:lang="en">century</skos:notation>
    <skos:topConceptOf rdf:resource="http://purl.org/heritagedata/schemes/eh_period"/>
  </skos:Concept>

  <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_period/concepts/IA">
    <skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/EIA"/>
    <skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/LIA"/>
