		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500779" />
		<skos:scopeNote xml:lang="en">A government employment agency for those out of work offering advice on jobs, training and retraining.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
