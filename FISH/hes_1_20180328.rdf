	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/923">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/923</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">MUILEANN-LUADHAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Muileann far a bheilear a' bualadh 's a' glanadh aodach le siabann no criadh an fhùcadair.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">FULLING MILL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">PLASH MILL</skos:altLabel>
		<skos:altLabel xml:lang="en">WAULK MILL</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/917" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1348" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/693" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/933" />
		<skos:scopeNote xml:lang="en">A mill for beating and cleaning cloth, using soap or fullers' earth.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
