    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Single parents"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/687> ;
    skos:scopeNote "Parents with sole custody of their children - either by choice or because they are compelled by specific circumstances."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1981> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/158> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Garages (workshops)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1982> ;
    skos:scopeNote "Workshops used for repairing and servicing motor vehicles."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1982> a skos:Concept ;
    skos:altLabel "Auto refinishing"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/205> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Vehicle refinishing"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1981> ;
    skos:scopeNote "The work of repairing and dyeing the bodywork of automobiles or other vehicles."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1997> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/240> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Uncia (unit of weight)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444> ;
    skos:scopeNote "Roman unit of weight equivalent to 1/12 of the Roman libra."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1998> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Treasurer of the Other Gods"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2043> ;
    skos:scopeNote "An initially annual position that occurs in ancient Athens from the year 434 BCE onwards. The treasurers of the Other Gods were ten in number and they had the duty to concentrate the treasures of the various temples on the Acropolis, in front of the Assembly. For some time, they were also in charge of certain public payments in place of the apodektai."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1999> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Treasurer of Athena"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2044> ;
    skos:scopeNote "An office that occurs in ancient Athens. The treasurers of Athena were initially annualy selected but later they served for four years from one Panathenaic festival to another. They were responsible for all things relevant to the festival, and also for the custody of the Parthenon, its religious and dedicatory objects. Moreover, they were the keepers of the list of citizens organized by tribe (katalogoi). During the 5th c. BCE they were also responsible for the safe-keeping of the state's budget surplus and the execution of payments related to the construction works on the Acropolis."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2000> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Apodektes"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2045> ;
    skos:scopeNote "An office that occurs in ancient Athens. The apodektai were ten in number and were appointed by lot. They received certain state revenues and apportioned them (merizein) as directed by law among separate spending authorities. They also kept lists of persons indebted to the state, made entries of all monies that were paid in, and erased the names of the debtors from the lists. Moreover, they executed some payments and had the power to decide cases connected with the subjects under their management, but only up to 10 drachms."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2003> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2002> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Juristen, Sozialwissenschaftler und Kulturberufe"@de,
        "Legal, social and cultural professionals"@en ;
    skos:scopeNote "This group of professionals comprises creative and performing artists, librarians, archivists and curators, authors, journalists and linguists, social and religious professionals as well as legal professionals. They conduct research, improve or develop concepts, theories and operational methods, apply knowledge relating to the law, storage and retrieval of information and artefacts, psychology, social welfare, politics, economics, history, religion, languages, sociology, other social sciences, and arts and entertainment."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2004> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2003> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Creative and performing artists"@en ;
    skos:scopeNote "Creative and performing artists communicate ideas, impressions and facts in a wide range of media to achieve particular effects; interpret a composition such as a musical score or a script to perform or direct the performance; and host the presentation of such performance and other media events.<br />Tasks performed usually include: conceiving and creating visual art forms; conceiving and writing original music; devising, directing, rehearsing and performing in music, dance, theatrical and film productions; assuming creative, financial and organizational responsibilities in the production of television programmes, films, and stage presentations; studying script, play or book and preparing and rehearsing interpretation; selecting and introducing music, videos and other entertainment material for broadcast and making commercial and public service announcements."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2005> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1321> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Drawing from the antique"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1027> ;
    skos:scopeNote "Drawing classical sculptures, precisely and accurately, showing every nuance of shading."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2013> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1321> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Decorative illustration"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1027> ;
    skos:scopeNote "Type of drawing which represents decorative motifs of a painted, sculptural or architectural decoration."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2015> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/618> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Portraits"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2631> ;
    skos:scopeNote "A representation of a particular person which traditionally depicts something of the person’s character."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2016> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/378> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Tone drawing"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2024> ;
    skos:scopeNote "Type of drawing in which surfaces and planes are indicated by contrast between tones or values, rather than by lines."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2020> a skos:Concept ;
    skos:altLabel "Landscapes"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/618> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Landscape paintings"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2632> ;
    skos:scopeNote "Creative works, usually two-dimensional, depicting an outdoor scene dominated by the land, hills, fields, sky, trees, fields, rivers or other bodies of water, and other natural elements. Landscapes may include a near point of view in the foreground, but also usually depict a view into the distance. Landscapes may contain architecture or figures, but the primary focus remains the land."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2029> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2040> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Monasteries"@en ;
    skos:scopeNote "Organised communities of persons who live in a specific place in partial or complete seclusion from society and pursue a religious and/or mystic lifestyle devoted to contemplative activities of prayer, study, self-searching, and manual labour. Monasteries are organised as institutions that dispose of -and manage- their own property (including buildings and dwellings for the performance of rituals and for the accommodation of their members), have a certain degree of administrative autonomy and are governed according to particular hierarchies and sets of rules."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2042> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/26> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Gender groups"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1047> ;
    skos:scopeNote "Human groups that are defined according to their gender identity, namely the existing social and cultural standards and roles -or even deviations- in relation to their biological sex."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2043> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2622> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Treasurers of the Other Gods (Collective authorities)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1998> ;
    skos:scopeNote "Magistrates in ancient Athens from the year 434 BCE onwards. The treasurers of the Other Gods were ten in number, initially annually selected. They had the duty to concentrate the treasures of the various temples on the Acropolis in front of the Assembly. For some time, they were also in charge of certain public payments in place of the apodektai."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2044> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2622> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Treasurers of Athena (Collective authorities)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1999> ;
    skos:scopeNote "Magistrates in ancient Athens. The treasurers of Athena were initially annually selected but later they served for four years from one Panathenaic festival to another. They were responsible for all things relevant to the festival, and also for the custody of the Parthenon, its religious and dedicatory objects. Moreover, they were the keepers of the list of citizens organized by tribe (katalogoi). During the 5th c. BCE they were also responsible for the safe-keeping of the state&#39;s budget surplus and the execution of payments related to the construction works on the Acropolis."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2045> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2622> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Apodektai (Collective authorities)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2000> ;
    skos:scopeNote "Magistrates in ancient Athens. The apodektai were ten in number and were appointed by lot. They received certain state revenues and apportioned them (merizein) as directed by law among separate spending authorities. They also kept lists of persons indebted to the state, made entries of all monies that were paid in, and erased the names of the debtors from the lists. Moreover, they executed some payments and had the power to decide cases connected with the subjects under their management, but only up to 10 drachms."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2051> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Agoranomos (ancient Athens)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2052> ;
    skos:scopeNote "An office known in many ancient Greek states. In Athens there were ten, five for the city and five for Piraeus. They kept order in the market, saw to the quality of goods and cleanliness of the Agora. They also had the right to impose punishments or fines on those who violated the market laws."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2052> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2622> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Agoranomoi (Collective authorities)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2051> ;
    skos:scopeNote "Magistrates known in many ancient Greek states. In Athens there were ten, five for the city and five for Piraeus. They kept order in the market, saw to the quality of goods and cleanliness of the Agora. They also had the right to impose punishments or fines on those who violated the market laws."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2053> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Metronomos (ancient Athens)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2054> ;
    skos:scopeNote "An office that occurs in ancient Athens. They were ten, five for the city and five for Piraeus. Their duty was to ensure the validity of weights and measures in the market. Although we have no direct evidence regarding how these officials enforced the law, it seems likely that they could impose fines up to a specific limit and bring suits just like other market officials."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2054> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2622> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Metronomoi (Collective authorities)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2053> ;
    skos:scopeNote "Magistrates in ancient Athens. They were ten, five for the city and five for Piraeus. Their duty was to ensure the validity of weights and measures in the market. Although we have no direct evidence regarding how these officials enforced the law, it seems likely that they could impose fines up to a specific limit and bring suits just like other market officials."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2065> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/285> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Antidosis"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1988> ;
    skos:scopeNote "A procedure that appears in ancient Athens during the process of assigning and assuming the liturgies of the wealthiest citizens. One citizen had the right to refuse to assume the liturgy and to challenge another to either undertake it on the grounds that he considered him better qualified to bear the expense or to exchange their properties by means of the antidosis. If the person challenged refused, the case was brought to court."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2066> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Sitophylax (ancient Athens)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2067> ;
    skos:scopeNote "Athenian officers originally ten in number but later in the 4th c. BCE, twenty in the city and fifteen in Piraeus. Sitophylakes registered all imports of corn and superintended the sale of flour, corn and bread to see that they were sold by lawful measure. It seems that they could also impose fines up to a specific limit and bring suits just like other market officials."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2067> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2622> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Sitophylakes (Collective authorities)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2066> ;
    skos:scopeNote "Magistrates in ancient Athens, originally ten in number but later in the 4th c. BCE, twenty in the city and fifteen in Piraeus. Sitophylakes registered all imports of corn and superintended the sale of flour, corn and bread to see that they were sold by lawful measure. It seems that they could also impose fines up to a specific limit and bring suits just like other market officials."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2070> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Athlothetes (ancient Athens)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2071> ;
    skos:scopeNote "Official in ancient Athens, in charge of certain aspects of the Panathenaia. The athlothetai were ten in number, chosen by lot, and stayed in office for four years. They arranged the procession, and the musical, gymnastic and equestrian games. They were responsible for the making of the peplos, and together with the Boule for the making of the amphorae. Moreover, they gave the oil to the athletes."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2071> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2622> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Athlothetai (Collective authorities)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2070> ;
    skos:scopeNote "Magistrates in ancient Athens, who managed certain aspects of the Panathenaia. The athlothetai were ten in number, chosen by lot, and stayed in office for four years. They arranged the procession, and the musical, gymnastic and equestrian games. With the Boule, they provided the peplos and prize amphorae. Moreover, they gave the oil to the athletes."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2072> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Episkeuastes (ancient Athens)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2073> ;
    skos:scopeNote "Official in ancient Athens. The episkeuastai were ten men, selected by lot each year. Their duty was to repair those sanctuaries especially in need of it. For this purpose they received 30 mnai from the Apodektai."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2073> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2622> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Episkeuastai (Collective authorities)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2072> ;
    skos:scopeNote "Magistrates in ancient Athens. The episkeuastai were ten men, selected by lot each year. Their duty was to repair those sanctuaries especially in need of it. For this purpose they received 30 mnai from the Apodektai."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2076> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Epimeletes of the Mysteries (ancient Athens)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2077> ;
    skos:scopeNote "Official in ancient Athens. The epimeletai of the Mysteries were four in number and were elected by the Demos, two from all the Athenians, and one each of the Eumolpidae and the Kerykes. They were to administer the Eleusinian Mysteries obeying the orders of the Basileus."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2077> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2622> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Epimeletai of the Mysteries (Collective authorities)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2076> ;
    skos:scopeNote "Magistrates in ancient Athens. The epimeletai of the Mysteries were four in number and were elected by the Demos, two from all the Athenians, and one each from among the Eumolpidae and the Kerykes. Their duty was to administer the Eleusinian Mysteries obeying the orders of the Basileus."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2078> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Hodopoios (ancient Athens)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2079> ;
    skos:scopeNote "Official in ancient Athens. The hodopoioi were five in number, appointed by lot annually. Their duty was to keep the roads in a good condition, employing public slaves as workmen."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2079> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2622> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Hodopoioi (Collective authorities)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2078> ;
    skos:scopeNote "Magistrates in ancient Athens. The hodopoioi were five in number, appointed by lot annually. Their duty was to keep the roads in a good condition, employing public slaves as workmen."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2084> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Citizenship (honor awarded)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1354> ;
    skos:scopeNote "An honor awarded to foreigners in ancient Athens. It involved granting foreigners the right to become Athenian citizens in recompense for outstanding services toward Athens. Citizenship was the highest honor that could be awarded to foreigners, and in some cases, it was also awarded to his descendants."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2085> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Isoteleia"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1218> ;
    skos:scopeNote "A privilege granted to metics in ancient Athens. It involved tax equality of the metics with regard to Athenian citizens, with whom the foreigners had the same obligations."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2095> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/285> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Damnatio memoriae"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2096> ;
    skos:scopeNote "A procedure that appears in ancient Rome, according to which the Senate, the emperor, or even the army imposed a &quot;condemnation of memory&quot; on persons, who were considered dangerous for the safety of the state due to their actions. The punishment involved the elimination of any testimony of the person&#39;s existence and was accompanied by confiscation of his property, withdrawal, alteration, or destruction of sculptures and other illustrations and the scraping of his name from inscriptions and public texts etc."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2096> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/29> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Rasurae"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2095> ;
    skos:scopeNote "The deliberate deletion of selected letters of an inscription by the cutter. It was a common practice when he wished to correct the content of an inscription or at a later period (in Roman times) in cases of Damnatio memoriae."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/210> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/29> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Skin"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2579> ;
    skos:scopeNote "The natural outer covering that protects the body of humans or animals, and stimulates the sense of touch."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2157> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/26> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Thesmothetai (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1985> ;
    skos:scopeNote "A college of six magistrates in ancient Athens, who belonged to the so-called nine archons. Their duties were mainly legal. They were responsible for hearing several kinds of cases (such as cases of graphe). They also determined the time and the place where the courts would be in session."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2174> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/17> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Periakten"@de,
        "Periaktoi"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/966> ;
    skos:scopeNote "Periaktoi were revolving triangular prisms made of wood on the stage of the ancient theatre, bearing on each of its three sides a different pictured scene. They were usually placed to the right and left of the logeion on square frames and rotated around an axis, changing the scenery when needed. They represented places that the stage building could not represent (e.g. the countryside, the port). The periaktoi were revived, notably for the Renaissance theatre and for the 17th-century English stage."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2185> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2159> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "A posteriori languages"@en ;
    skos:scopeNote "An a posteriori language (from Latin a posteriori - from the latter), according to Louis Couturat, is any constructed language whose elements are borrowed or based on existing languages, as opposed to the a priori languages. The a posteriori languages can be divided into three categories: (a) Simplified ethnic languages, like Basic English or Latino sine flexione (b) Naturalistic languages, i.e. closest to the real ethnic languages (most often Latin or Romance languages), like the Occidental language or Interlingua (c) Autonomous (schematic) languages, in which grammar is a priori but vocabulary is a posteriori, like Esperanto or, to some extent, Volap&uuml;k. In distinguishing whether the language is a priori or a posteriori the prevalence and distribution of respectable traits is often the key."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2186> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/285> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Issue (Numismatics)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444> ;
    skos:scopeNote "The process of offιcially placing a coin into circulation."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2193> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/978> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Catalogues of victors in athletic games"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1093> ;
    skos:scopeNote "Inscriptions comprising catalogues with the names of victors in athletic games that were Panhellenic or held locally in various regions of ancient Greece. These catalogues include the names of the victors and the sports in which they were distinguished."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2194> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/978> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Αthletic games recognition decrees"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/742> ;
    skos:scopeNote "Inscriptions recording decrees by which a local athletic game in an area of ​​ancient Greece, is recognized as Panhellenic. Such recognition meant enhancing the city's prestige both financially and diplomatically."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2200> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Episkopos (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2289> ;
    skos:scopeNote "The episkopoi were annual magistrates appointed by lot and sent to the cities in the Delian Confederacy to sit in judgement on differences that arose out of the implementation of the treaties."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2201> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1093> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Catalogues of eponymous archons"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1953> ;
    skos:scopeNote "Inscriptions containing catalogues with the names of persons who held the office of eponymous archon in ancient Greece. These lists are of particular importance for the dating of inscriptions, which contain names of eponymous archons, as the eponymous archon gave his name to the year of his term of office."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2202> a skos:Concept ;
    skos:altLabel "Apron"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/17> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Vorbühne"@de,
        "Forestage"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/683> ;
    skos:scopeNote "The apron is any part of the stage that extends past the proscenium arch and into the audience. In proscenium stages, the part of the stage which projects in front of the closed curtain."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2215> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Hieromnemon (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2218> ;
    skos:scopeNote "Member of the commission sent by the Greek cities in antiquity as representatives at the Amphictyony councils (Pylaiai). His duties were to take care of matters concerning the sanctuary which was the center of each Amphictyony. As the Amphictyonies, besides being religious, also ended up being political in nature, the Hieromnemones had the jurisdiction to punish or even to proclaim a sacred war against cities that would try to abandon the Amphictyony."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2217> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/26> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Terrorist groups"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/937> ;
    skos:scopeNote "Organised groups that engage in planning and executing terrorist attacks. Many terrorist organsations are the result of a split between moderate and radical wings of an already existing political or religious organisation. Generalised political and social unrest, as well as the alienation of parts of the population from dominant ideological, social, economic, and political structures play an important role in the formation of terrorist organisations. Terrorist organisations function as conspiratorial groups; they may receive overt or covert support from networks of sympathisers, from political organisations, from the media, from economic agents, or even from state and deep-state organisations."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2218> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Pylagoras (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2215> ;
    skos:scopeNote "Member of the commission sent by the Greek cities in antiquity as representatives at the Amphictyony councils (Pylaiai). The Pylagorοi were elected annually and had the duty to defend the interests of their city at the Amphictyonic councils."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2234> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/315> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Sports competitions"@en ;
    skos:scopeNote "Sports competitions cover a wide range of events from local sports competitions to the Olympic Games. Such events, apart from being competitions between elite athletes or even mass participants, are social -and often media- occasions that bring together small or great numbers of people and a series of economic and cultural activities. Sports competitions can be categorised according to their sporting characteristics, their spatial and temporal characteristics, their size, their financial characteristics, and their renown."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2271> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1742> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Anagrapheis"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2273> ;
    skos:scopeNote "An office that appears in ancient Athens. The anagrapheis were a group of persons who, with the establishment of the democratic regime in Athens (marked by the fall of the Four Hundred in 411 BC), were responsible for the collection and publication of the Athenian laws, and for the republication of the laws of Draco and the laws of Solon that were still in force."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2273> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Anagrapheus (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2271> ;
    skos:scopeNote "An office that appears in ancient Athens. The Anagrapheas belonged to the group of anagrapheis who, with the establishment of the democratic regime in Athens (marked by the fall of the Four Hundred in 411 BC), were responsible for the collection and publication of the Athenian laws, and for the republication of the laws of Draco and the laws of Solon that were still in force."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2281> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2279> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Harlekin"@de,
        "Harlequin"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2274> ;
    skos:scopeNote "Harlequin is the best-known of the zanni or comic servant types in the Italian Commedia dell&#39; arte. He is characterised by his patched costume of multicoloured triangles complemented by a black mask. His role is that of a light-hearted, nimble, and astute servant, the shadow of his master, the matchmaker and mediator of his love stories. He undertakes intrigues on his behalf and always gets into scrapes, while he often acts to thwart his plans, and pursue his own love interest. His contribution to the performance is pivotal, dominating the stage with his jokes, sketches, and acrobatics."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2289> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Phrourarchos (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2200> ;
    skos:scopeNote "An office that appears in ancient Athens. Phrourarchos was the commander of the garrisons established by the Athenians in allied cities in order to exercise their authority over them."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/229> a skos:Concept ;
    skos:altLabel "Alienation effect"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/31> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Verfremdungseffekt"@de,
        "Estrangement effect"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/570> ;
    skos:scopeNote "Method of taking distance from the represented reality. It comprises techniques that abolish illusion and reveal the stratagem of the dramatic construction or the characters. In Epic Theatre that aimed at altering the attitude of the spectator and activating his perception, distanciation marks the shift from the field of aesthetics to the ideological responsibility of the work of art."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2298> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2534> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Capitano"@de,
        "Capitano"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2274> ;
    skos:scopeNote "Theatrical type (stock figure) of the Commedia dell&rsquo; arte that took on several different names, derived from&nbsp;Plautus&rsquo;s <em>Miles gloriosus</em> and having vanity as the common theme. Capitano is the vainglorious, deceitful braggart soldier. He is exaggerated and flashy, but in essence cowardly and stupid. His part usually involves his boasting of great exploits of war and amatory successes, but he is also the subject of pranks and jokes by the other characters. His costume has undergone many changes but has always alluded to military attire, with a feathered cap and a large sword."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2308> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2349> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Struck coins"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444> ;
    skos:scopeNote "Coins that were made by striking. The blank flans were heated to soften and then the first minter took the heated flan and held it in place between the two dies, the fixed one, the anvil, and the moveable one, the character, while a second minter struck with a hammer. Thus, the blank flan was stamped with the representations on the dies. The majority of ancient coins were struck."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2315> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Heraldic coins"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444> ;
    skos:scopeNote "Τhe earliest coinage of Athens. They are so called because they depicted a wide range of types once thought to be emblems of powerful Athenian families. The series consists of silver didrachms, subsidiary denominations and later on tetradrachms, that were intended for local use. Heraldic coins were first introduced around 546 BCE and were replaced by the glaukes towards the end of the sixth century BCE."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2328> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/26> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Kanephoroi"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2329> ;
    skos:scopeNote "Title attributed to a young woman of a noble family who participated in religious processions in antiquity. She occupied a prominent position in the procession carrying a canister (basket) with offerings and the necessary utensils for the sacrifice. The number of kanephoroi who participated in the various religious processions (Dionysian, Panathenaic etc.) was not fixed."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2329> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/26> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Epimeletai of procession"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2328> ;
    skos:scopeNote "Officials in ancient Athens who bore the expense of a religious procession and were responsible for organising it. Later on, the State paid 100 mnai to the epimelitai for procuring the necessary equipment."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2330> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Treasurer of the military fund (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Elected officer who, together with the official ἐπὶ τῆι διοικήσει (responsible for financial administration), was responsible for covering the costs of engraving inscriptions from the military fund. The military fund was created in 373 BC in order to collect war funds οn time."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2338> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1747> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ismailis (Shia branch)"@en ;
    skos:scopeNote "The Ismailis constitute the second largest Shia community after the Twelvers and are scattered in more than twenty countries of Asia, Africa, Europe and America. Ismailis and Twelvers are both branches of the Imami Shiites, who acknowledge the successors of Muhammad and Ali, his son-in-law, as leaders of the Muslims. Twelvers amd Ismailis differ as to the line of succession of the imams after the first six imams, whom they both recognise. Moreover, most of the Ismailis believe that the line of the Imams continues to this day."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2358> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Amphictyonic coins"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444> ;
    skos:scopeNote "Coins that were issued by an amphictyony, that is a religious association of ancient Greek cities formed around a common religious center."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2367> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1467> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Milesian weight standard"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444> ;
    skos:scopeNote "The Milesian was the oldest weight standard. It was based on a stater of 14.2 gr. which at first was divided into thirds, sixths, twelfths etc. Sometime later this system was replaced by the Mainland system with division of fourths, that is drachms, and obols."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2389> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Hellespontophylax (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2392> ;
    skos:scopeNote "An office that appears in ancient Athens. Hellespontophylax was a special official established in the area of the Hellespont to check cargos of corn coming from the granary of the ancient city Byzantium, probably after the beginning of the Peloponnesian War."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2390> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/362> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Sanides (Bearers of inscriptions)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/69> ;
    skos:scopeNote "Wooden tablets covered with gypsum on which public announcements were written during antiquity.&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2392> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1742> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Hellestontophylakes"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2389> ;
    skos:scopeNote "Committee of special officials established in the area of the Hellespont to check cargos of corn coming from the granary of the ancient city Byzantium, probably after the beginning of the Peloponnesian War."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2420> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1581> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Metaphysics"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2529> ;
    skos:scopeNote "Broad area of philosophy that raises questions about the nature, constitution and structure of reality, which lie beyond and behind those capable of being tackled by the methods of science. Therefore, metaphysics is broader in scope and more fundamental than science. Some of the more traditional questions of metaphysics are those of mind and body, events, causation, as well as questions on the existence (being), the characteristics and the categories of beings. This last group of questions belong to that branch of metaphysics called \"ontology\", which is often used as a synonym of metaphysics."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2446> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Prosodos (privilege in ancient Athens)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1218> ;
    skos:scopeNote "A privilege granted to foreigners in ancient Athens. Prosodos was the right of a foreigner or a group of people from another city to appear directly before the Council and the Assembly without the offices of an intermediary. The grant of this privilege was registered in the honorific decree which recorded the resolution of the Assembly."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2500> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1888> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Barometers"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2501> ;
    skos:scopeNote "Scientific instruments for measuring atmospheric pressure. The two main types are the mercury barometer and the aneroid barometer. The mercury barometer grew out of investigations and demonstations for the existence of vacuum in the first half of the 17th century and was later used as an instrument to measure the variation in pressure of the air and the heights. The aneroid barometer was constructed in the middle of the 19th century and became popular among mountaineers and mariners due to its robustness and portability."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2503> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1888> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Hygrometers"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2501> ;
    skos:scopeNote "Meteorological instrument for measuring humidity in the atmosphere. A first version was constructed in the 15h century. However, the scientific character of the hygrometer was established in the 18th century, contributing to the development of meteorology. The hygrometer for determining humidity by the motion of a piece of animal matter, such as hair or ivory, was very popular in the 18th century."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/251> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Exogamy"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/288> ;
    skos:scopeNote "The rules that enforce marriages exclusively between members of different social, tribal, or kinship groups."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2518> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2039> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Intergovernmental organisations"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2517> ;
    skos:scopeNote "International organisations in which full legal membership is officially solely open to states and the decision-making authority lies with representatives from governments. Intergovernmental organisations are considered as one of the main actors who play a regular part in global politics."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2523> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1575> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Philosophy of psychology"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2463> ;
    skos:scopeNote "A branch of the philosophy of science that examines what psychology argues about the nature of psychological phenomena; it examines aspects of psychological theorizing such as the models used, explanations offered, and laws invoked; and it also examines how psychology fits with the social sciences and natural sciences."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2532> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2525> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Experimental psychology"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2529> ;
    skos:scopeNote "In a broad sense, the application of experimental methods (including systematic manipulation and control of relevant<br />variables, careful observation, and, often, statistical analysis) to any area in psychology. More narrowly, some central problem areas in psychology that have typically and traditionally been investigated (since the middle of the 19th century) with experimental methods, including sensation and&nbsp;perception, learning and motivation, reaction time, psychophysics and physiological psychology."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/254> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/105> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/255> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Realism"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1912> ;
    skos:scopeNote "Realism was an artistic movement that began in France in the 1850s, after the 1848 Revolution. Realists rejected Romanticism, which had dominated French literature and art since the late 18th century. Realism revolted against the exotic subject matter and exaggerated emotionalism and drama of the Romantic Movement. Instead, it sought to portray real and typical contemporary people and situations with truth and accuracy, and not avoiding unpleasant or sordid aspects of life.<br />Realism in art (applied in visual arts, theatre, and literature) is the portrayal of scenes, objects, and people in ways that are immediately intelligible to the viewer, spectator or reader, with the themes focusing on the reality of life as it is, without idealisation."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2565> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/28> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ιntentional fallacy (Literature)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2566> ;
    skos:scopeNote "The wrong belief in the author&rsquo;s intention. It is an&nbsp;important term of new criticism aimed against interpretations which try to reconstruct the author&rsquo;s original intentions when writing a literary text and which thereby neglects intrinsic aspects of the text."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2566> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/28> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Affective fallacy (Literature)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2565> ;
    skos:scopeNote "Important term of the new criticism, attacking any kind of interpretation that&nbsp;considers the reader&rsquo;s emotional reactions to a literary text relevant in the scholarly analysis of text."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/257> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/31> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Anrede ans Publikum"@de,
        "Address to the audience"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1802> ;
    skos:scopeNote "As a technique of distanciation and disillusionment, the address to the public is a function during which the actor addresses part of the text (improvised or not) directly to the audience, stepping out of the role and smashing theatre illusion and fiction."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2579> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/24> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Leather"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/210> ;
    skos:scopeNote "Tanned skins and hides of animals, used as raw material in the production of other materials and articles (mainly leather garments)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2599> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/285> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Standardisation"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2520> ;
    skos:scopeNote "The establishment of specifications for the measurement, design, and performance of processes and products of science, technology and industry, or society in general. These specifications are either administered voluntarily or enforced by some authority, and apply at a national or international level."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/260> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Fairy tales"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/613> ;
    skos:scopeNote "EN: Short educational stories with allegorical connotations that unfold in consecutive acts and feature imaginary characters as well as elements of the natural and supernatural realms."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2605> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1888> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Sundials"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2195> ;
    skos:scopeNote "Instruments that determine the local time by means of a shadow cast by a gnomon onto a surface marked in hours. Sundials date back&nbsp;to Antiquity, but became especially popular between the 16th and 19th centuries for checking if mechanical clocks, which were becoming more and more common, were keeping correct time."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2606> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/28> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Tacit knowledge"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1508> ;
    skos:scopeNote "The knowledge which is clear and concrete, but cannot be put into words. Tacit knowledge is implicit and this implicit core binds together the knowing person, the object of their attention,&nbsp;and a tradition shared with the group to which the person belongs."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2608> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/20> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Urbanisation"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/315> ;
    skos:scopeNote "The process by which large numbers of people&nbsp;migrate to and establish residence in relatively dense areas of population (cities). As a result, there is a considerable shift in their everyday life, while their social relationships are affected significantly. Urbanisation stands also for the process of the engagement of an even greater proportion of the population of a given region with urban economic activities, as well as for the process&nbsp;by which the urban becomes the dominant feature of all landscapes: physical, economic, political, social, and cultural."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2613> a skos:Concept ;
    skos:altLabel "Gramophones"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/24> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Phonographs"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2470> ;
    skos:scopeNote "Devices for recording and reproducing sound by means of a stylus needle vibrating in grooves carved into a cylinder or disc, whose rotation was powered by hand or a clockwork motor. The phonograph appeared in the 19th century as a scientific curiosity, and by the early 20th century it had become a key component technology of the entertainment industry."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2618> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2622> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Kosmoi (Collective authorities)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2619> ;
    skos:scopeNote "The chief officials in ancient Gortyn. They were ten in number and were elected from certain tribes only. Their duties included leading in war, religious duties, adjudicating cases where foreigners were involved, adoption, caring for an heiress, and introducing laws for approval to the assembly of the citizens."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2619> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Kosmos (ancient Gortyn)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2618> ;
    skos:scopeNote "The chief office in ancient Gortyn. They were ten in number and were elected from certain tribes only. Their duties included leading in war, religious duties, adjudicating cases where foreigners were involved, adoption, caring for an heiress, and introducing laws for approval to the assembly of the citizens."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2620> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2622> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Politarchai (Collective authorities)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2623> ;
    skos:scopeNote "A distinctively Makedonian board of magistrates attested in Beroia, Amphipolis, Philippopolis, Thessalonike and poleis under Makedonian influence. Introduced in the late 3rd or early 2nd c. BCE, there were, initially, two, but in Roman times their number was increased to five. They had executive power, they could introduce laws, convene and preside in the Assembly and the Council.&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2623> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Politarches (ancient Macedonia)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2620> ;
    skos:scopeNote "A distinctively Makedonian magistrate attested in Beroia, Amphipolis, Philippopolis, Thessalonike and poleis under Makedonian influence. Introduced in the late 3rd or early 2nd c. BCE, there were, initially, two, but in Roman times their number was increased to five. They had executive power, they could introduce laws, convene and preside in the assembly and the Council.&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2631> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1321> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Portrait painting"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2015> ;
    skos:scopeNote "Painting genre having as its subject matter the representation of a particular person that depicts something of the person&#39;s character.&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2632> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1321> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Landscape painting"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2020> ;
    skos:scopeNote "Painting genre having as its subject matter outdoor scenes dominated by natural elements (such as the land, hills, fields, , sky, trees, rivers) which may also inlude figures or architecture. In the landscape painting, painters usually choose a distant point of view and focus primarily on the land.&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/274> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/30> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Fasting period"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/145> ;
    skos:scopeNote "The period of abstinence from certain foods and/or actions."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/275> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/21> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Magic (function)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/82> ;
    skos:scopeNote "The practice of invoking -or preventing- the intervention of supernatural forces in order to provoke beneficial or harmful repercussions on certain persons or groups of persons."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/324> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Conceptual Art"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1250> ;
    skos:scopeNote "A widespread movement from the mid-1960s through the 1970s. Conceptual Αrt emphasized the artist’s thinking, making any activity or thought an artwork without the necessity of translating it into physical form."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/332> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/31> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Genealogical method"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1613> ;
    skos:scopeNote "Method of research focusing on the identification and description of the structure of a given population with the use of family trees."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/356> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/94> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Scalpels"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Sharp-ended tools used to render details and letters of the inscriptions on the engraving surface."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/369> a skos:Concept ;
    skos:altLabel "Holy scriptures"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/240> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Holy writs"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/256> ;
    skos:scopeNote "The authoritative texts of major religions, such as the Torah for Judaism, the Bible for Christianity, and the Quran for Islam. Holy writs, crystallized in a standard, canonized form defined and accepted by religious authorities, proclaim the fundamental beliefs of every religion and stipulate the systems of worship and commands that must be followed by the faithful. Holy writs are considered to have a divine origin or to be the outcome of divine inspiration."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/38> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/225> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
