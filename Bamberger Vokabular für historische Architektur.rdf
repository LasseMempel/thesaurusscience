    <!-- https://hist-arch-vocab.org/bvha#c_a3280435 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_a3280435">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_39738fa5"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_b41bd73a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-18T08:27:10.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-18T08:28:21.000</terms:modified>
        <skos:definition xml:lang="de">Art der Verglasung. Um ein rundes Glas in der Mitte eines rechteckigen Glasfeldes (i. d. R. eine Butze, aber auch runde Gläser aus Mond- oder Zylinderglas ausgeschnitten) gruppieren sich vier Glasviertel, die zum runden Glas entsprechend ausgeschnitten sind. Die einzelnen Gläser sind mit Bleiruten verbunden. [Noky 1996]</skos:definition>
        <skos:prefLabel xml:lang="de">Quartierscheiben</skos:prefLabel>
    </owl:NamedIndividual>
    


