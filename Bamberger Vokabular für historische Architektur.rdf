        <skos:definition xml:lang="de">Von einem Peristyl umgebener Hof. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Peristylhof</skos:prefLabel>
    </owl:NamedIndividual>
    


