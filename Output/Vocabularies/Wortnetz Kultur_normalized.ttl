    skos:broader <http://lvr.vocnet.org/wnk/wk002510> ;
    skos:definition "Ein Bruchstein ist ein Naturstein, der durch Sprengen oder Abbruch in Steinbrüchen abgebaut und nicht weiter bearbeitet wird. Als umdimensionierter Stein weist er unregelmäßige Kanten und Oberflächen auf."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4242486-0> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
