	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/169">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/169</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">PRÌOSAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite tèarainte far a bheilear a' cumail daoine a tha a' feitheamh ri cùis lagha no air an deach binn prìosain a chur.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">JAIL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/167" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/170" />
		<skos:scopeNote xml:lang="en">A secure place where persons sentenced to imprisonment or persons awaiting trial are confined.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
