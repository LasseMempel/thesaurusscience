        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-25T12:46:31.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-18T15:02:48.000</terms:modified>
        <skos:definition xml:lang="de">Bastille (frz.), einem Burg- oder Stadttor vorgelagerte, ringförmige Befestigung mit Türmen, größer als die Barbakane und ständig mit einer Truppe besetzt. [Koepf / Binding 2016]</skos:definition>
