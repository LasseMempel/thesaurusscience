		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/198" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/317" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/401" />
		<skos:scopeNote xml:lang="en">A ditch which forms part of a defensive barrier around a town.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/401">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/401</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BALLA A' BHAILE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Balla daingnichte a tha na pàirt de bhacadh dìona mun cuairt air baile.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TOWN WALL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/399" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/400" />
		<skos:scopeNote xml:lang="en">A fortified wall, forming part of a defensive barrier around a town or city.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
