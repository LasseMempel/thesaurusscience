    <!-- https://hist-arch-vocab.org/bvha#c_9e8715ac -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_9e8715ac">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a36fd146"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-14T16:22:10.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T23:53:35.000</terms:modified>
        <skos:altLabel xml:lang="cs">radnice </skos:altLabel>
        <skos:definition xml:lang="de">Halle oder Saal für öffentl. Veranstaltungen, Konzerte, z. T. auch Bühnenvorführungen, in neuerer Zeit auch für Sportveranstaltungen. Waren die urspr. S.n meist Saalbauten, so wurden in neuerer Zeit auch Großraumkonstruktionen mit zentralisierendem Grundriss entwickelt. Verschiedenen Veranstaltungen dienen die Mehrzweckhallen, die durch Veränderung der Einrichtung der jeweiligen Funktion angepasst werden können. Die Zuschauerränge sind meist amphitheatral. angeordnet. Da die Besucherzahlen der einzelnen Veranstaltungen oft sehr unterschiedl. sind, werden teilweise auch mehrere Säle verschiedener Größe zu einem S.ngebäude zusammengefasst. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Stadthalle</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">halle municipale</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">městská hala</skos:prefLabel>
        <skos:prefLabel xml:lang="es">salón municipal</skos:prefLabel>
        <skos:prefLabel xml:lang="en">town hall</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_9e9094e8 -->


