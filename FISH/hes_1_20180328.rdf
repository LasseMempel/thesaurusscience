	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/167">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/167</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">PRÌOSAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite far an cumar an greim eucoirich. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PRISON</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/161" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/170" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/169" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/168">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/168</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">BORSTAL</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Institiuid airson prìosanachadh agus trèanadh dhaoine òga eadar aois 16-21 agus a chaidh a stèidheachadh gu h-oifigeil ann an 1908. Chaidh Aonadan Glacas na h-Òigridh a chur nan àite ann an 1982.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">BORSTAL</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/167" />
				<skos:scopeNote xml:lang="en">An institution for the imprisonment and training of 16-21 year olds first established officially in 1908. Replaced by Youth Custody Centres in 1982.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/503625">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/503625</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">PRÌOSAN DHAOINE ÒGA</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Institiud far a bheilear a' cumail an greim eucoirich a tha fo aois uallaich.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">JUVENILE PRISON</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-25T16:26:57</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-25T16:27:02</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:altLabel xml:lang="en">YOUNG OFFENDERS INSTITUTE</skos:altLabel>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/167" />
				<skos:scopeNote xml:lang="en">A custodial institution for offenders below the legal age of responsibility.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
