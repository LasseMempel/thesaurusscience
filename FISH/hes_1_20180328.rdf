		<skos:prefLabel xml:lang="gd">IONAD-OBRACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Buidheann-gnìomha an riaghaltais a bheir seachad fiosrachadh air obair, trèanadh is ath-thrèanadh do dhaoine a tha gun obair.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">JOB CENTRE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-10-20T08:23:50</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-10-20T08:25:30</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
