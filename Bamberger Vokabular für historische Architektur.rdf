        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T18:22:46.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T13:24:22.000</terms:modified>
        <skos:definition xml:lang="de">Ein seitl. der Apsis oder des Chors am Übergang zum Chorjoch auf jeder Seite beigestellter Turm, zumeist quadrat., aber auch rund, seit Anfang des 11. Jhs. bekannt, bes. bei den stauf. Kirchen im Rheinland. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Chorflankenturm</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">chórová flankovací věž</skos:prefLabel>
    </owl:NamedIndividual>
    


