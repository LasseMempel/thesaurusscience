	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk012873">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Eiswagen (Lastfahrzeug)</skos:prefLabel>
		<skos:prefLabel xml:lang="en">ice wagon</skos:prefLabel>
		<skos:altLabel xml:lang="en">ice wagons</skos:altLabel>
