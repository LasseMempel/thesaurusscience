    <dc:publisher rdf:resource="https://historicengland.org.uk/"/>
    <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
    <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
    <skos:prefLabel xml:lang="en">Prehistoric</skos:prefLabel>
    <skos:scopeNote xml:lang="en">For monuments that can be identified only to a date range from Palaeolithic to Iron Age. Circa -1000000 BCE to 43 CE.</skos:scopeNote>
    <skos:notation xml:lang="en">PR</skos:notation>
  </skos:Concept>

  <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_period/concepts/RO">
