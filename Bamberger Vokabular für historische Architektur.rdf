        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-05T17:34:19.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T17:43:18.000</terms:modified>
        <skos:altLabel xml:lang="de">Flügelrock</skos:altLabel>
        <skos:definition xml:lang="de">Flügelsuperpelliceum n, auch Flügelrock m, Superpelliceum mit  langen, flügelähnlichen Stoffbahnen anstelle der Ärmel. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Flügelsuperpelliceum</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">surplis à ailes</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_aa7a9a9b"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_7df544d2 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_7df544d2">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0660b156"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_fe6ee255"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_fd44f8d9"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-25T16:40:39.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T22:40:55.000</terms:modified>
        <skos:altLabel xml:lang="de">Chorlampe</skos:altLabel>
        <skos:altLabel xml:lang="de">Ewige Lampe</skos:altLabel>
        <skos:altLabel xml:lang="de">Ewiglichtlampe</skos:altLabel>
        <skos:altLabel xml:lang="fr">lampe du Saint-Sacrement</skos:altLabel>
        <skos:altLabel xml:lang="en">sanctuary light</skos:altLabel>
        <skos:altLabel xml:lang="fr">veilleuse</skos:altLabel>
        <skos:altLabel xml:lang="fr">veilleuse à perpétuité</skos:altLabel>
        <skos:definition xml:lang="de">Ewiges Licht n; auch Ewige Lampe f ; Chorlampe f; Ewiglichtlampe f; lat. lucerna aeterna: eine an drei Ketten hängende, mit Olivenöl gespeiste Lampe, die ständig vor dem Tabernakel brennen muss, in dem das Sakrament aufbewahrt wird und die nur an den drei letzten Tagen der Karwoche gelöscht wird. Das Ewige Licht gilt als Symbol der Gegenwart Christi als Licht der Welt (Joh 8, 12 ). Die Verwendung eines anderen vegetabilischen Öls bedarf der bischöflichen Genehmigung, die Benützung von Glühlicht bedarf der Erlaubnis durch den Heiligen Stuhl. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="cs">Olejová lampa hořící nepřetržitě před Nejsvětější svátostí oltářní (venerabile) v křesťanském kostele a v synagogách. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Öl-Ampel, die ständig vor dem Allerheiligsten (Venerabile) christlicher Kirchen und in Synagogen brennt. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Ewiges Licht</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">lampe du sanctuaire</skos:prefLabel>
        <skos:prefLabel xml:lang="la">lucerna aeterna</skos:prefLabel>
        <skos:prefLabel xml:lang="en">sanctuary-lamp</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">věčné světlo</skos:prefLabel>
    </owl:NamedIndividual>
    


