    skos:definition "occurrence of pollutants in soil above a certain level, causing a deterioration or loss of one or more soil functions"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "soil contamination"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/1101>,
        <http://www.eionet.europa.eu/gemet/concept/11676>,
        <http://www.eionet.europa.eu/gemet/concept/6904> .

<http://www.eionet.europa.eu/gemet/concept/15302> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1745> ;
    skos:definition "use of goods and services that respond to basic needs and bring a better quality of life, while minimising the use of natural resources, toxic materials and emissions of waste and pollutants over the life cycle, so as not to jeopardise the needs of future generations"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "sustainable consumption"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15103>,
        <http://www.eionet.europa.eu/gemet/concept/15106>,
        <http://www.eionet.europa.eu/gemet/concept/15280> .

<http://www.eionet.europa.eu/gemet/concept/15306> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8247> ;
    skos:definition "increase in per capita real income or real GNP which can be sustained in the long term (i.e. while maintaining macroeconomic stability and keeping pace with demographic changes)"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "sustainable growth"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15163>,
        <http://www.eionet.europa.eu/gemet/concept/15307>,
        <http://www.eionet.europa.eu/gemet/concept/6624> .

<http://www.eionet.europa.eu/gemet/concept/15307> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2877> ;
    skos:definition "management approach which efficiently integrates economic, environmental and social issues with the aim of creating long-term benefits and securing the support, cooperation, and trust of the local community in a way that will benefit the current and the future generations"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "sustainable management"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15109>,
        <http://www.eionet.europa.eu/gemet/concept/15306> .

<http://www.eionet.europa.eu/gemet/concept/15311> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2159> ;
    skos:definition "new definition: multi-dimensional and fundamental processes of change in socio-technical systems and their interactions with ecosystems"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "transition"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/8626> .

<http://www.eionet.europa.eu/gemet/concept/15323> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4183> ;
    skos:definition "destruction of waste where the main purpose of the destruction is the thermal treatment of waste in order to reduce the volume and the hazardousness of the waste."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "waste incineration"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/15056>,
        <http://www.eionet.europa.eu/gemet/concept/15325> .

<http://www.eionet.europa.eu/gemet/concept/15331> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2892> ;
    skos:definition "environmental sustainability in the management of water resources, via integrated ecosystem approaches, access to good quality water in sufficient quantity and contribution to the internationally agreed targets and goals relevant to water and socio-economic development"@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "water policy"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/12151>,
        <http://www.eionet.europa.eu/gemet/concept/740> .

<http://www.eionet.europa.eu/gemet/concept/15340> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15339> ;
    skos:definition "Written story lines (based on a literature review and on creative and logical thinking of the authors) used as parts of a horizon scan or a scenario study.  A story line consists of a coherent description of several possible or desirable future developments and/or events which can lead to a possible or desirable future."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
