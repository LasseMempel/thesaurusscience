    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Hydrocarbon"@en ;
    skos:scopeNote "An organic chemical compound composed exclusively of hydrogen and carbon atoms."@en .

<http://purl.org/heritagedata/schemes/73/concepts/171257> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75405> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Basalt"@en ;
    skos:scopeNote "A dark finegrained volcanic rock that sometimes displays a columnar structure, typically composed largely of plagioclase with pyroxene and olivine."@en .

<http://purl.org/heritagedata/schemes/73/concepts/171263> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75385> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Vegetal"@en ;
    skos:scopeNote "Pertaining to or deriving from a botanical living organism. Use narrower concepts where possible."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75342> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75338> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Bone"@en ;
    skos:scopeNote "Any of the pieces of hard tissue consisting largely of calcium phosphate that make up the skeleton of a vertebrate animal."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75345> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75381> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Cement"@en ;
    skos:scopeNote "Originally obtained by burning limestone to produce quicklime. Now a fine grey powder made from a mixture of limestone and clay used with water and sand to make mortar or with water, sand and aggregate to make concrete."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75361> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75381> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Glass"@en ;
    skos:related <http://purl.org/heritagedata/schemes/73/concepts/151858> ;
    skos:scopeNote "Transparent, hard substance made by fusing sodasilica which solidifies from a molten state."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75371> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75405> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Jadeite"@en ;
    skos:related <http://purl.org/heritagedata/schemes/73/concepts/146351> ;
    skos:scopeNote "A hard, translucent variety of jade which is rarer than the other varieties of nephrite as a result considered to be the best and very desirable."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75411> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75338> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Tooth"@en ;
    skos:scopeNote "A hard, bonelike material obtained from animal teeth."@en .

<http://purl.org/heritagedata/schemes/73/concepts/171264> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/171263> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Plant"@en ;
    skos:scopeNote "Any material derived from a tree, shrub or herb of cellulose form, normally subsisting in soil and producing its food through photosynthesis."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75395> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75381> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Quartz"@en ;
    skos:scopeNote "Hard, transparent, often coloured mineral. Can be found on its own as crystals and veins but also as a major constituent of rocks such as granite. Often used decoratively."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75394> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75381> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Pottery"@en ;
    skos:scopeNote "A ceramic made from clay and fired in a kiln or oven. This term has been used interchangeably with EARTHENWARE and with TERRACOTTA"@en .

<http://purl.org/heritagedata/schemes/73/concepts/75338> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75385> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Animal"@en ;
    skos:scopeNote "Material derived or formed from the corporeal parts of a member of the animal kingdom."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75335> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75380> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Alloy"@en ;
    skos:related <http://purl.org/heritagedata/schemes/73/concepts/143865> ;
    skos:scopeNote "A metallic substance made by combining two or more elements at least one of which is a metal. Use more specific terms where known."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75380> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75385> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Metal"@en ;
    skos:scopeNote "Class of elements and alloys that are characteristically lustrous,ductile, fusible and malleable. These are extracted from ore minerals originally existing in nature and processed before becoming a recognisable metal."@en .

