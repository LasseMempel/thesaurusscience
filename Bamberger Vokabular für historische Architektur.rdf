        <skos:altLabel xml:lang="de">Gebetskranz</skos:altLabel>
        <skos:altLabel xml:lang="de">Gebetsschnur</skos:altLabel>
        <skos:altLabel xml:lang="de">Paternoster</skos:altLabel>
        <skos:definition xml:lang="de">Rosenkranz m; auch Gebetskranz m; Gebetsschnur f ; Paternoster n; Iat. rosarium; corona: eine Kette mit großen und kleinen Perlen oder Kugeln, die in einer festgelegten Abfolge aufgereiht und denen bestimmte Gebete zugeordnet sind. Der Rosenkranz wird bei der Marienandacht benützt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Rosenkranz</skos:prefLabel>
        <skos:prefLabel xml:lang="la">rosarium</skos:prefLabel>
    </owl:NamedIndividual>
    


