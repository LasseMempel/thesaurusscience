    <!-- https://hist-arch-vocab.org/bvha#c_e6fbc506 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_e6fbc506">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_194f23d8"/>
