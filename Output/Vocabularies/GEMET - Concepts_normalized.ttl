    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Verweisinformation"@de,
        "referral information"@en .

<http://www.eionet.europa.eu/gemet/concept/14882> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4311> ;
    skos:definition "A coordinated assemblage of people, devices or other resources enabling the exchange of numerical data that has been collected, classified or interpreted for analysis."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Statistisches Informationssystem"@de,
        "statistical information system"@en .

<http://www.eionet.europa.eu/gemet/concept/14883> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4303> ;
    skos:definition "Knowledge pertaining to the collection, classification, analysis and interpretation of numerical data."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/4256> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Statistische Information"@de,
        "statistical information"@en .

<http://www.eionet.europa.eu/gemet/concept/14885> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14884> ;
    skos:definition "The provision of aid by library staff trained to interpret library materials and library organizational structures to meet the informational, educational, cultural, recreational or research needs of the library's clients."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Informationsvermittlungsdienst"@de,
        "reference service"@en .

<http://www.eionet.europa.eu/gemet/concept/14887> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14884> ;
    skos:definition "The service provided by a library in which the library's clients are temporarily allowed to use books and other printed materials outside the library."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/1079> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Dokumentenausleihe"@de,
        "document lending"@en .

<http://www.eionet.europa.eu/gemet/concept/14888> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14884> ;
    skos:definition "The service provided by one library in which a second library's clients are temporarily allowed to use books and other printed materials belonging to the first library; and consequently the system providing rules and infrastructure for this service to a group of libraries."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Fernleihe"@de,
        "inter-library loan"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Interlibrary_loan> .

<http://www.eionet.europa.eu/gemet/concept/14889> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14896> ;
    skos:closeMatch <http://dbpedia.org/resource/Selective_dissemination_of_information> ;
    skos:definition "A service provided by a library or other agency that periodically notifies users of new publications, report literature or other data sources in subjects in which the user has specified an interest."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Selektive Informationsverbreitung"@de,
        "selective dissemination of information"@en .

<http://www.eionet.europa.eu/gemet/concept/1489> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:closeMatch <http://dbpedia.org/resource/Clothing> ;
    skos:definition "Clothes considered as a group."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/4680> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bekleidung"@de,
        "clothing"@en .

<http://www.eionet.europa.eu/gemet/concept/14890> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14884> ;
    skos:definition "The provision of special aid by library staff trained to query bibliographic or other information contained on an electronic storage medium, usually to meet the research needs of the library's clients."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "CD-ROM Suchdienst"@de,
        "CD-ROM search service"@en .

<http://www.eionet.europa.eu/gemet/concept/14892> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4310> ;
    skos:definition "A central institution or agency for the collection, maintenance, and distribution of materials or data compiled to convey knowledge on some subject."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Informationsvermittlungsstelle"@de,
        "information clearing-house"@en .

<http://www.eionet.europa.eu/gemet/concept/14893> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4311> ;
    skos:definition "A coordinated assemblage of people, devices or other resources that analyzes, typically, business data and presents it so that users can make business decisions more easily."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_49868> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Entscheidungshilfesystem"@de,
        "decision-support system"@en .

<http://www.eionet.europa.eu/gemet/concept/14897> a skos:Concept ;
    skos:broadMatch <http://eurovoc.europa.eu/4821> ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1979> ;
    skos:closeMatch <http://dbpedia.org/resource/Relational_database> ;
    skos:definition "A collection of digital information items organized as a set of formally described tables from which the information can be accessed or reassembled in different ways without reorganizing the tables."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Relationale Datenbank"@de,
        "relational database"@en .

<http://www.eionet.europa.eu/gemet/concept/14898> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:definition "A remote sensing term referring to a scanning radiometer that simultaneously acquires images in various wavebands at the same time. A multispectral scanner can be carried aboard an aircraft or satellite. The Landsat multispectral scanner records images in four wavebands of visible and near infrared electromagnetic radiation to enable objects with different reflectance properties to be distinguished."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Multispektralscanner"@de,
        "multispectral scanner"@en .

<http://www.eionet.europa.eu/gemet/concept/14899> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:closeMatch <http://dbpedia.org/resource/Angular_resolution>,
        <http://dbpedia.org/resource/Spectral_resolution> ;
    skos:definition "A remote sensing term which has three separate applications: a) spatial resolution, which refers to the ability of a sensor to distinguish between objects that are spatially close to each other. It is a measure of the smallest angular or linear separation between two objects. b) Spectral resolution which refers to the ability of a sensor to distinguish between objects which are spectrally similar. It is a measure of both the discreteness of wavebands and the sensitivity of the sensor to distinguish between electromagnetic radiation intensity levels. c) Thermal resolution which refers to the ability of a sensor to distinguish between objects with a similar temperature."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Auflösung"@de,
        "resolution (parameter)"@en .

<http://www.eionet.europa.eu/gemet/concept/1490> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:exactMatch <http://eurovoc.europa.eu/1397> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bekleidungsindustrie"@de,
        "clothing industry"@en .

<http://www.eionet.europa.eu/gemet/concept/14900> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:closeMatch <http://dbpedia.org/resource/Pixel> ;
    skos:definition "A contraction of the words 'picture element'. The smallest unit of information in an image or raster map. Referred to as a resolution cell in an image or grid."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Pixel"@de,
        "pixel"@en .

<http://www.eionet.europa.eu/gemet/concept/14901> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6884> ;
    skos:definition "Closely grouped bands of lines characteristic of molecular gases of chemical compounds (spectroscopy)."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Spektralband"@de,
        "spectral band"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Spectral_bands> .

<http://www.eionet.europa.eu/gemet/concept/14902> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14924> ;
    skos:closeMatch <http://data.uba.de/umt/_00051120> ;
    skos:definition "A numeric string which uniquely identifies an image component of a geographical information system database."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Ortsbestimmung"@de,
        "scene identification"@en .

<http://www.eionet.europa.eu/gemet/concept/14903> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3645> ;
    skos:definition "A coordinated assemblage of computer devices designed to capture and manipulate pictures stored as data in discrete, quantized units or digits."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Digitales Bildverarbeitungssystem"@de,
        "image processing digital system"@en .

<http://www.eionet.europa.eu/gemet/concept/14905> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14924> ;
    skos:closeMatch <http://dbpedia.org/resource/Pattern_recognition> ;
    skos:definition "A remote sensing term referring to an automated process through which unidentified patterns can be classified into a limited number of discrete classes through comparison with other class-defining patterns or characteristics. Pattern recognition is an essential part of the classification of remotely sensed images and is used as an aid to image interpretation."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Mustererkennung"@de,
        "pattern recognition"@en .

<http://www.eionet.europa.eu/gemet/concept/14906> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6205> ;
    skos:closeMatch <http://dbpedia.org/resource/Mosaic> ;
    skos:definition "A composite photograph consisting of separate aerial photographs of overlapping surface areas, producing an overall image of a surface area too large to be depicted in a single aerial photograph."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Mosaik"@de,
        "mosaic"@en .

<http://www.eionet.europa.eu/gemet/concept/14907> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14904> ;
    skos:definition "A remote sensing term related to image enhancement that refers to the removal of a spatial component of electromagnetic radiation."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bildgebendes Filtern"@de,
        "image filtering"@en .

<http://www.eionet.europa.eu/gemet/concept/14908> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14904> ;
    skos:definition "In remote sensing, the filtering of data and other processes to manipulate pixels to produce an image that accentuates features of interest or visual interpretation."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bildverbesserung"@de,
        "image enhancement"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Image_editing> .

<http://www.eionet.europa.eu/gemet/concept/14909> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14904> ;
    skos:definition "A remote sensing term referring to the adjustment of an image for geometric errors."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Geometrische Korrektur"@de,
        "geometric correction"@en .

<http://www.eionet.europa.eu/gemet/concept/1491> a skos:Concept ;
    skos:broadMatch <http://eurovoc.europa.eu/89> ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5196> ;
    skos:closeMatch <http://data.uba.de/umt/_00027996>,
        <http://dbpedia.org/resource/Cloud> ;
    skos:definition "Suspensions of minute water droplets or ice crystals produced by the condensation of water vapour."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Wolke"@de,
        "cloud"@en .

<http://www.eionet.europa.eu/gemet/concept/14910> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14924> ;
    skos:closeMatch <http://dbpedia.org/resource/Image_registration> ;
    skos:definition "The process of linking map coordinates to control points with known earth-surface coordinates. Related term: coordinate systems."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bildüberlagerung"@de,
        "image registration"@en .

<http://www.eionet.europa.eu/gemet/concept/14912> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14911> ;
    skos:definition "A graphical representation processing technique by which an analyst selects groups of pixels, determines their spectral response signature and trains a computer system to recognize pixels based on this spectral response pattern."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Kontrollierte Bildklassifikation"@de,
        "supervised image classification"@en .

<http://www.eionet.europa.eu/gemet/concept/14913> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14911> ;
    skos:definition "Unsupervised classification is a kind of classification which takes place with minimum input from the operator; no training sample is available and subdivision of the feature space is achieved by identifying natural groupings of the measurement vectors."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Nichtkontrollierte Bildklassifikation"@de,
        "unsupervised image classification"@en .

<http://www.eionet.europa.eu/gemet/concept/14914> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14924> ;
    skos:definition "A remote-sensing term referring to the process of assigning different colours to different spectral bands. The colour picture formed by this process is called a \"colour composite\" (a colour image produced through optical combination of multiband images by projection through filters) and is produced by assigning a colour to an image of the Earth's surface recorded in a particular waveband. For a Landsat colour composite, the green waveband is coloured blue, the red waveband is coloured green and the infrared waveband is coloured red. This produces an image closely approximating a false colour photograph. Colour composite images are easier to interpret than separate images recording different wavebands. US national experimental crop inventories are based upon visual interpretation of Landsat colour composites."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Farbzusammensetzung"@de,
        "colour composition"@en .

<http://www.eionet.europa.eu/gemet/concept/14915> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14924> ;
    skos:closeMatch <http://data.uba.de/umt/_00051551>,
        <http://dbpedia.org/resource/Atmospheric_correction> ;
    skos:definition "The removal from the remotely sensed data of the atmospheric effects caused by the scattering and absorption of sunlight by particles; the removal of these effects improves not only the quality of the observed earth surface imaging but also the accuracy of classification of the ground objects."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Atmosphärische Korrektur"@de,
        "atmospheric correction"@en .

<http://www.eionet.europa.eu/gemet/concept/14916> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3645> ;
    skos:definition "An organized collection of computer hardware, software, geographic data, and personnel designed to efficiently capture, store, update, manipulate, analyze, and display all forms of geographically referenced information that can be drawn from different sources, both statistical and mapped."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "GIS Digitalsystem"@de,
        "GIS digital system"@en .

<http://www.eionet.europa.eu/gemet/concept/14917> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14933> ;
    skos:definition "The digital form of data collected by remote sensing."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "GIS Digitalformat"@de,
        "GIS digital format"@en .

<http://www.eionet.europa.eu/gemet/concept/14918> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:closeMatch <http://dbpedia.org/resource/Vector> ;
    skos:definition "One of the two major types of internal data organization used in GIS. Vector systems are based primarily on coordinate geometry and take advantage of the convenient division of spatial data into point, line, and polygon types. Vector structures are especially suited to storing definitions of spatial objects for which sharp boundaries exist or can be imposed."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Vektor"@de,
        "vector"@en .

<http://www.eionet.europa.eu/gemet/concept/14919> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:closeMatch <http://dbpedia.org/resource/Point> ;
    skos:definition "A position on a reference system determined by a survey."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Punkt"@de,
        "point"@en .

<http://www.eionet.europa.eu/gemet/concept/14920> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:closeMatch <http://dbpedia.org/resource/Line> ;
    skos:definition "Term used in GIS technologies in the vector type of internal data organization: spatial data are divided into point, line and polygon types. In most cases, point entities (nodes) are specified directly as coordinate pairs, with lines (arcs or edges) represented as chains of points. Regions are similarly defined in terms of the lines which form their boundaries. Some vector GIS store information in the form of points, line segments and point pairs; others maintain closed lists of points defining polygon regions. Vector structures are especially suited to storing definitions of spatial objects for which sharp boundaries exist or can be imposed."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Linie"@de,
        "line"@en .

<http://www.eionet.europa.eu/gemet/concept/14921> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:closeMatch <http://dbpedia.org/resource/Polygon> ;
    skos:definition "In the vector type of GIS internal data organization spatial data are conveniently divided into point, line and polygon types. Some vector GIS store information in the form of points, line segments and point pairs; others maintain close lists of points defining polygon regions."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Polygon"@de,
        "polygon"@en .

<http://www.eionet.europa.eu/gemet/concept/14922> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:closeMatch <http://dbpedia.org/resource/Raster> ;
    skos:definition "One of the two major types of internal data organization used in GIS. Raster systems superimpose a regular grid over the area of interest and associate each cell-or pixel, to use the image term- with one or more data records. The values associated with each grid cell may represent either real values or any scalar or nominal data values associated with the cell coordinates. Among the strengths of the raster method is its ability to accept data directly from remote sensing systems and to represent transitional information. Raster systems tend to be relatively storage-intensive and this imposes practical limits on the area of coverage, the resolution, or both of these. Capacity constraints are, however, becoming less significant as computer memory and storage become more powerful and as data compression techniques become more readily available."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Raster"@de,
        "raster"@en .

<http://www.eionet.europa.eu/gemet/concept/14923> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:closeMatch <http://dbpedia.org/resource/Attribute> ;
    skos:definition "A distinctive feature of an object. In mapping and GIS applications, the objects are points, lines, or polygons that represent features such as sampling locations, section corners (points); roads and streams (lines); lakes, forest and soil types (polygons). These attributes can be further divided into classes such as tree species Douglas-fir and ponderosa pine) for forest types and paved and gravel for road types. Multiple attributes are generally associated with objects that are located on a single map layer."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Eigenschaft"@de,
        "attribute"@en .

<http://www.eionet.europa.eu/gemet/concept/14925> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14924> ;
    skos:closeMatch <http://dbpedia.org/resource/Interpolation> ;
    skos:definition "A process used to estimate an intermediate value of one (dependent) variable which is a function of a second (independent) variable when values of the dependent variable corresponding to several discrete values of the independent variable are known."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Interpolation"@de,
        "interpolation"@en .

<http://www.eionet.europa.eu/gemet/concept/14926> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14924> ;
    skos:definition "A system of uniformly spaced perpendicular lines and horizontal lines running north and south, and east and west on a map, chart, or aerial photograph; used in locating points."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Gitternetz"@de,
        "gridding"@en .

<http://www.eionet.europa.eu/gemet/concept/14927> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14924> ;
    skos:definition "Methods to convert remotely sensed raster data to vector format. A number of raster-to-vector and vector-to-raster conversion procedures have been developed and introduced to current releases of many GIS packages."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Raster zu Vektor"@de,
        "raster to vector"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Vectorization_%28computer_graphics%29> .

<http://www.eionet.europa.eu/gemet/concept/14928> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14924> ;
    skos:definition "Methods to convert remotely sensed raster data to vector format. A number of vector-to-raster and raster-to-vector conversion procedures have been developed and introduced to current releases of many GIS packages."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Vektor zu Raster"@de,
        "vector to raster"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Rasterisation> .

<http://www.eionet.europa.eu/gemet/concept/14932> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14931> ;
    skos:definition "A limit or border of a geographic area under the jurisdiction of some governmental or managerial entity."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Verwaltungsgrenze"@de,
        "administrative boundary"@en .

<http://www.eionet.europa.eu/gemet/concept/14936> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14935> ;
    skos:closeMatch <http://dbpedia.org/resource/Latitude> ;
    skos:definition "An angular distance in degrees north or south of the equator (latitude 0°), equal to the angle subtended at the centre of the globe by the meridian between the equator and the point in question."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_4222> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Breitengrad"@de,
        "latitude"@en .

<http://www.eionet.europa.eu/gemet/concept/14937> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14935> ;
    skos:closeMatch <http://dbpedia.org/resource/Longitude> ;
    skos:definition "Distance in degrees east or west of the prime meridian at 0° measured by the angle between the plane of the prime meridian and that of the meridian through the point in question, or by the corresponding time difference."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Längengrad"@de,
        "longitude"@en .

<http://www.eionet.europa.eu/gemet/concept/14938> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7129> ;
    skos:definition "Centre where remote sensing data are stored, handled and analyzed."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Fernerkundungszentrum"@de,
        "remote sensing centre"@en .

<http://www.eionet.europa.eu/gemet/concept/14939> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4567> ;
    skos:definition "A laboratory where GIS data drawn from different sources are stored, handled, analyzed and updated."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "GIS-Labor"@de,
        "GIS laboratory"@en .

<http://www.eionet.europa.eu/gemet/concept/14947> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4621> ;
    skos:closeMatch <http://data.uba.de/umt/_00006625> ;
    skos:definition "Any subterranean or below-ground site in which solid, or other, waste is deposited without environmental controls."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Deponieuntergrund"@de,
        "underground dump"@en .

<http://www.eionet.europa.eu/gemet/concept/14955> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8841> ;
    skos:closeMatch <http://data.uba.de/umt/_00028767> ;
    skos:definition "Area out of closed settlements or building."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Aussenbereich"@de,
        "outer space (allocation plan)"@en ;
    skos:scopeNote "area out of closed settlements or building"@en .

<http://www.eionet.europa.eu/gemet/concept/14956> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14837> ;
    skos:closeMatch <http://data.uba.de/umt/_00024437>,
        <http://dbpedia.org/resource/Deep_sea_mining> ;
    skos:definition "The most valuable of the marine mineral resources is petroleum. About 15% of the world's oil is produced offshore, and extraction capabilities are advancing. One of the largest environmental impacts of deep sea mining are discharged sediment plumes which disperse with ocean currents and thus may negatively influence the marine ecosystem. Coal deposits known as extensions of land deposits , are mined under the sea floor in Japan and England."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Tiefseebergbau"@de,
        "deep sea mining"@en .

<http://www.eionet.europa.eu/gemet/concept/14959> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2587> ;
    skos:definition "Economic activity for manufacturing electric material and devices."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Elektrowarenindustrie"@de,
        "electrical goods industry"@en .

<http://www.eionet.europa.eu/gemet/concept/14962> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9246> ;
    skos:closeMatch <http://data.uba.de/umt/_00011467> ;
    skos:definition "Any treatment process in which contaminated water is cleansed or corrected, particularly by use of a pump-and-treat approach."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Gewässersanierung"@de,
        "restoration of water"@en .

<http://www.eionet.europa.eu/gemet/concept/14964> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7621> ;
    skos:closeMatch <http://data.uba.de/umt/_00022904> ;
    skos:definition "A person or business that specializes in the shipment and receiving of goods."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/4542> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Spediteur"@de,
        "forwarding agent"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Forwarding_agent_%28philately%29> .

<http://www.eionet.europa.eu/gemet/concept/14966> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2862> ;
    skos:closeMatch <http://data.uba.de/umt/_00041684> ;
    skos:definition "The inviolable, moral claim of non-human organisms and their habitats to exist unharmed or unchanged by human activity as postulated by certain environmental ethicists."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Natureigenrecht"@de,
        "natural independence law"@en .

<http://www.eionet.europa.eu/gemet/concept/14967> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11540> ;
    skos:closeMatch <http://data.uba.de/umt/_00025161> ;
    skos:definition "Unlawful acts against the environment, such as water contamination, hazardous waste disposal, air contamination, unpermitted installation of plants, oil spills, etc."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Umweltdelikt"@de,
        "offence against the environment"@en .

<http://www.eionet.europa.eu/gemet/concept/14968> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4749> ;
    skos:closeMatch <http://data.uba.de/umt/_00015708> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Landesrecht"@de,
        "provincial/regional law (D)"@en .

<http://www.eionet.europa.eu/gemet/concept/14970> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/661> ;
    skos:closeMatch <http://data.uba.de/umt/_00015686> ;
    skos:definition "The power of a government agency or its administrators to administer and implement laws and government policies applicable to a specific political subdivision or geographical area within the state."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/5120>,
        <http://eurovoc.europa.eu/5502> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Landesbehörde"@de,
        "provincial/regional authority (D)"@en .

<http://www.eionet.europa.eu/gemet/concept/14971> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4438> ;
    skos:closeMatch <http://data.uba.de/umt/_00013614> ;
    skos:definition "Any agreement or act involving two or more countries in which  business dealings, negotiations or other affairs are settled or concluded."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Internationaler Vergleich"@de,
        "international transaction"@en .

<http://www.eionet.europa.eu/gemet/concept/14972> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7320> ;
    skos:closeMatch <http://data.uba.de/umt/_00009173> ;
    skos:definition "The establishing of boulevards, turnpikes, highways and other routes on land."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Fahrwegfestlegung"@de,
        "road setting"@en .

<http://www.eionet.europa.eu/gemet/concept/14982> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8525> ;
    skos:definition "Any shelter or protection from distress or danger located in a predominantly mountainous area."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bergrückzugsgebiet"@de,
        "mountain refuge"@en .

<http://www.eionet.europa.eu/gemet/concept/14983> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11148> ;
    skos:definition "Research involving studies of all aspects of environmental conditions beyond the atmosphere of the earth."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/5238> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Weltraumforschung"@de,
        "space research"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Space_science> .

<http://www.eionet.europa.eu/gemet/concept/14985> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2917> ;
    skos:definition "The series of publications produced by the International Union for the Conservation of Nature and Natural Resources (IUCN). They provide an inventory on the threat to rare plants and animal species. Information includes status, geographical distribution, population size, habitat and breeding rate. The books also contain the conservation measures, if any, that have been taken to protect the species. There are five categories of rarity status: endangered species; vulnerable organisms, which are those unlikely to adapt to major environmental effects; rare organisms, which are those at risk because there are few of them in the world, such as plants which only grow on mountain peaks or on islands; out of danger species, which were formerly in the above categories, but have had the threat removed because of conservation actions; and indeterminate species, which are the plants and animals probably at risk, although not enough is known about them to assess their status."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Rote Liste"@de,
        "red list"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/IUCN_Red_List> .

<http://www.eionet.europa.eu/gemet/concept/1499> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6233> ;
    skos:closeMatch <http://data.uba.de/umt/_00014511>,
        <http://dbpedia.org/resource/Coagulation> ;
    skos:definition "A separation or precipitation from a dispersed state of suspensoid particles resulting from their growth; may result from prolonged heating, addition of an electrolyte, or from a condensation reaction between solute and solvent."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_1691> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Koagulation"@de,
        "coagulation"@en .

<http://www.eionet.europa.eu/gemet/concept/15027> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:closeMatch <http://data.uba.de/umt/_00500142>,
        <http://dbpedia.org/resource/Decantation> ;
    skos:definition "Sizing or classifying particulate matter by suspension in a fluid (liquid or gas), the larger particulates tending to separate by sinking."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Dekantieren"@de,
        "decantation"@en .

