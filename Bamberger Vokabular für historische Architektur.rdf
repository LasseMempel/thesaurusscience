    <!-- https://hist-arch-vocab.org/bvha#c_08cf2739 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_08cf2739">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
