        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-21T14:16:33.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-21T14:18:00.000</terms:modified>
        <skos:definition xml:lang="de">Aus Zement oder anderem Material gegossener oder gepresster Bogen. Beispiel: der Parabelbogen im Collegium delle Teresiane von Antonio Gaudi in Barcelona. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Gussbogen</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_59bca020 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_59bca020">
