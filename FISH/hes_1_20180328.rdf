		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1170" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1196" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1198" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1203" />
		<skos:scopeNote xml:lang="en">An area of mining activity, where excavations have extracted ores, coal, salt or precious stones. Use specific MINE type where known eg LEAD MINE.</skos:scopeNote>
