		<skos:prefLabel xml:lang="gd">GÀRRADH FOIRMEIL</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Gàrradh dìreach riaghailteach ceàrnagach air dealbhadh geomatrach is bidh nòsan tradaiseanta Eadailteach, Frangach agus Duitseach air an siubhal.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">FORMAL GARDEN</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
