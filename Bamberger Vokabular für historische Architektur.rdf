        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-21T10:25:49.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:21:31.000</terms:modified>
        <skos:altLabel xml:lang="de">Halbkreisgewölbe</skos:altLabel>
        <skos:altLabel xml:lang="de">Rundbogentonne</skos:altLabel>
        <skos:altLabel xml:lang="fr">berceau plein-cintre</skos:altLabel>
        <skos:altLabel xml:lang="en">cylindrical barrel vault</skos:altLabel>
        <skos:definition xml:lang="de">Tonne mit halbkreisförmiger Gewölbelinie, die Grundform des TonnengewöIbes. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Rundtonne</skos:prefLabel>
        <skos:prefLabel xml:lang="en">semicircular barrel vault</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte en berceau plein-cintre</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_11426742"/>
    </owl:NamedIndividual>
    


