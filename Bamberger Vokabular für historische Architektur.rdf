        <skos:prefLabel xml:lang="tr">iç mekan iklim çalışması</skos:prefLabel>
        <skos:prefLabel xml:lang="hr">proučavanje klime u unutrašnjosti</skos:prefLabel>
        <skos:prefLabel xml:lang="it">studio del clima interno</skos:prefLabel>
