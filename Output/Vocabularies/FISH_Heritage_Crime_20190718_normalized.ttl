<http://purl.org/heritagedata/schemes/596/concepts/152653> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152652> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Architectural Theft"@en ;
    skos:scopeNote "The illegal removal of architectural features from heritage assets."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152654> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152652> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Cultural Theft"@en ;
    skos:scopeNote "The illegal removal of fittings and internal furnishings from heritage assets."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152664> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152662> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Assault (Visitor)"@en ;
    skos:scopeNote "A crime of violence against a visitor to a heritage site. Double index with the type and severity of the assault if known)."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152665> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152662> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Assault (Volunteer)"@en ;
    skos:scopeNote "A crime of violence against a volunteer at a heritage site. Double index with the type and severity of the assault if known)."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152666> a skos:Concept ;
    skos:altLabel "Dogging"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152663> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Sex Groups"@en ;
    skos:scopeNote "Groups of people who meet to perform group sex. Such activity can occur amongst people of all sexual orientations and genders. Group sex may take place in public for example, at nude beaches, secluded heritage assets or outdoor events or nightclubs."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152668> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152667> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Prostitution"@en ;
    skos:scopeNote "The act of prostituting a person or oneself for sexual activity in return for payment."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152669> a skos:Concept ;
    skos:altLabel "Flashing"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152663> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Indecent Exposure"@en ;
    skos:scopeNote "Unseemly behaviour involving the public exposure of one's body in an indecent manner."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152670> a skos:Concept ;
    skos:altLabel "Arson"@en,
