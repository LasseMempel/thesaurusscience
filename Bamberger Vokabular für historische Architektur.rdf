    <!-- https://hist-arch-vocab.org/bvha#c_93e804f0 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_93e804f0">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_utiejxdh"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-14T13:10:57.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T16:43:09.000</terms:modified>
        <skos:altLabel xml:lang="de">Bilderkapitell</skos:altLabel>
        <skos:altLabel xml:lang="de">Figuriertes Kapitell</skos:altLabel>
        <skos:altLabel xml:lang="fr">chapiteau anthropomorphe</skos:altLabel>
        <skos:altLabel xml:lang="fr">chapiteau zoomorphe</skos:altLabel>
        <skos:definition xml:lang="de">Figurenkapitell, Bilderkapitell, Kapitell, an dem Figuren von Menschen, Tieren oder Fabelwesen erscheinen, oft zu ganzen Szenen vereint. Das F. kommt schon in der Spätantike vor, hat sich aber erst in der roman. Baukunst bes. Frankreichs voll entwickelt. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="cs"> figurální hlavice</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Figurenkapitell</skos:prefLabel>
        <skos:prefLabel xml:lang="es">capitel con figuras</skos:prefLabel>
        <skos:prefLabel xml:lang="it">capitello istoriato</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">chapiteau figuré</skos:prefLabel>
        <skos:prefLabel xml:lang="en">figural capital</skos:prefLabel>
    </owl:NamedIndividual>
    


