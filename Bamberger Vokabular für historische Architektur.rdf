        <skos:altLabel xml:lang="de">Oblatenbüchse</skos:altLabel>
        <skos:altLabel xml:lang="fr">boîte à hosties non consacrées </skos:altLabel>
        <skos:altLabel xml:lang="la">capsa</skos:altLabel>
        <skos:altLabel xml:lang="en">host-container</skos:altLabel>
        <skos:definition xml:lang="de">Hostiendose f; auch Oblatenbüchse f; lat. Capsula hostiarum; capsa: ein Behälter für die noch nicht konsekrierten Hostien. Oft gehören zwei Dosen zusammen, die eine für die kleinen, die andere für die großen Hostien. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Hostiendose</skos:prefLabel>
        <skos:prefLabel xml:lang="en">altar-bread box</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">boîte à hosties</skos:prefLabel>
        <skos:prefLabel xml:lang="la">capsula hostiarum</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_250d2b75 -->


