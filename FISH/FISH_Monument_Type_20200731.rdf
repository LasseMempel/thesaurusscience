    <skos:scopeNote xml:lang="en">A gun emplacement which conforms to Department of Fortification and Works drawing number 55414.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92088">
    <skos:scopeNote xml:lang="en">A table found in a garden, often made of stone.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92298">
