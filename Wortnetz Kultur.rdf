	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk000381">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Bauwerksgründung (Verfahren)</skos:altLabel>
		<skos:prefLabel xml:lang="en">foundation (structural element)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Grundbau</skos:altLabel>
		<skos:prefLabel xml:lang="de">Gründung (Verfahren)</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003620"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk003620"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk000673"/>
		<skos:definition xml:lang="de">Eine Gründung ist Verfahren, das im Bauwesen angewandt wird, um die Standsicherheit eines Bauwerks zu gewährleisten und eine ungleichmäßige Setzung verhindern soll.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4137134-3"/>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300000919"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003620"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-15T09:22:34+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk000382">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">deep foundation</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Tiefgründung</skos:prefLabel>
		<skos:altLabel xml:lang="de">Tiefgründungen</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000673"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk014952"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000673"/>
		<xe:explanation_temp xml:lang="de">Eine Tiefgründung wird erforderlich, wenn die bodennahen Schichten nicht tragfähig genug sind.</xe:explanation_temp>
		<skos:definition xml:lang="de">Eine Tiefgründung ist eine Gründung, die die Bauwerkslasten nicht direkt unterhalb des Bauwerks in den Untergrund, sondern über zusätzliche senkrechte Elemente tiefer in die Erde ableitet.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4232320-4"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk014952"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000673"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000380"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000383"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000384"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004343"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-06-14T12:41:20+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk000383">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Brunnengründung</skos:prefLabel>
		<skos:altLabel xml:lang="de">Brunnengründungen</skos:altLabel>
		<skos:prefLabel xml:lang="en">shaft foundation</skos:prefLabel>
		<skos:altLabel xml:lang="en">well foundation</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000382"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000382"/>
		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk000308"/>
		<skos:definition xml:lang="de">Eine Brunnengründung ist eine Tiefgründung, bei der Schachtringe bis auf die Tiefe des tragfähigen Bodens eingelassen werden und bei der der Hohlraum nach Erreichen der tragfähigen Bodenschichten mit Beton, Kies oder Sand aufgefüllt wird.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000382"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-09-18T14:17:14+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk000384">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Schlitzwandgründung</skos:prefLabel>
		<skos:altLabel xml:lang="de">Schlitzwandgründungen</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000382"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk014952"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000382"/>
		<skos:definition xml:lang="de">Eine Schlitzwandgründung ist eine Tiefgründung, bei der eine Wand in die Baugrube betoniert wird, um Erddruck und Wasserdruck abzuhalten.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000382"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk014952"/>
		<xe:status>candidate</xe:status>
