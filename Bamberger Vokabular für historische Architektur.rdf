        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-25T18:49:51.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T11:42:02.000</terms:modified>
        <skos:altLabel xml:lang="de">Präsepie</skos:altLabel>
        <skos:definition xml:lang="de">Krippe f; auch Präsepie f ; lat. praesepium: der hölzerne Trog, in den der neugeborene Jesus zu Bethlehem gelegt wurde. Die hl. Helena verwahrte die Krippe in der Geburtkirche, später wurde sie nach Rom in die Basilika S. Maria Maggiore gebracht, wo s ie alljährlich am 24. Dezember auf dem Hochaltar aufgestellt und als Reliquie verehrt wird. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="en">Crib</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Crèche </skos:prefLabel>
        <skos:prefLabel xml:lang="de">Krippe Christi</skos:prefLabel>
        <skos:prefLabel xml:lang="la">praesepium</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_53f21c5d -->


