				<skos:prefLabel xml:lang="gd">CRANN-OLA</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Structar a chumas taic ri innealan drilidh a chleachdar gus olaichean mèinnireach a lorg no a tharraing às an talmhainn.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">OIL RIG</skos:prefLabel>
