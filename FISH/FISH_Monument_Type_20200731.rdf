  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70378">
    <skos:scopeNote xml:lang="en">A length of straight, curved or angled earthwork or cropmark of uncertain date or function.</skos:scopeNote>
  </rdf:Description>
