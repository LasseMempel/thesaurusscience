		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk004226"/>
		<skos:definition xml:lang="de">Die Porta praetoria ist ein Tor, das in einer Schmalseite des Lagers gegenüber der Front der Principia liegt und den Hauptzugang in ein römisches Militärlager markiert.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk009970"/>
