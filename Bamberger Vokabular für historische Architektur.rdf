        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-18T13:30:05.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-18T13:58:58.000</terms:modified>
        <skos:definition xml:lang="cs">Akvarel (lat. aqua = voda), průhledná malba (prosvěcuje podklad) vodou ředitelnými barvami kromě bílé, pojivo: arabská guma, v architektuře při malbě fresek. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Aquarellmalerei (lat. aqua = Wasser), lasierende Malereitechnik (lässt den Grund durchscheinen) mit wasserlöslichen Farben ohne Weiß. Bindemittel: Gummi arabicum. Am Bau für Fresko-Malerei (sh. dort). [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Aquarellmalerei</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">akvarel</skos:prefLabel>
    </owl:NamedIndividual>
    


