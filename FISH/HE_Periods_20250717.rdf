        <time:hasBeginning xml:lang="en">1642</time:hasBeginning>
        <time:hasEnd xml:lang="en">1651</time:hasEnd>
        <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_period"/>
        <dc:identifier>http://purl.org/heritagedata/schemes/eh_period/concepts/ECW</dc:identifier>
