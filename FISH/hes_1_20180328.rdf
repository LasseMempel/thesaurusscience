		<skos:prefLabel xml:lang="gd">BATARAIDH CLADAICH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Bataraidh ghunnaichean dìon air a' chladach 's mu choinneamh na mara.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">COASTAL BATTERY</skos:prefLabel>
