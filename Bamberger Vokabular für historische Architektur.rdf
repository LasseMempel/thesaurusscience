    <!-- https://hist-arch-vocab.org/bvha#c_7723fa45 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_7723fa45">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f88a153a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c7b144d0"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-15T12:09:42.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-30T23:27:36.000</terms:modified>
        <skos:altLabel xml:lang="fr">fenêtre composée</skos:altLabel>
        <skos:altLabel xml:lang="cs">sdružené okno</skos:altLabel>
        <skos:definition xml:lang="de">Fenster, dessen parallele Flügel gemeinsam angeschlagen und mit einem einzigen Handgriff zu öffnen sind. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Verbundfenster erbringen besondere Leistungen in Schallschutz und Wärme-Isolierung. Der Luftzwischenraum zwischen den beiden Scheiben beträgt 4 - 7 cm und bildet mit seinem Luftpolster eine äußerst effektive Barriere gegenüber Schalleinflüssen. [Pax - Fenster &amp; Türen Fachbegriffe]</skos:definition>
        <skos:prefLabel xml:lang="de">Verbundfenster</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">fenêtre à vitrage double</skos:prefLabel>
        <skos:prefLabel xml:lang="it">finestra a doppia chiusura</skos:prefLabel>
        <skos:prefLabel xml:lang="es">ventana con cierre doble</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">zdvojené okno</skos:prefLabel>
        <broaderByConstruction rdf:resource="https://hist-arch-vocab.org/bvha#c_f88a153a"/>
    </owl:NamedIndividual>
    


