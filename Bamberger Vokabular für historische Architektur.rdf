        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-21T10:26:18.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:15:25.000</terms:modified>
        <skos:altLabel xml:lang="en">vault with a straight axis</skos:altLabel>
        <skos:altLabel xml:lang="fr">voûte à axe droit</skos:altLabel>
        <skos:definition xml:lang="de">Gewölbe, dessen Achse rechtwinklig zur Horizontalprojektion seines Stirnbogens verläuft, z. B. die Rundtonne. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">gerades Gewölbe</skos:prefLabel>
        <skos:prefLabel xml:lang="en">straight vault</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte droite</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_049c4c22"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_bf3bffa7 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_bf3bffa7">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1cb81a92"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_167cb98f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_19d56a39"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-11-04T16:18:08.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T14:54:15.000</terms:modified>
        <skos:altLabel xml:lang="de">Schalenständer</skos:altLabel>
        <skos:definition xml:lang="de">Der Mantel-/Schalenständer ist ein wandhohes, vertikal in die Block- oder Bohlenwand eingestelltes Holz, welches beidseitig mit Mantelschalen die Balken- oder Bohlenköpfe umfasst. Seine Funktion entspricht entweder jener der Blockzange oder der eines Verbindungselementes bei der nachträglichen Verlängerung oder Reparatur einer Blockwand. [Eißing et al. 2012]</skos:definition>
        <skos:prefLabel xml:lang="de">Mantelständer</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_1cb81a92"/>
        <broaderByPosition rdf:resource="https://hist-arch-vocab.org/bvha#c_1cb81a92"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_bf404f51 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_bf404f51">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
