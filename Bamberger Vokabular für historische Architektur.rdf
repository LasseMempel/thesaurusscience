        <skos:definition xml:lang="de">Mit der Fläche wird eine vorher gespitzte Oberfläche eines Werksteines eingeebnet. [BVHA]</skos:definition>
        <skos:prefLabel xml:lang="de">Abflächen</skos:prefLabel>
