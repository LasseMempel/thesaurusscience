    <skos:scopeNote xml:lang="en">A site or building where ore is processed to obtain metal.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71729">
    <skos:scopeNote xml:lang="en">An establishment where people get their hair dressed and cut.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70063">
    <skos:scopeNote xml:lang="en">A place of burial for members of the Religious Society of Friends, often known as Quakers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162617">
    <skos:scopeNote xml:lang="en">A farmstead where mostly detached buildings have developed around three sides of an open cattle yard.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69172">
    <skos:scopeNote xml:lang="en">A kiln used for the production of any of the soda group of alkalis by the heating of plant remains or salt.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93659">
    <skos:scopeNote xml:lang="en">A lime kiln in which coal is burnt, as distinct from a flame-free kiln in which wood or peat is used.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69180">
    <skos:scopeNote xml:lang="en">A charcoal fired shaft furnace used for the direct reduction of iron ore to produce wrought iron.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/169963">
    <skos:scopeNote xml:lang="en">A chapel where the followers of the Anglican tradition worship.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92689">
    <skos:scopeNote xml:lang="en">A garden incorporating features of Moorish-influenced Spanish gardens - water features, patios, benches, walls and compartments, evergreens, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/102912">
    <skos:scopeNote xml:lang="en">Use only for features assumed to be archaeological but which cannot be identified more precisely without further investigation .Use more specific term where known</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71459">
    <skos:scopeNote xml:lang="en">Central functional building of a gas works. Coal is roasted in retorts producing gas and coke.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/147335">
    <skos:scopeNote xml:lang="en">An enclosure, usually within a zoo, designed to represent the natural environment for Lemurs, including shelter.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93121">
    <skos:scopeNote xml:lang="en">An office at which the registration of marriages, births and deaths are recorded, and in which marriage ceremonies may take place.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70261">
    <skos:scopeNote xml:lang="en">An outbuilding where a horse-drawn carriage is kept.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71806">
    <skos:scopeNote xml:lang="en">A place where the popular gambling game of bingo is played.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68709">
    <skos:scopeNote xml:lang="en">A house devoted to the shelter of the poor and endowed by a benefactor for this use.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/146388">
    <skos:scopeNote xml:lang="en">The area of a town or city, such as a harbour or dockyard, alongside a body of water.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91610">
    <skos:scopeNote xml:lang="en">An area of a port, dock or harbour where a container vessel docks to take on or unload its containers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/90197">
    <skos:scopeNote xml:lang="en">An artificial hill constructed in Tudor gardens, especially, to provide a good view.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71700">
    <skos:scopeNote xml:lang="en">A mill used for the extraction and processing of starch.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92819">
    <skos:scopeNote xml:lang="en">A factory where musical organs are manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159207">
    <skos:scopeNote xml:lang="en">An area of land used for camping. Often includes facilities for washing, catering and entertainment.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93303">
    <skos:scopeNote xml:lang="en">An ornamental building, usually decorated with or displaying shells.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93625">
    <skos:scopeNote xml:lang="en">Sites and structures used for the transportation of goods and people under roads and rivers, or through hills, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/90957">
    <skos:scopeNote xml:lang="en">A group of buildings and satellite dishes used to transmit and receive signals relayed by satellites.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70122">
    <skos:scopeNote xml:lang="en">A residence used during short visits by an official and attendants of the Knights Hospitallers for administrative purposes on their estates.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70413">
    <skos:scopeNote xml:lang="en">A building in which horses are accommodated.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68963">
    <skos:scopeNote xml:lang="en">A crude shelter for persons engaged in the production of pure carbon by the controlled burning of wood and other organic materials.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71519">
    <skos:scopeNote xml:lang="en">A dwelling for the keeper of a canal wharf.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170630">
    <skos:scopeNote xml:lang="en">A graduated post or pole adjacent to an area at risk of flooding to indicate the depth of water during a flood.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70296">
    <skos:scopeNote xml:lang="en">A rectangular chamber of brick or stone with heavy wooden gates at either end equipped with sluices to let water in and out, thereby enabling a canal boat to be lowered or raised to a different level.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143393">
    <skos:scopeNote xml:lang="en">A device used to remove pollutants from gas or smoke produced during industrial processes such as burning high-sulphur fuels.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92626">
    <skos:scopeNote xml:lang="en">A northern term for water reservoirs at steam powered industrial sites that are part of the steam raising plant and are used for recirculating condenser cooling water. The lodge had to be large enough to supply the condenser with cool water for a day.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69235">
    <skos:scopeNote xml:lang="en">Pond, created specifically for providing power to water-powered forges, blast furnaces, helve or other hammers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167088">
    <skos:scopeNote xml:lang="en">A building used as emergency accommodation and food distribution centre for people displaced by a natural disaster or conflict.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69009">
    <skos:scopeNote xml:lang="en">A platform or other structure for the use of a band of musicians.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71296">
    <skos:scopeNote xml:lang="en">A barn usually containing a single, central threshing floor.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91995">
    <skos:scopeNote xml:lang="en">Buildings, sites and structures associated with the preserving of food.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68939">
    <skos:scopeNote xml:lang="en">The residence of a priest.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164188">
    <skos:scopeNote xml:lang="en">A site specializing in the manufacture of parts for the Aerospace industry.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162643">
    <skos:scopeNote xml:lang="en">A hideout containing radio equipment to be used by the Special Duties sections of the Auxiliary Units to send information to the control station for relaying to headquarters.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91694">
    <skos:scopeNote xml:lang="en">A kind of primary school kept by elderly women.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69199">
    <skos:scopeNote xml:lang="en">Any building designed or adapted to accommodate trades and manufacturing activity. Use more specific site where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92256">
    <skos:scopeNote xml:lang="en">A building in which hoops (for masts) were heated.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143441">
    <skos:scopeNote xml:lang="en">A prepared area of ground, featuring a 'mini' golf course with obstacles, used to undertake the leisure pursuit of miniature golf or 'crazy golf'. Often popular at seaside resorts.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68869">
    <skos:scopeNote xml:lang="en">A fortified building or site with purpose built emplacements for artillery pieces.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70064">
    <skos:scopeNote xml:lang="en">A Neolithic burial monument comprising a stone-built chamber within a mound of earth or stone. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93389">
    <skos:scopeNote xml:lang="en">A twin-shafted kiln, circular or oval in plan, consisting of a fire chamber, pre-heater and cooling chamber.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91481">
    <skos:scopeNote xml:lang="en">A residence of two or three monks of the Cistercian order dependent on a foreign mother house.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69280">
    <skos:scopeNote xml:lang="en">Open-air area often terraced on which a range of ore processing operations are carried out.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/107253">
    <skos:scopeNote xml:lang="en">A heavy grating, often made of wood or iron, usually lowered vertically as a defensive barrier at the entrance to a gatehouse or barbican.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159293">
    <skos:scopeNote xml:lang="en">A prefabricated structure consisting of sectional timber framed units that were bolted together. The structure was clad with weatherboarding and had a felted roof. They were used as temporary accommodation on airfields. Also see 'Type A'</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69287">
    <skos:scopeNote xml:lang="en">A site where large sheets of thin metal are manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70088">
    <skos:scopeNote xml:lang="en">A building or room used for holding, viewing, identifying or examining dead bodies prior to burial or cremation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/122499">
    <skos:scopeNote xml:lang="en">A type of bridge which was designed for temporary use and then capable of being moved to another site. Use for temporary bridges which have remained in situ since erection.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162959">
    <skos:scopeNote xml:lang="en">A facility used for the storage and distribution of fuel for transportation. Often associated with dockyards and railways.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94055">
    <skos:scopeNote xml:lang="en">A building used to house apes and monkeys.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94093">
    <skos:scopeNote xml:lang="en">Nowadays a hospital block where patients suffering from psychiatric disorders receive medical and surgical treatment. Formerly a place where psychiatric patients were primarily segregated from other patients in a hospital.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/72460">
    <skos:scopeNote xml:lang="en">A non residential building providing recreational, social and other facilities, especially for the elderly and those with special needs.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93453">
    <skos:scopeNote xml:lang="en">A farm where stallions and mares are kept for breeding.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92086">
    <skos:scopeNote xml:lang="en">Stone, brick or wooden steps or stairs found in a garden.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69055">
    <skos:scopeNote xml:lang="en">An industrial manufacturing complex producing bricks.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91595">
    <skos:scopeNote xml:lang="en">A usually large school providing courses for children of all abilities, between the ages of eleven and sixteen.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/147332">
    <skos:scopeNote xml:lang="en">Building used for the display of inscription panels and memorials to those buried in the underlying catacomb.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/152566">
    <skos:scopeNote xml:lang="en">An area of shallow linear cuts made by the removal of turf for fuel or building material.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140075">
    <skos:scopeNote xml:lang="en">Buildings and structures associated with the processing and storage of natural gas.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142962">
    <skos:scopeNote xml:lang="en">A decoy site designed to simulate a burning urban area during a bombing raid in order to lure enemy bombers away from legitimate targets.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91180">
    <skos:scopeNote xml:lang="en">An establishment where wagering and the placing of bets takes place.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92194">
    <skos:scopeNote xml:lang="en">A mechanism used for lifting and lowering weights, operated by hand.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78231">
    <skos:scopeNote xml:lang="en">A bridge carrying a tramway.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69423">
    <skos:scopeNote xml:lang="en">A factory where furniture is manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68581">
    <skos:scopeNote xml:lang="en">A shallow pond, often artificial, fed by the condensation of water from the air, occuring on high land which has no other adequate water supply.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92769">
    <skos:scopeNote xml:lang="en">A school for pre-Infant school children, usually 3-5 years old.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140158">
    <skos:scopeNote xml:lang="en">A circular or octagonal building at the base of a post mill to provide storage space and to give protection to the superstructure. The roundhouse is not attached to the mill itself. Some roundhouses were later converted for domestic purposes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78879">
    <skos:scopeNote xml:lang="en">A 20th century feature found in public parks and seaside resorts. The face of the clock is planted with low-growing flowers and plants, while the moving hands are covered with small foliage.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93264">
    <skos:scopeNote xml:lang="en">An external structure used to sit on.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93182">
    <skos:scopeNote xml:lang="en">A building used as a social venue by people interested in, and involved with, the sport of rowing. An area of the building may be used for the storage of canoes, sculls etc. Often situated by a river.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92506">
    <skos:scopeNote xml:lang="en">A hospital for the treatment of venereal disease.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93396">
    <skos:scopeNote xml:lang="en">A cottage erected over a short period of time, by people who had no legal right to the land. Squatters were often tolerated by the landlord as they provided cheap labour.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/151260">
    <skos:scopeNote xml:lang="en">A lightweight prefabricated structure of corrugated galvanized steel having a semicircular cross section. The design was based on the Nissen hut developed by the British during the First World War.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92943">
    <skos:scopeNote xml:lang="en">A factory used for the production of thick, flat glass used for shop window panes, etc. Plate glass is produced by rolling and casting rather than traditional blowing.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68564">
    <skos:scopeNote xml:lang="en">A building for the storage and drying of hops, often including a hop drying kiln. Usually built as part of a farm.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69263">
    <skos:scopeNote xml:lang="en">A mine for the extraction of iron ore.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93162">
    <skos:scopeNote xml:lang="en">The principal Roman Catholic church in a diocese in which the cathedra or bishop's throne is to be found.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160314">
    <skos:scopeNote xml:lang="en">A plate-steel water tower made with two compartments holding 30,000 gallons of water. Designed to Air Ministry drawing number 20/40.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/104253">
    <skos:scopeNote xml:lang="en">A structure consisting of combustible material, typically wood, on which a body is placed and then cremated, sometimes with accompanying grave goods. Use only when evidence of structure exists.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164101">
    <skos:scopeNote xml:lang="en">A factory where collars, for shirts and other garments, are manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92878">
    <skos:scopeNote xml:lang="en">Sites and structures associated with the cutting and processing of peat.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/88699">
    <skos:scopeNote xml:lang="en">A floating, fixed marker used to indicate to a navigator a sea area to approach or avoid.</skos:scopeNote>
  </rdf:Description>
