        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-24T23:11:49.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T16:29:25.000</terms:modified>
        <skos:definition xml:lang="fr">Désagrégation saccharoïde : s’applique aux marbrescristallins  [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="de">Zuckerkörniger Zerfall wird hauptsächlich bei weißem kristallinen Marmor angewendet. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="en">employed mainly for white crystalline marble [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="cs">zcukrovatění: termín používaný při popisu bílých krystalických vápenců. [ICOMOS-ISCS]</skos:definition>
        <skos:prefLabel xml:lang="fr">désagrégation saccharoïde</skos:prefLabel>
        <skos:prefLabel xml:lang="en">sugaring</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">zcukrovatění</skos:prefLabel>
        <skos:prefLabel xml:lang="de">zuckerkörniger Zerfall </skos:prefLabel>
    </owl:NamedIndividual>
    


