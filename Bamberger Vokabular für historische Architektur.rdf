        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-14T13:59:58.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T17:51:58.000</terms:modified>
        <skos:altLabel xml:lang="de">Verschwärzung</skos:altLabel>
        <skos:note xml:lang="en">A change in the surface colour due to a decrease in hue (reduction of visible light reflection). [EwaGlos]</skos:note>
        <skos:note xml:lang="de">Eine Farbveränderung der Oberfläche durch Dämpfung des Farbtons (Herabsetzung der Reflexion des sichtbaren Lichts). [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="de">Verdunklung</skos:prefLabel>
        <skos:prefLabel xml:lang="en">darkening</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_808448c2 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_808448c2">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_eea5235b"/>
