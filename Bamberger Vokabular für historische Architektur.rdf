        <skos:altLabel xml:lang="it">strada a cordonata</skos:altLabel>
        <skos:definition xml:lang="de">Treppenweg, ein außerhalb von Gebäuden liegender ( öffentl.) nicht befahrbarer Verkehrsweg, der als Treppe ausgebildet ist oder in dessen Verlauf Treppen eingeschaltet sind. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Treppenstraße</skos:prefLabel>
        <skos:prefLabel xml:lang="es">calle con gradas</skos:prefLabel>
