		<skos:definition xml:lang="de">Ein Querhaus ist ein Gebäudeteil, der quer zum Langhaus verläuft und vorzugsweise im Kirchenbau vorkommt.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003665"/>
