		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/98" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/117">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/117</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">LIOS CHRAOBHAN-MEASAN</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Gort far a bheilear a' fàs craobhan mheasan.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">ORCHARD</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/115" />
				<skos:scopeNote xml:lang="en">An enclosure used for the cultivation of fruit trees.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
