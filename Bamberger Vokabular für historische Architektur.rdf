    <!-- https://hist-arch-vocab.org/bvha#c_f45c8063 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_f45c8063">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_40b99f7d"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_4bd3aa19"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-27T14:47:23.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T11:08:31.000</terms:modified>
        <skos:definition xml:lang="de">Gliederung einer Fassade mit Pilastern oder Säulen der antiken Ordnungen, die über mehrere Stockwerke reicht. Michelangelo hat in der Spätrenaissance das geschossweise Aufeinandersetzen der Fassaden aufgegeben und die K. entwickelt. Besondere Bedeutung hat die K. im Schlossbau der Barockzeit, weil mit ihr besondere Gebäudeteile hervorgehoben werden konnten (Schloss Weißenfels / Pommersfelden BY). B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:definition xml:lang="de">Kolossalordnung (griech. kolossos = Riesenbildsäule), Säulenordnung, die über mehrere, meist zwei Stockwerke greift. Von Michelangelo und Palladio entwickelt. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Řec. kolossos = obrovitá socha. Sloupový řád, který zasahuje více než jedno patro, většinou dvě, rozvinut Michelangelem a Palladiem. [Koch 2008] </skos:definition>
        <skos:prefLabel xml:lang="de">Kolossalordnung</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">vysoký řád</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_f45d5629 -->


