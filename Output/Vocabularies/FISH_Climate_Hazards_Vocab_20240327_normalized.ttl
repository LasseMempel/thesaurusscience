    skos:scopeNote "Changing patterns in average wind movement, such as changing directions of prevailing winds."@en .

<http://purl.org/heritagedata/schemes/38076/concepts/40102> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/38076/concepts/4010> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/38076> ;
    skos:prefLabel "Wind-driven rain"@en ;
    skos:scopeNote "Rain and wind occurring together, giving rain a horizontal velocity."@en .

