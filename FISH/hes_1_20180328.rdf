	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/353">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/353</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BLOCA NAN OBRAICHEAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach no grunn thogalaichean, mar is trice nam pàirt de làrach nas motha mar raon-adhair, far a bheilear a' dèanamh planaichean is co-dhùnaidhean ro-innleachdail.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">OPERATIONS BLOCK</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/349" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/355" />
		<skos:scopeNote xml:lang="en">A building or group of buildings, usually forming part of a larger site such as an airfield, where operational and strategic planning and decisions are carried out.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/354">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/354</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">IONAD-AIRM</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far a bheil acainnean an airm agus luchd-obrach taice.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MILITARY INSTALLATION</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/355" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/360" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/278" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/366" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/367" />
		<skos:scopeNote xml:lang="en">A site where military equipment and supporting personnel are located.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
