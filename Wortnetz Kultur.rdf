	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk012969">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Blockbebauung</skos:prefLabel>
		<skos:altLabel xml:lang="de">Blockbebauungen</skos:altLabel>
		<skos:prefLabel xml:lang="en">perimeter development</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk002418"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk005739"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk002418"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk001731"/>
		<skos:definition xml:lang="de">Eine Blockbebauung ist eine geschlossene Bauweise, deren Baublocks an allen Seiten von Straßen umgeben sind.</skos:definition>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4126921-4"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002418"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk005739"/>
