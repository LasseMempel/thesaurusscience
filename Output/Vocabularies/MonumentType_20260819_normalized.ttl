        "Churchyard Watch House"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92672> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "CHURCHYARD"@en ;
    skos:scopeNote "An area of ground belonging to a church, often used as a burial ground."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70062> a skos:Concept ;
