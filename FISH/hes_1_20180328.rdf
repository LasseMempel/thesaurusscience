		<skos:prefLabel xml:lang="gd">SABHAL FROISIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Sabhal le aon ùrlar-bualaidh sa mheadhan mar is trice.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">THRESHING BARN</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
