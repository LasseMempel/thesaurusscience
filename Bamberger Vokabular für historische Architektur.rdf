        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-18T09:52:38.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-02T14:47:04.000</terms:modified>
        <skos:altLabel xml:lang="fr">croisillon</skos:altLabel>
        <skos:definition xml:lang="de">Gestalterische oder durch Glasgröße bedingte Unterteilung des Glasfeldes in einem Fenster- oder Flügelrahmen. Die Sprosse ist Teil des Glasfeldes, auch wenn sie mit dem Rahmen konstruktiv verbunden ist. Es gibt Holzsprossen und Bleisprossen. [Noky 1996]</skos:definition>
        <skos:definition xml:lang="de">Unterteilungsholz einer Glaslichte. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="en">(window) sash</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Sprosse</skos:prefLabel>
        <skos:prefLabel xml:lang="es">listones que dividen la hoja de una ventana</skos:prefLabel>
        <skos:prefLabel xml:lang="it">traversina (di finestra)</skos:prefLabel>
    </owl:NamedIndividual>
    


