        <skos:altLabel xml:lang="de">Kohäsionsverlust</skos:altLabel>
        <skos:altLabel xml:lang="de">Kreiden</skos:altLabel>
        <skos:altLabel xml:lang="de">Pudern</skos:altLabel>
        <skos:altLabel xml:lang="de">Pulverisierung</skos:altLabel>
        <skos:altLabel xml:lang="fr">farinage</skos:altLabel>
        <skos:altLabel xml:lang="en">friability</skos:altLabel>
        <skos:altLabel xml:lang="en">loss of cohesion</skos:altLabel>
        <skos:altLabel xml:lang="en">powdering</skos:altLabel>
        <skos:altLabel xml:lang="en">pulverization</skos:altLabel>
        <skos:note xml:lang="fr">Désagrégation en poudred’un matériau à grains fins (ex. craie).  [ICOMOS-ISCS]</skos:note>
        <skos:note xml:lang="de">Kohäsionsverlust und Ablagerung von sehr feinen Partikeln (kreide- oder puderartig) auf der Oberfläche des Materials. [EwaGlos]</skos:note>
        <skos:note xml:lang="en">The loss of cohesion and the generation of very fine particles (chalk / powder like) on the surface of a material. [EwaGlos]</skos:note>
        <skos:note xml:lang="cs">termíny někdy používané pro popsání zrnitého rozpadu jemnozrnných hornin. [ICOMOS-ISCS]</skos:note>
        <skos:prefLabel xml:lang="de">Abmehlen</skos:prefLabel>
