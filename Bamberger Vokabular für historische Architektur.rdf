    <!-- https://hist-arch-vocab.org/bvha#c_e578e87b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_e578e87b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_wyccl4ls"/>
