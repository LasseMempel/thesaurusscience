    <!-- https://hist-arch-vocab.org/bvha#c_e178060d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_e178060d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b320e26f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-16T15:41:14.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-18T15:02:29.000</terms:modified>
        <skos:definition xml:lang="de">Barbakane (frz. v. arab. barbacane), 1. bei ma. Burgen, Stadtbefestigungen und Festungen eine meist halbkreisförmige, mit Schießscharten versehene Vormauer zur Verteidigung des Tors oder als Brückenkopf (Bastille). 2. Schmale, nach hinten erweiterte Schießscharte für Bogenschützen. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Eine dem Tor als beim Angriff besonders gefährdetem Bereich vorgelegte, vom Tor und vom Bering teils oder ganz separierte Wehranlage (»Vortor«), meist jenseits von Zwinger und Graben angelegt. Im englischen Sprachgebrauch auch für Torzwinger, die mit der Hauptumwallung bzw. Ringmauer im Verband stehen oder allgemein für ein befestigtes äußeres Torhaus. Die B. ist eine angeblich aus dem Orient eingeführte Form eines selbständigen Außenwerkes, bei dem der Zugang zunächst längs der Mauer und dann abknickend zum Tor führte, um so Angreifer von der Wehrmauer aus längs bekämpfen zu können (Krakau PL; Schweinsberg HE: Burg, um 1500). M. L. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:definition xml:lang="cs">Objekt před hradem. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Vorwerk einer Burg. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Barbakane</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">barbakan</skos:prefLabel>
    </owl:NamedIndividual>
    


