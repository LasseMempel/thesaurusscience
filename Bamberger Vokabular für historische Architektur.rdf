        <skos:altLabel xml:lang="de">Konopeum</skos:altLabel>
        <skos:altLabel xml:lang="en">aumbrey veil</skos:altLabel>
        <skos:altLabel xml:lang="fr">pavillon de tabernacle</skos:altLabel>
        <skos:definition xml:lang="de">Conopeum n, Konopeum n: aus verschiedenen Materialien (z.B. Seide, Leinen oder Baumwolle) bestehender, schlichter oder verzierter Behang, der das Tabernakel zeltartig umhüllt; das Conopeum unterliegt dem Farbenkanon, darf auch immer weiß sein, nie jedoch schwarz. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Conopeum</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">conopée</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">konopeum</skos:prefLabel>
        <skos:prefLabel xml:lang="en">tabernacle veil</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_b8248b61 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b8248b61">
