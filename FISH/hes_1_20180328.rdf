	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1269">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1269</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">IONAD CEANGAL-LEABHRAICHEAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Factaraidh no ceàrdach far a bheilear a' nasgadh leabhraichean.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BINDING WORKS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1268" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/884" />
		<skos:scopeNote xml:lang="en">A factory or workshop where books are bound.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1272">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1272</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÒN SÌOLAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Linn far a bheil cothrom aig mìrean beaga ann an uisge tuiteam gun ghrunnd 's a' dol nan grùid ann.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SETTLING POND</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1961" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/647" />
		<skos:scopeNote xml:lang="en">A pond where suspended fine particles are allowed to sink to the bottom, forming a sediment.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1273">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1273</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÀRACH OBAIR CLOICHE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far a bheilear a' giullachd, a' dealbhadh, ag obrachadh no a' cruthachadh na cloiche gharbh na bhathar ullamh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">STONE WORKING SITE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1275" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1279" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1284" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/647" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1274" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1276" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1278" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1280" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/977" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1283" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501704" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/504366" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500616" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502995" />
		<skos:scopeNote xml:lang="en">A site where rough stone is processed, shaped worked or formed into finished products.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1274">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1274</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FACTARAIDH LEACAN-CLOICHE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far a bheilear a' gearradh, a' cruthachadh 's ag obrachadh clach ghrùideach sa bheil breathan fìnealta na leacan ullamh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">FLAGSTONE WORKS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">FLAGSTONE QUARRY</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1273" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1279" />
		<skos:scopeNote xml:lang="en">A site where finely laminated sedimentary rock is cut, shaped and worked into finished flagstones.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1275">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1275</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FACTARAIDH CLACH-GHRÀIN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far a bheilear a' dèanamh clachan togail agus bathar ullamh eile de ghoireal.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GRANITE WORKS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1273" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1284" />
		<skos:scopeNote xml:lang="en">A site where granite is worked into building stone and other finished products.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1276">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1276</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÀRACH OBAIR CLOICHE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far an deach fianais a lorg gun robhar ag obair na cloiche ann gus innealan, buill-airm no rudan eile a dhèanamh. Buinidh làraichean mar seo ris na linntean ro-eachdraidheil mar is trice ach chan ann an-còmhnaidh. Cleachd stuth an oibseict ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">LITHIC WORKING SITE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">FLINT WORKING SITE</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1273" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1277">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1277</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">LÀRACH CLACH-CHIÙIRDE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Àite far an robhar a' faighinn chlachan airson buill-cheàird ro-eachdraidheil (a' gabhail a-steach tuaghan) nach robh air an dèanamh de chlach-theine. Chan eilear a' cleachdadh seo ach airson àitichean far an d'fhuaras iad ann an linn ùr na cloiche agus tràth ann an linn an umha. Na cleachd airson làraichean far an robhar a' dùsgadh chlachan-teine no làraichean far an robhar ag obrachadh chlachan-teine.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">STONE AXE FACTORY</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:altLabel xml:lang="en">STONE IMPLEMENT FACTORY</skos:altLabel>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1276" />
				<skos:scopeNote xml:lang="en">A source where stone utilised for the manufacture of prehistoric non-flint stone artefacts, including axes, was obtained. Applied only to sources exploited during the Neolithic and earlier Bronze Age. Do not use for flint mining or knapping sites.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:scopeNote xml:lang="en">A site which has produced evidence of in situ working of stone for the manufacture of tools, weapons or other objects. Such sites will usually, but not always, be of prehistoric date. Use object material where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1278">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1278</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CUARAIDH CHLACHAN-MUILINN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far an robhar a' dùsgadh clachan-muilinn. Dh'fhaoidte gu bheil lagan cruinne ri fhaicinn ann agus clachan-muilinn nach eil buileach deiseil no briste.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MILLSTONE QUARRY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1273" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1114" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501704" />
		<skos:scopeNote xml:lang="en">A site where millstones have been quarried. Circular depressions may be visible, along with unfinished or broken millstones.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1279">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1279</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FACTARAIDH LEACAN CABHSAIR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far a bheilear a' dùsgadh 's a' gearradh chlachan gus leacan cabhsair a dhèanamh. Thathar a' dèanamh leacan concrait ro-mhòlltaichte an-diugh cuideachd.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PAVEMENT WORKS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1273" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1274" />
		<skos:scopeNote xml:lang="en">A site where flagstone is quarried and cut to produce paving slabs. Nowadays, pre-cast concrete slabs are also produced.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1280">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1280</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FACTARAIDH CLACH-OLA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far a bheilear a' tarraing ola à clach-ghuail.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SHALE OIL WORKS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1273" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1184" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/688" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/854" />
		<skos:scopeNote xml:lang="en">A site where oil is produced from shale.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1283">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1283</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FACTARAIDH  STEATAIT</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far a bheilear dèanamh soithichean is rudan eile de chlach-shiabainn.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">STEATITE WORKINGS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-02-25T15:39:22</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1273" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1118" />
		<skos:scopeNote xml:lang="en">A site where vessels and other objects are made from steatite (also known as Soapstone).</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1284">
