  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87554">
    <skos:scopeNote xml:lang="en">A factory where food is preserved either by freezing, salting or pickling</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70006">
    <skos:scopeNote xml:lang="en">A rectangular or trapezoidal earthen mound of Neolithic date, usually accompanied by flanking or encircling ditches, and normally associated with human remains. Mound construction and associated features vary considerably in type and complexity.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69384">
