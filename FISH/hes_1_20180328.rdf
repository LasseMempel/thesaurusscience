				<skos:prefLabel xml:lang="gd">MÈINN DEARG-CHRÈADHA</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Làrach far a bheilear a' dùsgadh ogsaid iarainn agus sulfaid iarainn.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">OCHRE MINE</skos:prefLabel>
