<http://lvr.vocnet.org/wnk/wk021263> a skos:Concept ;
    skos:altLabel "Grünalgen"@de,
        "green algae"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk011045> ;
    skos:definition "Grünalgen sind Algen, die überwiegend im Süßwasser, aber auch im Salzwasser und auf feuchten Landflächen vorkommen. Sie enthalten Chlorophyll a und b und sind dadurch grün gefärbt."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Grünalge"@de,
        "green alga"@en .

<http://lvr.vocnet.org/wnk/wk021266> a skos:Concept ;
    skos:altLabel "Bärlapppflanzen"@de ;
    skos:broadMatch <http://vocab.getty.edu/aat/300310157> ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000855> ;
    skos:definition "Eine Bärlapppflanze ist eine Gefäßpflanze, die wie Farne Sporen statt Samen bildet.  Sie besitzt nur kleine, schuppenartige Blätter, sogenannte Mikrophylle, und meist gabelig verzweigte Stängel. Rezente Bärlapppflanzen sind klein und krautig, im Karbon wuchsen sie jedoch zu riesigen Bäumen und bildeten die Grundlage für die Steinkohlevorkommen."@de ;
    skos:exactMatch <http://www.wikidata.org/entity/Q1149748> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:narrowMatch <http://d-nb.info/gnd/4143901-6> ;
    skos:prefLabel "Bärlapppflanze"@de .

