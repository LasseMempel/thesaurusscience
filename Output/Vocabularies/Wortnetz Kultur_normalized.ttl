    skos:related <http://lvr.vocnet.org/wnk/wk009489> .

<http://lvr.vocnet.org/wnk/wk021137> a skos:Concept ;
    skos:altLabel "Rasierklingen-Schärfer"@de,
        "razor sharpeners"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk009927> ;
    skos:definition "Ein Rasierklingenschärfer ist ein Gerät zum Nachschärfen von Rasierklingen. In der Regel erfolgt die Schärfung durch Schleifsteine, über die die Klingen geführt werden. Je nach Modell kommen unterschiedliche Techniken zum Einsatz."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Rasierklingenschärfer"@de,
        "razor sharpener"@en ;
    skos:related <http://lvr.vocnet.org/wnk/wk012371> .

<http://lvr.vocnet.org/wnk/wk021241> a skos:Concept ;
    skos:altLabel "Apothekenflasche"@de,
        "Apothekenflaschen"@de,
        "Apothekenfläschen"@de,
        "Apothekerflaschen"@de,
        "apothecary bottles"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk004610>,
        <http://lvr.vocnet.org/wnk/wk019046> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q63813700> ;
    skos:definition "Eine Apothekerflasche ist eine Flasche, die historisch in Apotheken und Laboren zur Aufbewahrung von Arzneimitteln und Chemikalien verwendet wurde. Sie ist meist aus dickwandigem, braunem oder klarem Glas gefertigt, zylindrisch oder vierkantig mit kurzem Hals und wird oft mit einem Stopfen aus Glas oder Kork verschlossen. Typischerweise hat sie ein Volumen zwischen 50 und 500 ml. Der Name der enthaltenen Substanz steht üblicherweise auf dem Glaskörper."@de ;
    skos:exactMatch <http://vocab.getty.edu/aat/300378929> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Apothekerflasche"@de,
        "apothecary bottle"@en ;
    skos:related <http://lvr.vocnet.org/wnk/wk007493> .

<http://lvr.vocnet.org/wnk/wk021247> a skos:Concept ;
    skos:altLabel "Trommelreiben"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk004969>,
        <http://lvr.vocnet.org/wnk/wk013080> ;
    skos:definition "Eine Trommelreibe ist eine Küchenmühle, die Zutaten durch Zerspanung zerkleinert. Das zu zerkleinernde Lebensmittel wird dabei gegen eine rotierende Trommel mit scharfen Klingen oder Öffnungen gedrückt."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Trommelreibe"@de,
        "drum grater"@en .

<http://lvr.vocnet.org/wnk/wk021256> a skos:Concept ;
    skos:altLabel "Mikrofossilien"@de,
        "microfossils"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk001811> ;
    skos:definition "Ein Mikrofossil ist ein Fossil von mikroskopischer Größe, das also in der Regel unter einem bis zwei Millimeter groß ist. Dazu zählen sowohl fossile Überreste von Mikroorganismen als auch winzige Reste oder Spuren größerer Lebewesen. Bei den Gruppen, die üblicherweise als Mikrofossilien bezeichnet werden, gibt es allerdings auch Exemplare, die über einen Zentimeter groß werden können."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4169818-6>,
        <http://vocab.getty.edu/aat/300379441>,
        <http://www.wikidata.org/entity/Q1761786> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Mikrofossil"@de,
        "microfossil"@en .

<http://lvr.vocnet.org/wnk/wk021280> a skos:Concept ;
    skos:altLabel "Cnidarier"@de,
        "Nesseltiere"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk001769> ;
    skos:definition "Nesseltiere sind vielzellige, im Wasser lebende Tiere, die überwiegend im Meer vorkommen und die durch Nesselzellen gekennzeichnet sind, mit denen sie bei Berührung giftige Nesselfäden zum Beutefang oder zur Verteidigung ausschleudern. Zu den Nesselieren zählen unter anderem Quallen, Korallen, Seeanemonen und Hydren."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Nesseltier"@de .

<http://lvr.vocnet.org/wnk/wk021292> a skos:Concept ;
