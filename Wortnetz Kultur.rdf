		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-05-20T10:29:49+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021256">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">microfossil</skos:prefLabel>
		<skos:altLabel xml:lang="en">microfossils</skos:altLabel>
		<skos:prefLabel xml:lang="de">Mikrofossil</skos:prefLabel>
		<skos:altLabel xml:lang="de">Mikrofossilien</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk001811"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk001811"/>
		<skos:definition xml:lang="de">Ein Mikrofossil ist ein Fossil von mikroskopischer Größe, das also in der Regel unter einem bis zwei Millimeter groß ist. Dazu zählen sowohl fossile Überreste von Mikroorganismen als auch winzige Reste oder Spuren größerer Lebewesen. Bei den Gruppen, die üblicherweise als Mikrofossilien bezeichnet werden, gibt es allerdings auch Exemplare, die über einen Zentimeter groß werden können.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300379441"/>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4169818-6"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1761786"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk001811"/>
