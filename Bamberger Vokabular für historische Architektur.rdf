        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-13T13:53:14.000</terms:modified>
        <skos:definition xml:lang="de">Spatula f (Iat.) : ein flaches silbernes Löffelchen, mit dem heiliges Öl aus dem Chrismarium entnommen wird. [Glossarium Artis]</skos:definition>
