		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk017957"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk018390"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk006114"/>
		<skos:definition xml:lang="de">Ein Nagel ist ein Befestigungselement aus Metall oder Holz, das aus einem schlanken Schaft mit einem zugespitzten Ende und einem flachen Kopf besteht. Er wird in der Regel mit einem Hammer eingeschlagen.</skos:definition>
