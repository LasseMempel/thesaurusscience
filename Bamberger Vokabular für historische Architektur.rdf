        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-01T11:56:44.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T12:32:43.000</terms:modified>
        <skos:altLabel xml:lang="de">Kreuzwunder der Helena</skos:altLabel>
        <skos:definition xml:lang="de">Kreuzauffindung f; lat. inventio crucis: die legendäre Schilderung von der hl. Helena, welche die drei Kreuze, an denen Christus und die beiden Schacher gestorben waren, wieder gefunden haben soll. In der kath. Kirche wurde die Kreuzauffindung (bis 1960) am 3. Mai gefeiert. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Kreuzauffindung</skos:prefLabel>
        <skos:prefLabel xml:lang="en">discovery of the True Cross</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">découverte de la Vraie Croix</skos:prefLabel>
        <skos:prefLabel xml:lang="la">inventio crucis</skos:prefLabel>
    </owl:NamedIndividual>
    


