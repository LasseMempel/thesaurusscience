	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/768">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/768</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">ÀTH-BHRACHA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àth, mar is trice le mullach biorramaideach is luidhear le ceann air, a chleachdar gus crìoch a chur air failleanachadh ann am brachadh an eòrna. Gheibhear seo air làrach sabhail-bhrachaidh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MALT KILN</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/993" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/764" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/73" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/767" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/769" />
		<skos:scopeNote xml:lang="en">A kiln, usually with a pyramidal roof and capped vent, used to arrest the germination process in malted barley. Found on the site of a malt house.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
