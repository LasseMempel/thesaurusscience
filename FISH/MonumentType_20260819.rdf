  <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140192">
    <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2"/>
    <skos:prefLabel xml:lang="en">HUERS HUT</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Hut along the coast, which provided shelter for lookouts, known as huers, who kept watch for the pilchard shoals that passed by the coast. Built of stone or wood. Particular common to Cornwall.</skos:scopeNote>
    <dc1:identifier rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140192"/>
    <dc1:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-08-19T18:09:31</dc1:issued>
