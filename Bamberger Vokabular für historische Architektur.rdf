        <skos:prefLabel xml:lang="de">Nagel des Herrn</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Saint-Clou</skos:prefLabel>
        <skos:prefLabel xml:lang="la">clavus Domini</skos:prefLabel>
    </owl:NamedIndividual>
    


