    <!-- https://hist-arch-vocab.org/bvha#c_5d47f525 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_5d47f525">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_fbedadd4"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_b41bd73a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-18T09:39:02.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-27T14:44:41.000</terms:modified>
        <skos:altLabel xml:lang="en">mullion</skos:altLabel>
        <skos:definition xml:lang="de">Feststehender Mittelpfosten eines Fensters. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Senkrechtes Holz der Innenkonstruktion des Fensterrahmens das zwischen Oberschenkel und Querholz eingesetzt ist. Es kommt nur dann vor, wenn in der unteren Etage des Fensters zwei Drehflügel mit aufgehendem Pfosten und in der oberen Etage eine Festverglasung eingesetzt sind. Das Setzholz dient der Verlängerung des Pfostens, es ist ein Höhenholz. [Noky 1996]</skos:definition>
        <skos:prefLabel xml:lang="de">Setzholz</skos:prefLabel>
        <skos:prefLabel xml:lang="es">entreventana</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">meneau vertical de bois</skos:prefLabel>
        <skos:prefLabel xml:lang="it">montante di croce di finestra</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">sloupek okenního rámu</skos:prefLabel>
        <skos:prefLabel xml:lang="en">window post</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_5d4b5d3b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_5d4b5d3b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_9b5b214b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_42c67dc9"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_9d0e6da4"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_9e8572ba"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_c144fbd9"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_d661e186"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_67e21097"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-02T15:07:06.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-04T14:08:52.000</terms:modified>
        <skos:altLabel xml:lang="en">clerical dress</skos:altLabel>
        <skos:altLabel xml:lang="en">official costume</skos:altLabel>
        <skos:altLabel xml:lang="fr">vêtements de fonction</skos:altLabel>
        <skos:definition xml:lang="de">Amtstracht f, klerikale: Kleidung, welche die Geistlichen bei administrativen Handlungen, Diensten und vielerlei Anlässen tragen, z. B. bei kirchlichen und weltlichen Feiern, in Seminaren und bei Teilnahmean einer von einem anderen Kleriker gehaltenen Messe. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Veredelung der Oberfläche einer Konstruktion durch eine nichttragende Materialschicht aus ästhet. Gründen, zur Erhöhung der Widerstandsfähigkeit gegen Abnutzung, Verwitterung, Feuchte und Brand oder zur Verbesserung akust. und therm. Eigenschaften: Anstriche und Schutzschichten (Putz, Stuck, Estrich), Inkrustationen (Mosaik, Fliesen), Furniere, Tapeten, Täfelungen und Schalungen. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Bekleidung</skos:prefLabel>
        <skos:prefLabel xml:lang="en">ceremonial vestments</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">habit clérical</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">oděv</skos:prefLabel>
    </owl:NamedIndividual>
    


