		<skos:prefLabel xml:lang="en">heart (of the town/village)</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Ortskern</skos:prefLabel>
		<skos:altLabel xml:lang="de">Ortskerne</skos:altLabel>
		<skos:altLabel xml:lang="de">Ortsmitte</skos:altLabel>
		<skos:altLabel xml:lang="de">Ortszentrum</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk001980"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk005739"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010258"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk014663"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019816"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk001980"/>
		<xe:explanation_temp xml:lang="de">Da sich der Ortskern räumlich häufig mit dem historischen Kern einer Siedlung überschneidet, befinden sich hier meist auch die wichtigsten Kirchen, sehenswerten Gebäude, Bau- und Kulturdenkmäler eines Ortes.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Ortskern ist ein Siedlungsteil, an dem sich die Einrichtungen des Handels, der Dienstleistungs- und Verwaltungseinrichtungen sowie des Verkehrs (Verkehrswege, Bahnhöfe) innerhalb eines Ortes in zentraler Lage konzentrieren.</skos:definition>
		<skos:mappingRelation rdf:resource="http://d-nb.info/gnd/4222111-0"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk001980"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010258"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk005739"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk014663"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019816"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003436"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003437"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
