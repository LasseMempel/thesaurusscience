		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk001205"/>
		<skos:definition xml:lang="de">Eschboden ist anthropogener Boden, der durch künstlichen Bodenauftrag bestehend aus einer Mischung aus Sand und Tierexkrementen zur Steigerung der Ertragsfähigkeit entsteht.</skos:definition>
		<skos:broadMatch rdf:resource="http://d-nb.info/gnd/4174772-0"/>
