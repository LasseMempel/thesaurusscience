    <!-- https://hist-arch-vocab.org/bvha#c_c4f800dd -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_c4f800dd">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_152bb636"/>
