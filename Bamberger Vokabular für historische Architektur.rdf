        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-28T08:25:28.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T11:39:27.000</terms:modified>
        <skos:altLabel xml:lang="cs">podpěra</skos:altLabel>
        <skos:altLabel xml:lang="cs">rozpěra</skos:altLabel>
        <skos:altLabel xml:lang="it">saettone</skos:altLabel>
        <skos:altLabel xml:lang="en">strut</skos:altLabel>
        <skos:altLabel xml:lang="cs">zápora</skos:altLabel>
        <skos:altLabel xml:lang="fr">étrésillon</skos:altLabel>
        <skos:definition xml:lang="de">An beiden Enden gezapftes, schräg verlaufendes Holz. [Eißing et al. 2012]</skos:definition>
        <skos:definition xml:lang="de">Schräg gestelltes, versteifendes Holz zur Aufnahme von Druckkräften, zumeist eingezapft, seltener angeblattet (Band); zwei sich überkreuzende S.n werden Kreuzs. (Schere) oder Andreaskreuz genannt. Eine kurze S. (Kopf- und Fußs.) wird auch fälschl. Band genannt. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Strebe</skos:prefLabel>
        <skos:prefLabel xml:lang="it">contraffisso</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">jambe de force</skos:prefLabel>
        <skos:prefLabel xml:lang="es">puntal</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">vzpěra</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_1fc840f3 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_1fc840f3">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_46483b7b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-28T12:16:20.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T11:41:47.000</terms:modified>
        <skos:definition xml:lang="de">Triangelkreuz n: ein Kreuz, dessen Balken in einem Dreieck mit nach außen gerichteter Basis enden. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Triangelkreuz</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">croix à triangles</skos:prefLabel>
        <skos:prefLabel xml:lang="en">triangulated cross</skos:prefLabel>
    </owl:NamedIndividual>
    


