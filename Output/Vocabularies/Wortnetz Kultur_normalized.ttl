    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:narrowMatch <http://d-nb.info/gnd/1036714667>,
        <http://d-nb.info/gnd/4757157-3> ;
    skos:prefLabel "Drag-Künstler"@de,
        "drag artist"@en .

<http://lvr.vocnet.org/wnk/wk021141> a skos:Concept ;
    skos:altLabel "Gummi (Verhütungsmittel)"@de,
