        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-01T11:24:05.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T18:46:34.000</terms:modified>
        <skos:definition xml:lang="de">Tür mit zwei in geringem Abstand hintereinander angeordneten Türblättern zur Schalldämmung oder Wärme-isolierung. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Doppeltür</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_5d9ecbc1 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_5d9ecbc1">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
