  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92351">
    <skos:scopeNote xml:lang="en">The residence and sometimes workplace of industrial workers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93216">
    <skos:scopeNote xml:lang="en">A place where saltpetre, the chief component of gunpowder, is kept.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93214">
    <skos:scopeNote xml:lang="en">A hut, usually containing lead pans, in which salt water is boiled to produce salt.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92563">
    <skos:scopeNote xml:lang="en">The residence of a marsh keeper.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92806">
    <skos:scopeNote xml:lang="en">A room where surgical operations are performed. Originally in the form of a room with a raised table surrounded by tiered seating from where students could watch an operation or disection be performed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70028">
    <skos:scopeNote xml:lang="en">A funeral rite in which the human body is burnt, usually on a pyre, leaving fragmentary charred or completely combusted remains. Often found buried, occasionally in a container associated with grave goods.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92206">
    <skos:scopeNote xml:lang="en">A workshop for combining flax or hemp as a preparatory stage of rope making.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69039">
    <skos:scopeNote xml:lang="en">An artificial mound, generally conical, placed within a garden or park to provide a viewing point to overlook the garden or park. It may also serve as a visual focus in the garden or park layout.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87943">
    <skos:scopeNote xml:lang="en">A factory where pencils are manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/145089">
    <skos:scopeNote xml:lang="en">A building or part of a building used for the storage of stationery materials.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91414">
    <skos:scopeNote xml:lang="en">Large storage structure for powdered cement.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140277">
    <skos:scopeNote xml:lang="en">An airfield building housing a turret gunnery trainer used to teach air gunners how to report the correct position of enemy aircraft by practising shooting against projected moving images of enemy aircraft displayed on a target screen (WWII).</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/130933">
    <skos:scopeNote xml:lang="en">A maze used for the act of penitence.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160278">
    <skos:scopeNote xml:lang="en">A building housing a flight simulator designed to air ministry drawing number 10040/41.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71506">
    <skos:scopeNote xml:lang="en">Originally, a house of higher social status in a town or port, often with a storage cellar.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92467">
    <skos:scopeNote xml:lang="en">A workshop used for the small-scale production of leather goods.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/74787">
    <skos:scopeNote xml:lang="en">A place of worship for Strict Baptists, a sect who broke away from the Particular Baptists and kept up the practice of denying communion to non members after the union of General and Particular Baptists was formed in 1891.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159217">
    <skos:scopeNote xml:lang="en">A walkway on the top of a defensive wall, providing access to the parapets and towers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69946">
    <skos:scopeNote xml:lang="en">A hall licensed for musical performances, singing, dancing and other entertainments, exclusive of dramatic performance.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143000">
    <skos:scopeNote xml:lang="en">Temporary accommodation for war evacuees.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92902">
    <skos:scopeNote xml:lang="en">A place where the science of historical and comparative language is taught.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93030">
    <skos:scopeNote xml:lang="en">Nowadays a hospital where patients suffering from psychiatric disorders receive medical care and treatment. Traditionally they were often places where psychiatric patients were kept confined away from society receiving minimal medical care or attention.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99584">
    <skos:scopeNote xml:lang="en">Buildings, sites and structures associated with the production, testing and storage of gunpowder.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93073">
    <skos:scopeNote xml:lang="en">A building where radium is used in the treatment of cancer.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71516">
    <skos:scopeNote xml:lang="en">A model village built in association with a factory, mill, railway, or any other industrial complex; usually built by the employer.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94384">
    <skos:scopeNote xml:lang="en">An upright, or originally upright, stone featuring a hole which is often large enough in diameter for a person to pass through, eg. Men an Tol, Cornwall. Do not use for perforated portable stone artefacts.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162728">
    <skos:scopeNote xml:lang="en">A woollen mill in which the cloth was passed over rollers covered in short spikes to raise the nap in one direction only.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/100215">
    <skos:scopeNote xml:lang="en">A covered way or passage especially in a cathedral or monastic church, leading east from the cloisters between transept and chapter house.</skos:scopeNote>
  </rdf:Description>
