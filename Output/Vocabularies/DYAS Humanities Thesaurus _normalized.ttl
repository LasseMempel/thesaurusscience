    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Inscriptions related to issues of religion."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/627> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/186> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Muslim religious communities"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1583>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/430> ;
    skos:scopeNote "Communities of believers that follow one of the branches of Islam. Muslim communities (Sunnites, Shiites, Shafiites, Hanbalites etc.) differ as to particular beliefs and (more seldom) forms of worship, but mainly as to traditions and practices of communal and social organization, as well as of law enforcement."@en .

