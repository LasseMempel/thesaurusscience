        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-21T17:13:32.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-10T11:03:26.000</terms:modified>
        <skos:definition xml:lang="de">Knotenstrick m: der weiße, mit Knoten versehene Strick, mit dem die Kutte der Franziskaner und ihrer Zweigorden gegürtet wird. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Knotenstrick</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">cordelière</skos:prefLabel>
        <skos:prefLabel xml:lang="en">knotted cord</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_fc304d3c -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_fc304d3c">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f4e2bee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_19d56a39"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_63d013eb"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-18T12:32:32.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-12-01T14:35:58.000</terms:modified>
        <skos:altLabel xml:lang="cs">nižší příčná střecha se štítem u okapu sedlové střechy</skos:altLabel>
        <skos:definition xml:lang="de">Ein Dachaufbau in Flucht der Traufwand, dessen First quer zum First des Hauptdaches verläuft, heißt Querdach oder Zwerchdach. Liegt seine Traufe oberhalb der Traufe des Hauptdaches, so dass eine Seitenwand ausgebildet wird, spricht man vom Zwerchhaus. [Eißing et al. 2012]</skos:definition>
        <skos:definition xml:lang="de">Querdach, quer zum Hauptfirst verlaufendes Dach, z.B. beim Zwerchhaus. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Vikýřová stříška procházející napříč k hlavnímu hřebenu střechy, např. u zastřešeného vikýře s obytným prostorem. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Zwerchdach, 1. Lukarne. 2. Querdach, ein senkrecht zum Hauptdach ausgerichtetes, kleineres Dach, bes. bei got. Seitenschiffen verwandt, wo über jedem Joch ein Walm- oder Satteldach aufsitzt und sich damit eine Reihung ergibt, auch vereinzelt angewandt, dort auch als Ziergiebel. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Zwerchdach</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">boční stříška</skos:prefLabel>
        <broaderByPosition rdf:resource="https://hist-arch-vocab.org/bvha#c_f4e2bee8"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_fc3476fc -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_fc3476fc">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_dd883e1f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-21T13:15:35.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T13:02:21.000</terms:modified>
        <skos:altLabel xml:lang="it"> catenaccio</skos:altLabel>
        <skos:altLabel xml:lang="en"> rail beam</skos:altLabel>
        <skos:altLabel xml:lang="es"> travesaño</skos:altLabel>
        <skos:altLabel xml:lang="de">Balkenriegel</skos:altLabel>
        <skos:altLabel xml:lang="de">Klemmbalken</skos:altLabel>
        <skos:altLabel xml:lang="de">Sperrbalken</skos:altLabel>
        <skos:altLabel xml:lang="de">Verschlussbalken</skos:altLabel>
        <skos:altLabel xml:lang="es">barra</skos:altLabel>
        <skos:altLabel xml:lang="fr">barre</skos:altLabel>
        <skos:altLabel xml:lang="it">spranga di legno</skos:altLabel>
        <skos:altLabel xml:lang="fr">traverse</skos:altLabel>
        <skos:definition xml:lang="de">Ein in einen Mauerkanal einschiebbarer Balken, der bei geschlossenem Tor auf der Innenseite über dieses hinweg in eine entsprechende Maueraussparung geschoben wird und dadurch die Torflügel auch gegen kräftigen Druck sichert. [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Riegelbalken, Sperrbalken, Klemmbalken, Verschlussbalken, zum Verschließen eines Tors dienender Balken; er läuft in seitl. Mauerschlitzen, wird in Mauerlöcher zurückgeschoben oder ist in Klauen eingehängt. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="it"> chiavaccio</skos:prefLabel>
        <skos:prefLabel xml:lang="es"> tranca</skos:prefLabel>
        <skos:prefLabel xml:lang="fr"> épar(t)</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Riegelbalken</skos:prefLabel>
        <skos:prefLabel xml:lang="en">cross beam</skos:prefLabel>
    </owl:NamedIndividual>
    


