	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004218">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="en">Ala fort</skos:altLabel>
		<skos:prefLabel xml:lang="de">Alenkastell</skos:prefLabel>
		<skos:altLabel xml:lang="de">Alenkastelle</skos:altLabel>
		<skos:altLabel xml:lang="de">Alenlager</skos:altLabel>
		<skos:prefLabel xml:lang="en">Roman cavalry fort</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004216"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010526"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk016332"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019909"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004216"/>
		<skos:definition xml:lang="de">Ein Alenkastell ist ein römisches Auxiliarlager, das speziell für die Stationierung einer berittenen Einheit (Ala quingenaria oder Ala milliaria) eingerichtet wurde. Es ist in Größe und Grundriss auf die Bedürfnisse der Kavallerie ausgerichtet, etwa mit größeren Stallungen für Pferde und erweiterten Flächen als Reitplatz oder Übungsflächen.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004216"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010526"/>
