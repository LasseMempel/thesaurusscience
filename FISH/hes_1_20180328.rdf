				<skos:prefLabel xml:lang="gd">SEÒMAR NAN SEUD</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Togalach a chleachdar airson stòradh sàbhailte agus taisbeanadh poblach de sheòid, m.e. seòid a' chrùin.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">JEWEL HOUSE</skos:prefLabel>
