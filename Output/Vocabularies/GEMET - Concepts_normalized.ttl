    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Ökologie"@de,
        "ecology"@en .

<http://www.eionet.europa.eu/gemet/concept/2490> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:closeMatch <http://data.uba.de/umt/_00027912>,
        <http://dbpedia.org/resource/Economic_growth> ;
