    <!-- https://hist-arch-vocab.org/bvha#c_54af5a6c -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_54af5a6c">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b6prqhi5"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-05T20:21:29.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T14:59:15.000</terms:modified>
        <skos:altLabel xml:lang="de">Formgips</skos:altLabel>
        <skos:altLabel xml:lang="de">Plaster of Paris</skos:altLabel>
        <skos:note xml:lang="en">A white, fıne, inorganic and quicksetting powder that is made by heating gypsum to 120–180 °C in dry conditions (calcinated gypsum). It is composed of hemihydrate as well as impurities originating from the natural source, such as anhydrite. [EwaGlos]</skos:note>
        <skos:note xml:lang="de">Ein weißes, feines, anorganisches und schnell abbindendes Pulver, das beim Erhitzen von Gips bei 120–180 °C, unter trockenen Bedingungen, entsteht (kalzinierter Gips). Es besteht aus Halbhydrat und natürlichen Verunreinigungen, wie z.B. Anhydrit. [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="de">Modellgips</skos:prefLabel>
        <skos:prefLabel xml:lang="en">plaster of Paris</skos:prefLabel>
    </owl:NamedIndividual>
    


