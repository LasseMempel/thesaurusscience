        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-30T12:18:26.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T11:01:33.000</terms:modified>
        <skos:altLabel xml:lang="de">Eckklaue </skos:altLabel>
        <skos:altLabel xml:lang="de">Eckknolle </skos:altLabel>
        <skos:altLabel xml:lang="de">Ecksporn </skos:altLabel>
        <skos:altLabel xml:lang="en">angle leaf</skos:altLabel>
        <skos:altLabel xml:lang="en">griffe </skos:altLabel>
        <skos:altLabel xml:lang="fr">patte</skos:altLabel>
        <skos:definition xml:lang="de">Eckblatt, -sporn, Verzierungen in den Zwickeln zwischen der kreisförmigen Grundfläche der Säulenbasis und der quadratischen Plinthe. Hauptsächlich Romanik und Gotik. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Ein figürlicher Dekor in den Ecken der quadratischen Plinthe, auf der eine Rundsäule steht. [Glossarium Artis] </skos:definition>
        <skos:definition xml:lang="cs">Ozdoby v rozích mezi základní kruhovou plochou sloupové packy a čtvercovou plintou, především v románské a gotické době. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Eckblatt</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">drápek</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">griffe feuillagée </skos:prefLabel>
        <skos:prefLabel xml:lang="en">spur</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Blattförmige Eckzier. [Koepf / Binding 2016]</skos:scopeNote>
    </owl:NamedIndividual>
    


