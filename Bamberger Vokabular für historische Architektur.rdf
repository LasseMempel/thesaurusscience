        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T12:27:12.000</terms:modified>
        <skos:altLabel xml:lang="de">Utlucht</skos:altLabel>
        <skos:definition xml:lang="de">1. Auch Utlucht, an Renaissancebauten Niedersachsens ein vom Erdboden aufsteigender, meist mehrgeschossiger, erkerartiger Vorbau an einer oder zu beiden Seiten der Haustüre. 2. Über einem Seitenschiffjoch errichteter Querdachgiebel, bes. an got. Kirchen Ostdeutschlands (Lucht). [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Besonders an den Wohnhäusern der niedersächsischen Renaissance üblicher erkerartiger Vorbau des Erdgeschosses oder mehrerer Geschosse an einer oder beiden Seiten der Haustür. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Auslucht</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">arkýřový výstupek</skos:prefLabel>
    </owl:NamedIndividual>
    


