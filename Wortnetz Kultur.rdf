		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk010606"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk010606"/>
		<xe:explanation_temp xml:lang="de">Die ersten Raupenbahnen gab es ab Mitte der 1920er Jahre, sie waren auf Jahrmärkten bis um 1970 im Einsatz.</xe:explanation_temp>
		<skos:definition xml:lang="de">Eine Raupenbahn ist eine Berg- und Talbahn, deren Wagenreihung von einem Stoffverdeck verhüllt ist und damit die Form einer Raupe nachempfindet.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010606"/>
