	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk014914">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">acetic acid</skos:prefLabel>
		<skos:altLabel xml:lang="de">Acetylsäure</skos:altLabel>
		<skos:prefLabel xml:lang="la">acidum aceticum</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Essigsäure</skos:prefLabel>
		<skos:altLabel xml:lang="de">Essigsäuren</skos:altLabel>
		<skos:altLabel xml:lang="de">Ethansäure</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk014913"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk014913"/>
		<xe:explanation_temp xml:lang="de">Essigsäure ist Carbonsäure mit der Zusammensetzung C2H4O2 (Halbstrukturformel CH3COOH). Als Lebensmittelzusatzstoff hat sie die Bezeichnung E 260. Wässrige Lösungen der Essigsäure werden ausschließlich Essig, reine Essigsäure Eisessig genannt. Die Salze und Ester der Essigsäure heißen Acetate oder (systematisch) Ethanoate.</xe:explanation_temp>
		<skos:definition xml:lang="de">Essigsäure ist eine flüssige Säure, die farblos, ätzend und einen säuerlich-stechenden Geruch aufweist. </skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300011753"/>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4153052-4"/>
