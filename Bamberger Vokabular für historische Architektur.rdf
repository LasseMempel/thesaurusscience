        <skos:altLabel xml:lang="en">mortuary chapel</skos:altLabel>
        <skos:definition xml:lang="de">Grabkapelle, Kapelle, meist in unmittelbarer Nähe einer Kirche, in der Bischöfe oder Adelige beigesetzt sind (im Gegensatz zum Karner, dem Beinhaus mit darüberliegender Kapelle). [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Grabkapelle</skos:prefLabel>
        <skos:prefLabel xml:lang="es">capilla funeraria</skos:prefLabel>
        <skos:prefLabel xml:lang="it">cappella funeraria</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">chapelle funéraire</skos:prefLabel>
        <skos:prefLabel xml:lang="en">funerary chapel</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_a252a285"/>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_b5206255"/>
