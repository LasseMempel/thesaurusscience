        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-06T19:34:46.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T15:07:32.000</terms:modified>
        <skos:definition xml:lang="de">Nuntius m, lat.: ständiger diplomatischer Vertreter des Papstes bei den Regierungen im Ausland. Erträgt die bischöflichen Gewänder, die aus Seidenmoiré gefertigt sind. [Glossarium Artis]</skos:definition>
