	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/501706">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/501706</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÀRACH OBAIR-MÈINNE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite far a bheilear ri mèinnearachd, daoine a' dùsgadh clachan-mèinnir, gual, salann no seudan às an talamh. Cleachd MÈINN shònraichte ma tha fhios cò tè, m.e. MÈINN LUAIDHE.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MINE WORKINGS</skos:prefLabel>
