        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_ce3a167b"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_d51ad471"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_d9fa2689"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_da943b7b"/>
