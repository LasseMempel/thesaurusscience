        <http://purl.org/heritagedata/schemes/38076/concepts/3020> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/38076> ;
    skos:prefLabel "Saltwater incursion"@en ;
    skos:scopeNote "Movement of saline waters into freshwater zones"@en .

<http://purl.org/heritagedata/schemes/38076/concepts/30200> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/38076/concepts/3020>,
        <http://purl.org/heritagedata/schemes/38076/concepts/4020> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/38076> ;
    skos:prefLabel "Coastal flooding"@en ;
    skos:scopeNote "Episodic flooding of coastal areas. Connected to rising sea levels, storm surges, wave action, and high tides."@en .

<http://purl.org/heritagedata/schemes/38076/concepts/30300> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/38076/concepts/3030>,
        <http://purl.org/heritagedata/schemes/38076/concepts/5010> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/38076> ;
    skos:prefLabel "Coastal erosion"@en ;
    skos:scopeNote "Long term or episodic changes of shorelines. Caused by storms, rising sea levels, wave action, tides, wind-driven rain, ocean currents, and ice."@en .

<http://purl.org/heritagedata/schemes/38076/concepts/30301> a skos:Concept ;
    skos:altLabel "Coastal instability"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/38076/concepts/3030> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/38076> ;
    skos:prefLabel "Coastal landslide"@en ;
    skos:scopeNote "Rapid loss or movement of coastlines."@en .

