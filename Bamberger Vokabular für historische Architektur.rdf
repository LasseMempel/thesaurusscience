        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_b41bd73a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-13T16:46:50.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T16:34:31.000</terms:modified>
        <skos:definition xml:lang="de">Fenstergewände, schräg eingeschnittene, seitl. Begrenzung eines Fensters in Mauerdicke. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Schräge Einschnittflächen der Fensteröffnungen in Mauern, heute in der Fachliteratur auch verwendet als Begriff für die äußere Rahmung in Werkstein, welche oft eine der Bauzeit entsprechende Profilierung aufweist. [Noky 1996]</skos:definition>
        <skos:prefLabel xml:lang="de">Fenstergewände</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">okenní šikmé ostění</skos:prefLabel>
        <broaderByPosition rdf:resource="https://hist-arch-vocab.org/bvha#c_a80d827a"/>
    </owl:NamedIndividual>
    


