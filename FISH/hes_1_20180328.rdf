				<skos:prefLabel xml:lang="gd">POIRDSE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Fasgadh air an taobh a-staigh no a stobas a-mach 's a tha mun cuairt air doras togalaich.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">PORCH</skos:prefLabel>
