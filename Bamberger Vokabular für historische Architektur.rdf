        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T11:18:58.000</terms:modified>
        <skos:definition xml:lang="de">Langriegel: Riegel, der Feld- oder Bundständer überblattet oder verschränkt; unterer, mittlerer, oberer Feldriegel: Riegel, die das Feld in der Höhe unterteilen. (Eißing et al. 2012)</skos:definition>
        <skos:prefLabel xml:lang="de">Langriegel</skos:prefLabel>
    </owl:NamedIndividual>
    


