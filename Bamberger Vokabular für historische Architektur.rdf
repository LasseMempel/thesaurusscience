        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_110d9426"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_4b599987"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_d1aa2cea"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-04T12:53:37.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T14:18:52.000</terms:modified>
        <skos:altLabel xml:lang="en"> astragal</skos:altLabel>
        <skos:altLabel xml:lang="en"> torus</skos:altLabel>
        <skos:altLabel xml:lang="cs">astragal</skos:altLabel>
        <skos:altLabel xml:lang="es">junquillo</skos:altLabel>
        <skos:altLabel xml:lang="cs">podhrlek</skos:altLabel>
        <skos:definition xml:lang="de">Stabförmiger, zylindr. Bauteil, hauptsächl. bei Profilen, Rippen, Fenster- und Portalgewänden der Gotik (Stab). Ein Dreiviertelstab ist ein R. mit Dreiviertelkreisquerschnitt.[Koepf / Binding 2016] </skos:definition>
        <skos:definition xml:lang="de">Zierstab, dessen Querschnitt einen Viertel-, Halb- oder Dreiviertelkreis ( Viertel-, Halbrund-, Dreiviertelstab) bildet. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">a) české synonymum pro torus, b) ozdobný prut, jehož průřez tvoří čtvrtkruh, půlkruh nebo tříčtvrteční kruh. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="fr"> baguette</skos:prefLabel>
        <skos:prefLabel xml:lang="en"> baston</skos:prefLabel>
        <skos:prefLabel xml:lang="it"> tondo</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Rundstab</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">obloun</skos:prefLabel>
        <skos:prefLabel xml:lang="es">tapajuntas</skos:prefLabel>
    </owl:NamedIndividual>
    


