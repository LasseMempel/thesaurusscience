        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T09:38:17.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T01:04:02.000</terms:modified>
        <skos:definition xml:lang="cs">AGORA (řec. trh), náměstí řeckého města sloužící různým účelům. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Agora (gr. Markt), Platz der gr. Stadt, auf dem Versammlungen und Märkte abgehalten wurden, meist rechteckig und von Säulenhallen (Stoa) umgeben, mit einem oder mehreren Altären und mit Denkmälern. An oder in der Nähe der A. lagen das Rathaus (Buleuterion) und das Haus der städt. Behörden (Prytaneion). [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Agora (griech. Markt), Platz der griechischen Stadt mit vielfältigen Aufgaben. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Agora</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">agora</skos:prefLabel>
    </owl:NamedIndividual>
    


