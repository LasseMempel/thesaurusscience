<http://www.eionet.europa.eu/gemet/concept/8448> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8229> ;
    skos:definition "Water, generally of a spring or geyser, whose temperature is appreciably above the local mean annual air temperature."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Thermalwasser"@de,
        "thermal water"@en ;
