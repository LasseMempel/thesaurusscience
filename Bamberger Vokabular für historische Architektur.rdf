        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T23:16:28.000</terms:modified>
        <skos:definition xml:lang="de">Vom Bohlenblockbau spricht man, wenn die Wandstärken deutlich geringer als im Kantholzblockbau ausgebildet und die Ecken verzinkt sind. Es handelt sich meist um einräumige Bauten von maximal 4-5 m Seitenlänge.  (Eißing et al. 2012) </skos:definition>
        <skos:prefLabel xml:lang="de">Bohlenblockbau</skos:prefLabel>
        <broaderByConstruction rdf:resource="https://hist-arch-vocab.org/bvha#c_93fd7d9a"/>
    </owl:NamedIndividual>
    


