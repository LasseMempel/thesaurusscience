	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk000758">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">concentration camp</skos:prefLabel>
		<skos:altLabel xml:lang="de">KL</skos:altLabel>
		<skos:prefLabel xml:lang="de">Konzentrationslager</skos:prefLabel>
		<skos:altLabel xml:lang="de">KZ</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003611"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk003737"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk014358"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk017602"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019684"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk003611"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk000822"/>
		<skos:scopeNote xml:lang="de">Benutzt für das unter der NS-Herrschaft von 1933-1945 eingerichtete und betriebene Lager; für andere Lager siehe Lager (Unterkunft) oder Gefangenenlager.</skos:scopeNote>
		<xe:explanation_temp xml:lang="de">Die Opfer der Konzentrationslager wurden aufgrund ihrer Rasse, ihres Glaubens, ihrer Weltanschauung, sexuellen Orientierung, körperlichen oder geistigen Behinderungen oder ihrer politischen Gegnerschaft zum Nationalsozialismus verfolgt und inhaftiert. In den Lagern starben die meisten dieser Menschen an den Folgen physischer Misshandlungen, systematischer Aushungerung, Zwangsarbeit, medizinischer Menschenversuche oder wurden - vor allem im Rahmen der deutschen Judenvernichtung (Shoah bzw. Holocaust) - durch Massentötungen in Gaskammern, Erschießungen oder Todesmärsche ermordet.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Konzentrationslager ist ein Gefangenenlager, welches in der Zeit des Nationalsozialismus für die Internierung und zumeist auch Ermordung von Opfern der nationalsozialistischen Unrechtsherrschaft errichtet wurde.</skos:definition>
		<crm:P82a_begin_of_the_begin rdf:datatype="http://www.w3.org/TR/xmlschema11-2/#gYear">1933</crm:P82a_begin_of_the_begin>
		<crm:P82b_end_of_the_end rdf:datatype="http://www.w3.org/TR/xmlschema11-2/#gYear">1945</crm:P82b_end_of_the_end>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003611"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003737"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk014358"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk017602"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019684"/>
