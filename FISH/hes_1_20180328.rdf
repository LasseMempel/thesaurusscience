	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/273">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/273</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CRANN- CRAOLAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar, togalach no taigh sa bheil acainnean airson craoladh rèidio no siognailean telebhisein.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BROADCASTING TRANSMITTER</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">TELEVISION MAST</skos:altLabel>
		<skos:altLabel xml:lang="en">TELEVISION STATION</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/272" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502185" />
		<skos:scopeNote xml:lang="en">A structure, building or site housing equipment for transmitting radio or television signals.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/274">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/274</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BOGSA-FÒN POILIS</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Bogsa meatailt, fiodha no concrait san robh fòn a b' urrainn dhan phoball a chleachdadh, àite-fuireach beag a chaidh a chleachdadh mar chealla sealach agus lampa airson aire a' phoileis a ghlacadh 's iad a' dol seachad.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">POLICE CALL BOX</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/609" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/272" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/166" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/275" />
		<skos:scopeNote xml:lang="en">A metal, wooden or concrete box containing a telephone for use by the public, limited accommodation for use as a temporary cell, and a lamp on top that could be used to attract the attention of a passing patrol.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
