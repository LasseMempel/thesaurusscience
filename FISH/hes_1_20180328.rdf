	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1309">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1309</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH-RÒPA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach fada caol le mullach air, uaireannan le dà ùrlar, ann an dèanar ròpa. Gu math tric co-cheangailte ri taighean-bathair, taigh-einnsein no oifisean. Dh'fhaoidte gum bi seo na phàirt de dh'aitreabh mhuilinn-chlòtha no doca.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ROPEWALK</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1307" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1310" />
		<skos:scopeNote xml:lang="en">A long, narrow, roofed building, sometimes two-storied, used for the manufacture of rope. Often attached to warehousing, an engine house or offices. Can be included within the complex of a textile mill or dockyard.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1310">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1310</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">STÒR-TEARRA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Taigh-stòrais a tha co-cheangailte ri saothrachadh ròpa (m.e. ann an docannan a' chabhlaich).</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TAR HOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1307" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1309" />
		<skos:scopeNote xml:lang="en">A storehouse associated with rope manufacture (eg. in naval dockyards).</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
