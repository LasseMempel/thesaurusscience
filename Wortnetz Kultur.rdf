		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk002318"/>
		<xe:explanation_temp xml:lang="de">Die Dossierung wird angewandt, um waagerecht wirkende Kräfte wie Erddruck oder Wasserdruck auffangen zu können.</xe:explanation_temp>
		<skos:definition xml:lang="de">Eine Dossierung ist eine Baukonstruktion, bei der eine Mauer nicht senkrecht, sondern geneigt ausgeführt wird.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003620"/>
