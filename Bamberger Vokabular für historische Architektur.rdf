        <skos:prefLabel xml:lang="it">cappella domestica</skos:prefLabel>
        <broaderByPosition rdf:resource="https://hist-arch-vocab.org/bvha#c_b5206255"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_6d826258 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_6d826258">
