        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-08T15:12:17.000</terms:modified>
        <skos:definition xml:lang="de">Räuml. Tragwerk aus Stahlbeton, Spannbeton oder Stahlblech, das aus starren, ebenen Einzelplatten zusammengesetzt ist, bes. für weit gespannte Hallendächer verwendet. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Faltwerk (Tragwerk)</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_4e6deb7d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_4e6deb7d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_8fc667ec"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-05T09:54:22.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T22:55:23.000</terms:modified>
        <skos:definition xml:lang="de">Eine hauptsächl. in Oberösterreich vorkommende Form eines Bauernhauses, bei der Wohn- und Wirtschaftsgebäude einen allseitig geschlossenen Hof umgeben. Der V. ist meist aus Backstein- oder Schichtmauerwerk, einzelne Teile der Wirtschaftsgebäude auch als Holzkonstruktion mit Verschalung errichtet. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Vierkanthof</skos:prefLabel>
    </owl:NamedIndividual>
    


