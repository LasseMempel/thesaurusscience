    <skos:scopeNote xml:lang="en">A housing for racing pigeons usually situated in allotments of back yards.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91986">
    <skos:scopeNote xml:lang="en">A structure found on lighthouses, piers, etc, capable of emitting a loud noise to warn shipping in foggy weather.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143443">
    <skos:scopeNote xml:lang="en">Site used for the maintenance of aircraft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91145">
    <skos:scopeNote xml:lang="en">A CRUCK HOUSE where the cruck blades are truncated and joined by a collar beam, above which is a separate roof construction.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/83979">
