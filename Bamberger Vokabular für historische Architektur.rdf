        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_bf8a2b1f"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_d34f0825"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-25T10:44:57.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T01:04:50.000</terms:modified>
        <skos:definition xml:lang="de">Arena (lat. Sand), der mit Sand bestreute Kampfplatz im Zentrum des röm. Amphitheaters, Zirkus und Stadions. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Arena</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">aréna</skos:prefLabel>
    </owl:NamedIndividual>
    


