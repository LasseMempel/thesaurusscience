        <skos:prefLabel xml:lang="en">English Civil War</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The period of the mid 17th Century which saw a series of civil wars between Royalists and Parliamentarians (1642 CE to 1651 CE).</skos:scopeNote>
        <skos:notation xml:lang="en">ECW</skos:notation>
      </skos:Concept>
    </skos:narrower>

    <skos:narrower>
