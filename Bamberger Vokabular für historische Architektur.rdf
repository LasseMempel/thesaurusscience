        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-28T11:05:34.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-28T10:53:04.000</terms:modified>
        <skos:altLabel xml:lang="de">Hab</skos:altLabel>
        <skos:altLabel xml:lang="la">Hab</skos:altLabel>
        <skos:definition xml:lang="de">Habacuc, Hab., der Prophet Habakuk. [Glossarium Artis]</skos:definition>
