	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk010663">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">architectural fragment</skos:prefLabel>
		<skos:altLabel xml:lang="en">architectural fragments</skos:altLabel>
		<skos:prefLabel xml:lang="de">Architekturfragment</skos:prefLabel>
		<skos:altLabel xml:lang="de">Architekturfragmente</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk005941"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk012074"/>
