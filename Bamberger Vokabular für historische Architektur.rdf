        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-27T13:09:17.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T11:32:53.000</terms:modified>
        <skos:definition xml:lang="de">Hochschloss, Anlage, bei der die Wohnlichkeit und der Anspruch auf Repräsentation schon dem Schlossbau entspricht, bei der aber die strategisch günstige Lage auf dem Berg, häufig oberhalb einer Stadt, beibehalten wurde. Fast immer entstehen H.er durch Umbauten mittelalterlicher Burgen (Weilburg a. d. Lahn RP, Heidelberg BW, Würzburg BY). B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:prefLabel xml:lang="de">Hochschloss</skos:prefLabel>
    </owl:NamedIndividual>
    


