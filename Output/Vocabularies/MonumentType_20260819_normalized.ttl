    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "CRYPT"@en ;
    skos:scopeNote "A vault, often located under a chancel or chancel aisle, containing an altar and usually used for burial."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70082> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70081> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "CROSS SLAB"@en ;
    skos:scopeNote "A slab of stone, either standing or recumbent, inscribed with a cross. Usually found in association with burials."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70084> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70080> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "PILLOW STONE"@en ;
    skos:scopeNote "A small Anglo-Saxon cross-slab buried on the breast or beneath the head of a corpse. The term can also apply to a stone placed beneath the head of some prehistoric burials."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70085> a skos:Concept ;
    skos:altLabel "Hogback"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/103572> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "HOGBACK STONE"@en ;
    skos:scopeNote "A North country memorial imitating a wattled hut decorated with formalized bears or snakes."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70086> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69999>,
