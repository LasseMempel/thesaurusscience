    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "TREE TRUNK COFFIN"@en ;
    skos:scopeNote "A prehistoric coffin made out of a hollow tree trunk."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70077> a skos:Concept ;
