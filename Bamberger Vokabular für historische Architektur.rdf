        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-10T18:30:17.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T23:54:16.000</terms:modified>
        <skos:definition xml:lang="de">Fronaltar (Altar des Herrn) vor oder in der Apsis. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Oltář Páně, před apsidou, nebo v apsidě. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Hochaltar</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">hlavní oltář</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Direkt an der Ostwand bzw. am östlichen Abschluss stehender Altar, vor dem 2. Vatikanischen Konzil häufig Hauptaltar. </skos:scopeNote>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_wyccl4ls"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_edb7d77d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_edb7d77d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_c5c22822"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_dihjrxws"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_1ddd1454"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-05T15:09:21.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T17:20:36.000</terms:modified>
        <skos:altLabel xml:lang="de">Firmung</skos:altLabel>
        <skos:altLabel xml:lang="de">Konfirmation</skos:altLabel>
        <skos:altLabel xml:lang="de">Myronsalbung</skos:altLabel>
        <skos:altLabel xml:lang="en">sacrament of Confirmation</skos:altLabel>
        <skos:altLabel xml:lang="la">sacramentum confirmationis</skos:altLabel>
        <skos:altLabel xml:lang="fr">sacrement de confirmation</skos:altLabel>
        <skos:definition xml:lang="de">Firmung f; Firmungssakrament n; Konfirmation f; ostk. Myronsalbung f; gr. hagion myron; lat. confirmatio &quot;Befestigung&quot;; sacramentum confirmationis; russ. miropomazanie: das Sakrament, durch das der Getaufte vom Hl. Geist im Glauben bestärkt und gefestigt werden soll. Dies geschieht durch Handauflegung und Salbung durch den Bischof oder einen von ihm Beauftragten. Das Sakrament der Firmung bestätigt die Taufe und eröffnet die Zulassung zum Abendmahl und zum Patenamt. Während die Firmung  in den westlichen Kirchen in der Regel getrennt vom Taufakt und zeitlich meist wesentlich später vollzogen wird, erfolgt in den Ostkirchen die Myronsalbung unmittelbar nach der Taufe. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="en">Confirmation</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Firmungssakrament</skos:prefLabel>
        <skos:prefLabel xml:lang="la">confirmatio</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">confirmation</skos:prefLabel>
        <skos:prefLabel xml:lang="el">hagion myron</skos:prefLabel>
        <skos:prefLabel xml:lang="ru">miropomazanie</skos:prefLabel>
    </owl:NamedIndividual>
    


