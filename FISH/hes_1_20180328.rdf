		<skos:prefLabel xml:lang="gd">CNOC-DHÙN</skos:prefLabel>
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/322">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/322</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÀRACH LE DÌG</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach mun a bheil staing, mar is trice air plana ceart-cheàrnach agus daoine dhen bheachd gur ann às na meadhan-aoisean a tha e.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MOATED SITE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-26T16:08:04</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">HOMESTEAD MOAT</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/320" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/490" />
		<skos:scopeNote xml:lang="en">A site enclosed within a moat, normally rectangular on plan, and believed to be medieval in date.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
