    <!-- https://hist-arch-vocab.org/bvha#c_823ee3cf -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_823ee3cf">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
