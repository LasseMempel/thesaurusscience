		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk020441"/>
		<skos:definition xml:lang="de">Eine Kopie ist ein Objekt, das durch die Vervielfältigung oder Nachbildung eines Originalobjekts entsteht und diesem mehr oder weniger präzise in Aussehen und Form entspricht.</skos:definition>
		<skos:mappingRelation rdf:resource="http://d-nb.info/gnd/4032423-0"/>
		<skos:mappingRelation rdf:resource="http://vocab.getty.edu/aat/300015640"/>
