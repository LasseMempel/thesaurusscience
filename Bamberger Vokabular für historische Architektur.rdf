    <!-- https://hist-arch-vocab.org/bvha#c_bcd8cb72 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_bcd8cb72">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_d3971ceb"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_19d56a39"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-22T12:29:05.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-20T13:32:41.000</terms:modified>
        <skos:definition xml:lang="cs">FASCIE (lat. fascia = pás), mírně vystupující vodorovný páskovitý architektonický článek na iónském a korintském architrávu. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Faszie (lat. fascia: Band, Mz. Faszien, Fasciae), leicht vorspringendes waagerechtes, bandartiges Bauglied am ionischen und korinthischen Architrav. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Faszien (lat. fasciae: Binden) heißen die drei, seltener zwei übereinanderliegenden, von unten nach oben leicht vorspringenden Streifen, die den Architrav der Ionischen und der Korinthischen Ordnung waagerecht unterteilen, auch auf Bogenstirn. [Koepf / Binding]</skos:definition>
        <skos:prefLabel xml:lang="de">Faszie</skos:prefLabel>
        <skos:prefLabel xml:lang="es">banda de arquitrabe</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">fasce</skos:prefLabel>
        <skos:prefLabel xml:lang="en">fascia</skos:prefLabel>
        <skos:prefLabel xml:lang="it">fascia</skos:prefLabel>
        <skos:prefLabel xml:lang="la">fascia</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">fascie</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_bce1d06e -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_bce1d06e">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b4ffaac7"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_8067ebd9"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_812a3cb2"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_9f39033a"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_abbb35ea"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T18:05:24.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T12:14:06.000</terms:modified>
        <skos:definition xml:lang="de">Der Abschluss des Chors. Er kann halbrund, gerade (&gt;platt&lt;) oder polygonal, d.h. aus mehreren Seiten eines Vielecks gebildet (Chorpolygon, Polygonchor) und von einem Chorumgang bzw. Chorkapellen (Kapellenkranz, Apsidialkapellen) umgeben sein. Besteht der C. z.B. aus fünf Seiten eines Achtecks, so spricht man von einem Fünfachtelschluss. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Chorschluss</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">závěr chóru</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_bcea69ad -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_bcea69ad">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_3da3c0b4"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-05T18:11:40.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-12T17:05:09.000</terms:modified>
        <skos:definition xml:lang="de">Grabhügel auf kreisrundem Grundriss. Die Grundform des T. kommt hauptsächl. bei myken. Gräbern, Grabhügeln in der Gegend von Pergamon, bei etrusk. und röm. Gräbern vor. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Grabhügel mit kreisförmigem Grundriss, besonders in der mykenischen, pergamenischen, etruskischen, römischen Kultur. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Mohyla s kruhovým půdorysem, zvl. v mykénské, pergamské, etruské a římské kultuře, Augustovo mauzoleum. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Tumulus</skos:prefLabel>
        <skos:prefLabel xml:lang="it">tumulo</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">tumulus</skos:prefLabel>
        <skos:prefLabel xml:lang="en">tumulus</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">tumulus</skos:prefLabel>
        <skos:prefLabel xml:lang="es">túmulo</skos:prefLabel>
    </owl:NamedIndividual>
    


