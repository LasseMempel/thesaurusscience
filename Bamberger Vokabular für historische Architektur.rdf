        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T20:26:09.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T17:38:05.000</terms:modified>
        <skos:altLabel xml:lang="fr">arc en chaînette</skos:altLabel>
        <skos:altLabel xml:lang="fr">arc en parabole</skos:altLabel>
        <skos:altLabel xml:lang="en">catenary arch</skos:altLabel>
        <skos:definition xml:lang="de">Bogen in Parabelform (Bogenformen). Der dem stat. Kräfteverlauf genau entsprechende P. wird v. a. in neuerer Zeit häufig verwendet. [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Bogen, dessen Bogenlinie die Form einer umgekehrt hängenden Kette zeigt; man spricht deshalb manchmal auch von einem umgekehrten Kettenbogen. Die Bogenschenkel bilden an den Kämpferpunkten immer einen stumpfen Winkel mit den senkrechten Stützen. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="es"> arco parabólico</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Parabelbogen</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">arc parabolique</skos:prefLabel>
        <skos:prefLabel xml:lang="it">arco parabolico</skos:prefLabel>
        <skos:prefLabel xml:lang="en">parabolic arch</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">parabolický oblouk</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_2026364f"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_7b5bd7a7 -->


