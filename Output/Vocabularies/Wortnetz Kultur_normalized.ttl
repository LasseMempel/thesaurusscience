    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Schlossmühle"@de,
        "castle mill"@en .

<http://lvr.vocnet.org/wnk/wk002586> a skos:Concept ;
    skos:broader <http://lvr.vocnet.org/wnk/wk005838> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Expressionismus"@de,
