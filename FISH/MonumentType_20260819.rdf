    <skos:prefLabel xml:lang="en">HENGIFORM MONUMENT</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A small, circular Late Neolithic/Early Bronze Age enclosure which bears a morphological resemblance to henges, but may belong to another category of circular earthwork-defined monuments, or is enclosed by something other than a bank and ditch.</skos:scopeNote>
    <dc1:identifier rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70098"/>
