        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-25T15:12:32.000</terms:modified>
        <skos:altLabel xml:lang="de">Tracht der Barfüßer</skos:altLabel>
        <skos:altLabel xml:lang="de">Tracht der Grauen Brüder</skos:altLabel>
        <skos:altLabel xml:lang="de">Tracht der Graumönche</skos:altLabel>
        <skos:definition xml:lang="de">Franziskaner m pl, auch Barfüßer m pl, veraltet Graumönche m pl, Graue Brüder m pl : im Mittelalter graue, später braune Kutte mit weißem Knotenstrick die Franziskaner tragen nur Sandalen. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Tracht der Franziskaner</skos:prefLabel>
        <skos:prefLabel xml:lang="en">discalced friars\&apos; habit</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">františkánský hábit</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">vêtements des franciscains</skos:prefLabel>
    </owl:NamedIndividual>
    


