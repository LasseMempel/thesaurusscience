		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk018333"/>
		<skos:definition xml:lang="de">Ein Sexspielzeug ist ein Gerät, das zur sexuellen Stimulation allein oder mit Partner verwendet wird</skos:definition>
