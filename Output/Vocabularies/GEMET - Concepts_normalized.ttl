        <http://eurovoc.europa.eu/3732> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Reis"@de,
        "rice"@en .

<http://www.eionet.europa.eu/gemet/concept/7217> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:closeMatch <http://data.uba.de/umt/_00002364> ;
    skos:definition "A legal guarantee or just claim enabling a citizen or employee to compose and submit a formal written request to an authority asking for some benefit or favor or for intervention and redress of some wrong."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Antragsrecht"@de,
        "petition right"@en .

<http://www.eionet.europa.eu/gemet/concept/7218> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:closeMatch <http://data.uba.de/umt/_00007405> ;
    skos:definition "The legal guarantee or just claim inhering in a citizen's relation to some physical thing, but especially a plot of land, including the right to possess, use and dispose of it."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/3929> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Eigentumsordnung"@de,
        "right of property"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Ownership> .

<http://www.eionet.europa.eu/gemet/concept/7221> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:closeMatch <http://data.uba.de/umt/_00008307> ;
    skos:definition "A legally enforceable claim for payment or reimbursement to pay for damages, loss or injury, or for remuneration to pay for services rendered, whether in fees, commissions or salary."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/1339> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Entschädigungsrecht"@de,
        "right to compensation"@en .

<http://www.eionet.europa.eu/gemet/concept/7222> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13147> ;
    skos:closeMatch <http://data.uba.de/umt/_00003347> ;
    skos:definition "The individual's right to know in general about the existence of data banks, the right to be informed on request and the general right to a print-out of the information registered and to know the actual use made of the information."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/513> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Auskunftsanspruch"@de,
        "right to information"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Freedom_of_information_legislation> .

<http://www.eionet.europa.eu/gemet/concept/7227> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7340> ;
    skos:definition "The removal of thin layers of surface material more or less evenly from an extensive area of gently sloping land, by broad continuous sheets of running water rather than by streams flowing in well-defined channels; e.g. erosion that occurs when rain washes away a thin layer of topsoil."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Spülen"@de,
        "rinsing"@en .

<http://www.eionet.europa.eu/gemet/concept/7230> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9297> ;
    skos:closeMatch <http://data.uba.de/umt/_00030428>,
        <http://dbpedia.org/resource/Riparian_zone> ;
    skos:definition """1) Terrestrial areas where the vegetation complex and microclimate are products of the combined pressure and influence of perennial and/or intermittent water... and soils that exhibit some wetness characteristics.
2) Zone situated on the bank of a water course such as a river or stream."""@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_35294> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Gewässerrandstreifen"@de,
        "riparian zone"@en .

<http://www.eionet.europa.eu/gemet/concept/7232> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7513> ;
    skos:closeMatch <http://data.uba.de/umt/_00016791> ;
    skos:definition "Sea level rises are a possible consequence of global warming. As the amount of free water in the ocean increases, and as the water becomes warmer, global warming will increase. In addition, according to theory, the heating at the poles may reduce the amount of water trapped in glaciers and ice caps. By the year 3000, the seas could rise between one and two metres. Such an event would clearly threaten low-lying areas, particularly in Asia, where million of people live and farm on river deltas and flood plains."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Meeresspiegelanstieg"@de,
        "rising sea level"@en .

<http://www.eionet.europa.eu/gemet/concept/7237> a skos:Concept ;
    skos:broadMatch <http://eurovoc.europa.eu/1800> ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2478> ;
    skos:closeMatch <http://data.uba.de/umt/_00020939>,
        <http://dbpedia.org/resource/Risk-benefit_analysis> ;
    skos:definition "A systematic process of evaluating and assessing the hazards of loss versus the possibility of financial gain or profit."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Risiko-Nutzen-Analyse"@de,
        "risk-benefit analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/7238> a skos:Concept ;
