        <skos:altLabel xml:lang="cs">stoa</skos:altLabel>
        <skos:definition xml:lang="de">Ein hallenartiger Wandelgang vor öffentl. Gebäuden oder Kirchen und als Rahmung von Plätzen (Säulengang). Auch Vorhalle von Kirchen- und Profanbauten. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Säulenhalle</skos:prefLabel>
        <skos:prefLabel xml:lang="en">hypostyle hall</skos:prefLabel>
        <skos:prefLabel xml:lang="it">loggia colonnato</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">portique</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">sloupová síň</skos:prefLabel>
    </owl:NamedIndividual>
    


