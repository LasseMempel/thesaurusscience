        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-26T18:40:18.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T16:22:21.000</terms:modified>
        <skos:altLabel xml:lang="de">Festkalender</skos:altLabel>
        <skos:altLabel xml:lang="de">christlicher Kalender</skos:altLabel>
        <skos:definition xml:lang="de">Kalendarium n, auch christlicher Kalender m, Festkalender m, celendarium: mit Monatsbildern und anderen Darstellungen ausgestattetes, nach Monaten, Wochen und Tagen eines Jahres geordnetes Verzeichnis mit Angabe der kirchlichen Feste; es war im Mittelalter oft einem Brevier, Psalter, Stundenbuch usw. vorangestellt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Kalendarium</skos:prefLabel>
        <skos:prefLabel xml:lang="la">calendarium</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">calendrier (chrétien)</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kalendárium</skos:prefLabel>
    </owl:NamedIndividual>
    


