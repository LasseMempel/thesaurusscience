		<skos:prefLabel xml:lang="gd">TAIGH-DIBHE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite aig a bheil cead deoch-làidir a reic agus airson am poball a bhith an làthair ga h-òl.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PUBLIC HOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
