	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1105">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1105</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÀRACH CLADHACH CRÈADHA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalaichean, làraichean is structaran a tha co-cheangailte ri buain criadha.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CLAY EXTRACTION SITE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
