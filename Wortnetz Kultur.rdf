		<skos:altLabel xml:lang="en">chalices (liturgical vessels)</skos:altLabel>
		<skos:prefLabel xml:lang="de">Kelch (Gefäß)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Kelche (liturgische Gefäße)</skos:altLabel>
		<skos:prefLabel xml:lang="de-1901">Meßkelch</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk010221"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk020430"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk012069"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013708"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk010221"/>
