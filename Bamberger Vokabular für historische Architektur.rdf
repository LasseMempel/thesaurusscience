        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-11-21T10:28:19.000</terms:modified>
        <skos:definition xml:lang="de">Vordächer verfügen über eigenständige Konstruktionen, die an das Hauptdach anbinden. Die Dachhaut wird in diesem Fall von Vordachrofen/-sparren getragen. [Eißing et al. 2012]</skos:definition>
        <skos:prefLabel xml:lang="de">Vordachsparren</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Bei Dachüberständen auf der Traufseite. An der Giebelseite wurde man von einem Freisparren sprechen. [BVHA]</skos:scopeNote>
    </owl:NamedIndividual>
    


