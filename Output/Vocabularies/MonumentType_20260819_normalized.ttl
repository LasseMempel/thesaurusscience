    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "CHEST TOMB"@en ;
    skos:scopeNote "A tomb designed in the form of a cist or stone box placed over a burial. Its outward form often reproduces the features of the classical sarcophagus or medieval effigy base."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70094> a skos:Concept ;
    skos:altLabel "Bale Tomb"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70092> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "TABLE TOMB"@en ;
    skos:scopeNote "A type of tomb in the form of a slab raised on freestanding legs."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70095> a skos:Concept ;
