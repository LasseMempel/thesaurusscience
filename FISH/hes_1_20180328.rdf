		<skos:prefLabel xml:lang="gd">LOIDSE-IASGAICH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach a tha ga chleachdadh le buidhnean iasgaich, mar is trice air oighreachd.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">FISHING LODGE</skos:prefLabel>
