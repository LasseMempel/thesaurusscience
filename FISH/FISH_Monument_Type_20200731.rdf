    <skos:scopeNote xml:lang="en">A nunnery of nuns belonging to the Order of the Servants of the Blessed Virgin Mary or Servites.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93938">
    <skos:scopeNote xml:lang="en">A place where furs are made into finished products.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/103993">
    <skos:scopeNote xml:lang="en">A complex of buildings used for the processing of metals. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69101">
    <skos:scopeNote xml:lang="en">Surface workings including shallow shafts, lode workings, open-pit methods and quarrying including some mines of stone, clays, compounds, etc. See also MINERAL EXTRACTION SITE.</skos:scopeNote>
  </rdf:Description>
