    <!-- https://hist-arch-vocab.org/bvha#c_e58d562a -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_e58d562a">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b54dd069"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_b06c1468"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_1df20620"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_d7b6162a"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_f9171b53"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-04-09T17:32:49.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T15:33:57.000</terms:modified>
        <skos:altLabel xml:lang="de">Laubengang</skos:altLabel>
        <skos:altLabel xml:lang="en">arcade</skos:altLabel>
        <skos:altLabel xml:lang="fr">arcades</skos:altLabel>
        <skos:altLabel xml:lang="en">arched gallery</skos:altLabel>
        <skos:altLabel xml:lang="es">corredor exterior</skos:altLabel>
        <skos:altLabel xml:lang="es">galería</skos:altLabel>
        <skos:altLabel xml:lang="it">loggiato</skos:altLabel>
        <skos:altLabel xml:lang="en">porch</skos:altLabel>
        <skos:altLabel xml:lang="es">porche</skos:altLabel>
        <skos:altLabel xml:lang="en">portico</skos:altLabel>
        <skos:definition xml:lang="de">Ein langer, an der Gebäudefront unter einem vorkragenden Obergeschoss verlaufender, durch Arkaden geöffneter, oft gewölbter Gang. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Offener, oft gewölbter Bogengang (Arkade) als Teil des Erdgeschosses besonders von Wohn- und Rathäusern, auch dem Erdgeschoss vorgelagert. Die Pergola (ital.) ist eine Laube aus Pfeilern oder Säulen, die eine offene Holzdecke mit Rankengewächsen tragen. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Otevřená, často zaklenutá arkáda jako součást přízemí, zvl. u obytných domů a radnic, někdy též předsazená. Pergola (ital.) je podloubí z pilířů nebo sloupů nesoucích otevřený dřevěný strop s popínavými rostlinami. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Laube (Erschließung)</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">galerie d\&apos;arcades</skos:prefLabel>
        <skos:prefLabel xml:lang="en">gallery of arcades</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">podloubí</skos:prefLabel>
    </owl:NamedIndividual>
    


