    <!-- https://hist-arch-vocab.org/bvha#c_72f117c3 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_72f117c3">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_dbac5de7"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
