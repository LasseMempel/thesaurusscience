    skos:definition "Ein Gusseisen ist eine Eisenlegierung, die neben Eisen aus Kohlenstoff besteht durch Umschmelzen von Roheisen in einem Kuppelofen entsteht."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Gusseisen"@de,
