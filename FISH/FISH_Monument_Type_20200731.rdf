    <skos:scopeNote xml:lang="en">A room designed or suitable for dancing.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164385">
    <skos:scopeNote xml:lang="en">A factory used to make packaging equipment.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70419">
