		<skos:prefLabel xml:lang="de">Tierische Behausung</skos:prefLabel>
		<skos:altLabel xml:lang="de">Tierischer Behausungen</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk002208"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk009614"/>
		<skos:definition xml:lang="de">Eine tierische Behausung ist ein Bauwerk, das von Tieren errichtet oder genutzt wird und als Rückzugsort, Brutstätte oder Schlafplatz dient. Solche Behausungen können aktiv durch das Tier geschaffen werden, wie ein Nest, ein Bau oder ein Gespinst, oder es handelt sich um naturgegebene Strukturen wie beispielsweise Höhlen oder Kuhlen.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300380002"/>
