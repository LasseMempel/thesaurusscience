		<skos:altLabel xml:lang="en">hat form</skos:altLabel>
		<skos:altLabel xml:lang="de">Hutblock</skos:altLabel>
		<skos:altLabel xml:lang="de">Hutblöcke</skos:altLabel>
		<skos:prefLabel xml:lang="de">Hutform</skos:prefLabel>
		<skos:altLabel xml:lang="de">Hutformen</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006128"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk006128"/>
		<skos:definition xml:lang="de">Eine Hutform ist ein Gerät, das zur Herstellung von Hüten verwendet wird und die spezifische Gestaltung und Größe des Hutes vorgibt. Sie besteht meist aus Holz oder Metall und dient als dreidimensionale Grundlage, auf der der Hut direkt geformt wird.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300390898"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q5680833"/>
