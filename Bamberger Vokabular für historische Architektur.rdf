        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_559aa52a"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-18T08:16:35.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-18T08:17:08.000</terms:modified>
        <skos:definition xml:lang="de">Gussglas mit ein oder beidseitiger Oberflächenprägung (durchscheinend bis Durchsicht sperrend). Ornamentglas ist oft farbig. Wegen seiner verzierten Oberfläche wirkt es sehr dekorativ. Besondere Ornamentgläser sind zum Beispiel Kathedralglas, Drahtornamentglas oder Antikglas. [Pax - Fenster &amp; Türen Fachbegriffe]</skos:definition>
        <skos:prefLabel xml:lang="de">Ornamentglas</skos:prefLabel>
    </owl:NamedIndividual>
    


