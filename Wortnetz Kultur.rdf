		<skos:prefLabel xml:lang="en">hunting garden</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Jagdpark</skos:prefLabel>
		<skos:altLabel xml:lang="de">Jagdparks</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000421"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk003815"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk004412"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010541"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk016511"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019757"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019924"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000421"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk001770"/>
		<xe:explanation_temp xml:lang="de">Ein Jagdpark besitzt Schneisen, die zur Parforce-Jagd genutzt werden. Diese Schneisen treffen sich in einem oder mehreren Jagdsternen. Ein Jagdpark kann abgegrenzt sein (Benrath) oder in einem offenen Waldgebiet liegen (Kottenforst). Das hat aber keinen Einfluss auf die jeweils übliche Benennung als Jagdpark oder Jagdgarten.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Jagdpark ist ein Park, der dem Adel zur Ausübung der Jagd dient.</skos:definition>
		<skos:relatedMatch rdf:resource="http://d-nb.info/gnd/4027955-8"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000421"/>
