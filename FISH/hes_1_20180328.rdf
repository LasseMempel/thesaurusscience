		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/506201" />
		<skos:scopeNote xml:lang="en">Purpose built workers' accommodation comprising single rooms with communal eating and washing facilities. Usually for short stay accommodation only.</skos:scopeNote>
