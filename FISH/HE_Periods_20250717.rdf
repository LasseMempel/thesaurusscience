  <skos:ConceptScheme rdf:about="http://purl.org/heritagedata/schemes/eh_period">
    <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-07-17</dc:issued>
    <cc:license rdf:resource="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"/>
    <cc:attributionURL rdf:resource="https://historicengland.org.uk/"/>
    <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
    <dc:publisher rdf:resource="https://historicengland.org.uk/"/>
    <dc:identifier>http://purl.org/heritagedata/schemes/eh_period</dc:identifier>
    <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
    <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
    <dc:title xml:lang="en">Historic England Periods</dc:title>
    <dc:description xml:lang="en">Periods and centuries used in Historic England datasets.</dc:description>
    <skos:hasTopConcept rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/period"/>
    <skos:hasTopConcept rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/century"/>
    <skos:hasTopConcept rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/geology"/>
  </skos:ConceptScheme>

  <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_period/concepts/AS">
    <skos:altLabel xml:lang="en">Anglo Saxon</skos:altLabel>
    <skos:broader rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/EM"/>
    <skos:narrower>
      <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_period/concepts/EAS">
        <skos:altLabel xml:lang="en">Migration period</skos:altLabel>
        <skos:broader rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/AS"/>
        <time:hasBeginning xml:lang="en">0410</time:hasBeginning>
        <time:hasEnd xml:lang="en">0660</time:hasEnd>
        <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_period"/>
        <dc:identifier>http://purl.org/heritagedata/schemes/eh_period/concepts/EAS</dc:identifier>
        <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-17T16:46:30</dc:issued>
        <cc:license rdf:resource="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"/>
        <cc:attributionURL rdf:resource="https://historicengland.org.uk/"/>
        <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
        <dc:publisher rdf:resource="https://historicengland.org.uk/"/>
        <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
        <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
        <skos:prefLabel xml:lang="en">Early Anglo-Saxon</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The first part of the period which saw the arrival of Anglo-Saxon culture (circa 410 CE to 660 CE).</skos:scopeNote>
        <skos:notation xml:lang="en">EAS</skos:notation>
      </skos:Concept>
    </skos:narrower>

    <skos:narrower>
      <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_period/concepts/LAS">
        <skos:broader rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/AS"/>
        <time:hasBeginning xml:lang="en">0899</time:hasBeginning>
        <time:hasEnd xml:lang="en">1066</time:hasEnd>
        <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_period"/>
        <dc:identifier>http://purl.org/heritagedata/schemes/eh_period/concepts/LAS</dc:identifier>
        <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-17T16:46:30</dc:issued>
        <cc:license rdf:resource="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"/>
        <cc:attributionURL rdf:resource="https://historicengland.org.uk/"/>
        <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
        <dc:publisher rdf:resource="https://historicengland.org.uk/"/>
        <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
        <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
        <skos:prefLabel xml:lang="en">Late Anglo-Saxon</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The final part of the Anglo-Saxon period which began with the reign of Edward the ELder and ended with the Norman Conquest(circa 899 CE to 1066 CE).</skos:scopeNote>
        <skos:notation xml:lang="en">LAS</skos:notation>
      </skos:Concept>
    </skos:narrower>

    <skos:narrower>
      <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_period/concepts/MAS">
        <skos:altLabel xml:lang="en">Middle Anglo-Saxon</skos:altLabel>
        <skos:altLabel xml:lang="en">Middle Anglo Saxon</skos:altLabel>
        <skos:altLabel xml:lang="en">Mid Anglo Saxon</skos:altLabel>
        <skos:broader rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/AS"/>
        <time:hasBeginning xml:lang="en">0660</time:hasBeginning>
        <time:hasEnd xml:lang="en">0899</time:hasEnd>
        <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_period"/>
        <dc:identifier>http://purl.org/heritagedata/schemes/eh_period/concepts/MAS</dc:identifier>
        <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-17T16:46:30</dc:issued>
        <cc:license rdf:resource="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"/>
        <cc:attributionURL rdf:resource="https://historicengland.org.uk/"/>
        <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
        <dc:publisher rdf:resource="https://historicengland.org.uk/"/>
        <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
        <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
        <skos:prefLabel xml:lang="en">Mid Anglo-Saxon</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The middle part of the Anglo-Saxon period which saw the development of the Seven Kingdoms - the Heptarchy (circa 660 CE to 899 CE).</skos:scopeNote>
        <skos:notation xml:lang="en">MAS</skos:notation>
      </skos:Concept>
    </skos:narrower>

    <time:hasBeginning xml:lang="en">0410</time:hasBeginning>
    <time:hasEnd xml:lang="en">1066</time:hasEnd>
    <skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/ASA"/>
    <skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300021024"/>
    <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_period"/>
    <dc:identifier>http://purl.org/heritagedata/schemes/eh_period/concepts/AS</dc:identifier>
    <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-17T16:46:30</dc:issued>
    <cc:license rdf:resource="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"/>
    <cc:attributionURL rdf:resource="https://historicengland.org.uk/"/>
    <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
    <dc:publisher rdf:resource="https://historicengland.org.uk/"/>
    <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
    <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
    <skos:prefLabel xml:lang="en">Anglo-Saxon</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Both a political and cultural term: applied to the distinctive culture and artistic styles that evolved from the merging of native traditions with those of Germanic tribes who had migrated from northern Europe.</skos:scopeNote>
    <skos:notation xml:lang="en">AS</skos:notation>
  </skos:Concept>

  <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_period/concepts/EM">
    <skos:altLabel xml:lang="en">Pre-Conquest</skos:altLabel>
    <skos:altLabel xml:lang="en">Early Mediaeval</skos:altLabel>
    <skos:altLabel xml:lang="en">Dark Age</skos:altLabel>
    <skos:narrower>
      <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_period/concepts/VIK">
        <skos:broader rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/EM"/>
        <time:hasBeginning xml:lang="en">0800</time:hasBeginning>
        <time:hasEnd xml:lang="en">1050</time:hasEnd>
        <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_period"/>
        <dc:identifier>http://purl.org/heritagedata/schemes/eh_period/concepts/VIK</dc:identifier>
        <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-17T16:46:30</dc:issued>
        <cc:license rdf:resource="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"/>
        <cc:attributionURL rdf:resource="https://historicengland.org.uk/"/>
        <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
        <dc:publisher rdf:resource="https://historicengland.org.uk/"/>
        <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
        <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
        <skos:prefLabel xml:lang="en">Viking</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Defined as the period of initial settlement following on from a period of Viking (raiding) activities and initial contact.</skos:scopeNote>
        <skos:notation xml:lang="en">VIK</skos:notation>
      </skos:Concept>
    </skos:narrower>

    <skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/AS"/>
    <skos:broader rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/period"/>
    <time:hasBeginning xml:lang="en">0410</time:hasBeginning>
    <time:hasEnd xml:lang="en">1066</time:hasEnd>
    <skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/EM"/>
    <skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/11/concepts/505127"/>
    <skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300020760"/>
    <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_period"/>
    <dc:identifier>http://purl.org/heritagedata/schemes/eh_period/concepts/EM</dc:identifier>
    <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-17T16:46:30</dc:issued>
    <cc:license rdf:resource="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"/>
    <cc:attributionURL rdf:resource="https://historicengland.org.uk/"/>
    <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
    <dc:publisher rdf:resource="https://historicengland.org.uk/"/>
    <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
    <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
    <skos:prefLabel xml:lang="en">Early Medieval</skos:prefLabel>
    <skos:scopeNote xml:lang="en">This dates from the breakdown of Roman rule in Britain (c. 410) to the Norman invasion in 1066 and is to be used for monuments of post Roman, Saxon and Viking date.</skos:scopeNote>
    <skos:notation xml:lang="en">EM</skos:notation>
  </skos:Concept>

