	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/733">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/733</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FACTARAIDH CHOIDSEACHAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Gu tradaiseanta tha seo na thogalach far an robhar a' togail carbadan-stèidse. Thathar a' cleachdadh an fhacail seo an-diugh airson saothrachadh bodhaig is fùirneiseachd carbadan motair is carbadan rèile.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">COACH WORKS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">COACHWORKS</skos:altLabel>
		<skos:altLabel xml:lang="en">COACHBUILDING WORKS</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/730" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/750" />
		<skos:scopeNote xml:lang="en">Traditionally a building or site where stage coaches were built. Nowadays the term is applied to buildings used for the manufacturing of the body work and furnishings of motor vehicles and railway carriages.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
