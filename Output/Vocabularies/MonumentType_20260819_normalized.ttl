    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "CIST GRAVE CEMETERY"@en ;
    skos:scopeNote "A cemetery comprising inhumations or cremations interred in stone cists."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70063> a skos:Concept ;
