		<skos:prefLabel xml:lang="gd">GIL MÈINNEADH LUAIDHE</skos:prefLabel>
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500631">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500631</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">DÌONACHD CUIRP</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Frèam iarainn a chaidh a chur os cionn ciste-laighe no a chaidh a chur aig doras uaighe gus casg a chur air luchd-aiseirighe.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MORT SAFE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-30T10:03:29</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-30T10:03:49</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1667" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1716" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501658" />
		<skos:scopeNote xml:lang="en">An iron frame placed over a coffin or at the entrance to a grave to act as a deterrent against resurrectionists.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
