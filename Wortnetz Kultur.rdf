	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021247">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">drum grater</skos:prefLabel>
