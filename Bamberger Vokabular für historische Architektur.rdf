        <skos:prefLabel xml:lang="cs">boční strana</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_4ecacc8f -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_4ecacc8f">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_17d46f99"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_01901a66"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_b9d55f6c"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_fff0cce8"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-25T09:45:06.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T14:56:52.000</terms:modified>
        <skos:altLabel xml:lang="de">Räucherfass</skos:altLabel>
        <skos:altLabel xml:lang="de">Räucherkessel</skos:altLabel>
        <skos:altLabel xml:lang="de">Räucherschwenker</skos:altLabel>
        <skos:altLabel xml:lang="de">Schwenkräuchergefäß</skos:altLabel>
        <skos:altLabel xml:lang="de">Weihrauchbecken</skos:altLabel>
        <skos:altLabel xml:lang="de">Weihrauchfass</skos:altLabel>
        <skos:altLabel xml:lang="la">fumigatorium</skos:altLabel>
        <skos:altLabel xml:lang="la">suffitorium</skos:altLabel>
        <skos:altLabel xml:lang="en">thurible</skos:altLabel>
        <skos:altLabel xml:lang="de">thuriferarium</skos:altLabel>
        <skos:altLabel xml:lang="la">thymiaterium</skos:altLabel>
        <skos:altLabel xml:lang="la">turibulum</skos:altLabel>
        <skos:altLabel xml:lang="la">turiferarium</skos:altLabel>
        <skos:definition xml:lang="de">Rauchfass n; Weihrauchfass n; auch Räucherfass n; veraltet Weihrauchbecken m; lat. incensorium; fumigatorium; thuribulum; turiferarium; thymiaterium; suffitorium: ein an drei Tragketten hängendes, schwenkbares Becken aus Kupfer, Bronze, Messing oder Eisen, gelegentlich auch aus Edelmetall, mit einem niedrigen Standfuß und einem an einer Kette aufziehbaren, durchbrochen gearbeiteten Deckel. Es kommt in vielen unterschiedlichen Formen vor, häufig in architektonischer Gestaltung. Bei den liturgischen Inzensationen werden Weihrauchkörner verbrannt, wobei Weihrauch entsteht. Das Rauchfass wird entweder kreuzförmig (lat. in modum crucis) oder kreisförmig (lat. in modum circuli) geschwenkt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Rauchfass</skos:prefLabel>
        <skos:prefLabel xml:lang="en">censer</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">encensoir</skos:prefLabel>
        <skos:prefLabel xml:lang="es">incensario</skos:prefLabel>
        <skos:prefLabel xml:lang="la">incensorium</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kadidelnice</skos:prefLabel>
        <skos:prefLabel xml:lang="it">turibolo</skos:prefLabel>
        <skos:prefLabel xml:lang="nl">wierookvat</skos:prefLabel>
    </owl:NamedIndividual>
    


