        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_05127c72"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_7fb8587d"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_c8c9a68f"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_d7b2f8b8"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-24T14:09:54.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T16:16:21.000</terms:modified>
        <skos:definition xml:lang="de">1. in antiken Tempeln der abgesonderte Raum für das Götterbild (Adyton, Sekos). 2. In christl. Kirchen der Platz des Altars (Sanktuarium), in der orthodoxen Kirche der Raum hinter der Ikonostasis, in der Synagoge der Aufbewahrungsraum für die Thorarollen (Arche). [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Allerheiligstes</skos:prefLabel>
    </owl:NamedIndividual>
    


