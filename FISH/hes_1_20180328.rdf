		<skos:prefLabel xml:lang="gd">BAILE LOBHAR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalaichean a chaidh an cleachdadh le coimhearsnachd lobharan 's iad a' fuireach air falbh o na bailtean is clachain faisg orra.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">LEPER COLONY</skos:prefLabel>
