    <!-- https://hist-arch-vocab.org/bvha#c_ad31e23a -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_ad31e23a">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_237c1721"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_541f6da4"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_7c0b4654"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_7c4af9bc"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_bqjysq71"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-31T16:08:36.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T18:12:42.000</terms:modified>
        <skos:altLabel xml:lang="de">Bauform</skos:altLabel>
        <skos:altLabel xml:lang="de">Stil</skos:altLabel>
        <skos:definition xml:lang="de">Stil: Auf wesentl. Eigenschaften beruhende Gleichartigkeit künstler. Mittel, d. h. die Art der Anwendung von Formen und deren Auswahl, die Einbindung des Individuellen ins Allg.: die Eigenheit einer Künstlerpersönlichkeit (Individuals.), einer Landschaft (Raum-, Nationals.), einer Zeit (Zeits., wie Romanik, Gotik, Renaissance, Barock, Rokoko, Klassizismus, Historismus, Jugendstil usw.) oder eines Materials (Materials.). Die Erkenntnis von S.merkmalen an fest datierten Werken erlaubt es, eine S. entwicklung zu rekonstruieren und undatierte Werke mit einer gewissen Genauigkeit der Datierung einzufügen. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Stilausprägung</skos:prefLabel>
        <skos:prefLabel xml:lang="es">estilo</skos:prefLabel>
        <skos:prefLabel xml:lang="it">stile</skos:prefLabel>
        <skos:prefLabel xml:lang="en">style</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">style</skos:prefLabel>
    </owl:NamedIndividual>
    


