	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1816">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1816</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">RÈILE MHÈINNEARAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Rathad-iarainn a tha gu sònraichte airson giùlan guail is chlachan-mèinneir eile.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MINERAL RAILWAY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1815" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1103" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1169" />
		<skos:scopeNote xml:lang="en">A railway used specifically to transport coal and other minerals.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
