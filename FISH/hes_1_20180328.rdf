		<skos:prefLabel xml:lang="gd">CALA FLEÒDRAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Cala a chaidh a thogail de dh'aonadan no caissons air fleòdradh 's a chaidh an ceangal ri chèile.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">FLOATING HARBOUR</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-14T15:27:09</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-14T15:27:20</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">MULBERRY HARBOUR</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1390" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/278" />
		<skos:scopeNote xml:lang="en">A harbour constructed from floating pontoons or caissons connected end to end.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
