    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Oven"@en ;
    skos:scopeNote "An enclosed structure of brick, stone or metal in which material is heated or burned, or, in a domestic context, food is cooked, through the continuous radiation of heat from its floor, walls or ceiling."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/139624> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_com/concepts/138182> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Artists Studio"@en ;
    skos:scopeNote "A workroom or apartment, often with a north-light, used for the creation of artwork by painters, sculptors etc."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/139625> a skos:Concept ;
