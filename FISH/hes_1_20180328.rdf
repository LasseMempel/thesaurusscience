		<skos:prefLabel xml:lang="gd">TARGAID BOMAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach no structar a chaidh a thogail airson eacarsaichean bomaidh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BOMBING TARGET</skos:prefLabel>
