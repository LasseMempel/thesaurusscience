		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk004770"/>
		<xe:explanation_temp xml:lang="de">Durch eine Dachgaupe wird aufrechtes Stehen und freies Hinausschauen ermöglicht. Sie vergrößert den Wohnraum und die Nutzungsmöglichkeiten unterm Dach. </xe:explanation_temp>
		<skos:definition xml:lang="de">Eine Dachgaupe ist der Bestandteil eines Daches, der an geneigten Dächern durch senkrecht stehende Fensterscheiben aus dem Dach herausragt.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4148722-9"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk001412"/>
