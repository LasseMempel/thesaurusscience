	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021280">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="mul">Cnidaria</skos:prefLabel>
		<skos:altLabel xml:lang="de">Cnidarier</skos:altLabel>
		<skos:altLabel xml:lang="mul">Cnidarium</skos:altLabel>
		<skos:prefLabel xml:lang="de">Nesseltier</skos:prefLabel>
		<skos:altLabel xml:lang="de">Nesseltiere</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk001769"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk001769"/>
		<skos:definition xml:lang="de">Nesseltiere sind vielzellige, im Wasser lebende Tiere, die überwiegend im Meer vorkommen und die durch Nesselzellen gekennzeichnet sind, mit denen sie bei Berührung giftige Nesselfäden zum Beutefang oder zur Verteidigung ausschleudern. Zu den Nesselieren zählen unter anderem Quallen, Korallen, Seeanemonen und Hydren.</skos:definition>
		<skos:mappingRelation rdf:resource="http://www.wikidata.org/entity/Q25441"/>
		<skos:mappingRelation rdf:resource="http://vocab.getty.edu/aat/300265921"/>
		<skos:mappingRelation rdf:resource="http://d-nb.info/gnd/4171498-2"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk001769"/>
