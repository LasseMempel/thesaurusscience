        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-08T15:01:59.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T11:08:40.000</terms:modified>
        <skos:definition xml:lang="de">Falchion (engl. Pallasch), ein vierblättriges Gebilde, bei dem einem Pass ein kielbogiges Blatt gegenüber steht, während die beiden seitl. Blätter gespitzt langgezogen und immer gekrümmt sind. Bes. im engl. Curvilinear-Maßwerk 1. Hälfte des 14. Jhs. vorkommend. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Falchion</skos:prefLabel>
    </owl:NamedIndividual>
    


