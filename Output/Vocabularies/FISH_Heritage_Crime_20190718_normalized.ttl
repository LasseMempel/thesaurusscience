    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152640> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Fire Setting"@en ;
    skos:scopeNote "The deliberate, malicious starting of fires."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152671> a skos:Concept ;
    skos:altLabel "Car Noise"@en,
        "Motorbike Noise"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152656>,
        <http://purl.org/heritagedata/schemes/596/concepts/152694> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Vehicle Noise"@en ;
    skos:scopeNote "Sound energy emanating from motor vehicles which is is constituted chiefly of engine, tire, aerodynamic and braking elements."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152674> a skos:Concept ;
