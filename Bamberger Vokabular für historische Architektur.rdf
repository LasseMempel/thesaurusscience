        <skos:altLabel xml:lang="de">Kreuzgiebeldach</skos:altLabel>
        <skos:definition xml:lang="de">Kreuzdach, Kreuzgiebeldach, Dach, das aus einander rechtwinklig überkreuzenden Satteldächern über quadrat. Grundriss besteht, bes. auf Türmen. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Kreuzdach</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">křížová střecha</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_f4e2bee8"/>
    </owl:NamedIndividual>
    


