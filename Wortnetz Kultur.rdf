		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-11-08T16:51:12+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk003842">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">feldspar</skos:prefLabel>
		<skos:altLabel xml:lang="en">feldspars</skos:altLabel>
		<skos:prefLabel xml:lang="de">Feldspat</skos:prefLabel>
		<skos:altLabel xml:lang="de">Feldspate</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003905"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk003905"/>
		<skos:definition xml:lang="de">Ein Feldspat ist ein Silikat, das als einer der häufigsten Gesteinsbildner auftritt und vor allem in Vulkaniten meist das häufigste Mineral darstellt.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003905"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003847"/>
