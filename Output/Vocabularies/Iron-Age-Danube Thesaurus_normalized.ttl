<https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme/concept345> a skos:Concept ;
    skos:altLabel "stray find"@en ;
    skos:definition "An object of some kind -- pottery, metalwork, a coin, etc. -- which has not been found in an archaeological context. Stray finds are useful if the total distribution of a particular type of object is required, but the absence of associated material or structures makes their interpretation difficult."@en ;
    skos:inScheme <https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme> ;
    skos:prefLabel "Einzelfund"@de,
        "single find"@en ;
    skos:topConceptOf <https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme> .

