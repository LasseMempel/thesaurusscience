    <!-- https://hist-arch-vocab.org/bvha#c_40fc6bc5 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_40fc6bc5">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_174d6ba6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-25T11:53:02.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T19:47:07.000</terms:modified>
        <skos:definition xml:lang="de">Verschluss der Gefache im Fachwerkbau, in dem zwischen die Horizontalhölzer des Gerüsts Stöcke (Staken) in Nuten eingesetzt werden, um die Weidenruten (Fachgerten) oder Strohseile gewunden und mit strohvermengtem Lehm verkleidet werden. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Ausstakung</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_40fd9bd2 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_40fd9bd2">
