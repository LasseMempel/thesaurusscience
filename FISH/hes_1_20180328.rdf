		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1917" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/543" />
		<skos:scopeNote xml:lang="en">A building from where marine operations are directed.</skos:scopeNote>
