        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T17:20:36.000</terms:modified>
        <skos:altLabel xml:lang="cs">podezdívka</skos:altLabel>
        <skos:altLabel xml:lang="cs">podnož</skos:altLabel>
        <skos:altLabel xml:lang="fr">socle</skos:altLabel>
        <skos:definition xml:lang="de">Der Unterbau eines Gebäudes, einer Säule oder einer Statue. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Lat. socculus = botka. 1. Spodní část zdiva, často oddělená soklovou římsou. 2. Podstavec sloupu, pilíře, sochy. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Sockel (lat. socculus = kleiner Schuh), 1. unterer Mauerteil, oft durch ein Sockelgesirns (Gesims) abgesetzt; 2. Unterbau von Säule, Pfeiler, Skulptur. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Sockel</skos:prefLabel>
        <skos:prefLabel xml:lang="en">pedestal</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">piédouche</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">sokl</skos:prefLabel>
        <skos:prefLabel xml:lang="it">zoccolo</skos:prefLabel>
        <skos:prefLabel xml:lang="es">zócalo</skos:prefLabel>
    </owl:NamedIndividual>
    


