		<skos:prefLabel xml:lang="de">Kollektivbestattung (Grab)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Kollektivbestattungen (Gräber)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk002725"/>
