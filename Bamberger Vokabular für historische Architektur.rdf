    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_b07f1ec0 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b07f1ec0">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_89b7da10"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
