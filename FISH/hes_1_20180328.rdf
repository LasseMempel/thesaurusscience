				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/435</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TAIGH A’ MHUILLEIR</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Àite-còmhnaidh muilleir, gu math tric ri muilleann, taigh-grùide no taigh-staile.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">MILL HOUSE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:altLabel xml:lang="en">MILLERS HOUSE</skos:altLabel>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/433" />
				<skos:scopeNote xml:lang="en">The residence of a miller, often attached to a mill, brewery or distillery.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/434" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/437" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/422" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/647" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/438" />
		<skos:scopeNote xml:lang="en">The residence and sometimes workplace of industrial workers.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/434">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/434</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH A’ GHRÙDAIR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite-còmhnaidh aig cuideigin a tha ri grùdaireachd, co-cheangailte ri TAIGH-GRÙIDE.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BREWERS HOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/433" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/765" />
		<skos:scopeNote xml:lang="en">A dwelling occupied by a person engaged in the brewing industry, associated with a BREWERY.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/436">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/436</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH-MÈINNEIR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Taigh beag a chaidh a thogail a dh'aona-ghnothach le fastaiche airson còmhnaidh mèinneir agus a chuid teaghlaich.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MINERS COTTAGE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-01-09T08:26:10</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">COAL MINERS COTTAGE</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/438" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/489" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/531" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/536" />
		<skos:scopeNote xml:lang="en">A cottage purpose built by an employer for the accommodation of a miner and his family.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/437">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/437</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH-BREABADAIR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach a tha an dà chuid na àite-còmhnaidh agus àite-obrach far an dèanar clò a làimh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">WEAVERS COTTAGE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/433" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/720" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1553" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/934" />
		<skos:scopeNote xml:lang="en">A building which combines a dwelling with a workshop where textiles are hand woven.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/438">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/438</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH-SGALAIG</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Taigh aig obraiche gnìomhachais a chaidh a thogail a dh'aona-ghnothach le fastaiche, seach taighean-ciùird a bhiodh aig ciùird.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">WORKERS COTTAGE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-01-09T08:31:24</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/436" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/433" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/441" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/496" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/535" />
		<skos:scopeNote xml:lang="en">An industrial worker's house which has been purpose built by an employer, as opposed to the workshop houses used by artisans.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/439">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/439</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH AN UACHDARAIN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Taigh-còmhnaidh meadhanach mòr a bha aig uachdarain-fhearainn eadar 1560 is 1750 mu thuaiream. Bha iad nan taighean-tùir an toiseach ach chaidh an togail air plana ceart-cheàrnach is co-shìnte an uairsin.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">LAIRDS HOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/422" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/122" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/341" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/424" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/469" />
		<skos:scopeNote xml:lang="en">A medium-sized domestic residence of a lesser landholder c.1560-c.1750, the earliest being of tower-house form, the later ones of symmetrical rectangular plan.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/441">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/441</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH A’ MHANAIDSEIR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite-còmhnaidh a chaidh a thogail do mhanaidsear factaraidh no muileann-clòtha 's msaa, gu math tric am broinn an aitreibh fhèin.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MANAGERS HOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/422" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1080" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/438" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/769" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/848" />
		<skos:scopeNote xml:lang="en">A purpose-built dwelling for the manager of a factory, works, textile mill, etc, often found within the complex itself.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/443">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/443</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH LE CUAIRT-DHÌG</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Taigh-cruinn le dìg na bhroinn. Dh'fhaoidte gum faicear an dìg air uachdar na talmhainn.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">RING DITCH HOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/422" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/444" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/445" />
		<skos:scopeNote xml:lang="en">A roundhouse with an internal ditch, which may be visible on the ground surface.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/444">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/444</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH LE CUAIRT-GHRÒB</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Taigh-cruinn aig an robh saidhean a sheas ann an clais leabachaidh bheàrn-fhàinneach. Dh'fhaoidte gun aithnichear a' chlais air gròb eu-domhain air an talamh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">RING GROOVE HOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/422" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/443" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/445" />
		<skos:scopeNote xml:lang="en">A roundhouse, the upright posts of which stood in a penannular bedding trench. The trench may be visible on the ground as a shallow groove.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/445">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/445</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH-CRUINN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite-còmhnaidh cearcallach no cha mhòr cearcallach, air a thogail de dh'fhiodh gu ìre mhòr ach faodaidh gu bheil bun cloiche no ùir aig a' bhalla.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ROUNDHOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">ROUND HOUSE</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/422" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/446" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/458" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/443" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/444" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/461" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/532" />
		<skos:scopeNote xml:lang="en">A circular or sub-circular dwelling, largely timber-built, although it may have a stone or earth wall base.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/446">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/446</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH-CRUINN TRANNSACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach-cobhaireachd a tha cruinn no cha mhòr cruinn agus aig a bheil sreath de charraighean-cloiche dìreach mu choinneamh a bhalla a-staigh, gu tric le leacan os an cionn a tha an taobh eile dhiubh air an anainn. Cleachd an àite TAIGHE-CUIBHLE ma tha a leithid a rudan ann.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">AISLED ROUNDHOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">ROUND WAG</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/445" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/406" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/409" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/412" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/458" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/461" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/476" />
		<skos:scopeNote xml:lang="en">A circular or sub-circular dry-stone building with a series of upright single pillar stones set vertically around its inner wall-face, often capped by a lintel which rests on the wall-head. Use for WHEELHOUSE if these features are present.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/447">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
