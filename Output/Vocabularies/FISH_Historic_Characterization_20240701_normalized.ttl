    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Bait Digging"@en ;
    skos:scopeNote "Areas whose character is dominated by regular digging to acquire bait for fishing by various methods. Generally found in estuaries, sandy and rocky foreshores."@en .

