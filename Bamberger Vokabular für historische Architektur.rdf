    <!-- https://hist-arch-vocab.org/bvha#c_126f1589 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_126f1589">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_de30207d"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-28T16:47:21.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T13:55:39.000</terms:modified>
        <skos:altLabel xml:lang="it">atrio</skos:altLabel>
        <skos:altLabel xml:lang="cs">dvorana</skos:altLabel>
        <skos:altLabel xml:lang="cs">vstupní hala</skos:altLabel>
        <skos:definition xml:lang="de">(lat. vestis ›Gewand‹), Vorraum eines Hauses. Im Schlossbau bezeichnet man damit die große Eingangshalle, von der meist die Treppe abgeht und die man durchschreitet, um in die Sala terrena zu gelangen. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:definition xml:lang="cs">Lat. vestibulum, vstupní hala a předsíň domu, též strážní místnost. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Vestibulum, 1. Vorhof, Vorhalle vor dem Eingang des röm. Hauses, die in die Bauflucht einbezogene Haustür bildet den hinteren Abschluss, seit!. von Läden oder anderen Räumen flankiert. Vom V. geht der Raum mit der Obergeschosstreppe ab. 2. In der jüngeren Neuzeit zunächst ein Vorraum hinter der Haustür vor den Zimmern, häufig mit Garderobe ausgestattet, dann auch jedes Vorzimmer. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Vestibül (lat. vestibulum), Eingangshalle und Vorraum eines Hauses, auch Wachtraum. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Vestibül</skos:prefLabel>
        <skos:prefLabel xml:lang="it">vestibolo</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">vestibul</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">vestibule</skos:prefLabel>
        <skos:prefLabel xml:lang="la">vestibulum</skos:prefLabel>
        <skos:prefLabel xml:lang="es">vestíbulo</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_12738af1 -->


