		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/624" />
		<skos:scopeNote xml:lang="en">An area of land designed to provide living material for the study of botany and horticulture. May include public glasshouses and gardens.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
