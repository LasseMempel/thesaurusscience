    <!-- https://hist-arch-vocab.org/bvha#c_69b00eaa -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_69b00eaa">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_ba70d70b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_5bf6bcac"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-20T16:19:36.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-20T16:22:21.000</terms:modified>
        <skos:altLabel xml:lang="de">Doppelsulfat</skos:altLabel>
        <skos:altLabel xml:lang="de">Kalialaun</skos:altLabel>
        <skos:definition xml:lang="de">Ein bereits in der Antike bekanntes Salz, ein Kalium-Aluminium- Sulfat, weshalb es den Namen Doppelsulfat trägt. Es kann aus Alaunschiefer, aber auch aus Bauxit und Kaolin gewonnen werden, in entwässerter Form ist es als mildes Ätzmittel in Gebrauch und wurde bei der Papierherstellung und zum Färben und Gerben eingesetzt. [Schrader / Voigt 2003]</skos:definition>
        <skos:prefLabel xml:lang="de">Alaun</skos:prefLabel>
    </owl:NamedIndividual>
    


