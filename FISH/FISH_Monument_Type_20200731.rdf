  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93940">
    <skos:scopeNote xml:lang="en">A structure used for music, dance, ceremonial or civic events.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70334">
    <skos:scopeNote xml:lang="en">Usually a row of bushes or small trees planted closely together to form a boundary between pieces of land or at the sides of a road.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143966">
