    <!-- https://hist-arch-vocab.org/bvha#c_6190bcdb -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_6190bcdb">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0fe515e7"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_4b0fc1fe"/>
