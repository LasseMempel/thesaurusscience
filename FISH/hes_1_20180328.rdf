		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500636" />
		<skos:scopeNote xml:lang="en">A room or a building set aside for infants and young children.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
