        <skos:altLabel xml:lang="fr">sacristain</skos:altLabel>
        <skos:altLabel xml:lang="en">sacristan</skos:altLabel>
        <skos:definition xml:lang="de">Mesner m; Küster m; Sakristan m; lat. mansionarius; custos: Kirchendiener, dem die Sorge für Kirchengebäude, Paramente und Kirchengerät, auch für das Glockenläuten etc. obliegt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Mesner</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">bedeau</skos:prefLabel>
        <skos:prefLabel xml:lang="la">mansionarius</skos:prefLabel>
        <skos:prefLabel xml:lang="en">sexton</skos:prefLabel>
    </owl:NamedIndividual>
    


