        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-08T21:37:18.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T14:53:19.000</terms:modified>
        <skos:altLabel xml:lang="de">Randsicherung</skos:altLabel>
        <skos:altLabel xml:lang="tr">kenar tamir süsü</skos:altLabel>
        <skos:definition xml:lang="fr">Ajout de mortier pour eviter la perte de matiere en bordures d’enduit exposees. (EwaGlos)</skos:definition>
        <skos:definition xml:lang="en">Mortar additions undertaken to protect exposed plaster and stone edges against loss, water and dirt infiltration. (EwaGlos)</skos:definition>
        <skos:definition xml:lang="de">Mörtelergänzungen, mit denen exponierte Putz- und Steinränder gegen Schädigung und das Eindringen von Wasser und Schmutz geschützt werden. (EwaGlos)</skos:definition>
        <skos:prefLabel xml:lang="de">Anböschung</skos:prefLabel>
