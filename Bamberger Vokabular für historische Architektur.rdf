        <skos:altLabel xml:lang="de">Firstbaum</skos:altLabel>
        <skos:definition xml:lang="de">Firstpfette, bei Pfettendächern zur Unterstützung der Rofen unter dem First angeordnete Pfette, die von Säulen oder Stühlen gestützt wird (veraltet Firstbaum). [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Firstpfette</skos:prefLabel>
