		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/405</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">AIG AN TAIGH</skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://purl.org/heritagedata/schemes/1" />
