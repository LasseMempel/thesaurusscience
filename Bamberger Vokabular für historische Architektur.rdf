    <!-- https://hist-arch-vocab.org/bvha#c_ff77b7dd -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_ff77b7dd">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_d6f572a5"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-25T13:30:30.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T23:21:47.000</terms:modified>
        <skos:definition xml:lang="de">(prakrit.) Aus dem Stupa der buddhist. Baukunst Ostasiens weiterentwickelter Stockwerksbau auf quadrat. oder polygonalem Grundriss. Die meist ungerade Zahl der Stockwerke beträgt zwischen drei und neun. Die oft geschwungenen und manchmal auch mit Glocken besetzten Dächer springen weit vor. Die P. ist ein umschreitbares Heiligtum und kann isoliert, aber auch in Verbindung mit anderen Bauten einer buddhist. Tempelanlage stehen. Der Begriff P. wird auch für turmähnl. Bauten ind. bzw. hinterind. Tempel verwandt. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Pagode</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_ff863922 -->


