	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/183">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/183</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TOGALACH A' BHAILE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach aig ùghdarras ionadail no fear a tha ga chleachdadh le ùghdarras ionadail.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MUNICIPAL BUILDING</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/151" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/156" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/191" />
		<skos:scopeNote xml:lang="en">A building owned or used by a local authority.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/184">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/184</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BOTHAN NISSEN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar ro-shaothraichte, frèam stàilinn air an robh iarann preasach. Bha roinn-tarsainn leth-chearcallach aca 's chaidh an cleachdadh le feachdan an airm agus, rè an Dàrna Chogaidh Mhòir, mar taigheadas èiginn do dhaoine a chaidh na taighean aca a leigeil mu làr le boma. Ga chleachdadh mar stòras cuideachd.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">NISSEN HUT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/151" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/349" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/351" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/361" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/367" />
		<skos:scopeNote xml:lang="en">A prefabricated structure of a steel frame clad in corrugated iron. Semi-circular in section they were used as accommodation for the armed forces and, during WWII, as emergency housing for bombed out civilians. Also used for storage.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/185">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/185</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TOGALACH POBLACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach no grunn thogalaichean aig buidheann-riaghlaidh 's e gan obrachadh, bidh buidheann riaghaltais ann gu math tric. Cleachd seòrsa nas mionaidiche de thogalach ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PUBLIC BUILDING</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/151" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/186" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/187" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/188" />
		<skos:scopeNote xml:lang="en">A building or group of buildings owned and operated by a governing body and often occupied by a government agency. Use specific type of building where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/186">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/186</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">SEÒMRAICHEAN COINNEACHAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach no sreath sheòmraichean far an tigear còmhla cruinn agus far an cumar dannsaichean.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ASSEMBLY ROOMS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1587" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/185" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500547" />
		<skos:scopeNote xml:lang="en">A building or set of rooms in which social gatherings and dances are held.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/187">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/187</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH-MARGAID</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach margaide a chaidh a thogail ron 19mh linn aig a bheil seòmraichean airson rudan eile, m.e. taigh-cluich, seòmraichean-cùirte, seòmraichean-teagaisg.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MARKET HOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/185" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/219" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/190" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/191" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500625" />
		<skos:scopeNote xml:lang="en">A market building, pre-19th century, incorporating other function rooms, e.g. theatres, courtrooms, schoolrooms.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/188">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/188</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TALLA CRUINNEACHAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite far an cruinnich daoine airson fèisteas, deasbad no tionalan. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MEETING HALL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
