	<dct:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence"/>
	<dct:spatial rdf:resource="http://dbpedia.org/resource/Scotland"/>
	<dct:spatial rdf:resource="http://vocab.getty.edu/tgn/7002444"/>
	<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/EM"/>
	<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300262953"/>
	<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/scapa"/>
	<skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NO</skos:notation>
	<skos:prefLabel xml:lang="en">Norse</skos:prefLabel>
	<skos:prefLabel xml:lang="gd">Lochlannais</skos:prefLabel>
	<skos:scopeNote xml:lang="en">A cultural term applied to areas settled by and often territory controlled by the Norse. The term may be applied to place-names, monument types and artefacts.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="http://purl.org/heritagedata/schemes/scapa/concepts/PA">
