		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019759"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk003837"/>
		<xe:explanation_temp xml:lang="de">Der notwendige Lebensunterhalt wird durch Arbeit, Schenkungen oder Betteln bestritten.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Bettelorden ist ein christlicher Orden, welcher besonders der Armut verpflichtet ist und kein Eigentum besitzt.</skos:definition>
