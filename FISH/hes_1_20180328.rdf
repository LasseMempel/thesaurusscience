		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/120" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1466" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1520" />
		<skos:scopeNote xml:lang="en">A field boundary or enclosure bank constructed in turf.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
