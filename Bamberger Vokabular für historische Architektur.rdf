        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T13:25:44.000</terms:modified>
        <skos:definition xml:lang="de">Quadrifons (lat.), ein vierseitiger Torbau mit Öffnungen auf jeder Seite. [Koepf / Binding 2016]</skos:definition>
