				<skos:prefLabel xml:lang="gd">GÀRRADH-CÀIL</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Lann mun a bheil balla cloiche, gu sònraichte airson fàs a thoirt air càl; aithnichear gu tric iad is ùir a' càrnadh an àirde na broinn.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">KALE YARD</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-12-08T11:28:42</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-12-15T15:16:13</dcterms:modified>
