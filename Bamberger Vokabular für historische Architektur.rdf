    <!-- https://hist-arch-vocab.org/bvha#c_f7567a8d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_f7567a8d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_3afe76f7"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_776742bd"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-04T13:17:07.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T00:56:07.000</terms:modified>
        <skos:definition xml:lang="de">Auch Landschaftsgarten genannt; ein künstl. angelegter, aber der Natur weitgehend nachgebildeter Park, der unter dem Einfluss der Romantik im 18. Jh. in England entstand und 1790-1815 in Europa beliebt war. Hauptelemente der Anlage waren außer Nutzung natürl. Geländegegebenheiten geschlungene Wege und natürl. und künstl. Ruinen, Tempel, Pavillons, Plastiken, auch mit landwirtschaftl. genutzten Flächen und Bauten. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Šířil se od počátku 18. století z Anglie a měl nepravidelný ráz podobný volné přírodě; zdánlivou náhodnost jeho uspořádání oživovaly stavby a pomníky, které vyjadřovaly zcela určité, často sentimentální pocity: umělé zříceniny (minulost), neogotické ermitáže (osamělost), selská stavení (prostota), čínské mosty a chrámy (dálka) atd. Často navazuje na již existující barokní park, viz folly. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Englischer Garten</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">anglický park</skos:prefLabel>
    </owl:NamedIndividual>
    


