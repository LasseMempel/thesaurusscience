	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk015213">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Bohnenschneidemaschine</skos:altLabel>
		<skos:prefLabel xml:lang="de">Bohnenschneider</skos:prefLabel>
		<skos:altLabel xml:lang="de">Bohnenschnippler</skos:altLabel>
		<skos:prefLabel xml:lang="en">green bean slicer</skos:prefLabel>
		<skos:altLabel xml:lang="en">green bean slicers</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk010543"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013697"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk010543"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk017733"/>
		<xe:explanation_temp xml:lang="de">Ein Bohnenschneider ist ein Küchengerät, das bei der Zerkleinerung von Bohnen eingesetzt wird. Heute besteht es in der Regel aus Metall, während es u. a. im Jugenstil aus Gusseisen hergestellt wurde. Das Gerät hat eine seitliche Kurbel, die den Klingenkopf antreibt, sowie an der Oberseite eine trichterähnliche Öffnung, über die die zu zerkleinernden Bohnen eingefüllt werden und gegenüber der Kurbel eine Öffnung, aus der die zerkleinerten Bohnen herausfallen. Es kann mit Hilfe einer Klemme oder einer schraubstockähnlichen Vorrichtung an einer Küchen- oder Tischplatte befestigt werden, sodass die Kurbel gut beweglich ist und die zerkleinerten Bohnen auf die Arbeitsplatte fallen können.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Bohnenschneider ist ein Küchengerät zum Schneiden von Bohnen.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk013697"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010543"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-01T17:27:48+02:00+01:00</dcterms:modified>
	</skos:Concept>
