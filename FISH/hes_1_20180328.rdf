		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501707" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/503860" />
		<skos:scopeNote xml:lang="en">This is the top term for the class. See DOMESTIC Class List for narrow terms.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
