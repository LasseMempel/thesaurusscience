    dct:description "Terminology used for recording archaeological and architectural investigative, data collection exercises; from intrusive interventions to non damaging surveys."@en ;
    dct:publisher <https://historicengland.org.uk/> ;
    dct:spatial <http://dbpedia.org/resource/England>,
        <http://vocab.getty.edu/tgn/7002445> ;
    dct:title "FISH Event Types Thesaurus"@en ;
