        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-29T13:25:11.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:45:57.000</terms:modified>
        <skos:altLabel xml:lang="en">diagonal and cross ribbing</skos:altLabel>
        <skos:definition xml:lang="de">Gewölbe mit parallel verlaufenden, schräg zur Längsachse des Raumes ausgerichteten Rippen. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Diagonalrippengewölbe</skos:prefLabel>
        <skos:prefLabel xml:lang="en">diagonal-ribbed vault</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte à nervures diagonales</skos:prefLabel>
