        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_19d56a39"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-23T12:22:20.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T11:45:53.000</terms:modified>
        <skos:definition xml:lang="de">Die Sparrenspannweite unterteilendes, abstützendes Holz zwischen Sparren und Dachbalken bzw. Kehlbalken, das senkrecht verläuft oder gegen den Sparren geneigt ist. [Eißing et al. 2012]</skos:definition>
        <skos:prefLabel xml:lang="de">Sparrenunterstützungsstrebe</skos:prefLabel>
    </owl:NamedIndividual>
    


