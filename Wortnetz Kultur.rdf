		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk003189"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk005847"/>
		<xe:explanation_temp xml:lang="de">Lourdesgrotten sind nicht auf Gärten beschränkt, sondern können auch in anderen Zusammenhängen, etwa innerhalb eines Kirchenraumes, vorkommen.</xe:explanation_temp>
		<skos:definition xml:lang="de">Eine Lourdesgrotte eine Grotte, die den Ort der Marienerscheinung von Lourdes nachbildet und in der eine Figur der wundertätigen Madonna von Lourdes steht.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4840119-5"/>
