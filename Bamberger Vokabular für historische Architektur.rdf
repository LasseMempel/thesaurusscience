        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:49:48.000</terms:modified>
        <skos:altLabel xml:lang="en">parallel ribbed vault</skos:altLabel>
        <skos:definition xml:lang="de"> Gewölbe mit paarweise gleichlaufenden Rippen (Parallelrippen), gehört als Untergruppe zu den Netzgewölben. [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Gewölbe mit paarweise gleichlaufenden Rippen. Dieser Figuration liegt ein System von Rippendreistrahlen zugrunde. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="en"> vault with parallel ribs  </skos:prefLabel>
        <skos:prefLabel xml:lang="it"> volta reticolare a nervature binate</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Parallelrippengewölbe</skos:prefLabel>
        <skos:prefLabel xml:lang="es">bóveda nervada en paralelo</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte à nervures parallèles</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_b505b3b9"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_bb6974ce -->


