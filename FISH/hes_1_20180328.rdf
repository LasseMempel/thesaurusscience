		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1827</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">DROCHAID-RÈILE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Drochaid, mar is trice tè thogte air grunn bhoghachan agus air a bheil rathad-iarainn a' dol thairis air gleann, abhainn no talamh ìseal.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">RAILWAY VIADUCT</skos:prefLabel>
