	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500635">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500635</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">SEÒMAR-ÀRAICH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Seòmar no togalach a tha airson naoidheanan is clann òga.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">NURSERY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-30T10:19:41</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-30T10:22:27</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
