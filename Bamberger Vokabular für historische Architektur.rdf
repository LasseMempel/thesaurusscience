        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_40d7ba03"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_7a7db0bd"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-20T17:39:01.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T16:09:49.000</terms:modified>
        <skos:definition xml:lang="de">Monstranzvelum n, schlichtes, weißes Tuch aus weichem Stoff, mit dem die Monstranz vor und nach der Exposition verhüllt wird; bei der Aussetzung im Heiligen Grab wird die Monstranz von einem durchsichtigen, weißen Velum bedeckt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Monstranzvelum</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">monstranční velum</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voile d\&apos;ostensoir</skos:prefLabel>
    </owl:NamedIndividual>
    


