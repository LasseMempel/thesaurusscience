		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004628"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk012104"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk018756"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004628"/>
		<skos:definition xml:lang="de">Eine Gabel ist ein landwirtschaftliches Gerät mit zwei oder mehr Zinken, die an einem langen Stiel montiert sind, und das je nach Ausprägung zum Schaufeln, Aufheben und Kurzzeittransport verschiedener loser Güter, oder zum Graben verwendet wird.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300024351"/>
