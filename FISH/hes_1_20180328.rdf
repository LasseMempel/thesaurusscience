		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1237" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1989" />
		<skos:scopeNote xml:lang="en">A treadwheel using a donkey as motive power. Usually found in association with wells.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
