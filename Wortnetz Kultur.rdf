		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-05-20T12:06:31+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021266">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Bärlapppflanze</skos:prefLabel>
		<skos:altLabel xml:lang="de">Bärlapppflanzen</skos:altLabel>
		<skos:prefLabel xml:lang="mul">Lycopodiopsida</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000855"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000855"/>
		<skos:definition xml:lang="de">Eine Bärlapppflanze ist eine Gefäßpflanze, die wie Farne Sporen statt Samen bildet.  Sie besitzt nur kleine, schuppenartige Blätter, sogenannte Mikrophylle, und meist gabelig verzweigte Stängel. Rezente Bärlapppflanzen sind klein und krautig, im Karbon wuchsen sie jedoch zu riesigen Bäumen und bildeten die Grundlage für die Steinkohlevorkommen.</skos:definition>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1149748"/>
		<skos:broadMatch rdf:resource="http://vocab.getty.edu/aat/300310157"/>
