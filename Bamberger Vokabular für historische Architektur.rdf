        <skos:prefLabel xml:lang="fr">bec</skos:prefLabel>
        <skos:prefLabel xml:lang="en">bill</skos:prefLabel>
        <skos:prefLabel xml:lang="es">pico</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_44ceb1c0 -->


