        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-28T20:27:08.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T17:11:32.000</terms:modified>
        <skos:definition xml:lang="de">Fünf schmerzensreiche Geheimnisse n pl : die zweite Abteilung des Rosenkranzes. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Fünf schmerzreiche Geheimnisse</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">cinq mystères douloureux</skos:prefLabel>
        <skos:prefLabel xml:lang="en">five sorrowful mysteries</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Die fünf schmerzreichen Geheimnisse sind: Todesnot in Gethsemane, Geißelung, Dornenkrönung, Kreuztragung und Kreuzigung. [Glossarium Artis]</skos:scopeNote>
    </owl:NamedIndividual>
    


