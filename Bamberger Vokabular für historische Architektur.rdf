        <skos:prefLabel xml:lang="en">blind triforium</skos:prefLabel>
        <skos:prefLabel xml:lang="es">triforio simulado</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">triforium simulé</skos:prefLabel>
    </owl:NamedIndividual>
    


