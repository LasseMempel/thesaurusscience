  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69272">
    <skos:scopeNote xml:lang="en">A site where ores are smelted. Use more specific site type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70287">
    <skos:scopeNote xml:lang="en">A structure used for the lifting of boats and other water craft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68659">
    <skos:scopeNote xml:lang="en">A pillow-shaped, flat topped rectangular mound often surrounded by a shallow ditch used to farm rabbits.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69339">
    <skos:scopeNote xml:lang="en">The area of water retained above a mill dam for driving a mill.</skos:scopeNote>
  </rdf:Description>
