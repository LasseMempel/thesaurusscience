		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/473" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/486" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500574" />
		<skos:scopeNote xml:lang="en">A building located at the gateway or entrance to an estate, park or other enclosed area of land.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
