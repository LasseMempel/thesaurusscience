	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk005011">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">monstrance</skos:prefLabel>
		<skos:altLabel xml:lang="en">monstrances</skos:altLabel>
		<skos:prefLabel xml:lang="de">Monstranz</skos:prefLabel>
		<skos:altLabel xml:lang="de">Monstranzen</skos:altLabel>
