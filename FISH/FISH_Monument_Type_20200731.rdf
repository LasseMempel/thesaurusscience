  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71661">
    <skos:scopeNote xml:lang="en">A specialist school for the teaching of blind people.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92519">
    <skos:scopeNote xml:lang="en">A factory used for the manufacture and assembly of lorries.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69015">
    <skos:scopeNote xml:lang="en">A fountain erected specifically to supply drinking water.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140784">
    <skos:scopeNote xml:lang="en">A radio station set up to broadcast signals aimed at 'bending' or altering German navigation transmissions.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91455">
    <skos:scopeNote xml:lang="en">Building with underfloor kiln used for drying China Clay slurry prior to packing and transportation. Central feature of China Clay Works.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70376">
    <skos:scopeNote xml:lang="en">A hollow, concave formation or place, which has sometimes been dug out.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140531">
    <skos:scopeNote xml:lang="en">A pillbox which varies from standard designs.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/100530">
    <skos:scopeNote xml:lang="en">A site or structure associated with the activities of the Royal Observer Corps. The Corps was reformed on 1 January 1947 and disbanded in 1991.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69010">
    <skos:scopeNote xml:lang="en">A turret, tower or look out occupying a prominent position to provide a view, either a separate building, or part of a villa.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/146386">
    <skos:scopeNote xml:lang="en">A purpose built tower used for the testing of helicopter rotor blades.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142074">
    <skos:scopeNote xml:lang="en">A kitchen set up, specifically during World War Two, to serve food to members of the public, especially families whose homes had succumbed to enemy bombing.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141681">
    <skos:scopeNote xml:lang="en">A club where predominantly rhythm and blues style music is played, analagous to a jazz club.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/83658">
    <skos:scopeNote xml:lang="en">A site where a single large balloon was attached by fine wire cables to the ground to form an aerial obstruction to attacking enemy aircraft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93639">
    <skos:scopeNote xml:lang="en">A framework used as a support upon which fruit-trees or climbing plants are trained.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68857">
    <skos:scopeNote xml:lang="en">Hillslope forts with wide spaced ramparts.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68926">
    <skos:scopeNote xml:lang="en">A small building in which game is hung up and kept cool.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71688">
    <skos:scopeNote xml:lang="en">A school associated with a cathedral or college originally intended to provide a general education for their choristers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69931">
    <skos:scopeNote xml:lang="en">A pit where bears were housed for baiting and entertainment purposes. If not used for baiting use BEAR ENCLOSURE.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93759">
    <skos:scopeNote xml:lang="en">A small building used as a shelter by a constable of the watch responsible for patrolling the streets at night to safeguard life and property.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69097">
    <skos:scopeNote xml:lang="en">Chimney used on an industrial or commercial site.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140500">
    <skos:scopeNote xml:lang="en">A pillbox built to a design drawn up by the Air Ministry. Usually found on or near airfields.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70306">
    <skos:scopeNote xml:lang="en">Sites, buildings, structures, features &amp; areas of land, both natural &amp; man-made, which cannot be assigned to a particular class (for example, railings).</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93663">
    <skos:scopeNote xml:lang="en">Garden steps covered in turf.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160410">
    <skos:scopeNote xml:lang="en">A building associated with a barrage balloon site and intended to provide shelter for the balloon crew from air attack.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140483">
    <skos:scopeNote xml:lang="en">A transportable hangar designed by A &amp; J Main of Glasgow.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93168">
    <skos:scopeNote xml:lang="en">A picturesque garden building decorated with tree roots, often serving as a HERMITAGE or ARBOUR.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92777">
    <skos:scopeNote xml:lang="en">An area of a port, dock or harbour, often including buildings for passport control and customs, where passengers of ocean liners can embark/disembark and where supplies can be taken on board.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70349">
    <skos:scopeNote xml:lang="en">A tower built to display a large clock.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68868">
    <skos:scopeNote xml:lang="en">A permanently occupied position or building designed primarily for defence.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/88213">
    <skos:scopeNote xml:lang="en">A building, usually associated with a port or dock, where seamen could get a meal and a cheap room. Often established by religious groups for the moral betterment of seamen.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/108133">
    <skos:scopeNote xml:lang="en">A mill used for the production of wadding, as opposed to yarn or cloth. Often associated with steam or water power.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159388">
    <skos:scopeNote xml:lang="en">A single-storey structure, usually situated against the exterior of a walled garden's south facing wall, used for storage and often accomodation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69393">
    <skos:scopeNote xml:lang="en">A site used for the manufacture and finishing of querns.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71441">
    <skos:scopeNote xml:lang="en">A building and open area from which buses, usually those working local or regional services, begin or end their journeys.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/135319">
    <skos:scopeNote xml:lang="en">A magistrates court sitting for the purpose of holding trials for children and young people. Replaced the juvenile court, following legislation, in 1991.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69176">
    <skos:scopeNote xml:lang="en">For reheating of worked metal or glass to make it malleable or to harden it after use for toolmaking, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92005">
    <skos:scopeNote xml:lang="en">The residence of a ford keeper.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92532">
    <skos:scopeNote xml:lang="en">A structure to which a net filled with mail bags is attached. Situated next to railway lines, it allows mail to be collected by a train without it stopping, the bag being 'caught' by the train as it passed. Can also be used to 'catch' mail.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69236">
    <skos:scopeNote xml:lang="en">A site used for the production and/or working of metallic iron.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92872">
    <skos:scopeNote xml:lang="en">A pawnbrokers shop or place of business.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91844">
    <skos:scopeNote xml:lang="en">Buildings, sites and structures associated with the production of electricity.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68694">
    <skos:scopeNote xml:lang="en">A building in which works of art are displayed, permanently or temporarily.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68795">
    <skos:scopeNote xml:lang="en">A room or building where clothing and other fabrics are washed, mangled, steamed and ironed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92271">
    <skos:scopeNote xml:lang="en">A building where horses are rubbed down after training.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91287">
    <skos:scopeNote xml:lang="en">A path, barred to vehicles, reserved for riding horses.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92410">
    <skos:scopeNote xml:lang="en">A small gate swinging in a U or V-shaped enclosure, which allows only one person to pass through at a time.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93507">
    <skos:scopeNote xml:lang="en">A working hospital, often near or associated with a university, where doctors and nurses are trained.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68879">
    <skos:scopeNote xml:lang="en">A free standing small turf and timber fortlet, situated every Roman mile along Hadrian's Wall.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/100533">
    <skos:scopeNote xml:lang="en">A ditch associated with a palisade.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92553">
    <skos:scopeNote xml:lang="en">The residence of a sailor.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/169983">
    <skos:scopeNote xml:lang="en">An enclosure defined by a single bank and entrance. They occur on every type of ground, although they favour sheltered, valley side locations. Smaller and usually less well defended than hillforts they are thought to be settlements of Iron Age date.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93144">
    <skos:scopeNote xml:lang="en">A balance engine used to replenish the water levels of a river by transferring water from a reservoir or other supply.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162874">
    <skos:scopeNote xml:lang="en">A small area of managed woodland, created to provide cover for deer and other game.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/90322">
    <skos:scopeNote xml:lang="en">Flats or houses first built by 19th century philanthropic societies as a model to encourage the development of approved working class housing.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170051">
    <skos:scopeNote xml:lang="en">A mill for the processing of rice for use in food products.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91030">
    <skos:scopeNote xml:lang="en">A mill where long-staple hair, often from llamas, is made into yarn.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91944">
    <skos:scopeNote xml:lang="en">A high status building of the medieval period, consisting of a hall and attached room at first floor level with rooms below possibly for storage or living accommodation for a lower status family. The first floor was accessed by an external staircase.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162625">
    <skos:scopeNote xml:lang="en">A farmstead with multiple yards which are grouped together and regularly arranged (other than the defined E, F, H, T or Z plans). The yards may relate to one or more buildings or ranges which may be of either loose courtyard or regular courtyard form.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/111513">
    <skos:scopeNote xml:lang="en">A building or site used for the production of both chemical and organic fertilizer.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142070">
    <skos:scopeNote xml:lang="en">The site of the formal burial of cremated bone, sometimes 'urned' in a vessel or casket of glass, wood or, more commonly, ceramic.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162553">
    <skos:scopeNote xml:lang="en">A circular concrete platform onto which aircraft would be taxied allowing the ground crew to calibrate, check and adjust the accuracy of the aircrafts compass, usually by rotating the platform.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/84019">
    <skos:scopeNote xml:lang="en">An intricately designed garden in which ground coves, low shrubs or coloured earths are arranged in interlacing patterns resembling knots</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68897">
    <skos:scopeNote xml:lang="en">An enclosure of stakes driven into the ground, sometimes for defensive purposes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87801">
    <skos:scopeNote xml:lang="en">A bridge which takes the towpath across the canal.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162554">
    <skos:scopeNote xml:lang="en">A site which is known, or believed to be, where an aircraft crashed. It is an offence to interfere with the wreckage of crashed military aircraft without a licence (Protection of Military Remains Act 1986). Index with AIRCRAFT TYPE where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140540">
    <skos:scopeNote xml:lang="en">A small single storey structure with just one room containing a pyrotechnic cupboard and built of rendered brick with a flat reinforced concrete roof</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159310">
    <skos:scopeNote xml:lang="en">A prefabricated structure of reinforced concrete posts and beams with infillings of pre stressed concrete planks and felted slabs. Initially used for military barracks in WWII and later for civilian housing. Manufactured by the Orlit Company.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/76302">
    <skos:scopeNote xml:lang="en">The hull of a dismantled ship used as a prison.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143367">
    <skos:scopeNote xml:lang="en">A roomspace within an abode which combines the specific functions of several of the more traditional roomspaces into a singular unified space.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140446">
    <skos:scopeNote xml:lang="en">A steel framed seaplane hangar designed for Royal Navy Air Stations by the admiralty in 1917-1918.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162592">
    <skos:scopeNote xml:lang="en">Boarding school for children of Travellers and Romany Gypsies while their parents were away on agricultural work</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/90291">
    <skos:scopeNote xml:lang="en">A building with facilities for playing snooker.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/145017">
    <skos:scopeNote xml:lang="en">A room to display various items of hardware and ironmongery.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87823">
    <skos:scopeNote xml:lang="en">Building housing switch gear to control electricity supply either to the National Grid, industrial or domestic premises.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160240">
    <skos:scopeNote xml:lang="en">A protected parachute store built with permanent brick cavity walls and a roof of reinforced concrete slabs in two heights separated by lantern lights.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70075">
    <skos:scopeNote xml:lang="en">A stone coffin embellished with sculpture.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70420">
    <skos:scopeNote xml:lang="en">A construction of unknown function, either extant or implied by archaeological evidence. If known, use more specific type.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/107813">
    <skos:scopeNote xml:lang="en">A factory or group of buildings engaged in the manufacture of acetone. A variety of processes may be used to manufacture acetone including the use of destructive distallation of wood and fermentation technology.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71715">
    <skos:scopeNote xml:lang="en">A club or cafe where popular music is played for dancing.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93555">
    <skos:scopeNote xml:lang="en">An establishment dedicated to the study of God and religion.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71681">
    <skos:scopeNote xml:lang="en">A craft or repair workshop in a boat yard, harbour or naval dockyard.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69358">
    <skos:scopeNote xml:lang="en">A machine, powered by steam, gas, electricity or other energy source, which produces energy of movement. Use for stationary industrial engines rather than transport use.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91702">
    <skos:scopeNote xml:lang="en">A place of law to which debtors were taken for the recovery of monies by their creditors.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70257">
    <skos:scopeNote xml:lang="en">A structure providing protection against the weather at bus stops.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143493">
    <skos:scopeNote xml:lang="en">A low lying area of land that is usually waterlogged at all times and is flooded in wet weather.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87740">
    <skos:scopeNote xml:lang="en">A stable associated with a horse-drawn tramway system.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159304">
    <skos:scopeNote xml:lang="en">A prefabricated structure of lightweight timber wall sections bolted together. Externally the walls were clad with plasterboard covered with felt. Designed for use as officers accomodation during WWII.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159308">
    <skos:scopeNote xml:lang="en">A type of temporary military hutting used throughout WWII constructed of brick in 'stretcher bond' 4.5 inches thick with a light steel truss roof usually covered with corrugated asbestos sheeting. Used for accommodation, as gyms, training huts etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143430">
    <skos:scopeNote xml:lang="en">A seperate wing of a large house provide accommodation for guests.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/76689">
    <skos:scopeNote xml:lang="en">A building or site from which a lookout can be kept.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/139614">
    <skos:scopeNote xml:lang="en">A building or buildings used for the production of whistles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160535">
    <skos:scopeNote xml:lang="en">A portable indoor air raid shelter in the form of a steel topped table, often with wire meshing around the sides.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92657">
    <skos:scopeNote xml:lang="en">An area of a building providing reading materials for the benefit of colliery workers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69014">
    <skos:scopeNote xml:lang="en">An artificial aperture from which water springs. The water supply usually came from a lake or reservoir higher up in order to ensure the necessary flow and pressure. More recently fountains have been powered by pumps.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91292">
    <skos:scopeNote xml:lang="en">A school founded by the British and Foreign Society to provide non-denominational education. Usually built and supported by voluntary contributions.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92707">
    <skos:scopeNote xml:lang="en">A crane mounted on wheels and/or rails, used for the unloading of ships' cargoes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70354">
    <skos:scopeNote xml:lang="en">An area of land enclosed by a boundary ditch, bank, wall, palisade or other similar barrier. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71393">
    <skos:scopeNote xml:lang="en">A building used to accommodate elephants at a zoo or wildlife park.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162555">
    <skos:scopeNote xml:lang="en">A level crossing designed to allow the passage of aircraft to and from a runway which has a railway or road running through it.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69956">
    <skos:scopeNote xml:lang="en">A prepared area, traditionally grass, where tennis is played.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69001">
    <skos:scopeNote xml:lang="en">A collection of dwelling-houses and other buildings, usually larger than a hamlet but smaller than a town with a simpler organisation and administration than the latter.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/97278">
    <skos:scopeNote xml:lang="en">A complex of buildings at a seaport, comprising of a terminal building, landing pier and hangars, used for the embarkation of passengwers and/or freight on flying boat services during the 1930's-50's.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92647">
    <skos:scopeNote xml:lang="en">A railway used for the conveyance of coal and other minerals.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170633">
    <skos:scopeNote xml:lang="en">A site where aircraft are stored, dismantled and processed for the recovery of serviceable parts.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70612">
    <skos:scopeNote xml:lang="en">Small scale enterprise producing bricks but not at the same site as the extraction of clay.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68876">
    <skos:scopeNote xml:lang="en">A manor house, which was granted a royal licence to crenellate.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93115">
    <skos:scopeNote xml:lang="en">A beacon, firmly embedded on the sea floor, consisting of an iron mast, with ladder steps leading up to the refuge cage considerably above high-water mark, and capable of holding several people.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160502">
    <skos:scopeNote xml:lang="en">Scaffolding erected on a beach and in the surf so as to prevent hostile forces from landing.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/136930">
    <skos:scopeNote xml:lang="en">The premises of a coal merchant where coal and other kinds of solid fuel can be bought.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87959">
    <skos:scopeNote xml:lang="en">A watertight reservoir or tank that receives sewage, and by sedimentation and bacterial action effects a process of partial purification.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94209">
    <skos:scopeNote xml:lang="en">A bridge made up of many relatively small members joined together in a series of interconnecting triangles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69324">
    <skos:scopeNote xml:lang="en">A mill for the removal by mechanical means of the dried wood and seeds of the flax and cotton plants after retting. The resulting 'tow' is then spun into linen and cotton respectively.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71620">
    <skos:scopeNote xml:lang="en">A building where lace was laid out to dry.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/151798">
    <skos:scopeNote xml:lang="en">A large cauldron used in the making of a preservative from the bark of spruce, fir or other conifers. The preservative was used to treat nets, sails and other fishing gear.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92948">
    <skos:scopeNote xml:lang="en">A rudimentary roofed building found in school playgrounds, open at the side. Used as a shelter from bad weather.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140272">
    <skos:scopeNote xml:lang="en">A covered passageway projecting into or across a ditch of a fortified place to provide flanking fire to the ditch in which it stands or for the purpose of sheltering communication with outworks.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78194">
    <skos:scopeNote xml:lang="en">A kiln used for the drying of wood.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68669">
    <skos:scopeNote xml:lang="en">A pit where grain is stored.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68680">
    <skos:scopeNote xml:lang="en">A hall associated with a church, used for holding functions, meetings and for conducting parish business.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70203">
    <skos:scopeNote xml:lang="en">A well or spring, possessing religious or otherwise ritualistic significance, around which a structure, such as a niche, wall or shelter, has been constructed. In the case of the water source being a natural spring, double-index with SPRING.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/103953">
    <skos:scopeNote xml:lang="en">A building where violins are manufactured and the art of violin making is taught.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71099">
    <skos:scopeNote xml:lang="en">Use to identify a feature, previously thought to be a monument but now disproved, or to avoid erroneous identification as a monument in future. Where a feature is regarded as an antiquity, but is unclassified, use SITE.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69218">
    <skos:scopeNote xml:lang="en">A stone channel sunk into the ground, employed from the mid-19th century, to carry away gases produced during smelting.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143508">
    <skos:scopeNote xml:lang="en">The position of a fire in a wood-fuelled furnace. All periods from the Iron Age  to the 17th century.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87745">
    <skos:scopeNote xml:lang="en">An open area of water, usually artificial and enclosed by dock gates or locks, lined with wharves, warehouses and berths to enable vessels to load and unload.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69355">
    <skos:scopeNote xml:lang="en">Wooden or ferro-concrete tower for cooling waste, hot water from a power station. The water cascades from the top of the tower to a pond in the bottom.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92378">
    <skos:scopeNote xml:lang="en">An area within a hospital used for the isolation of patients. Patients were isolated if they had an infectious disease or suffered from a psychiatric illness.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/102732">
    <skos:scopeNote xml:lang="en">A building used for broadcasting radio programmes for public entertainment. Often includes recording studios, transmitters and offices. Use RADIO STATION for non-broadcasting uses eg. Military.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91994">
    <skos:scopeNote xml:lang="en">A room with special ventilation used for the slow drying of foodstuffs.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/83582">
    <skos:scopeNote xml:lang="en">Grinding mill for producing dyes and pigments from natural materials.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99580">
    <skos:scopeNote xml:lang="en">A factory engaged in the manufacture of small arms ammunition, especially the metal components and filling with the explosive propellant.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99596">
    <skos:scopeNote xml:lang="en">A purpose-built triangulation point used for the metrical survey of Britain carried out by the Ordnance Survey.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68563">
    <skos:scopeNote xml:lang="en">A kiln for drying hops in a brewery or maltings complex, as distinct from the OASTHOUSES found on farms.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70422">
    <skos:scopeNote xml:lang="en">A tall building, either round, square or polygonal in plan, used for a variety of purposes, including defence, as a landmark, for the hanging of bells, industrial functions, etc. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70170">
    <skos:scopeNote xml:lang="en">An abbey or priory of Dominican nuns.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91875">
    <skos:scopeNote xml:lang="en">A site used for the production of anaesthetic gas.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69963">
    <skos:scopeNote xml:lang="en">A monument consisting of parallel lines of banks, ditches, stones, timber posts or trees which appears to mark out an approach to another monument or monuments. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71495">
    <skos:scopeNote xml:lang="en">A pool of water, and ancillary buildings, designed to accommodate penguins.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93327">
    <skos:scopeNote xml:lang="en">The residence of a signalman.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68734">
    <skos:scopeNote xml:lang="en">The office or headquarters of a local police force, or of a police district.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143781">
    <skos:scopeNote xml:lang="en">A building housing a fan used for the ventilation of mines</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69930">
    <skos:scopeNote xml:lang="en">A site used for the sport of badger baiting using fighting dogs.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68877">
    <skos:scopeNote xml:lang="en">A fortified Roman site, usually under 1 hectare in area, strategically situated, housing small military patrols, often defended by a rampart, one or two ditches and a gate.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92653">
    <skos:scopeNote xml:lang="en">A building for miners to change their clothes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68934">
    <skos:scopeNote xml:lang="en">The official residence of a dean.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92945">
    <skos:scopeNote xml:lang="en">Large covered spaces where the steel plate used for ship construction was cut and marked out, prior to being craned onto the hull, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68686">
    <skos:scopeNote xml:lang="en">A signal station incorporating equipment for visually conveying coded communications.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/135315">
    <skos:scopeNote xml:lang="en">A law court builidng established during the 1970's accommodating offices and courtrooms fro the Crown and County Courts.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68983">
    <skos:scopeNote xml:lang="en">A small, defensive settlement, usually consisting of one dwelling and ancillary buildings, surrounded by a palisade.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140196">
    <skos:scopeNote xml:lang="en">A site where iron oxide and iron sulphate is extracted.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/125633">
    <skos:scopeNote xml:lang="en">A site used for the production of items derived from animal bones.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92055">
    <skos:scopeNote xml:lang="en">An educational establishment primarily for children aged 16-18 years old but can provide education for more mature students.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71511">
    <skos:scopeNote xml:lang="en">A small building housing a lavatory.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91193">
    <skos:scopeNote xml:lang="en">A building or buildings used for the manufacture of shoe and leather polish, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68952">
    <skos:scopeNote xml:lang="en">A tower or structure, with a powerful light or lights at the top, usually erected at an important or dangerous point on or near the sea-coast for the warning and guidance of mariners, but can also be erected inland for the guidance of travellers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94411">
    <skos:scopeNote xml:lang="en">A concrete structure designed to be the headquarters for the coordination of an airfield's defences. Constructed partially underground it was only intended to be occupied during an attack.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/111533">
    <skos:scopeNote xml:lang="en">A building housing an economizer, a machine designed to preheat water for boilers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71033">
    <skos:scopeNote xml:lang="en">A hole dug in the ground to act as a, usually temporary, communal toilet facility.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/151884">
    <skos:scopeNote xml:lang="en">A natural or man-made gap in vegetation or other combustible material that acts as a barrier to slow or stop the progress of a fire.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160224">
    <skos:scopeNote xml:lang="en">A centre used to train Air Raid Precautions wardens.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69975">
    <skos:scopeNote xml:lang="en">The principal church of a diocese in which the cathedra or bishop's throne is to be found.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93508">
    <skos:scopeNote xml:lang="en">A crane or hoist within a building found mainly in the North of England. Can also refer to a projecting crane located above a loading slot.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70224">
    <skos:scopeNote xml:lang="en">A movable bridge that swings or rotates around a central pier, or one that is pivoted only at one end, to provide a passageway for navigation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92321">
    <skos:scopeNote xml:lang="en">A crane whose winding mechanism was operated by hydraulic jiggers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160193">
    <skos:scopeNote xml:lang="en">An area of a carriageway, usually delimited by road markings, for the sole use of bicycles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91739">
    <skos:scopeNote xml:lang="en">The bottom of a dock.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71408">
    <skos:scopeNote xml:lang="en">A loft over a stable or barn used for storing hay.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92319">
    <skos:scopeNote xml:lang="en">A structure used for the production of hydraulic power. A head of water was raised at the top of the tower by means of pumps. Used for powering machinery.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69368">
    <skos:scopeNote xml:lang="en">Large piston used to operate lifting bridges, lock gates, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92932">
    <skos:scopeNote xml:lang="en">A type of waterwheel where the incoming supply of water leaves a launder near the top of the wheel, and drops onto the paddles or buckets of the wheel which rotates in the reverse direction to that of the incoming flow.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91784">
    <skos:scopeNote xml:lang="en">A factory producing drabbet, a type of linen cloth.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93635">
    <skos:scopeNote xml:lang="en">A free-standing building or a room used as a storage place for valuable objects.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69077">
    <skos:scopeNote xml:lang="en">A complex, comprising a workshop and a storage yard, used by a stonemason.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164137">
    <skos:scopeNote xml:lang="en">Structural elements (parts of hull etc.) or fixtures and fittings (masts, etc.) lost during a naval engagement without incurring the actual loss of a ship. May also be used as a monument type for expended ammunition (e.g. shells, cannonballs).</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/151874">
    <skos:scopeNote xml:lang="en">A residence of two or three monks of the Savigniac order dependent on a foreign mother house. The order was originally founded by monks in Savigny, Normandy, in 1105 and first established in Britain in 1123 at Tulket, Preston.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93771">
    <skos:scopeNote xml:lang="en">Sites, building, structures &amp; features associated with the supply &amp; drainage of water &amp; the disposal of sewage and waste water. Includes bodies of water, waterways &amp; associated ancillary structures.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159255">
    <skos:scopeNote xml:lang="en">A channel or pipe providing water to a canal or other body of water.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92096">
    <skos:scopeNote xml:lang="en">A machine producing mechanical power by the internal combustion of gas.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92794">
    <skos:scopeNote xml:lang="en">A building where onions are laid out to dry.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/147282">
    <skos:scopeNote xml:lang="en">Prefabricated small building that is designed and built to be movable rather than permanently located.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71402">
    <skos:scopeNote xml:lang="en">A covered arcade, often attached to a building, open on one or more sides.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78500">
    <skos:scopeNote xml:lang="en">A site where granite is excavated.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68909">
    <skos:scopeNote xml:lang="en">A covered trench, often in a zig zag form, made for the purpose of approaching a beseiged place under fire of the garrison.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93662">
    <skos:scopeNote xml:lang="en">Seats or benches covered in turf, built against a wall, tree or fountain,  were a common feature of medieval enclosed gardens.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69371">
    <skos:scopeNote xml:lang="en">A pumping station used in the production of hydraulic power, eg. in warehouse complexes, goods depots on railways, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93671">
    <skos:scopeNote xml:lang="en">A mill in which strands of yarn are twisted together to produce a strong thread with a uniform thickness.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/146436">
    <skos:scopeNote xml:lang="en">A shaft cut to facilitate the extraction of salt from halite deposits by pumping water into the deposit and pumping out brine from which the salt is later extracted.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/169857">
    <skos:scopeNote xml:lang="en">Smoke generators (also known as smoke pots) were used to create a smoke screen to provide defensive cover for strategic targets</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/144484">
    <skos:scopeNote xml:lang="en">A pit used to bury a large number of people who have died, or been killed, either as a result of warfare, epidemics or natural disasters.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/145101">
    <skos:scopeNote xml:lang="en">A ditch which is not continuous but instead is made up of segments which may vary in length and width.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92856">
    <skos:scopeNote xml:lang="en">A school serving or supported by a parish. Usually teaching religious as well as conventional education.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160217">
    <skos:scopeNote xml:lang="en">A building used as a control centre for the Air Raid Precautions network, responsible for issuing air raid warnings and coordinating fire and rescue services.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70321">
    <skos:scopeNote xml:lang="en">A painting executed directly onto a wall.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/76937">
    <skos:scopeNote xml:lang="en">A building used to house calves.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91213">
    <skos:scopeNote xml:lang="en">Place for people who underwent regular blood letting.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70467">
    <skos:scopeNote xml:lang="en">A dam constructed on the reaches of a canal or river designed to retain the water and to regulate its flow.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91849">
    <skos:scopeNote xml:lang="en">The residence and office of an ambassador.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93745">
    <skos:scopeNote xml:lang="en">Non-pavilion type of attached ward block.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91513">
    <skos:scopeNote xml:lang="en">The residence of a clothier.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68673">
    <skos:scopeNote xml:lang="en">A device used to trap or kill animals considered to be pests, eg. rats.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91384">
    <skos:scopeNote xml:lang="en">A hospital department, open 24 hours a day, for the immediate reception and treatment of emergency cases.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92292">
    <skos:scopeNote xml:lang="en">A specialist hospital for the medical and surgical treatment of urinary disorders and diseases.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94205">
    <skos:scopeNote xml:lang="en">A specialized form of truss bridge that extends or cantilevers from both sides of the pier, the inner 'arms' usually supporting a central span.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/103572">
    <skos:scopeNote xml:lang="en">A stone, slate, iron or wooden structure used to mark the site of a grave. Use only where evidence of the form is uncertain otherwise use more specific type.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93800">
    <skos:scopeNote xml:lang="en">A circle made out of stones, which is used for making wheels.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162648">
    <skos:scopeNote xml:lang="en">A reinforced concrete structure, usually sited underground,  intended to be used by the regional government as an air raid shelter in the event of a nuclear attack.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140295">
    <skos:scopeNote xml:lang="en">A building housing machinery for crushing chalk for whiting. Whiting was used in toothpaste, paint, tablets, putty and other products.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68578">
    <skos:scopeNote xml:lang="en">A press used to extract the juice from apples, which was then used to make cider.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91674">
    <skos:scopeNote xml:lang="en">A house with a range at the end of it, at right angles to the main range.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71419">
    <skos:scopeNote xml:lang="en">A room or part of a church where the vestments, vessels and records are kept.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160260">
    <skos:scopeNote xml:lang="en">A watch office with additional rooms given over to the meteorological section, including a forecast room and met store.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69104">
    <skos:scopeNote xml:lang="en">A site where coal is processed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91947">
    <skos:scopeNote xml:lang="en">A series of steps designed to enable fish to ascend a fall of water or a dam.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70998">
    <skos:scopeNote xml:lang="en">A building, usually containing several dormitories, used as a cheap, short term residence. Use more specific term if known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143014">
    <skos:scopeNote xml:lang="en">Factory or workshop making bits, spurs and other small metal objects associated with horse harness.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91165">
    <skos:scopeNote xml:lang="en">A portable beehive, often made of straw.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162727">
    <skos:scopeNote xml:lang="en">A factory built for the production of breakfast cereals.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87455">
    <skos:scopeNote xml:lang="en">An area of a port, dock or harbour where cargo vessels can load and unload large storage containers. May include a rail terminal for containers which have been transported to the port by rail.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69431">
    <skos:scopeNote xml:lang="en">A place where tobacco is made into cigarettes, cigars, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/103392">
    <skos:scopeNote xml:lang="en">A residence for a member of a religious community eg. Abbot, Prior, Manciple etc. For multiple occupancy use more specific term eg. DORMITORY.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/90949">
    <skos:scopeNote xml:lang="en">A building or buildings where explosives are manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141975">
    <skos:scopeNote xml:lang="en">A site, usually including fuel tanks, pipe works and control buildings, where flaming petroleum was intended to be used as a weapon against a hostile invasion.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159152">
    <skos:scopeNote xml:lang="en">An earthwork feature used by hunters to trap deer comprising a steep ditch into which the deer are chased with an enclosure to hold them at one end, known from the Isle of Rum and a debateable example in Cumbria.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/136910">
    <skos:scopeNote xml:lang="en">A recreation ground with usually permanent structure. It usually contains rides such as ghost trains, helter skelter and roller coasters.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93103">
    <skos:scopeNote xml:lang="en">A building where official archives are kept for public inspection.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143423">
    <skos:scopeNote xml:lang="en">School built by the local Education Authority to provide residental schooling at the seaside for children from urban communities.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162629">
    <skos:scopeNote xml:lang="en">A farmstead where the buildings and yards are loosely arranged, with no focal yard. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93673">
    <skos:scopeNote xml:lang="en">A tunnel carrying a railway beneath the surface of the ground.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69981">
    <skos:scopeNote xml:lang="en">A church attached to or founded by a college.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70936">
    <skos:scopeNote xml:lang="en">A large, level structure, usually of stone or timber, built alongside water to allow warships to moor for the loading and unloading of guns.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92464">
    <skos:scopeNote xml:lang="en">Buildings or sites used in the preparation, treatment and working of raw animal hide into leather products such as gloves or saddles, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/152384">
    <skos:scopeNote xml:lang="en">A frame containing glass tiles or bricks set into a pavement to allow the lighting of basement areas.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68566">
    <skos:scopeNote xml:lang="en">A building with malt kilns for the malting of grains and with other similar equipment for brewing work.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140201">
    <skos:scopeNote xml:lang="en">A curved military aircraft hangar produced in 1939. The frame is steel which is then clad with steel sheeting and reinforced concrete and typically covered with a thin layer of concrete, earth and turf.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140518">
    <skos:scopeNote xml:lang="en">A hexagonal pillbox, with an internal anti-ricochet wall and loopholes for fives light machine guns and one rifle. Originally designed to have 15in bulletproof walls many were built with 42in thick shellproof walls. Designed by DFW branch 3.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91453">
    <skos:scopeNote xml:lang="en">Building used for children to play in.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93378">
    <skos:scopeNote xml:lang="en">A hospital providing medical, surgical or psychiatric testing and treatment for patients with specific illnesses or injuries.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93455">
    <skos:scopeNote xml:lang="en">A building used, as a meeting place and administration block, by an organization run for the benefit of students at a school, college or university.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69123">
    <skos:scopeNote xml:lang="en">A room or small building kept at low temperatures for the storage of perishable items, particularly food.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93443">
    <skos:scopeNote xml:lang="en">A table made of stone, found in streets, parks, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71054">
    <skos:scopeNote xml:lang="en">A prison used for temporary detention. The typical village lock-up was a one-storeyed, one-celled building, sometimes of round or polygonal plan.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69046">
    <skos:scopeNote xml:lang="en">Trees planted in an ornamental circle. For earthwork surrounding trees use TREE ENCLOSURE RING.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70383">
    <skos:scopeNote xml:lang="en">Use only for natural features mistakenly assumed to be archaeological or natural features with archaeological significance.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91278">
    <skos:scopeNote xml:lang="en">A building in which newly made bricks are laid out to dry.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143436">
    <skos:scopeNote xml:lang="en">An industrial building, plant or site where crude substances, such as sugar, metal, oil etc., are purified or refined.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160238">
    <skos:scopeNote xml:lang="en">A brick-built building with four windows on the north-facing wall with a pitched roof and with a dormer roof light on both sides, intended for drying, storing and packing parachutes.The 2355/25 was the first design for a purpose-built parachute store.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91402">
    <skos:scopeNote xml:lang="en">A long metal or stone vessel for cattle to drink water from.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91258">
    <skos:scopeNote xml:lang="en">A site, usually consisting of a bowling green and pavilion, frequented by lawn bowlers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70425">
    <skos:scopeNote xml:lang="en">An area of common grassland in a village used for grazing cattle, recreational purposes, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92776">
    <skos:scopeNote xml:lang="en">A centre where treatment and rehabilitation training is given to patients recovering from injuries or accidents.</skos:scopeNote>
  </rdf:Description>
