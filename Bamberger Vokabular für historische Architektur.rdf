    <!-- https://hist-arch-vocab.org/bvha#c_760c8dff -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_760c8dff">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b8ea47ea"/>
