    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1856> ;
    skos:scopeNote "Stores for the purchase or sale of old and / or used items."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1978> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/158> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Shoemaker shops"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1084> ;
    skos:scopeNote "<br />Workshops for the manufacture and/or the repair of shoes."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/198> a skos:Concept ;
