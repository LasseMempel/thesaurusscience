	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk007712">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Haarnetz</skos:prefLabel>
		<skos:altLabel xml:lang="de">Haarnetze</skos:altLabel>
		<skos:prefLabel xml:lang="en">hairnet</skos:prefLabel>
		<skos:altLabel xml:lang="en">hairnets</skos:altLabel>
