    <!-- https://hist-arch-vocab.org/bvha#c_04c5cbf5 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_04c5cbf5">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_cc7a1644"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T17:22:10.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-01T18:57:06.000</terms:modified>
        <skos:altLabel xml:lang="en">bundle pier</skos:altLabel>
        <skos:altLabel xml:lang="es">pilar de haz</skos:altLabel>
        <skos:definition xml:lang="de">Bündelpfeiler, ein Pfeiler, der rundum mit Diensten von größerem und geringerem Durchmesser, sog. alte und junge Dienste, besetzt ist; in der 1. Hälfte des 13. Jhs. aus dem Gliederpfeiler entwickelt und in der Gotik weitverbreitet; teilweise ist der Pfeilerkern nicht mehr sichtbar. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Ein Pfeiler mit eingebundenen Diensten, zusammenfassend auch Pfeilervorlagen genannt. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="cs">Svazkové pilíře mají kolem sebe seskupeny různě silné, zaoblené nebo žlábkované plné sloupy, polosloupy nebo tříčtvrteční sloupy, které pokračují do klenby nebo arkád jako žebra nebo klenební pasy a podle svého menšího nebo většího průřezu se nazývají buď vedlejší přípory nebo hlavní přípory. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Bündelpfeiler</skos:prefLabel>
        <skos:prefLabel xml:lang="en">compound pier</skos:prefLabel>
        <skos:prefLabel xml:lang="es">pilar de nervios</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">pilier en faisceau</skos:prefLabel>
        <skos:prefLabel xml:lang="it">piliere</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">svazkový pilíř</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_cc7a1644"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_04d1b67c -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_04d1b67c">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0e17492b"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_473bbc7d"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-01T11:02:56.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T19:25:12.000</terms:modified>
        <skos:altLabel xml:lang="de">Brunnengründungen</skos:altLabel>
        <skos:definition xml:lang="de">Neben den Grundpfeilern eine weitere Gründungsart, Fundamente auf den tiefliegenden Baugrund zu führen. Die Herstellung erfolgte durch Hohlzylinder aus Mauerwerk, Beton, Stahlbeton und in selteneren Fällen auch aus Stahl oder Holz. Diese wurden durch Ausheben des Bodens im Inneren bis auf tragfähigen Baugrund versenkt und dann verfüllt. Die am häufigsten ausgeführte Grundrissform des Brunnenkranzes war der Kreis, da hier der Umfang im Verhältnis zur umschlossenen Fläche und damit auch der Reibungswiderstand am geringsten ist. Um ein leichtes Absenken des Brunnenkranzes zu gewährleisten, wurden die Wände meist auf ganzer Höhe oder nur im unteren Teil nach oben hin verjüngt. [Bargmann]</skos:definition>
        <skos:prefLabel xml:lang="de">Senkbrunnen</skos:prefLabel>
        <broaderByConstruction rdf:resource="https://hist-arch-vocab.org/bvha#c_473bbc7d"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_04d502d8 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_04d502d8">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f4e2bee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_7a0c6f8a"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T20:03:17.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-24T07:42:24.000</terms:modified>
        <skos:altLabel xml:lang="fr"> comble pyramidal</skos:altLabel>
        <skos:altLabel xml:lang="fr"> toit pyramidal</skos:altLabel>
        <skos:altLabel xml:lang="de">Dachpyramide</skos:altLabel>
        <skos:altLabel xml:lang="de">Zeltdach</skos:altLabel>
        <skos:altLabel xml:lang="en">pyramid roof</skos:altLabel>
        <skos:altLabel xml:lang="cs">pyramidová střecha</skos:altLabel>
        <skos:definition xml:lang="cs">Jehlanový tvar, všechny valbové plochy se stýkají v jednom vrcholovém bodu, půdorys je čtvercový, obdélníkový, polygonální, při velké výšce ve vztahu k délce okapu se nazývá jehlanová střecha. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Pyramidendach, die allseitigen Walmflächen treffen sich in einem Firstpunkt; quadratischer, rechteckiger, vieleckiger Grundriss. Bei großer Höhe im Verhältnis zur Traufenlänge heißt es Turmdach. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Pyramidendach, über vieleckigem oder quadrat. Grundriss errichtetes, allseitig abgewalmtes Dach, dessen Flächen zu einer Spitze anstelle des Firsts zusammenlaufen. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="it"> tetto a piramide</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Pyramidendach</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">comble en pavillon</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">stanová střecha</skos:prefLabel>
        <skos:prefLabel xml:lang="es">techo piramidal</skos:prefLabel>
        <skos:prefLabel xml:lang="en">tent roof</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Pyramidendach, Zeltdach, Dach in Pyramidenform. [Koepf / Binding 2016]</skos:scopeNote>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_f4e2bee8"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_04d8687e -->


