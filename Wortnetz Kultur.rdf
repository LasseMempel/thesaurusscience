	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk007299">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Schütte (Schublade)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Schütten (Schubladen)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk007264"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013708"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk007264"/>
		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk007249"/>
		<skos:definition xml:lang="de">Eine Schütte ist eine kleine Schublade zur Aufbewahrung loser Vorräte, die geschüttet werden können, wie Mehl, Zucker oder Kaffee. Sie ist typischerweise aus Glas, Aluminium oder Keramik, besitzt einen Griff, häufig auch eine Beschriftung und war besonders als Bestandteil von Küchenschränken ab den 1920er Jahren in Gebrauch.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk013708"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk007264"/>
