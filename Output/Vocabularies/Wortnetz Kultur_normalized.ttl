        "episcope"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk018441>,
        <http://lvr.vocnet.org/wnk/wk018442> ;
    skos:definition "Ein Episkop ist ein Projektor, der undurchsichtige, meist flache Vorlagen wie Buchseiten, Zeichnungen, Postkarten oder Bilder projiziert, indem er diese von oben mit sehr hellem Licht beleuchtet und das diffus reflektierte Licht über einen Spiegel und ein Objektiv auf eine Oberfläche überträgt."@de ;
    skos:exactMatch <http://d-nb.info/gnd/1028332122>,
        <http://vocab.getty.edu/aat/300193182>,
        <http://www.wikidata.org/entity/Q520676> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Episkop"@de,
        "opaque projector"@en .

