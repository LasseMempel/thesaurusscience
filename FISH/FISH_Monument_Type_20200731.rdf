    <skos:scopeNote xml:lang="en">A pit in the ground from where minerals are dug.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92089">
    <skos:scopeNote xml:lang="en">A village laid out systematically with spacious and garden-like surroundings.</skos:scopeNote>
  </rdf:Description>
