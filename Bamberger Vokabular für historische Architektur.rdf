        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-04T11:10:30.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-12-01T11:14:03.000</terms:modified>
        <skos:altLabel xml:lang="cs">kvádrové zdivo</skos:altLabel>
        <skos:altLabel xml:lang="es">mampostería d. sillares</skos:altLabel>
        <skos:altLabel xml:lang="cs">zdivo z tesaného kamene</skos:altLabel>
        <skos:definition xml:lang="de">Ein aus Werksteinen (Quadersteinen) bestehendes Mauerwerk. [Koepf / Binding 2016]</skos:definition>
