        <skos:altLabel xml:lang="la">pallium mortuorum</skos:altLabel>
        <skos:altLabel xml:lang="fr">poêle</skos:altLabel>
        <skos:definition xml:lang="de">Bahrtuch n, Tumbatuch n, auch Leichentuch n, veraltet Funeraltuch n, Pallium funerale, pallium mortuorum: mit einem weißen Kreuz bezeichnetes schwarzes oder violettes Tuch, das während der Exequien den Sarg oder die Tumba bedeckt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Sargtuch</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">drap funéraire</skos:prefLabel>
        <skos:prefLabel xml:lang="la">pannus mortuarius</skos:prefLabel>
    </owl:NamedIndividual>
    


