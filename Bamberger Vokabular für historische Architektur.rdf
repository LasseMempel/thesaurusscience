    <!-- https://hist-arch-vocab.org/bvha#c_0959d03c -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_0959d03c">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_46483b7b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_3baf11f2"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-11T12:28:22.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-13T14:10:38.000</terms:modified>
        <skos:altLabel xml:lang="cs">Antonínův kříž</skos:altLabel>
        <skos:altLabel xml:lang="de">Taukreuz</skos:altLabel>
        <skos:altLabel xml:lang="it">croce a tau</skos:altLabel>
        <skos:altLabel xml:lang="es">cruz de tau</skos:altLabel>
        <skos:altLabel xml:lang="cs">egyptský kříž</skos:altLabel>
        <skos:altLabel xml:lang="cs">tau</skos:altLabel>
        <skos:altLabel xml:lang="en">twisted rope cross</skos:altLabel>
        <skos:definition xml:lang="de">Antoniuskreuz, Taukreuz, Ägyptisches Kreuz, crux commissa; Kreuzform in Gestalt eines T (des gr. Tau), benannt nach dem Einsiedler Antonius, der in Ägypten lebte und einen so geformten Stock getragen haben soll. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Antonínský, egyptský kříž (crux commissa),  často pro lotry po levici a po pravici. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">T-Kreuz, T-förmiges Kreuz mit abschließendem oberen Querbalken. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Tau-, Antonius-Kreuz (crux commissa), oft für die Schächer. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">symbol pro střed světa [Šefců 2013]</skos:definition>
        <skos:prefLabel xml:lang="de">Antoniuskreuz</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Saint Anthony\&apos;s cross</skos:prefLabel>
