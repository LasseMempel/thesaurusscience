	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/501006">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/501006</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">GOC SIMILEIR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Rud siolandrach, ioma-cheàrnach no ceàrnagach a chaidh a shocrachadh air ceann staca simileir gus an luidhear a dhèanamh nas fhaide airson 's gum falbhadh ceò 's gas às nas fhearr. Gu tric de chriadh-theine dearg no buidhe.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CHIMNEY CAN</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-02-20T10:20:47</dcterms:created>
