    skos:broader <http://www.eionet.europa.eu/gemet/concept/2562> ;
    skos:definition "Resultant of natural or manmade perturbations of the physical, chemical or biological components making up the environment."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/3139> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Wirkung auf die Umwelt"@de,
        "effect on the environment"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/4159> .

