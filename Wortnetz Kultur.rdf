	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk000348">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Alabaster (Mineral)</skos:prefLabel>
		<skos:prefLabel xml:lang="en">alabaster (mineral)</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000347"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010567"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019436"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019456"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000347"/>
		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk004565"/>
		<xe:explanation_temp xml:lang="de">Alabaster wird ebenso in der Bildhauerei wie auch zur Herstellung von kleineren Kunstgegenständen verwendet, ist aber wegen seiner geringen Wetterfestigkeit nur für Objekte in Innenräumen geeignet.</xe:explanation_temp>
		<skos:definition xml:lang="de">Alabaster ist ein Gips, der sich von anderen Gipsspaten durch seine veränderte mikrokristalline Struktur unterscheidet, da er Anteile von Kristallwasser enthält.</skos:definition>
		<skos:scopeNote xml:lang="de">Benutzt für Alabaster als Varietät des Gipsspates; für die als ägyptischer Alabaster bezeichnete Varietät des Calcits siehe Kalksinter (wk004565).</skos:scopeNote>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4141793-8"/>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300011101"/>
