		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/439" />
		<skos:scopeNote xml:lang="en">The improved land surrounding a Scottish country house.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
