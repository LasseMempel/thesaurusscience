    <!-- https://hist-arch-vocab.org/bvha#c_f42ecd51 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_f42ecd51">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_9b659a9d"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-21T10:52:22.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-21T18:35:38.000</terms:modified>
        <skos:altLabel xml:lang="cs">hypostyl</skos:altLabel>
        <skos:altLabel xml:lang="en">hypostyle hall</skos:altLabel>
        <skos:altLabel xml:lang="cs">sloupová síň</skos:altLabel>
        <skos:definition xml:lang="de">Ein Saal, dessen Decke von Säulen getragen wird. Bekannte S.e sind die Apadana der pers. Königspaläste (Hunderts.), die Quersäle ägypt. Tempel und der S.moscheen (Hypostyl). Eine Sonderform des S.s ist der ägypt. Saal, ein dreischiffiger s. der hellenist. Baukunst mit basilikal erhöhtem Mittelschiff. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Säulensaal</skos:prefLabel>
        <skos:prefLabel xml:lang="en">columned hall</skos:prefLabel>
        <skos:prefLabel xml:lang="it">sala ipostila</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">salle à colonnes</skos:prefLabel>
        <skos:prefLabel xml:lang="es">salón con columnas</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">sloupový sál</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_f44143f9 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_f44143f9">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
