        <cc:attributionURL rdf:resource="https://historicengland.org.uk/"/>
        <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
        <dc:publisher rdf:resource="https://historicengland.org.uk/"/>
        <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
        <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
        <skos:prefLabel xml:lang="en">Regency</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The period between 1811 and 1820, following the relapse of George III, when his son George, Prince of Wales, was appointed Prince Regent to discharge royal functions.</skos:scopeNote>
        <skos:notation xml:lang="en">REG</skos:notation>
      </skos:Concept>
