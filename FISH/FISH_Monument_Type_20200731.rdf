  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164133">
    <skos:scopeNote xml:lang="en">Site where steel is produced from molten pig iron using a Bessemer Converter, a development from the cementation and crucible steel-making techniques .</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140126">
    <skos:scopeNote xml:lang="en">A slaughterhouse for horses.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91178">
    <skos:scopeNote xml:lang="en">A vault shaped trellis on which climbing plants are trained.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91068">
    <skos:scopeNote xml:lang="en">An educational establishment where the art and theory of building and construction is taught.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170049">
    <skos:scopeNote xml:lang="en">A building where artefacts, scientific specimens, antiquities and similar objects of interest could be examined through microscopes by members of the public.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160377">
    <skos:scopeNote xml:lang="en">A building, on an airfield, used to house a fire engine designed to Air Ministry drawing number 12563/40.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93071">
    <skos:scopeNote xml:lang="en">A large dish-like structure designed to observe the invisible outerspace phenomena detected by radio waves, eg. Jodrell Bank.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92286">
    <skos:scopeNote xml:lang="en">A hospital building of uncertain function. Use more specific type if known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/103472">
    <skos:scopeNote xml:lang="en">A building, site or structure associated with the playing of racket sports.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93599">
    <skos:scopeNote xml:lang="en">A bridge which takes a towing path over a branch canal, basin, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140508">
    <skos:scopeNote xml:lang="en">A pillbox built to a design drawn up by the chief engineer of GHQ home forces.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93847">
    <skos:scopeNote xml:lang="en">A workshop in which carded wool was passed through heated combs to straighten and separate the long and short fibres prior to spinning. Associated with the worsted branch of the textile industry.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70138">
    <skos:scopeNote xml:lang="en">A priory of double order of Fontevrault nuns and brethren.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/122518">
    <skos:scopeNote xml:lang="en">A bridge manufactured from prefabricated sections.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87808">
    <skos:scopeNote xml:lang="en">A factory or site for the manufacture of food stuffs from raw ingredients.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140375">
    <skos:scopeNote xml:lang="en">A military side-opening aircraft hangar originally designed for seaplanes and used RNAS bases from 1916. Steel framed with asbestos or corrugated iron cladding.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92258">
    <skos:scopeNote xml:lang="en">A commercial building used primarily as a trading place for breweries and hop merchants.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/139023">
    <skos:scopeNote xml:lang="en">An alignment of posts or postholes of unknown function</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68885">
    <skos:scopeNote xml:lang="en">A building used for the accommodation of a military guard and/or the detainment of prisoners.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164382">
    <skos:scopeNote xml:lang="en">A factory used to manufacture fibreglass.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70399">
    <skos:scopeNote xml:lang="en">A single line, or pair of roughly parallel lines, of pits set at intervals along a common axis or series of axes. The pits are not thought to have held posts.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/147334">
    <skos:scopeNote xml:lang="en">A distinctive form of terrace found in the northeast consisting of a long, two storey terrace indistinguishable from a conventional house externally, save that each unit has two front doors, one leading to a separate dwelling or dwellings upstairs.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91953">
    <skos:scopeNote xml:lang="en">A purpose-built fisherman's house, eg. a house with a first floor dwelling and ground floor fish store, or a house with a watch tower for spotting shoals.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/90214">
    <skos:scopeNote xml:lang="en">An administrative building used by the official in charge of a dock or harbour.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68642">
    <skos:scopeNote xml:lang="en">A piece of land used for the cultivation of hops.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91859">
    <skos:scopeNote xml:lang="en">A jettied house where the upper storey only overhangs the end elevation of the building.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140466">
    <skos:scopeNote xml:lang="en">A device on an airfield for securing aircrafts when parked outside in order to prevent major movement due to the weather or other conditions.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92216">
    <skos:scopeNote xml:lang="en">A type of carriage house, usually in a churchyard, for storing a hearse.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91093">
    <skos:scopeNote xml:lang="en">A running track used for athletic practice and competition.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71405">
    <skos:scopeNote xml:lang="en">A small body of water, either natural or artificial.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142075">
    <skos:scopeNote xml:lang="en">An area of privately owned land attached to, and incorporating, a country house and associated buildings.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68778">
    <skos:scopeNote xml:lang="en">A building for the weighing or testing of metals, eg. at a mine site.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69458">
    <skos:scopeNote xml:lang="en">A platform, sometimes floating, for the landing of passengers and goods from vessels.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69142">
    <skos:scopeNote xml:lang="en">A site, often in a woodland clearing, used for the production of pure carbon by the controlled burning of wood and other organic materials.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/97271">
    <skos:scopeNote xml:lang="en">A military building from which the guns of a battery were directed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69198">
    <skos:scopeNote xml:lang="en">A pit lined with the bony cores of animal horns. Thought to date from the 17th/18th centuries and believed to have been used in the tanning industry although some may have been used for casting cannon.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94018">
    <skos:scopeNote xml:lang="en">A long, narrow, irregularly constructed and generally unstructured mound of stones. Normally a by-product of field clearance for agricultural purposes, though prehistoric examples may include burials and other deposits.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93612">
    <skos:scopeNote xml:lang="en">A building for the housing of trams.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69986">
    <skos:scopeNote xml:lang="en">A communal residence of secular priests and/or other clerics sometimes with the condition of learning and education attached.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143810">
    <skos:scopeNote xml:lang="en">Plant for the processing of uranium ores, such as pitchblende. Uranium is the principal extract, but radium may also be recovered as a by-product</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92373">
    <skos:scopeNote xml:lang="en">A type of calcining kiln used in the processing of iron ore.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94023">
    <skos:scopeNote xml:lang="en">A subsidiary enclosure externally attached to an enclosure of known or unknown date and function. The annexe is generally smaller than, and secondary to, the main enclosure. Use more specific site type where known. Do not use for Roman military sites.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69342">
    <skos:scopeNote xml:lang="en">A water channel leading from a water wheel.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/129049">
    <skos:scopeNote xml:lang="en">A workshop forming part of a domestic dwelling.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68822">
    <skos:scopeNote xml:lang="en">A flanking tower, or projection from the main walls of a defensive work from which a garrison can defend the ground in front or on the flank.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68572">
    <skos:scopeNote xml:lang="en">A mill which contains machinery for separating grain from the chaff.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69996">
    <skos:scopeNote xml:lang="en">A stone, either in situ or part of a monument, bearing one or more small, roughly hemispherical depressions, generally created by chipping or pecking.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71580">
    <skos:scopeNote xml:lang="en">A communal residence of secular vicars whose duties included the education of choristers attached to cathedrals and collegiate churches.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68904">
    <skos:scopeNote xml:lang="en">A building or site incorporating equipment used for detecting the presence of enemy aircraft or ships. Radar Stations can also be used to aid aircraft navigation in dark or poor conditions.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93870">
    <skos:scopeNote xml:lang="en">A building containing machinery for the spinning of yarn.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92030">
    <skos:scopeNote xml:lang="en">A school where no fees were charged.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92466">
    <skos:scopeNote xml:lang="en">A large building used for the storage of leather goods or processed animal skins.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/135016">
    <skos:scopeNote xml:lang="en">A racing track, often within a permanent stadium, for racing dogs, usually greyhounds and whippets.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140488">
    <skos:scopeNote xml:lang="en">An aircraft hangar designed by T. Bedford Consulting Engineers usually erected on aircraft factory sites rather than operational airfields.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70282">
    <skos:scopeNote xml:lang="en">A gate on a toll road where travellers had to pay a toll to the toll-keeper.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70364">
    <skos:scopeNote xml:lang="en">A monument consisting of an area of land enclosed by a ditch, bank, wall, palisade or similar barrier, where the barrier consists of several straight or near straight sections.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141457">
    <skos:scopeNote xml:lang="en">A prefrabicated home sited in parks where a pitch fee is charged. Although technically mobile they usually only make one journey before being permanently installed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68874">
    <skos:scopeNote xml:lang="en">A usually permanent defensive work. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68728">
    <skos:scopeNote xml:lang="en">A place where people were put to death. Use narrower monument type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71386">
    <skos:scopeNote xml:lang="en">A row of balusters, usually made of stone, surmounted by a rail or coping.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/119473">
    <skos:scopeNote xml:lang="en">An institute provided by a regiment for the improvement of the soldiers and to reduce excessive drinking.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140185">
    <skos:scopeNote xml:lang="en">A place where dead animals are buried.</skos:scopeNote>
  </rdf:Description>
