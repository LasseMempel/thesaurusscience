    <!-- https://hist-arch-vocab.org/bvha#c_d4b6b8df -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_d4b6b8df">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0e26a85b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_19d56a39"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-14T10:31:08.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T14:07:12.000</terms:modified>
        <skos:altLabel xml:lang="cs">hmoždinka</skos:altLabel>
        <skos:definition xml:lang="de">Zur Positionssicherung bei schichtweise übereinandergelegten Hölzern oder Bohlen werden Dollen eingesetzt. Ihre Form ist weitgehend der Rundung des Bohrloches angepasst, um einen möglichst geringen Schub auf die zum Teil schmalen Seitenstege auszuüben. Einsatzzapfen verbinden wie Dollen zwei übereinandergelegte Hölzer. Sie können mit Holznägeln gesichert sein. (Eißing et al. 2012) </skos:definition>
        <skos:prefLabel xml:lang="de">Dollen</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">trn</skos:prefLabel>
    </owl:NamedIndividual>
    


