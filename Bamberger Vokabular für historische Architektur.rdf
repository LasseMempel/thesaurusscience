    <!-- https://hist-arch-vocab.org/bvha#c_07c17db8 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_07c17db8">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
