        <skos:prefLabel xml:lang="fr">alléluiarium</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_9a164150 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_9a164150">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0ea453f7"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_0e7ca4ab"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-28T14:48:15.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T15:08:21.000</terms:modified>
        <skos:altLabel xml:lang="de">Kollegienkirche</skos:altLabel>
        <skos:definition xml:lang="de">Kirche eines Kollegiums, einer Klerikergemeinschaft, die sich auf wenigen Stiftspfründen neben der Seelsorge bes. der Ausbildung des Klerikernachwuchses widmete. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Kostel duchovní instituce, jejíž příslušníci jsou světští duchovní (nikoliv řeholníci) a společně tvoří kolegiátní kapitulu. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Kollegiatkirche</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kolegiátní kostel</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_0ea453f7"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_9a1f4fb2 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_9a1f4fb2">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_6bbfbe49"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-14T10:14:52.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T13:14:31.000</terms:modified>
        <skos:definition xml:lang="de">Mauerwerk, Raumauerwerk aus unbearbeiteten oder zersprengten Feldsteinen oder Kieselsteinen, beim Dorfkirchen- und Stadtmauerbau angewandt, meist in Schalenbauweise mit Mörtelbindung; zum Abgleichen von Feldsteinmauerschichten konnten Backsteine dienen, daraus auch Friese, Gesimse, Fenster- und Portaleinfassungen. Die frühesten Kirchen aus dem 8./9. Jh. in Holstein, Niederrhein, Schweiz, Bodensee und Oberitalien. Die große Masse der nordeurop. F.ten gehört dem 12. und 13. Jh. an, vereinzelt im 14./15. Jh„ dann wieder in der 2. Hälfte des 18. Jhs. Im Profanbau für Wehrbauten, Burgen und Gartenmauern durch alle Jahrhunderte seit röm. Zeit. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Feldsteinbau</skos:prefLabel>
        <broaderByConstructionMaterial rdf:resource="https://hist-arch-vocab.org/bvha#c_6bbfbe49"/>
    </owl:NamedIndividual>
    


