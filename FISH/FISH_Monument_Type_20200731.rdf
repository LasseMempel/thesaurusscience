    <skos:scopeNote xml:lang="en">The residence and office of a chaplain.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160501">
    <skos:scopeNote xml:lang="en">A structure, based on drawing number (3329/41), intended to be the headquarters for the coordination of an airfield's defences. Constructed above ground this design was found to be vulnerable and was superceded by the (11008/41).</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92900">
