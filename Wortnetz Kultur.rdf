	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk002625">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">cyclopean  masonry</skos:prefLabel>
		<skos:altLabel xml:lang="de">Polygonalmauerwerk</skos:altLabel>
		<skos:prefLabel xml:lang="de">Zyklopenmauerwerk</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk002624"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010555"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019935"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk002624"/>
		<skos:definition xml:lang="de">Zyklopenmauerwerk ist ein Hausteinmauerwerk, bei dem große Steine lediglich an den Kanten bearbeitet werden, um die Steine einander anzupassen, wobei waagerechte Lagerfugen und durchgehende Schichthöhen nicht die Regel sind.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002624"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010555"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019935"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-11-08T16:50:46+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk002626">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">ashlar masonry</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Quadermauerwerk</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk002319"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010555"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019935"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk002319"/>
		<skos:definition xml:lang="de">Quadermauerwerk ist ein Mauerwerk, das aus steinmetzmäßig bearbeiteten Steinquadern besteht, sodass es durchgehende waagerechte Lagerfugen und senkrechte Stoßfugen gibt.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002319"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010555"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019935"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002627"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002628"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002629"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-11-08T16:50:46+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk002627">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Bossenmauerwerk</skos:altLabel>
		<skos:prefLabel xml:lang="de">Buckelquadermauerwerk</skos:prefLabel>
		<skos:prefLabel xml:lang="en">rustication (architecture)</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk002626"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010555"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019935"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk002626"/>
		<xe:explanation_temp xml:lang="de">Ab etwa 1250 wird Buckelquadermauerwerk nicht mehr verwendet. Das ähnlich aussehende nachmittelalterliche Buckelquadermauerwerk wird als Rustikamauerwerk bezeichnet.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Buckelquadermauerwerk ist ein Quadermauerwerk, bei dem auf der Ansichtsseite der kaum bearbeitete Spiegel vor den geglätteten und geebneten Rand des Quaders tritt.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002626"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010555"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019935"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003195"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-11-08T16:50:46+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk002628">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">rusticated masonry</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Rustikamauerwerk</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk002626"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010555"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019935"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk002626"/>
		<skos:definition xml:lang="de">Rustikamauerwerk ist ein Quadermauerwerk, bei dem auf der Ansichtsseite der kaum bearbeitete Spiegel vor den geglätteten und geebneten Rand des Quaders tritt.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002626"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010555"/>
