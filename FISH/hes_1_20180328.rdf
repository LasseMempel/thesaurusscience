		<skos:prefLabel xml:lang="gd">FACTARAIDH SHEÒL</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach no làrach far a bheilear a' dèanamh siùil bàta de dh'aodach giullaichte.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SAILMAKING WORKS</skos:prefLabel>
