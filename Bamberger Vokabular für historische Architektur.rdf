        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-11-04T18:55:36.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T18:44:45.000</terms:modified>
        <skos:definition xml:lang="de">Türstiel: nicht geschosshohes, eine Wandöffnung einfassendes vertikales Holz. [Eißing et al. 2012]</skos:definition>
        <skos:prefLabel xml:lang="de">Türstiel</skos:prefLabel>
    </owl:NamedIndividual>
    


