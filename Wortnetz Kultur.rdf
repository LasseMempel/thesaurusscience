		<skos:prefLabel xml:lang="en">demijohn</skos:prefLabel>
		<skos:altLabel xml:lang="en">demijohns</skos:altLabel>
		<skos:prefLabel xml:lang="de">Glasballon</skos:prefLabel>
		<skos:altLabel xml:lang="de">Glasballone</skos:altLabel>
		<skos:altLabel xml:lang="de">Glasballons</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004610"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013708"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004610"/>
		<skos:definition xml:lang="de">Ein Glasballon ist eine große bauchige bis kugelförmige Flasche, die meistens aufgrund des bruchempfindlichen Glaskörpers durch einen Korb oder ein Holzgestell geschützt wird. Er wird in der Regel zur Lagerung von Most oder Brandweindestillaten, seltener auch für korrosive Flüssigkeiten, verwendet.</skos:definition>
		<skos:narrowMatch rdf:resource="http://vocab.getty.edu/aat/300197269"/>
		<skos:closeMatch rdf:resource="https://www.wikidata.org/wiki/Q23660"/>
