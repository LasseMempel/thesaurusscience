	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk007642">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">film container</skos:prefLabel>
		<skos:altLabel xml:lang="en">film containers</skos:altLabel>
		<skos:prefLabel xml:lang="de">Filmdose</skos:prefLabel>
		<skos:altLabel xml:lang="de">Filmdosen</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk021049"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk021049"/>
		<skos:definition xml:lang="de">Eine Filmdose ist eine Dose, die dazu dient, Filmmaterial luft- und lichtdicht aufzubewahren. Filmdosen können aus Blech, Kunststoff, Pappe oder Karton bestehen. Sie kommen in verschiedenen Formen und Größen vor: üblicherweise sind sie flach oder höher  zylindrisch, je nach Filmart. Die Gestaltung der Dosen ist an verschiedene Filmarten angepasst, wobei sie meist für Film auf Spulen konzipiert sind. Es kommen auch Dosen für mehrere Filmrollen vor.</skos:definition>
		<skos:mappingRelation rdf:resource="http://www.wikidata.org/entity/Q1414430"/>
