	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk013873">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">bacon</skos:altLabel>
		<skos:prefLabel xml:lang="de">Speck (Lebensmittel)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Specke</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk014694"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013709"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk014694"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk013854"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk006627"/>
		<xe:explanation_temp xml:lang="de">Während heute Speck vornehmlich von Schweinen ist wurde früher häufig auch das Fettgewebe von Walen und Robben so benannt und genutzt. Man unterscheidet zwischen Rückenspeck, der fast nur aus Fett besteht, und Bauchspeck, der von Muskelfleisch durchzogen ist.</xe:explanation_temp>
		<skos:definition xml:lang="de">Speck ist ein Nahrungsmittel aus Fleisch das roh, luftgetrocknet, geräuchert oder gepökelt verzehrt wird. Speck wird aus dem Fettgewebe gewonnen, das zwischen der Haut und den Muskeln liegt.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4299964-9"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk013709"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk014694"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-03-24T14:31:41+01:00+01:00</dcterms:modified>
	</skos:Concept>
