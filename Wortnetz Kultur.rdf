		<skos:altLabel xml:lang="de">Topase</skos:altLabel>
		<skos:prefLabel xml:lang="en">topaz</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000346"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000349"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000346"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000349"/>
		<skos:definition xml:lang="de">Ein Topas ist ein Mineral, das in der chemischen Zusammensetzung Al2(SiO4)(F,OH)2 auftritt. Mit einer Mohshärte von 8 gehört Topas zu den harten Mineralen. Er kommt in prismatischen Kristallen vor, die transparent und glänzend sind und eine weiße, gelbe, braune, blassblaue, rosafarbene, rote oder blassgrüne Farbe haben können.</skos:definition>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4185705-7"/>
