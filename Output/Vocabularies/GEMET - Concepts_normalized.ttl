    skos:closeMatch <http://data.uba.de/umt/_00020757>,
        <http://dbpedia.org/resource/Land_reclamation> ;
    skos:definition "Making land capable of more intensive use by changing its general character, as by drainage of excessively wet land; irrigation of arid or semiarid land; or recovery of submerged land from seas, lakes and rivers."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Rekultivierung"@de,
        "land reclamation"@en .

