        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-05T12:19:41.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-18T13:59:46.000</terms:modified>
        <skos:definition xml:lang="de">Gouache-Malerei (ital. guazzo = Lache, Wasser), wasserlösliche Deckfarben (mit Weiß), mit Gummi gebunden. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Ital. guazzo = louže, voda), krycí barvy ředitelné vodou (včetně bílé), pojivo: arabská guma. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Gouachemalerei</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kvaš</skos:prefLabel>
    </owl:NamedIndividual>
    


