    skos:broader <http://lvr.vocnet.org/wnk/wk008768>,
        <http://lvr.vocnet.org/wnk/wk020865> ;
    skos:definition "Ein Aryballos ist ein meist kleines, kugeliges Vorratsgefäß mit einem oder zwei Henkeln, das zur Aufbewahrung von Ölen, Salben oder Parfüms verwendet wurde. Das Gefäß ist häufig aufwendig bemalt und wurde vorwiegend aus Ton, aber auch aus Glas, seltener aus Metall hergestellt. Aryballoi wurden in der Antike hauptsächlich von Athleten an einem Riemen am Handgelenk getragen."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Aryballos"@de,
        "aryballos"@en .

