		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/177" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/178" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/172" />
		<skos:scopeNote xml:lang="en">A site where acts of corporal and capital punishment were carried out.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
