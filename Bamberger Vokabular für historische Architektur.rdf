        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-05T09:27:24.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T17:45:56.000</terms:modified>
        <skos:altLabel xml:lang="de">Fallgitter</skos:altLabel>
        <skos:definition xml:lang="cs">1. Dřevěná mříž v opevněných branách, 2. Emblém tudorovského rodu. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Fallgatter, Fallgitter, starkes Holzgatter aus unten zugespitzten, eisenbeschlagenen Pfählen und Querbalken, zum Sperren von Burg-, Stadt- oder Festungstoren. Das F. ist über dem Tor an Ketten aufgehängt und seitl. in Mauerschlitzen geführt und konnte bei Belagerungen mit einer Winde rasch heruntergelassen werden. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Hölzernes Sperrgatter an befestigten Toren. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Fallgatter</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">hřeben (mřížka)</skos:prefLabel>
    </owl:NamedIndividual>
    


