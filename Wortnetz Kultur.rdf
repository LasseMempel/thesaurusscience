	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk008738">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Spange (Befestigungselement)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Spangen (Befestigungselement)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006114"/>
