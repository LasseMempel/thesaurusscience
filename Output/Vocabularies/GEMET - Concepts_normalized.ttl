<http://www.eionet.europa.eu/gemet/concept/10012> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3715> ;
    skos:definition "A central government organization that has authority or oversight over government activity relating to the preservation and safeguarding of ecological or natural resources."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Umweltverwaltungsbehörde"@de,
