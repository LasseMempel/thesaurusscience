        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_4ad58c08"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_e3404b66"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-05T21:07:08.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-12-01T16:02:57.000</terms:modified>
        <skos:note xml:lang="en">Decoration made of small coloured pieces of various materials (tesserae) applied on interior or exterior surfaces and embedded in several layers of mortar. [EwaGlos]</skos:note>
        <skos:note xml:lang="de">Dekoration aus kleinen, farbigen Teilen aus verschiedenen Materialien (Tesserae), die auf Innen- oder Außenflächen aufgebracht und in mehrere Mörtellagen gebettet werden. [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="fr"> mosaïque</skos:prefLabel>
