    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Green Edge Village"@en ;
    skos:scopeNote "Agricultural village with farmsteads and cottages wholly or mainly arranged around the edges of a green."@en .

<http://purl.org/heritagedata/schemes/571/concepts/160472> a skos:Concept ;
