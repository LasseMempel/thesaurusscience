	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021255">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Ichnofossil</skos:altLabel>
		<skos:altLabel xml:lang="de">Ichnofossilien</skos:altLabel>
		<skos:prefLabel xml:lang="de">Spurenfossil</skos:prefLabel>
		<skos:altLabel xml:lang="de">Spurenfossilien</skos:altLabel>
		<skos:prefLabel xml:lang="en">trace fossil</skos:prefLabel>
		<skos:altLabel xml:lang="en">trace fossils</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk001811"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk001811"/>
		<skos:definition xml:lang="de">Ein Spurenfossil ist ein Fossil, das aus den erhaltenen Spuren der Aktivität eines Lebewesens besteht, etwa Fährten, Fraßspuren, Grabgängen, Wohnbauten oder Ausscheidungen. Es handelt sich dabei nicht um körperliche Überreste des Organismus selbst.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4261161-1"/>
		<skos:narrowMatch rdf:resource="http://vocab.getty.edu/aat/300379470"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q853800"/>
