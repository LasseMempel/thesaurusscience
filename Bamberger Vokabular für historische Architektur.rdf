        <skos:altLabel xml:lang="de">Kompaktschliff</skos:altLabel>
        <skos:note xml:lang="de">Herstellung von Querschliffen von Proben zur Untersuchung durch optische Mikroskopie mit reflektiertem, künstlichen Tageslicht oder UV-Licht. [EwaGlos]</skos:note>
        <skos:note xml:lang="en">Preparation of crosswise cut samples for observation by optical microscopy under reflected artificial daylight or UV light. [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="de">Querschliff</skos:prefLabel>
        <skos:prefLabel xml:lang="en">cross section</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_b08496e6 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b08496e6">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a2e37af3"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-05T22:17:41.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T18:04:14.000</terms:modified>
        <skos:note xml:lang="de">Die zyklische Aufnahme und Abgabe von Feuchte in einem Baumaterial, die an salzbelasteten, porösen Materialien Schäden hervorrufen kann. [EwaGlos]</skos:note>
        <skos:note xml:lang="en">The cyclical absorption and desorption of moisture in a building material, which can provoke damage in salt-infested porous materials. [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="de">Nass-Trocken-Wechsel</skos:prefLabel>
        <skos:prefLabel xml:lang="en">wet-dry cycles</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_b08588ac -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b08588ac">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_2b8c8e23"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-28T10:50:07.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T13:39:51.000</terms:modified>
        <skos:definition xml:lang="de">Schmückender Aufbau oder oberer Abschluss eines Bauteils: z.B. Fensterb. ( Fensterverdachung) und Portalb. (Wimperg), Baldachin, Sima, Stirnziegel, Attika und Balustrade über dem Hauptgesims (Firstb., Firstkamm), Akroterien, Krabben am Giebel, Fialen an got. Strebepfeilern, Dachfiguren, Turmknauf, Ähre, Kreuzblume u.a. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Bekrönung</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_b0883b12 -->


