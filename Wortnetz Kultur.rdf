	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk019046">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">apothecary container</skos:prefLabel>
		<skos:altLabel xml:lang="en">apothecary containers</skos:altLabel>
		<skos:prefLabel xml:lang="de">Apothekengefäß</skos:prefLabel>
		<skos:altLabel xml:lang="de">Apothekengefäße</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000203"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000203"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk008710"/>
		<skos:definition xml:lang="de">Ein Apothekengefäß ist ein Gefäß, um bestimmte pharmazeutische Substanzen aufzubewahren. Die Gefäße sind in der Regel aus Glas, Kunststoff oder Keramik gefertigt und verfügen über einen Verschluss, um den Inhalt zu schützen.</skos:definition>
		<xe:explanation_temp xml:lang="de">Häufig wird Braunglas für Behälter mit pharmazeutischen Substanzen verwendet. Dadurch wird das Eindringen von Licht reduziert und die Stabilität der darin enthalten Substanzen gewährleistet.</xe:explanation_temp>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4002467-2"/>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300220895"/>
