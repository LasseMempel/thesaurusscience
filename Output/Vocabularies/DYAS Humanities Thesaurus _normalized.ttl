    skos:prefLabel "Holodaktylos"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/771> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/372> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Sachtouria"@en ;
    skos:scopeNote "Sailing ships with square sails and a tonnage of up to 20 tonnes. They were used in the Mediterranean from the early 18th century onwards."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/774> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/385> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "External focalization"@en ;
    skos:scopeNote "Narrative way in which the narrator knows less than the characters. He acts a bit like a camera lens, following the protagonists' actions and gestures from the outside; he is unable to guess their thoughts and emotions."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/778> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Kneaders"@en ;
    skos:scopeNote "Women engaged in kneading and baking bread. Breads kneaded for special occasions, such as weddings and engagements, were so beautifully decorated with designs that they resembled works of art."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/786> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cutlers"@en ;
    skos:scopeNote "Craftsmen involved in the manufacture and repair of knives."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/795> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/381> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Contracts (Private inscriptions)"@en ;
    skos:scopeNote "Inscriptions recording contracts or agreements between private citizens for rent, mortgages, real estate sales and other needs."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/802> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/618> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ready-mades"@en ;
    skos:scopeNote "A term devised by Marcel Duchamp to describe pre-existing mass-produced objects, selected at random, which were then accorded the status of artworks. Ready-mades differed from objets trouvés (found objects such as stones, shells, etc.) as the latter were chosen for their aesthetic beauty."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/806> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Painters (craftsmen)"@en ;
    skos:scopeNote "Craftsmen who paint walls or other surfaces."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/81> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/811> a skos:Concept ;
    skos:altLabel "Bagel men"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/456> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Bagel sellers"@en ;
    skos:scopeNote "Itinerant sellers of sesame buns or other bakery products."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/814> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/456> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Water carriers"@en ;
    skos:scopeNote "Water sellers who supplied water to houses in towns or villages that did not have their own water source."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/815> a skos:Concept ;
    skos:altLabel "Aeolian dialect"@en,
        "Lesbian dialect"@en,
        "Lesbic dialect"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/532> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Aeolic dialect"@en ;
    skos:scopeNote "Aeolic dialect is the set of dialects of Ancient Greek spoken mainly in Boeotia (a region in Central Greece); Thessaly, in the Aegean island of Lesbos; and the Greek colonies of Asia Minor (Aeolis). The Aeolic dialect shows many archaisms in comparison to the other Ancient Greek dialects (Attic/Ionic, Doric, Northwestern and Arcadocypriot), as well as many innovations. Aeolic poetry, which is exemplified in the works of Sappho, mostly uses four classical meters known as the Aeolics: Glyconic (the most basic form of Aeolic line), hendecasyllabic verse, Sapphic stanza, and Alcaic stanza (the latter two are respectively named for Sappho and Alcaeus). It is specified by a group of morphophonological phenomena and a significant large group of dialectic words."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/825> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/702> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Epilog"@de,
        "Epilogue"@en ;
    skos:scopeNote "The epilogue is a summary speech that appears at the end of a play to draw conclusions from the story, thank the audience and encourage them to draw moral or political lessons from it and win their indulgence."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/839> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/618> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Collages"@en ;
    skos:scopeNote "Artworks in two dimensions or very low relief that were made by gluing paper, fabrics, photographs, or other materials onto a flat surface."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/846> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/532> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ionian dialect"@en ;
    skos:scopeNote "Ionic Greek was a subdialect of the Attic-Ionic or Eastern dialect group of Ancient Greek.The Ionic dialect appears to have originally spread from the Greek mainland across the Aegean at the time of the Dorian invasions, around the 11th century BC during the early Greek Dark Ages. By the end of the Archaic Greek and early Classical Greek periods in the 5th century BC, the central west coast of Asia Minor, along with the islands of Chios and Samos, formed the heartland of Ionia proper. The Ionic dialect was also spoken on islands across the central Aegean and on the large island of Euboea north of Athens. The dialect was soon spread by Ionian colonization to areas in the northern Aegean, the Black Sea, and the western Mediterranean."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/850> a skos:Concept ;
    skos:altLabel "Predicative position"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/374> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Predicative adjective"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/855> a skos:Concept ;
    skos:altLabel "Marble makers"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Stonemasons"@en ;
    skos:scopeNote "Craftsmen skilled in the extraction and processing of marble or in covering surfaces with marble."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/862> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/456> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Pedlars"@en ;
    skos:scopeNote "Petty merchants who roamed from village to village, from neighborhood to neighborhood on their donkey, and peddled their merchandise, mainly textiles, clothes and household utensils of everyday use."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/865> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/602> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Contemporary Greek Art History"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/876> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Farriers"@en ;
    skos:scopeNote "Craftsmen skilled in horseshoeing beasts of burden."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/879> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/542> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Extradiegetic narrator"@en ;
    skos:scopeNote "Narrative technique in which the narrator is one who narrates a story from outside the fictional universe of a particular text. For example the narrator in <em>Thousand and One Nights</em> is extradiegetic, since he recounts the facts that consist the main plot, but he stands out of it."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/880> a skos:Concept ;
    skos:altLabel "Narrateur intradiégétique"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/542> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Intradiegetic narrator"@en ;
    skos:scopeNote "Narrative technique in which the narrator is one who exists within the storyworld of a particular text and tells a story (about his past, for instance, or a fictional story) which is situated at a secondary narrative level with respect to the main story. Ιntradiegetic story is a story within a story. For example, Scheherazade, in <em>One Thousand and One Nights</em>, is an intradiegetic narrator, since she narrates her stories within the frame of the main story."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/881> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/681> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Interjection"@en ;
    skos:scopeNote "An interjection is a word or expression that occurs as an utterance on its own and expresses a spontaneous feeling or reaction. The category is quite heterogeneous, and includes such things as exclamations, curses, greetings, responses, and hesitation. Due to its heterogeneous nature, the category of interjections partly overlaps with categories like profanities, discourse markers and fillers."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/883> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/618> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Still lifes"@en ;
    skos:scopeNote "Pictures of inanimate objects. Common still life subjects include vessels, food, flowers, books, clothing. This genre flourished particularly among Dutch painters of the seventeenth century.Τhe images were intended to relay allegorical messages."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/886> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/378> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Photomontage"@en ;
    skos:scopeNote "A technique of image-making from bits of different preexisting photographs which are cut out, arranged, and pasted down to form a composition, it was largely the creation of the Berlin Dadaists."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/889> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Town criers"@en ;
    skos:scopeNote "Public preachers, who announced news or events in the neighborhoods of cities or villages in a loud voice."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/897> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Loom combers"@en ;
    skos:scopeNote "The craftsmen who fabricated and sold battens. The batten is one of the components of the loom. It is a rectangle about 10-12 cm high and has a number of thin teeth that are attached to two narrow parallel reeds or woods. These craftsmen also repaired the broken battens. There are small and large battens that were used depending on the fabric."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/898> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/372> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Lateen rigged ships"@en ;
    skos:scopeNote "Big sailing ships that sailed in the Mediterranean during the early modern and modern period. Lateen-rigged ships had initially two and after the mid-18th century three masts with triangular sails, called lateens, which gave this type of ship its name."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/901> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Carpenters"@en ;
    skos:scopeNote "Craftsmen trained in woodworking, construction and repair of wooden objects and surfaces."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/907> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/618> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Installations"@en ;
    skos:scopeNote "Works dating from the 1960s or later that use their exhibition space as part of their design. Demanding a viewer's active engagement, installations are often created by artists in direct opposition to the notion of permanent artwork, or art as a commodity."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/909> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/456> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Salep sellers"@en ;
    skos:scopeNote "Manufacturers and sellers of salep. They were street sellers and walked around dressed in white (white blouse and hat) and pushing a cart. The utensils they used were bronze, always polished and impeccably clean. Their work peaked in the mornings and the evenings."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/910> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/618> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Caricatures"@en ;
    skos:scopeNote "Artworks, usually portraitures, in which the characteristic features of the subjects are exaggerated or distorted for comic effect."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/918> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/618> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Mosaics"@en ;
    skos:scopeNote "Images or patterns composed of small, regularly shaped pieces of durable material, usually stone or colored glass. Distinguished from \"Opus sectile\" which is composed of individually shaped pieces of durable material, usually stone or glass, which conform to the design or pattern."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/919> a skos:Concept ;
    skos:altLabel "Attributive position"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/374> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Attributive adjective"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/92> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/22> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/923> a skos:Concept ;
    skos:altLabel "Spondiacus"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/634> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Spondeiazon"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/925> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/372> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Brigs"@en ;
    skos:scopeNote "Big trade ships with two oars that were used also as warships. Their tonnage reached 250-300 tons. They dominated the marine history of the Mediterranean in the 18th and 19th centuries, and were the main type of ship used during the Greek War of Independence."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/927> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/378> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Pointillism"@en ;
    skos:scopeNote "Pointillism is the application of tiny dots of brilliant color on the canvas. These dots merge in the viewer’s eye. Other preferred the word “Divisionism”."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/928> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/670> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Tyranny"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/934> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/372>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/412> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Galleons"@en ;
    skos:scopeNote "The basic type of sailing ships in the early modern Mediterranean. Galleons were variations of the galleys that developed into sailing ships with oars for additional propelling power."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/942> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/492> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Free indirect style"@en ;
    skos:scopeNote "A narrative technique in which the character's words or actions are reported by the narrator, but without using a subordinating conjunction."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/946> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/475> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Rebellions"@en ;
    skos:scopeNote "Acts of collective violence against power institutions by subordinate social groups that express demands for institutional, political and/or economic change. Depending on historical conditions, rebellions can develop into revolutions."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/947> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/378> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Stained glass technique"@en ;
    skos:scopeNote "Technique for making artworks of colored glass, generally in the form of a window, autonomous panel, or lampshade, in which the design is meant to be observed through refracted light and its effect is greatly dependent on the quality of the light. The stages of manufacture were described in a manual written in the early twelfth century by the monk Theophilus and the process has hardly changed since then. The window or other item is made by cutting pieces of colored glass based on a full-scale cartoon and holding the pieces together by strips of lead. Details may be painted on the surface of the pieces of glass and fired in a kiln before piecing the glass together. The method of weatherproofing and fixing the glass in a window is often highly decorative and forms an important element of the design. The highest achievements in stained glass are thought to be those of the Gothic era in Europe and those of the Gothic Revival of the nineteenth century."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/949> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/618> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Gouaches"@en ;
    skos:scopeNote "Watercolors using gouache, which is opaque color that is ground in water and mixed with gum and honey. Gouaches may be classified as either drawings or paintings."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/952> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/456> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ice sellers"@en ;
    skos:scopeNote "Door-to -door ice sellers. Prior to the use of electric refrigerators for food preservation, the ice sellers walked around in neighborhoods with a three-wheeled cart, a specially shaped cart, or a donkey full of ice blocks made by means of a special ice-making process. The ice sellers supplied not only houses but also small shops. They wore gloves to keep their hands from freezing and handled a special hook-cutter, with which they held the ice, cut it and carried it. The ice was then placed in brick or wooden refrigerators. Families used these refrigerators to preserve their food and to ensure cool water in the summer."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/959> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/618> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Pastels"@en ;
    skos:scopeNote "Artworks, typically on a paper or vellum support, to which designs are applied using crayons made of ground pigment held together with a binder, typically oil or water and gum. Works in this medium are sometimes classified as drawings, and sometimes as paintings, typically based on the local curatorial department responsible for the work or on the material of the support (pastels on paper may be classified as drawings, while pastels on vellum may be classified as paintings)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/96> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Dada"@en ;
    skos:scopeNote "Dada was a protest by a group of European artists against World War I, bourgeois society, and the conservativism of traditional thought. Its followers used absurdities and non sequiturs to create artworks and performances which defied any intellectual analysis. They also included random \"found\" objects in sculptures and installations."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/963> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/708> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Economic and financial reforms"@en ;
    skos:scopeNote "Reforms that induce changes in the structure and function of the economy and of the fiscal system of a state."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/965> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/456> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ice cream sellers"@en ;
    skos:scopeNote "Travelling ice cream sellers. They went around the neighborhoods and sold ice creams with various flavors. They wore a white apron and a white cap. They usually rode a bicycle and had a cart with ice creams."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/972> a skos:Concept ;
    skos:altLabel "Quarry men"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Quarriers"@en ;
    skos:scopeNote "Special craftsmen who cracked big stones at their foundations and cleared the way."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/973> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/618> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Oil paintings"@en ;
    skos:scopeNote "Creative works produced in oil paint, which is pigment suspended in vegetal drying oils."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/975> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/618> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Photographs"@en ;
    skos:scopeNote "Images produced by the action of light on light-sensitive materials."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/992> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Umbrella manufacturers"@en ;
    skos:scopeNote "Craftsmen who manufacture, repair and / or sell umbrellas."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/102> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/21> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Judicial system"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/391> ;
    skos:scopeNote "The system of functions and activities performed by the judicial authorities of a state or other sovereign instance in order to solve legal disputes, to deal with crime and delinquency, and to safeguard the application of laws."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1023> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/586> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Freies Morphem"@de,
        "Free morpheme"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/849> ;
    skos:scopeNote "A morpheme that can carry meaning on its own and does not require a prefix, suffix, or infix to give it meaning."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1024> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/669> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Εxpanded sentences"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/792> ;
    skos:scopeNote "<br />Expanding clauses are a group of words that forms a part of a sentence and that contains a subject and a predicate. Kinds of expanded clauses are a) the independent clause, and b) the dependent clause."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1026> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/681> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Preposition"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/775> ;
    skos:scopeNote "A preposition combines with a noun or pronoun or a noun phrase, this being called its complement or object. A preposition comes before its complement."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1032> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Weavers"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/496> ;
    skos:scopeNote "The women craftsmen engaged in the art of weaving. They weaved on the loom."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1047> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/457> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Gender identity"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2042> ;
    skos:scopeNote "Aspect of social identity, which refers to a person&#39;s assumed characteristics and roles, as designated by the prevailing social and cultural stereotypes about their sex."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/105> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/254> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1053> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Coopers"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/502> ;
    skos:scopeNote "Craftsmen skilled in the construction and repair of wooden barrels."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1065> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Embroiderers"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/510> ;
    skos:scopeNote "Women professionally engaged in handmade embroidery."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1071> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/542> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Metadiegetic narrator"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1335> ;
    skos:scopeNote "Narrative technique in which the narrator is present in the secondary narration (in the meta-narration) and narrates another story."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1083> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/569> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Sacred calendars (Religious inscriptions)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Inscriptions indicating by month the days devoted to offering sacrifices, the name of the deity for whom the sacrifice was intended, the location of the sanctuary where the ritual would take place, the sacrificial animal, and the total cost of the sacrifice."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1084> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Shoemakers"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1978> ;
    skos:scopeNote "Craftsmen who manufacture and repair worn shoes. In the old times, shoemakers walked around the streets and collected shoes for repair."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1091> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Glassblowers"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/487> ;
    skos:scopeNote "Craftsmen involved in the processing of glass and the manufacture of glassware."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1098> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/656> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Hemiepes"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/448> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1103> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/693> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Patrilineal descent"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/940> ;
    skos:scopeNote "Descent system in which children of both sexes are affiliated to their father&#39;s kinship group."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1114> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/708> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Political reforms"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2625> ;
    skos:scopeNote "Reforms that induce changes in the structure and function of the political system within a state."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1119> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/328> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Aristocracy"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/113> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Modernism"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/150> ;
    skos:scopeNote "The term refers to the succession of 20th-century avant-garde art and architectural movements formed in a reaction to social modernity. Modernism was eclipsed by the Post-Modernism movement which began in the 1970s."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1130> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/740> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Lexicologie"@de,
        "Lexicology"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1257> ;
    skos:scopeNote "Lexicology is the part of linguistics which studies words. This may include their nature and function as symbols, their meaning, the relationship of their meaning to epistemology in general, and the rules of their composition from smaller elements (morphemes such as the English -ed marker for past or un- for negation; and phonemes as basic sound units). Lexicology also involves relations between words, which may involve semantics (for example, love vs. affection), derivation (for example, fathom vs. unfathomably), usage and sociolinguistic distinctions (for example, flesh vs. meat), and any other issues involved in analyzing the whole lexicon of a languages."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1137> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/801> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Arbitrations (Interstate affairs inscriptions)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Inscriptions bearing a written resolution of a city aiming to solve the issues that exist between two cities."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1142> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1093> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Naval catalogues"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Inscriptions with catalogues that include a complete census of ships and naval equipment, the persons responsible for them and a reference to their seaworthiness."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1152> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/818> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Triptychs (Bearers of inscriptions)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Albums composed of three tablets joined together by metal rings or thin leather strips."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1165> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/801> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Official epistle (Interstate affairs inscriptions)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Inscriptions bearing official correspondence. Letters were the main means of communication of Hellenistic rulers, as well as Roman officials and Emperors with cities, Koina (leagues) or Confederations of cities, subjects, small settlements, collective entities, such as youth and elders' clubs, athletic clubs and other rulers.<br />"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1168> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1044> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Regular accounts (Public inscriptions)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Inscriptions that are records of public property during the period between the expiry of the term of public office of one citizen and the assumption of office by his successor. Usually, the accounts were drawn up by the new officers, who received the public property from the outgoing officials, possibly in cooperation with them."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/117> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/22> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Editorial epigraphic symbols"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "A set of commonly accepted symbols that allow the printed version of the texts of inscriptions and help to reproduce the restorations and corrections proposed by scholars for the preserved text of the inscription."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1170> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1045> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Sacred manumission inscriptions"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Manumission inscriptions involving a god as the recipient of a slave assignment or as a slave buyer, through the mediation of his priesthood. In either case, the act, assignment or sale, is virtual and its final goal is the liberation of the slave."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1193> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/958> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Epexigetical genitive"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/807> ;
    skos:scopeNote "This use of the genitive helps to define an ambiguous or metaphorical head noun, or gives a specific example of the larger category named by the head noun. It also requires the words of equality for proper understanding, but the word ‘of’ can be used (unlike the case with Simple Apposition)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1214> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/818> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Diptychs (Bearers of inscriptions)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Albums composed of only two tablets joined together by metal rings or thin leather strips."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1229> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/874> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Political revolutions"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2625> ;
    skos:scopeNote "Revolutions that are characterized by large social participation and aim at the radical overthrow of the structure and the function of political power, and at their replacement with a new system enabling the participation of excluded social groups."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1237> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/933> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Language contact"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1276> ;
    skos:scopeNote "Language contact occurs when two or more languages or varieties interact. The study of language contact is called contact linguistics."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1247> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1021> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Alphabetical oracles"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Inscriptions written in verse and containing 24 divine verdicts, whose initial letters correspond to the 24 letters of the alphabet. The believer chose randomly a letter and the oracle gave him the answer to his question with the corresponding divine verdict that he would have to apply in his case."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1257> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/933> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Lexicographie"@de,
        "Lexicography"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1130> ;
    skos:scopeNote "Lexicography is divided into two separate but equally important groups: (a) Practical lexicography is the art or craft of compiling, writing and editing dictionaries, and (b) Theoretical lexicography is the scholarly discipline of analyzing and describing the semantic, syntagmatic and paradigmatic relationships within the lexicon (vocabulary) of a language, developing theories of dictionary components and structures linking the data in dictionaries, the needs for information by users in specific types of situations, and how users may best access the data incorporated in printed and electronic dictionaries. This is sometimes referred to as 'metalexicography'."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1258> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1044> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Extraordinary accounts (Public inscriptions)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Inscriptions that were records compiled by committees appointed to check the work of the regular officers, when necessary."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1261> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/801> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Treaties (Interstate affairs inscriptions)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Inscriptions which describe the official relations between the cities-states. These relations were formulated in the texts of the treaties, which were published by the contracting cities on stone stelae, which they erected in public places."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1270> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/933> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Soziolinguistik"@de,
        "Sociolinguistics"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2582> ;
    skos:scopeNote "Sociolinguistics is the descriptive study of the effect of any and all aspects of society, including cultural norms, expectations, and context, on the way language is used, and the effects of language use on society. Sociolinguistics differs from sociology of language in that the focus of sociology of language is the effect of the society on the language, while the sociolinguistics focuses on language's effect on the society. Sociolinguistics overlaps to a considerable degree with pragmatics. It is historically closely related to linguistic anthropology and the distinction between the two fields has even been questioned recently."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1276> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/933> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Dialektologie"@de,
        "Dialectology"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1237> ;
    skos:scopeNote "Dialectology is the scientific study of linguistic dialect, a sub-field of sociolinguistics. It studies variations in language based primarily on geographic distribution and their associated features. Dialectology treats such topics as divergence of two local dialects from a common ancestor and synchronic variation.Dialectologists are ultimately concerned with grammatical, lexical and phonological features that correspond to the varieties of specific regional areas. Thus they usually deal not only with populations that have lived in certain areas for generations, but also with migrant groups that bring their languages to new areas."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1284> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/801> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Edicts (Interstate affairs inscriptions)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Inscriptions, mainly of the Hellenistic and Roman times, which bear a law of general application, formulated and imposed by a single person. The text was usually sent to cities in the form of a manuscript, and the cities decided whether it would be engraved on stelae."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1294> a skos:Concept ;
    skos:altLabel "Cultural Linguistics"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/933> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ethnolinguistik"@de,
        "Ethnolinguistics"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1506> ;
    skos:scopeNote "Ethnolinguistics (sometimes called cultural linguistics) is a field of linguistics which studies the relationship between language and culture, and the way different ethnic groups perceive the world. It is the combination between ethnology and linguistics. The former refers to the way of life of an entire community, i.e., all the characteristics which distinguish one community from the other. Those characteristics make the cultural aspects of a community or a society."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1306> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/861> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Szene"@de,
        "Scenes"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1078> ;
    skos:scopeNote "Unit of action, often a temporal subdivision of the act of the theatre play. Τhe external division of the dramatic text in scenes that had already appeared during the 19th century as better responding to the structure of the new dramaturgy, was fully exploited by playwrights during the 20th century."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1309> a skos:Concept ;
    skos:altLabel "Μanuals (Bearers of inscriptions)"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/818> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Encheiridia (Bearers of inscriptions)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Albums composed more than three tablets joined together by metal rings or thin leather strips."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1327> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1045> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Secular manumission inscriptions"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Manumission inscriptions that do not involve the divine element. Often, the manumission itself is not recorded, but the payment of a fixed manumisson fee by those liberated to the authorities of the city."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1329> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/856> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Satyrspiel"@de,
        "Satyr play"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1806> ;
    skos:scopeNote "Dramatic genre of the ancient Greek drama featuring the chorus of satyrs, who typically performed a dance that was guided by Silenus. It had a comic plot and a happy ending, it mocked persons and satirised mythological themes from the preceding tragedies. Satyr plays were shorter than tragedies and used the metre more freely. They were performed after the trilogies of tragedies in the drama festivals."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1331> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1085> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Theater"@de,
        "Theatre"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2209> ;
    skos:scopeNote "Theatre, the art of dramatic performance, follows certain conventions in order to (re)present real or imagined events (dramatised plot). The representation is carried out by people (actors), who talk and act in front of an audience gathered in a more or less organised space and time, in order to watch it."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1335> a skos:Concept ;
    skos:altLabel "Frame narrative"@en,
        "Frame tale"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/852> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Frame story"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1071> ;
    skos:scopeNote "Narrative technique in which a secondary narration is embedded into the main narration, interupting the time flow of the main narration. It consists of a story within a story. Homer's <em>Odyssey</em> makes use of this device; Odysseus' adventures at sea are all narrated by Odysseus to the court of king Alcinous in Scheria."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1344> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/983> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Funerary epigrams"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Funerary inscriptions written in verse."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1345> a skos:Concept ;
    skos:altLabel "Genitive of apposition"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/958> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Genitive of simple apposition"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/939> ;
    skos:scopeNote "If the head noun is in the genitive case, due to other relationships within the sentence, then the noun in apposition is also required to be in the genitive case. Notice that in this case, the word ‘of’ could not be used in translation to show the relationship between the two nouns. One of the words (phrases) showing equality must be used."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/135> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Taboos"@en ;
    skos:scopeNote "Prohibitive rules with relevance to sacred and/or profane acts, objects and entities. The violation of these rules entails sanctions or punishment by supernatural forces."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1354> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1218> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Decrees awarding citizenship"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2084> ;
    skos:scopeNote "Decrees, by which a city decided to grant citizen's rights, i.e. the right of a foreigner to become a citizen of a city, due to his outstanding deeds towards it. This was the highest honor awarded, especially during the classical period."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/136> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/169> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/139> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/24> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ekkyklemen"@de,
        "Ekkyklemas"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1291> ;
    skos:scopeNote "The eccyclema was a low platform that rolled on wheels and was used in the performance of ancient Greek tragedy. This device was a means to present the results of (usually violent) deeds that had taken place in an interior place or some offstage scene (mainly murdered bodies)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1448> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Staters"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444> ;
    skos:scopeNote "The term was used in certain parts of the ancient Greek world in order to identify the coins of the highest value in a series. The first electrum Greek coins were divided into staters, hectes and smaller fractions. The term was used for gold but also for silver coins."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/145> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/285> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Fasting"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/274> ;
    skos:scopeNote "The practice of abstinence from certain foods and/or actions, for religious purposes."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1450> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2349> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Incuse coins"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444> ;
    skos:scopeNote "Coins which exhibit the same image, concave on one side, convex on the other. This technique was achieved by using a concave cast and was popular in the Greek cities of South Italy during the 6th and 5th c. BCE."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1451> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2349> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Double struck coins"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444> ;
    skos:scopeNote "The term refers to coins whose obverse or reverse has been struck twice by the respective die. As a consequence of this action, deliberate or not, parts of the design may be visible twice."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1452> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2349> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Off-center coins"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444> ;
    skos:scopeNote "An off-center coin is a coin struck on a blank flan that was not properly centered on the die. As a consequence of this mistake, part of the design is missing from the coin."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1455> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2349> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Overstrikes"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444> ;
    skos:scopeNote "Coins that, instead of being struck in a blank flan, were struck on coins that were already in circulation. Sometimes overstriking had not obliterated the original coin or undertype completely, and detailed examination enables both undertype and overtype to be identified. Overstriking often occurred after the withdrawal of older coins or in cities that had no precious metals in order to mint their own currency."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1470> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Posthumous coinage"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444> ;
    skos:scopeNote "Coinage produced in the name of a ruler after his death."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1473> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Axis (Numismatics)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444> ;
    skos:scopeNote "The notional line that is vertical to the design of the coin. The term expresses the directional relationship between the obverse and reverse type of a numismatic object and it is usually marked using the hours of the clock. This relationship can be perceived when a coin is held by its edges between forefinger and thumb with its obverse type upright, and then rotated on this axis. During ancient times the two dies used to strike coins were not always aligned in a fixed position."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1479> a skos:Concept ;
    skos:altLabel "Pediatrics"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2377> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Paediatrics"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2102> ;
    skos:scopeNote "Paediatrics is the specialty of medical science concerned with the physical, mental, and social health of children from birth to young adulthood. Paediatric care encompasses a broad spectrum of health services ranging from preventive health care to the diagnosis and treatment of acute and chronic diseases. It is a discipline that deals with biological, social, and environmental influences on the developing child and with the impact of disease and dysfunction on its development."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1488> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/24> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Casts"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444> ;
    skos:scopeNote "Models of solid objects that have been made by pouring a liquid, such as plaster or hot metal, into a mold, so that when it hardens it has the same shape as the solid objects."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1502> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1568> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Gregorian Armenian Christians"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/458> ;
    skos:scopeNote "Christians of the non-Chalcedonian Armenian Apostolic Church that goes back to Gregory the Illuminator, who is regarded as having introduced Christianity to Armenia. Gregorian Armenians comprise the largest part of the wider Armenian ethnic-cultural group, and the Armenian Apostolic Church is regarded as the Armenian national Church."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1503> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Sestertii"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444> ;
    skos:scopeNote "Roman coins that were first introduced around 211 BCE along with the denarii. During the Roman Republic they were small, silver coins valued at one quarter of a denarius. In 23 BCE, in the monetary reform of Augustus, the sestertii were reintroduced as the largest brass denomination. They were worth four assaria and valued still at one quarter of a denarius."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1524> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1513> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Homonymy"@en ;
    skos:scopeNote "Ηomonyms, broadly defined, are words which sound alike or are spelled alike, but have different meanings. The relationship between a set of homonyms is called homonymy. Example of homonyms are the pair bank (building, institution) and bank (of river). A distinction is sometimes made between true homonyms, which are unrelated in origin, such as skate (glide on ice) and skate (the fish), and polysemous homonyms, or polysemes, which have a shared origin, such as mouth (of a river) and mouth (of an animal)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1555> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1540> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Huguenots"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/458> ;
    skos:scopeNote "French Calvinists of the 16th and 17th centuries. Relations between Huguenots, many of whom belonged to the French nobility, and state power, which remained Catholic, was often marked by tensions culminating in persecutions, like the massacres that took place on St Bartholomew's Day (1572). The Edict of Nantes (1598) granted religious rights to the Huguenots, but pressure on them intensified in the course of the 17th century and the Edict was revoked in 1685. Most Huguenots left France and settled in Protestant countries."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1563> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1539> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Anglicans"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/458> ;
    skos:scopeNote "Protestant Christians who constitute the third most numerous Christian community after the Catholics and the Eastern Orthodox. Anglicans originate in the secession of the Church of England from the Pope in the 16th century. Anglican Churches, which acknowledge the Archbishop of Canterbury as \"primus inter pares\", emphasize the importance of the Bible, of apostolic succession, and of Church tradition, constituting thus a middle way between Catholicism and the radical aspects of Protestantism (i.e. Calvinism). This is evident also in the hierarchical structure of Anglican Churches, as in the existence of monastic communities."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1567> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1539> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Lutherans"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/458> ;
    skos:scopeNote "Christians who belong to one of the Lutheran Churches, which follow the teachings of Martin Luther and other 16th-century theologians. This set of teachings, which inaugurated the Reformation and culminated in the split of the Protestants from the Catholic Church, focuses on the primary importance of the Scriptures in relation to Christian tradition, on the salvation and justification of Man by divine grace and through faith, on the rejection of a hierarchical ecclesiastical structure, and on the distinction between law and gospel. This teaching was expressed in the Augsburg Confession (1530) and the <em>Book of Concord</em> (1580). Lutheranism, in contrast to more radical Protestant branches, like Calvinism, acknowledges liturgical practices and views on the sacraments that originate from before the Reformation."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1574> a skos:Concept ;
    skos:altLabel "Jacobites"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1568> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Syrian Orthodox Christians"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/458> ;
    skos:scopeNote "Christians who follow the Syriac Oriental Orthodox Church of Antioch, a miaphysite Church which goes back to Jacob Baradaeus, a missionary and bishop of Edessa (6th century), and which suffered persecution by the Byzantine emperors. Syriac Orthodox Christians consider their Church in terms of succession from the bishopric of Antioch, established by the apostle Peter. Scholars of the Syriac Church were crucial in the translation of works of the ancient Greek literature into Arabic. Syriac Orthodox Christians use the Syriac rite in the Syriac-Aramaic language. Besides the Middle East, they live in India, as well as in diasporic communities all over the world."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1582> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1568> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ethiopian Orthodox Christians"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/458> ;
    skos:scopeNote "Christians who follow the Oriental Orthodox Church of Ethiopia, a miaphysite Church that until the 20th century was administratively included in the Coptic Church. Ethiopian Orthodox Christians trace their Church in the time of Christ's apostles, who preached in Ethiopia. In the 4th century Christianity was proclaimed state religion of the Ethiopian Kingdom of Aksum and the Church of Ethiopia was incorporated in the Egyptian Church with Frumentius from Syria as its bishop. Liturgical language of the Church is the ancient Ethiopian Ge'ez. Ethiopian Orthodox Christians constitute the largest community in the framework of Oriental Orthodox Christianity."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1596> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/643> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Religious wars"@en ;
    skos:scopeNote "Wars in which the combatants regard each other as being religiously different; use the elimination of religious difference as a motive or justification for conducting war; use religious ideas and concepts in the discourse on war; use specific practices in conducting war that highlight religious difference; are connected to opposing religious institutions; and form military alliances according to religious boundaries. Religious wars lead to serious consequences with regard to religious behavior, culminating in the prohibition or the imposition of a religion in state territories, often in connection with relocation of populations.<br />"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/161> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Word"@en ;
    skos:scopeNote "A single distinct meaningful element of speech or writing, used with others (or sometimes alone) to form a sentence and typically shown with a space on either side when written or printed. A word is a unit which is a constituent at the phrase level and above. It is sometimes identifiable according to such criteria as being the minimal possible unit in a reply, having features such as a regular stress pattern, and phonological changes conditioned by or blocked at word boundaries being the largest unit resistant to insertion of new constituents within its boundaries, or being the smallest constituent that can be moved within a sentence without making the sentence ungrammatical."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1613> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2582> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Genealogy"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/332> ;
    skos:scopeNote "The discipline that detects the origin and lineage of individuals and systematically monitors the evolution of families and generations and their classification."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1619> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/643> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Interstate wars"@en ;
    skos:scopeNote "Wars fought between two or more sovereign states. Interstate wars exceed, as to the scale of military operations and the number of casualties, the level of border skirmishes and other minor types of conflict, and are as a rule accompanied by official war declarations by the belligerents."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1620> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1622> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Secession wars"@en ;
    skos:scopeNote "Wars aiming at acquiring autonomy or independence for a part of a sovereign state. Secession wars are fought by a national, ethnic, or religious group, included within a sovereign state, which aims at breaking away from this state (a process understood usually as liberation) and sometimes at merging with another state."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1622> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/643> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "State-building wars"@en ;
    skos:scopeNote "Wars fought in the framework of a state-building process. State-building wars may be secession/anti-colonial wars, or interstate wars aiming at the expansion of small states through the incorporation of populations and territories, on which they consider themselves as having justified claims, and at their crystallisation into a new state."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1695> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Prime Minister"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/520> ;
    skos:scopeNote "Political office, whose holders are heads of the executive in nation-states under a political regime of parliamentary republic or constitutional monarchy. In semi-presidential republics, like France and Russia, the Prime Minister is appointed by the President, while in presidential republics, as the USA, the office does not exist. Prime Ministers are members of the parliament and heads of the political partry that is able to form a government. They appoint the cabinet of ministers that implements the government's policies."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1699> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/248> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cartography"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1700> ;
    skos:scopeNote "The art and science of graphically representing a geographical area, usually on a flat surface such as a map or chart. It may involve the superimposition of political, cultural, or other nongeographical divisions onto the representation of a geographical area."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1700> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/240> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Maps"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1699> ;
    skos:scopeNote "Graphic representation, drawn to scale and usually on a flat surface, of features—for example, geographical, geological, or geopolitical—of an area of the Earth or of any other celestial body."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1701> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1085> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Dance (art)"@en ;
    skos:scopeNote "Form of expression that uses bodily movements that are rhythmic, patterned (or sometimes improvised), and usually accompanied by music. One of the oldest art forms, dance is found in every culture and is performed for purposes ranging from the ceremonial, liturgical, and magical to the theatrical, social, and simply aesthetic."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1702> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/157> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Journalism"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1499> ;
    skos:scopeNote "The business or practice of regularly producing and disseminating information about affairs of public interest and importance."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1724> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1584> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cardinal"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1509> ;
    skos:scopeNote "High official of the Catholic Church, who either is a bishop/archbishop or is the head of a sector of the Roman curia. The cardinals, organized as a collective body, the College of Cardinals, elect the next pope and take over the governance of the Church while the papal seat remains vacant."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1725> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1509> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Eastern Catholic Christians"@en ;
    skos:scopeNote "Christians of Eastern Europe and of the countries around the Eastern Mediterranean, who belong to Churches that have retained their original rite (Byzantine, Syriac, Coptic etc.) and their own theological tradition, but have been incorporated in the Catholic Church. Most of these Churches emerged during the modern era, when Christian communities of the Near East and Eastern Europe acknowledged papal supremacy and were united with the Church of Rome."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1727> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1566> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Distant reading"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1542> ;
    skos:scopeNote "A method of analyzing literary texts that involves the use of algorithms, statistical tools and programs to manage large volumes of data provided by digitized literary works, capturing the results in the form of graphs and trees. Distant reading can reveal narrative patterns in large corpora of literary texts that cannot be detected by close reading, that is by the word by word reading of the texts which emphasizes the single and the particular over the general."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1743> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1742> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Collectors (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1762> ;
    skos:scopeNote "Committees consisting of thirty persons, three from each tribe, elected by the Council. In cooperation with the six civil servants, they checked the admission of the citizens to the Assembly by distributing to them the \"symbols\" to ensure that only Athenian citizens attended the Assembly. This checking was particularly important as any violator was punished by death."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1750> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Minister (government office)"@en ;
    skos:scopeNote "Head of a goverment department. In contemporary republics, ministers are politicians appointed by the head of the executive (prime minister or president) and, according to the degree, in which the distinction of powers is implemented, they may be members of Parliament or not. In parliamentary republics and constitutional monarchies, the ministers form a collective body (Cabinet) that convenes under the prime minister, while in presidential republics ministers (called secretaries in the USA) have advisory functions as to the overall decision-making of the government."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1764> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1742> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Triremes builders"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1765> ;
    skos:scopeNote "Committees consisting of ten persons appointed by the Council. Their duty was to inspect the shipbuilding of triremes and pay off the contractors."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1795> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1583> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Hieropoios (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1744> ;
    skos:scopeNote "The members of the sacred commission (Hieropoioi) held the office of the Hieropoios with the primary task of overseeing sacred ceremonies and sacrifices, either on great feasts or in sanctuaries and temples."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1797> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/625> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Bote"@de,
        "Messenger"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1291> ;
    skos:scopeNote "Secondary figure of ancient Greek tragedy, usually anonymous. The basic function of the Messenger in the drama is to report off-stage action or events that occurred inside the palace which he has eye-witnessed to other characters on stage and the spectators."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1807> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/29> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Incuse (Numismatics)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444> ;
    skos:scopeNote "A design which is recessed into the surface of the flan rather than protruding in relief. Although frequently encountered on Greek coins, this characteristic is very rare in the Roman series, being confined to the legends on certain quadrigati and denarii of the Republican series."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1808> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1742> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Euthynoi"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1809> ;
    skos:scopeNote "Committees of officials selected by lot, who were responsible for the final audit of the financial reports provided by the various committees at the end of their term of office."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1810> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/289> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Barbers"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1948> ;
    skos:scopeNote "Professionals involved in the treatment of male hair mainly by haircut and shaving."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1824> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/28> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Determinism"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2471> ;
    skos:scopeNote "The view that every event or state of affairs is brought about by antecedent events or states of affairs in accordance with universal causal laws that govern the world. Thus, the state of the world at any instant determines a unique future, whereas for every instant of the past nothing different could have happened from what has already happened. There are many types of determinism, such as technological, psychological, theological and logical, all of which are considered incompatible with or problematic for the notions of free will, human choice and responsibility."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1828> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Probouleumata (Epigraphy)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/742> ;
    skos:scopeNote "Type of draft resolution that was issued during the decision-making process by the Council of ancient Athens. The probouleuma was the recording of a proposal for a matter made by a citizen or by the Council before publishing the resolution. A prerequisite for issuing the resolution was the ratification of the subject by the Assembly following discussion. The probouleuma was valid for as long as the Council which proposed it was in office, while it was unlawful for the Assembly to approve a resolution of a previous Council."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1831> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/19> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Aerial bombings"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1852> ;
    skos:scopeNote "Military operations aiming at destroying the infrastructure of the enemy, at demoralising him and at forcing him to surrender. Aerial bombings, which emerged in the framework of the total wars of the 20th century, have been often implemented against civilian targets and have caused immense casualties."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1844> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/19> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ethnic cleansing"@en ;
    skos:scopeNote "Intentional and coordinated actions aiming at the total -or to a great extent- elimination of an ethnic or national group from regions that either belong to a state's territory or are under its control in conditions of military occupation during war. Ethnic cleansing is pursued through mass murder by military or paramilitary groups, through forced expatriation, deportation and emigration, or (most often) through a combination of the above. The term is widely used after the ethnic conflicts that took place during the civil war of Yugoslavia."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1856> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Junk dealers"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1977> ;
    skos:scopeNote "Itinerant traders who collect or buy old and / or second-hand objects and resell them."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1912> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1731> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Novel of manners"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/255> ;
    skos:scopeNote "Τype of novel which describes in detail the&nbsp;customs, values, mores and expectations of a certain social group at a specific time and place. The novel of manners flourished in the 19th century."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1944> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/158> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Fur workshops"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/891> ;
    skos:scopeNote "Fur trading workshops or small shops."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1946> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/158> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Woollen mills"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1947> ;
    skos:scopeNote "Workshops for processing wool and woolen fabrics."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1947> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/205> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Wool production"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1946> ;
    skos:scopeNote "Textile processing of wool and the corresponding branch of economic activity for the production of yarns."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1948> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/158> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Barber shops"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1810> ;
    skos:scopeNote "Shops for the treatment of male hair involving mainly haircut and shaving."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1954> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Polemarchos (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1985> ;
    skos:scopeNote "An office that first appears in ancient Athens. One of the nine archons, his original duty was to command the army, but after 487/6 B.C., when the archontes began to be appointed by lot, this function was handed over to the strategoi. The other duties of the polemarchos were mainly religious and judiciary. The religious duties included the responsibility for organising sacrifices, funeral games in honour of the dead of war, etc. Judiciary duties involved hearing cases of persons who were not Athenian citizens."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1955> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Archon basileus (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1985> ;
    skos:scopeNote "An office that first appears in ancient Athens. One of the nine archons, he presided over the Areopagus and he was the supervisor of religious festivals like the Lenaea and the Mysteries. His jurisdiction included cases of claimants for priesthood, of impiety and of homicide."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1977> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/158> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
