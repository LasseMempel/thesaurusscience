		<skos:prefLabel xml:lang="gd">TOGALACH IOMA-CHÒMHNAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalaichean a chaidh a dhealbhadh mar àite-còmhnaidh airson mòran dhaoine seach teaghlaichean fa leth is msaa.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MULTIPLE DWELLING</skos:prefLabel>
