        <skos:altLabel xml:lang="de">bautechnische Prüfung</skos:altLabel>
        <skos:altLabel xml:lang="de">statische Untersuchung</skos:altLabel>
        <skos:note xml:lang="en">An assessment of the structural stability of the object under study and the surrounding building. (EwaGlos)</skos:note>
