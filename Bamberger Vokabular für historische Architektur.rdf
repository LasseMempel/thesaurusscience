        <skos:prefLabel xml:lang="es">fresco con tríglifos</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">frise à triglyphe</skos:prefLabel>
        <skos:prefLabel xml:lang="en">triglyph frieze</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">tryglyfon</skos:prefLabel>
    </owl:NamedIndividual>
    


