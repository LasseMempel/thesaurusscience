    <skos:scopeNote xml:lang="en">A meeting hall, or sale room in a town, for manufacturers and traders.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140505">
    <skos:scopeNote xml:lang="en">A construction designed to look like a pillbox in order to deceive or confuse the enemy.</skos:scopeNote>
  </rdf:Description>
