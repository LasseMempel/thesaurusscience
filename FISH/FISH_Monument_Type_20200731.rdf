    <skos:scopeNote xml:lang="en">A lift powered by an hydraulic system.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70084">
    <skos:scopeNote xml:lang="en">A small Anglo-Saxon cross-slab buried on the breast or beneath the head of a corpse.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69037">
    <skos:scopeNote xml:lang="en">Timber or metal structure consisting of upright and cross members designed to support climbing plants.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71645">
    <skos:scopeNote xml:lang="en">A place where people meet for entertainment, discussion or assembly. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70371">
    <skos:scopeNote xml:lang="en">A movable stucture which enables or prevents entrance to be gained. Usually situated in a wall or similar barrier and supported by gate posts.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167321">
    <skos:scopeNote xml:lang="en">A building, usually part of a complex, where medical treatment and hospital facilities are provided.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70147">
    <skos:scopeNote xml:lang="en">A friary belonging to the Pied Friars also known as Friars of Blessed Mary or St Mary de Arens.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93406">
    <skos:scopeNote xml:lang="en">A fort with a star trace plan, designed to increase the angles of fire.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/110893">
    <skos:scopeNote xml:lang="en">A crude, stone-built shelter for persons involved in lime production and the processing of lime burning.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170052">
    <skos:scopeNote xml:lang="en">Two or more adjacent locks where the upper gates of one lock serve as the lower gates of the next.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/121254">
