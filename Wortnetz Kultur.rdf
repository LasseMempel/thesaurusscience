		<skos:prefLabel xml:lang="en">cummerbund</skos:prefLabel>
		<skos:altLabel xml:lang="en">cummerbunds</skos:altLabel>
		<skos:prefLabel xml:lang="de">Kummerbund</skos:prefLabel>
		<skos:altLabel xml:lang="de">Kummerbunde</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk008873"/>
