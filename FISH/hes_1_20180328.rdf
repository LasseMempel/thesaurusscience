				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/710</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">STÒR SULFAIR</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Togalach far a bheilear a' stòradh pronnasg, eileamaid cheimigeach air a bheil feum airson maidsichean, fùdar-gunna agus searbhag phronnasgach a dhèanamh. Thathar ga chleachdadh ann an gealachadh cuideachd, airson rubair a vulcanadh agus mar dhì-ghalarach.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">SULPHUR STORE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/678" />
				<skos:scopeNote xml:lang="en">A building used for storing Sulphur, a chemical element used in the manufacture of matches, gunpowder and sulphuric acid. It is also used in bleaching, for vulcanizing rubber and as a disinfectant.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
