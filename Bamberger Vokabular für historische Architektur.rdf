        <skos:altLabel xml:lang="en">abito piano</skos:altLabel>
        <skos:altLabel xml:lang="fr">habit piano</skos:altLabel>
        <skos:definition xml:lang="de">Habitus m pianus, lat.: Kleidung von Prälaten bei festlichen Anlässen: Kollar und schwarze Soutane, deren Futter, Saum, Nähte und Knöpfe violett sind bzw. violett abgesetzt sind. Dazu kommen Ferraiolo, Pileolus, Birett und Brustkreuz, für Bischöfe noch die Zimarra. Diese recht komplizierte Kleiderordnung ist seit 1969 vereinfacht. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Habitus pianus</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">abito piano</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">abito piano</skos:prefLabel>
        <skos:prefLabel xml:lang="en">academic dress</skos:prefLabel>
    </owl:NamedIndividual>
    


