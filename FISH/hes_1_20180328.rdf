	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500622">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500622</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">MAINEAR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Pìos talmhainn a tha na thìrleach tighearna agus fearann air an togadh e cìsean àraidh is msaa.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MANOR</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-30T09:42:46</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-30T09:43:04</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/98" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/113" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1754" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1757" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1758" />
