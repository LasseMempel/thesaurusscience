        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-14T11:22:29.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:10:43.000</terms:modified>
        <skos:definition xml:lang="de">Kreuzgewölbe mit halbkreisförmigen Rand- und Kreuzbogen. Dem höheren Kreuzbogen entspricht die Anhebung des Gewölbescheitels durch einen Stich und die Ausbildung sphärischer Wölbflächen. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="en">Romanesque cross vault with semicircular diagonals</skos:prefLabel>
        <skos:prefLabel xml:lang="de">romanisches Kreuzgewölbe</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte d\&apos;arêtes romane</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_5f9418c5"/>
    </owl:NamedIndividual>
    


