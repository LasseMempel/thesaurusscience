    <!-- https://hist-arch-vocab.org/bvha#c_aad90b17 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_aad90b17">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_expxyogj"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T15:26:03.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T23:04:36.000</terms:modified>
        <skos:altLabel xml:lang="de">Steinplastik</skos:altLabel>
        <skos:definition xml:lang="de">Nach einer Tonskizze (it. bozzetto) wird meist ein Gipsmodell in natürlicher Größe geformt, nach diesem wird freihändig oder unter Kontrolle von Messgeräten das Original aus dem Stein geschlagen. Die halbfertigen Teile der Steinplastik nenntman »in der Bosse« stehend. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Podle hliněné skici (it. bozzetto) se zpravidla vytváří sádrový model ve skutečné velikosti, podle něhož se pak volně nebo pomocí měřicích přístrojů tesá originál z kamene. Polohotové části kamenné plastiky se nazývají &quot;v bose&quot;. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Steinskulptur</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kamenná plastika</skos:prefLabel>
        <broaderByConstructionMaterial rdf:resource="https://hist-arch-vocab.org/bvha#c_expxyogj"/>
    </owl:NamedIndividual>
    


