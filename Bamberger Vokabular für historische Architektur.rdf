        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_9b5a0097"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_d336298e"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_e61fe97f"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_f1d973da"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_fd3fd41e"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-10T17:19:11.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T13:59:52.000</terms:modified>
        <skos:altLabel xml:lang="de">pečetidlo</skos:altLabel>
        <skos:altLabel xml:lang="en">seal</skos:altLabel>
        <skos:altLabel xml:lang="la">signum</skos:altLabel>
        <skos:definition xml:lang="de">Siegel n: der Abdruck des Siegelstempels im Siegelstoff. Man unterscheidet Schriftsiegel (n), Bildsiegel (n), Porträtsiegel (n) und Wappensiegel (n). Das Siegel wird auf den Beschreibstoff gepresst (lat. sigillum impressum) oder als Hängesiegel (n), (lat. sigillum pendens) an der Urkunde befestigt. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Siegel n; lat. sigillum; signum: die in einen Siegelstempel (Petschaft n; Typar n) vertieft geschnittene Form zum Abdruck in den Siegelstoff, eine erweichte, später erhärtende Masse (Wachs, Blei, Gold; Siegellack ab 16. Jh.). [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Siegel</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">cachet</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">pečeť</skos:prefLabel>
        <skos:prefLabel xml:lang="en">seal-matrix</skos:prefLabel>
        <skos:prefLabel xml:lang="la">sigillum</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_aaf2a23b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_aaf2a23b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
