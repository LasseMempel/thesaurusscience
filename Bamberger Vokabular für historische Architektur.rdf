        <skos:altLabel xml:lang="de">flaches Gewölbe</skos:altLabel>
        <skos:altLabel xml:lang="fr">plafond appareillé</skos:altLabel>
        <skos:definition xml:lang="de">Ebene, jedoch aus Keilsteinen gebildete Decke, vorwiegend über Fenstern oder Türen vorkommt. Es werden die für das echte Gewölbe üblichen Mauerverbände ausgeführt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="en">flat vault</skos:prefLabel>
        <skos:prefLabel xml:lang="de">scheitrechtes Gewölbe</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte plate clavée</skos:prefLabel>
        <broaderByConstruction rdf:resource="https://hist-arch-vocab.org/bvha#c_049c4c22"/>
    </owl:NamedIndividual>
    


