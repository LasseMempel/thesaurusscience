				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/995" />
				<skos:scopeNote xml:lang="en">A kiln principally used in brick making which gives a continuous operation.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
