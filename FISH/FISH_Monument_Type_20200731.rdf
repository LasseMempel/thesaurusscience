  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70215">
    <skos:scopeNote xml:lang="en">A bridge over a canal.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/97269">
    <skos:scopeNote xml:lang="en">A place from where rescue missions are co-ordinated and casualties treated after an accident, offensive action or disaster.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69213">
    <skos:scopeNote xml:lang="en">Use only where evidence is specific, ie. copper/tin alloy. For working of copper based alloys of unknown composition use COPPER WORKING SITE.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91783">
