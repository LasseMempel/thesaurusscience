        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-09T15:34:10.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T17:32:13.000</terms:modified>
        <skos:altLabel xml:lang="de">Himmel</skos:altLabel>
        <skos:altLabel xml:lang="de">Prozessionshimmel</skos:altLabel>
        <skos:altLabel xml:lang="de">Tragbaldachin</skos:altLabel>
        <skos:altLabel xml:lang="fr">ciel portatif</skos:altLabel>
        <skos:altLabel xml:lang="la">coelum</skos:altLabel>
        <skos:altLabel xml:lang="fr">dais de procession</skos:altLabel>
        <skos:altLabel xml:lang="cs">přenosný baldachýn</skos:altLabel>
        <skos:altLabel xml:lang="la">umbella</skos:altLabel>
        <skos:definition xml:lang="de">Traghimmel m, Tragbaldachin m, auch Prozessionshimmel m, Himmel m, an Tragstangen befestigtes Stoffdach, das bei Prozessionen über dem Allerheiligsten sowie beim feierlichen Ein- und Auszug über dem Bischof getragen wird. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Traghimmel</skos:prefLabel>
        <skos:prefLabel xml:lang="la">baldachinus</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">dais portatif</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">nebesa</skos:prefLabel>
        <skos:prefLabel xml:lang="en">processional canopy</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_b41be637 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b41be637">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_8fc667ec"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-15T16:19:22.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T15:13:23.000</terms:modified>
        <skos:altLabel xml:lang="de">Palast</skos:altLabel>
        <skos:altLabel xml:lang="de">Palazzo</skos:altLabel>
        <skos:definition xml:lang="de">(lat. palatium) Der Begriff wird heute allg. für Königs- oder Fürstensitze, aber auch für öffentl. Gebäude oder für monumentale städt. Wohnhäuser, die nur von einer Familie bewohnt werden (Palais, Palazzo), verwandt. Der Name ist von den röm. Kaiserbauten abgeleitet, die auf dem Palatin standen. [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Allgemeine Bezeichnung für einen prachtvollen, in der Stadt gelegenen herrschaftlichen Wohnsitz. Der Name leitet sich von den Wohn- und Repräsentationsbauten der römischen Kaiser auf dem Palatin in Rom her. Prägend für den Architekturtypus der Neuzeit war der italienische Palazzo des 15. Jhs. Später wurde der Begriff P. auch auf anspruchsvolle Gebäude ohne Wohnfunktion übertragen, z. B. Justizpalast. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:prefLabel xml:lang="en"> palace</skos:prefLabel>
        <skos:prefLabel xml:lang="es"> palacio</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Palastanlage</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">palais</skos:prefLabel>
        <skos:prefLabel xml:lang="it">palazzo</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">palác </skos:prefLabel>
    </owl:NamedIndividual>
    


