	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk020554">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Anspitzer</skos:prefLabel>
		<skos:altLabel xml:lang="de">Bleistiftanspitzer</skos:altLabel>
		<skos:altLabel xml:lang="de">Bleistiftschärfer</skos:altLabel>
		<skos:altLabel xml:lang="de">Bleistiftspitzer</skos:altLabel>
		<skos:prefLabel xml:lang="en">pencil sharpener</skos:prefLabel>
		<skos:altLabel xml:lang="en">pencil sharpeners</skos:altLabel>
		<skos:altLabel xml:lang="de">Spitzer</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004633"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk018334"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk020553"/>
		<skos:definition xml:lang="de">Ein Anspitzer ist ein Gerät zum Formen und Schärfen der Spitze von Holzstiften und Minen. Er besteht in der Regel aus einem Gehäuse mit einer scharfen Klinge, die den Holz- oder Kunststoffmantel des Stifts abträgt, um eine feine Schreib- oder Zeichenspitze zu erzeugen. Anspitzer können manuell oder elektrisch betrieben sein und einen Auffangbehälter besitzen.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300022521"/>
