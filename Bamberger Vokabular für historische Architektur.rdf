        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-20T18:53:00.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T14:59:31.000</terms:modified>
        <skos:note xml:lang="en">A finely ground active material used as a binder which, when mixed with water, forms a paste that sets and hardens, both in air or water. [EwaGlos]</skos:note>
        <skos:note xml:lang="de">Ein fein gemahlenes, aktives Material, das als Bindemittel benutzt wird und mit Wasser eine Paste bildet, die sowohl unter Wasser als auch in der Luft abbindet und aushärtet. [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="en">hydraulic binder</skos:prefLabel>
        <skos:prefLabel xml:lang="de">hydraulisches Bindemittel</skos:prefLabel>
    </owl:NamedIndividual>
    


