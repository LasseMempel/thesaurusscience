  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92556">
    <skos:scopeNote xml:lang="en">A stone erected to mark a particular spot in the landscape. Can be used for various reasons.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91521">
    <skos:scopeNote xml:lang="en">An outlying farm or estate belonging to the Cluniac order.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87720">
    <skos:scopeNote xml:lang="en">For the disposal of town refuse. Some 19th century plants were linked to a power station. Later ones incorporate INCINERATORS, recycling facilities, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/90982">
    <skos:scopeNote xml:lang="en">An official residence of an abbot during the summer months.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160255">
    <skos:scopeNote xml:lang="en">A concrete, circular concave dish 20 feet in diameter used as an acoustic listening device to detect approaching enemy aircraft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91751">
    <skos:scopeNote xml:lang="en">The residence of a dock worker.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93577">
    <skos:scopeNote xml:lang="en">Buildings, sites and structures associated with the manufacture of timber products.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68740">
    <skos:scopeNote xml:lang="en">A type of Roman lodging house, frequently sited near the town gate.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/137170">
    <skos:scopeNote xml:lang="en">A building with small observation ports used for plotting mines dropped by parachute.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87666">
    <skos:scopeNote xml:lang="en">A market where fish is sold.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70078">
    <skos:scopeNote xml:lang="en">A building or site where bodies are burnt, and the ashes collected for burial or dispersal.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167069">
    <skos:scopeNote xml:lang="en">A site, usually including hardstandings and associated buildings, where ambulances can be parked and stored.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69004">
