        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-25T23:06:14.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T21:10:59.000</terms:modified>
        <skos:altLabel xml:lang="de">Kantenblume</skos:altLabel>
        <skos:altLabel xml:lang="de">Knolle</skos:altLabel>
        <skos:altLabel xml:lang="de">Kriechblume</skos:altLabel>
        <skos:altLabel xml:lang="cs">žába</skos:altLabel>
        <skos:definition xml:lang="de">Krabbe, Kantenblume, Knolle, got. Kriechblume an den Kanten von Fialen, Wimperggiebeln, Turmpyramiden u. dergl. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Kriechblume auf den Kanten von gotischen Turmhelmen, Fialen, Wimpergen. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Ozdoba na hranách gotických věží, fiál, vimperků. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Krabbe</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">krab</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_7dee71a1 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_7dee71a1">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0ea453f7"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_f8bf69ba"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_0e7ca4ab"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_81c56447"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_83e770d8"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-14T11:29:36.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T15:07:57.000</terms:modified>
        <skos:altLabel xml:lang="de">Münster</skos:altLabel>
        <skos:altLabel xml:lang="cs">dóm</skos:altLabel>
        <skos:altLabel xml:lang="cs">katedrála</skos:altLabel>
        <skos:altLabel xml:lang="cs">münster</skos:altLabel>
        <skos:altLabel xml:lang="cs">velechrám</skos:altLabel>
        <skos:definition xml:lang="de">Die im Gegensatz zur gr. K. (Katholikon) meist langgestreckte Kirche eines Klosters, die in der Regel an der Nordseite des Kreuzgangs liegt. Sie folgt den jeweiligen Stiltendenzen, fällt aber auch bei manchen Orden durch Besonderheiten auf. So verwenden Hirsauer und Cluniazenser manchmal einen rechteckigen Schluss des Chors und vermeiden Westchöre und Krypten. Die Zisterzienser verwenden ebenfalls manchmal einen Rechteckschluss, den sie in einigen Fällen durch Kapellen (Bußkapellen) erweitern, die in der Regel auch am Ostende des Querhauses liegen. Der Mönchschor ist in vielen K.n durch einen Lettner vom Laienschiff getrennt. Die Zisterzienserkirchen sind ebenso wie die Kirchen der Bettelorden (Franziskaner, Dominikaner) bis auf kleine hölzerne Dachreiter turmlos, die Bettelordenskirchen auch meist ohne Querhaus und im Langhaus oft flach gedeckt. In der Barockzeit unterscheidet sich der Typ der K. nicht mehr wesentlich von der Erscheinungsform anderer Kirchenbauten. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Lat. monasterium = klášter. Jihoněmecký výraz pro dóm, původně se tak nazýval celý klášterní objekt, později jen klášterní kostel, dnes název pro katedrálu nebo hlavní městský kostel. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Münster (Iat. monasterium = Kloster), süddeutsche Bezeichnung für Dom. Münster hieß ursprünglich die gesamte Klosteranlage, dann nur die Klosterkirche. Heute Name einer Kathedrale oder städtischen Hauptkirche. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Klosterkirche</skos:prefLabel>
        <skos:prefLabel xml:lang="es">catedral</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">cathédrale</skos:prefLabel>
        <skos:prefLabel xml:lang="it">duomo</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">hlavní klášterní kostel</skos:prefLabel>
        <skos:prefLabel xml:lang="en">minster</skos:prefLabel>
        <broaderByPosition rdf:resource="https://hist-arch-vocab.org/bvha#c_0ea453f7"/>
    </owl:NamedIndividual>
    


