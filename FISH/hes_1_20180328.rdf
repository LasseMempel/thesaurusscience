				<skos:prefLabel xml:lang="gd">IONAD-TASGAIDH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Seòmar no togalach a chleachdar mar stòras, mar is trice airson sgrìobhainnean, obair-ealain, leabhraichean is msaa.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">REPOSITORY</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-03-10T15:03:43</dcterms:created>
