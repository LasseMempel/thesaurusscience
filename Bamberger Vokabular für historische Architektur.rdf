    <!-- https://hist-arch-vocab.org/bvha#c_c9563214 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_c9563214">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_3da3c0b4"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-28T15:44:50.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-12T16:58:46.000</terms:modified>
        <skos:definition xml:lang="de">Cairn, Carn (gäl.-ir.), frühgeschichtl. Grabmal in Form eines pyramidenförmig aufgeschichteten Steinhaufens, bes. in England und Irland; dort auch Bezeichnung für ebenso gebildete Grenzmale und Wegzeichen. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Cairn</skos:prefLabel>
    </owl:NamedIndividual>
    


