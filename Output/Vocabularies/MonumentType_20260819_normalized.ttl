    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "SHIP BURIAL"@en ;
    skos:scopeNote "A burial in which the body is placed in, or covered by a boat, which is then covered with earth. Use with barrow type where relevant."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70037> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70018> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "TILE BURIAL"@en ;
    skos:scopeNote "An inhumation, usually Roman, which has been covered by tiles to form a tent-like structure over the body; the apex is covered by ridge tiles."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70040> a skos:Concept ;
    skos:altLabel "Bustum"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70038> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "CREMATION PIT"@en ;
    skos:scopeNote "A pit over which a  corpse has been cremated on a pyre into which the remains and debris, and sometime grave goods, collapse and are buried. Generally confined to the Roman period."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70041> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70038> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "PLAGUE PIT"@en ;
    skos:scopeNote "A deep pit used for the burial of plague victims."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70043> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70042> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "FAMILY VAULT"@en ;
    skos:scopeNote "A burial vault built to contain the remains of members of a single family, household or dynasty."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70046> a skos:Concept ;
    skos:altLabel "Gallery Grave"@en,
        "Long Cist"@en,
        "Transepted Gallery Grave"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70045>,
