        <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
        <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
        <skos:prefLabel xml:lang="en">Severan</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Referring to the Severan dynasty who were Emperors of Rome in 193-235 CE.</skos:scopeNote>
        <skos:notation xml:lang="en">ROSE</skos:notation>
      </skos:Concept>
    </skos:narrower>

    <time:hasBeginning xml:lang="en">0043</time:hasBeginning>
    <time:hasEnd xml:lang="en">0410</time:hasEnd>
    <skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/RO"/>
    <skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/11/concepts/505126"/>
    <skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300020541"/>
    <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_period"/>
    <dc:identifier>http://purl.org/heritagedata/schemes/eh_period/concepts/RO</dc:identifier>
    <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-17T16:46:30</dc:issued>
    <cc:license rdf:resource="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"/>
    <cc:attributionURL rdf:resource="https://historicengland.org.uk/"/>
    <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
    <dc:publisher rdf:resource="https://historicengland.org.uk/"/>
    <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
    <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
    <skos:prefLabel xml:lang="en">Roman</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The Roman period traditionally begins with the Roman invasion in 43AD and ends with the emperor Honorius directing Britain to see to it's own defence in 410AD. Circa 43 CE to 410 CE.</skos:scopeNote>
    <skos:notation xml:lang="en">RO</skos:notation>
  </skos:Concept>

  <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_period/concepts/UN">
    <skos:altLabel xml:lang="en">Unknown</skos:altLabel>
    <skos:broader rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/period"/>
