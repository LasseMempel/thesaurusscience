    <skos:scopeNote xml:lang="en">A site where millstones have been cut to shape and/or fabricated from smaller pieces of stone.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140105">
    <skos:scopeNote xml:lang="en">A place where two artificial waterways meet each other.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91661">
    <skos:scopeNote xml:lang="en">A component part of a treadmill crane, the shed is used to enclose the treadwheel.</skos:scopeNote>
