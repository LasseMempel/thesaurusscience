        <http://purl.org/heritagedata/schemes/571/concepts/160166> ;
    skos:scopeNote "Land enclosed from woodland. Required licence in medieval period. Term applied more generally in landscape history. Can include planned and regular enclosures and piecemeal irregular ones. Often still with numerous trees on boundaries."@en .

<http://purl.org/heritagedata/schemes/571/concepts/160157> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151727> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Barton Demesne Fields"@en ;
    skos:related <http://purl.org/heritagedata/schemes/571/concepts/160155>,
        <http://purl.org/heritagedata/schemes/571/concepts/160166> ;
    skos:scopeNote "Field patterns established by lord of an estate, usually as closes (bounded individual fields), in distinction to the open common fields of tenants. They tend to be relatively large fields."@en .

<http://purl.org/heritagedata/schemes/571/concepts/160163> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151453> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Modern Enclosed Land"@en ;
    skos:related <http://purl.org/heritagedata/schemes/571/concepts/151281>,
        <http://purl.org/heritagedata/schemes/571/concepts/151787> ;
    skos:scopeNote "Farmland, whose predominant character developed since World War 2. Usually broad-brush characterisation that includes farming settlement and various land use."@en .

<http://purl.org/heritagedata/schemes/571/concepts/160215> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151450> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
