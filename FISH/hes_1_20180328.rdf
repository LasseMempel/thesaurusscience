		<skos:prefLabel xml:lang="gd">IONAD OBAIR-MHEATAILT</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Factaraidh far a bheilear ag obair air meatailt. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">METAL WORKING SITE</skos:prefLabel>
