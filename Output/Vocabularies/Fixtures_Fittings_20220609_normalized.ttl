    skos:inScheme <http://purl.org/heritagedata/schemes/572> ;
    skos:prefLabel "Centreboard"@en ;
    skos:scopeNote "A board which can be lowered in a shallow draught vessel to increase the vessel's lateral area and keel thus increasing the resistance to leeway."@en .

<http://purl.org/heritagedata/schemes/572/concepts/146558> a skos:Concept ;
