		<skos:altLabel xml:lang="de">Bierhumpen</skos:altLabel>
		<skos:prefLabel xml:lang="de">Bierkrug</skos:prefLabel>
		<skos:altLabel xml:lang="de">Bierkrüge</skos:altLabel>
		<skos:altLabel xml:lang="de">Bierseidel</skos:altLabel>
