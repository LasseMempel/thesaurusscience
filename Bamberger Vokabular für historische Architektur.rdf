    <!-- https://hist-arch-vocab.org/bvha#c_7e73a008 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_7e73a008">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a4d58de0"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_f10222e0"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-11-14T14:25:35.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T14:22:42.000</terms:modified>
        <skos:prefLabel xml:lang="de">Prinzipalbogen</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Der Prinzipalbogen ist eine Methode zur Gewölbekonstruktion, die nachweislich in der Spätgotik zum Einsatz kam. Aus einem Bogenschlag, dem Prinzipalbogen, leiten sich alle Rippenprofile eines Gewölbes ab, d.h. alle Rippenprofile erhalten denselben Halbmesser.  [BVHA]</skos:scopeNote>
    </owl:NamedIndividual>
    


