	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk008647">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">mask (costume)</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Maske (Kostümierung)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Masken (Kostümierungen)</skos:altLabel>
		<skos:altLabel xml:lang="en">masks (costumes)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk012175"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk005711"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk012090"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk017956"/>
		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk020930"/>
		<skos:scopeNote xml:lang="de">Verwendet für Masken, die das Gesicht bedecken und im Zusammenhang mit einer Verkleidung stehen. Für Masken, die dem Schutz dienen, benutze Atemmaske (Schutzausrüstung) (wk017587). Für Masken, die nicht zur Kleidung gehören, sondern etwa als Schmuck an Objekten dienen, benutze Maske (Bildwerk) (wk020930).</skos:scopeNote>
		<skos:definition xml:lang="de">Eine Maske ist ein Kleidungsstück, das das Gesicht ganz oder teilweise verdeckt. Sie kann auch über das Gesicht hinaus den Kopf bedecken. In der Regel gibt es Öffnungen für die Augen, Mund oder Nase. Sie wird hauptsächlich zur Veränderung des Aussehens, zur Verschleierung der Identität getragen; vor allem im Zusammenhang mit Bräuchen, Zeremonien oder aus künstlerischen Aspekten.</skos:definition>
		<skos:mappingRelation rdf:resource="http://d-nb.info/gnd/4037845-7"/>
		<skos:mappingRelation rdf:resource="http://vocab.getty.edu/aat/300138758"/>
		<skos:mappingRelation rdf:resource="https://www.wikidata.org/wiki/Q161524"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk005711"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk017956"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk012090"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
