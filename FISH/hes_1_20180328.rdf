		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1221" />
		<skos:scopeNote xml:lang="en">An ancillary building, usually to provide gas for lighting a particular building (eg. railway stations, factories, etc) as opposed to public GAS WORKS.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
