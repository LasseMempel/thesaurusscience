		<skos:prefLabel xml:lang="gd">TAIGH-BRACHA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach sa bheil àthan-brachaidh airson brachadh shìol agus le acainnean eile coltach ri sin airson obair-ghrùide.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MALT HOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
