    <!-- https://hist-arch-vocab.org/bvha#c_3d48cec6 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_3d48cec6">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f88a153a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_b41bd73a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-11T16:32:26.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-27T08:47:23.000</terms:modified>
        <skos:altLabel xml:lang="cs">posunovací okno</skos:altLabel>
        <skos:altLabel xml:lang="cs">stahovací okno</skos:altLabel>
        <skos:definition xml:lang="de">Ein Fenster, bei dem ein Flügel seitl. verschoben werden kann. Der Begriff S. wird heute aber auch für Fenster verwendet, deren unterer Flügel nach oben gegen einen feststehenden oder sich herabsenkenden Flügel bewegt wird (Hebefenster). Beim Senkfenster wird hingegen der untere Flügel in die Zone der Fensterbrüstung bzw. des Fußbodens versenkt. [Koepf /Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Fenster mit einem oder mehreren horizontal oder vertikal in Laufnuten in der Konstruktion des Fensterahmens verschiebbaren Fensterflügeln. [Noky 1996]</skos:definition>
        <skos:prefLabel xml:lang="de">Schiebefenster</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">fenêtre coulissante</skos:prefLabel>
        <skos:prefLabel xml:lang="it">finestra scorrevole</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">posuvné okno</skos:prefLabel>
        <skos:prefLabel xml:lang="en">sliding window</skos:prefLabel>
        <skos:prefLabel xml:lang="es">ventana corrediza</skos:prefLabel>
        <broaderByConstruction rdf:resource="https://hist-arch-vocab.org/bvha#c_f88a153a"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_3d4b52da -->


