        <skos:altLabel xml:lang="de">Segen</skos:altLabel>
        <skos:definition xml:lang="de">Segnung f; lat. benedictio: das Herabflehen der göttlichen Gnade durch den Priester und die Vermittlung der Gnade durch die Segensspendung des Priesters mit dem Kreuzeszeichen. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Segnung</skos:prefLabel>
        <skos:prefLabel xml:lang="la">benedictio</skos:prefLabel>
        <skos:prefLabel xml:lang="ru">blagoslovinie</skos:prefLabel>
