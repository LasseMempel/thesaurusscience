		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/263" />
		<skos:scopeNote xml:lang="en">A building or group of buildings situated close to the sea, used by coastguards to enable them to monitor the coastline.</skos:scopeNote>
