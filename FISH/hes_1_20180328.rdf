		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/99" />
		<skos:scopeNote xml:lang="en">An area of land consisting of the lord's demesne and of lands from whose holders he may exact certain fees, etc.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
