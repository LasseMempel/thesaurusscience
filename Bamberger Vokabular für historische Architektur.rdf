    <!-- https://hist-arch-vocab.org/bvha#c_7c503d2b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_7c503d2b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_16d20867"/>
