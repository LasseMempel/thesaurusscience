		<skos:prefLabel xml:lang="gd">MUILEANN-STAOIN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Muileann a thathar ga chleachdadh ann an ullachadh clach-thiona le bhith ga sgrìobadh, ga stampadh no ga leaghadh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TIN MILL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
