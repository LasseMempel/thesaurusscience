    <!-- https://hist-arch-vocab.org/bvha#c_139610df -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_139610df">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_96916a56"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_ed43f447"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_34ca6582"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-08T19:20:45.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T16:24:58.000</terms:modified>
        <skos:altLabel xml:lang="de">Absanden</skos:altLabel>
        <skos:altLabel xml:lang="de">Bröckelzerfall</skos:altLabel>
        <skos:definition xml:lang="de">Ablösung von Kornaggregaten vom Substrat. Diese Aggregate besitzen allgemein eine begrenzte Größe von unter 2 cm. Die Größe hängt vom Gestein und von den Umgebungsbedingungen ab. [ICOMOS-ISCS] </skos:definition>
        <skos:definition xml:lang="en">Detachment of aggregates of grains from the substrate. These aggregates are generally limited in size (less than 2 cm). This size depends of the nature of the stone and its environment. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="fr">Détachement d’agrégats de grains de pierre. Ces agrégats ont une taille généralement inférieure à 2 cm, liée à la nature et à l’environnement de la pierre. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="cs">Oddělování agregátů zrn od substrátu. Tyto agregáty jsou všeobecně omezeny velikostí (méně než 2 cm). Velikost závisí na druhu kamene, jeho struktuře a okolním prostředí. [ICOMOS-ISCS] </skos:definition>
        <skos:note xml:lang="en">The disintegration of a material into small pieces as a result of chemical, physical or biological deterioration; the loss of cohesion between component materials, which can be due to gradual dissolution of the binder. [EwaGlos]</skos:note>
        <skos:note xml:lang="de">Zerfall eines Materials in kleine Bruchstücke in der Folge von chemischer, physikalischer oder biogener Schädigung. Bindungsverlust von Materialgefüge, was auf allmählicher Zersetzung des Bindemittels beruhen kann. [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="de">Abbröckeln</skos:prefLabel>
        <skos:prefLabel xml:lang="en">crumbling</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">emiettement</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">rozdrolení</skos:prefLabel>
    </owl:NamedIndividual>
    


