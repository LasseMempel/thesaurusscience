    skos:exactMatch <http://eurovoc.europa.eu/4711> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Neustadt"@de,
        "new town"@en .

<http://www.eionet.europa.eu/gemet/concept/11333> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4666> ;
    skos:definition "Areas that are subject to the pre-emption right which is a privilege accorded by the government to the actual settler upon a certain limited portion of the public domain, to purchase such tract at a fixed price to the exclusion of all other applicants."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Gebiet mit Vorkaufsrecht"@de,
        "pre-emption zone"@en .

<http://www.eionet.europa.eu/gemet/concept/11334> a skos:Concept ;
