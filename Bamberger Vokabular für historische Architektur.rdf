        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_9002c144"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_99dbbfad"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_a1be7983"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_bd954b8c"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_c222baae"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_c3f768ad"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_c5c2e421"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_cee75313"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_d1112130"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_e23ba4eb"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_fa1d8f19"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_16d20867"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_783f2c73"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_eieuwx7k"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T12:22:05.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T11:49:45.000</terms:modified>
        <skos:altLabel xml:lang="de">Arma Christi</skos:altLabel>
        <skos:altLabel xml:lang="en">Instruemtns of the Passion</skos:altLabel>
        <skos:altLabel xml:lang="fr">Instruments de la Passion</skos:altLabel>
        <skos:altLabel xml:lang="de">Leidenswerkzeug</skos:altLabel>
        <skos:altLabel xml:lang="cs">pašijové nástroje</skos:altLabel>
        <skos:definition xml:lang="de">Die Leidenswerkzeuge, die bei der Passion Christi angewendet wurden: Nägel, Ruten, Geißel, Dornenkrone, Lanze, Essigschwamm auf einem Rohrstock usw., bis zu 30 verschiedene Teile, darunter auch solche, die nur zum Randgeschehen gehören, wie Zange, Schweißtuch, Würfel. Sie werden seit dem Mittelalter oft als Symbole des Leidens Christi dargestellt, so auf dem Fastentuch und der Martersäule. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Passionswerkzeuge n pl; Arma Christi pl (lat.); Leidenswerkzeuge n pl Christi: die Attribute des Leidens Christi, dargestellt schon im 10. und 11. Jh., häufig in der Plastik und Malerei des späteren Mittelalters. Ihre vollständigste Wiedergabe, nämlich mit dreißig Gegenständen, fanden sie am Gestühl der Klosterkirche zu Berlin vom Jahre 1383. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="cs">Též pašijové nástroje. Zbraně a nástroje, které byly použity při mučení Ježíše Krista: hřeby, důtky, bič, trnová koruna, kopí, houba namočená do octa na holi atd., až 30 různých předmětů včetně okrajových, jako jsou kleště, rouška na osušení potu, kostky; od středověku bývají zobrazovány jako symboly Kristova utrpení, např. na postním suknu a na pašijovém sloupu. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="la">Arma Christi</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Armes du Christ</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Arms of Christ</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Passionswerkzeug</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">nástroje Kristova utrpení</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_77d715fa -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_77d715fa">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_7becmxjs"/>
