    <skos:prefLabel xml:lang="en">TIME GUN</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A gun, usually fired remotely by means of an electric current, formerly used to signal a specific time of day to inform the local inhabitants or workers in an area.</skos:scopeNote>
