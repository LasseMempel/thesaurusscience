    <skos:scopeNote xml:lang="en">A hoisting mechanism powered by electricity.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143175">
