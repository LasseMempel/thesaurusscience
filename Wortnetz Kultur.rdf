		<skos:prefLabel xml:lang="de">Dreikönigsball</skos:prefLabel>
		<skos:altLabel xml:lang="de">Dreikönigsbälle</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk009760"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013778"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk009760"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk006570"/>
		<xe:explanation_temp xml:lang="de">Zu Beginn des 20. Jahrhunderts wurden die Dreikönigsbälle zu einem öffentlichen Ereignis. In einem sogenannten Königskuchen wurde eine Bohne versteckt, wer sie fand, wurde zum Bohnenkönig ernannt. Heute wird der traditionelle Dreikönigsball oder Bohnenball, mit einer Bohnenkönigswahl, von vielen Ortsvereinen oder Pfarrgemeinden wieder neu belebt.</xe:explanation_temp>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk009760"/>
