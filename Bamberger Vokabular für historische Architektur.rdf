    <!-- https://hist-arch-vocab.org/bvha#c_2a92b62b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_2a92b62b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
