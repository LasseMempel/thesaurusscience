		<gvp:aat2815_composed_of rdf:resource="http://lvr.vocnet.org/wnk/wk000254"/>
		<skos:definition xml:lang="de">Bruchsteinmauerwerk ist ein Mauerwerk, bei dem die Steine so verwendet werden, wie sie aus dem Bruch kommen.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002319"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010555"/>
