		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk002289"/>
		<skos:definition xml:lang="de">Ein Fachwerkgeschossbau ist ein Holzfachwerkbau, dessen Hauptständer von der Schwelle bis zur Traufe durchlaufen, sodass die einzelnen Geschosse in diese Ständer eingehängt sind.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002289"/>
