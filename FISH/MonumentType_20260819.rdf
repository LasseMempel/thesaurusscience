    <skos:prefLabel xml:lang="en">DISC BARROW</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A round barrow featuring a small mound separated from a ditch of much greater diameter by a wide berm. The ditch may be accompanied by an external (or occasionally internal) bank.</skos:scopeNote>
    <dc1:identifier rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70015"/>
