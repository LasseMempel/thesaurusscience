		<skos:prefLabel xml:lang="en">Carnival (pre-Lenten festival)</skos:prefLabel>
		<skos:prefLabel xml:lang="en-US">Carnival Days</skos:prefLabel>
		<skos:altLabel xml:lang="de">Fasteleer</skos:altLabel>
		<skos:altLabel xml:lang="de">Fastelovend</skos:altLabel>
