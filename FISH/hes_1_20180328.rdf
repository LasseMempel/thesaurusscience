	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500526">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500526</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">DROCHAID CEUM-TARRAING</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Drochaid far a bheil an ceum-tarraing a' dol thairis air a' chanal.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ROVING BRIDGE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-26T14:53:39</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-26T14:55:03</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1786" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1870" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500525" />
		<skos:scopeNote xml:lang="en">A bridge which takes the towpath across the canal.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
