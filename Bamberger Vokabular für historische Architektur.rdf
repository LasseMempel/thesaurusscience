    <!-- https://hist-arch-vocab.org/bvha#c_b50b7a5b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b50b7a5b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_9jb9am2u"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_5bf6bcac"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-15T15:48:22.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-15T15:53:38.000</terms:modified>
        <skos:altLabel xml:lang="de">Abbeizer</skos:altLabel>
        <skos:altLabel xml:lang="de">Abbeizmittel</skos:altLabel>
        <skos:definition xml:lang="de">Wässrige, alkalische Lösung einer starken Lauge, mit der Altanstriche und Beschichtungen wie Ölfarben, Lacke und Lasurfarben chemisch so umgewandelt werden, dass sie gelöst und entfernt werden können. Bei der Anwendung auf Holz werden dessen Strukturen trotz einer etwaigen Neutralisierung mit Essigsäure und Nachwaschen mit Wasser geschädigt. [Schrader / Voigt 2003]</skos:definition>
        <skos:prefLabel xml:lang="de">Ablauger</skos:prefLabel>
    </owl:NamedIndividual>
    


