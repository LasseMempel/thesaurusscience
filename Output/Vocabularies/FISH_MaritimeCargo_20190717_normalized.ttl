    skos:scopeNote "Steel, usually unworked, in the form of bars."@en .

<http://purl.org/heritagedata/schemes/77/concepts/110973> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/79002> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Pilchards"@en ;
    skos:scopeNote "Small fish, Sardina pilchardus, common to European waters and eaten as a food fish."@en .

<http://purl.org/heritagedata/schemes/77/concepts/110974> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/88458> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Pimentos"@en ;
    skos:scopeNote "Sweet red peppers."@en .

<http://purl.org/heritagedata/schemes/77/concepts/111793> a skos:Concept ;
    skos:altLabel "Gold Specie"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/78961> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Gold Coin"@en ;
    skos:scopeNote "Gold fashioned into coins for use as currency."@en .

<http://purl.org/heritagedata/schemes/77/concepts/111794> a skos:Concept ;
    skos:altLabel "Silver Specie"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/78961> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Silver Coin"@en ;
    skos:scopeNote "Silver fashioned into coin for use as currency."@en .

<http://purl.org/heritagedata/schemes/77/concepts/118633> a skos:Concept ;
    skos:altLabel "Coal Patent Fuel"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/78951> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Patent Fuel"@en ;
    skos:scopeNote "A mixture of coals that have been formed into briquettes or blocks. This fuel took its name from the fact that it was under patent in the late nineteenth century."@en .

<http://purl.org/heritagedata/schemes/77/concepts/139331> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/110933> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Coprolites"@en ;
    skos:scopeNote "Fossilized animal dung, often ground into powder and used as fertilizer."@en .

<http://purl.org/heritagedata/schemes/77/concepts/139805> a skos:Concept ;
    skos:altLabel "Pumice Stones"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/79195> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Pumice"@en ;
    skos:scopeNote "A light porous acid volcanic rock used for scouring and, in powdered form, as an abrasive and for polishing. Also used to make lightweight concrete."@en .

<http://purl.org/heritagedata/schemes/77/concepts/139811> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/109313> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Toys"@en ;
    skos:scopeNote "Objects designed to be played with, often a model or miniature replica of something and especially for a child."@en .

<http://purl.org/heritagedata/schemes/77/concepts/139812> a skos:Concept ;
    skos:altLabel "Bikes"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/79222> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Bicycles"@en ;
    skos:scopeNote "Two-wheeled vehicles for personal transport with pedals for propulsion by the rider."@en .

<http://purl.org/heritagedata/schemes/77/concepts/140266> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/79135> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Madder"@en ;
    skos:scopeNote "A climbing plant (Rubia tinctorum) which was formerly cultivated for the reddish-purple dye obtained from the roots."@en .

<http://purl.org/heritagedata/schemes/77/concepts/140443> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/79041> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Clocks"@en ;
    skos:scopeNote "Instruments for measuring and displaying time. Often manufactured as a piece of furniture e.g.a grandfather clock."@en .

<http://purl.org/heritagedata/schemes/77/concepts/140444> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/109313> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Pens"@en ;
    skos:scopeNote "Writing implements; formerly quill pens made of bird feathers, and in more modern times fountain pens made of various materials with metal nibs, both used with ink to write."@en .

<http://purl.org/heritagedata/schemes/77/concepts/140469> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/78965> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Crates"@en ;
    skos:scopeNote "Wooden boxes or cases for carrying fruit and other similar goods."@en .

<http://purl.org/heritagedata/schemes/77/concepts/140474> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/82879> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Earthenware"@en ;
    skos:scopeNote "Ceramic vessels made from potash, sand, feldspar and clay which is biscuit fired at a temperature of around 1000 degree Celsius. Usually glazed in order to become watertight."@en .

<http://purl.org/heritagedata/schemes/77/concepts/141224> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/141269> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Human Hair"@en ;
    skos:scopeNote "Cut human hair, usually intended for wig-making."@en .

<http://purl.org/heritagedata/schemes/77/concepts/141331> a skos:Concept ;
    skos:altLabel "Headstones"@en,
        "Tombstones"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/87415> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Gravestones"@en ;
    skos:scopeNote "Carved stones used for marking a grave."@en .

<http://purl.org/heritagedata/schemes/77/concepts/141502> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/109313>,
        <http://purl.org/heritagedata/schemes/77/concepts/79086> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Weapons"@en ;
    skos:scopeNote "Any form of arms or ammunition whether from a formal organized military context or as a general cargo. Use specific terms - e.g. swords, bombs, where known; otherwise use this term primarily in contexts where the arms are unspecified or ancient."@en .

<http://purl.org/heritagedata/schemes/77/concepts/141504> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/79085> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Bronze"@en ;
    skos:scopeNote "An alloy, principally of copper or tin, but which may also include zinc and/or lead."@en .

<http://purl.org/heritagedata/schemes/77/concepts/141854> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/79200> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Cutlery"@en ;
    skos:scopeNote "Metal knives, forks and spoons, carried either as an export cargo or for crew and/or passengers."@en .

<http://purl.org/heritagedata/schemes/77/concepts/141857> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/109313> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Cosmetics"@en ;
    skos:scopeNote "Preparations for beautifying or enhancing the body, face, hair or skin, e.g. creams, and coloured \"make-up\" items, e.g. rouge, lipstick, etc."@en .

<http://purl.org/heritagedata/schemes/77/concepts/141863> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/78889> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Shell Cases"@en ;
    skos:scopeNote "Outer cases for ammunition shells, e.g. Howitzer shells; not \"live\" ammunition, i.e. either at the first stage of manufacture, or having been expended."@en .

<http://purl.org/heritagedata/schemes/77/concepts/141876> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/79009> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Bottled Goods"@en ;
    skos:scopeNote "Goods, usually foodstuffs, preserved in glass bottles, jars, etc. Examples are bottled fruit, pickled onions, jam, honey."@en .

<http://purl.org/heritagedata/schemes/77/concepts/141885> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/109133> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Stationery"@en ;
    skos:scopeNote "Paper products intended for note-taking or correspondence, e.g. blank notebooks, diaries, writing paper, postcards"@en .

<http://purl.org/heritagedata/schemes/77/concepts/141886> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/109133> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Bank Notes"@en ;
    skos:scopeNote "Paper currency. Bank notes may be of any denomination or value and of any nationality."@en .

<http://purl.org/heritagedata/schemes/77/concepts/141953> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/79013> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Personal Effects"@en ;
    skos:scopeNote "Baggage, plate, money, clothes and other personal belongings of all kinds. Use only where the vessel is a cargo vessel conveying the goods of a person of consequence, e.g. a noble or diplomat, rather than for a general passenger vessel."@en .

<http://purl.org/heritagedata/schemes/77/concepts/141976> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/79010> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Grapes"@en ;
    skos:scopeNote "Edible fruit of the vine, which may be either red or white."@en .

<http://purl.org/heritagedata/schemes/77/concepts/141980> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/111773> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Bagged Goods"@en ;
    skos:scopeNote "Cargoes transported in sacks or bags, usually wheat, corn, flour, fruit, or coal. To be used only where the cargo is said to be \"sacks\" or \"bags\" of goods. Use specific term where known."@en .

<http://purl.org/heritagedata/schemes/77/concepts/142049> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/140472>,
        <http://purl.org/heritagedata/schemes/77/concepts/79134> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Woad"@en ;
    skos:scopeNote "The blue dyestuff prepared from the leaves of the plant Isatis tinctoria, and sometimes used to discribe the plant itself.  Later superseded by indigo."@en .

<http://purl.org/heritagedata/schemes/77/concepts/143178> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/79093>,
        <http://purl.org/heritagedata/schemes/77/concepts/83931> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Fullers Earth"@en ;
    skos:scopeNote "Sedimentary clay with smectite mineral properties, originally used for the cleansing [\"fulling\"] of cloth; in the 20th century it was used for a wider range of industrial applications."@en .

<http://purl.org/heritagedata/schemes/77/concepts/143241> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/141503> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Sculpture"@en ;
    skos:scopeNote "Three-dimensional artwork usually created out of stone, e.g. marble; metal, e.g. bronze; ceramics, e.g. terracotta, or other suitable materials."@en .

<http://purl.org/heritagedata/schemes/77/concepts/143250> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/79072> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Mining Machinery"@en ;
    skos:scopeNote "Machinery, e.g. drive wheels, used in powering and excavating mines, i.e. mines for the extraction of minerals such as coal, lead or tin."@en .

<http://purl.org/heritagedata/schemes/77/concepts/143377> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/109313>,
        <http://purl.org/heritagedata/schemes/77/concepts/79086> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Armour"@en ;
    skos:scopeNote "Protective equipment, usually made of metal, to protect parts of the body, e.g. helmets, breastplates, or full suits of armour, to protect troops or individuals in warfare. Most examples date from the Middle Ages, obsolete from the 17th century."@en .

<http://purl.org/heritagedata/schemes/77/concepts/143384> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/79221> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Garlic"@en ;
    skos:scopeNote "The plant, Allium sativum, whose bulb is used for culinary purposes."@en .

<http://purl.org/heritagedata/schemes/77/concepts/143385> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/79011> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Peat"@en ;
    skos:scopeNote "Vegetable matter decomposed in water and partially carbonized to form bogs, whence slabs are cut out to use as fuel."@en .

<http://purl.org/heritagedata/schemes/77/concepts/143449> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/111673> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Blankets"@en ;
    skos:scopeNote "Bed coverings, usually of woollen or similar natural or artificial fabrics."@en .

<http://purl.org/heritagedata/schemes/77/concepts/143973> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/79191> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Cinnamon"@en ;
    skos:scopeNote "Spice from the bark of an East Indian tree"@en .

<http://purl.org/heritagedata/schemes/77/concepts/143974> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/79191> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Nutmeg"@en ;
    skos:scopeNote "A hard aromatic seed, obtained from the fruit of an East Indian evergreen tree and used as a spice."@en .

<http://purl.org/heritagedata/schemes/77/concepts/143975> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/79191> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Cloves"@en ;
    skos:scopeNote "Dried flower buds, used as a pungent aromatic spice."@en .

<http://purl.org/heritagedata/schemes/77/concepts/144487> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/79009> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Roe"@en ;
    skos:scopeNote "Fish eggs, e.g. from cod or, for example, caviar."@en .

<http://purl.org/heritagedata/schemes/77/concepts/144571> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/84339> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Ammonium Nitrate"@en ;
    skos:scopeNote "A fertilizer derived from nitrogen; also known as nitrate of ammonia."@en .

<http://purl.org/heritagedata/schemes/77/concepts/144620> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/79041> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Mirrors"@en ;
    skos:scopeNote "\"Looking glasses\", up to and including the medieval period made of polished steel or other reflective metals; later a piece of glass with a reflective coating, e.g. silver or aluminium."@en .

<http://purl.org/heritagedata/schemes/77/concepts/145061> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/79065>,
        <http://purl.org/heritagedata/schemes/77/concepts/79134> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Honey"@en ;
    skos:scopeNote "A sweet fluid substance, the nectar of flowers, gathered and worked up for food by insects such as bees."@en .

<http://purl.org/heritagedata/schemes/77/concepts/149847> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/78892> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Non Domesticated Animals"@en ;
    skos:scopeNote "Any animal other than livestock (animals carried as food); animals used for transport (horses; mules); and domestic pets. Such animals may be exported as specimens, for zoos, menageries, and circuses, or as unusual pets (e.g. elephants, monkeys)."@en .

<http://purl.org/heritagedata/schemes/77/concepts/152263> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/77/concepts/79114> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Bauxite"@en ;
    skos:scopeNote "Mineral ore comprising mainly aluminium ore and mined for aluminium extraction."@en .

<http://purl.org/heritagedata/schemes/77/concepts/152310> a skos:Concept ;
