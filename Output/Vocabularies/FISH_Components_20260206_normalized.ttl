    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Stonework"@en ;
    skos:scopeNote "A structure, part of a structure or area consisting of plain masonry."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/139763> a skos:Concept ;
