				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:scopeNote xml:lang="en">A structure which can be an area within a building, a separate building within a complex or a detached architectural component of a building.</skos:scopeNote>
