	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk012891">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Echter Fenchel</skos:altLabel>
		<skos:prefLabel xml:lang="de">Fenchel (Pflanze)</skos:prefLabel>
		<skos:altLabel xml:lang="de">fennel</skos:altLabel>
		<skos:prefLabel xml:lang="mul">Foeniculum vulgare</skos:prefLabel>
		<skos:altLabel xml:lang="de">Gartenfenchel</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk014752"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk014752"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk016528"/>
		<xe:explanation_temp xml:lang="de">Vom Fenchel wird die Knolle als Gemüse gegessen, die Samen als Gewürz oder Heilmittel verwendet.</xe:explanation_temp>
		<skos:definition xml:lang="de">Fenchel ist ein Doldenblütler mit fein gefiederten Blättern und gelben Blüten. Die Pflanze wächst als Staude mit einer weißen bis grünweißen, zwiebelartigen Knolle, die leicht nach Anis schmeckt.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4153990-4"/>
		<skos:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_3004"/>
