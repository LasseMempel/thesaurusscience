    <skos:scopeNote xml:lang="en">A shallow pond containing salt water and used for the manufacture of salt through the evaporation process. For metal vessels associated with the DIRECT BOILING and SLEECHING SALT WORKS use SALT PAN.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70631">
    <skos:scopeNote xml:lang="en">A circle of spaced upright boulders emerging from a low, hemispherical, stony mound. The boulders may lean outwards due to pressure from the cairn material.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92885">
    <skos:scopeNote xml:lang="en">A pond storing water to supply a HAMMER POND.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/104073">
    <skos:scopeNote xml:lang="en">A decoy site designed to simulate the flarepath lighting of permanent RAF stations, to lure attacking night bombers away from legitimate targets.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/97461">
    <skos:scopeNote xml:lang="en">A hospital where Royal Naval personnel and their families receive medical and surgical treatment.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143458">
    <skos:scopeNote xml:lang="en">Sites, buildings or structures involved in passive air defence, usually by forcing hostile aircraft to fly high or drop their bombs on the wrong targets. Use more specific term.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92831">
    <skos:scopeNote xml:lang="en">A place of worship for followers of the Orthodox Catholic Church. Use only where the specific denomination is unknown.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140191">
    <skos:scopeNote xml:lang="en">A large steelframed military aircraft hangar designed in 1939, intended for aircraft maintenance on operational stations. It includes side annexes for workshops and offices, provided with a large number of windows. The annexes are of brick or concrete.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68858">
    <skos:scopeNote xml:lang="en">A hillfort enclosure with defences composed of more than one bank and ditch.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91759">
    <skos:scopeNote xml:lang="en">A railway at a dockyard used for the transportation of goods to and from the dock side.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91867">
    <skos:scopeNote xml:lang="en">A building situated within the estate of a manor or country house.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87918">
    <skos:scopeNote xml:lang="en">A workshop used by a joiner; a craftsman working with wood and producing more ornate work than that of a carpenter.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68651">
    <skos:scopeNote xml:lang="en">A system of long, continuous banks and/or ditches dividing land into well defined areas. Possibly used for controlling livestock</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91579">
    <skos:scopeNote xml:lang="en">A threshing barn which also houses farm animals and is somethimes used to stotre grain, house carts and other functions.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99543">
    <skos:scopeNote xml:lang="en">A place of meeting and worship for Exclusive Brethren, an exclusive fundamentalist puritan sect which was created when the Brethren split in 1847.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68712">
    <skos:scopeNote xml:lang="en">A building, usually open to the public, containing a number of areas for bathing. In the case of such a complex containing baths for swimming, also index with INDOOR or OUTDOOR SWIMMING POOL.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70001">
    <skos:scopeNote xml:lang="en">A poorly understood Neolithic monument comprising a very long, narrow earthen mound. They may be of single-phase construction, or represent the addition of a linear extension to the bank of an existing Long Barrow.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69465">
    <skos:scopeNote xml:lang="en">An artificial paved bank or solid landing place built parallel to, or projecting out from, the shoreline to serve in the loading and unloading of vessels.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160406">
    <skos:scopeNote xml:lang="en">A barracks comprising eight barrack blocks accessed via a central corridor. With four blocks on either side of the corridor the whole structure resembled a spider in plan.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92711">
    <skos:scopeNote xml:lang="en">Buildings designed for the accommodation of large numbers of people, rather than single families, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71380">
    <skos:scopeNote xml:lang="en">A textile-weaving factory housing powerlooms; commonly a one-storeyed shed with wide, north-light roof carried on iron columns.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71362">
    <skos:scopeNote xml:lang="en">A rough shelter or dwelling, sometimes used to house cattle.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159386">
    <skos:scopeNote xml:lang="en">A strip of cultivated land situated against the exterior of a walled garden's perimeter, so placed to maximise usable wall space.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160222">
    <skos:scopeNote xml:lang="en">A brick built railway signal box, usually with a reinforced correct roof, designed to minimize the effects of blast damage from aerial bombardment and thus protect the signalling equipment.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69435">
    <skos:scopeNote xml:lang="en">A building or room used for small scale manufacture. Use more specific term where possible.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160388">
    <skos:scopeNote xml:lang="en">A purpose-built building with a steel framed tower, based on drawing number (11595/42). Used for the drying of parachutes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143971">
    <skos:scopeNote xml:lang="en">A coastal site producing salt by dissolving rocksalt or other impure salt in seawater, then boiling the concentrated brine in a PANHOUSE</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140231">
    <skos:scopeNote xml:lang="en">A widening in a canal to allow boats to turn around.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70918">
    <skos:scopeNote xml:lang="en">A building made chiefly of glass, used to grow plants and fruit in. Use more specific type where possible.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71791">
    <skos:scopeNote xml:lang="en">A departmental building within a college or university where a particular subject is taught and administered.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164170">
    <skos:scopeNote xml:lang="en">A building in which cordite dough is stored before extrusion.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87457">
    <skos:scopeNote xml:lang="en">A large building used for the storage of grain.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/104133">
    <skos:scopeNote xml:lang="en">A building constructed from prefabricated sections. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/76300">
    <skos:scopeNote xml:lang="en">A floating structure consisting of two walls standing on pontoon tanks, the latter of which can be flooded to receive a vessel and then pumped out until the pontoon deck and the ship are dry.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/163242">
    <skos:scopeNote xml:lang="en">A school that is directly funded by central government (specifically, the Department for Education) and independent of direct control by local government in England.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93969">
    <skos:scopeNote xml:lang="en">A slate situated at the end of a terrace for a coal company employee to wake the miners for their shift. The slate had the time of the shifts written on it.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71699">
    <skos:scopeNote xml:lang="en">A building where artisans could learn more about their craft, and the scientific and theoretical principles behind it, by attending lectures and the use of the reading room facilities.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68618">
    <skos:scopeNote xml:lang="en">Manmade marks or earthworks which provide evidence for agricultural cultivation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69156">
    <skos:scopeNote xml:lang="en">A factory where paper is made. Use with power type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71609">
    <skos:scopeNote xml:lang="en">A building with shelves and/or stands for skeps or wooden hives, and flight holes through the walls for bees.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162652">
    <skos:scopeNote xml:lang="en">A building or site used to train civilians and members of the services in the skills designed to protect the civilian population during times of war. Could also be used during times of national emergency.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69454">
    <skos:scopeNote xml:lang="en">A naval base that builds, repairs, docks or converts warships, and is manned by civilian engineers and workers and administered by engineer duty officers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70269">
    <skos:scopeNote xml:lang="en">A road whose upkeep and repair was financed by the exaction of a toll.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69185">
    <skos:scopeNote xml:lang="en">A furnace used for the refining of precious metals. eg. the separation of silver from argentiferous lead.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93954">
    <skos:scopeNote xml:lang="en">A building in which the lay sisters resided. Lay sisters were not nuns and as such weren't bound by any vows. They could leave the convent and even marry if they wished.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93475">
    <skos:scopeNote xml:lang="en">A place of worship for followers of Emmanuel Swedenborg who believed he was the medium through which the New Jerusalem would be founded on earth. The church was formed in 1787.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92895">
    <skos:scopeNote xml:lang="en">A place where perfume is sold, as well as manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92641">
    <skos:scopeNote xml:lang="en">Baths containing water impregnated with mineral substances in which patients bathe for medicinal purposes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140481">
    <skos:scopeNote xml:lang="en">A transportable hangar designed by Callender Cable and Construction to Air Ministry drawing number 6633/37. A steel box-girder framework with corrugated iron cladding and canvas doors it had a clear door height of 25ft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142009">
    <skos:scopeNote xml:lang="en">Term applied to a pit trap itself and also a walled enclosure containing one or more pit traps.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91998">
    <skos:scopeNote xml:lang="en">A specialist hospital for the medical and surgical treatment of foot disorders and diseases.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69266">
    <skos:scopeNote xml:lang="en">A place where manganese ore is extracted. Use with other ores extracted and MINE where relevant.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68596">
    <skos:scopeNote xml:lang="en">A fence or row of stakes, often with nets attached forming an enclosure within a river or harbour and used for catching, or holding, fish.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/84578">
    <skos:scopeNote xml:lang="en">A multi-storey building in which individual blocks of flats cluster around a central service core.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/152547">
    <skos:scopeNote xml:lang="en">Factory for the production of Pet Food.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70183">
    <skos:scopeNote xml:lang="en">A small carved figure, usually female in appearance, probably representing  fertility charms, found on Romanesque churches in the West of England, eg. Kilpeck.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92869">
    <skos:scopeNote xml:lang="en">A school for the teaching of poor children, often the recipients of Poor Law relief.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143898">
    <skos:scopeNote xml:lang="en">A building housing an electric powered ventilation fan for use in deep mine shafts</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69359">
    <skos:scopeNote xml:lang="en">An engine in which the mechanical force of steam is made available as a motive power for driving machinery.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70390">
    <skos:scopeNote xml:lang="en">A point where water issues naturally from the rock or soil onto the ground or into a body of surface water.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160290">
    <skos:scopeNote xml:lang="en">An operations room, built to drawing number 367/41, to control the lighting arrays of the DREM type of bombing decoy in use during the Second World War. Unlike earlier designs it was surface built and then covered in earth to protect against flooding.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70077">
    <skos:scopeNote xml:lang="en">A wall with niches in a CREMATORIUM to display the urns containing ashes. Use only when related to funerary site.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68625">
    <skos:scopeNote xml:lang="en">The limit line of a field.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70068">
    <skos:scopeNote xml:lang="en">A form of Neolithic burial monument comprising a large circular stone or earthen mound, with a low and narrow entrance passage leading to a wider and higher stone built chamber.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159218">
    <skos:scopeNote xml:lang="en">A temporary, usually roofed, wooden structure placed on the ramparts or walls of a castle to improve the defenders field of fire along the length of a wall.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160250">
    <skos:scopeNote xml:lang="en">A stand by set house built to Air Ministry drawing number 4238/44.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70372">
    <skos:scopeNote xml:lang="en">A gateway with one or more chambers over the entrance arch; the flanking towers housing stairs and additional rooms. Use with wider site type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69998">
    <skos:scopeNote xml:lang="en">A vessel, usually made of stone, which contains the consecrated water for baptism. Use a broader monument type if possible.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/90118">
    <skos:scopeNote xml:lang="en">A structure consisting of a large, metal framework holding a skyward facing dish. Used for transmitting and receiving signals which are relayed by satellite.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/146429">
    <skos:scopeNote xml:lang="en">A room or building for hand knitting garments on simple hand frames.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68855">
    <skos:scopeNote xml:lang="en">A hilltop enclosure bounded by one or more substantial banks, ramparts and ditches. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99542">
    <skos:scopeNote xml:lang="en">A place of worship for Welsh Presbyterians. Formerly known as Calvinistic Methodists, the Presbyterian Church of Wales separated from the established church in 1811.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68881">
    <skos:scopeNote xml:lang="en">A large, fortified permanent Roman military base, made of timber and stone, surrounded by a rampart and ditches.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93326">
    <skos:scopeNote xml:lang="en">Buildings and structures associated with signal communication.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164399">
    <skos:scopeNote xml:lang="en">A factory making laminate flooring.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/133655">
    <skos:scopeNote xml:lang="en">A structure, into which a cart can be drawn, to enable it to be loaded from above.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167065">
    <skos:scopeNote xml:lang="en">A building used for the storage of equipment.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68900">
    <skos:scopeNote xml:lang="en">An often squat building with thick, loopholed walls and a flat roof, designed to accommodate a variety of weapons, usually strategically positioned to cover a vulnerable point in a defensive system. Many were built to standardized designs.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160398">
    <skos:scopeNote xml:lang="en">A radar station with sets operating on a wavelength of 10cm or less. They were highly accurate radars and gave better sea level coverage than the earlier Chain Home Low stations.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160401">
    <skos:scopeNote xml:lang="en">A building equipped with instruments and a flight simulator used to teach members of bomber crews how to correctly identify targets for bombing.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/145086">
    <skos:scopeNote xml:lang="en">A building or part of a building used for the storage of shoes or boots.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91013">
    <skos:scopeNote xml:lang="en">Buildings, sites and structures associated with the control, accommodation, service and testing of aircraft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71404">
    <skos:scopeNote xml:lang="en">A garden surrounded by a substantial wall.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68896">
    <skos:scopeNote xml:lang="en">A canal built as a military obstacle, but also used for the transport of military stores, equipment and personnel.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92762">
    <skos:scopeNote xml:lang="en">A building used for services by a nonconformist protestant sect, especially by Quakers and Presbyterians.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140274">
    <skos:scopeNote xml:lang="en">Large concrete letters representing the ground-to-air airfield code. It has been used to show pilots in WWII the name of the airfield they were above e.g. DW for Dunkeswell.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93192">
    <skos:scopeNote xml:lang="en">A prepared area of grass on which the game of rugby is played.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92610">
    <skos:scopeNote xml:lang="en">A burial ground for military personnel.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70763">
    <skos:scopeNote xml:lang="en">A churchyard or memorial cross set on a long shaft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92640">
    <skos:scopeNote xml:lang="en">A pumping station for draining a mine or colliery.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94398">
    <skos:scopeNote xml:lang="en">A large building where iron is stored.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92716">
    <skos:scopeNote xml:lang="en">A building for the storage of ammunition and other military stores.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68817">
    <skos:scopeNote xml:lang="en">A place in which the artillery is encamped or collected together.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68626">
    <skos:scopeNote xml:lang="en">A bank formed at the end of a field by soil which, loosened by the plough, gradually moves down slope through a combination of gravity and erosion.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91126">
    <skos:scopeNote xml:lang="en">Linear or curvilinear construction of earth, turf and stone, often, but not always accompanied by a ditch. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91466">
    <skos:scopeNote xml:lang="en">A place of worship for Christadelphians, a fundamentalist sect founded in America in the late 1840s who rejected the trinity and awaited the second coming of Christ.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91690">
    <skos:scopeNote xml:lang="en">A building or site from which a watch can be kept to prevent the illegal import/export of goods.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167064">
    <skos:scopeNote xml:lang="en">Sites and buildings used for the storage or equipment, ordnance or vehicles. Use more specific term.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142054">
    <skos:scopeNote xml:lang="en">A tower with one or more horizontal platforms extending out over deep water for use in diving competitions.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93364">
    <skos:scopeNote xml:lang="en">A site used for the production of sodium bicarbonate, soda ash or caustic soda.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160363">
    <skos:scopeNote xml:lang="en">A site, usually with docks and control buildings, used for the storage, maintenance and deployment of military vessels or the administration of the Royal Navy. May also include accommodation buildings for personnel.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93079">
    <skos:scopeNote xml:lang="en">An embankment or cutting on a railway system, surfaced at a uniform gradient, up or down which materials were hauled by rope.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69966">
    <skos:scopeNote xml:lang="en">A representation of the crucifixion of Christ or related scenes as a sculpture in a churchyard, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160397">
    <skos:scopeNote xml:lang="en">A coastal battery constructed at short notice usually mounting a variety of artillery pieces.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91449">
    <skos:scopeNote xml:lang="en">A specialist hospital treating patients with chest disorders and diseases, can be pre sanatoria.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68948">
    <skos:scopeNote xml:lang="en">The principal house of a manor or village.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91017">
    <skos:scopeNote xml:lang="en">Sites used for the manufacture of aircraft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93886">
    <skos:scopeNote xml:lang="en">A site available to the public for the pursuit of leisure and recreational activities.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140258">
    <skos:scopeNote xml:lang="en">An inhumation burial in which the corpse is laid on a wooden bed, often surrounded by a collection of grave-goods. Anglo-Saxon rite of 7th century AD.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71740">
    <skos:scopeNote xml:lang="en">A workshop used for the manufacture of items of jewellery and/or timepieces from precious metals and precious or semi-precious stones.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167076">
    <skos:scopeNote xml:lang="en">A building housing the engines used to power equipment used by a searchlight, anti-aircraft or coastal battery.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91623">
    <skos:scopeNote xml:lang="en">Open sided barn for the storage of wood produced by the periodic cutting of small trees.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71761">
    <skos:scopeNote xml:lang="en">A place of worship for followers of the Eastern Orthodox churches. This family of churches separated from the Western church in the 11th century and recognizes the Patriarch of Constantinople.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70212">
    <skos:scopeNote xml:lang="en">A structure used for the housing and servicing of aircraft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159277">
    <skos:scopeNote xml:lang="en">An area of land incorporating bodies of water, either natural or manmade for use in water sports activities such as canoeing, rowing and sailing. Usually includes a leisure complex with facilities for the users.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91791">
    <skos:scopeNote xml:lang="en">An inlet in the banks of a navigable river, often lined with brick and gated, into which boats can be drawn for repair etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91704">
    <skos:scopeNote xml:lang="en">A workshop used for the decoration of fired pottery or ceramics. Usually part of a larger complex.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92311">
    <skos:scopeNote xml:lang="en">Structure used for viewing deer hunt.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68890">
    <skos:scopeNote xml:lang="en">A substantial bank and ditch forming a major boundary between two adjacent landholdings. Most date from the late Bronze Age and Iron Age.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140513">
    <skos:scopeNote xml:lang="en">A circular pillbox, usually consisting of a concrete pipe with a timber and corrugated iron roof, surrounded and covered by earth and sandbags. Built to a design by Norcon Ltd, a company dealing in concrete pipes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170066">
    <skos:scopeNote xml:lang="en">A device, monogram or symbol usually carved on stone or woodwork near a buildingï¿½s entrance points, particularly doorways, windows and fireplaces, to protect inhabitants and visitors from witches and evil spirits.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92248">
    <skos:scopeNote xml:lang="en">A yard for pigs.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71436">
    <skos:scopeNote xml:lang="en">A building or room within a granary used to dry grain. Often consisting of an oven with a refractory-brick drying floor above, on which the grain was placed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143710">
    <skos:scopeNote xml:lang="en">18th-19th century stone-lined pit which held the balance bob for a pump-rod or flat-rod system. It includes examples where the surviving feature is a pillar for the bearing, rather than the pit.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/135015">
    <skos:scopeNote xml:lang="en">An installation used to store ammunition and equipment ready for the mobilization of armed forces in the event of a war.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92695">
    <skos:scopeNote xml:lang="en">A rustic garden building made of wood with moss pressed between the wall slats. The mosses could be of different types, forming a mossery.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99660">
    <skos:scopeNote xml:lang="en">A place of worship for members of the United Methodist Free Church. Formed in 1857 by the amalgamation of the Methodist Reform Church and the Wesleyan Association they later became part of the United Methodist Church in 1907.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159175">
    <skos:scopeNote xml:lang="en">A road junction where two (or occasionally more) roads cross each other.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/82861">
    <skos:scopeNote xml:lang="en">Obstacles such as scaffolding, barbed wire and concrete blocks or cylinders placed on a beach to impede the progress of enemy soldiers, vehicles or watercraft landing from the sea.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/100005">
    <skos:scopeNote xml:lang="en">A stone which has a socket for an unknown function. Use specific term where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92970">
    <skos:scopeNote xml:lang="en">A door, gate, doorway or gateway of grand or elaborate construction. Use specific type where possible.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/100195">
    <skos:scopeNote xml:lang="en">A factory for the production of missiles</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160367">
    <skos:scopeNote xml:lang="en">A site with accommodation buildings and ancillary facilities for Royal Air Force personnel.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69328">
    <skos:scopeNote xml:lang="en">A factory, incorporating power driven machinery from the late 18th century, where cloth was manufactured from threads interlaced at right angles to each other in a loom.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68894">
    <skos:scopeNote xml:lang="en">A building or group of buildings, often surrounded by a system of fortifications, used as a residential and training site by members of an armed force.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/103312">
    <skos:scopeNote xml:lang="en">A room or building used as a store, usually for documents, works of art, books etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160296">
    <skos:scopeNote xml:lang="en">Blocks of solid concrete, in the shape of a round bottomed cone usually 2 feet 6 inches across x 2 feet 9 inches high. Buoys were mainly used in road blocks intended to impede enemy movement in the event of invasion.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/168346">
    <skos:scopeNote xml:lang="en">Workshop used in the the production of tripe.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70189">
    <skos:scopeNote xml:lang="en">A monument consisting of parallel lines of standing stones, which appears to mark out an approach to another monument or monuments.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69333">
    <skos:scopeNote xml:lang="en">A tower-like structure of wood or brick with a wooden cap and sails which are driven around by the wind producing power to work the internal machinery. Use with product type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70120">
    <skos:scopeNote xml:lang="en">A religious house governed by an abbot or abbess. Use with narrow terms of DOUBLE HOUSE, MONASTERY or NUNNERY.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/97262">
    <skos:scopeNote xml:lang="en">Rolls of barbed wire with supporting metal posts designed to impede enemy advance.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93117">
    <skos:scopeNote xml:lang="en">Power station using domestic refuse as its principal fuel.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70060">
    <skos:scopeNote xml:lang="en">An area used for the deposition of human remains where the principal funeral rite is the burial of the corpse complete. Generally indicated by the discovery of articulated human skeletal remains, occasionally with evidence of coffins and/or grave goods.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93104">
    <skos:scopeNote xml:lang="en">A room or building used for the making of films, television or radio programmes and musical recordings (CDs, LPs, etc).</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70443">
    <skos:scopeNote xml:lang="en">A system of artificial or natural drains and ditches used to drain off surplus water.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92451">
    <skos:scopeNote xml:lang="en">An establishment with automatic washing machines available for public use.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91817">
    <skos:scopeNote xml:lang="en">A defensive or boundary earthwork.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71534">
    <skos:scopeNote xml:lang="en">A purpose-built tenement. Use specific monument type where possible.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70171">
    <skos:scopeNote xml:lang="en">An abbey of Franciscan nuns also known as Minoresses or Poor Clares.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92724">
    <skos:scopeNote xml:lang="en">A mill where mustard is produced.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71477">
    <skos:scopeNote xml:lang="en">A room in which a judge sits to hear cases and undertake other official proceedings which are not of a sufficient importance to be brought into court.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/151893">
    <skos:scopeNote xml:lang="en">A place where silica or silicate, the most common mineral component of rock, is extracted from the ground.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70126">
    <skos:scopeNote xml:lang="en">A residence of two or three monks of the Benedictine order dependent on an English mother house.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71392">
    <skos:scopeNote xml:lang="en">A flat, level area of ground within a garden. Often raised and accessed by steps.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/139084">
    <skos:scopeNote xml:lang="en">An area speciallly developed to accommodate commercial buildings.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68886">
    <skos:scopeNote xml:lang="en">A fortified site in which a gun, mortar or cannon is positioned.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/151470">
    <skos:scopeNote xml:lang="en">A shop selling household furniture.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/103876">
    <skos:scopeNote xml:lang="en">A vertical vein of metallic ore, usually lead, occuring between walls of rock and cutting through the bedding. Often rakes have been worked from early times leaving deep trenches several km long, with adits leading off and shafts sunk at the side.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99662">
    <skos:scopeNote xml:lang="en">A place of meeting and worship for Jehovahs Witnesses.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92101">
    <skos:scopeNote xml:lang="en">A building in which apparatus registering the amount of gas consumed is housed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91467">
    <skos:scopeNote xml:lang="en">A place of meeting and worship for followers of the Church Army, a body of trained lay evangelists devoted to evangelism and social work.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91104">
    <skos:scopeNote xml:lang="en">A brewing or baking house attached to a vernacular building, 16/17th century.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160342">
    <skos:scopeNote xml:lang="en">A pit dug to protect a small group of infantry men.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69380">
    <skos:scopeNote xml:lang="en">A building housing a whim, a machine worked by a horse, used for raising ores, etc, from a mine.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70810">
    <skos:scopeNote xml:lang="en">A narrow, open container, usually where food or water for animals is put. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93064">
    <skos:scopeNote xml:lang="en">A building or room where beer is decanted from conditioning tanks, into casks or barrels.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68767">
    <skos:scopeNote xml:lang="en">A commemorative stone inscribed with a dedicatory inscription to a person or event.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/100224">
    <skos:scopeNote xml:lang="en">A crane consisting of a lattice girder carried on a lattice tower forming a T-shaped structure. A hoist is carried along the girder by a 'crab', enabling the crane to perform a variety of tasks eg loading/unloading of ships.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93019">
    <skos:scopeNote xml:lang="en">A building used to manufacture Producer Gas. Producer Gas is a mix of gases formed by passing compressed air through hot coke.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69216">
    <skos:scopeNote xml:lang="en">Building or structure covering a casting floor or pit.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162619">
    <skos:scopeNote xml:lang="en">Regular courtyard farmsteads where the working buildings are carefully planned as linked ranges and are focused around one or more working yards. They often result from a single phase of building.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/119393">
    <skos:scopeNote xml:lang="en">A raised platform from which an officer can address or review his troops.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69325">
    <skos:scopeNote xml:lang="en">A mill used for the mechanized processing of silk.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71126">
    <skos:scopeNote xml:lang="en">A path running by the side of a canal or navigable river for use in towing vessels.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140552">
    <skos:scopeNote xml:lang="en">A small, single storey building used as the Pilots' room on fighter stations and as the watch office on bomber stations.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/88198">
