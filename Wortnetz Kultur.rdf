	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk019212">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Feuerschlagstein</skos:prefLabel>
		<skos:altLabel xml:lang="de">Feuerschlagsteine</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk020091"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019149"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk020091"/>
		<skos:definition xml:lang="de">Ein Feuerschlagstein ist ein Steinartefakt, der zur Erzeugung von Funken verwendet wird. In der Regel sind die Schlagsteine langschmal und an einer oder beiden Enden durch den Gebrauch stark verrundet oder vernarbt.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019149"/>
