    <!-- https://hist-arch-vocab.org/bvha#c_499e6829 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_499e6829">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_d997b1c2"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T15:26:16.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-02T16:44:52.000</terms:modified>
        <skos:altLabel xml:lang="es">piedra colada</skos:altLabel>
        <skos:altLabel xml:lang="it">stucco</skos:altLabel>
        <skos:definition xml:lang="de">Beim Steinguss wird ein Bildwerk aus pulverisiertem (meist Kalk-)Stein gegossen, so z.B. in der (süddeutschen) Spätgotik. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Guss von Bauteilen (Gewölberippen etc.) und Bildhauerarbeiten aus einer Masse aus Steinmehl und Bindemittel in Negativformen, v.a. um 1400 verbreitet. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">V případě kamenolitu se socha odlévá z práškového kamene (většinou vápence), např. v (jihoněmecké) pozdní gotice. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Steinguss</skos:prefLabel>
        <skos:prefLabel xml:lang="en">casting of imitated stone</skos:prefLabel>
        <skos:prefLabel xml:lang="es">fundición de piedra</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kamenolit</skos:prefLabel>
        <skos:prefLabel xml:lang="it">scultura a stampo</skos:prefLabel>
    </owl:NamedIndividual>
    


