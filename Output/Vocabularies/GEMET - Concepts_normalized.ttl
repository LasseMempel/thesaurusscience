    skos:related <http://www.eionet.europa.eu/gemet/concept/1571> .

<http://www.eionet.europa.eu/gemet/concept/2426> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15330>,
        <http://www.eionet.europa.eu/gemet/concept/2422> ;
    skos:definition "Directive concerning the use and management of water resources for a rational economical and social development and the protection of the related environmental features."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "EU-Wasserschutzrichtlinie"@de,
