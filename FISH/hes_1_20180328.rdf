		<skos:prefLabel xml:lang="gd">TAIGH NAN OB</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach airson stòradh is tiormachadh oban, gu math tric le àth-thìoraidh oban. A ghnàth na phàirt de thuathanas.</skos:scopeNote>
