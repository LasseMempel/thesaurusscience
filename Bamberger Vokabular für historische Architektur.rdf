        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c7b144d0"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-15T13:34:26.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T14:49:54.000</terms:modified>
        <skos:definition xml:lang="de">Mit U-Wert bezeichnet man den Wärmedurchgangskoeffizient (früher auch k-Wert), dies ist das Maß für den Wärmedurchgang durch einen festen Körper wie z.B. ein Fenster, das Glas oder eine Haustüre. [Pax - Fenster &amp; Türen Fachbegriffe]</skos:definition>
        <skos:prefLabel xml:lang="de">U-Wert</skos:prefLabel>
    </owl:NamedIndividual>
    


