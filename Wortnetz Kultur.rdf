		<skos:altLabel xml:lang="en">claw beakers</skos:altLabel>
		<skos:prefLabel xml:lang="de">Rüsselbecher</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk005423"/>
