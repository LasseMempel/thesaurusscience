    <!-- https://hist-arch-vocab.org/bvha#c_3201517b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_3201517b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_61354695"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_34ca6582"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-13T14:47:14.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T16:36:39.000</terms:modified>
        <skos:definition xml:lang="de">Ablösung von Steinsubstanz in Form einer Schale oder eines Stapels von Schalen, welche nicht der Gesteinstextur folgen und sich wie Fischschuppen oder parallel zur Steinoberfläche ablösen. Die Dicke der Schalen beträgt allgemein zwischen einigen Millimetern und Zentimetern; sie ist wesentlich kleiner als die Fläche der Schale. [ICOMOS-ISCS] </skos:definition>
        <skos:definition xml:lang="en">Detachment of stone as a scale or a stack of scales,not following any stone structure and detaching likefish scales or parallel to the stone surface. The thicknessof a scale is generally of millimetric to centimetricscale, and is negligeable compared to its surfacedimension. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="fr">Détachement d’écailles de pierre individuelles ou enpaquets indépendamment de toute structure orientéepréexistante. La desquamation se développeparallèlement à la surface ou en écailles de poisson.L’épaisseur des écailles est négligeable par rapportà leur extension. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="cs">odprýskávání a odtrhávání kousků kamene, nesledující žádné struktury v kameni. oddělování kousků kamene probíhá podobně jako oddělování rybích šupin nebo paralelně s povrchem kamene. tloušťka šupin obecně dosahuje milimetrů nebo centimetrů a je zanedbatelná vzhledem k plošnému rozměru. [ICOMOS-ISCS] </skos:definition>
        <skos:prefLabel xml:lang="de">Schuppenbildung</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">desquamation</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">odprýskávání</skos:prefLabel>
        <skos:prefLabel xml:lang="en">scaling</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_320d52dd -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_320d52dd">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_80f8e5a0"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_5bf6bcac"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T15:40:47.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T11:58:04.000</terms:modified>
        <skos:altLabel xml:lang="de">Kyma</skos:altLabel>
        <skos:altLabel xml:lang="de">Kymation</skos:altLabel>
        <skos:definition xml:lang="de">Kyma (griech. Welle), Blattwellen-Fries; 1. Dorisches Kymation, meist nur gemalt auf unterschnittenem Stab; 2. ionisches Kymation mit plastischen Ovalformen (Eierstab) und Pfeilspitzen, konvexer Stab; 3. lesbisches Kymation mit plastischem Herzlaub (Wasserlaub) und Spitzen, konvex-konkaves Profil. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Kyma (řec. vlna), 1.Dórské kyma, většinou pouze malované na vydutém profilu. 2. lonské kyma s plastickými oválnými tvary (vejcovec) a šípovitými hroty, vypuklý profil. 3. Lesbické kyma s plastickými srdčitými listy a hroty (listovcem), vypuklovy dutý profil. [Koch 2008] </skos:definition>
        <skos:prefLabel xml:lang="de">Blattwellenfries</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kyma</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_322cf81d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_322cf81d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_894fd3f5"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T12:16:04.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-02T10:47:39.000</terms:modified>
        <skos:definition xml:lang="cs">Antická římská stavba, většinou obloukový most s otevřeným nebo krytým žlabem, jímž byla do sídla samospádem přiváděna voda, zvl. v římské Campagne, jižní Francii (Nimes), Španělsku (Segovia). [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Aquädukt (lat. aquae ductus = Wasserleitung), römisch-antike Anlage, im besonderen eine Bogenbrücke mit der eine Wasserrinne offen oder verdeckt im natürlichen Gefälle des Wassers in eine Siedlung geleitet wurde. Besonders in der römischen Campagna, Süd-Frankreich (Nimes), Spanien (Segovia). [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Aquädukt (lat. aquae ductus: Wasserleitung), in der röm. Kaiserzeit entwickelte Gefällewasserleitung. Durch eine von hohen, oft mehrstöckigen Bogenstellungen getragene Rinne mit leichtem Gefälle konnte das Gebirgswasser über Täler und Ebenen hinweg in die Städte fließen. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Aquädukt</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">akvadukt</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_323cf4ff -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_323cf4ff">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_66433988"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_167cb98f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_19d56a39"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_6af98fb4"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-23T12:34:09.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T14:28:42.000</terms:modified>
        <skos:altLabel xml:lang="de">Schlüsselbalken</skos:altLabel>
        <skos:altLabel xml:lang="de">Wechsel</skos:altLabel>
        <skos:altLabel xml:lang="fr">linçoir</skos:altLabel>
        <skos:altLabel xml:lang="en">trimmed joist</skos:altLabel>
        <skos:altLabel xml:lang="en">trimmer</skos:altLabel>
        <skos:altLabel xml:lang="es">viga secundaria</skos:altLabel>
        <skos:definition xml:lang="de">Balken, der quer zum übrigen Gebälk verläuft und in zwei Balken eingezapft ist. Ein W. ist v. a. bei Deckenöffnungen (Treppenw.) und bei der Schornsteindurchführung (Kaminw.) notwendig. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Tragender Querbalken zur Aufnahme tragender Stichbalken. [Eißing et al. 2012]</skos:definition>
        <skos:prefLabel xml:lang="de">Wechselbalken</skos:prefLabel>
        <skos:prefLabel xml:lang="es">brochal</skos:prefLabel>
        <skos:prefLabel xml:lang="it">cavallo</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">chevêtre</skos:prefLabel>
        <skos:prefLabel xml:lang="en">trimmer beam</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">trámová výměna</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_66433988"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_323dc643 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_323dc643">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_334623ef"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-22T09:25:03.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T16:28:15.000</terms:modified>
        <skos:altLabel xml:lang="cs">sbírka mešních antifon</skos:altLabel>
        <skos:prefLabel xml:lang="de">Antiphonarium missarum</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">antiphonarium missarum</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Buch mit den antiphonen und responsorialen Gesängen der Messe (Antiphonarium missarum). </skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_3244cac9 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_3244cac9">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_d936f79a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_b41bd73a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-13T17:05:16.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T14:42:44.000</terms:modified>
        <skos:definition xml:lang="de">Ein am rechten Flügel angebrachter, drehbarer Riegel wird zum Verschließen in das am linken Flügel befindliche Winkelstück gelegt, welches am senkrechten Teil nach unten stärker wird. Dadurch werden beide Flügel aneinander gezogen. Die Ruderverriegelung tritt nur mit dem aufgehenden Pfosten auf. Der rechte Flügel wird am linken gehalten, der mit Schubriegeln oder Einreibern am Unterschenkel des Fensterrahmens und am Querholz arretiert wird. [Noky 1996]</skos:definition>
        <skos:prefLabel xml:lang="de">Ruderverriegelung</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_325c6f2d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_325c6f2d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_3da3c0b4"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-28T16:06:52.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T10:50:27.000</terms:modified>
        <skos:definition xml:lang="de">Cubiculum (lat. Schlafzimmer), für mehrere Familienmitglieder bestimmte Grabkammer in röm. Katakomben. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Cubiculum</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_325ec138 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_325ec138">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_219f468f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T17:20:07.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T17:06:59.000</terms:modified>
        <skos:altLabel xml:lang="it">architettura trompe-l\&apos;œil</skos:altLabel>
        <skos:altLabel xml:lang="es">arquitectura simulada</skos:altLabel>
        <skos:definition xml:lang="cs">Architektonické prvky napodobené pomocí malby nebo reliéfu na stěnách nebo klenbách, které iluzivně rozšiřují vnitřní prostor, zvl. pompejská architektura a baroko. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Durch Malerei oder Relief vorgetäuschte Architekturteile an Wänden oder Decken, die den Innenraum meist illusionistisch erweitern. Besonders pompejanische Architektur und Barock. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Eine illusionist. gemalte oder durch Reliefwirkung nur angedeutete Architektur, die räuml. nicht existiert. S. findet man v. a. in barocken Kirchenbauten, um eine Raumausweitung zu erzielen. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Scheinarchitektur</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">architecture simulée</skos:prefLabel>
        <skos:prefLabel xml:lang="it">architettura finta</skos:prefLabel>
        <skos:prefLabel xml:lang="es">arquitectura aparente</skos:prefLabel>
        <skos:prefLabel xml:lang="en">illusionistic architecture</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">iluzivní architektura</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_325fdd46 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_325fdd46">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_12194ed3"/>
