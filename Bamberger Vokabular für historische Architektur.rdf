    <!-- https://hist-arch-vocab.org/bvha#c_507b668b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_507b668b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_826f3942"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_5bf6bcac"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-22T15:58:41.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T19:18:29.000</terms:modified>
        <skos:definition xml:lang="de">Eine gestemmte Füllungstür in Rahmenbauweise mit zwei gleich großen Füllungen, die sich von der Renaissance bis heute als eine der häufigsten Türaufteilungen etabliert hat. Im 18. Jahrhundert galt sie in der Stadt und auf dem Land als Standardlösung für Zimmertüren, wobei die Friese um so geringer werden, je jünger die Türen sind. Heute werden diese Türen als Landhaustüren bezeichnet. [Schrader / Voigt 2003]</skos:definition>
        <skos:prefLabel xml:lang="de">Zweifüllungstür</skos:prefLabel>
    </owl:NamedIndividual>
    


