    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_796f6992 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_796f6992">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_dd883e1f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-27T15:01:56.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T13:01:17.000</terms:modified>
        <skos:altLabel xml:lang="cs">kordón</skos:altLabel>
        <skos:definition xml:lang="de">(frz. cordon ›Schnur, Band, Gürtel‹), Beim Befestigungsbau als halbrund vortretendes Gesims der Brustwehr verlaufend, trennendes Element zwischen dem dossierten (Dossierung) und dem senkrechten Teil der Eskarpe. Geeignet zur besseren Bekämpfung von Angreifern mit Sturmleitern. Im Festungsbau des späten 18. und des 19. Jh.s die Linie der auskragenden Abdeckungssteine von Bekleidungsmauern oder mit Erdschüttung versehener Bauten. M. L. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:prefLabel xml:lang="de">Kordon</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">ochranný řetěz</skos:prefLabel>
    </owl:NamedIndividual>
    


