  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71475">
    <skos:scopeNote xml:lang="en">A small house or cottage at the entrance to a cemetery, usually occupied by a caretaker or gardener, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68580">
    <skos:scopeNote xml:lang="en">A heated stone, brick or iron chamber used for drying corn.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93070">
