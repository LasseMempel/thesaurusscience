    <!-- https://hist-arch-vocab.org/bvha#c_10972fca -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_10972fca">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_d6e98810"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-05T11:51:31.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T12:09:41.000</terms:modified>
        <skos:definition xml:lang="cs">Byl napodobován v době renesance, baroka a klasicismu a bývaly, stejně jako v antice, prolomený (též rozeklaný) a zalomený, a nejrůznějším způsobem obměňovaný, zvl. jako ozdobný štít nad portálem nebo oknem (viz fronton, nadokenní římsa). Tzv. „syrský štít&quot; je trojúhelníkový štít nad trojdílným architrávem, jehož střední část je tvořena půlkruhovou archivoltou (viz syrský architráv, vrací se v palladiovském motivu). Románský trojúhelníkový štít je téměř pravoúhlý a málo zdobený. Štíty gotických kostelů jsou vysoké, často bývají opatřeny rozetovým oknem nebo slepou kružbou, osazeny fiálami a kraby, nebo ukončeny kytkou. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Giebel mit segmentbogenförmigem Abschluss. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Segmentgiebel</skos:prefLabel>
        <skos:prefLabel xml:lang="it">frontone ad arco ribassato</skos:prefLabel>
        <skos:prefLabel xml:lang="en">segmental gable</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">segmentový štít</skos:prefLabel>
        <broaderByConstruction rdf:resource="https://hist-arch-vocab.org/bvha#c_d6e98810"/>
    </owl:NamedIndividual>
    


