    <skos:prefLabel xml:lang="en">CAIRNFIELD</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A group of cairns occurring within close proximity to each other. Use for instances where the majority are clearance cairns. Also index specific types where known.</skos:scopeNote>
