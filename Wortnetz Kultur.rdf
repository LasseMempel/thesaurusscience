		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk017418"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019790"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004266"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk012173"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk003995"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk002959"/>
		<skos:definition xml:lang="de">Ein Torf ist ein organisches Material, das aus schwach zersetzten Pflanzenresten in Mooren gebildet wird. Abgebaut und getrocknet dient Torf als Brennmaterial.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004266"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk008310"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk012173"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk017418"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019790"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004267"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004268"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-07-13T12:08:32+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004270">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Gley</skos:prefLabel>
		<skos:prefLabel xml:lang="en">gley soil</skos:prefLabel>
		<skos:altLabel xml:lang="de">Gleye</skos:altLabel>
		<skos:altLabel xml:lang="de">Klei</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004265"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk008310"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019790"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004265"/>
		<xe:explanation_temp xml:lang="de">Durch den ständigen Grundwassereinfluss herrscht im Gley eine relative Sauerstoffarmut. Dadurch werden Eisen- und Manganoxide gelöst und steigen als typische rostfleckige Bänder in den Kapillaren des Bodens auf.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Gley ist ein Grundwasserboden, der unter ständigem Grundwassereinfluss, manchmal bis in den Oberboden hinein, steht.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004265"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk008310"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019790"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-11-08T16:51:23+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004271">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">alluvial soil</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Auenboden</skos:prefLabel>
		<skos:altLabel xml:lang="de">Auenböden</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004265"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk008310"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019790"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004265"/>
		<xe:explanation_temp xml:lang="de">Der Einfluss des Flusswasserspiegels auf den benachbarten Grundwasserspiegel wird mit dem Abstand zum Fluss geringer, kann sich bei durchlässigem Untergrund (z.B. Kies) aber 4-5 km auswirken.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Auenboden ist ein Grundwasserboden, der aus den Sedimenten von Flußauen und Bachauen entstehen und einmal durch starke Grundwasserschwankungen, die im Laufe eines Jahres bis zu 4 m betragen können, geprägt wird.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004265"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk008310"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019790"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-11-08T16:51:23+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004272">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="en">hillside soil</skos:altLabel>
		<skos:prefLabel xml:lang="de">Ranker</skos:prefLabel>
		<skos:prefLabel xml:lang="en">Rankers</skos:prefLabel>
		<skos:altLabel xml:lang="en">slope soil</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004264"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk008310"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019790"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004264"/>
		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk004273"/>
		<xe:explanation_temp xml:lang="de">Ranker entstehen häufig an Hängen und in Gebirgslagen.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Ranker ist ein Landboden, der nur flachgründig ausgebildet ist und eine maximale Mächtigkeit von 30cm über dem silikatreichen oder quarzreichen Ausgangsgestein erreicht. Ein Unterboden-Horizont fehlt.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004264"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk008310"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019790"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-11-08T16:51:23+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004273">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">redzina soil</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Rendzina</skos:prefLabel>
		<skos:altLabel xml:lang="de">Rendzinen</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004264"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk008310"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019790"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004264"/>
		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk004272"/>
		<skos:definition xml:lang="de">Eine Rendzina ist ein Landboden, der nur flachgründig ausgebildet ist und eine maximale Mächtigkeit von 30cm über dem kalkreichen Ausgangsgestein erreicht. Ein Unterboden-Horizont fehlt.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004264"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk008310"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019790"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-11-08T16:51:23+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004274">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">chernozem</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Schwarzerde</skos:prefLabel>
		<skos:altLabel xml:lang="de">Schwarzerden</skos:altLabel>
		<skos:altLabel xml:lang="de">Tschernosem</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004264"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk008310"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019790"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004264"/>
		<skos:definition xml:lang="de">Eine Schwarzerde ist ein Landboden, der sich auf Löss oder mergelhaltigem Lockersediment entwickelt und einen sehr hohen natürlichen Nährstoffgehalt besitzt. Schwarzerden sind gut durchlüftet und weisen eine hohe Aktivität von Bodenorganismen auf.</skos:definition>
		<xe:explanation_temp xml:lang="de">Schwarzerden weisen die höchste Fruchtbarkeit aller Böden auf und sind daher wichtige Böden für Ackerbau und Gemüsebau. Sie besitzen eine Bodenmesszahl von 100 und bilden so die Referenz zur Bewertung des Potenzials aller anderen Bodentypen. </xe:explanation_temp>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004264"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk008310"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019790"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-11-08T16:51:23+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004275">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Braunerde</skos:prefLabel>
		<skos:altLabel xml:lang="en">braunerde</skos:altLabel>
		<skos:altLabel xml:lang="de">Braunerden</skos:altLabel>
		<skos:altLabel xml:lang="en">brown earth</skos:altLabel>
		<skos:prefLabel xml:lang="en">cambisol</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004264"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk008310"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019790"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004264"/>
		<xe:explanation_temp xml:lang="de">Die Braunerde ist ein typischer Bodentyp der mittleren Breiten und des gemäßigten Klimas.</xe:explanation_temp>
		<skos:definition xml:lang="de">Eine Braunerde ist ein Landboden, der als charakteristisches Merkmal einen verbraunten, durch Eisenfreisetzung entstandenen Unterboden besitzt und eine Mächtigkeit von 1,5 m über dem Ausgangsgestein erreicht.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4330466-7"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004264"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk008310"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019790"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-11-08T16:51:23+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004276">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Lessivé</skos:altLabel>
		<skos:prefLabel xml:lang="en">Luvisol</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Parabraunerde</skos:prefLabel>
		<skos:altLabel xml:lang="de">Parabraunerden</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004264"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk008310"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019790"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004264"/>
		<skos:definition xml:lang="de">Eine Parabraunerde ist ein Landboden, der sich neben der typischen Verbraunung zusätzlich durch eine vertikale Auswaschung und Verlagerung von Tonmineralen aus dem Oberboden in tiefere Horizonte auszeichnet.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004264"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk008310"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019790"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-11-08T16:51:23+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004277">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Ascheboden</skos:altLabel>
		<skos:prefLabel xml:lang="en">ash soil</skos:prefLabel>
		<skos:altLabel xml:lang="de">Bleicherde</skos:altLabel>
		<skos:altLabel xml:lang="de">Bleicherden</skos:altLabel>
		<skos:altLabel xml:lang="de">Bleichsand</skos:altLabel>
		<skos:altLabel xml:lang="de">Bleichsande</skos:altLabel>
		<skos:prefLabel xml:lang="de">Podsol</skos:prefLabel>
		<skos:altLabel xml:lang="de">Podsole</skos:altLabel>
		<skos:altLabel xml:lang="en">podzol</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004264"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk008310"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019790"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004264"/>
		<skos:definition xml:lang="de">Ein Podsol ist ein Landboden, der durch die Auswaschung von Eisen und Aluminium einen fahlen Bleichhorizont mit gräulicher Färbung aufweist. Oft entsteht durch diese Verlagerung im Unterboden eine verfestigte Ortsteinschicht.</skos:definition>
		<xe:explanation_temp xml:lang="de">Podsole entstehen über sauren Ausgangsgesteinen und weisen eine typische Vegetation auf, die an die sauren Bodenverhältnisse angepasst ist, wie z.B. Kiefern und Heidekraut. Diese Vegetation produziert ihrerseits eine schwer zersetzbare Humusschicht, die dem Boden nur schwach vermischt aufliegt.</xe:explanation_temp>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004264"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk008310"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019790"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-01-05T12:57:18+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004278">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Pseudogley</skos:prefLabel>
		<skos:altLabel xml:lang="de">Pseudogleye</skos:altLabel>
		<skos:prefLabel xml:lang="en">stagnosol</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004264"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk008310"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019790"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004264"/>
		<skos:definition xml:lang="de">Ein Pseudogley ist ein Landboden, der unter zeitweisem Einfluss von Stauwasser steht, der durch einen hohen Gehalt wasserundurchlässiger Tonminerale im Unterboden verursacht wird. Dadurch wird das Versickern verhindert oder verlangsamt.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004264"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk008310"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019790"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-11-08T16:51:23+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004283">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Einturmtor</skos:prefLabel>
		<skos:altLabel xml:lang="de">Einturmtore</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000989"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk009968"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk009968"/>
		<skos:definition xml:lang="de">Ein Einturmtor ist ein Tor, das in oder neben einem einzelnen Turm liegt.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk009968"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk001958"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004284"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-11-08T16:51:23+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004284">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="it">porta a torre</skos:prefLabel>
		<skos:prefLabel xml:lang="en">tower gate</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Turmtor</skos:prefLabel>
		<skos:altLabel xml:lang="de">Turmtore</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004283"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk005745"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004283"/>
		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk001958"/>
		<skos:definition xml:lang="de">Ein Turmtor ist ein Einturmtor, bei dem der Torweg im Untergeschoss des Turmes liegt.</skos:definition>
