        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T01:27:46.000</terms:modified>
        <skos:definition xml:lang="de">Eine Nische, die durch die Mauerstruktur oder durch Art und Farbe des Steinmaterials stärker betont wird. Die B. kommt hauptsächl. in spätroman. Zeit vor. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Okrasná nika předstírající další vedení otvoru (okno aj.) v řadě (např. románská horní okenní stěna). [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Ziernische, täuscht die Weiterführung einer Öffnung (Fenster o. ä.) in einer Reihe vor (z. B. romanischer Obergaden). [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Blendnische</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">slepá nika</skos:prefLabel>
    </owl:NamedIndividual>
    


