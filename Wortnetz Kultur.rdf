	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk019052">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Formgerät</skos:altLabel>
		<skos:altLabel xml:lang="de">Formgeräte</skos:altLabel>
		<skos:prefLabel xml:lang="de">Formwerkzeug</skos:prefLabel>
		<skos:altLabel xml:lang="de">Formwerkzeuge</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006128"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk012103"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk006128"/>
		<skos:definition xml:lang="de">Ein Formgerät ist ein Gerät, das in einem handwerklichen oder industriellen Prozess für die Formgebung und Formgestaltung benutzt wird.</skos:definition>
		<xe:explanation_temp xml:lang="de">Die Werkzeuge werden in der Metallindustrie, vor allem in der blechverarbeitenden Industrie (z. B. im Karosseriebau) und in der gesamten Gusstechnik, in der Kunststoffverarbeitung (z. B. beim Spritzgießen) sowie in einigen Handwerksbereichen (z. B. in der Schmiedekunst) verwendet.</xe:explanation_temp>
