<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68777> a skos:Concept ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "COMMERCIAL"@en ;
    skos:scopeNote "Sites, buildings, structures & features related to the sale, exchange &/or storage of goods or services. Includes commercially operated catering establishments & lodging premises."@en ;
    skos:topConceptOf <http://purl.org/heritagedata/schemes/eh_tmt2> .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99961> a skos:Concept ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "GARDENS PARKS AND URBAN SPACES"@en ;
    skos:scopeNote "Planned &/or landscaped areas designed for aesthetic or recreational purposes. Includes all sites, buildings, structures & features normally associated with parks & urban spaces including street furniture."@en ;
    skos:topConceptOf <http://purl.org/heritagedata/schemes/eh_tmt2> .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68707> a skos:Concept ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "HEALTH AND WELFARE"@en ;
    skos:scopeNote "Sites, buildings, structures & features associated with health (for example, treatment of the sick) &/or social welfare (for example, alleviation of poverty), including all charitable foundations & all forms of state defined social welfare."@en ;
    skos:topConceptOf <http://purl.org/heritagedata/schemes/eh_tmt2> .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99962> a skos:Concept ;
