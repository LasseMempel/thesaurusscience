		<skos:prefLabel xml:lang="gd">LÀRACH OBAIR CRÈADHA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far a bheilear a' dùsgadh crèadh à uachdar na talmhainn.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CLAY WORKINGS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-21T14:51:05</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-21T14:51:18</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
