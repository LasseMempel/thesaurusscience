        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_525777c7"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_8db770ce"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T22:39:59.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T12:33:21.000</terms:modified>
        <skos:altLabel xml:lang="en">bar tracery</skos:altLabel>
        <skos:altLabel xml:lang="cs">prutová konstrukce</skos:altLabel>
        <skos:altLabel xml:lang="cs">prutová soustava</skos:altLabel>
        <skos:definition xml:lang="de">Senkrechte Stäbe zur Unterteilung der Glasflächen unterhalb des Bogenfelds im Maßwerk got. Fenster; nach Lage und Dicke als Haupt- und Nebenstäbe unterschieden, auch als alte und junge Pfosten bezeichnet. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Členění gotických oken úzkými svislými kamennými prvky. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Stabwerk</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">ossature de croisée</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">pruty</skos:prefLabel>
        <skos:prefLabel xml:lang="es">tracería de crucero</skos:prefLabel>
        <skos:prefLabel xml:lang="it">traforo ad asta</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_958612cc -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_958612cc">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_381f9e69"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-20T12:27:50.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-07T09:47:04.000</terms:modified>
        <skos:definition xml:lang="de">Der zwischen Abakus und Säulenschaft liegende polsterförmige, im Querschnitt kreisrunde Abschnitt des dorischen Kapitells. An seinem unteren Ende finden sich meist vier scharf profilierte Ringe, die sogenannten Anuli. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="cs">ECHINUS, část dórské a iónské lavice. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Echinus (gr. echinos: Igel, Seeigel), Polster, der wulstartige, im Querschnitt kreisförmige Teil des dor. Kapitells, der zwischen der Deckplatte (Abacus) und dem Säulenschaft vermittelt (Dorische Ordnung), mit Ringen (Anuli) an seiner unteren Kante. In der Frühzeit stark bauchig und weit ausladend, erscheint der E. in der klass. Form gestraffter und erstarrt in der nachklass. Zeit fast zum Kegelstumpf. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Echinus</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">echinus</skos:prefLabel>
        <skos:prefLabel xml:lang="en">echinus</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">échine</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Teil des dorischen und ionischen Kapitells. [Koch 2009]</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_9587110f -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_9587110f">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_af38f5d3"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_ee7464eb"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-25T16:47:47.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T15:00:28.000</terms:modified>
        <skos:altLabel xml:lang="la">arunda</skos:altLabel>
        <skos:altLabel xml:lang="la">calamus</skos:altLabel>
        <skos:altLabel xml:lang="fr">chalumeau</skos:altLabel>
        <skos:altLabel xml:lang="en">eucharistic cannula</skos:altLabel>
        <skos:altLabel xml:lang="en">eucharistic reed</skos:altLabel>
        <skos:altLabel xml:lang="de">eucharistisches Saugröhrchen</skos:altLabel>
        <skos:altLabel xml:lang="la">pugillaris</skos:altLabel>
        <skos:definition xml:lang="de">Fistula f (lat.); auch eucharistisches Saugröhrchen n; lat. pipa; pugillaris ; calamus; arundo: ein Röhrchen aus Edelmetall, auch aus Elfenbein oder Glas, meist mit einem Griff, das bei der Kelchkommunion verwendet wurde (7.-1 5. Jh.), um ein Verschütten des Messweines zu verhindern. Besonders kunstvoll ausgeführt ist die beim päpstlichen PontifikaIamt auch weiterhin verwendete Fistula. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Fistula</skos:prefLabel>
        <skos:prefLabel xml:lang="en">fistula</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">fistula</skos:prefLabel>
        <skos:prefLabel xml:lang="la">pipa</skos:prefLabel>
    </owl:NamedIndividual>
    


