    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_9a6c71e7 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_9a6c71e7">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_c55445fe"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_d1311ee4"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-21T14:01:03.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T16:36:22.000</terms:modified>
        <skos:altLabel xml:lang="de">Horizontalbogen</skos:altLabel>
        <skos:altLabel xml:lang="fr">arc en plate-bande</skos:altLabel>
        <skos:altLabel xml:lang="fr">arc monolithique arasé</skos:altLabel>
        <skos:altLabel xml:lang="es">dintel escotado</skos:altLabel>
        <skos:altLabel xml:lang="es">dintel plano</skos:altLabel>
        <skos:altLabel xml:lang="en">flat arch</skos:altLabel>
        <skos:altLabel xml:lang="fr">linteau échancré</skos:altLabel>
        <skos:altLabel xml:lang="en">lintel</skos:altLabel>
        <skos:altLabel xml:lang="it">piattabanda</skos:altLabel>
        <skos:altLabel xml:lang="de">scheitrechter Bogen</skos:altLabel>
        <skos:altLabel xml:lang="de">scheitrechter Sturz</skos:altLabel>
        <skos:definition xml:lang="de">Bogenförmige Überdeckung einer Fenster- oder Türöffnung durch einen Stein mit gerundeter Unterseite. Ausnahmsweise auch ein gerader Sturz mit ausgerundeter Oberseite. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Scheitrechter Bogen, Sturzbogen, Horizontalbogen; trotz waagerechter Untersicht ein echter Bogen, d. h. die Fugen weisen zu einem angenommenen gemeinsamen Mittelpunkt. Der Setzung des Mauerwerks wird bei der Konstruktion des S.S.es durch eine geringfügige Erhöhung der Mitte oder durch Anordnung eines Entlastungsbogens entgegengewirkt. Ist der S. S. aus Werksteinen gefügt, so können zur Verbesserung der Tragfähigkeit auch Hakensteine verwendet werden. [Koepf / Binding 2016] </skos:definition>
        <skos:definition xml:lang="de">Segmentbogenförmiger Abschluss einer Fenster- oder Türöffnung, missverständl. auch für einen Scheitrechten Sturz. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Sturzbogen</skos:prefLabel>
        <skos:prefLabel xml:lang="es">arco achatado</skos:prefLabel>
        <skos:prefLabel xml:lang="it">arco ribassato (di porta o di finestra)</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">plate-bande bombée</skos:prefLabel>
        <skos:prefLabel xml:lang="en">vaulted lintel</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">záklenek</skos:prefLabel>
    </owl:NamedIndividual>
    


