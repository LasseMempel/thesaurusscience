		<skos:altLabel xml:lang="de">Gebetstuhl</skos:altLabel>
		<skos:altLabel xml:lang="de">Gebetstühle</skos:altLabel>
		<skos:altLabel xml:lang="en">prayer bench</skos:altLabel>
		<skos:altLabel xml:lang="en">prayer desk</skos:altLabel>
		<skos:altLabel xml:lang="en">prayer stool (prie-dieus bench)</skos:altLabel>
		<skos:prefLabel xml:lang="en">prie-dieu (bench)</skos:prefLabel>
		<skos:altLabel xml:lang="en">prie-dieus (benches)</skos:altLabel>
		<skos:altLabel xml:lang="en">prie-dieux (benches)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk002862"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk001919"/>
		<skos:definition xml:lang="de">Ein Betstuhl ist ein Möbelstück für das Gebet in kniender Haltung, meist aus Holz gefertigt. Er hat die Form eines Gestells oder Pults mit einer schmalen, geneigten Ablage zum Auflegen eines Gebetsbuchs oder der Hände, manchmal ersetzt durch eine gepolsterte Armlehne. Meistens verfügt er auch über eine Kniebank oder Knieauflage. Betstühle finden sich in Kirchen, Klöstern, Privatwohnungen und konfessionellen Einrichtungen.</skos:definition>
		<skos:mappingRelation rdf:resource="http://d-nb.info/gnd/4196454-8"/>
