<http://www.eionet.europa.eu/gemet/concept/2707> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8339> ;
    skos:closeMatch <http://data.uba.de/umt/_00008050> ;
    skos:definition "An approach to pollution control which concentrates upon effluent treatment or filtration prior to discharge into the environment, as opposed to making changes in the process giving rise to the wastes."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "End-of-Pipe Technik"@de,
        "end-of-pipe technology"@en .

<http://www.eionet.europa.eu/gemet/concept/2714> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2733> ;
    skos:closeMatch <http://data.uba.de/umt/_00008109>,
        <http://dbpedia.org/resource/Energy_conservation> ;
    skos:definition "The strategy for reducing energy requirements per unit of industrial output or individual well-being without affecting the progress of socio-economic development or causing disruption in life style. In temperate developed countries most energy is used in heating and lighting industrial and domestic buildings. Industrial processes, transport and agriculture are the other main users. During the 1970s it was demonstrated that substantial savings could be achieved through appropriate building technologies and the use of energy-efficient equipment for heating, air-conditioning and lighting. Most goods could and should be both manufactured and made to work more efficiently."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_2567> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Energieeinsparung"@de,
        "energy conservation"@en .

<http://www.eionet.europa.eu/gemet/concept/2716> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2734> ;
    skos:closeMatch <http://data.uba.de/umt/_00008177> ;
    skos:definition "The process of changing energy from one form to another."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_10608>,
        <http://eurovoc.europa.eu/203> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Energieumwandlung"@de,
        "energy conversion"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Energy_transformation> .

<http://www.eionet.europa.eu/gemet/concept/2720> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2749> ;
    skos:definition "Any loss of energy, generally by conversion into heat."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Energievernichtung"@de,
        "energy dissipation"@en .

