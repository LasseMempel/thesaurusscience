    <!-- https://hist-arch-vocab.org/bvha#c_382465bd -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_382465bd">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
