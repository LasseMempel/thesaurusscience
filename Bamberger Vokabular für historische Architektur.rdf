    <!-- https://hist-arch-vocab.org/bvha#c_adecb586 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_adecb586">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_12194ed3"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-05T10:08:47.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T12:30:14.000</terms:modified>
        <skos:definition xml:lang="de">Flamboyant (frz. flammend, geflammt), Maßwerk der spätgot. Baukunst in Frankreich und England, Flowing tracery, das von der dort als Flamme gedeuteten Fischblase bes. starken Gebrauch macht. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="fr">flamboyant</skos:prefLabel>
        <skos:prefLabel xml:lang="de">flammenartig</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_adef846e -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_adef846e">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_3e25acca"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_da303341"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-18T14:49:32.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-12-01T14:46:56.000</terms:modified>
        <skos:altLabel xml:lang="fr">clef de voûte</skos:altLabel>
        <skos:altLabel xml:lang="cs">cíp</skos:altLabel>
        <skos:altLabel xml:lang="en">gore</skos:altLabel>
        <skos:altLabel xml:lang="en">lune</skos:altLabel>
        <skos:altLabel xml:lang="cs">pendentiv</skos:altLabel>
        <skos:definition xml:lang="de">1. die dreieckige, meist auf einer Spitze stehende Fläche zwischen zwei divergierenden Bogenlinien ( = Bogenzwickel) oder zwischen Bogen und rechtwinkliger Einfassung (= Spandrille); 2. Hängezwickel bzw. Pendentifs (Kuppel). [Koch 2009] </skos:definition>
        <skos:definition xml:lang="de">Der Zwischenraum zwischen dem Gewölberücken und dem aufgehenden Mauerwerk über dem Widerlager. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Eckz., Teilgewölbe (Trompe), das zu einer Kuppel oder zu einem Klostergewölbe überleitet. Ein Z. in Form eines sphär. Dreiecks ist der Pendentif. [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Trojúhelníková, většinou na špici stojící plocha mezi dvěma divergujícími obloukovými liniemi. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Zwickel (räumlich)</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">cvikl (prostorově)</skos:prefLabel>
        <skos:prefLabel xml:lang="es">pechina</skos:prefLabel>
        <skos:prefLabel xml:lang="it">pennacchio</skos:prefLabel>
        <skos:prefLabel xml:lang="en">spandrel (vault)</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">écoinçon (voûte)</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_adf814f2 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_adf814f2">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_9e3fea21"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_9fcb19ed"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-02T12:56:58.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-31T00:01:17.000</terms:modified>
        <skos:prefLabel xml:lang="de">Mechelener Schema</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Das Retabel des Mechelener Schemas hat als Grundform ein Quadrat. Wie beim Brüsseler Schema sind drei Gefachtravéen ausgebildet, von denen die Mittlere erhöht ist. Die Travéen werden von Maßwerk überfangen, die Abschlusskante des Maßwerks liegt bei allen Travéen auf derselben Höhe. Der Schrein verfügt über einen Fries. Die Retabelflügel reichen über die gesamte Höhe des Schreins (Fries, Gefach, Maßwerk). [Gliesmann 2011] </skos:scopeNote>
    </owl:NamedIndividual>
    


