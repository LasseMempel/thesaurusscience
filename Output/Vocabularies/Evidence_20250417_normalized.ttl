<http://purl.org/heritagedata/schemes/eh_evd/concepts/99975> a skos:Concept ;
    skos:altLabel "Submerged"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/97294> ;
