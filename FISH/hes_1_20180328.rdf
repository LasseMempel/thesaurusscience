		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500623" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/501004">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/501004</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">DOCA-TIONNDAIDH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Uisgeadan iadhta a tha na phàirt de shiostam doca, mar is trice airson longan a thionndadh agus eadar-dhealaichte o dhocannan dùinte far a bheilear a' toirt bathar far longan no ga luchdadh orra.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">DOCK BASIN</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-02-12T11:12:40</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-07-24T12:48:16</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1384" />
				<skos:scopeNote xml:lang="en">An enclosed area of water within a dock system, typically for turning (canting) ships and to be distinguished from enclosed docks used for loading and unloading.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502114">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502114</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">LEUMADAIR-ACRACHAIDH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Badan phoidhlichean airson soitheach acrachadh ann.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">DOLPHIN</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-14T14:56:55</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-14T14:57:05</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1384" />
				<skos:scopeNote xml:lang="en">A cluster of piles for mooring a vessel.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
