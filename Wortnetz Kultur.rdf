		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk007987"/>
		<skos:definition xml:lang="de">Ein Pullunder ist ein Pullover, der ärmellos ist und die Funktion einer Weste übernimmt. Er wird über anderen Oberbekleidungsstücken getragen.</skos:definition>
