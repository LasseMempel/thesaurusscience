		<skos:prefLabel xml:lang="gd">FACTARAIDH ÒRDANAIS</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach no làrach far a bheilear a' dèanamh buill-airm bheaga, gunnaichean-mòra, connadh-gunna, stuthan-iomain, stuthan-spreadhaidh is msaa.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ORDNANCE FACTORY</skos:prefLabel>
