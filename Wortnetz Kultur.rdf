	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk014038">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Schneemann</skos:prefLabel>
		<skos:altLabel xml:lang="de">Schneemänner</skos:altLabel>
		<skos:prefLabel xml:lang="en">snowman</skos:prefLabel>
		<skos:altLabel xml:lang="en">snowmen</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000742"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013598"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000742"/>
		<skos:definition xml:lang="de">Ein Schneemann ist eine Figur aus Schnee. Ein klassischer Schneemann besteht aus drei aufeinander gestapelten Schneebällen, die den Kopf, den Körper und die Basis bilden. Der Kopf wird oft mit Steinen oder Kohlen als Augen, einer Karotte als Nase und Kieselsteinen als Mund verziert. Häufig werden Zweige genutzt, um am Körper Arme darzustellen. Ein Schneemann kann auch mit Hüten, Schals oder andere Accessoires dekoriert werden. Schneemänner sind temporäre Konstruktionen, die schmelzen, sobald die Außentemperaturen steigen.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4316829-2"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q483985"/>
