		<skos:prefLabel xml:lang="gd">STÈISEAN DÌ-THRUAILLEADH GAS</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Ionad far a bheilear a' toirt truailleadh à ceò-guail.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GAS PURIFICATION STATION</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
