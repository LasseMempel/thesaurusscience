    <!-- https://hist-arch-vocab.org/bvha#c_7e4c947d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_7e4c947d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_70bbf373"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-07T14:31:12.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T18:02:53.000</terms:modified>
        <skos:altLabel xml:lang="fr">aile (d\&apos;escalier)</skos:altLabel>
        <skos:altLabel xml:lang="es">brazo ala de la escalera imperial</skos:altLabel>
        <skos:altLabel xml:lang="it">rampa di scala</skos:altLabel>
        <skos:altLabel xml:lang="cs">schodišt\&apos;ové rameno</skos:altLabel>
        <skos:definition xml:lang="de">Folge mehrerer Treppenläufe zwischen zwei Geschossen bei reicheren (zwei-, drei-, mehrarmigen) Treppenformen. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Schodišťové rameno vedoucí v jiném směru než druhé schodišťové rameno (lomené schodiště), s nímž má však společné odpočívadlo. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Treppenlauf, der in eine andere Richtung als ein zweiter Treppenlauf führt (gebrochene Treppe), mit diesem aber einen gemeinsamen Treppenabsatz = Podest hat. Jeder Arm kann wieder mehrere Läufe und Richtungen haben. Zwei- oder mehrarmig heißt eine Treppenanlage, die a) nicht mit demselben Treppenlauf beginnt oder endet oder b) von einem gemeinsamen Podest aus sich in 2 Läufe teilt, die in unterschiedliche, z.B. entgegengesetzte Richtungen führen. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Treppenarm</skos:prefLabel>
        <skos:prefLabel xml:lang="es">ala de la escalera imperial</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">montée (d\&apos;escalier)</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">schodišťová část</skos:prefLabel>
        <skos:prefLabel xml:lang="en">stair shapes</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_7e4d9ed1 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_7e4d9ed1">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0e469ac8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-21T11:34:52.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-05T12:41:35.000</terms:modified>
        <skos:altLabel xml:lang="de">Tribünenbogen</skos:altLabel>
        <skos:altLabel xml:lang="fr">arc d\&apos;exèdre</skos:altLabel>
        <skos:definition xml:lang="de">In der römischen Markt- oder Gerichtsbasilika der Bogen, an den sich die Tribunalnische - der erhöhte Platz am Ende der Basilika, die Rednerbühne, die spätere Apsis - anschloss und sie vom Langschiff trennte. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Tribunalbogen</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">arc de tribune romaine</skos:prefLabel>
        <skos:prefLabel xml:lang="en">arch of Roman tribunal</skos:prefLabel>
        <broaderByPosition rdf:resource="https://hist-arch-vocab.org/bvha#c_0e469ac8"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_7e4e7b04 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_7e4e7b04">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b54dd069"/>
