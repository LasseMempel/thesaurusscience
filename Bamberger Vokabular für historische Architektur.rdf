    <!-- https://hist-arch-vocab.org/bvha#c_81477d2c -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_81477d2c">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
