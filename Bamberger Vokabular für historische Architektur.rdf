    <!-- https://hist-arch-vocab.org/bvha#c_2df3b013 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_2df3b013">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_49b400f3"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T11:53:40.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T12:40:41.000</terms:modified>
        <skos:definition xml:lang="de">Fahrgestell mit einem hölzernen Esel, auf dem eine lebensgroße Christusfigur mit segnender Gebärde sitzt. Wird seit dem Mittelalter in der Palmsonntagsprozession mitgeführt zur Erinnerung an Christi Einzug in Jerusalem (Matthäus, 21,1-11). [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Podvozek s dřevěným oslíkem, na němž sedí figura Krista v životní velikosti se žehnajícím gestem, od středověku součást procesí o Květné neděli, aby připomínalo Kristův příchod do Jeruzaléma (Matouš). [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Palmesel</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">velikonoční oslátko</skos:prefLabel>
    </owl:NamedIndividual>
    


