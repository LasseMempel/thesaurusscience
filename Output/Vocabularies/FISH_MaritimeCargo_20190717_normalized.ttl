    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Cedar"@en ;
    skos:scopeNote "Durable wood from the cedar tree."@en .

<http://purl.org/heritagedata/schemes/77/concepts/109253> a skos:Concept ;
