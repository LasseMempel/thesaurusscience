	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1815">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1815</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">RATHAD-IARAINN RÈILE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Traca a tha na rèilichean iarainn no stàilinn air a bheil  carbadan luchd-siubhail no bathair a' gluasad, mar is trice le einnsean-rèile gan tarraing.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">RAILWAY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1817">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1817</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">AONA-RÈILE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Rathad-iarainn aig nach eil ach an aon traca.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">MONORAIL</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1815" />
				<skos:scopeNote xml:lang="en">A single track railway.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1811" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1816" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/503681" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1861" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500627" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/504861" />
		<skos:scopeNote xml:lang="en">A line or track consisting of iron or steel rails, on which passenger carriages or goods wagons are moved, usually by a locomotive engine.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
