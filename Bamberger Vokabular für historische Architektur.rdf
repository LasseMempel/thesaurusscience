        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-22T16:47:59.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:16:38.000</terms:modified>
        <skos:altLabel xml:lang="de">gebürstetes Gewölbe</skos:altLabel>
        <skos:altLabel xml:lang="de">gefußtes Gewölbe</skos:altLabel>
        <skos:altLabel xml:lang="de">überhobenes Gewölbe</skos:altLabel>
        <skos:definition xml:lang="de">Gewölbe, bei dem zwischen Kämpfergesims und Beginn der Gewölbekrümmung mit dem ersten Keilstein ein kurzes, vertikales Mauerstück eingefügt ist. Die Gewölbelinie beginnt also erst einige Steine oberhalb des Auflagers. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">gestelztes Gewölbe</skos:prefLabel>
        <skos:prefLabel xml:lang="en">stilted vault</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte surélevée</skos:prefLabel>
        <broaderByConstruction rdf:resource="https://hist-arch-vocab.org/bvha#c_049c4c22"/>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_049c4c22"/>
    </owl:NamedIndividual>
    


