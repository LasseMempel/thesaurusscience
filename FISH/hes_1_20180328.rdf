				<skos:scopeNote xml:lang="en">A small building housing a valve which controls the flow of water from a reservoir via a canal feeder channel to a canal.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
