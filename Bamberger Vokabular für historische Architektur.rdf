    <!-- https://hist-arch-vocab.org/bvha#c_21652d6e -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_21652d6e">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_52399e62"/>
