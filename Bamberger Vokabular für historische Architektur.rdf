        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-07T13:11:20.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-28T08:39:00.000</terms:modified>
        <skos:altLabel xml:lang="la">clavicula</skos:altLabel>
        <skos:definition xml:lang="de">Tabernakelschlüssel m; lat. clavicella; clavicula: der kleine Schlüssel für das Tabernakelpförtchen zum sicheren Verschluss der Eucharistie (gefordert vom Canon 938 des Codex Iuris Canonici von 1983). Er ist in der Sakristei &quot;an geheimem Platz unter Verschluss mittels eines zweiten Schlüssels zu verwahren&quot; (Hortatio vom 10. Februar 1941). [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Tabernakelschlüssel</skos:prefLabel>
        <skos:prefLabel xml:lang="la">clavicella</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">clef du tabernacle</skos:prefLabel>
        <skos:prefLabel xml:lang="en">key of tabernacle</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_826f3942 -->


