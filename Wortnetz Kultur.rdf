		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk012655"/>
		<skos:definition xml:lang="de">Die Nikolausankunft ist ein Fest, bei dem am ersten Samstag nach dem Martinstag die Ankunft des Nikolaus` gefeiert wird. Dieses Fest wird vor allem in den Niederlanden gefeiert.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk013777"/>
