        <skos:altLabel xml:lang="de">Biforienfenster</skos:altLabel>
        <skos:altLabel xml:lang="de">Biforium</skos:altLabel>
        <skos:definition xml:lang="de">Die durch eine mittlere Stütze unterteilte Maueröffnung, Fenster. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:definition xml:lang="cs">Rozdělené středním sloupkem do dvou otvorů. [Koch 2008]</skos:definition>
