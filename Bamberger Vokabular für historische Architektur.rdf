    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_65ea7409 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_65ea7409">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_46483b7b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_e1c3d376"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_f8e3d9a1"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-05T17:45:00.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-13T15:10:03.000</terms:modified>
        <skos:altLabel xml:lang="de">Deichselkreuz</skos:altLabel>
        <skos:altLabel xml:lang="de">Schächerkreuz</skos:altLabel>
        <skos:altLabel xml:lang="la">crux deassala</skos:altLabel>
        <skos:altLabel xml:lang="en">pair-cross</skos:altLabel>
        <skos:definition xml:lang="de">Gabelkreuz n; auch Deichselkreuz n; Schächerkreuz n; lat. furca; crux deassala: ein Kreuz mit schräg aufwärtsgerichteten Querbalken; auf frühchristlichen und byzantinischen Darstellungen das Kreuz, an das die Schacher geschlagen wurden. Formvarianten sind das volle Gabelkreuz (n) oder Zweigkreuz (n), bei dem alle Balkenenden gespreizt sind und das Dreizinken-Gabelkreuz (n). [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Gabelkreuz</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">croix fourchée</skos:prefLabel>
        <skos:prefLabel xml:lang="en">forked cross</skos:prefLabel>
        <skos:prefLabel xml:lang="la">furca</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">vidlicový, rozsochový kříž</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_46483b7b"/>
    </owl:NamedIndividual>
    


