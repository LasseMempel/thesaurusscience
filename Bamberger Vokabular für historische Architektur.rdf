        <skos:altLabel xml:lang="fr">livre des collectes</skos:altLabel>
        <skos:altLabel xml:lang="fr">livre des oraisons</skos:altLabel>
        <skos:altLabel xml:lang="la">orationarius</skos:altLabel>
        <skos:definition xml:lang="de">Kollektar n, collectarius liber, collectarium, collectaneum, orationarius: Sammlung der priesterlichen Tages- und Festgebete, oft auch mit Antiphonen, Hymnen usw. [Glossarium Artis] </skos:definition>
        <skos:prefLabel xml:lang="de">Kollektar</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">collectaire</skos:prefLabel>
        <skos:prefLabel xml:lang="la">collectarius liber</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kolektář</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_f63914df -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_f63914df">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f78b2e4c"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-20T14:38:41.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-14T16:39:39.000</terms:modified>
        <skos:definition xml:lang="de">Eine Sonderform des Gewölbes mit steigendem Rücken, bei welcher die Wölbung von stufenartig einander folgenden Bogen, den sogenannten Gurten oder Zonen gebildet wird. Es hat also eine gebrochen verlaufende Scheitellinie. Zu unterscheiden vom Gurtgewölbe. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Gurtengewölbe </skos:prefLabel>
        <skos:prefLabel xml:lang="en">inclined barrel vault composed of a series of arches </skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte en berceau incliné appareillée en rouleaux à ressauts</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_f644efa6 -->


