		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/613" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/614" />
		<skos:scopeNote xml:lang="en">A cast iron direction marker plate, usually fastened to a stone support with clips or bolts.</skos:scopeNote>
