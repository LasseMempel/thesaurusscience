		<skos:prefLabel xml:lang="gd">DÙN-SGUDAIL CLACH-OLA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Torr cartaidh, faisg air mèinn ola cloiche-guail agus FACTARAIDH ola, sa bheil an sgudal a thig às na soithichean san robhar a' ròstadh na cloiche-ghuail gus diofar bathar ola a dhèanamh mar phaireafain is cèir.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SHALE BING</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
