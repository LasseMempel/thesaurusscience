    <!-- https://hist-arch-vocab.org/bvha#c_2c32cca6 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_2c32cca6">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0f62a529"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T14:58:35.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-31T00:08:14.000</terms:modified>
        <skos:definition xml:lang="cs">Místo pro vyslechnutí zpovědi, cca. od r. 1600 ve dnešní podobě: trojdílná dřevěná skříň, ve střední části sedí duchovní, který je mřížkou oddělen od zpovídajících se, kteří střídavě klečí v bočních částech zpovědnice. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Sitz zum Beichthören, seit etwa 1600 in der heutigen Form: dreiteiliges Holzgehäuse, im Mittelteil sitzt der Geistliche, durch Gitter von den Beichtenden getrennt, die abwechselnd in den Seitenteilen knien. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Beichtstuhl</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">zpovědnice</skos:prefLabel>
    </owl:NamedIndividual>
    


