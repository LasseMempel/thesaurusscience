		<skos:altLabel xml:lang="de">Nikolausfest</skos:altLabel>
		<skos:prefLabel xml:lang="en">St. Nicholas Celebration</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006601"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013777"/>
