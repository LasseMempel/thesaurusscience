        <skos:altLabel xml:lang="en">Turkish dome</skos:altLabel>
        <skos:altLabel xml:lang="de">Zwiebeldach </skos:altLabel>
        <skos:altLabel xml:lang="de">Zwiebelhaube </skos:altLabel>
        <skos:altLabel xml:lang="it">c. a cipolla</skos:altLabel>
        <skos:altLabel xml:lang="es">c. c. t. persa</skos:altLabel>
        <skos:altLabel xml:lang="cs">cibule</skos:altLabel>
        <skos:altLabel xml:lang="cs">cibulová báň</skos:altLabel>
        <skos:altLabel xml:lang="fr">coupole bulbeuse</skos:altLabel>
        <skos:altLabel xml:lang="it">cupola a bulbo</skos:altLabel>
        <skos:altLabel xml:lang="es">cúpula con tejado imperial</skos:altLabel>
        <skos:altLabel xml:lang="fr">dôme bulbeux</skos:altLabel>
        <skos:altLabel xml:lang="fr">dôme en bulbe</skos:altLabel>
        <skos:altLabel xml:lang="fr">dôme outrepasse en bulbe</skos:altLabel>
        <skos:altLabel xml:lang="en">onion dome</skos:altLabel>
        <skos:altLabel xml:lang="en">onionshaped dome</skos:altLabel>
        <skos:definition xml:lang="de">Außenkuppel bzw. ein Kuppeldach, das unten konvex und oben konkav geschwungen ist und in einer Spitze ausläuft. Beispiel: Die Haubendächer über den Türmen der Basilius Kathedrale in Moskau, das Dach der Kirche von St. Johann Baptist in Western darf/ Oberbayern. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Kuppel mit einem Zwiebeldach. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Zwiebelkuppel</skos:prefLabel>
        <skos:prefLabel xml:lang="en">bulbous dome</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">cibulová střecha</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">dôme bulbe</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Besonders Süddeutschland, Österreich. [Koch 2009]</skos:scopeNote>
        <skos:scopeNote xml:lang="cs">Zvl. jižní Německo a Rakousko. [Koch 2008]</skos:scopeNote>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_ad800342"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_bc1004ab -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_bc1004ab">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_be6dd5fa"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_34ca6582"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-16T14:30:09.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T16:31:51.000</terms:modified>
        <skos:altLabel xml:lang="de">Buchdeckelverhärtung</skos:altLabel>
        <skos:altLabel xml:lang="en">case hardening</skos:altLabel>
        <skos:altLabel xml:lang="fr">desquamation en plaque</skos:altLabel>
        <skos:altLabel xml:lang="cs">odprýskávání plátků</skos:altLabel>
        <skos:definition xml:lang="de">Hier verläuft die Trennfläche zwischen Schale und gesundem Gestein parallel zur Gesteinsoberfläche. Im Fall von ebenen Oberflächen kann die Konturschale auch als „Abplatzung“ bezeichnet werden. [ICOMOS-ISCS] </skos:definition>
        <skos:definition xml:lang="cs">Odpadávání povrchů a hran v tenkých plátcích při kterémstyková plocha s nezvětralou částí kamene je paralelní spovrchem kamene. V případě plochého povrchu oddělováníkamene může být označené jako odprýskávání plochy. [ICOMOS-ISCS] </skos:definition>
        <skos:definition xml:lang="fr">desquamation dont l’interface avec la partie saine de la pierre reproduit le modelé de la pierre, parallèlement à sa surface. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="en">scaling in which the interface with thesound part of the stone is parallel to the stone surface. [ICOMOS-ISCS]</skos:definition>
        <skos:prefLabel xml:lang="de">Konturschale</skos:prefLabel>
        <skos:prefLabel xml:lang="en">contour scaling</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">contour scaling</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">odpadávání povrchů a hran</skos:prefLabel>
    </owl:NamedIndividual>
    


