		<skos:altLabel xml:lang="mul">Tetracoralla</skos:altLabel>
		<skos:altLabel xml:lang="mul">Tetracorallia</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk021280"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk021280"/>
		<skos:definition xml:lang="de">Eine Runzelkoralle ist ein ausgestorbenes Nesseltier, das durch ein meist hornförmiges Kalkskelett mit einer runzeligen Außenwand sowie durch gut entwickelte vierstrahlig angeordnete Septen gekennzeichnet ist. Runzelkorallen lebten überwiegend solitär, seltener koloniebildend und waren wichtige Riffbildner im Paläozoikum.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4291454-1"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q133091"/>
