    skos:prefLabel "CHAMBERED LONG CAIRN"@en ;
    skos:scopeNote "A Neolithic burial monument comprising a rectangular or trapezoidal stony mound which contains either a passage at one end with or without lateral chambers, or one or more smaller chambers entered from the side of the mound."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70047> a skos:Concept ;
    skos:altLabel "Gallery Grave"@en,
        "Transepted Gallery Grave"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70045>,
        <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70050> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "CHAMBERED ROUND CAIRN"@en ;
    skos:scopeNote "A Neolithic burial monument comprising an approximately circular stony mound which contains a stone-built chamber, with or without additional lateral chambers."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70049> a skos:Concept ;
    skos:altLabel "Complex Ring Cairn"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70044> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "RING CAIRN"@en ;
    skos:scopeNote "A low, wide, circular ring or bank of stones surrounding an open, roughly circular area which is (or was initially) free of cairn material. The inner and outer faces of the bank may be kerbed."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70051> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70044> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "SQUARE CAIRN"@en ;
    skos:scopeNote "A roughly square mound of stones which may also contain or conceal a burial."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70052> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99962> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "TOR CAIRN"@en ;
    skos:scopeNote "A circular bank of stones and turf, sometimes accompanied by a ditch, surrounding a natural outcrop of rock, usually a tor, or an earthfast boulder."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70054> a skos:Concept ;
    skos:altLabel "Barrow Field"@en,
        "Round Barrow Cemetery"@en,
        "Square Barrow Cemetery"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70053> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "BARROW CEMETERY"@en ;
    skos:scopeNote "A cluster of closely spaced barrows and related monuments (eg. ring ditches). Use with specific barrow-types where known."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70055> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70053> ;
