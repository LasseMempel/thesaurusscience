        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T18:13:22.000</terms:modified>
        <skos:prefLabel xml:lang="de">Apostelkreuz</skos:prefLabel>
        <skos:prefLabel xml:lang="en">apostle cross</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">croix apostolique</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Apostelkreuz, Weihekreuz an den Apostelleuchtern. [Glossarium Artis]</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_4c25291a -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_4c25291a">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_66433988"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a9967019"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_c51fa22d"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_167cb98f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_19d56a39"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_46c53805"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-28T08:48:28.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T14:22:20.000</terms:modified>
        <skos:altLabel xml:lang="de">Gratbalken</skos:altLabel>
        <skos:altLabel xml:lang="de">Hahnenbalken</skos:altLabel>
        <skos:definition xml:lang="de">Gratbalken, Kehlbalken, der diagonal auf die Ecke zulaufende Balken einer Balkenlage, in den die übrigen Balken eingezapft werden, vorrangig bei Dachbalkenlagen; besser ist die Anordnung eines Gratstichbalkens. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Horizontal zwischen den beiden Sparren eines Sparrenpaares eingespanntes Holz, zugleich geschossunterteilend als Bundkehlbalken im Querbund. [Eißing et al. 2012]</skos:definition>
        <skos:prefLabel xml:lang="de">Kehlbalken</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">hambalky</skos:prefLabel>
        <broaderByPosition rdf:resource="https://hist-arch-vocab.org/bvha#c_66433988"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_4c33a164 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_4c33a164">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_8c8249bf"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-25T13:30:22.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-13T11:04:32.000</terms:modified>
        <skos:definition xml:lang="de">Der innerhalb zeitl. (Bauperiode) oder räuml. Grenzen fertiggestellte Teil eines Baus. Bei großen Bauvorhaben, die eine lange Bauzeit erfordern, können von vornherein bestimmte B.e eingeplant sein (Baulos), um das fristgerechte Fortschreiten der Bauarbeiten kontrollieren zu können oder aus wirtschaftl. und anderen Gründen. Die an ma. Kathedralen erkennbaren B.e (Baunaht) sind jedoch häufig durch unfreiwillige Unterbrechungen der Bauarbeiten, wie wirtschaftl. Schwierigkeiten, Einsturzkatastrophen, Kriege, Brände u.a„ entstanden. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Bauabschnitt</skos:prefLabel>
    </owl:NamedIndividual>
    


