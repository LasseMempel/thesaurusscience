				<skos:scopeNote xml:lang="gd">Togalach far a bheil àitichean-fuirich do dh'oifigearan an airm.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">OFFICERS QUARTERS</skos:prefLabel>
