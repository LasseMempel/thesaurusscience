        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:37:55.000</terms:modified>
        <skos:altLabel xml:lang="en">squinch dome</skos:altLabel>
        <skos:definition xml:lang="de">Eine über Ecktrichtern (Trompe) errichtete Kuppel. Ungenau auch fur  ein über Trompen errichtetes Klostergewölbe. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">In der Regel eine vieleckige Kuppel über quadratischem Grundriss, bei der Trompen den Übergang von der Grundfläche zum Kuppelfuß ermöglichen. (Glossarium Artis)</skos:definition>
        <skos:definition xml:lang="cs">Má horní rohy čtyřboké spodní části stavby přemostěny trompy. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="fr"> coupole sur trompes </skos:prefLabel>
        <skos:prefLabel xml:lang="de">Trompenkuppel </skos:prefLabel>
        <skos:prefLabel xml:lang="it">cupola su tromba</skos:prefLabel>
        <skos:prefLabel xml:lang="es">cúpula sobre una trompa</skos:prefLabel>
        <skos:prefLabel xml:lang="en">dome on squinches</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kupole na trompech</skos:prefLabel>
        <broaderByConstruction rdf:resource="https://hist-arch-vocab.org/bvha#c_ad800342"/>
    </owl:NamedIndividual>
    


