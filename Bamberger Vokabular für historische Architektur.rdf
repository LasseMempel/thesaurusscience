    <!-- https://hist-arch-vocab.org/bvha#c_103322ff -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_103322ff">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
