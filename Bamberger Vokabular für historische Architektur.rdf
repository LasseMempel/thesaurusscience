        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-16T15:37:32.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:12:46.000</terms:modified>
        <skos:altLabel xml:lang="en">quadrant vault </skos:altLabel>
        <skos:definition xml:lang="de">Gewölbe, das nur einseitig vom Widerlager bis zum Scheitel aufgeführt ist, in der Regel eine Halbtonne. Es dient z.B. zur Überwölbung der Seitenschiffe mittelalterlicher Kirchen oder als Treppenunterwölbung. Zu unterscheiden vom Horngewölbe. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Einschenkliges Gewölbe</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">demi-voûte </skos:prefLabel>
        <skos:prefLabel xml:lang="en">half barrel vault</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">jednoramenná klenba</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_049c4c22"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_4a2c8f27 -->


