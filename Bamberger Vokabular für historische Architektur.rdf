        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_55ffe661"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_a73a67a1"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_f8bc9d09"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-05T16:44:21.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T19:22:26.000</terms:modified>
        <skos:altLabel xml:lang="de">Türrahmen</skos:altLabel>
        <skos:altLabel xml:lang="fr">bâti de porte</skos:altLabel>
        <skos:altLabel xml:lang="it">telaio della porta</skos:altLabel>
        <skos:definition xml:lang="de">Fest mit dem Mauerwerk verbundener Rahmen einer Tür, in dem das bewegl. Türblatt sitzt. Man unterscheidet den flachen, eingestellten Türrahmen und den Zargenstock (Zarge), der eingemauert wird. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Separates, nicht konstruktives Holzgerüst, das als Blockrahmen oder Zargenrahmen in die Türöffnung eingesetzt oder als Blendrahmen der Wand vorgeblendet wird und dadurch dem Türblatt als Anschlag dient. [Schrader / Voigt 2003]</skos:definition>
        <skos:prefLabel xml:lang="de">Türstock</skos:prefLabel>
        <skos:prefLabel xml:lang="it">chiassile della porta</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">châssis de porte</skos:prefLabel>
        <skos:prefLabel xml:lang="en">door frame</skos:prefLabel>
        <skos:prefLabel xml:lang="es">marco</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_13425c9a -->


