        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-21T13:47:55.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:24:39.000</terms:modified>
        <skos:altLabel xml:lang="en">conoidal barrel vault </skos:altLabel>
        <skos:altLabel xml:lang="en">conoidal vault</skos:altLabel>
        <skos:definition xml:lang="de">Gewölbe, meist eine Tonne, mit konvergierend oder divergierend verlaufenden Widerlagermauern und horizontaler Scheitellinie. Zu unterscheiden vom konischen Gewölbe. [Glossarium Artis]</skos:definition>
