		<skos:prefLabel xml:lang="gd">UCHDAN PLANNTACHAIS</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Uchdan ùir a tha a' comharradh crìochan planntachais.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PLANTATION BANK</skos:prefLabel>
