	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004610">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">bottle</skos:prefLabel>
		<skos:altLabel xml:lang="en">bottles</skos:altLabel>
		<skos:altLabel xml:lang="de">Buddel</skos:altLabel>
		<skos:altLabel xml:lang="de">Buddeln (Gefäße)</skos:altLabel>
		<skos:prefLabel xml:lang="de">Flasche</skos:prefLabel>
		<skos:altLabel xml:lang="de">Flaschen</skos:altLabel>
		<skos:altLabel xml:lang="de">Pulle</skos:altLabel>
		<skos:altLabel xml:lang="de">Pullen</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000203"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk012069"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013708"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk017961"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000203"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk015298"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk015300"/>
		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk008640"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk017820"/>
		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk005003"/>
		<skos:definition xml:lang="de">Eine Flasche ist ein dicht verschließbares Gefäß mit enger, oft deutlich abgesetzter Halspartie, in der Regel ohne Handhabe. Im Verhältnis zur Höhe weist die Flasche typischerweise einen geringen Durchmesser auf. Das Gefäß wird hauptsächlich zum Transport und zur Lagerung von Flüssigkeiten verwendet und besteht üblicherweise aus Glas, Keramik, Kunststoff oder Metall.</skos:definition>
		<xe:explanation_temp xml:lang="de">Die Flasche ist aus typologischer und herstellungstechnischer Sicht durch eine große Bandbreite an Varianten vertreten. Eine einheitliche Beschreibung der Gefäße ist durch die vielen unterschiedlichen regionalen Prägungen schwierig. Formenkundliche Ausnahmen bilden beispielsweise Flaschenformen mit Henkel und auch solche, die in ihrer Funktion für keine trinkbaren Flüssigkeiten gedacht sind.</xe:explanation_temp>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300045627"/>
