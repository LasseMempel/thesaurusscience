				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/293</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">RAON BLÀIR</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Achadh no talamh far an robhar ri blàr.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">BATTLEFIELD</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/292" />
				<skos:scopeNote xml:lang="en">The field or area of ground on which a battle was fought.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:scopeNote xml:lang="en">The area where a battle or skirmish is thought to have taken place.</skos:scopeNote>
