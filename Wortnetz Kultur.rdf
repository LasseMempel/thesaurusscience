		<skos:altLabel xml:lang="en">high-level water tank</skos:altLabel>
		<skos:prefLabel xml:lang="de">Hochbehälter</skos:prefLabel>
		<skos:altLabel xml:lang="de">Wasserhochbehälter</skos:altLabel>
