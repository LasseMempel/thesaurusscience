	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk020969">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Textheft</skos:prefLabel>
		<skos:altLabel xml:lang="de">Texthefte</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006010"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk006010"/>
		<skos:definition xml:lang="de">Ein Textheft ist ein Dokument, das in der Regel Gesangstexte von Vokalwerken enthält. Typischerweise wird ein Textheft aus Anlass eines musikalischen Ereignisses erstellt.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk006010"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
