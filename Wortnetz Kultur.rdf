	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk001825">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Immunität</skos:prefLabel>
		<skos:prefLabel xml:lang="en">immunity</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk002233"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk004450"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019782"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk002233"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk001826"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk002861"/>
		<skos:scopeNote xml:lang="de">Benutzt für den Rechtsbegriff; für das durch eine Immunität gekennzeichnete Gelände siehe Immunitätsbezirk.</skos:scopeNote>
		<skos:definition xml:lang="de">Der Rechtsbegriff Immunität bezeichnet im Feudalrecht einen verliehenen rechtlichen Schutzstatus, der sich durch die Befreiung von Lasten (Leistungen, Steuern, Abgaben u.ä.) auszeichnet oder vor äußeren Eingriffen (auch: Gerichtsbarkeit) schützt.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002233"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004450"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019782"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002741"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-07-04T16:51:13+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk001826">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">central judiciary</skos:prefLabel>
		<skos:altLabel xml:lang="de">Immunitätsbereich</skos:altLabel>
		<skos:prefLabel xml:lang="de">Immunitätsbezirk</skos:prefLabel>
		<skos:altLabel xml:lang="de">Immunitätsbezirke</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004315"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk003671"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk005739"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010200"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019655"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004315"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk001825"/>
		<gvp:aat2801_conjuncted_with rdf:resource="http://lvr.vocnet.org/wnk/wk002861"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk002741"/>
		<skos:scopeNote xml:lang="de">Benutzt für das durch eine Immunität gekennzeichnete Gelände; für den entsprechenden Rechtsbegriff siehe Immunität.</skos:scopeNote>
		<xe:explanation_temp xml:lang="de">Häufig vorkommende Bezirke sind Domimmunitätsbezirke, Klosterimmunitätsbezirke oder Stiftsimmunitätsbezirke.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Immunitätsbezirk ist ein offener Raum, der durch ein besonderes Schutzprivileg von der übrigen Stadt abgegrenzt ist.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003671"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004315"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010200"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk005739"/>
