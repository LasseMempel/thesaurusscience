        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_d2733eac"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-28T08:25:23.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-03T15:14:01.000</terms:modified>
        <skos:definition xml:lang="de">An beiden Enden geblattetes, schräg verlaufendes Holz. [Eißing et al. 2012]</skos:definition>
        <skos:definition xml:lang="de">Zimmermannsmäßige Holzverbindung durch ein schräg angeordnetes Holz, das als Bohle zur Aufnahme von Zugkräften angeblattet ist, seltener als Vollholz, das dann zusätzl. Strebefunktion hat (Vollholz-Band); zumeist als Kopf- oder Fußband (Schwäbisches Weible). [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Band (Holzbauteil)</skos:prefLabel>
    </owl:NamedIndividual>
    


