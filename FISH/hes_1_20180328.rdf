	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/41">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/41</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH-EUNAICH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach beag far an cùm sealgairean acainn agus a chleachdar mar thaigh-còmhnaidh sealach.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SHOOTING BOTHY</skos:prefLabel>
