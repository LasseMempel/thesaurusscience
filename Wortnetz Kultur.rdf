		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019436"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019456"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk003955"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk002037"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk000029"/>
		<xe:explanation_temp xml:lang="de">Es ist sehr weich und wird u.a. als Bindemittel oder Baustoff verwendet.</xe:explanation_temp>
		<skos:definition xml:lang="de">Gips ist ein Sulfat, das neben Schwefel aus Calcium besteht und ein typisches Verwitterungsprodukt salzhaltiger Gesteine ist.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003955"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010567"/>
