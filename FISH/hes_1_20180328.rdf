	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1902">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1902</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TOLL PUIST</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Toll a chaidh a chladhach mar bhunait sheasmhach airson post a sheasas dìreach an àirde, gu math tric le clachan dùmhlaichte ann. Cleachd seòrsa de chuimhneachan nach eil cho pongail ma tha fhios cò fear.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">POST HOLE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1898" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1478" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1943" />
		<skos:scopeNote xml:lang="en">A hole dug to provide a firm base for an upright post, often with stone packing. Use broader monument type where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1903">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1903</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÀRACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Iarsmaidhean àrc-eòlach nach gabh a chur ann an roinn agus air a bheil glè bheag a dh'fhiosrachadh. Sònraich seòrsa na làraich ma ghabhas sin a dhèanamh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SITE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-02-21T11:10:51</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">INDETERMINATE REMAINS</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1898" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1904">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1904</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">LÀRACH BLEITH-TALMHAINN</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Làrach a chaidh a leigeil ris an cois bleith na talmhainn agus nach eilear, aig an ìre-sa, a' tuigsinn buileach.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">EROSION SITE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1903" />
				<skos:scopeNote xml:lang="en">A site which has been partially exposed through the process of erosion and is not, as yet, fully understood.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1905" />
		<skos:scopeNote xml:lang="en">Unclassifiable archaeological remains with minimal information. Specify site type wherever possible.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1905">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1905</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÀRACH TUINEACHAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far a bheil fianais gun robh daoine a' fuireach ann ach gun chinnt gun robh iad a' fuireach ann gu buan.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">OCCUPATION SITE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1903" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/507" />
		<skos:scopeNote xml:lang="en">A site showing some signs of occupation but evidence is insufficient to imply permanent settlement.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1907">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1907</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">SREATH PHOST</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Co-dhiù aon sreath de chipeanan no tuill chipeanan ann an eadaramhan cunbhalach no neo-chunbhalach agus a-rèir aiseil choitchinn.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">STAKE ALIGNMENT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1898" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1908" />
		<skos:scopeNote xml:lang="en">One or more rows of stakes or stake holes set at regular or irregular intervals along a common axis.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1908">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1908</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TOLL PUIST</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Toll a nochd ri linn cipein dìreach a chaidh a phutadh no a bhualadh san talamh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">STAKE HOLE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1898" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1907" />
		<skos:scopeNote xml:lang="en">A hole which has been created by driving or hammering an upright stake into the ground.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1910">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1910</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FRACAN AILTIREACHD</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Pìos dealaichte de chlachaireachd, mar is trice air a shnaidheadh, gu foirmeil na phàirt de structar cloiche. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ARCHITECTURAL FRAGMENT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">SCULPTURED STONE</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1897" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1911">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1911</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">CLACH BUN-SGIUBHA</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Sgonn cloiche a tha os cionn balla bhreigean no cloiche, a' cur ceann air sgibheal barr-bhalla no barrain.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">SKEWPUTT</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-16T13:52:10</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1910" />
				<skos:scopeNote xml:lang="en">A block of stone set at the top of a brick or stone wall to finish the eaves of a parapet or coping.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/506121" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/506122" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1499" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1504" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500705" />
		<skos:scopeNote xml:lang="en">A detached piece of masonry, generally worked, formally part of a stone structure. Use more specific term where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1913">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1913</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">PÀIRT THOGALAICH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar a dh'fhaodadh a bhith am broinn togalaich no thogalach fa leth air aitreabh no co-phàirt ailtireachd fa leth aig togalach.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BUILDING COMPONENT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1471" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1914" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1915">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1915</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">CRÙISLE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Seòmar fon talamh no togalach aig a bheil mullach boghaichte, tha seo na sheòmar tìodhlacaidh gu math tric. Cleachd seòrsa de làrach nas fharsainge ma tha fhios dè.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">VAULT</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-07-12T12:50:17</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1913" />
				<skos:scopeNote xml:lang="en">An underground room or building with an arched roof, often used as a burial chamber. Use wider site type where known.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500502" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500519">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500519</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">COT CHLAGAN</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Ionad airson co-dhiù aon chlag, mar is trice le tulchainn no mullach.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">BELLCOTE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-26T11:44:04</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-26T11:45:19</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1913" />
				<skos:scopeNote xml:lang="en">A housing for one or more bells, usually gabled or roofed.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500546" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500621">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500621</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">ÀRD-DORAS</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Ball còmhnard a tha a' dol thairis air beàrn agus a' cur taic ris a' bhalla os cionn an fhosglaidh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">LINTEL</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-30T09:41:08</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-30T09:42:20</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1913" />
				<skos:scopeNote xml:lang="en">A horizontal member spanning an opening and providing support to the wall above the opening.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
