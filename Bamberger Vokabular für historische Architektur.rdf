        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-09T18:36:07.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T18:40:42.000</terms:modified>
        <skos:definition xml:lang="de">Hohlblockstein, großformatiger Mauerstein aus einer Betonmischung mit Ziegelsplitt, Schlacke oder Bims, der zur Verringerung des Gewichts und zur Erhöhung der Wärmedämmung Hohlräume hat. In den 1920er Jahren entwickelt und nach 1945 verbreitet. [Koepf / Binding 2016] </skos:definition>
        <skos:prefLabel xml:lang="de">Hohlblockstein</skos:prefLabel>
    </owl:NamedIndividual>
    


