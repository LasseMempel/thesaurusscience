        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-15T12:08:40.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T14:52:12.000</terms:modified>
        <skos:altLabel xml:lang="de">Führung</skos:altLabel>
        <skos:altLabel xml:lang="de">Steinauswechslung</skos:altLabel>
        <skos:altLabel xml:lang="fr">créneler</skos:altLabel>
        <skos:altLabel xml:lang="fr">faire un lancis (lancer)</skos:altLabel>
        <skos:altLabel xml:lang="hu">foltozás</skos:altLabel>
        <skos:altLabel xml:lang="fr">incrustement</skos:altLabel>
