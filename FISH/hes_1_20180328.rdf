		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1268</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">IONAD CLÒ-BHUALAIDH 'S FOILLSEACHAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalaichean agus làraichean a tha co-cheangailte ri gnìomhachas a' chlò-bhualaidh 's an fhoillseachaidh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PRINTING AND PUBLISHING SITE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-04-20T13:48:12</dcterms:modified>
