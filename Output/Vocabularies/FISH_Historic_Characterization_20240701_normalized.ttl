    skos:scopeNote "A piece of land used for the cultivation of hops."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151755> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151751> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Garden (Recreational)"@en ;
    skos:scopeNote "An enclosed piece of ground devoted to recreational purposes."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151757> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151409> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Tree Avenue"@en ;
    skos:scopeNote "A straight road lined with trees along either side, also straight lines of trees found in parkland usually leading to a landscape feature."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151764> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151581> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Linear Urban Development"@en ;
    skos:scopeNote "Urban extension, usually along a major thoroughfare (canal, road or railway)."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151765> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151762> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Burgage Plot"@en ;
    skos:scopeNote "A plot of land longer than it is wide, usually running perpendicularly from street with dwelling on street front. The holding of a burgess, and thus typical of medieval towns."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151770> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151596> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Planned Village"@en ;
    skos:scopeNote "Village whose regularity of spacing and shape of plots, and also often of form of dwellings, suggests a degree of external planning, usually by a landlord."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151771> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151596> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Industrial Village"@en ;
    skos:scopeNote "Village for accommodation of industrial workers, usually close to either extractive industry or milling."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151773> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151597> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Agricultural Hamlet"@en ;
    skos:scopeNote "A small settlement containing two or more farmsteads, but few amenities. Typical rural settlement form away from central province."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151774> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151597> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Industrial Hamlet"@en ;
    skos:scopeNote "Hamlet for accommodation of industrial workers, usually close to either extractive industry or milling."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151779> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151421> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Interrupted Row"@en ;
    skos:scopeNote "A row settlement (linear arrangement of dwellings along a road) with numerous substantial gaps between buildings."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151781> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151173>,
        <http://purl.org/heritagedata/schemes/571/concepts/151780> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Furlong"@en ;
    skos:scopeNote "Block of land within an open field system containing a number of individual strips and usually managed as a single cropping or farming unit. In places such blocks were associated with fixed lengths, hence also name for a customary length of 220 yards."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151785> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151727> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Reorganised Field System"@en ;
    skos:scopeNote "Field pattern of any type or date that has been subject to revision, through either insertion or removal of boundaries, but where the original form is still legible."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151786> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151453> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Restored Fields"@en ;
    skos:scopeNote "Fields created on the surface of restored land, such as that landscaped from the former dumps of coal mines. Modern and often regular."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151789> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/160292> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Lido"@en ;
    skos:scopeNote "A public recreational complex centred around an open-air swimming pool."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151792> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/160252> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Cinema"@en ;
    skos:scopeNote "A building where people pay to see films and 'moving pictures'."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151793> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151450> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Hunting Site"@en ;
    skos:scopeNote "An area, building, site or structure associated with the hunting of animals."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151794> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/160214> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Grouse Moor"@en ;
    skos:scopeNote "Heathland used for the shooting of Red Grouse. Managed, by the controlled burning of areas of heather, to create a habitat that is favourable to grouse. Lines of butts used by the shooters are a common feature."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151795> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/160214> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Royal Forest"@en ;
    skos:scopeNote "Land including hunting areas for a monarch or (by invitation) the aristocracy; they usually included large areas of heath, grassland and wetland, that is habitats that supported deer and other game, but also farmland."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151797> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152301> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Motor Sports Track"@en ;
    skos:scopeNote "A purpose-built facility for racing motor cars and/or motor cycles which may also include grandstands or concourses."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151852> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151634> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Tank Range"@en ;
    skos:scopeNote "An area of ground used for the testing of, and practicing with armoured tanks."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151928> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151235>,
        <http://purl.org/heritagedata/schemes/571/concepts/151900> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Hillfort"@en ;
    skos:scopeNote "A hilltop enclosure bounded by one or more substantial banks, ramparts and ditches. Now forming a feature within other landscape character types such as recreation, rough ground or enclosed land."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151975> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152309> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Rowing Lake"@en ;
    skos:scopeNote "A lake, sometimes purpose built, for use in the sport of rowing."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152299> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152403> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Stables"@en ;
    skos:scopeNote "Building complex with yards etc, where horses are bred, raised and securely kept."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152302> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152301> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Football Ground"@en ;
    skos:scopeNote "A site including a pitch, stands and other ancillary buildings and areas associated with playing and paying to watch the game of football."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152303> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/160252> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Leisure Centre"@en ;
    skos:scopeNote "A purpose built building and associated grounds, usually owned and operated by a local authority, where people go to keep fit or relax through using the facilities."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152311> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/160252> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Amusements"@en ;
    skos:scopeNote "An area or place for recreation, typically with electronic game machines and gambling machines."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152312> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152309> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Recreational Dive Area"@en ;
    skos:scopeNote "An area used by recreational divers, sometimes concentrated on wreck sites and other areas of semi-natural or historic environment interest."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152314> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151450> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Leisure Sailing Area"@en ;
    skos:scopeNote "Area used for recreational sailing, yachting, and other small craft pursuits."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152316> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151611> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Valley Bog"@en ;
    skos:scopeNote "A bog that develops in gently sloping valleys upon a peat layer. Valley bogs may develop in relatively dry and warm climates, but because they rely on ground or surface water, they only occur on acidic substrates."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152324> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152594> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "River"@en ;
    skos:scopeNote "A significant watercourse largely following the natural drainage pattern and flowing towards another river, a lake or the sea."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152329> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151264> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Drove Common"@en ;
    skos:scopeNote "A common used for the resting and grazing of herds cattle being 'driven' to and from market."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152331> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152330> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Open Rough Ground"@en ;
    skos:scopeNote "-"@en .

<http://purl.org/heritagedata/schemes/571/concepts/152335> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/160474>,
        <http://purl.org/heritagedata/schemes/571/concepts/160475> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Cliff Top Rough Ground"@en ;
    skos:scopeNote "Coastal rough ground on the flatter land on cliff tops; grazed by cattle as well as sheep and goats."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152336> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/160474>,
        <http://purl.org/heritagedata/schemes/571/concepts/160475> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Cliff Slope Rough Ground"@en ;
    skos:scopeNote "Coastal rough ground on steep slopes; only able to be grazed by sheep, goats etc."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152337> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152330> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Secondary Rough Ground"@en ;
    skos:scopeNote "Rough ground that has developed recently, usually as a result of the suspension of other land uses and management . Not normally subjected to grazing, fuel collection etc."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152508> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151614> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Foreshore (Shingle)"@en ;
    skos:scopeNote "An area of foreshore where the predominant cover is exposed coarse rock sediments of a grain size generally perceived as 'shingle' or 'pebbles'."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152529> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151681> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Drying Hazard"@en ;
    skos:scopeNote "Areas variously submerged but also subject to exposure above the sea surface at various states of the tide, known as 'drying areas' and forming a hazard to the safe passage of shipping."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152530> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151681> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Maritime Debris"@en ;
    skos:scopeNote "An area deemed hazardous due to a predominance of recorded obstructions and fouls not known to be associated with a wreck."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152531> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151681> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Rock Outcrops"@en ;
    skos:scopeNote "An area dominated by rocks rising from the general level of the seabed and breaking the sea surface at some or all states of the tide, posing a risk for navigation."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152532> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151681> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Water Turbulence"@en ;
    skos:scopeNote "Areas of the water column and/or sea surface characterised by heavy swell, strong currents and tidal races which pose a risk for navigation."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152533> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151681> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Hazardous Water"@en ;
    skos:scopeNote "Areas of the water column and/or sea surface above sea floor hazards and in a buffered zone around them."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152534> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151443>,
        <http://purl.org/heritagedata/schemes/571/concepts/151681> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Shoals And Flats"@en ;
    skos:scopeNote "Shallow areas of sand banks, shoals, bars and spits, highly subject to change and extent of low tide exposure due to mobility of sediments."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152535> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151681> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Submerged Rocks"@en ;
    skos:scopeNote "Areas dominated by rocks rising from the general level of the seabed but not breaking the surface of the water at any state of the tide, posing a risk for navigation."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152540> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152539> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Safety Area"@en ;
    skos:scopeNote "An area of sea with advised or designated restrictions on navigation, or exclusion from permitted navigation altogether. These areas may respond to a variety of dangers."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152543> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151573> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Wave Power"@en ;
    skos:scopeNote "Buildings, sites and structures associated with the harnessing the energy of wave power for electrical power generation."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152544> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151683> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Longlining"@en ;
    skos:scopeNote "Areas characterised by commercial fishing using long line methods; this involves setting out a fishing line, often several kilometers long, from which shorter lines (snoods) are spaced at intervals with baited hooks."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152545> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151683> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Seine Netting"@en ;
    skos:scopeNote "Areas characterised by commercial fishing using seine nets; which is a long net that hangs in the water column with floats along the upper edge and weights along the bottom. The ends of the net can be drawn together to encircle and herd a school of fish."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152548> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151710> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Fish Warehouse"@en ;
    skos:scopeNote "Buildings & grounds used specifically for storage of fish or fish products. Such storage may relate to several aspects of the fishing industry, for example the storage of fish after landing & before auction or sale, or the cold storage of fish after sale."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152550> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152549> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Shellfish Farming"@en ;
    skos:scopeNote "Areas chacterised by the commercial cultivation of shellfish populations under controlled conditions, sometimes enclosed from wild stocks. Shellfish farming includes oyster, mussel and cockle beds which are seeded and managed over several seasons."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152551> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151683> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Fish Trapping"@en ;
    skos:scopeNote "Areas characterised by the use of semi permanent/permanent fish traps for the capture of naturally occurring fish stocks. Does not include temporary portable pots and creels which are covered by POTTING AREA."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152552> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151683> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Shellfish Collection"@en ;
    skos:scopeNote "Areas characterised by the regular commercial collection by hand or hand held tools, of naturally occurring shellfish stocks for food. If collected for bait use BAIT DIGGING AREA and for commercial farming from artificial structures use SHELLFISH FARMING."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152553> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151683> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Fixed Netting"@en ;
    skos:scopeNote "Areas characterised by commercial fishing using fixed netting or set netting as it is sometimes known. It refers to netting held vertically and stationery in the water column, rather than being towed by a vessel or allowed to drift in the current."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152555> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151683> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Hand Netting"@en ;
    skos:scopeNote "Areas characterised by commercial fishing using hand nets worked by an individual fisherman. This consists of a rectangular frame from which a net is suspended. Regional variations include haaf netting, lave netting and dip netting."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152560> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152561> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Flood Defence"@en ;
    skos:scopeNote "Artificial constructions used to prevent water flooding the surrounding area. Often taking the form of a bank or wall but may be more elaborate (eg the Thames Barrier) and include run-off drains and reservoirs."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152562> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151650> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Tramway"@en ;
    skos:scopeNote "A light railway. Early usage tended to be in industrial contexts with animal drawn stock; later usage tended to be for the conveyance of passengers, often in urban areas, with vehicles run along sunken rails."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152563> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151667> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Landing Point"@en ;
    skos:scopeNote "A place where vessels can land passengers and goods"@en .

<http://purl.org/heritagedata/schemes/571/concepts/152564> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151667> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Port"@en ;
    skos:scopeNote "A settlement area that combines a harbour and terminal facilities at the interface between land and water transportation systems."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152565> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152571> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Naval Battlefield"@en ;
    skos:scopeNote "Recorded areas of former naval battles, where they form the dominant character of those areas. They may be associated with enhanced material imprints still extant in the form of wrecks and debris."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152584> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152583> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Active Navigation Channel"@en ;
    skos:scopeNote "Sea or river channels, charted or otherwise, recorded as in active use by present shipping traffic, whatever the channels' date of origin."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152586> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152585> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Buried Navigation Channel"@en ;
    skos:scopeNote "Sea or river channels no longer charted or recorded as in active navigational use for present shipping traffic and with evidence that the channel is also now a buried feature (if extant at all)."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152592> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152591> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Palaeochannel"@en ;
    skos:scopeNote "The course or channel of a river or stream preserved as a geological or geomorphological feature. Use for areas containing individual examples or an individual system. For areas of inter-fluvial ridges & other features, use 'Palaeolandscape component'."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152596> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152595> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Coarse Sediment Plain"@en ;
    skos:scopeNote "Extensive areas of seafloor whose surface sediments predominantly comprise different grades of pebbles, rocks, boulders etc with lower sand and very low silt and clay contents."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152597> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152595> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Fine Sediment Plain"@en ;
    skos:scopeNote "Large areas of seafloor whose surface sediments predominantly comprise different grades of sand and very low silt and clay content."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152598> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152595> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Mud Plain"@en ;
    skos:scopeNote "Extensive areas of seafloor whose surface sediments predominantly comprise fine sediment grades with high silt and clay contents."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152599> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152595> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Mixed Sediment Plain"@en ;
    skos:scopeNote "Large areas of seafloor whose surface sediments predominantly comprise heterogeneous sediment grades, from pebbles and gravels to sands, silts and clays. The overall composition can be highly variable, as can the form of their grades' mixing."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152600> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152595> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Sandbanks With Sandwaves"@en ;
    skos:scopeNote "An area of sand banks containing extensive wavelike structures and megaripples formed by rapidly moving currents of water on the sandbanks' surface. May occur around the margins of sandflats or they may occur in deeper water."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152601> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152320>,
        <http://purl.org/heritagedata/schemes/571/concepts/152595> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Exposed Bedrock"@en ;
    skos:scopeNote "Areas whose surface predominantly comprises bedrock exposures. On the sea-floor can be associated with rocks and boulders but little finer sediment deposition."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152602> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151417> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Reclamation From Sea"@en ;
    skos:scopeNote "Land reclaimed directly from the sea by enclosure and drainage."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152603> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151417> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Reclamation From Tidal Marsh"@en ;
    skos:scopeNote "Land reclaimed directly from tidal marsh, usually salt marsh, by enclosure and drainage."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152604> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151417> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Reclamation From Wetland"@en ;
    skos:scopeNote "Land reclaimed directly from wetland."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152611> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/160213> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Pleasure Pier"@en ;
    skos:scopeNote "A raised platform, generally of iron and/or wood, supported on spaced pillars or props and projecting out into the sea and designed to provide primarily recreational access over the sea from the shore to an adjacent position near or below MLW."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152612> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/160213> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Leisure Beach"@en ;
    skos:scopeNote "Largely inter-tidal areas, predominantly of sand, used mostly for leisure and relaxation by coastal visitors. May be managed actively, eg by periodic scraping or beach replenishment, or passively, eg by groynes, to retain the sand cover."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152614> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/160213> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Bathing/Swimming Area"@en ;
    skos:scopeNote "An outdoor area, commonly on the coast, used by people predominantly for bathing and/or swimming."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152622> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152624> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Lime Production"@en ;
    skos:scopeNote "Areas associated primarily with the transport and production of burnt lime from limestone, largely for agricultural use but also for lime mortar."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152625> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152605> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Nuclear Reprocessing"@en ;
    skos:scopeNote "Industrial area for the decommissioning of structures associated with the nuclear industry, reprocessing of nuclear materials, nuclear waste management and/or nuclear fuel manufacturing activities take place."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152626> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152624> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Iron Works"@en ;
    skos:scopeNote "An industrial complex for large-scale production of iron."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152627> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/160170> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Steel Works"@en ;
    skos:scopeNote "An industrial complex for large-scale production of steel in the 19th and 20th centuries."@en .

<http://purl.org/heritagedata/schemes/571/concepts/152633> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151407> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Submarine Telecommunication Cable"@en ;
    skos:scopeNote "Cables laid beneath the sea to carry telecommunications including telephone and internet communications, also historic telegraph systems. The most frequent function of submarine cabling, especially that covering long distances."@en .

<http://purl.org/heritagedata/schemes/571/concepts/160128> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/160129> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Crematorium Complex"@en ;
    skos:scopeNote "Place (building and grounds) where the dead are respectfully incinerated and remembered."@en .

<http://purl.org/heritagedata/schemes/571/concepts/160131> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/160130> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Religious Community"@en ;
    skos:scopeNote "Buildings and grounds where a group of devotees to a religion live and worship. Subdivide by form of religion, sect, etc."@en .

<http://purl.org/heritagedata/schemes/571/concepts/160134> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151651> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Road Tunnel"@en ;
    skos:scopeNote "A tunnel through which a road runs."@en .

<http://purl.org/heritagedata/schemes/571/concepts/160153> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151132> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Moorland (Divided)"@en ;
    skos:scopeNote "Moorland divided by stock-proof boundaries."@en .

<http://purl.org/heritagedata/schemes/571/concepts/160154> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151132> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Moorland (Undivided)"@en ;
    skos:scopeNote "Moorland left open, not divided by stock-proof boundaries."@en .

<http://purl.org/heritagedata/schemes/571/concepts/160159> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151453> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Enclosure Of Parkland"@en ;
    skos:scopeNote "Fields established within former parkland, either medieval deer park or post-medieval landscaped park. Tend to be large and regular fields and land often retains some parkland features, notably standard trees."@en .

<http://purl.org/heritagedata/schemes/571/concepts/160161> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151727> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Infields"@en ;
    skos:scopeNote "The more closely assessed and more intensively worked fields of an infield-outfield system, usually of open field type."@en .

<http://purl.org/heritagedata/schemes/571/concepts/160162> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151453> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Intake From Rough Ground"@en ;
    skos:scopeNote "Fields established on former rough ground. Mostly post-medieval."@en .

<http://purl.org/heritagedata/schemes/571/concepts/160164> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151727> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Outfields"@en ;
    skos:scopeNote "Marginal fields, often part of open field systems, beyond the more closely assessed and more intensively worked infields. In places left uncultivated for many decades. Often worked in common and divided into strips."@en .

<http://purl.org/heritagedata/schemes/571/concepts/160167> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151780> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Strip Fields"@en ;
    skos:scopeNote "Long narrow plots of land within an open field. Also used for those plots once enclosed and held in severalty, the form in which most now survive."@en .

<http://purl.org/heritagedata/schemes/571/concepts/160168> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151571> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "China Clay Works"@en ;
    skos:scopeNote "A place where china-clay (kaolin) is extracted and purified."@en .

<http://purl.org/heritagedata/schemes/571/concepts/160171> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152624> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Metal Works"@en ;
    skos:scopeNote "A place where metal ores are dressed, smelted and transformed into utilitarian material."@en .

<http://purl.org/heritagedata/schemes/571/concepts/160194> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151235>,
        <http://purl.org/heritagedata/schemes/571/concepts/151900> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Roman Fort"@en ;
    skos:scopeNote "A Roman period, permanently fortified military base incorporating a range of barracks, victualling and command structures. Often built to standardised plans which developed through time."@en .

<http://purl.org/heritagedata/schemes/571/concepts/160212> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/160213> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Cliff Gardens"@en ;
    skos:scopeNote "Ornamental gardens, usually open to the public, that take advantage of the peculiar topography and climate found on cliffs."@en .

<http://purl.org/heritagedata/schemes/571/concepts/160216> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152309> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Fishing Area"@en ;
    skos:scopeNote "Areas dominated by use for recreational fishing and angling."@en .

<http://purl.org/heritagedata/schemes/571/concepts/160264> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151756>,
        <http://purl.org/heritagedata/schemes/571/concepts/160292> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Municipal Park"@en ;
    skos:scopeNote "Land, often in urban areas, dedicated to outdoor public recreation. Usually with ornamental planting of trees and shrubs, with some formal gardens, ornamental ponds etc. Generally more robust than in landscaped parks with public conveniences & playgrounds"@en .

<http://purl.org/heritagedata/schemes/571/concepts/160274> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151704>,
        <http://purl.org/heritagedata/schemes/571/concepts/160292> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Open Air Museum"@en ;
    skos:scopeNote "A building, group of buildings or space within a building, where objects of value such as works of art, antiquities, scientific specimens, or other artefacts are housed and displayed."@en .

<http://purl.org/heritagedata/schemes/571/concepts/160275> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152403> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Race Course"@en ;
    skos:scopeNote "A purpose-built facility for the racing of horses; may also include grandstands or concourses."@en .

<http://purl.org/heritagedata/schemes/571/concepts/160297> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152309> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Sailing Area"@en ;
    skos:scopeNote "Area used for recreational sailing, yachting and other small craft persuits."@en .

<http://purl.org/heritagedata/schemes/571/concepts/160383> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152309> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Swimming Pool"@en ;
    skos:scopeNote "Indoor pool for sports such as swimming and diving. Includes any directly associated grounds."@en .

<http://purl.org/heritagedata/schemes/571/concepts/160424> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151257> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Council Housing"@en ;
