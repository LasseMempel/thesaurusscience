  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/95045">
    <skos:scopeNote xml:lang="en">A hospital ward block, completely open on the south side apart from a low railing and sun blind. It was thought beneficial for the recovery of wounded soldiers as well as those with diseases of the chest.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71589">
    <skos:scopeNote xml:lang="en">A workshop used for completing the shape of a product or part by turning on a lathe or wheel.</skos:scopeNote>
  </rdf:Description>
