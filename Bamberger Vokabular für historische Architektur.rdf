        <skos:altLabel xml:lang="de">Anfangsstein</skos:altLabel>
        <skos:altLabel xml:lang="de">Anfänger</skos:altLabel>
        <skos:altLabel xml:lang="de">Anwölber</skos:altLabel>
        <skos:altLabel xml:lang="en">kneeler</skos:altLabel>
        <skos:altLabel xml:lang="en">kneestone</skos:altLabel>
        <skos:altLabel xml:lang="en">rein</skos:altLabel>
        <skos:altLabel xml:lang="en">skew</skos:altLabel>
        <skos:altLabel xml:lang="en">springing stone</skos:altLabel>
        <skos:definition xml:lang="de">Anfangsstein, Anfänger, Anwölber, der erste Stein eines Bogens oder Gewölbes (Gewölbeanfänger) über dem Kämpfer (Kämpferstein oder der Kämpferlinie). [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Der erste Keilstein eines Bogenschenkels. Mit seiner waagerechten Unterseite ruht er auf dem Kämpfer, seine abgeschrägte Oberseite ist Auflager für den nächsten Keilstein. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Bogenanfänger</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">pateční klenák</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">sommier</skos:prefLabel>
        <skos:prefLabel xml:lang="en">springer</skos:prefLabel>
    </owl:NamedIndividual>
    


