        <skos:altLabel xml:lang="en">necking moulding</skos:altLabel>
        <skos:definition xml:lang="de">Bei der Toskanischen Ordnung ein Ring am oberen Ende des Säulenschafts unter dem Säulenhals (Säulenordnungen). [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Ein scharf profilierter Ring am oberen Ende des Säulenschaftes der toskanischen Säulenordnung. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="cs">Odděluje dřík sloupu od jeho krčku, římsko-toskánský řád. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Trennt Säulenschaft vom Säulenhals. Römisch-toskanische Ordnung. [Koch 2009]</skos:definition>
