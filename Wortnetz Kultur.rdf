		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-04-25T16:34:11+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk014945">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">dry roasting</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Rösten (Speisenzubereitung)</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk014686"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013639"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk014686"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk018374"/>
		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk006627"/>
		<skos:definition xml:lang="de">Rösten ist ein Verfahren, bei dem pflanzliche Lebensmittel trocken und ohne Fett stark erhitzt werden, um ihnen die Feuchtigkeit zu entziehen, den Geschmack durch die Bildung von Röststoffen zu ändern oder sie zu bräunen. Das Verfahren kommt insbesondere bei Kaffeebohnen, Nüssen, Saaten oder Getreide zur Anwendung.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4178329-3"/>
		<skos:closeMatch rdf:resource="https://www.wikidata.org/wiki/Q10860338"/>
