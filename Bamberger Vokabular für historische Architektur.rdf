        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-04T12:54:02.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T14:19:22.000</terms:modified>
        <skos:altLabel xml:lang="cs">iónské kyma</skos:altLabel>
        <skos:altLabel xml:lang="cs">těžké kyma</skos:altLabel>
        <skos:altLabel xml:lang="cs">čtvrtkruhový profil</skos:altLabel>
        <skos:definition xml:lang="de">Rundstab mit einem Viertelkreisprofil. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="fr">(baguette) quart de rond</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Viertelstab</skos:prefLabel>
        <skos:prefLabel xml:lang="it">modanatura convessa a quarto di cerchio</skos:prefLabel>
        <skos:prefLabel xml:lang="en">quarterround</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">čtvrtobloun</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_4b618a90 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_4b618a90">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_aa790c5e"/>
