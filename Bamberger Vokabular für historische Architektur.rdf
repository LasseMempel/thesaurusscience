    <!-- https://hist-arch-vocab.org/bvha#c_f3d06acd -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_f3d06acd">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_5b828b5f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-07T12:23:25.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T15:39:13.000</terms:modified>
        <skos:altLabel xml:lang="cs">zárubní zed\&apos;</skos:altLabel>
        <skos:definition xml:lang="de">Mauer, die seitlichen Druck von Erdmassen aufnimmt. (Glossarium Artis, Bd. 3, Bögen und Mauerwerk)</skos:definition>
        <skos:definition xml:lang="de">Stützmauer, eine Mauer aus Backstein, Naturstein oder Beton, die rutschgefährdete Erde, Felsen u. dergl. stützen soll. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Stützmauer</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">mur de soutènement</skos:prefLabel>
        <skos:prefLabel xml:lang="es">muro de apoyo</skos:prefLabel>
        <skos:prefLabel xml:lang="it">muro di sostegno</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">opěrná zed\&apos;</skos:prefLabel>
        <skos:prefLabel xml:lang="en">supporting wall</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_f3e59e57 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_f3e59e57">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b2356bd0"/>
