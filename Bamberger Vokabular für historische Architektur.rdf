        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-10T16:37:37.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T23:12:54.000</terms:modified>
        <skos:altLabel xml:lang="cs">dům s terasami</skos:altLabel>
        <skos:definition xml:lang="de">Ein Haus, dessen Geschosse stufenförmig versetzt sind, so dass jedes Stockwerk eine Dachterrasse hat. Das T. kommt meist bei Hanglage im Vorderen Orient, in Mesopotamien und in Indien vor. Auch die Pueblos der altamerikan. Kultur sind ähnl. ausgebildet. Das T. wird auch im modernen Wohnbau verwandt. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Terrassenhaus</skos:prefLabel>
        <skos:prefLabel xml:lang="it">casa a gradoni</skos:prefLabel>
        <skos:prefLabel xml:lang="es">edificio escalonado en terrazas</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">maison en terrasses</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">terasovitý dům</skos:prefLabel>
        <skos:prefLabel xml:lang="en">terrace hause</skos:prefLabel>
    </owl:NamedIndividual>
    


