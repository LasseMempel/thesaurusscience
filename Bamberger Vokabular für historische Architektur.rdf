        <skos:altLabel xml:lang="en">deacon\&apos;s vestments</skos:altLabel>
        <skos:definition xml:lang="de">Levitengeuänder n pl, auch Levitenröcke m pl, Diakonatsgewänder n pl, vestes diaconatus: auszeichnende Amtstracht des Diakons und Subdiakons, wie Dalmatik, Manipel, Tunicella und Diakonalstola. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Levitengewand</skos:prefLabel>
        <skos:prefLabel xml:lang="en">diaconal vestments</skos:prefLabel>
        <skos:prefLabel xml:lang="la">vestes diaconatus</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">vêtements diaconaux</skos:prefLabel>
    </owl:NamedIndividual>
    


