        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-08T16:47:19.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T17:34:13.000</terms:modified>
        <skos:altLabel xml:lang="cs">Prasklina</skos:altLabel>
        <skos:altLabel xml:lang="cs">Puklina</skos:altLabel>
        <skos:altLabel xml:lang="de">Spalt</skos:altLabel>
        <skos:altLabel xml:lang="de">Sprung</skos:altLabel>
        <skos:altLabel xml:lang="en">fissure</skos:altLabel>
        <skos:definition xml:lang="en">A discontinuity in an architectural surface or wall painting, resulting in a visible separation of one part from another, that extends through one or more layers. [EwaGlos]</skos:definition>
        <skos:definition xml:lang="de">Eine Unterbrechung in einer Architekturoberfläche oder Wandmalerei, die sich in einer optischen Trennung von zwei Bereichen zeigt, und eine oder mehrere Schichten durchziehen kann. [EwaGlos]</skos:definition>
        <skos:definition xml:lang="de">Einzelner  Spalt  (Trennung),  der  deutlich  mit  demAuge  sichtbar  ist.  Entsteht  durch  die  Trennung  vonzwei Teilen. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="en">Individual fissure, clearly visible by the naked eye,resulting from separation of one part from another. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="cs">Jednotlivá prasklina, zřetelně viditelná prostýmokem, vyvolaná oddělením jedné části kamene oddruhé. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="fr">Une fissure est un plan de rupture vu en coupe quirésulte de la séparation d’une pierre en deux parties. [ICOMOS-ISCS]</skos:definition>
        <skos:prefLabel xml:lang="de">Riss</skos:prefLabel>
        <skos:prefLabel xml:lang="en">crack</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">fissure</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">trhlina</skos:prefLabel>
    </owl:NamedIndividual>
    


