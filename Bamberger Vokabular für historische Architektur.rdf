    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_mgsjoiid">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_731c851a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_4a3mjwqc"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_kqjbswgs"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-12T17:02:11.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-27T18:43:23.000</terms:modified>
        <skos:altLabel xml:lang="it">calcestruzzo armato</skos:altLabel>
        <skos:altLabel xml:lang="cs">vyztužený beton</skos:altLabel>
        <skos:altLabel xml:lang="cs">železobeton</skos:altLabel>
        <skos:prefLabel xml:lang="de">Stahlbeton</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">béton armé</skos:prefLabel>
        <skos:prefLabel xml:lang="it">cemento (calcestruzzo) armato</skos:prefLabel>
        <skos:prefLabel xml:lang="es">hormigón armado</skos:prefLabel>
        <skos:prefLabel xml:lang="en">reinforced concrete</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">železový beton</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Ein Verbundkörper aus Beton und einer Stahlbewehrung, der so ausgeführt ist, dass der Beton nur die Druckspannungen, der Stahl meist nur die Zugspannungen aufzunehmen hat. Der S. wird auf vorfabrizierten oder eigens für einen bestimmten Bauteil angefertigten Schalungen gegossen, die nach Erhärten des Materials wieder entfernt werden können. Je nach Art der Ausbildung einer S.konstruktion unterscheidet man Pilz-, Rippen-, Platten- und Plattenbalkendecken, Rahmen, Schalen u. dergl. [Koepf / Binding 2016]</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Eisenbeton ist die veraltete Bezeichnung für Stahlbeton.</skos:scopeNote>
    </owl:NamedIndividual>
    


