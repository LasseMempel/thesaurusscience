        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_38e881e4"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-31T16:35:21.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T10:38:19.000</terms:modified>
        <skos:definition xml:lang="de">Staurogramm n: ein Kreuz mit einem Ρ (Rho) als Standbalken, etwa seit dem Jahre 200 nachweisbar. Ein berühmtes Beispiel ist das Staurogramm mit Nimbus und der Hand Gottes im Kuppelmosaik des Baptisteriums von San Giovanni in Fonte zu Neapel um 400. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Staurogramm</skos:prefLabel>
        <skos:prefLabel xml:lang="en">staurogram</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">staurogramme</skos:prefLabel>
    </owl:NamedIndividual>
    


