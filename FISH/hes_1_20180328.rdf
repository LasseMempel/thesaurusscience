	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/935">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/935</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">MUILEANN-FIGHE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Factaraidh, a' gabhail a-steach innealan cumhachd o dheireadh na 18mh linn, far an deach aodach a dhèanamh de shnàithean 's iad air am fighe còmhla air ceàrnan ceart thairis air a chèile air beart-fhighe.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">WEAVING MILL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">WEAVING FACTORY</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/917" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1318" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1288" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1324" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/933" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/934" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/937" />
		<skos:scopeNote xml:lang="en">A factory, incorporating power driven machinery from the late 18th century, where cloth was manufactured from threads interlaced at right angles to each other in a loom.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/936">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/936</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">MUILEANN-CLÒIMHE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Factaraidh far an robhar a' dèanamh snàth clòimhe de chlòimh ghoirid gus aodach a dhèanamh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">WOOLLEN MILL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/917" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1348" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1288" />
		<skos:scopeNote xml:lang="en">A factory where short wool was spun into woollen yarn to produce cloth.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/937">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/937</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">MUILEANN-BURSAID</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Factaraidh far a bheilear a' dèanamh bursaid, snàth clòimhe a nithear le bhith a' deagh-thoinneamh clòimh-stapaill fhada airson deiseachan is aodach eile a dhèanamh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">WORSTED MILL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">WORSTED SPINNING MILL</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/917" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1348" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/935" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/958" />
		<skos:scopeNote xml:lang="en">A factory where worsted, a well-twisted woollen yarn made from long staple wool and used in the manufacture of suits and other garments, is produced.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/939">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/939</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">MUILEANN LÀIN-MHARA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Nàdar de MHUILEANN-UISGE far an glèidhear sàl aig àirde an làin gus a leigeil às slighe roth-uisge aig muir-tràigh gus cumhachd a ghintinn.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TIDE MILL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">TIDAL MILL</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/902" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1248" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1255" />
		<skos:scopeNote xml:lang="en">A type of WATERMILL, powered by retaining seawater at high tide and  releasing it at low tide via a water wheel.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
