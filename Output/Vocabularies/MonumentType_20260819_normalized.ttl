    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99961> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "GARDEN"@en ;
    skos:scopeNote "An enclosed piece of ground devoted to the cultivation of flowers, fruit or vegetables and/or recreational purposes. Use more specific type where known."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69317> a skos:Concept ;
    skos:altLabel "Cloth Mill"@en,
        "Fabric Mill"@en,
