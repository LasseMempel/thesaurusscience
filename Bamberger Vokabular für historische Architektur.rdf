        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T21:05:06.000</terms:modified>
        <skos:altLabel xml:lang="de">Leiste</skos:altLabel>
        <skos:altLabel xml:lang="fr">dentelle</skos:altLabel>
        <skos:altLabel xml:lang="la">praetexta</skos:altLabel>
        <skos:definition xml:lang="de">Überhang m, auch Leiste f, aurifrisium, praetexta: aus Seide oder anderem kostbarem Stoff bestehender, mit Gold- oder Seidenfransen besetzter, schmaler Zierstreifen entlang der Vorderkante der Mensa; heute oft nur noch ein Zierbörtchen. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="la">aurifrisium (mensa)</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">bordure (à franges)</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Überhang</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_ba2faafd -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_ba2faafd">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_bvscnjkx"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-06T10:29:25.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-02T16:54:04.000</terms:modified>
        <skos:altLabel xml:lang="de">Sinterzeug</skos:altLabel>
        <skos:altLabel xml:lang="en">crockery</skos:altLabel>
        <skos:altLabel xml:lang="it">gres</skos:altLabel>
        <skos:definition xml:lang="cs">Její lesklá glazura vzniká vypařováním soli při vypalování za vysoké teploty. Méně barev: kobalt, manganová fialka; hnědá barva působením kouře ve vypalovacím prostoru (přesoušení), (východní Asie; v Německu Kolín nad Rýnem, oblast Kannebackerland v Porýní). [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Seine glänzende Glasur entsteht durch Verdampfen von Salz während des Brennens bei hoher Temperatur. Wenige Farben: Kobalt, Manganviolett; Braun durch Raucheinwirkung in den Brennraum (Schmauchung). (Ostasien; Köln, Kannebäckerland). [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Sinterzeug mit bes. harten Scherben aus geschmolzenem Ton, das hauptsächl. für Fliesen und Kanalisationsrohre verwandt wird. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Steinzeug</skos:prefLabel>
        <skos:prefLabel xml:lang="es">gres</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">grès (-cérame)</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kamenina</skos:prefLabel>
        <skos:prefLabel xml:lang="en">stoneware</skos:prefLabel>
