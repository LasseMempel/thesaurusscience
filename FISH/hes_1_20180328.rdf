		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500571" />
		<skos:scopeNote xml:lang="en">A place where people meet for entertainment, discussion or assembly. Use more specific term where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
