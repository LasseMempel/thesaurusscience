  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71193">
    <skos:scopeNote xml:lang="en">A building on a railway system housing levers used to regulate trains on the tracks using signals and to change the points to enable a train to transfer from one track to another.</skos:scopeNote>
  </rdf:Description>
