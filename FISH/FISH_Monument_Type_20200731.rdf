  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143809">
    <skos:scopeNote xml:lang="en">Buildings associated with the extaction of uranium from its pitchblende or copper ores.</skos:scopeNote>
