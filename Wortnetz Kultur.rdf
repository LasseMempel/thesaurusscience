	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk002487">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">tabernacle</skos:prefLabel>
		<skos:altLabel xml:lang="en">tabernacles</skos:altLabel>
		<skos:prefLabel xml:lang="de">Tabernakel</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk005896"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk005744"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk012074"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk005896"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk000698"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk005023"/>
		<xe:explanation_temp xml:lang="de">Die Verwendung des Begriffs „Tabernakel“ im heutigen Sinn beginnt im 13. Jh. Bis dahin wird mit „tabernaculum“ lediglich ein Gefäß bezeichnet, in dem die konsekrierten Hostien aufbewahrt werden.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Tabernakel ist ein liturgischer Behälter, der verschließbar ist und in einer katholischen Kirche der sicheren Aufbewahrung der konsekrierten Hostien, des Allerheiligsten, dient.</skos:definition>
		<skos:narrowMatch rdf:resource="https://www.wikidata.org/wiki/Q1670363"/>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300207778"/>
