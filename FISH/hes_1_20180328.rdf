		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/81" />
		<skos:scopeNote xml:lang="en">A mushroom-shaped stone used to raise the floor of a barn, granary etc. above ground level, to prevent vermin from gaining access to stored grain and fodder. Now often used as a garden ornament.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
