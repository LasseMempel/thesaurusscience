	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk003822">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Kaffgesims</skos:prefLabel>
		<skos:altLabel xml:lang="de">Kaffgesimse</skos:altLabel>
