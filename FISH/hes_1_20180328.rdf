		<skos:prefLabel xml:lang="gd">RATHAD</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Slighe eadar diofar àitichean air a bheil eich, luchd-coiseachd is carbadan a' siubhal.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ROAD</skos:prefLabel>
