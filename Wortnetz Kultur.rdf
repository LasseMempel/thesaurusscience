	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk019004">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Fliese (Material)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Fliesen (Materialien)</skos:altLabel>
		<skos:prefLabel xml:lang="en">tile (material)</skos:prefLabel>
