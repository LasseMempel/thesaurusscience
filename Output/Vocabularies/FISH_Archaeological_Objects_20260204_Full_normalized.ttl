    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Outerwear"@en ;
    skos:scopeNote "Clothes worn so that they are visible, usually but not always worn over other clothes."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/97220> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96817> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Container <By Function>"@en ;
    skos:scopeNote "Containers identified by function rather than by form."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/97146> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96982> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Cutting Equipment"@en ;
    skos:scopeNote "Equipment used primarily to cut, slice, chop etc, using an implement with one or more sharp edges."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/96260> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/95070> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Fastening"@en ;
    skos:scopeNote "An object to fasten, bind or join one item to another."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/97086> a skos:Concept ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Measurement"@en ;
    skos:related <http://purl.org/heritagedata/schemes/mda_obj/concepts/97209> ;
    skos:scopeNote "Objects used to measure time, distance, weight, number or natural forces."@en ;
    skos:topConceptOf <http://purl.org/heritagedata/schemes/mda_obj> .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/96360> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/95056> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Architectural Element"@en ;
    skos:scopeNote "Parts of a building's fabric, structures and associated services, eg drain pipe. If the structure is complete use a monument type thesaurus."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/97089> a skos:Concept ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Religion Or Ritual"@en ;
    skos:scopeNote "Objects used or associated with religious, ritual or funerary activities."@en ;
    skos:topConceptOf <http://purl.org/heritagedata/schemes/mda_obj> .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/95070> a skos:Concept ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Unassigned"@en ;
    skos:scopeNote "Objects which cannot be assigned to any one particular class, or the function of which is unknown."@en ;
    skos:topConceptOf <http://purl.org/heritagedata/schemes/mda_obj> .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/96982> a skos:Concept ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Tools And Equipment"@en ;
    skos:scopeNote "Tools and equipment with a specific function and those for which a function cannot be assigned with any degree of certainty. Where the function is known, the term is also included under the relevant Class."@en ;
    skos:topConceptOf <http://purl.org/heritagedata/schemes/mda_obj> .

