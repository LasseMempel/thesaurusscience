<http://www.eionet.europa.eu/gemet/concept/7119> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6650> ;
    skos:closeMatch <http://data.uba.de/umt/_00027664>,
        <http://dbpedia.org/resource/Reprocessing> ;
    skos:definition "Restoration of contaminated nuclear fuel to a usable condition."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Wiederaufbereitung"@de,
        "reprocessing"@en .

<http://www.eionet.europa.eu/gemet/concept/7122> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3624> ;
    skos:definition "The technology involved in altering in some prescribed way the genetic constitution of an organism. Typically \"useful\" genes, i.e. very short sequence of DNA, are isolated from one organism and inserted into the DNA of a bacterium of yeast. These microorganisms multiply rapidly and can be cultured easily, enabling large quantities of the gene product to be obtained. Reproductive manipulation has been used for the large-scale production of antibiotics, enzymes, and hormones (e.g. insulin). Organisms into which foreign DNA has been artificially inserted are called \"transgenic organisms\"."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Fortpflanzungsmanipulation"@de,
        "reproductive manipulation"@en .

<http://www.eionet.europa.eu/gemet/concept/7135> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7127> ;
    skos:definition "Proposal, plan or design containing the necessary information and data for conducting a specific survey."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_24891>,
        <http://eurovoc.europa.eu/2801> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Forschungsprojekt"@de,
        "research project"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Research> .

<http://www.eionet.europa.eu/gemet/concept/7146> a skos:Concept ;
    skos:broadMatch <http://eurovoc.europa.eu/4787> ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7143> ;
    skos:closeMatch <http://data.uba.de/umt/_00051064> ;
    skos:definition "Residential zones where raised areas are built across roads so that vehicles are forced to move more slowly along it."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Wohngebiet (mit Verkehrsberuhigung)"@de,
        "residential area with traffic calmings"@en .

<http://www.eionet.europa.eu/gemet/concept/7149> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9172> ;
    skos:closeMatch <http://data.uba.de/umt/_00020854> ;
    skos:definition "Amount of water left in a water course after it has fed a hydropower plant in order to maintain a satisfactory dry-weather-flow for allowing the survival of biotic communities."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Restwassermenge"@de,
        "residual amount of water"@en .

<http://www.eionet.europa.eu/gemet/concept/7155> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7233> ;
    skos:closeMatch <http://data.uba.de/umt/_00020846>,
        <http://dbpedia.org/resource/Residual_risk> ;
    skos:definition "Remaining potential for harm to persons, property or the environment following all possible efforts to reduce predictable hazards."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Restrisiko"@de,
        "residual risk"@en .

<http://www.eionet.europa.eu/gemet/concept/7159> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/397> ;
    skos:closeMatch <http://data.uba.de/umt/_00021143> ;
    skos:definition "Analysis of residues from agricultural chemicals used in food crops and contained in foodstuff. The analyses use gas chromatography, liquid chromatography, mass spectrometry, immunoassays, etc."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Rückstandsanalyse"@de,
        "residue analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/7160> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7015> ;
    skos:closeMatch <http://data.uba.de/umt/_00021151> ;
    skos:definition "Recycling of material or energy which is left over or wasted in industrial processes and other human activities. Examples include waste heat and gaseous pollutants from electricity generation, slag from metal-ore refining, and garbage. A residual becomes an output or input when a technological advance creates economic opportunities for the waste."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Rückstandsverwertung"@de,
        "residue recycling"@en .

<http://www.eionet.europa.eu/gemet/concept/7163> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/664> ;
    skos:closeMatch <http://data.uba.de/umt/_00020802> ;
    skos:definition """1) The ability of a plant to overcome, retard, suppress, or prevent infection or colonization by a pathogen, parasite, or adverse abiotic factor. 
2) The ability of insects, fungi, weeds, or other pests to survive normally lethal doses of an insecticide, fungicide, herbicide, or other pesticide."""@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Resistenz"@de,
        "resistance (biological)"@en .

<http://www.eionet.europa.eu/gemet/concept/7165> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "A formal expression of the opinion of an official body or a public assembly, adopted by vote, as a legislative resolution."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Resolution"@de,
        "resolution (act)"@en .

<http://www.eionet.europa.eu/gemet/concept/7178> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7176> ;
    skos:closeMatch <http://data.uba.de/umt/_00002825> ;
    skos:definition "Air volumes inspired and expired through the lungs."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Atemluft"@de,
        "respiratory air"@en .

<http://www.eionet.europa.eu/gemet/concept/7182> a skos:Concept ;
