	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1236">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1236</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">IONAD-CRUTHACHAIDH DEALAIN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Acainnean is structaran far an tèid cumhachd dealain a ghintinn gus a chleachdadh ann an togalaichean no ionadan sònraichte. Airson ionadan cumhachd coimeirsealta, cleachd STÈISEAN-CUMHACHD.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GENERATING PLANT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1210" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1226" />
		<skos:scopeNote xml:lang="en">Equipment and structures used to generate electrical power for use by specific buildings or facilities. For commercial power facilities use POWER STATION.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1237">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1237</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">ÙRLAR EINNSEAN-EICH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Ùrlar cruinn air a bheil each (fo acainn aig cuibhle-ghèar mheadhanach) a' gluasad gus innealan obrachadh. Gu math tric faisg air sloc mèinn guail.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HORSE ENGINE PLATFORM</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1210" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1212" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1213" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1232" />
		<skos:scopeNote xml:lang="en">A circular platform, on which a horse harnessed to a central gear-wheel moves in order to drive machinery. Often sited adjacent to the shaft of a coal mine.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1238">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1238</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">IONAD2 CUMHACHD HAIDREOLAIG</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làraichean is structaran a tha co-cheangailte ri gintinn cumhachd haidreolaig.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HYDRAULIC POWER SITE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1210" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1239" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1227" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500612" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502142">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502142</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">RAMA HAIDREOLAIG</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Loinid mhòr a chleachdar gus drochaidean-togail, tuil-dhorsan is rudan mar sin obrachadh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">HYDRAULIC RAM</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-15T09:31:45</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-15T09:31:51</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1238" />
				<skos:scopeNote xml:lang="en">Large piston used to operate lifting bridges, lock gates, etc.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:scopeNote xml:lang="en">Sites and structures associated with the generation of hydraulic power.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1239">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1239</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TÙR CRUINNEACHADH CUMHACHD HAIDREOLAIG</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar far a bheilear a' stòradh cumhachd haidreolaig. Tha ceann uisge a' cumail frith-chudrom aig barr an tùir slighe phumpaichean. Thathar gan cleachdadh gus innealan obrachadh agus tha iad gu tric ceangailte ri bun-structar baile no cala slighe lìonra de phrìomh-loidhnichean haidreolaig.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HYDRAULIC ACCUMULATOR TOWER</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">HYDRAULIC ACCUMULATOR</skos:altLabel>
		<skos:altLabel xml:lang="en">AUXILIARY ACCUMULATOR TOWER</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1238" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1227" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1480" />
		<skos:scopeNote xml:lang="en">A structure used for the storage of hydraulic energy. A head of water holds a counterweight at the top of the tower by means of pumps. Used for powering machinery, and often connected to an urban or port infrastructure by a network of hydraulic mains.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1241">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1241</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">IONAD CRUTHACHADH CUMHACHD-SMÙIDE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalaichean, làraichean is structaran a tha co-cheangailte ri gintinn is cleachdadh cumhachd smùide.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">STEAM POWER PRODUCTION SITE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-04-20T13:47:26</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1210" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1242" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1014" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/916" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1235" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501715" />
		<skos:scopeNote xml:lang="en">Buildings, sites and structures associated with the production and use of steam power.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1242">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1242</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH-GOILEADAIR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach sa bheil goileadair, gu math tric co-cheangailte ri taigh-einnsein smùide.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BOILER HOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1241" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1011" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1014" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501005" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501715" />
		<skos:scopeNote xml:lang="en">A building housing a boiler, often connected to a steam engine house.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1243">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1243</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">GOILEADAIR CINN OS-CHEARCALLACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Goileadair a thèid a theasachadh on taobh a-muigh agus air a dhèanamh de thiùb stàilinn le cinn chruinn 's a sheasas ri smùid fo bhrùthadh mòr. Chaidh goileadairean ugh-cheannach a chleachdadh gu tric ann an einnseanan-smùid.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">EGG END BOILER</skos:prefLabel>
