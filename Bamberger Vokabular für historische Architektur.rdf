        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T10:46:59.000</terms:modified>
        <skos:definition xml:lang="de">Herz-Jesu-Bild n: eine Darstellung Christi mit einem brennenden Herzen auf der Brust, Symbol des liebenden und leidenden Heilandes; ein aus der deutschen Mystik hervorgegangenes Bild der Christusfrömmigkeit. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Herz-Jesu-Bild</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">image de Sacré-Cœur</skos:prefLabel>
        <skos:prefLabel xml:lang="en">image of the Sacred Heard</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_559aa52a -->


