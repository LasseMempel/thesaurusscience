    skos:prefLabel "Public inscriptions"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Inscriptions concerning issues of interstate relations,the organization and control of public life of citizens, as well as whatever issue merited publication in order to inform all citizens of a city in antiquity."@en .

