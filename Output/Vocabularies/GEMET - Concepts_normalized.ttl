    skos:closeMatch <http://data.uba.de/umt/_00016823> ;
    skos:definition "Removing salt from ocean or brackish water."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Meerwasserentsalzung"@de,
        "sea water desalination"@en .

<http://www.eionet.europa.eu/gemet/concept/7538> a skos:Concept ;
