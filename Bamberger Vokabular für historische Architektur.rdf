        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T14:08:57.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T14:20:36.000</terms:modified>
        <skos:altLabel xml:lang="cs">přístupnými ze společného schodiště</skos:altLabel>
        <skos:definition xml:lang="de">Wohnhaustyp, bei dem je zwei Wohnungen eines Geschosses an einem Treppenhaus liegen. [Koepf / Binding 2016]</skos:definition>
