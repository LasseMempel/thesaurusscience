        <skos:altLabel xml:lang="de">Schopfwalmdach</skos:altLabel>
        <skos:definition xml:lang="de">Der Giebel wird nur im unteren oder oberen Teil durch Dachflächen ersetzt (z. B. Schwarzwaldhaus). [Koch 2009]</skos:definition>
