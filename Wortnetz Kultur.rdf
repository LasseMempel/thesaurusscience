		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-03-27T19:51:19+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021139">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Abziehleder</skos:altLabel>
		<skos:altLabel xml:lang="de">Abziehriemen</skos:altLabel>
		<skos:altLabel xml:lang="en">razor strop</skos:altLabel>
		<skos:prefLabel xml:lang="en-UK">razor-strop</skos:prefLabel>
		<skos:altLabel xml:lang="en-UK">razor-strops</skos:altLabel>
		<skos:prefLabel xml:lang="de">Streichriemen</skos:prefLabel>
		<skos:prefLabel xml:lang="en">strop (sharpening device)</skos:prefLabel>
		<skos:prefLabel xml:lang="en-US">strops (sharpening devices)</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006998"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk006998"/>
		<skos:definition xml:lang="de">Ein Streichriemen ist ein Gerät, das zum Schärfen von Klingen, beispielsweise von Rasiermessern, verwendet wird. Es handelt sich um einen langen, flexiblen Riemen aus Leder, seltener aus Stoff, der in der Regel mit einer Polierpaste oder einem Schleifmittel behandelt wird. Durch die Bewegung der Klinge über den Riemen (das Abziehen) wird die Schneide verfeinert und von Mikrograten befreit, was die Schärfe der Klinge verbessert.</skos:definition>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q2142266"/>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300023296"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk006998"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-08-19T09:53:22+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021140">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">drag artist</skos:prefLabel>
		<skos:altLabel xml:lang="en">drag artists</skos:altLabel>
		<skos:prefLabel xml:lang="de">Drag-Künstler</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk005831"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013601"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk018387"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk005831"/>
		<gvp:aat2312_perform rdf:resource="http://lvr.vocnet.org/wnk/wk021133"/>
		<gvp:aat2322_use rdf:resource="http://lvr.vocnet.org/wnk/wk005391"/>
		<gvp:aat2322_use rdf:resource="http://lvr.vocnet.org/wnk/wk021018"/>
		<gvp:aat2322_use rdf:resource="http://lvr.vocnet.org/wnk/wk009489"/>
		<skos:definition xml:lang="de">Ein Drag-Künstler ist eine Person in der darstellenden Kunst, die sich verschiedener ästhetischer (etwa Schminke, Kleidung, Perücken) und performativer (etwa Tanz, Gesang, Sprache) Stilmittel bedient, um mit gesellschaftlichen Geschlechterrollen, meist Vorstellungen von Männlichkeit oder Weiblichkeit, zu spielen.</skos:definition>
		<xe:explanation_temp xml:lang="de">Darbietungen sind häufig, wenngleich nicht immer, humorvoll überspitzt, und sollen dabei oft nicht nur unterhalten, sondern auf gesellschaftliche Missstände wie etwa strukturellen Sexismus hinweisen. Künstler betreiben Drag als Hobby oder beruflich unter anderem auf Bühnen, im Fernsehen und in den sozialen Medien. Häufig handelt es sich um Mitglieder der LGBTQIA+-Gemeinschaft. Am häufigsten sind Drag-Künstler Männer in Frauen-Rollen (Drag Queens) oder Männer in Frauen-Rollen. Jedoch wird Drag von Menschen aller Geschlechter praktiziert, deren Kunstfiguren geschlechtlich ebenso vielfältig sind oder sich gar nicht geschlechtlich verorten lassen.</xe:explanation_temp>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q126912755"/>
		<skos:narrowMatch rdf:resource="http://d-nb.info/gnd/4757157-3"/>
		<skos:narrowMatch rdf:resource="http://d-nb.info/gnd/1036714667"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk005831"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk013601"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk018387"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<schema:image rdf:resource="https://xtree.digicult-verbund.de/imageStore/images/lvr_database/depiction_184.jpg"/>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-02-06T12:31:03+01:00+01:00</dcterms:modified>
	</skos:Concept>
