	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021121">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Diabetrachter</skos:prefLabel>
		<skos:prefLabel xml:lang="en">slide viewer (hand held device)</skos:prefLabel>
		<skos:altLabel xml:lang="en">slide viewers (hand held devices)</skos:altLabel>
		<skos:altLabel xml:lang="en">transparency viewer</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk018440"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk018440"/>
		<gvp:aat2416_requires rdf:resource="http://lvr.vocnet.org/wnk/wk008289"/>
		<skos:definition xml:lang="de">Ein Diabetrachter ist ein handliches optisches Gerät zum Ansehen von Diapositiven. Es besteht aus einem kompakten Gehäuse mit einer Öffnung zum Einsetzen des Dias, einer Vergrößerungslinse und einer Lichtquelle oder einer Vorrichtung zur Nutzung von Umgebungslicht. Durch eine Sichtöffnung kann das eingelegte Dia betrachtet werden.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300411362"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q438441"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk018440"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-02-25T13:12:40+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021122">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Siphon (Flasche)</skos:altLabel>
		<skos:prefLabel xml:lang="en">siphon bottle</skos:prefLabel>
		<skos:altLabel xml:lang="en">siphon bottles</skos:altLabel>
		<skos:prefLabel xml:lang="de">Siphonflasche</skos:prefLabel>
		<skos:altLabel xml:lang="de">Siphonflaschen</skos:altLabel>
		<skos:altLabel xml:lang="de">Siphons (Flaschen)</skos:altLabel>
		<skos:prefLabel xml:lang="de-1901">Syphon (Flasche)</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004610"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004610"/>
		<skos:definition xml:lang="de">Eine Siphonflasche ist eine Flasche für kohlensäurehaltige Getränke, insbesondere Sodawasser. Sie besteht meist aus Glas, Stahl oder Aluminium und verfügt über ein spezielles Steigrohr und einen Siphonkopf mit Hebel. Ursprünglich diente sie dem Aufbewahren und Ausschenken von Sodawasser, später gab es auch Varianten mit CO2-Kartusche zum Versetzen von Wasser mit Kohlensäure. Es existieren verschiedene Entwicklungsstufen von werksseitig befüllten Flaschen bis zu modernen, wiederbefüllbaren Varianten für den Hausgebrauch.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300220910"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q2061094"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004610"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-05-13T11:44:07+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021123">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Antiskop</skos:altLabel>
		<skos:altLabel xml:lang="de">Auflichtprojektor</skos:altLabel>
