		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/696" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/703">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/703</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">FACTARAIDH PENTAERYTHRITE TETRANITE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Factaraidh far a bheilear a' dèanamh Pentaerythrite Tetranite (PETN), co-phàirt de Semtex agus stuthan-spreadhaidh is fiùsaichean eile.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">PENTAERYTHRITE TETRANITE PLANT</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/698" />
				<skos:scopeNote xml:lang="en">A plant which manufactures pentaerythrite tetranite (PETN), a constituent of Semtex and other explosives and fuses.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:scopeNote xml:lang="en">A building or buildings where explosives are manufactured.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/700">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/700</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FACTARAIDH FÙDAR-GUNNA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far a bheilear a' dèanamh fùdar-gunna.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GUNPOWDER WORKS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">POWDER FACTORY</skos:altLabel>
		<skos:altLabel xml:lang="en">GUNPOWDER FACTORY</skos:altLabel>
		<skos:altLabel xml:lang="en">GUNPOWDER MILL</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/698" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/697" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/766" />
		<skos:scopeNote xml:lang="en">A site used for the manufacture of gunpowder.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/701">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/701</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FACTARAIDH NITROCELLULOSE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Factaraidh far a bheilear a' dèanamh nitrocellulose, stuth a chleachdar gus stuthan-spreadhaidh agus stuthan-iomain, le bhith a' cur searbhag phronnasgach agus naidhtreach ri ceallalos.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">NITROCELLULOSE FACTORY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/698" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/704" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/707" />
		<skos:scopeNote xml:lang="en">A factory where nitrocellulose, a substance used in the manufacture of explosives and propellants, is made by treating cellulose with sulphuric and nitric acids.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/702">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/702</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FACTARAIDH NITROGLYCERINE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">FACTARAIDH no factaraidh far a bheilear a' dèanamh nitroglycerine. Dh'fhaoidte gum bi grunn chnoc naidhtreo-gliosarain faisg air làimh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">NITROGLYCERINE WORKS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/698" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502148" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/704" />
		<skos:scopeNote xml:lang="en">A works or factory where nitroglycerine is manufactured. May include several nitroglycerine hills.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/704">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/704</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CNOC IONAD NITROGLYCERINE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Ionad far a bheilear a' dèanamh naidhtreo-gliosarain, mar is trice na phàirt ann an FACTARAIDH nitroglycerine.  Tha nitroglycerine agus salachar uisge a' dol leis a' chnoc tro ghrunn sgaradairean agus taighean-stòraidh a' cleachdadh comas-tarraing na talmhainn a chionn 's gun spreadh naidhtreo-gliosarain ma thèid a phumpadh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">NITROGLYCERINE HILL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/697" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/701" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/702" />
		<skos:scopeNote xml:lang="en">A facility for producing nitroglycerine, usually part of a NITROGLYCERINE WORKS.  Nitroglycerine and waste liquids flow down hill through a sequence of separators and storage houses under gravity, because pumping nitroglycerine can cause detonation.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/706">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/706</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">STÒR STUTHAN-SPREADHAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach far a bheilear a' stòradh stuthan-spreadhaidh nach eil gan cleachdadh leis an arm, m.e. stuthan-spreadhaidh mèinnearachd, stuthan-spreadhaidh siognailidh is msaa.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">EXPLOSIVES STORE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/707" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/678" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/371" />
		<skos:scopeNote xml:lang="en">A building used for the storage of explosives of a non-military function, e.g. mining explosives, signal explosives etc.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/707">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/707</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">STÒR COTAN-GUNNA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach far a bheilear a' stòradh cotan-gunna. Tha cotan-gunna na nàdar de naidhtreat ceallalois a chleachdar mar stuth-iomain no co-phàirt ann an stuthan-spreadhaidh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GUNCOTTON STORE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/706" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/701" />
		<skos:scopeNote xml:lang="en">A building in which gun cotton is stored. Guncotton is a form of cellulose nitrate used as a propellant or a component of explosives.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/708">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/708</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">AITREABH PEATRO-CHEIMIGEACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Aitreabh gnìomhachais far a bheil togalaichean is structaran airson co-thàthaidhean agus bathar a chruthachadh de pheatrol no gas nàdarra.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PETROCHEMICAL COMPLEX</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/678" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/834" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/835" />
		<skos:scopeNote xml:lang="en">An industrial complex, with buildings and structures used to produce compounds and products from petroleum or natural gas.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/709">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/709</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">DROCHAID PÌOBA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Drochaid a ghiùlaineas pìoban eadar togalaichean no àitichean-obrach, uaireannan thairis air cnapan-starra mar aibhnichean no mòr-ghil.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PIPE BRIDGE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-10-08T10:03:44</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/678" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502148" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/835" />
		<skos:scopeNote xml:lang="en">A bridge for carrying pipes between buildings or working areas, and sometimes over obstacles such as rivers, gorges etc.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/712">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/712</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÀRACH GNÌOMHACHAS AODAICH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalaichean agus làraichean a tha co-cheangailte ri saothrachadh aodaich.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CLOTHING INDUSTRY SITE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/647" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/716" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/713" />
		<skos:scopeNote xml:lang="en">Buildings and sites associated with the manufacture of clothing.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/713">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/713</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FACTARAIDH AODAICH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Factaraidh no àireamh de cheàrdaichean-obrach airson saothrachadh aodaich.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CLOTHING FACTORY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">TAILORING FACTORY</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/712" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/714" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/715" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/848" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/917" />
		<skos:scopeNote xml:lang="en">A factory or series of workshops for the manufacture of clothing.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/714">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/714</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FACTARAIDH OSANACHD</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Factaraidh no FACTARAIDH sa bheil acainnean air an dèanar stocainnean, a' cleachdadh dòighean fighe meacanaigeach.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HOSIERY FACTORY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-04-20T12:01:13</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">HOSIERY MILL</skos:altLabel>
		<skos:altLabel xml:lang="en">HOSIERY WORKS</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/713" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/917" />
		<skos:scopeNote xml:lang="en">A factory or works housing machinery used to produce stockings and socks, using mechanized knitting processes.</skos:scopeNote>
