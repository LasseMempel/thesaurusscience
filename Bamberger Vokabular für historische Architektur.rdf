    <!-- https://hist-arch-vocab.org/bvha#c_c7098093 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_c7098093">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_19a0a69b"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_6a10ebdb"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-12T09:11:09.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T18:18:38.000</terms:modified>
        <skos:prefLabel xml:lang="de">Style Plantagenet</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">style plantagenet</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Style Plantagenet, Form der frz. Frühgotik im Anjou und Loire-Gebiet. Dreischiffige Hallenkirchen mit gleich hohen Schiffen, in der Tradition romanischer Dreitonnenhallen des Poitous. Saalkirchen ohne Wandgliederung mit Rundbogenfenstern, achtteilige gebuste Gewölbefelder mit dünnen Rippen, durch einen dünnen Rundstab statt durch einen breiten Gurt von den Nachbarjochen getrennt (&quot;angevinisches Gewölbe&quot;). [Koch 2009]</skos:scopeNote>
    </owl:NamedIndividual>
    


