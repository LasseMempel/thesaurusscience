  <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_period/concepts/GEO">
    <skos:broader rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/HAN"/>
    <skos:narrower>
      <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_period/concepts/REG">
        <skos:broader rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/GEO"/>
        <time:hasBeginning xml:lang="en">1660</time:hasBeginning>
        <time:hasEnd xml:lang="en">1685</time:hasEnd>
