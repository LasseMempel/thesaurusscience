    <!-- https://hist-arch-vocab.org/bvha#c_07d1171b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_07d1171b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a9967019"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T12:34:23.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-02T17:38:18.000</terms:modified>
        <skos:altLabel xml:lang="fr">auvent</skos:altLabel>
        <skos:altLabel xml:lang="it">controvento</skos:altLabel>
        <skos:altLabel xml:lang="fr">poincon rampant</skos:altLabel>
        <skos:altLabel xml:lang="en">sprocket</skos:altLabel>
        <skos:definition xml:lang="de">Schwache Hölzer, die gegen den Winddruck kreuzweise übereinander zwischen die liegenden Stuhlsäulen oder an der Innenseite der Sparren angebracht werden. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Sturmlatte</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">queue de vache</skos:prefLabel>
        <skos:prefLabel xml:lang="es">riostra de contraviento</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_07d6fc36 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_07d6fc36">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_849603be"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T19:17:01.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T19:23:12.000</terms:modified>
        <skos:definition xml:lang="de">Das Fundament kann unmittelbar auf dem tragfähigen Baugrund in der vorgesehenen Bauwerkssohle gegründet werden, oder der tragfähige Baugrund liegt nur unwesentlich unterhalb der Bauwerkssohle. Die Gründungsarten unterscheiden sich je nach Tragfähigkeit des Baugrundes.</skos:definition>
        <skos:prefLabel xml:lang="de">Flachgründung</skos:prefLabel>
        <broaderByConstruction rdf:resource="https://hist-arch-vocab.org/bvha#c_849603be"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_07dbc83b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_07dbc83b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_049c4c22"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-23T09:50:56.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T13:13:44.000</terms:modified>
        <skos:altLabel xml:lang="de">Kompositgewölbe</skos:altLabel>
        <skos:altLabel xml:lang="fr">voûte composite</skos:altLabel>
        <skos:definition xml:lang="de">Gewölbe, das bei der Durchdringung oder Aneinanderreihung mehrerer gleichartiger oder unterschiedlicher Wölbungen entsteht. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="en">compound vault</skos:prefLabel>
