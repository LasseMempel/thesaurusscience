	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021339">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Brenner (Gerät zum Erhitzen)</skos:prefLabel>
		<skos:prefLabel xml:lang="en">burner (heating equipment)</skos:prefLabel>
		<skos:altLabel xml:lang="en">burners (heating equipment)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006132"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk006132"/>
		<skos:definition xml:lang="de">Ein Brenner ist ein technisches Gerät zur Umwandlung von chemischer in thermische Energie durch kontrollierte Verbrennung von Brennstoffen. Brenner erzeugen eine Flamme oder Hitze und werden zum Erhitzen, Schmelzen, Verarbeiten oder Verbrennen von Materialien eingesetzt. Sie können für gasförmige, flüssige oder feste Brennstoffe ausgelegt sein. Brenner finden vielfältige Anwendung, etwa in Laboratorien, in der Industrie, im Handwerk, in Haushalten sowie in technischen und wissenschaftlichen Geräten.</skos:definition>
		<skos:narrowMatch rdf:resource="http://vocab.getty.edu/aat/300024729"/>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4008171-0"/>
