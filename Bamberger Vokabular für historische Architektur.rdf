        <skos:definition xml:lang="de">Funeralwaffen (lat. funus = Leichenbegängnis), über einem Rittergrab angebrachte Waffen. Zu ihnen gehört der Totenschild, seit dem 13. Jh. bekannt. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Lat. funus= pohřbívání. Zbraně umístěné nad hrobem rytíře, patří k nim také pohřební štít, známý od 13. stol. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Funeralwaffe</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">funerální zbraně</skos:prefLabel>
    </owl:NamedIndividual>
    


