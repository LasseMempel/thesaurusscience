    <!-- https://hist-arch-vocab.org/bvha#c_98ca9e73 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_98ca9e73">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1311274f"/>
