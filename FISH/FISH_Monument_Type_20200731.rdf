  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92478">
    <skos:scopeNote xml:lang="en">A mechanized gate or barrier at a level crossing used to prevent road vehicles crossing a railway line when a train is approaching.</skos:scopeNote>
  </rdf:Description>
