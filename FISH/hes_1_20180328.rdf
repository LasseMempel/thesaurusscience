	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/172">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/172</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÒN TUMAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Linn a chaidh a chleachdadh gus ciontaich a pheanasachadh le bhith gan tumadh ann.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">DUCKING POND</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-07-17T13:29:15</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/171" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1961" />
		<skos:scopeNote xml:lang="en">A pond used for the punishment, by ducking in water, of offenders.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/173">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/173</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BÀS-LAG</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite far an robhar a' cur gu bàs daoine. Cleachd seòrsa de chuimhneachan nas mionaidiche ma tha fhios cò fear.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">EXECUTION SITE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-31T14:23:46</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/171" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/174" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/175" />
		<skos:scopeNote xml:lang="en">A place where people were put to death. Use narrower monument type where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
