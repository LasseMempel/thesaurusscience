<http://www.eionet.europa.eu/gemet/concept/3220> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11662> ;
    skos:closeMatch <http://data.uba.de/umt/_00005533>,
        <http://dbpedia.org/resource/Fire_protection> ;
    skos:definition "All necessary precautions to see that fire is not initiated, by ensuring that all necessary fire fighting apparatus is in good order and available for use if fire should break out, and by ensuring that personnel are properly trained and drilled in fighting fire."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/1706> ;
