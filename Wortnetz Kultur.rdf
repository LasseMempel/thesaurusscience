		<gvp:aat2801_conjuncted_with rdf:resource="http://lvr.vocnet.org/wnk/wk000903"/>
		<skos:definition xml:lang="de">Eine Einschienenhängebahn ist eine untertägige Hängebahn, bei der die Fahrzeuge für den Transport von Gütern und Personen unterhalb einer einzelnen Schiene hängen.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4136048-5"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1308921"/>
