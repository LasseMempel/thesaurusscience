		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/507583" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/509503" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/509522" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/509523" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/507582" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/507584" />
		<skos:scopeNote xml:lang="en">Writing, drawing or marking on a surface, usually created illicitly, for public and private display. Can be carved, painted or sprayed and of any date or content.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
