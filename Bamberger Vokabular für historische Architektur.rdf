        <skos:altLabel xml:lang="de">Vorsteller</skos:altLabel>
        <skos:altLabel xml:lang="fr">bannière d\&apos;exposition </skos:altLabel>
        <skos:altLabel xml:lang="en">exposition banner</skos:altLabel>
        <skos:altLabel xml:lang="en">monstrance shield</skos:altLabel>
        <skos:altLabel xml:lang="en">monstrance veil</skos:altLabel>
        <skos:altLabel xml:lang="fr">voile du Saint Sacrement</skos:altLabel>
        <skos:definition xml:lang="de">Vorsatzvelum n, auch Vorsetzfähnchen n, Sakramentsfähnchen n: kleine Kirchenfahne oder auf einen Rahmen gespanntes Tuch, das bei Predigten vor dem ausgesetzten Allerheiligsten die Monstranz verbirgt. [Glossarium Artis]</skos:definition>
