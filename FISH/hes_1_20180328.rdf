		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1106" />
		<skos:scopeNote xml:lang="en">A site where clay is extracted from the surface of the ground.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
