		<skos:prefLabel xml:lang="gd">TAIGH-CUNNTAIS</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Oifis cunntasair, gu h-àraid am broinn aitreabh gnìomhachais no gnothachais.</skos:scopeNote>
