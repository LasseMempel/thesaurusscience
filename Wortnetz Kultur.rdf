		<skos:prefLabel xml:lang="en">crossbow fibula</skos:prefLabel>
		<skos:altLabel xml:lang="en">crossbow fibulae</skos:altLabel>
		<skos:prefLabel xml:lang="de">Zwiebelknopffibel</skos:prefLabel>
		<skos:altLabel xml:lang="de">Zwiebelknopffibeln</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk005726"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019966"/>
