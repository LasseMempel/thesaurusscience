	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1748">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1748</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH-COINNEIMH NAN NEO-GLÈILLEADAIREAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach a chaidh a chleachdadh airson seirbheisean le seict Phròstanach neo-ghèillidh, gu h-àraid Cuaigearan is Clèirich.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">NONCONFORMIST MEETING HOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1740" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500521">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500521</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TAIGH-COINNEIMH NAM BRÀITHREAN</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Àite-coinneachaidh is adhraidh aig na Bràithrean, seict phiùratanach bhun-chreidmheach a chaidh a chur air chois ann an Èirinn aig deireadh nan 1820an agus ann an Sasainn ann am Plymouth sna 1830an.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">BRETHREN MEETING HOUSE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-26T14:11:19</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-26T14:11:43</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1748" />
				<skos:scopeNote xml:lang="en">A place of meeting and worship for Brethren, a fundamentalist puritan sect founded in Ireland in the late 1820s and established in England in Plymouth in the 1830s.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500571" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500757">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500757</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TALLA AN SALVATION ARMY</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Àite-adhraidh is talla-cruinneachaidh do bhall Feachd na Slàinte, seict shoisgeulach a chaidh a chur air bhonn le William Booth ann an Nottingham ann an 1865, stèidhichte air Meathodachd Wesley. Dhiùlt iad na sàcramaidean is ghabh iad ri reatoraig is stoidhle leth-armailteach.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">SALVATION ARMY HALL</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-11-06T16:27:26</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-11-06T16:27:54</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:altLabel xml:lang="en">SALVATION ARMY CITADEL</skos:altLabel>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1748" />
				<skos:scopeNote xml:lang="en">A place of worship and meeting hall for members of the Salvation Army, an evangelical sect founded by William Booth in Nottingham in 1865 and derived from Wesleyan Methodism. They rejected the sacraments and adopted a quasi-military rhetoric and style.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/504022">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/504022</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TAIGH-COINNEIMH NAM BUCHANACH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Àite-adhraidh aig seict nam Buchanach (1784-1846).</skos:scopeNote>
				<skos:prefLabel xml:lang="en">BUCHANITE MEETING HOUSE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-03-06T11:00:18</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-03-06T11:01:44</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1748" />
				<skos:scopeNote xml:lang="en">A place of worship for members of the Buchanite sect (1784-1846).</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:scopeNote xml:lang="en">A building used for services by a nonconformist protestant sect, especially by Quakers and Presbyterians.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1750">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1750</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">SIONAGOG</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach airson adhradh is teagasg a' chreideimh Iùdhaich.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SYNAGOGUE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1740" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1751" />
		<skos:scopeNote xml:lang="en">A building for worship and religious instruction in the Jewish faith.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1751">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1751</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TEAMPALL</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach no structar a thathar a' cleachdadh airson deas-ghnàthan cràbhach no adhradh. Airson cruthan san tìr nas ùire na sin, cleachd TEAMPALL GÀRRAIDH no SAOBH-THOGALACH.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TEMPLE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1740" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1747" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1750" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1768" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/2316" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/574" />
		<skos:scopeNote xml:lang="en">A building or structure used for religious ceremonies or worship. For later landscape features use GARDEN TEMPLE or FOLLY.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
