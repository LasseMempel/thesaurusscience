	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500623">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500623</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">MARINA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Doca no amar, gu math tric am broinn na tìre, a chleachdar mar acarsaid airson iachtaichean is bàtaichean-athais eile.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MARINA</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-30T09:46:37</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-30T09:46:54</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1384" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/570" />
		<skos:scopeNote xml:lang="en">A dock or basin, often inland, used for mooring yachts and other small pleasure craft.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500624">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500624</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CLACH-CHOMHARRACHAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Post cloiche a chaidh a thogail gus àite sònraichte san tìr a chomharradh ach gun fhios dè an rud a tha e a' comharradh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MARKER STONE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-30T09:47:45</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-11-16T10:27:46</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1897" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502258">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502258</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">COMHARRA NA MEADHAN-LOIDHNE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Comharra na meadhan-loidhne a tha dìreach deas no tuath air amharc-lann reul-eòlais mar phuing-reifreans shocraichte air an talamh nuair a thathar ag amharc air trasnaidhean reulan, phlanaidean no na gealaich. Faodaidh an comharra seo a bhith na cholbh, charragh, bhogha no chlach eagach, mar is trice air an fhàire 's ag astar on amharc-lann, eadar ceudan a shlatan is iomadh mìle air falbh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">MERIDIAN MARKER</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-18T13:10:43</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-18T13:11:08</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500624" />
				<skos:scopeNote xml:lang="en">A meridian marker, precisely positioned due south or north of an astronomical observatory, provides a fixed terrestrial point of reference for observations of stellar, planetary or lunar transits. Markers can take the form of a column, pillar, arch, or notched stone, usually on the skyline, at distances from the observatory varying between several hundred yards and several miles.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1468" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/44" />
		<skos:scopeNote xml:lang="en">A post made of stone erected to mark a particular spot in the landscape, but the purpose of which is unknown.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500625">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500625</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TALLA-MARGAID</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Talla-margaid le mullach a chaidh a thogail a dh'aona-ghnothach, mar is trice às an 19mh linn.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MARKET HALL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-30T09:48:39</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-30T09:49:12</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/219" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/187" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/190" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/236" />
		<skos:scopeNote xml:lang="en">A purpose built covered market hall, usually 19th century.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
