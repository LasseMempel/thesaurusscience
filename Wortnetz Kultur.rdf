		<skos:prefLabel xml:lang="de">Vase (Ziergefäß)</skos:prefLabel>
		<skos:prefLabel xml:lang="en">vase (vessel for decoration)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Vasen (Ziergefäße)</skos:altLabel>
		<skos:altLabel xml:lang="en">vases (vessels for decoration)</skos:altLabel>
