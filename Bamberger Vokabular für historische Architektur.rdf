        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-21T12:24:12.000</terms:modified>
        <skos:altLabel xml:lang="de">Muqarnasbogen</skos:altLabel>
        <skos:definition xml:lang="de">Bogen, der an seiner Leibung und oft auch an der Stirn mit Schmuckformen dekoriert ist, welche Tropfsteinen ähneln. In der islamischen Baukunst oft über dem Eingang zum Mihrab. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Stalaktitenbogen</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">arc à stalactites</skos:prefLabel>
        <skos:prefLabel xml:lang="en">arch with stalactite decoration</skos:prefLabel>
    </owl:NamedIndividual>
    


