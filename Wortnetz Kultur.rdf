	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk000379">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Brunnenverfüllung</skos:prefLabel>
		<skos:altLabel xml:lang="de">Brunnenverfüllungen</skos:altLabel>
		<skos:prefLabel xml:lang="en">fill of the well shaft</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000377"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000377"/>
		<gvp:aat2801_conjuncted_with rdf:resource="http://lvr.vocnet.org/wnk/wk000308"/>
		<skos:definition xml:lang="de">Eine Brunnenverfüllung ist eine Verfüllung, die Brunnen, die nicht mehr genutzt oder den wasserwirtschaftlichen Anforderungen nicht mehr gerecht werden, fachgerecht verfüllt und rückbaut.</skos:definition>
