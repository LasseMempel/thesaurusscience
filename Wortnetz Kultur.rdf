	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk019086">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">gun barrel</skos:prefLabel>
		<skos:altLabel xml:lang="en">gun barrels</skos:altLabel>
		<skos:prefLabel xml:lang="de">Lauf (Waffenteil)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Läufe (Waffenteile)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk019466"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk019466"/>
		<skos:definition xml:lang="de">Ein Lauf ist Teil einer Schusswaffe, durch den ein Projektil abgefeuert wird. Der Lauf einer Waffe ist speziell gefertigt, um dem Projektil eine präzise Richtung und hohe Geschwindigkeit zu geben. Je nach Waffenart und Waffentyp kann der Lauf unterschiedliche Längen, Durchmesser und spezifische Merkmale aufweisen, um die Leistung der Waffe zu beeinflussen.</skos:definition>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q487192"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019466"/>
