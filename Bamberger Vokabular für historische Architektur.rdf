        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-08T20:47:28.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T14:50:31.000</terms:modified>
        <skos:altLabel xml:lang="de">Hinterfüllen</skos:altLabel>
        <skos:altLabel xml:lang="de">Hohlraumverfüllung</skos:altLabel>
        <skos:altLabel xml:lang="es">consolidación por inyección</skos:altLabel>
        <skos:altLabel xml:lang="tr">sulu harç enjeksiyonu</skos:altLabel>
        <skos:definition xml:lang="en">Adhesion of layers or fragments of mortars, plasters or renders with the injection of a fluid and fine-grained mortar (grout) inside small spaces, cracks and pores. (EwaGlos)</skos:definition>
        <skos:definition xml:lang="fr">Injection d’un mortier fluide et a grains fins (coulis) dans de petits espaces, fissures et pores pour permettre l’adherence de couches, de fragments de mortiers ou d’enduits. (EwaGlos)</skos:definition>
        <skos:definition xml:lang="de">Zum Verkleben von Putzschichten oder -fragmenten wird flüssiger und feinkorniger Injektionsmörtel in schmale Zwischenräume, Risse und Poren eingespritzt. (EwaGlos)</skos:definition>
        <skos:prefLabel xml:lang="de">Injektion</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">coulis d’injection</skos:prefLabel>
        <skos:prefLabel xml:lang="tr">enjeksiyon harcı</skos:prefLabel>
        <skos:prefLabel xml:lang="it">iniezione di boiacca</skos:prefLabel>
        <skos:prefLabel xml:lang="ro">injectare de mortar</skos:prefLabel>
        <skos:prefLabel xml:lang="en">injection of grout</skos:prefLabel>
        <skos:prefLabel xml:lang="hr">injektiranje</skos:prefLabel>
        <skos:prefLabel xml:lang="es">inyección de mortero</skos:prefLabel>
        <skos:prefLabel xml:lang="hu">vakolat injektálás</skos:prefLabel>
        <skos:prefLabel xml:lang="pl">zastrzyki z ciekłej zaprawy</skos:prefLabel>
        <skos:prefLabel xml:lang="bg">Подливане</skos:prefLabel>
    </owl:NamedIndividual>
    


