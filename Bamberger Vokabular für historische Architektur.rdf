    <!-- https://hist-arch-vocab.org/bvha#c_87272d02 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_87272d02">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b652ef1a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_b41bd73a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-18T08:00:31.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-18T08:02:18.000</terms:modified>
        <skos:altLabel xml:lang="de">Gucklein</skos:altLabel>
        <skos:altLabel xml:lang="de">Schößchen</skos:altLabel>
        <skos:definition xml:lang="de">Auch Schößchen oder Gucklein genannt. Flügel im Fensterflügel, der kleiner ist und eigene Beschläge besitzt. Er verkleinert die Lüftungsfläche des Fensters und diente als Ausguck. Seine Abmessungen sind i. d. R. so bemessen, dass ein Kopf durch die Öffnung gesteckt werden kann. [Noky 1996]</skos:definition>
        <skos:prefLabel xml:lang="de">Lüftungsflügel</skos:prefLabel>
    </owl:NamedIndividual>
    


