    <!-- https://hist-arch-vocab.org/bvha#c_2e374f89 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_2e374f89">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b54dd069"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_83e770d8"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_a07e515f"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-19T13:00:29.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T15:33:30.000</terms:modified>
        <skos:definition xml:lang="de">Kreuzgang (Ambitus), um den Rechteckhof einer Klausur angelegter, flach gedeckter oder gewölbter Gang, in dem Prozessionen mit einem Kreuz abgehalten wurden. Der K. bildet mit der Kirche das Kernstück eines Klosters. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Kreuzgang</skos:prefLabel>
        <skos:prefLabel xml:lang="la">ambitus</skos:prefLabel>
        <skos:prefLabel xml:lang="it">chiostro</skos:prefLabel>
        <skos:prefLabel xml:lang="ca">claustre</skos:prefLabel>
        <skos:prefLabel xml:lang="es">claustro</skos:prefLabel>
        <skos:prefLabel xml:lang="en">cloister</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">cloître, clôture</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">křížová chodba</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Ein viereckiger, offener Hof. In Anlehnung an das  Peristyl des hellenistischen Wohnhauses. Der Name Kreuzgang stammt von der um den Hof führendenKreuzprozession. [Koch 2009]</skos:scopeNote>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_b54dd069"/>
    </owl:NamedIndividual>
    


