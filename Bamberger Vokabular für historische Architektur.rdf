        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_84f2deb5"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-03T17:48:41.000</terms:created>
