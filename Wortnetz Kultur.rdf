	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021044">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Druckfahne</skos:prefLabel>
		<skos:altLabel xml:lang="de">Druckfahnen</skos:altLabel>
		<skos:altLabel xml:lang="de">Fahne (Probedruck)</skos:altLabel>
		<skos:prefLabel xml:lang="en">galley proof</skos:prefLabel>
		<skos:altLabel xml:lang="en">galley proofs</skos:altLabel>
		<skos:altLabel xml:lang="de">Korrekturabzug</skos:altLabel>
		<skos:altLabel xml:lang="de">Korrekturabzüge</skos:altLabel>
		<skos:altLabel xml:lang="de">Korrekturfahne</skos:altLabel>
		<skos:altLabel xml:lang="de">Korrekturfahnen</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk019117"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk019117"/>
		<skos:definition xml:lang="de">Eine Druckfahne ist ein Probedruck, der auf losen Blättern hergestellt und zur Überprüfung an den Autor, Herausgeber oder Korrekturleser gesendet wird. Dieser Korrekturabzug dient dazu, Fehler vor der endgültigen Vervielfältigung des Druckwerks zu identifizieren und zu korrigieren. Solche Abzüge werden oft für verschiedene Arten von Texten und grafischen Inhalten erstellt, einschließlich Musikstücken, bevor die endgültige Partitur oder Notenausgabe gedruckt wird.</skos:definition>
		<skos:mappingRelation rdf:resource="http://d-nb.info/gnd/4392728-2"/>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300172465"/>
