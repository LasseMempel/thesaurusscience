        <skos:altLabel xml:lang="fr">cagoule</skos:altLabel>
        <skos:altLabel xml:lang="fr">coculle</skos:altLabel>
        <skos:definition xml:lang="de">Flocke f: mantelartiges, faltenreiches Gewand mit Kapuze und weiten Ärmeln oder ärmellos; in manchen Orden zur Chorkleidung gehörend. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Flocke</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">coule</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_54fe83e0 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_54fe83e0">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a637fa3d"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-18T17:26:52.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T15:43:11.000</terms:modified>
        <skos:definition xml:lang="de"> Eine Baufuge, die Rissbildungen infolge ungleicher Setzungen des Baugrunds verhindern soll. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Setzfuge</skos:prefLabel>
        <skos:prefLabel xml:lang="it">giunto di assestamento</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">joint de tassement</skos:prefLabel>
        <skos:prefLabel xml:lang="es">junta de asentamiento</skos:prefLabel>
        <skos:prefLabel xml:lang="en">settlement joint</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_55027891 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_55027891">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_7f248b0e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-15T09:40:25.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T16:04:22.000</terms:modified>
        <skos:altLabel xml:lang="de">Rüstloch</skos:altLabel>
        <skos:altLabel xml:lang="cs">lešenářské otvory</skos:altLabel>
        <skos:definition xml:lang="de">1/2 Stein tiefe Aussparrung im Mauerwerk als Auflage für die Netzriegel des Gerüsts. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Die Stelle im Mauerwerk, in die ein Gerüstholz während der Bauarbeiten eingelegt wurde; anmittelalterlichen Bauten wurden Rüstlöcher manchmal auch nach Fertigstellung des Gebäudesnicht geschlossen. [Glossarium Artis, Bd. 3, Bögen und Mauerwerk]</skos:definition>
        <skos:definition xml:lang="en">Holes purposely made in a wall to support a suspended scaffolding platform. [EwaGlos]</skos:definition>
        <skos:definition xml:lang="de">Im Mauerwerk ausgesparte viereckige Löcher für die Befestigung der Hölzer eines Baugerüsts. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Kruhové, nebo pravoúhlé otvory ve zdivu sloužící pro lešeňové trámy. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Speziell angefertigte, eingetiefte Löcher in einer Wand zum Abstützen einer Gerüstplattform. [EwaGlos]</skos:definition>
        <skos:prefLabel xml:lang="de">Gerüstloch</skos:prefLabel>
        <skos:prefLabel xml:lang="en">putlog hole</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">trou de boulin</skos:prefLabel>
    </owl:NamedIndividual>
    


