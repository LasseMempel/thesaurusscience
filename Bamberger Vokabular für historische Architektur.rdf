        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-18T09:29:16.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-27T09:43:10.000</terms:modified>
        <skos:definition xml:lang="de"> Mittlere Deckleiste bei zweiflügeligen Fenstern oder Türen [Koepf /Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Flache Holzleiste, die jeweils über die innere und äußere Fuge der aneinanderstoßenden Flügel bei einem aufgehenden Pfosten genagelt ist. Sie verdeckt die Fuge und bildet zugleich einen weiteren Anschlag. Typisch ist die Schlagleiste für Galgenfenster. [Noky 1996]</skos:definition>
        <skos:prefLabel xml:lang="de">Schlagleiste</skos:prefLabel>
        <skos:prefLabel xml:lang="en">baffle plate</skos:prefLabel>
        <skos:prefLabel xml:lang="es">batiente</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">battement</skos:prefLabel>
        <skos:prefLabel xml:lang="it">copribattuta</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">klapačka (např. u okna)</skos:prefLabel>
    </owl:NamedIndividual>
    


