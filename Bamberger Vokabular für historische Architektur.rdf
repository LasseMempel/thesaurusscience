        <skos:altLabel xml:lang="de">Ablutionskanne</skos:altLabel>
        <skos:altLabel xml:lang="en">ablution ewer</skos:altLabel>
        <skos:altLabel xml:lang="la">aquafusilis</skos:altLabel>
        <skos:altLabel xml:lang="fr">buire</skos:altLabel>
        <skos:altLabel xml:lang="en">ceremonial pitcher</skos:altLabel>
        <skos:altLabel xml:lang="la">effusorium</skos:altLabel>
        <skos:altLabel xml:lang="la">vas fusorium</skos:altLabel>
        <skos:definition xml:lang="de">Lavabokanne f; Ablutionskanne f; lat. urceus; effusorium; vas fusorium; aquafusiIis: eine meist aus Metall gefertigte Kanne oder auch ein Krug für das AbIutionswasser. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Lavabokanne</skos:prefLabel>
        <skos:prefLabel xml:lang="en">ablution-can</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">aiguière </skos:prefLabel>
        <skos:prefLabel xml:lang="la">urceus</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_18b9aa69 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_18b9aa69">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_d936f79a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_b41bd73a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c7b144d0"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_0709039d"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_d56109a3"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-12T18:24:02.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T14:42:07.000</terms:modified>
        <skos:altLabel xml:lang="de">Vorreiber</skos:altLabel>
        <skos:definition xml:lang="de">(Halbvorreiber oder Doppelvorreiber) aufgeschraubter oder genagelter Drehriegel, der die Flügel am Blendrahmen über einen Streichdraht oder ein Streichblech festriegelt. [Pax - Fenster &amp; Türen Fachbegriffe]</skos:definition>
        <skos:definition xml:lang="de">Neben der Ankettel älteste bekannte Fensterverriegelung. Drehbar innen am Fensterrahmen befestigte Verriegelung, die den Fensterflügel an den Rahmen drückt. [Noky 1996]</skos:definition>
        <skos:definition xml:lang="de">Vorreiber, Fensterbeschlag; drehbarer Griff zur Verriegelung der Fensterflügel, bes. zur Betätigung des senkrechten Stabs, dessen gebogene Enden in untere und obere Ösen eindrehen. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="fr"> frottoir</skos:prefLabel>
        <skos:prefLabel xml:lang="it"> maniglia di finestra</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Reiber</skos:prefLabel>
        <skos:prefLabel xml:lang="es">perilla de ventana</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_18c01335 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_18c01335">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b320e26f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-25T12:56:12.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-18T15:09:15.000</terms:modified>
        <skos:definition xml:lang="de">Im Festungsbau Schulterwehr, Seitentraverse, Flankenwehr, im Graben oder an den Schultern einer offenen Schanze. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="fr"> paraflane</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Paraflanc</skos:prefLabel>
        <skos:prefLabel xml:lang="es">defensas en una trinchera</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_18c066ce -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_18c066ce">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_453a0a33"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_19d56a39"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-15T09:41:27.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-28T10:16:47.000</terms:modified>
        <skos:definition xml:lang="de">Abgesprengte Hochstrebengerüste (firstungebunden):  Dieser Gerüsttyp besteht aus zwei gegeneinander geneigten Hochstreben mit absprengender Wirkung, die vom Unterbau bis in den Dachraum aufsteigen. Abgesprengte Hochstrebengerüste besitzen eine Längszone. (Eißing et al. 2012) </skos:definition>
        <skos:prefLabel xml:lang="de">abgesprengtes Hochstrebengerüst</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_18c8a9dc -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_18c8a9dc">
