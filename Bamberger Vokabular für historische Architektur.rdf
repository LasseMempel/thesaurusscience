        <skos:altLabel xml:lang="cs">vřeteno</skos:altLabel>
        <skos:altLabel xml:lang="cs">vřetenový sloup</skos:altLabel>
        <skos:definition xml:lang="de">Mittlerer, zylindr. Teil einer Wendeltreppe. Die S. kann geschlossen sein (1), d. h. sie setzt sich aus einzelnen, an die Stufen angearbeiteten Teilzylindern zusammen, oder sie ist offen (2; Hohls„ Treppenauge), d. h. ein Hohlraum, der von der schraubenartigen Lichtwange derTreppe begrenzt wird. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Vedlejší žebro (žebro 2. stupně) na žebrové klenbě. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="en">(newel) post</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Spindel</skos:prefLabel>
        <skos:prefLabel xml:lang="es">alma de una escalera de caracol</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">noyau (d\&apos;escalier)</skos:prefLabel>
        <skos:prefLabel xml:lang="it">piantone (della scala a chiocciola)</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">točité schodiště</skos:prefLabel>
    </owl:NamedIndividual>
    


