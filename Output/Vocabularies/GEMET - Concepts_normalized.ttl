<http://www.eionet.europa.eu/gemet/concept/11889> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/57> ;
    skos:closeMatch <http://dbpedia.org/resource/Decibel> ;
    skos:definition "A unit used to express relative difference on power, usually between acoustic or electric signals, equal to ten times the common logarithm of the ratio of the two level."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Dezibel"@de,
        "decibel"@en .

<http://www.eionet.europa.eu/gemet/concept/1190> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/367> ;
    skos:closeMatch <http://data.uba.de/umt/_00100348> ;
    skos:definition "A geographical region bordered on the south by South America and Panama, and on the west by Central America, and consisting of the West Indian, and nearby, islands and the Caribbean Sea, a part of the western Atlantic Ocean."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/5259> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Karibik"@de,
        "Caribbean Area"@en .

<http://www.eionet.europa.eu/gemet/concept/11912> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8959> ;
    skos:definition "A motion, usually unintentional and often undesirable, of parts of machines and structures."@en ;
