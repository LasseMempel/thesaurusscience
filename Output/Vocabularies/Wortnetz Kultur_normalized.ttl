<http://lvr.vocnet.org/wnk/wk004262> a skos:Concept ;
    skos:altLabel "Natursand"@de,
        "Sande"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk011755> ;
    skos:definition "Sand ist ein Sediment, dessen einzelne Partikel kleiner als 2 mm und größer als 0,063 mm im Durchmesser sind und zumeist eine hohen Silikat- und Quarzanteil aufweist"@de ;
    skos:exactMatch <http://d-nb.info/gnd/4051537-0>,
        <http://vocab.getty.edu/aat/300014341> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Sand"@de,
        "sand"@en .

<http://lvr.vocnet.org/wnk/wk004267> a skos:Concept ;
    skos:altLabel "Niedermoortorfe"@de,
        "fen peat"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk004269> ;
    skos:definition "Ein Niedermoortorf ist ein Torf, der ausschließlich in Niedermooren entsteht und daher Reste der typischen Vegetation des Verlandungsmoores enthält."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Niedermoortorf"@de,
        "low-bog peat"@en .

<http://lvr.vocnet.org/wnk/wk004268> a skos:Concept ;
    skos:broader <http://lvr.vocnet.org/wnk/wk004269> ;
    skos:definition "Ein Hochmoortorf ist ein Torf, der ausschließlich in Hochmooren entsteht und daher Rückstände der hochmoortypischen Vegetation enthält."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Hochmoortorf"@de,
        "raised bog peat"@en .

<http://lvr.vocnet.org/wnk/wk004270> a skos:Concept ;
    skos:altLabel "Gleye"@de,
        "Klei"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk004265> ;
    skos:definition "Ein Gley ist ein Grundwasserboden, der unter ständigem Grundwassereinfluss, manchmal bis in den Oberboden hinein, steht."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Gley"@de,
        "gley soil"@en .

<http://lvr.vocnet.org/wnk/wk004271> a skos:Concept ;
    skos:altLabel "Auenböden"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk004265> ;
    skos:definition "Ein Auenboden ist ein Grundwasserboden, der aus den Sedimenten von Flußauen und Bachauen entstehen und einmal durch starke Grundwasserschwankungen, die im Laufe eines Jahres bis zu 4 m betragen können, geprägt wird."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Auenboden"@de,
        "alluvial soil"@en .

<http://lvr.vocnet.org/wnk/wk004272> a skos:Concept ;
    skos:altLabel "hillside soil"@en,
        "slope soil"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk004264> ;
    skos:definition "Ein Ranker ist ein Landboden, der nur flachgründig ausgebildet ist und eine maximale Mächtigkeit von 30cm über dem silikatreichen oder quarzreichen Ausgangsgestein erreicht. Ein Unterboden-Horizont fehlt."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Ranker"@de,
        "Rankers"@en .

<http://lvr.vocnet.org/wnk/wk004273> a skos:Concept ;
    skos:altLabel "Rendzinen"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk004264> ;
    skos:definition "Eine Rendzina ist ein Landboden, der nur flachgründig ausgebildet ist und eine maximale Mächtigkeit von 30cm über dem kalkreichen Ausgangsgestein erreicht. Ein Unterboden-Horizont fehlt."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Rendzina"@de,
        "redzina soil"@en .

<http://lvr.vocnet.org/wnk/wk004274> a skos:Concept ;
    skos:altLabel "Schwarzerden"@de,
        "Tschernosem"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk004264> ;
    skos:definition "Eine Schwarzerde ist ein Landboden, der sich auf Löss oder mergelhaltigem Lockersediment entwickelt und einen sehr hohen natürlichen Nährstoffgehalt besitzt. Schwarzerden sind gut durchlüftet und weisen eine hohe Aktivität von Bodenorganismen auf."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Schwarzerde"@de,
        "chernozem"@en .

<http://lvr.vocnet.org/wnk/wk004275> a skos:Concept ;
    skos:altLabel "Braunerden"@de,
        "braunerde"@en,
        "brown earth"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk004264> ;
    skos:definition "Eine Braunerde ist ein Landboden, der als charakteristisches Merkmal einen verbraunten, durch Eisenfreisetzung entstandenen Unterboden besitzt und eine Mächtigkeit von 1,5 m über dem Ausgangsgestein erreicht."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4330466-7> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Braunerde"@de,
        "cambisol"@en .

<http://lvr.vocnet.org/wnk/wk004276> a skos:Concept ;
    skos:altLabel "Lessivé"@de,
        "Parabraunerden"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk004264> ;
    skos:definition "Eine Parabraunerde ist ein Landboden, der sich neben der typischen Verbraunung zusätzlich durch eine vertikale Auswaschung und Verlagerung von Tonmineralen aus dem Oberboden in tiefere Horizonte auszeichnet."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Parabraunerde"@de,
        "Luvisol"@en .

<http://lvr.vocnet.org/wnk/wk004277> a skos:Concept ;
    skos:altLabel "Ascheboden"@de,
        "Bleicherde"@de,
        "Bleicherden"@de,
        "Bleichsand"@de,
        "Bleichsande"@de,
        "Podsole"@de,
        "podzol"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk004264> ;
    skos:definition "Ein Podsol ist ein Landboden, der durch die Auswaschung von Eisen und Aluminium einen fahlen Bleichhorizont mit gräulicher Färbung aufweist. Oft entsteht durch diese Verlagerung im Unterboden eine verfestigte Ortsteinschicht."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Podsol"@de,
        "ash soil"@en .

<http://lvr.vocnet.org/wnk/wk004278> a skos:Concept ;
    skos:altLabel "Pseudogleye"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk004264> ;
    skos:definition "Ein Pseudogley ist ein Landboden, der unter zeitweisem Einfluss von Stauwasser steht, der durch einen hohen Gehalt wasserundurchlässiger Tonminerale im Unterboden verursacht wird. Dadurch wird das Versickern verhindert oder verlangsamt."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Pseudogley"@de,
        "stagnosol"@en .

<http://lvr.vocnet.org/wnk/wk004284> a skos:Concept ;
