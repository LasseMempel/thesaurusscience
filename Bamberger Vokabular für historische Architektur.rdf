        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-25T15:11:13.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T15:54:40.000</terms:modified>
        <skos:altLabel xml:lang="de">Brustreliquiar</skos:altLabel>
        <skos:altLabel xml:lang="de">Reliquienbüste</skos:altLabel>
        <skos:definition xml:lang="de">Büstenreliquiar n; auch Reliquienbüste f; Brustreliquiar n: ein in der Regel aus Edelmetall gefertigtes, mit kostbaren Steinen geschmücktes plastisches Brustbild, das Reliquien des Dargestellten birgt; neben dem Brustbild waren auch Halbfiguren und halbe Doppelfiguren gebräuchlich. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Büstenreliquiar</skos:prefLabel>
        <skos:prefLabel xml:lang="en">bust-reliquary</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">buste-reliquaire</skos:prefLabel>
    </owl:NamedIndividual>
    


