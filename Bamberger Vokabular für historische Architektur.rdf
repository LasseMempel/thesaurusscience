        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_106b1464"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_16b837ff"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_aa7a9a9b"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_ef40cc12"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_f94e92f0"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-02T14:53:04.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T17:48:15.000</terms:modified>
        <skos:altLabel xml:lang="de">Alba</skos:altLabel>
        <skos:altLabel xml:lang="de">Sackalbe</skos:altLabel>
        <skos:altLabel xml:lang="la">tunica alba</skos:altLabel>
        <skos:altLabel xml:lang="la">tunica poderis </skos:altLabel>
        <skos:altLabel xml:lang="la">tunica talaris</skos:altLabel>
        <skos:definition xml:lang="de">Albe (alba, camisia, tunica), Bestandteil der liturgischen Kleidung, ein aus Leinen gemachter (tunica linea, linea), engärmeliger, bis zu den Füßen reichender (tunica talaris, poderes), mittels eines Zingulums aufgeschürzter Rock. [RDK Labor]</skos:definition>
        <skos:definition xml:lang="de">Albe f, Alba f, auch Sackalbe f, camisa, tunica alba, tunica talaris, tunica poderis: aus der römischen Tunika entstandenes, hemdartiges, knöchellanges weißes Leinengewand mit langen, engen Ärmeln; an Saum und Ärmeln befindet sich häufig eine Parura; als liturgisches Untergewand wird die Albe von allen Klerikern getragen. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Albe</skos:prefLabel>
        <skos:prefLabel xml:lang="en">alb</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">alba</skos:prefLabel>
        <skos:prefLabel xml:lang="es">alba</skos:prefLabel>
        <skos:prefLabel xml:lang="nl">albe</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">aube</skos:prefLabel>
        <skos:prefLabel xml:lang="it">camice</skos:prefLabel>
        <skos:prefLabel xml:lang="la">camisa</skos:prefLabel>
    </owl:NamedIndividual>
    


