        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-24T11:10:03.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-09T22:38:29.000</terms:modified>
        <skos:definition xml:lang="de">Ein Dach ohne oder mit sehr geringer Neigung, das als begehbares Terrassendach oder auch als Dachgarten ausgestaltet sein kann. Die tragende Unterkonstruktion ist meist mit der obersten Geschossdecke identisch. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Flachdach</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">plochá střecha</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_f4e2bee8"/>
    </owl:NamedIndividual>
    


