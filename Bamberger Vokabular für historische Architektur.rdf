    <!-- https://hist-arch-vocab.org/bvha#c_a01edf9f -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_a01edf9f">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_2d93c3e7"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_69367952"/>
        <skos:topConceptOf rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:topConceptOf rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:topConceptOf rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:topConceptOf rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:topConceptOf rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-21T17:38:37.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T16:17:04.000</terms:modified>
        <skos:altLabel xml:lang="es">cuarto</skos:altLabel>
        <skos:altLabel xml:lang="cs">místnost</skos:altLabel>
        <skos:altLabel xml:lang="cs">oblast</skos:altLabel>
        <skos:altLabel xml:lang="cs">pokoj</skos:altLabel>
        <skos:altLabel xml:lang="cs">území</skos:altLabel>
        <skos:definition xml:lang="de">In der Baukunst ein von Baukörpern oder von Oberflächen raumbildender Konstruktionen (z.B. von Wänden) begrenzter und dadurch sinnl. wahrnehmbarer Teil im Innern eines Baukörpers oder umgrenzt von verschiedenen Baukörpern eines städtebaul. Gefüges. Der R. wird in seiner Wirkung durch die Eigenschaften seiner Begrenzungen und durch deren Verhältnis zueinander und zum Menschen wesentl. bestimmt und seine Gestaltung ist neben der des Baukörpers das eigentl. Thema allen baukünstler. Schaffens. Der geschlossene R. (Innenr.) kann durch Durchlöchern oder Entfernen einer oder mehrerer seiner Umschließungen in den offenen R. übergehen (Hof, Platz; R. mit Glaswand). Dem uralten Bestreben,  den geschlossenen R. durch Entmaterialisierung seiner Begrenzungen (Mosaik, Malerei, Glasmalerei) zu erweitern, steht die moderne Tendenz zum unbegrenzten R. gegenüber (Ausklei­dung mit Spiegeln, Glaswände). [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Raum</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">espace</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">prostory</skos:prefLabel>
        <skos:prefLabel xml:lang="es">recinto</skos:prefLabel>
        <skos:prefLabel xml:lang="en">space</skos:prefLabel>
        <skos:prefLabel xml:lang="it">spazio</skos:prefLabel>
    </owl:NamedIndividual>
    


