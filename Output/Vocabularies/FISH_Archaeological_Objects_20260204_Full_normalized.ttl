    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Wheellock Musket"@en ;
    skos:scopeNote "A musket where a wheel on the lock is wound back and when the trigger is pulled the wheel moves dragging pieces of iron pyrites over the lock tocreate sparks and set powder in the pan off and so firing the main charge."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/100021> a skos:Concept ;
