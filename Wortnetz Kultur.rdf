	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004193">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Atrien (Kirchengebäude)</skos:altLabel>
		<skos:prefLabel xml:lang="it">atrio (chiesa)</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Atrium (Kirchengebäude)</skos:prefLabel>
		<skos:prefLabel xml:lang="en">atrium (church building)</skos:prefLabel>
