		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk006251"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk006649"/>
		<skos:definition xml:lang="de">Gänsereiten ist ein Fastnachtsbrauch, bei dem ein Seil zwischen zwei Bäumen gespannt wurde, an dem ein lebender Gänserich mit dem Kopf nach unten aufgehängt wurde. Ziel war es, im Vorbeireiten den Kopf der Gans abzureißen und „Jängktenkönig“, König der Gänsereiter, zu werden.</skos:definition>
		<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q323429"/>
