    <!-- https://hist-arch-vocab.org/bvha#c_9d437393 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_9d437393">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_5f9418c5"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
