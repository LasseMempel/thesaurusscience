		<gvp:aat2801_conjuncted_with rdf:resource="http://lvr.vocnet.org/wnk/wk004186"/>
		<xe:explanation_temp xml:lang="de">Das Reisig wird mit Hilfe von Draht zu walzenförmigen Bündeln zusammengefügt.</xe:explanation_temp>
		<skos:definition xml:lang="de">Eine Faschine ist ein Materialverbund aus Reisig und Drähten, der der Sicherung von Böschungen dient.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4555671-4"/>
