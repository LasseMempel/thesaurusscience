        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-28T16:41:40.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T11:44:36.000</terms:modified>
        <skos:altLabel xml:lang="de">Spottmantel</skos:altLabel>
        <skos:definition xml:lang="de">Purpurmantel m Christi; auch Spottmantel m; lat. purpura Domini: der Mantel, den man Christus umgelegt hatte, um ihn zu verhöhnen. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="fr">Manteau de pourpre du Christ</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Purpurmantel Christi</skos:prefLabel>
        <skos:prefLabel xml:lang="en">purple robe of Christ</skos:prefLabel>
        <skos:prefLabel xml:lang="la">purpura Domini</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_7c5ae7fd -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_7c5ae7fd">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_332f7a93"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-16T10:10:09.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:41:04.000</terms:modified>
        <skos:altLabel xml:lang="de">Doppelgewölbe</skos:altLabel>
        <skos:altLabel xml:lang="en">double vault</skos:altLabel>
        <skos:definition xml:lang="de">Doppelschalenkuppel, ein Gewölbe mit voneinander getrennten Innen- und Außenschalen. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Gewölbe aus zwei selbständig gemauerten, übereinander Iiegenden Schalen. Diese Konstruktion bietet dem Architekten die Möglichkeit, die Gewölbeschale dem angestrebten Charakter des Innenraumes anzupassen, und das äußere Erscheinungsbild des Gewölbes freier zu gestalten.  [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Zweischalengewölbe</skos:prefLabel>
        <skos:prefLabel xml:lang="en">two-shelled vault</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte double</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_7c5f4d79 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_7c5f4d79">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a9f26611"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_f10222e0"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-12T14:58:09.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T16:11:09.000</terms:modified>
        <skos:altLabel xml:lang="de">Pickung</skos:altLabel>
        <skos:definition xml:lang="de">[Bei der Punktspitzung] handelte sich [...] um eine Bearbeitung, bei der die vorher grob abgespitzte oder geflächte Oberfläche mit dem Zweispitz fein aufgepickt wurde. Dabei wurde das Werkzeug senkrecht zur Oberfläche geführt, was die sehr feinen, punktförmigen Spuren ergab. [Voelkle 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Punktspitzung</skos:prefLabel>
    </owl:NamedIndividual>
    


