  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/129034">
    <skos:scopeNote xml:lang="en">A building used for the preparation of animal skins and hides prior to the tanning process.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91109">
    <skos:scopeNote xml:lang="en">A terrace of BACK TO EARTH HOUSES.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/119053">
    <skos:scopeNote xml:lang="en">A manmade barrier built across a river in order to increase the depth of water.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78193">
