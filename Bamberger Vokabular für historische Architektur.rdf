    <!-- https://hist-arch-vocab.org/bvha#c_b5ef7dd5 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b5ef7dd5">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_6a7d7ddc"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_f88715e5"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-16T14:21:42.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T16:23:03.000</terms:modified>
        <skos:definition xml:lang="de">Stufenportal, Portal mit von außen nach innen zurückgestuftem Gewände, so dass die meist relativ geringe Öffnung bei großen Mauerdicken in der Fassade wesentl. erweitert erscheint. Das Gewände kann durch eingestellte Säulen, die sich in oft ornamental verzierten Archivolten fortsetzen (Säulenportal), und durch Skulpturen zwischen den Säulen (Säulenfigurenportal) bereichert werden. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Stufenportal</skos:prefLabel>
        <skos:prefLabel xml:lang="es">portal escalonado</skos:prefLabel>
        <skos:prefLabel xml:lang="it">portale a smussi</skos:prefLabel>
        <skos:prefLabel xml:lang="en">stepped portal</skos:prefLabel>
        <broaderByConstruction rdf:resource="https://hist-arch-vocab.org/bvha#c_6a7d7ddc"/>
    </owl:NamedIndividual>
    


