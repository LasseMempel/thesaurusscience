    <!-- https://hist-arch-vocab.org/bvha#c_bvscnjkx -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_bvscnjkx">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_jqmv6iaq"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_380577c3"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_451a03d3"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_7daa3a60"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_9a3af356"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_ba2faafd"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_be20e6da"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_33318aad"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-11T21:32:17.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-24T10:10:22.000</terms:modified>
        <skos:note xml:lang="en">A hard and brittle, heat- and corrosion- resistant material, made by shaping clay or similar earth materials and subsequently firing them at high temperatures. [EwaGlos]</skos:note>
        <skos:note xml:lang="de">Ein hartes, sprödes, hitze- und korrosionsbeständiges Material, das durch die Formung von Tonerde oder ähnlichen Erdmaterialien und späteren Brand bei hohen Temperaturen hergestellt wird. [EwaGlos]</skos:note>
        <skos:note xml:lang="de">Keramik (griech. keramos = Töpferton), Sammelbegriff für Tonwaren. Man unterscheidet Grob-Keramik (Ziegel, Röhren, Baukeramik) und Fein-Keramik (Geschirr, Gefäße, kunstgewerbliche Gegenstände). Die Porosität des Scherben wird aufgehoben durch Sinterung des Tons bei hoher Brenntemperatur und durch Glasur. [Koch 2009]</skos:note>
        <skos:note xml:lang="cs">Řec. keramos = hrnčířská hlína. Souhrnný název pro výrobky z hlíny, rozlišujeme keramiku hrubou (cihly, trubky, stavební keramika) a jemnou (nádobí, nádoby, umělecké předměty); pórovitost výrobku se odstraňuje spékáním hlíny při vysoké vypalovací teplotě a glazurováním. [Koch 2008]</skos:note>
        <skos:prefLabel xml:lang="de">Keramik</skos:prefLabel>
        <skos:prefLabel xml:lang="en">ceramic</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">keramika</skos:prefLabel>
    </owl:NamedIndividual>
    


