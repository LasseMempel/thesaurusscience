        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-28T16:34:33.000</terms:modified>
        <skos:definition xml:lang="de">Gliederpfeiler, Rundpfeiler mit vier vorgelegten Diensten, umlaufendem Sockel und Kranzkapitell (Kämpferkapitell), um 1230 entstanden, Vorstufe zum Bündelpfeiler (fälschl. Kantonierter Pfeiler genannt). [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Gliederpfeiler</skos:prefLabel>
        <skos:prefLabel xml:lang="es">pilar articulado</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_cc7a1644"/>
    </owl:NamedIndividual>
    


