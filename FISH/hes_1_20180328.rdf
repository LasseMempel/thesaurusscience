		<skos:prefLabel xml:lang="gd">MUILEANN-UISGE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Muileann sa bheil innealan a tha ag obair air cumhachd-uisge.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">WATERMILL</skos:prefLabel>
