<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70075> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70074> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "SARCOPHAGUS"@en ;
