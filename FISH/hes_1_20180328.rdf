				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1861" />
				<skos:scopeNote xml:lang="en">Metal posts erected to support tramway overhead power lines, typically set in pairs across the street or tram reservation.</skos:scopeNote>
