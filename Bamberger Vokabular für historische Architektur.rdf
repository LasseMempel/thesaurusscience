        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-07T13:18:29.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T18:09:19.000</terms:modified>
        <skos:definition xml:lang="de">Drehtabernakel n: ein um eine senkrechte Achse drehbarer hölzerner Zylinder mit je einer Nische zur Aufstellung des Altarkreuzes und zur Aufbewahrung bzw. feierlichen Aussetzung des AllerheiIigsten. Einige dieser barocken Tabernakel können auch hochgewunden werden. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Drehtabernakel</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">otočný tabernákl</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">tabernacle tournant</skos:prefLabel>
        <skos:prefLabel xml:lang="en">turning tabernacle</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_dfaaade3 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_dfaaade3">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_fbedadd4"/>
