		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1525" />
		<skos:scopeNote xml:lang="en">A small square, circular or rectangular enclosure used for growing root crops, usually without an entrance.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
