        <skos:altLabel xml:lang="de">Flamboyant-Gotik</skos:altLabel>
        <skos:altLabel xml:lang="cs">flamboyantní gotika</skos:altLabel>
        <skos:altLabel xml:lang="cs">flamboyantský styl</skos:altLabel>
