        <skos:prefLabel xml:lang="fr">charnière</skos:prefLabel>
        <skos:prefLabel xml:lang="en">hinge</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">stěžejka</skos:prefLabel>
    </owl:NamedIndividual>
    


