        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T11:08:54.000</terms:modified>
        <skos:definition xml:lang="de">Fassade mit übermäßiger Häufung unterschiedlicher Dekorationselemente, vor allem des Manierismus, des bürgerlichen Barock und der Gründerzeit. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Průčelí s přehnaným nahromaděním různých dekoračních prvků, především v době manýrismu, měšťanského baroka (Brusel) a gründerské doby. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Stapelfassade</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">průčelí s patrovým členěním</skos:prefLabel>
    </owl:NamedIndividual>
    


