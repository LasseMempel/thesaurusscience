	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk001948">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">Canons Regular</skos:prefLabel>
		<skos:altLabel xml:lang="de">Chorherren (Orden)</skos:altLabel>
		<skos:prefLabel xml:lang="de">Regularkanoniker (Orden)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Regulierte Chorherren (Orden)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk001945"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010286"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019843"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk001945"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk001517"/>
		<skos:definition xml:lang="de">Der Orden der Regularkanoniker ist ein Kanonikerorden, in dem ausschließlich männliche Angehörige als Mitglieder einer Stiftskirche nach einer Ordensregel zusammenleben, dessen Angehörige die Priesterweihe besitzen und Ordensgelübde abgelegt haben, jedoch keine Mönche sind.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk001945"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010286"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019843"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-10-30T13:59:17+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk001949">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">Congregation of Windesheim</skos:prefLabel>
		<skos:altLabel xml:lang="de">Kongregation der Windesheimer</skos:altLabel>
		<skos:altLabel xml:lang="de">Windesheimer (Kongregation)</skos:altLabel>
		<skos:altLabel xml:lang="de">Windesheimer Chorherren</skos:altLabel>
		<skos:prefLabel xml:lang="de">Windesheimer Kongregation</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk002207"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010287"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019844"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk002207"/>
		<skos:definition xml:lang="de">Die Windesheimer Kongregation ist eine Kongregation, die der römisch-katholischen Kirche zugehört, der ausschließlich männliche Mitglieder angehören und die im 14. Jahrhundert von Augustiner-Chorherren gebildet und nach dem Kloster Windesheim bei Zwolle (Niederlande) benannt worden ist.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002207"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010287"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019844"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
