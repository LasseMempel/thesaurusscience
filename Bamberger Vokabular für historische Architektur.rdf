    <!-- https://hist-arch-vocab.org/bvha#c_412735f3 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_412735f3">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_6ca61a95"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_76131543"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-22T17:39:10.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T10:20:46.000</terms:modified>
        <skos:altLabel xml:lang="la">rubrica generalis</skos:altLabel>
        <skos:altLabel xml:lang="la">rubrica particularis</skos:altLabel>
        <skos:altLabel xml:lang="la">rubrica propia</skos:altLabel>
        <skos:definition xml:lang="de">Im liturgischen Sprachgebrauch bezeichnet Rubrik ein von der kirchlichen Autorität vorgeschriebenes Gesetz, welches den Vollzug einer liturgischen Handlung regelt; die Rubrik ist weiterhin meist rot geschrieben und entweder in den Text der Gebete eingeschoben (rubrica specialis, rubrica propria, rubrica particularis) oder zu Anfang des Textes niedergelegt (rubrica generalis). [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Rubrik (Gesetz)</skos:prefLabel>
        <skos:prefLabel xml:lang="la">rubrica specialis</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">rubriky</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">rubrique (loi)</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_412b56ae -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_412b56ae">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0e26a85b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_19d56a39"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-14T10:30:14.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T14:08:55.000</terms:modified>
        <skos:definition xml:lang="de">Das Klammerholz ist ein kurzes, mit zwei Schwalbenschwänzen zugfest ausgebildetes Holz, das zwei in geringem Abstand übereinandergeführte Hölzer verbindet. Das Klammerholz wird häufig bei abgesprengten Quer- und Längsbünden zwischen Druckriegel und Kehlbalken ausgeführt. (Eißing et al. 2012)</skos:definition>
        <skos:prefLabel xml:lang="de">Klammerholz</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_413edd23 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_413edd23">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a36fd146"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-11T12:19:56.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T23:48:09.000</terms:modified>
        <skos:definition xml:lang="de">Kornhaus, städt. Speicherhaus für Korn; außer den eigentl. Lager- und Speicherräumen muss ein K. noch einen Saal zur Abhaltung der Getreidebörse, einige Kontore und Verwaltungsräume enthalten. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Kornhaus</skos:prefLabel>
        <skos:prefLabel xml:lang="en">grain silo</skos:prefLabel>
        <skos:prefLabel xml:lang="it">granaio</skos:prefLabel>
        <skos:prefLabel xml:lang="es">granero, silo</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">grenier</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">obilné silo, obilnice</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_414757ae -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_414757ae">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_c4cdfaeb"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-01T09:55:50.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-06T16:45:23.000</terms:modified>
        <skos:definition xml:lang="de">Zur Dachentwässerung aus Holz, Weißblech, Kupfer, Zink, Blei- oder auch Eisenblech gefertigt, entweder am Dachfuß (Traufrinne, Fußrinne, Abrinne) oder in der Dachkehle (Kehl- oder Schoßrinne, Abweiser). Die D. wird durch eiserne, auf die Sparren genagelte Haken (Rinneneisen, Dachrinnenhaken) befestigt. Das Wasser wird durch Fallrohre oder Wasserspeier abgeleitet. D.n aus Ton oder Stein waren schon in der Antike gebräuchl. Im Norden kommen D.n aus Holz oder Blei sowie als Steinrinnen im Kirchenbau im 12. Jh., an Profanbauten im 13./14. Jh. auf. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Dachrinne</skos:prefLabel>
    </owl:NamedIndividual>
    


