        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T18:51:10.000</terms:modified>
        <skos:altLabel xml:lang="de">Eckverbindung mit Vorstoß</skos:altLabel>
        <skos:definition xml:lang="de">Beim Blockbau mit vorstoßender Eck- oder Querverbindung erfolgen die Einschnitte etwa 15-20 cm vor dem Balkenende und bilden so einen unverschiebbaren Rahmen mit Vorstoß (regional: Gwättkopf). Vorstöße können mit Dollen gesichert sein. (Eißing et al.)</skos:definition>
        <skos:prefLabel xml:lang="de">Gwättkopf</skos:prefLabel>
    </owl:NamedIndividual>
    


