	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1259">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1259</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">MUILEANN TÒN RI LÀR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Muileann-uisge aig a bheil roth-muilinn a tha na laighe air a chòmhnard san uisge 's a' tionndadh clach-mhuilinn as aonais gèaraichean eatarra.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HORIZONTAL MILL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">CLICK MILL</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1258" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/804" />
		<skos:scopeNote xml:lang="en">A water mill in which the mill wheel is set horizontally within the water channel, and turns a mill stone directly without the use of  gears.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
