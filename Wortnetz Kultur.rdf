	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk011142">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Hefe (Pilz)</skos:altLabel>
		<skos:altLabel xml:lang="de">Hefen (Pilze)</skos:altLabel>
		<skos:prefLabel xml:lang="de">Hefepilz</skos:prefLabel>
		<skos:altLabel xml:lang="de">Hefepilze</skos:altLabel>
		<skos:altLabel xml:lang="de">Sprosspilz</skos:altLabel>
		<skos:altLabel xml:lang="de">Sprosspilze</skos:altLabel>
		<skos:prefLabel xml:lang="en">yeast (fungi)</skos:prefLabel>
		<skos:altLabel xml:lang="en">yeasts (fungi)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk009230"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013755"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk009230"/>
		<skos:definition xml:lang="de">Ein Hefepilz ist ein einzelliger Pilz, der sich unter günstigen Bedingungen wie Wärme, Feuchtigkeit und Zucker rasch vermehrt, zumeist ungeschlechtlich durch Sprossung oder Zellteilung. Hefen kommen in vielfältigen Lebensräumen vor, etwa auf Pflanzen, in Böden, auf Oberflächen und im menschlichen Körper. Sie spielen eine wichtige Rolle im natürlichen Abbau organischer Substanzen und können sowohl nützlich (beispielsweise als Gärungsmittel und Backmittel) als auch krankheitserregend sein.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300380029"/>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4230509-3"/>
