        "Wasserschlag"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002252> ;
    skos:definition "Ein Kaffgesims ist ein Gesims, das an der Oberseite stark abgeschrägt, in der Unteransicht profiliert und mit einer Wassernase versehen ist."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Kaffgesims"@de .

<http://lvr.vocnet.org/wnk/wk003825> a skos:Concept ;
