	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk019096">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">coin weight</skos:prefLabel>
		<skos:altLabel xml:lang="en">coin weights</skos:altLabel>
		<skos:altLabel xml:lang="de">Münzgewicht (Gewichtsstück)</skos:altLabel>
		<skos:altLabel xml:lang="de">Münzgewichte (Gewichtsstücke)</skos:altLabel>
		<skos:altLabel xml:lang="de">Münzgewichtsstück</skos:altLabel>
		<skos:altLabel xml:lang="de">Münzgewichtsstücke</skos:altLabel>
		<skos:prefLabel xml:lang="de">Münzgewichtstück</skos:prefLabel>
		<skos:altLabel xml:lang="de">Münzgewichtstücke</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006899"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk006899"/>
		<skos:definition xml:lang="de">Ein Münzgewichtstück ist ein Gewichtsstück, das zum Nachwiegen von Kurantmünzen - Geldmünzen, deren Nominalwert dem Wert des Metalls entspricht, aus dem sie bestehen - diente. Diese Münzgewichte bestehen meist aus Kupfer, Kupferlegierung oder auch Glas und können in ihrer Form den entsprechenden Münzen gleichen. Oft tragen sie Beschriftung oder Bilder zur Kennzeichnung.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300254280"/>
		<skos:mappingRelation rdf:resource="http://d-nb.info/gnd/4170682-1"/>
		<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1252368"/>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4170683-3"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk006899"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
