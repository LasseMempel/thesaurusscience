		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-17T13:42:14+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk007309">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Bottich</skos:prefLabel>
		<skos:altLabel xml:lang="de">Bottiche</skos:altLabel>
		<skos:prefLabel xml:lang="en">vat (container)</skos:prefLabel>
		<skos:altLabel xml:lang="en">vats (containers)</skos:altLabel>
		<skos:altLabel xml:lang="de">Zuber</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000202"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk004497"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013708"/>
		<skos:definition xml:lang="de">Ein Bottich ist ein runder bis wannenförmiger, offener Behälter. In der Regel aus Dauben gefertigt und durch Reifen zusammengehalten, werden Bottiche oftmals als Gärgefäße genutzt. Je nach Verwendungszweck besitzen Bottiche Griffe oder Deckel.</skos:definition>
