  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140507">
    <skos:scopeNote xml:lang="en">A pillbox with walls that have been thickened to protect against shells. Double index with specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69343">
    <skos:scopeNote xml:lang="en">An excavation made in the earth for the purpose of digging out metallic ores, coal, salt, or precious stones etc. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92437">
    <skos:scopeNote xml:lang="en">For the storage and recharging of battery-powered miners lamps.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69366">
    <skos:scopeNote xml:lang="en">A simple machine, worked by horses, to provide a power take-off for driving agricultural machinery.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91185">
    <skos:scopeNote xml:lang="en">A bookbinding workshop.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69038">
    <skos:scopeNote xml:lang="en">An area attached to a house, or part of an estate used for pleasure and recreation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70409">
    <skos:scopeNote xml:lang="en">A set of marks found on the wall of a building, thought to be a form of sundial.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93463">
