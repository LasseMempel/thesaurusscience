    <skos:scopeNote xml:lang="en">A site which has produced evidence of in situ working of stone for the manufacture of tools, weapons or other objects. Such sites will usually, but not always, be of prehistoric date. Use object material where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/129046">
    <skos:scopeNote xml:lang="en">A mill, on two or more levels.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71522">
    <skos:scopeNote xml:lang="en">A type of GARDEN HOUSE, usually in the form of an open-fronted shelter with seat.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91656">
    <skos:scopeNote xml:lang="en">A building in which cattle are housed overnight, normally tethered in stalls.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/144463">
    <skos:scopeNote xml:lang="en">An electric fan used for the ventilation of mines.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/145009">
    <skos:scopeNote xml:lang="en">A mechanism used to transport minerals or granulated materials.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93222">
    <skos:scopeNote xml:lang="en">A site associated with the extraction, from the ground, of sand and gravel. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142048">
    <skos:scopeNote xml:lang="en">A circular construction at the intersection of two or more roads to aid the passage of vehicles from one road to another.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140487">
    <skos:scopeNote xml:lang="en">Aircraft hangars designed by T. Bedford Consulting Engineers to meet the requirement to repair damaged heavy bombers in situ on their airfields.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92364">
    <skos:scopeNote xml:lang="en">A building in London belonging to one of four legal societies having exclusive right of admitting persons to practise at the English bar.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91985">
    <skos:scopeNote xml:lang="en">A system of petrol burners, pipework and pump houses on an airfield used to 'burn' away fog so that aircraft may take off and land safely.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87137">
    <skos:scopeNote xml:lang="en">A factory used for the manufacture of screws.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162967">
    <skos:scopeNote xml:lang="en">An airfield, and associated structures, used by one or more bomber squadrons.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164391">
    <skos:scopeNote xml:lang="en">An area for the testing of guided missiles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71428">
    <skos:scopeNote xml:lang="en">A group of buildings or rooms equipped with apparatus for scientific experiments or other research, testing and investigations.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91383">
    <skos:scopeNote xml:lang="en">A wing in a workhouse to accommodate vagrants overnight.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/151876">
    <skos:scopeNote xml:lang="en">A room in a monastery used by monks or nuns as a day room.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/147356">
    <skos:scopeNote xml:lang="en">Small vernacular building used by fishermen for the preparing of nets and storage of equipment.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70345">
    <skos:scopeNote xml:lang="en">An underground room or building with an arched roof, often used as a burial chamber. Use wider site type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99573">
    <skos:scopeNote xml:lang="en">A works or factory principally engaged in the manufacture of dynamite</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70438">
    <skos:scopeNote xml:lang="en">A small building built over the end of a water conduit or spring.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71473">
    <skos:scopeNote xml:lang="en">A school established by a charity.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92971">
    <skos:scopeNote xml:lang="en">A small building used by the keeper of a castle, park, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71329">
    <skos:scopeNote xml:lang="en">An early form of railway for the transportation of freight by wagons on rails on a road.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/130173">
    <skos:scopeNote xml:lang="en">A site which has been bombed but where there is no crater, eg. bombed buildings.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68675">
    <skos:scopeNote xml:lang="en">Sites, buildings, structures etc associated with the civil administration of settlements &amp; enforcement of the laws of the land. Includes local &amp; central government, settlements granted by the crown or ruling administration does not manorial settlements.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92499">
    <skos:scopeNote xml:lang="en">A building in which an organization or society is instituted to promote literature through lectures, study and research, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93994">
    <skos:scopeNote xml:lang="en">The residence of a glover.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70290">
    <skos:scopeNote xml:lang="en">An open area of water, usually artificial and enclosed by dock gates or locks, lined with wharves and warehouses, where barges, narrow boats and other canal vessels can load and unload goods and supplies.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93541">
    <skos:scopeNote xml:lang="en">A site where terracotta, made from weathered clay and grog, was manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92238">
    <skos:scopeNote xml:lang="en">A lighthouse whose lantern is sufficiently high to be seen at a long range and above low lying cloud or fog. In locations where varying weather conditions occur a High Light is usually accompanied by a LOW LIGHT built alongside or nearby.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91352">
    <skos:scopeNote xml:lang="en">A tomb with a raised canopy over it.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69463">
    <skos:scopeNote xml:lang="en">A structure of iron or wood, open below, running out into the sea and used as a promenade and landing stage.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93346">
    <skos:scopeNote xml:lang="en">A place where the game of skittles is played.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92138">
    <skos:scopeNote xml:lang="en">A tower used to store grain in.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91041">
    <skos:scopeNote xml:lang="en">A monument commemorating an animal.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69059">
    <skos:scopeNote xml:lang="en">A place from which clay is extracted.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92891">
    <skos:scopeNote xml:lang="en">A training college where workers can attend classes in vocational subjects. The classes are often day-release and sanctioned by the employer.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92077">
    <skos:scopeNote xml:lang="en">A decorative or ornamental structure purposefully situated in a garden. Such as sculptures, sundials, bird baths, gnomes etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91601">
    <skos:scopeNote xml:lang="en">A place, often including a BAKERY, where sweetmeats and pastries are sold.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/118853">
    <skos:scopeNote xml:lang="en">A man made terrace, often constructed in concrete, built to allow spectators a view of organized outdoor events or activities.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70217">
    <skos:scopeNote xml:lang="en">A movable bridge lifted at one end by chains or ropes either to stop traffic passing over it or to let traffic pass under it.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92423">
    <skos:scopeNote xml:lang="en">An employment exchange for unemployed labourers, servicemen, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68701">
    <skos:scopeNote xml:lang="en">A school founded in or before the 16th century, for teaching Latin, later becoming a secondary school teaching languages, history, science, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71409">
    <skos:scopeNote xml:lang="en">A structure, partly underground, for the preservation of ice for use during warmer weather.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68961">
    <skos:scopeNote xml:lang="en">A building of basic construction, usually smaller in size than a house and constructed from a variety of materials such as mud, turf, branches, wood, brick, concrete or metal. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/129035">
    <skos:scopeNote xml:lang="en">A workshop used in the manufacture and preparation of textiles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/100007">
    <skos:scopeNote xml:lang="en">An outlying farm or estate belonging to the Bridgettine order.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68790">
    <skos:scopeNote xml:lang="en">A stone slab, raised on stone or wooden piers, used for the display of fresh fish. Usually found in market places.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92071">
    <skos:scopeNote xml:lang="en">A series of arches, linked together, often made out of clipped hedges or trees with the trunks forming the uprights</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/119493">
    <skos:scopeNote xml:lang="en">Purpose built accommodation for members of the armed forces and their families.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140351">
    <skos:scopeNote xml:lang="en">An artificially constructed wall with recessed and projecting grips for hands and feet and places to attach ropes. Used for practising rock climbing. If the wall is situated within a sports centre use term from Components thesaurus.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69029">
    <skos:scopeNote xml:lang="en">A small artificial pond of water often found in parks and gardens, for decorative purposes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140223">
    <skos:scopeNote xml:lang="en">A surface interpreted as a buried cultivation layer, for example an agriculturally cultivated field.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93234">
    <skos:scopeNote xml:lang="en">A large room or building at a school used for assembly and other activities.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143544">
    <skos:scopeNote xml:lang="en">Similar in design to the Callender Hangar but with a reduced height of 17ft. Built to Air Ministry drawing number 17346/40.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70357">
    <skos:scopeNote xml:lang="en">An area of land, in the shape of a D, enclosed by a boundary ditch, bank, wall, palisade or similar barrier.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94039">
    <skos:scopeNote xml:lang="en">A temporary airfield in use during the build-up to D-Day. They consisted of a natural earth or grass surface reinforced with wire mesh.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68705">
    <skos:scopeNote xml:lang="en">A large, rectangular open space at the centre of a Roman town, incorporating public spaces and a market area.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93838">
    <skos:scopeNote xml:lang="en">A road surface made out of wooden blocks or planks. It was much used in English cities before 1940, but the cost of wooden blocks eventually made it uneconomical.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69251">
    <skos:scopeNote xml:lang="en">Term for ore store/ore hopper, used particularly in Yorkshire and Derbyshire.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68903">
    <skos:scopeNote xml:lang="en">A prison site for the containment of servicemen captured in war.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91974">
    <skos:scopeNote xml:lang="en">A channel dug, or built up, to carry away surplus water from a river or waterway to prevent it bursting its banks and flooding.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68776">
    <skos:scopeNote xml:lang="en">A large free-standing arch erected to commemorate a triumph or victory.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143372">
    <skos:scopeNote xml:lang="en">Beaches used for the departure of troops and equipment for the D-day landings.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70017">
    <skos:scopeNote xml:lang="en">A burial monument, usually of Iron age date, comprising a small square ditched enclosure surrounding a central interment, which may also have been covered by a mound.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92715">
    <skos:scopeNote xml:lang="en">A building where documents such as title-deeds, charters, etc, were kept as evidence of rights or privileges.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68707">
    <skos:scopeNote xml:lang="en">Sites, buildings, structures &amp; features associated with health (for example, treatment of the sick) &amp;/or social welfare (for example, alleviation of poverty), including all charitable foundations &amp; all forms of state defined social welfare.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69420">
    <skos:scopeNote xml:lang="en">A workshop where baskets were manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160223">
    <skos:scopeNote xml:lang="en">A building used for the storage and distribution of civilian respirators and Air Raid Precautions equipment.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91446">
    <skos:scopeNote xml:lang="en">An outer wall of a castle or similar fortification.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70168">
    <skos:scopeNote xml:lang="en">An abbey or a priory of Cistercian nuns.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68911">
    <skos:scopeNote xml:lang="en">A temporary overnight camp enclosed by a shallow ditch and palisade, constructed by Roman troops on campaigns or manoeuvres.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/149817">
    <skos:scopeNote xml:lang="en">A burial ground for followers of the Islamic faith.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93479">
    <skos:scopeNote xml:lang="en">A chalet designed in the Swiss style, eg. Kenwood, London.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68574">
    <skos:scopeNote xml:lang="en">A recess in a stone or brick wall, usually bounding a garden or orchard, set two to three feet from the ground and facing south to south-east to catch the morning sun, in which a bee skep/beehive is placed. Often found in groupings of three to six.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92048">
    <skos:scopeNote xml:lang="en">A place where social and other functions such as parties, presentations and meetings can be held.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68826">
    <skos:scopeNote xml:lang="en">A site in which one or more searchlights were positioned to locate enemy aircraft or surface vessels for the benefit of batteries and night fighter aircraft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70228">
    <skos:scopeNote xml:lang="en">A stone, situated alongside a road, providing directions to travellers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143016">
    <skos:scopeNote xml:lang="en">A purpose-built facility providing an area for wheeled sports, such as skateboarding, skating and BMX cycling, equipped with ramps and other structures and obstacles for the performance of tricks and manoeuvres.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141990">
    <skos:scopeNote xml:lang="en">A building housing the brakes for an incline railway or tramway.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68842">
    <skos:scopeNote xml:lang="en">An early form of castle consisting of a flat-top steep-sided earthen mound, supporting a wooden tower, and a bailey.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71709">
    <skos:scopeNote xml:lang="en">A steam driven winding engine house for raising coal to the surface.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93126">
    <skos:scopeNote xml:lang="en">A building used by an organization or society instituted to promote research.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68743">
    <skos:scopeNote xml:lang="en">A meeting hall, sometimes equivalent to a GUILDHALL, but also associated with some early mining industries.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92899">
    <skos:scopeNote xml:lang="en">A pump used to transfer petrol from a storage tank into cars, lorries and other road vehicles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92725">
    <skos:scopeNote xml:lang="en">A small work shop for nail manufacture, most commonly situated at the back of a nailer's dwelling.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143254">
    <skos:scopeNote xml:lang="en">64 Type DFW55373 projector sites arranged in and 8x8 grid or in 4 groups of 16. 30m between each projector, with hardened personnel and ammunition shelters located midway between each</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71483">
    <skos:scopeNote xml:lang="en">A building housing an engine, usually with an attendant boiler house and chimney. Used for winding from a pit.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93762">
    <skos:scopeNote xml:lang="en">A structure consisting of a large plastic pipe attached to a high tower and sloping down to a swimming pool. Water flows down the inside allowing people to slide down into the pool below.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142992">
    <skos:scopeNote xml:lang="en">Mark, usually consisting of a horizontal line above an arrow, cut by the Ordnance Survey as part of the survey of Britain and referenced to a known height above mean sea level.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70382">
    <skos:scopeNote xml:lang="en">A natural or artificial elevation of earth or stones, such as the earth heaped upon a grave. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69222">
    <skos:scopeNote xml:lang="en">A factory or works used for the forging and sharpening of a variety of tools including scythes, spades, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162644">
    <skos:scopeNote xml:lang="en">An underground hideout containing radio equipment to be used by the Special Duties sections of the Auxiliary Units to co-ordinate information collected by the outstations for relaying to headquarters.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91438">
    <skos:scopeNote xml:lang="en">A factory where cheese is produced and processed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70101">
    <skos:scopeNote xml:lang="en">A Prehistoric monument type in South West England in which a natural boulder is surrounded by a man-made kerb of stones.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140187">
    <skos:scopeNote xml:lang="en">The earliest side-opening standard type of aircraft hangar designed in 1913 and used in WWI. Originally constructed from wooden trusses and struts, one example has steel frames. It comprised a single or coupled shed with rear workshops.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69978">
    <skos:scopeNote xml:lang="en">A Neolithic monument comprising an irregularly circular enclosing ditch, interrupted by frequent causeways, and often accompanied by an internal bank, also causewayed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93334">
    <skos:scopeNote xml:lang="en">Ore hearth specifically for the refining of silver.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92233">
    <skos:scopeNote xml:lang="en">A shelter, sometimes camouflaged, for the observation of birds and animals at close quarters.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92860">
    <skos:scopeNote xml:lang="en">A coin-operated meter receiving fees for parking a vehicle in a street, and indicating time allowed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143471">
    <skos:scopeNote xml:lang="en">Sites used for the accommodation, welfare and recreation of servicemen, especially those serving in the Royal Air Force. Use only for sites associated with military installations. For non-military sites use DOMESTIC class and its narrower terms.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140550">
    <skos:scopeNote xml:lang="en">Based on a typical 18ft span, 40ft long temporary brick hut but with two bay windows in the front elevation, one for the watch office and one for the chief instructor.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70209">
    <skos:scopeNote xml:lang="en">An area or site used for the landing and take-off of aircraft, often including associated buildings, equipment and other installations.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93302">
    <skos:scopeNote xml:lang="en">A grotto decorated with shells, sometimes a room in a house, sometimes a detached building.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92550">
    <skos:scopeNote xml:lang="en">A scientific laboratory where marine life is studied and researched.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93261">
    <skos:scopeNote xml:lang="en">A hospital for the medical and surgical treatment of sailors and/or their families. For Royal Naval seamen use ROYAL NAVAL HOSPITAL.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93267">
    <skos:scopeNote xml:lang="en">A building providing lodgings for members of the police force.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70249">
    <skos:scopeNote xml:lang="en">A piece of machinery on which a railway engine, carriage or wagon can be rotated at a railway terminal.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69041">
    <skos:scopeNote xml:lang="en">An isolated building, circular in plan, generally consisting of one apartment with a domed roof, eg. Mausoleum at Castle Howard, Yorkshire.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/103814">
    <skos:scopeNote xml:lang="en">An institution for the imprisonment of prisoners who can be trusted to serve their sentence without likelihood of escape and of being a threat to the public. There is no physical barrier designed to prevent absconding.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68548">
    <skos:scopeNote xml:lang="en">A levelled area of ground on which a barn is built. A platform is often the sole surviving evidence for a barn.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92750">
    <skos:scopeNote xml:lang="en">A hospital for the treatment of diseases of the nerves and nervous system.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162873">
    <skos:scopeNote xml:lang="en">A small area of managed woodland, created to provide cover for foxes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143490">
    <skos:scopeNote xml:lang="en">An open area of prepared ground used for practising putting with golf clubs.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92010">
    <skos:scopeNote xml:lang="en">A medieval court established for the administration of forest law.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93047">
    <skos:scopeNote xml:lang="en">A sculptured group comprising a chariot drawn by four horses.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87782">
    <skos:scopeNote xml:lang="en">The entrance to a tunnel. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159298">
    <skos:scopeNote xml:lang="en">A prefabricated structure of reinforced concrete posts supporting a pitched roof frame with an infilling of sawdust concrete panels. Produced by Maycrete Ltd during WWII.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69270">
    <skos:scopeNote xml:lang="en">Use with other minerals extracted and MINE where relevant, eg. ZINC MINE.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92521">
    <skos:scopeNote xml:lang="en">A crane in which, during any alteration of radius, an automatic device causes the load to move horizontally.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93557">
    <skos:scopeNote xml:lang="en">A building containing a number of areas for bathing, some of which are naturally heated by thermal springs.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91930">
    <skos:scopeNote xml:lang="en">An unsocketed earthenware or porous concrete pipe laid end to end unjointed so as to drain the ground.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93317">
    <skos:scopeNote xml:lang="en">A long bed planted with mixed shrubs, usually found near the house.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69105">
    <skos:scopeNote xml:lang="en">A site where copper ore is extracted directly from the surface of the ground.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69060">
    <skos:scopeNote xml:lang="en">A pit used for the containment of clay whilst it is mixed to the right consistency for brickmaking.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99659">
    <skos:scopeNote xml:lang="en">A place of worship for members of the United Methodists Church, a group formed in 1907 by the amalgamation of the United Methodist Free Church, the Methodist New Connection and the Bible Christians.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71825">
    <skos:scopeNote xml:lang="en">A place of worship for Baptists. The first Baptist church was formed by Thomas Helws in 1611 and gave rise to the General Baptist Movement.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68797">
    <skos:scopeNote xml:lang="en">A market where cattle, pigs, sheep and poultry are bought and sold.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71538">
    <skos:scopeNote xml:lang="en">An enclosure for the containment of a bull.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68919">
    <skos:scopeNote xml:lang="en">A building or structure from which observation is kept of the approach of danger.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87916">
    <skos:scopeNote xml:lang="en">A building adjoining a cricket pitch with facilities for players and spectators.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94357">
    <skos:scopeNote xml:lang="en">Buildings, structures and sites for the training of military personnel.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70109">
    <skos:scopeNote xml:lang="en">A mound in excess of 150 metres in diameter, of Late Neolithic date and presumed ritual function, eg. Silbury Hill.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68841">
    <skos:scopeNote xml:lang="en">An artificial steep-sided earthen mound on, or in, which is set the principal tower of a castle.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92322">
    <skos:scopeNote xml:lang="en">An engine powered by high pressure water, originally used in mine drainage.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68775">
    <skos:scopeNote xml:lang="en">A representation in the round of a living being, allegorical personage, eminent person or animal, etc, sculptured, moulded or cast in marble, metal, plaster, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71617">
    <skos:scopeNote xml:lang="en">Use with wider site type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/83029">
    <skos:scopeNote xml:lang="en">A room or building housing the controls to a mechanized system, eg. in a power station, airport, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91698">
    <skos:scopeNote xml:lang="en">An unlit, highly visible and distinctive feature on the coast that can be used by mariners for navigation during daylight only.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70457">
    <skos:scopeNote xml:lang="en">A large natural or artificial body of water, sometimes covered, used to collect and store water for a particular function, eg. industrial or public use.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68782">
    <skos:scopeNote xml:lang="en">Traditionally the premises of a chandler, a maker and seller of candles. Now, a shop for the retail of groceries and other provisions.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160313">
    <skos:scopeNote xml:lang="en">A large, circular, reinforced-concrete tank supported on concrete staging built to Air Ministry drawing number 1178/25 and designed to hold 30,000 gallons of water. The height of the tower varied according to local site requirements.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68638">
    <skos:scopeNote xml:lang="en">A system of individually enclosed fields.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140199">
    <skos:scopeNote xml:lang="en">Building block (often a temporary brick structure or Nissen hut) comprising office accommodation for flight commanders and flight sergeants as well as pilots' rest rooms, storerooms and locker rooms. Some flight offices have central corridors.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143964">
    <skos:scopeNote xml:lang="en">A factory used for the industrial manufacture of firelighters.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92936">
    <skos:scopeNote xml:lang="en">A commemorative monument to victims of the plague.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91736">
    <skos:scopeNote xml:lang="en">Excludes terms specific to MARINE CONSTRUCTION SITE.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68665">
    <skos:scopeNote xml:lang="en">A platform for storing winter fodder.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/152318">
    <skos:scopeNote xml:lang="en">A C20th military building used to test the efficiency of gas protection equipment provided for drivers of all forms of vehicles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68787">
    <skos:scopeNote xml:lang="en">A building where samples of corn were sold or auctioned during the early to mid 19th century. When not in use, between market days, the buildings were used as public halls.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159243">
    <skos:scopeNote xml:lang="en">A building or complex where animal hair is processed, using a variety of means, for use in products such as brushes, mattresses etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68779">
    <skos:scopeNote xml:lang="en">A commercial bakery or bread factory. If domestic use BAKEHOUSE.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/144602">
    <skos:scopeNote xml:lang="en">A building containing machinery for operating sluices.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93567">
    <skos:scopeNote xml:lang="en">A place where ceramic tiles are manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99588">
    <skos:scopeNote xml:lang="en">A chemical works engaged in the production of the coal tar derivative phenol, a chemical used for the manufacture of explosives during WWI.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/147431">
    <skos:scopeNote xml:lang="en">A garden or park, with ancilliary buildings, in which young and domesticated animals are kept for public exhibition, especially for children. Children are given the opportunity to come into close contact and handle animals.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140517">
    <skos:scopeNote xml:lang="en">A pillbox built to a design by the commander of the Royal Engineers for the Colchester Garrison.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69057">
    <skos:scopeNote xml:lang="en">A site where cement is manufactured for the building industry.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70149">
    <skos:scopeNote xml:lang="en">An outlying farm or estate belonging to the Benedictine order.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71624">
    <skos:scopeNote xml:lang="en">A structure, often movable, used as a platform for the display of a traders goods in a market.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94058">
    <skos:scopeNote xml:lang="en">A building used to accommodate hippopotami.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70350">
