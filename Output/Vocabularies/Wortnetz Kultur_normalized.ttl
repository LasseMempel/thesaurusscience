<http://lvr.vocnet.org/wnk/wk002591> a skos:Concept ;
    skos:altLabel "Stauddämme"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000133>,
        <http://lvr.vocnet.org/wnk/wk001792> ;
    skos:definition "Ein Staudamm ist ein Damm, der als Bestandteil einer Stauanlage aus aufgeschütteten Baustoffen besteht und das Gebiet abschließt, in dem ein Gewässer aufgestaut wird."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Staudamm"@de,
        "embankment dam"@en .

<http://lvr.vocnet.org/wnk/wk002592> a skos:Concept ;
    skos:altLabel "Galgenberg"@de,
        "gallows hill"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000931>,
        <http://lvr.vocnet.org/wnk/wk001509> ;
    skos:closeMatch <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68730> ;
    skos:definition "Ein Galgenhügel ist eine Richtstätte, die außerhalb eines bewohnten Ortes auf einem Hügel liegt und an der ein Galgen errichtet worden ist."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Galgenhügel"@de,
        "gallows mound"@en .

<http://lvr.vocnet.org/wnk/wk002600> a skos:Concept ;
    skos:altLabel "Wendeltreppen"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000115> ;
    skos:definition "Eine Wendeltreppe ist eine Treppe, deren Stufen sich schraubenförmig um eine geschlossene Spindel oder ein Treppenloch winden."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Wendeltreppe"@de,
        "winding stair"@en .

<http://lvr.vocnet.org/wnk/wk002601> a skos:Concept ;
    skos:altLabel "Fahrtreppe"@de,
        "Rolltreppen"@de,
        "escalators"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000115>,
        <http://lvr.vocnet.org/wnk/wk004365> ;
    skos:exactMatch <http://d-nb.info/gnd/4178428-5>,
        <http://vocab.getty.edu/aat/300051244>,
        <https://www.wikidata.org/wiki/Q15003> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Rolltreppe"@de,
        "escalator"@en .

<http://lvr.vocnet.org/wnk/wk002604> a skos:Concept ;
    skos:altLabel "Innentreppen"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000115> ;
    skos:definition "Eine Innentreppe ist eine Treppe, die von einem Gebäudeteil umschlossen ist, der einen Raum abschließt."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Innentreppe"@de,
        "internal staircase"@en .

<http://lvr.vocnet.org/wnk/wk002605> a skos:Concept ;
    skos:altLabel "Außentreppen"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000115> ;
    skos:definition "Eine Außentreppe ist eine Treppe, die parallel zur Hauswand außen an einem Gebäude in höher gelegene Stockwerke führt."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Außentreppe"@de,
        "external  staircase"@en .

<http://lvr.vocnet.org/wnk/wk002608> a skos:Concept ;
    skos:altLabel "Feuertreppen"@de,
        "fire exit stairs"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000115> ;
    skos:definition "Eine Feuertreppe ist eine Treppe, die nur dazu dient, in einem Notfall, insbesondere bei einem Brand, die oberen Geschosse eines Gebäudes schnell und sicher zu verlassen."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Feuertreppe"@de,
        "fire  escape"@en .

<http://lvr.vocnet.org/wnk/wk002609> a skos:Concept ;
    skos:altLabel "Kellertreppen"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000115> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Kellertreppe"@de .

<http://lvr.vocnet.org/wnk/wk002612> a skos:Concept ;
    skos:altLabel "Antritt (Treppe)"@de,
        "Antrittsstufen"@de,
        "Antrittstufe"@de,
        "Antrittstufen"@de,
        "Treppenantrittsstufe"@de,
        "bottom step"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000296> ;
    skos:definition "Eine Antrittsstufe ist die Treppenstufe, die vom Boden aus als erstes betreten wird."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Antrittsstufe"@de,
        "first step"@en .

<http://lvr.vocnet.org/wnk/wk002613> a skos:Concept ;
    skos:altLabel "Antrittpfosten"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002614> ;
    skos:definition "Ein Antrittspfosten ist ein Pfosten, der am Antritt einer Treppe als unterster Pfosten eines Treppengeländers steht."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Antrittspfosten"@de,
        "starting newel"@en .

<http://lvr.vocnet.org/wnk/wk002617> a skos:Concept ;
    skos:altLabel "Einsiedeleien"@de,
        "Einsiedlerklause"@de,
        "Einsiedlerwohnung"@de,
        "Klause (Siedlung)"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000122>,
        <http://lvr.vocnet.org/wnk/wk003469> ;
    skos:definition "Eine Einsiedelei ist eine Siedlung, in der sich eine einzelne Person oder eine Gruppe zu einem kontemplativen Leben mit besonderer Konzentration auf geistige sowie religiöse Inhalte oder einem Leben im Einklang mit der Natur zurückzieht."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4140453-1>,
        <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70099>,
        <http://vocab.getty.edu/aat/300000640> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Einsiedelei"@de,
        "hermitage (religious retreat)"@en ;
    skos:scopeNote "Benutzt für den Ort religiös motivierten Rückzugs; für den im Rahmen einer Gartengestaltung und häufig nachgespielten zeitweisen Rückzug gestalteten Ort siehe Eremitage (wk003641)."@de .

<http://lvr.vocnet.org/wnk/wk002618> a skos:Concept ;
    skos:altLabel "fairfaced  brickwork"@en,
        "unrendered masonry"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002319> ;
    skos:definition "Sichtmauerwerk ist ein Mauerwerk, bei dem die Steinoberflächen sichtbar und weder verputzt noch geschlämmt sind. "@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Sichtmauerwerk"@de,
        "exposed masonry"@en .

<http://lvr.vocnet.org/wnk/wk002619> a skos:Concept ;
    skos:altLabel "quarrystone  work"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002319> ;
    skos:definition "Bruchsteinmauerwerk ist ein Mauerwerk, bei dem die Steine so verwendet werden, wie sie aus dem Bruch kommen."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Bruchsteinmauerwerk"@de .

<http://lvr.vocnet.org/wnk/wk002620> a skos:Concept ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002319> ;
    skos:definition "Ein Trockenmauerwerk ist ein Mauerwerk, bei dem das Material ohne Bindemittel aufeinander geschichtet wird und das sich häufig bei kleineren Stützmauern, z.B. in Weinberghängen findet."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Trockenmauerwerk"@de,
        "dry  masonry"@en .

<http://lvr.vocnet.org/wnk/wk002621> a skos:Concept ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002319> ;
    skos:definition "Ein Lehmmauerwerk ist ein Mauerwerk, bei dem Lehmmörtel als Bindemittel verwendet wird."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Lehmmauerwerk"@de,
        "loam masonry"@en .

<http://lvr.vocnet.org/wnk/wk002622> a skos:Concept ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002319> ;
    skos:definition "Ein Mörtelmauerwerk ist ein Mauerwerk, bei dem Kalk, Trass oder Zement als Bindemittel und auch in unterschiedlichen Mischungsverhältnissen verwendet werden."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Mörtelmauerwerk"@de,
        "mortar masonry"@en .

<http://lvr.vocnet.org/wnk/wk002623> a skos:Concept ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002319> ;
    skos:definition "Feldsteinmauerwerk ist ein Mauerwerk, das aus aufgelesenen und unbearbeiteten Steinen besteht."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Feldsteinmauerwerk"@de,
        "Field stone masonry"@en .

<http://lvr.vocnet.org/wnk/wk002625> a skos:Concept ;
    skos:altLabel "Polygonalmauerwerk"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002624> ;
    skos:definition "Zyklopenmauerwerk ist ein Hausteinmauerwerk, bei dem große Steine lediglich an den Kanten bearbeitet werden, um die Steine einander anzupassen, wobei waagerechte Lagerfugen und durchgehende Schichthöhen nicht die Regel sind."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Zyklopenmauerwerk"@de,
        "cyclopean  masonry"@en .

<http://lvr.vocnet.org/wnk/wk002628> a skos:Concept ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002626> ;
    skos:definition "Rustikamauerwerk ist ein Quadermauerwerk, bei dem auf der Ansichtsseite der kaum bearbeitete Spiegel vor den geglätteten und geebneten Rand des Quaders tritt."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Rustikamauerwerk"@de,
        "rusticated masonry"@en .

<http://lvr.vocnet.org/wnk/wk002629> a skos:Concept ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002626> ;
    skos:definition "Ein Polstermauerwerk ist ein Quadermauerwerk, bei dem die vorstehenden Spiegel der Quader kissenförmig oder polsterförmig bearbeitet sind."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Polstermauerwerk"@de .

<http://lvr.vocnet.org/wnk/wk002630> a skos:Concept ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002319> ;
    skos:definition "Diamantquadermauerwerk ist ein Mauerwerk, bei dem die vorstehenden Spiegel der Quader mit glatten Flächen und Abkantungen ähnlich dem Facettenschliff bei Edelsteinen bearbeitet sind. "@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Diamantquadermauerwerk"@de .

<http://lvr.vocnet.org/wnk/wk002631> a skos:Concept ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002319> ;
    skos:definition "Ein Verblendmauerwerk ist ein Mauerwerk, bei dem Schalen aus Steinmauerwerk durch eine innere Gussmasse miteinander verbunden sind."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Verblendmauerwerk"@de,
        "faced  brickwork"@en .

<http://lvr.vocnet.org/wnk/wk002632> a skos:Concept ;
    skos:altLabel "Gussmauerwerke"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002319> ;
    skos:definition "Ein Gussmauerwerk ist ein Mauerwerk, das aus einer Gussmasse erstellt wird, die zwischen Holzschalungen, aber auch Steinschalungen eingebracht ist."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Gussmauerwerk"@de,
        "Roman concrete"@en .

<http://lvr.vocnet.org/wnk/wk002682> a skos:Concept ;
    skos:altLabel "Schichten (Bautechnik)"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002680> ;
    skos:definition "Eine Schicht ist der Bestandteil eines Mauerverbandes, mit dem eine waagerechte Reihe von Steinen bezeichnet wird."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Schicht (Bautechnik)"@de,
        "layer (tech.)"@en .

<http://lvr.vocnet.org/wnk/wk002683> a skos:Concept ;
    skos:broader <http://lvr.vocnet.org/wnk/wk009664> ;
    skos:definition "Eine Stoßfuge ist eine Mauerfuge, der den Bereich bezeichnet, in dem zwei Steine einer Schicht aneinanderstoßen."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Stoßfuge"@de,
        "heading joint"@en .

<http://lvr.vocnet.org/wnk/wk002684> a skos:Concept ;
    skos:altLabel "Setzfuge"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk009664> ;
    skos:definition "Eine Lagerfuge ist eine Mauerfuge, der in der Regel mit Mörtel gefüllten Bereich zwischen zwei Schichten bezeichnet."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Lagerfuge"@de .

<http://lvr.vocnet.org/wnk/wk002687> a skos:Concept ;
    skos:altLabel "Schornsteinverband"@de,
        "longudinal bond"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002680> ;
    skos:definition "Ein Läuferverband ist ein Mauerverband, in dem die Steine jeder Schicht als Läufer verbaut sind."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Läuferverband"@de,
        "stretcher bond"@en .

<http://lvr.vocnet.org/wnk/wk002688> a skos:Concept ;
    skos:altLabel "Streckerverband"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002680> ;
    skos:definition "Ein Binderverband ist ein Mauerverband, bei dem alle Steine jeder Schicht als Binder verbaut sind."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Binderverband"@de,
        "header bond"@en .

<http://lvr.vocnet.org/wnk/wk002689> a skos:Concept ;
    skos:altLabel "bond"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002680> ;
    skos:definition "Ein Blockverband ist ein Mauerverband, bei dem Binderschichten und Läuferschichten regelmäßig wechseln."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Blockverband"@de,
        "block bond"@en .

<http://lvr.vocnet.org/wnk/wk002690> a skos:Concept ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002680> ;
    skos:definition "Ein Kreuzverband ist ein Mauerverband, bei dem Binderschichten und Läuferschichten regelmäßig wechseln. "@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Kreuzverband"@de,
        "cross bracing"@en .

<http://lvr.vocnet.org/wnk/wk002691> a skos:Concept ;
    skos:altLabel "Mönchsverband"@de,
        "Polnischer Verband"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002680> ;
    skos:definition "Ein Gotischer Verband ist ein Mauerverband, der aus Schichten besteht, in denen auf zwei Läufer ein Binder folgt."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Gotischer Verband"@de,
        "Gothic bond"@en .

<http://lvr.vocnet.org/wnk/wk002692> a skos:Concept ;
    skos:altLabel "Schlesischer Verband"@de,
        "Wendischer Verband"@de,
        "Yorkshire bond"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002680> ;
    skos:definition "Ein Märkischer Verband ist ein Mauerverband, bei dem sich in jeder Schicht zwei Läufer und ein Binder abwechseln. "@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Märkischer Verband"@de,
        "flying bond"@en .

<http://lvr.vocnet.org/wnk/wk002693> a skos:Concept ;
    skos:altLabel "Holländischer Mauerwerksverband"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002680> ;
    skos:definition "Ein Holländischer Verband ist ein Mauerverband, bei dem auf eine Binderschicht eine Schicht aus einander abwechselnden Bindern und Läufern folgt."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Holländischer Verband"@de,
        "cross bond"@en .

<http://lvr.vocnet.org/wnk/wk002694> a skos:Concept ;
    skos:altLabel "Burgverband"@de,
        "Festungsverband"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002680> ;
    skos:definition "Ein Stromverband ist ein Mauerverband, der als Blockverband oder Kreuzverband hergestellt sein kann und bei dem die Ziegel in der Regel waagerecht und lotrecht vermauert werden. Damit soll bei dicken Mauern im Brückenbau und im Festungsbau eine größere Festigkeit erzielt werden."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Stromverband"@de .

<http://lvr.vocnet.org/wnk/wk002695> a skos:Concept ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002680> ;
    skos:definition "Ein Figurierter Verband ist ein Mauerverband, der lediglich ornamental ist und keine konstruktive Funktion hat."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Figurierter Verband"@de,
        "ridge"@en .

<http://lvr.vocnet.org/wnk/wk002696> a skos:Concept ;
    skos:altLabel "brick-on-end course"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002680> ;
    skos:definition "Eine Rollschicht ist der Bestandteil eines Mauerverbandes, bei dem die Steine als Binder hochkant angeordnet sind und der vor allem als oberste Schicht, etwa als Mauerkrone oder Fensterbank, verwendet wird."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Rollschicht"@de,
        "rowlock"@en .

<http://lvr.vocnet.org/wnk/wk002697> a skos:Concept ;
    skos:broader <http://lvr.vocnet.org/wnk/wk002680> ;
    skos:definition "Ein Sägeverband ist ein Mauerverband, bei dem die Steine einer Schicht als hochkant gestellte Binder um etwa 45° gegenüber der Mauerflucht verdreht eingebaut werden, sodass in der Ansicht eine Fries in Form von Sägezähnen entsteht."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Sägeverband"@de .

