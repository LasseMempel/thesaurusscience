		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk008740"/>
		<skos:definition xml:lang="de">Ein Spachtel ist ein Gerät, das ein flaches breites Blatt hat, welches in einem Handgriff steckt. Er dient zum Aufbringen und Glätten dickflüssiger Massen, kann aber auch zum Abkratzen dieser genutzt werden.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300024836"/>
