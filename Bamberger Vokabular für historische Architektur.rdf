        <skos:altLabel xml:lang="en"> rotunda</skos:altLabel>
        <skos:definition xml:lang="de">Kirche mit kreisförmigem Grundriss, oft mit Umgang. Hauptsächl. in Dänemark (Bornholm) und Schweden (Gotland) vorkommend. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Kirchenbau über kreisrundem oder polygonalem Grundriss. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Kostel s kruhovým nebo polygonálním půdorysem. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="it"> chiesa rotonda</skos:prefLabel>
        <skos:prefLabel xml:lang="es"> iglesia circular</skos:prefLabel>
        <skos:prefLabel xml:lang="en"> round church</skos:prefLabel>
        <skos:prefLabel xml:lang="fr"> église ronde (église circulaire)</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Rundkirche</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">centrální kostel</skos:prefLabel>
    </owl:NamedIndividual>
    


