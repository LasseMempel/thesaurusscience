    <skos:scopeNote xml:lang="en">An early form of railway for the transportation of freight by sleds.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91156">
    <skos:scopeNote xml:lang="en">A small timber one-roomed dwelling where holiday makers could rest after a day spent sunbathing, swimming and playing on the beach.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87488">
    <skos:scopeNote xml:lang="en">A large store where wool is stored.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91984">
    <skos:scopeNote xml:lang="en">A bridge for carrying a road or railway over another.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69364">
    <skos:scopeNote xml:lang="en">A building housing a turbine.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164126">
    <skos:scopeNote xml:lang="en">A flour mill which uses one or more pairs of horizontal millstones to grind wheat into flour which millers call a ï¿½sudden deathï¿½ process; within not more than 90 seconds complete wheat grain becomes wholemeal flour.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68819">
