        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T16:33:10.000</terms:modified>
        <skos:altLabel xml:lang="cs">slepé dveře</skos:altLabel>
        <skos:altLabel xml:lang="cs">zdánlivé dveře</skos:altLabel>
        <skos:definition xml:lang="de">Eine Blendtür im letzten Raum einer Mastaba, meist mit der Statue des Toten geschmückt. Hinter der S. führt ein Schacht in die eigentl. Grabkammer. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Scheintür</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">falešné dveře</skos:prefLabel>
        <skos:prefLabel xml:lang="en">false door</skos:prefLabel>
        <skos:prefLabel xml:lang="it">fausse porte</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">porte feinte</skos:prefLabel>
        <skos:prefLabel xml:lang="es">puerta falsa</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_0c2a3183 -->


