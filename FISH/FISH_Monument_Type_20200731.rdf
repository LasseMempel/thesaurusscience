      </skos:ConceptScheme>
    </skos:inScheme>
    <dcterms:publisher rdf:resource="http://www.historicengland.org.uk"/>
    <skos:prefLabel xml:lang="en">Horse Isolation Hospital</skos:prefLabel>
    <dcterms:identifier>http://purl.org/heritagedata/schemes/eh_tmt2/concepts/166981</dcterms:identifier>
    <cc:attributionURL rdf:resource="http://www.historicengland.org.uk"/>
    <cc:license rdf:resource="http://creativecommons.org/licenses/by/3.0"/>
  </skos:Concept>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71527">
    <skos:scopeNote xml:lang="en">A building or room for the distribution of medicines, eg. in a hospital or clinic.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68891">
    <skos:scopeNote xml:lang="en">A building in which a supply of arms, ammunition and provisions for an army is stored.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69659">
    <skos:scopeNote xml:lang="en">A structure used to show the time of day by means of the sun shining on a 'gnomon', the shadow of which falls on the surface of the dial which is marked with a diagram showing the hours. Can be freestanding, usually on a pillar, or fixed to a building.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91854">
    <skos:scopeNote xml:lang="en">A low-temperature oven for the firing of metallic-based colour onto pottery after glazing.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68846">
    <skos:scopeNote xml:lang="en">A temporary castle built to house and protect troops beseiging another castle or town.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92516">
    <skos:scopeNote xml:lang="en">A mill used to process logwood, the inner red wood of a South American tree used widely in dyeing. Imported in the form of logs and cut and ground into dye by a mechanical process.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140195">
    <skos:scopeNote xml:lang="en">A wall structure built to direct a current into the desired channel in a harbour, river etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70362">
    <skos:scopeNote xml:lang="en">An area of land enclosed by two parallel ditches. Use with specific shaped enclosure where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71718">
    <skos:scopeNote xml:lang="en">A shop where fish is sold.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92928">
    <skos:scopeNote xml:lang="en">Bridge for carrying pipes between buildings or working areas.</skos:scopeNote>
  </rdf:Description>
  <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/169911">
    <dcterms:publisher rdf:resource="http://www.historicengland.org.uk"/>
    <cc:license rdf:resource="http://creativecommons.org/licenses/by/3.0"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-17T14:18:30</dcterms:issued>
    <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2"/>
    <skos:prefLabel xml:lang="en">Holiday Accommodation</skos:prefLabel>
    <dcterms:identifier>http://purl.org/heritagedata/schemes/eh_tmt2/concepts/169911</dcterms:identifier>
    <cc:attributionURL rdf:resource="http://www.historicengland.org.uk"/>
    <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
  </skos:Concept>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69655">
    <skos:scopeNote xml:lang="en">Fixed instrument to measure altitude of stars and planets.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69023">
    <skos:scopeNote xml:lang="en">A dry ditch or sunken fence which divided the formal garden from the landscaped park without interrupting the view.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/83544">
    <skos:scopeNote xml:lang="en">An outlying farm or estate belonging to the Order of Tiron.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68713">
    <skos:scopeNote xml:lang="en">An institution, sometimes attached to a hospital, where patients may receive treatment or health checks.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/121267">
    <skos:scopeNote xml:lang="en">A place, where a corpse could be laid whilst being carried on its way to a burial, to allow the bearers to rest.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70034">
    <skos:scopeNote xml:lang="en">A form of inhumation in which the skeleton is laid out in an approximately straight line, whether face up, face down, or on its side.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68910">
    <skos:scopeNote xml:lang="en">Reinforced concrete blocks, walls or ditches designed to obstruct the progress of a tank or armoured vehicle.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70047">
    <skos:scopeNote xml:lang="en">A Neolithic burial monument comprising an approximately circular stony mound which contains a stone-built chamber, with or without additional lateral chambers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143511">
    <skos:scopeNote xml:lang="en">In the glass industry this is bench-like structure within the melting-furnace on which crucibles are placed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91028">
    <skos:scopeNote xml:lang="en">A sports pitch usually with a synthetic surface (ie. not grass).</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93201">
    <skos:scopeNote xml:lang="en">A building or site where boat sails are manufactured from processed cloth.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70343">
    <skos:scopeNote xml:lang="en">A building or room, purpose built for the teaching, rehearsing and playing of music.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91458">
    <skos:scopeNote xml:lang="en">A light, ornamental structure in a garden, park or place of recreation built in the Chinese style.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143427">
    <skos:scopeNote xml:lang="en">6 Type DFW 55373s placed in a 3X2 rectangular plan. Each projector was separated by 31-34m. Hardened personnel and ammunition shelters located midway between each projector, but ammunition stored outside the perimeter.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69192">
    <skos:scopeNote xml:lang="en">A furnace constructed as a shaft with the fire at the bottom and the fuel and ore added from the top.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91477">
    <skos:scopeNote xml:lang="en">A site where traditional public shows, in which the display of exotic animals, combined with feats of agility and comedy, were held.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70029">
    <skos:scopeNote xml:lang="en">Urn containing a cremation. Where component use with wider site type.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91148">
    <skos:scopeNote xml:lang="en">A fort with projecting bastions, which came into use from the 16th century onwards.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162634">
    <skos:scopeNote xml:lang="en">A farmstead, often of linear plan, where the working buildings are placed opposite and parallel to the house and attached working buildings with a relatively narrow space between.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69985">
    <skos:scopeNote xml:lang="en">A stone found on route to a churchyard on which the coffin is rested during transportation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162912">
    <skos:scopeNote xml:lang="en">A shallow artificial pond, usually found on the coast, in which sea water is allowed to evaporate leaving behind the salt.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91811">
    <skos:scopeNote xml:lang="en">A 17th century garden in the Dutch style: usually flat and compact, with an emphasis on small canals, hedges, topiary, lead statuary and flowering shrubs and bulbs.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70466">
    <skos:scopeNote xml:lang="en">Buildings, engineering constructions and machinery, used for the purpose of supplying a town, etc, with water distributed through pipes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69313">
    <skos:scopeNote xml:lang="en">A factory in which logs are converted to timber by running them through a series of saws.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68794">
    <skos:scopeNote xml:lang="en">A public house offering lodgings to the passengers, and stabling for the horses of stage coaches.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140334">
    <skos:scopeNote xml:lang="en">A component of a salt works housing iron pans where the brine was evaporated above a furnace and flue. Such houses were lightly built in order to allow the heat and steam to escape.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91082">
    <skos:scopeNote xml:lang="en">A training establishment for gunnery personnel.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/82827">
    <skos:scopeNote xml:lang="en">A decorative garden, often landscaped, laid out with intricate flower beds and hedges, and often containing ornate sculptures, fountains and garden ornaments.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/100006">
    <skos:scopeNote xml:lang="en">A works where cotton waste is stored or processed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78796">
    <skos:scopeNote xml:lang="en">A rescue station serving a number of mines in the immediate area.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140510">
    <skos:scopeNote xml:lang="en">A pillbox built to a design drawn up the chief engineer of Scottish Command</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99962">
    <skos:scopeNote xml:lang="en">Sites, buildings, structures &amp; features related to the practice of rituals &amp; religious beliefs, including funerary rites. Includes ancillary buildings, structures &amp; features of uncertain use, which are thought to be ï¿½ritualï¿½ (eg. hill figures).</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68604">
    <skos:scopeNote xml:lang="en">A Palaeolithic or Mesolithic temporary site where there is evidence to suggest animal butchery. Evidence may include animal remains and a specialized tool assemblage.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142867">
    <skos:scopeNote xml:lang="en">Sites, buildings and structures associated with the prevention of an invasion by a hostile force.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93159">
    <skos:scopeNote xml:lang="en">A factory for the manufacture of rocket motors, both for civil and military use.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/130913">
    <skos:scopeNote xml:lang="en">A building used specifically for testing the boilers of railway engines, both hydraulically and with live steam.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69334">
    <skos:scopeNote xml:lang="en">A type of windmill, mainly timber-framed, whose body, containing machinery and carrying the sail, rotates about an upright post.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71762">
    <skos:scopeNote xml:lang="en">A college associated with, or forming part of, a university.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91913">
    <skos:scopeNote xml:lang="en">An area of hardstanding to allow movement of farm transport in all weathers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/97277">
    <skos:scopeNote xml:lang="en">A building housing a generator.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93285">
    <skos:scopeNote xml:lang="en">Use for complexes where services (eg. restaurants, shops) are provided in addition to facilities for buying petrol.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68691">
    <skos:scopeNote xml:lang="en">An office or central station of a local telephone system where the various lines are brought to a central switchboard and communication between subscribers is achieved.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68965">
    <skos:scopeNote xml:lang="en">Levelled or terraced area of ground presumed to have been the site of a house or hut.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93392">
    <skos:scopeNote xml:lang="en">Buildings, sites and structures associated with sporting activities.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92145">
    <skos:scopeNote xml:lang="en">A shelter for the parson during the burial service.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93889">
    <skos:scopeNote xml:lang="en">A specially prepared track used for fast motorcycle racing.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140545">
    <skos:scopeNote xml:lang="en">A two storey building with a watch office on the ground floor and a control room above. Originally based on drawing number 12096/4.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68609">
    <skos:scopeNote xml:lang="en">A stone-lined pit in which seaweed was burnt. The calcined ashes were used in the manufacture of soap and glass, amongst other things.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/163017">
    <skos:scopeNote xml:lang="en">The main hall of worship within a Sikh Temple.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162649">
    <skos:scopeNote xml:lang="en">A building used for the storage of artillery pieces.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69126">
    <skos:scopeNote xml:lang="en">A building where fish are stored. Often taking the form of a single storey building with one room, but also may provide living accommodation for a fisherman above. Found mainly in the South West of England.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91629">
    <skos:scopeNote xml:lang="en">A processing house containing equipment for sieving caked gunpowder to produce graded granules.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69357">
    <skos:scopeNote xml:lang="en">Building containing transformers to reduce the high voltage of the National Grid to the lower voltage of domestic supply.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143500">
    <skos:scopeNote xml:lang="en">A tall, hollow pipe, usually cast-iron, resembling a lamp-post. Used to ventilate sewer systems.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93229">
    <skos:scopeNote xml:lang="en">A building used by labourers who clean and pump the docks, and in general, assist shipwrights.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/107313">
    <skos:scopeNote xml:lang="en">A building used for the safe storage and public display of jewellery, eg. the Jewel House at the Tower of London.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68784">
    <skos:scopeNote xml:lang="en">An establishment serving coffee and other refreshments and inexpensive foods. Between the 17th and 18th centuries they were also meeting places for political discussions.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71514">
    <skos:scopeNote xml:lang="en">A house in a terrace consisting of a double row of houses sharing a common back wall, characteristic of industrial cities in the North of England.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68652">
    <skos:scopeNote xml:lang="en">A stone wall, often of considerable length, built to divide an area of land. Most occur as part of extensive walled field systems. This is a regional term specific to Dartmoor and should not be used in other parts of the country.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68629">
    <skos:scopeNote xml:lang="en">Long parallel soil ridges in excess of 5 metres across separated by furrows, formed by using a heavy plough capable of turning the soil.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93698">
    <skos:scopeNote xml:lang="en">A garden devoted to the growth of vegetables.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93817">
    <skos:scopeNote xml:lang="en">Buildings, sites and structures associated with the production and use of wind power.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159237">
    <skos:scopeNote xml:lang="en">A factory manufacturing electrical cables.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/100514">
    <skos:scopeNote xml:lang="en">A firm beach or foreshore used for landing and loading of ships and other vessels. In more recent times hards have been reinforced with concrete.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71556">
    <skos:scopeNote xml:lang="en">A building for the manufacture of condensed milk.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140339">
    <skos:scopeNote xml:lang="en">A small dispersal WWII military aircraft hangar featuring an "A" shaped steel frame clad with corrugated iron; end doors were supported by outriggers when open.Typically used on aircraft storage units or satellite landing grounds. Variations in size.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92125">
    <skos:scopeNote xml:lang="en">An artificial mound of earth outside a ditch or wall intended to deflect or absorb cannon fire.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160303">
    <skos:scopeNote xml:lang="en">Blocks of solid concrete, in the form of cylinders usually 2 feet across x 2 feet 6 inches or 3 feet high. Cylinders were mainly used in road blocks intended to impede enemy movement in the event of invasion.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68621">
    <skos:scopeNote xml:lang="en">A tract of land, often including a farmhouse and ancillary buildings, used for the purpose of cultivation and the rearing of livestock, etc. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68757">
    <skos:scopeNote xml:lang="en">Sites, buildings, structures, features &amp; areas of land commemorating an historical event, person or animal.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68577">
    <skos:scopeNote xml:lang="en">A wall built to give shelter to sheep.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140061">
    <skos:scopeNote xml:lang="en">A site where cementstone nodules are extracted.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69079">
    <skos:scopeNote xml:lang="en">A site used for all the processes associated with the manufacture of roof, floor or decorative tiles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140437">
    <skos:scopeNote xml:lang="en">A short-term storage centre of goods or special parts to facilitate the rapid processing of orders and supply of goods to customers; unlike a warehouse, the emphasis is on the moving of goods rather than on a long-term storage.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/147250">
    <skos:scopeNote xml:lang="en">Block of flats within which the individual dwellings are accessed by narrow external balconies.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140255">
    <skos:scopeNote xml:lang="en">Medieval Fenland ditched field system where the land is divided into strips for agricultural production. The strips are separated by hand-dug wide shallow drainage ditches with the spoil thrown up to create a dryer ridge.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143489">
    <skos:scopeNote xml:lang="en">A well with a superstructure, either partially or wholly enclosed with an access door, designed to protect the water source.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87142">
    <skos:scopeNote xml:lang="en">A pit or emplacement surrounding a concrete pedestal, or 'thimble', which was used to mount a spigot mortar. Deployed by the Home Guard during WWII as an anti invasion measure.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70145">
    <skos:scopeNote xml:lang="en">A friary belonging to the Crutched Friars also known as Crosiers or Fratres.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93782">
    <skos:scopeNote xml:lang="en">A water pump situated at the side of a road or track for use by travellers and their animals.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94118">
    <skos:scopeNote xml:lang="en">An area of ground or water containing explosive mines.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69291">
    <skos:scopeNote xml:lang="en">A place where silverware is manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70943">
    <skos:scopeNote xml:lang="en">A house consisting of a public hall with private living accommodation attached. Built from the medieval period onwards.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92607">
    <skos:scopeNote xml:lang="en">A landing and taking-off area for military aircraft. Often includes ancilliary structures and buildings for the maintenance and storage of aircraft, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78174">
    <skos:scopeNote xml:lang="en">A zoo building containing artificial ponds or tanks in which aquatic plants and animals are kept alive for purposes of observation and study.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/126733">
    <skos:scopeNote xml:lang="en">A building used to coordinate movement of railway engines and rolling stock in the event of war.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68715">
    <skos:scopeNote xml:lang="en">A civic building housing fire engines and a permanent fire-fighting force.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91543">
    <skos:scopeNote xml:lang="en">A crane used for the refueling of coal-powered vessels.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71543">
    <skos:scopeNote xml:lang="en">The residence of a prison governor.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/90198">
    <skos:scopeNote xml:lang="en">A raised platform for the unloading of coal from waggons or other containers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91307">
    <skos:scopeNote xml:lang="en">A structure, often built undergound, used for defence and co-ordination of military activity.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71051">
    <skos:scopeNote xml:lang="en">A late 17th - early 18th century house with a central chimney and fireplaces and a central door on the front; this door opened closely against the fireplaces, leaving a small lobby for access to the rooms.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141280">
    <skos:scopeNote xml:lang="en">A depression in the ground caused by the impact of a falling object, such as a crashed aircraft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69221">
    <skos:scopeNote xml:lang="en">A site containing a forge for the manufacture of cutlery.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70297">
    <skos:scopeNote xml:lang="en">A supply of water used to keep canals that were vulnerable to water shortage topped up.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69288">
    <skos:scopeNote xml:lang="en">A place where boats or ships are built or repaired.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/139779">
    <skos:scopeNote xml:lang="en">A foreshore structure to prevent barges from sinking in the river mud. Made by placing chalk on fascines of brushwood, which is in some cases retained by a timber revetement.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92694">
    <skos:scopeNote xml:lang="en">An iron frame placed over a coffin or at the entrance to a grave to act as a deterrent against resurrectionists.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91320">
    <skos:scopeNote xml:lang="en">A building or workshop where fine furniture, often veneered, is made.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143269">
    <skos:scopeNote xml:lang="en">Gun emplacement for static or mobile light anti aircraft artillery.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71798">
    <skos:scopeNote xml:lang="en">A site where an army or body of troops is, temporarily or permanently, lodged, with or without entrenchments and fortifications.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69457">
    <skos:scopeNote xml:lang="en">A mole or pier-like structure situated at the entrance of a harbour, or running out into a lake or the sea, usually used for the landing of craft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94176">
    <skos:scopeNote xml:lang="en">The residence of a master shipwright.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68648">
    <skos:scopeNote xml:lang="en">An area of land consisting of the lord's demesne and of lands from whose holders he may exact certain fees, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140489">
    <skos:scopeNote xml:lang="en">A single-span aircraft hangar designed by Boulton &amp; Paul of London and Norwich (drawing number 4178/44). Mainly used on aircraft factory sites and at Armament Training Schools.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93647">
    <skos:scopeNote xml:lang="en">A plant used for the manufacture of tubes and tubing, from wrought iron or steel.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70162">
    <skos:scopeNote xml:lang="en">An abbey or priory of Savigniac monks. Order merged with Cistercians c1147.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/84110">
    <skos:scopeNote xml:lang="en">A garden containing trees or shrubs pruned and trained into various geometric, zoomorphic or fantastic shapes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160395">
    <skos:scopeNote xml:lang="en">A defensive battery positioned facing out to sea enabling the guns to be brought to bear on enemy shipping and amphibious craft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68547">
    <skos:scopeNote xml:lang="en">A building for the storage and processing of grain crops and for housing straw, farm equipment and occasionally livestock and their fodder. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71812">
    <skos:scopeNote xml:lang="en">An establishment where patients can rest and recover after an operation or illness.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159272">
    <skos:scopeNote xml:lang="en">A parterre consisting of an area of turf often with a pattern cut into it.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78244">
    <skos:scopeNote xml:lang="en">A building where masts are made and stored.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93309">
    <skos:scopeNote xml:lang="en">An open metalwork structure supporting either a fabrication shed or the runners for an overhead crane.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70248">
    <skos:scopeNote xml:lang="en">A tunnel running under a river or a hillside through which a railway line runs.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68760">
    <skos:scopeNote xml:lang="en">An inscribed marker stone found on Hadrian's Wall.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/97270">
    <skos:scopeNote xml:lang="en">An undefined structure used in the training of people in a certain skill.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71425">
    <skos:scopeNote xml:lang="en">A building where clothes are washed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/74785">
    <skos:scopeNote xml:lang="en">A place of worship for Calvinistic Methodists, Welsh Methodists who split from the established church in 1811.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92267">
    <skos:scopeNote xml:lang="en">A wheel which is turned by a horse in order to provide power. Used in mines, manufacturing and farming.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99566">
    <skos:scopeNote xml:lang="en">A building, factory or works which was engaged in the manufacture of refining saltpetre. Often part of a gunpowder works.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92139">
    <skos:scopeNote xml:lang="en">A large, luxuriously appointed hotel.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140171">
    <skos:scopeNote xml:lang="en">The earliest side-opening standard type of aircraft hangar designed in 1913 and used in WWI. Originally constructed from wooden trusses and struts, some examples have steel frames. It comprised a single or coupled shed with rear workshops.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92709">
    <skos:scopeNote xml:lang="en">An 18th century cottage with a pottery kiln attached.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/132473">
