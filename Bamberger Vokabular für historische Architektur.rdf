    <!-- https://hist-arch-vocab.org/bvha#c_1a9cfdf9 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_1a9cfdf9">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1d92b9c9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_cf792a3c"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-29T16:14:14.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T11:22:18.000</terms:modified>
        <skos:definition xml:lang="de">Die auch unter dem Titel „Das ungerechte Gericht“ bekannte Darstellung der Verurteilung Christi zeigt – abweichend von den biblischen Passionsberichten – eine Versammlung von zwanzig Mitgliedern des jüdischen Hohen Rates, darunter (meist in herausgehobener Position) den Hohepriester Kaiphas. Die Beratung findet in Anwesenheit des auf einem Thron sitzenden Pontius Pilatus statt. Zur Szene gehört ein Tisch mit (meist zwei) Schreibern. Der angeklagte Christus sitzt oder steht ihnen gegenüber. Oft sind Schrifttafeln mit den Voten der Ratsherren sowie weitere Texte, etwa ein Urteilsspruch des Pilatus, dem Bild beigefügt oder in dieses integriert. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="en">Christ before the High Council</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Gericht über Jesus Christus</skos:prefLabel>
        <skos:prefLabel xml:lang="it">processo di Gésu</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">procès de Jésus</skos:prefLabel>
    </owl:NamedIndividual>
    


