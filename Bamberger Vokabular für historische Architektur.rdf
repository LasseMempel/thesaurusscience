    <!-- https://hist-arch-vocab.org/bvha#c_c6915086 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_c6915086">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_8e49744f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_bb4af844"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-04T12:00:56.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-01T10:55:02.000</terms:modified>
        <skos:altLabel xml:lang="de">Togge</skos:altLabel>
        <skos:altLabel xml:lang="cs">panenka</skos:altLabel>
        <skos:definition xml:lang="de">Docke (von mhdt. tocke: Bündel, Knäuel, Walze), kurzes,gewelltes oder geschweiftes Säulchen mit rundem Querschnitt, durch Handgriff verbunden als Geländer oder Balustrade. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Kuželka, též panenka, 1. Jednotlivá podpěra balustrády. 2. Většinou figurálně vyřezávaný nástavec na bočnici kostelních nebo chórových lavic. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Togge (=Puppe); profiliertes, im Querschnitt rundes Holzsäulchen als Stütze einer Balustrade oder eines Geländers. Vgl. Baluster. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Docke</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kuželka</skos:prefLabel>
    </owl:NamedIndividual>
    


