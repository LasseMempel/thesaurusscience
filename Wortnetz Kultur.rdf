		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-06-16T12:41:53+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021335">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">2. Serie (Kambrium)</skos:altLabel>
		<skos:altLabel xml:lang="en">Cambrian Series 2</skos:altLabel>
		<skos:prefLabel xml:lang="en">Cambrian Series 2 Epoch</skos:prefLabel>
		<skos:altLabel xml:lang="de">Kambrium 2. Serie</skos:altLabel>
		<skos:altLabel xml:lang="de">Kambrium Serie 2</skos:altLabel>
		<skos:prefLabel xml:lang="de">Kambrium-Serie 2</skos:prefLabel>
		<skos:altLabel xml:lang="de">Serie 2 (Kambrium)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk001498"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk001498"/>
		<skos:definition xml:lang="de">Die Kambrium-Serie 2 ist eine Epoche des Kambriums, die vor etwa 521 Millionen Jahren begann und vor etwa 506,5 Millionen Jahren endete.</skos:definition>
		<skos:mappingRelation rdf:resource="http://resource.geolba.ac.at/GeologicTimeScale/41"/>
		<skos:mappingRelation rdf:resource="http://www.wikidata.org/entity/Q5025303"/>
