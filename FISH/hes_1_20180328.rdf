		<skos:prefLabel xml:lang="gd">STÈISEAN-SIOGNALAIDH NÈIBHIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far a bheil togalaichean is structaran a chleachdas an cabhlach airson siognaileadh is conaltradh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">NAVAL SIGNAL STATION</skos:prefLabel>
