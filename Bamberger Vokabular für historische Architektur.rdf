        <skos:definition xml:lang="de">Couronnement (frz.), Bogenfeld eines Maßwerks. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Couronnement</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_ff285590 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_ff285590">
