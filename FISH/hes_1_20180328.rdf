		<skos:prefLabel xml:lang="gd">CALLAID</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Mar is trice bidh seo na shreath de phreasan no craobhan beaga a chaidh an cur dlùth air a chèile airson 's gum bi iad nan crìoch eadar pìosan de thalamh no aig taobh rathaid.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HEDGE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-11T11:06:58</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-11T11:07:03</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1448" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1460" />
		<skos:scopeNote xml:lang="en">Usually a row of bushes or small trees planted closely together to form a boundary between pieces of land or at the sides of a road.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
