		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1431" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/504301">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/504301</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">COMHARRA MÌLE TOMHAISTE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Paidhir de phuist a tha nan comharran-stiùiridh 's air a bheilear a' coimhead orra rè seòlaidh gus aon cheann de mhìle thomhaiste cheart a shocrachadh (air cùrsa aithnichte) gus dèanadas longan a dhearbhadh an dèidh obair-thogail no obair-chàraidh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">MEASURED MILE MARKER</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-05-06T11:57:19</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-05-06T13:37:17</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:altLabel xml:lang="en">ADMIRALTY DISTANCE POLE</skos:altLabel>
				<skos:altLabel xml:lang="en">DISTANCE POLE</skos:altLabel>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1382" />
				<skos:scopeNote xml:lang="en">A pair of landmark posts intended to be viewed in transit to define one end of an accurately measured mile (on a known bearing) used to verify the performance of ships following construction or refit.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
