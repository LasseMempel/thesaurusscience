        <skos:prefLabel xml:lang="it">abside del transetto</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">apside de transept</skos:prefLabel>
        <skos:prefLabel xml:lang="en">transept apse</skos:prefLabel>
        <skos:prefLabel xml:lang="es">ábside de crucero</skos:prefLabel>
    </owl:NamedIndividual>
    


