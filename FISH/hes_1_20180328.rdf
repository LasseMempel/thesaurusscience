	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/636">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/636</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">OSPADAL</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach no aitreabh far am faigh daoine a tha tinn, seann-daoine 's na bochd cùram is leigheasadh. Cleachd briathar nas mionaidiche ma ghabhas sin a dhèanamh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HOSPITAL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/624" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/637">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/637</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">OSPADAL CLOINNE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Ospadal sònraichte a bheir seachad leigheas is obair-lannsa dhan chlann.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">CHILDRENS HOSPITAL</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/636" />
				<skos:scopeNote xml:lang="en">A specialist hospital for the medical and surgical treatment of children.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500649" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/503624">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/503624</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">UÀRD OSPADAIL</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Seòmar mòr, coltach ri suain-lann, am broinn ospadail a chleachdar mar àite-fuirich sealach no buan do dh'euslaintich a tha a' feitheamh ri obair-lannsa no aig an robh obair-lannsa 's a tha ag ath-shlànachadh no daoine a tha a' faighinn leigheasadh fada.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">HOSPITAL WARD</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-25T16:22:32</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-25T16:22:48</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/636" />
				<skos:scopeNote xml:lang="en">A large room, similar to a dormitory, within a hospital, and used for the temporary or permanent accommodation of patients, either waiting for or recovering from operations or undergoing long term treatment.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
