        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-11-26T13:58:04.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-12T17:39:46.000</terms:modified>
        <skos:prefLabel xml:lang="de">Bundachse</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Die durch Längs- oder Querbund vorgegebene Achse im Holzgerüstbau. [BVHA]</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_8e9f3fc3 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_8e9f3fc3">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
