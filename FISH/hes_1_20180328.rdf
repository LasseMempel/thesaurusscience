		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1852" />
		<skos:scopeNote xml:lang="en">A system of interconnected roads and bridges, designed to connect efficiently two or more motorways and other roads.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
