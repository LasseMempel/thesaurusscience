	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/176">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/176</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BALLAN-STIALLACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Frèam fiodha sa bheil tuill a chaidh ceann is làmhan eucoirich a chur tromhpa 's càch a' magadh 's a' toirt ionnsaigh orra.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PILLORY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">JOUGS</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/171" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/177" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/178" />
		<skos:scopeNote xml:lang="en">A wooden frame with holes, through which the head and hands of an offender were thrust, in which state they would be exposed to public ridicule and assault.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
