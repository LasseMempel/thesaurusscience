        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T16:27:38.000</terms:modified>
        <skos:definition xml:lang="de">Abtrennung von scharfen, schlanken Gestein - stücken, abgespalten oder abgebrochen vom Hauptbestandteil des Hauptgesteinskörpers. [ICOMOS-ISCS] </skos:definition>
        <skos:definition xml:lang="en">Detachment of sharp, slender pieces of stone,split or broken off from the main body. [ICSOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="fr">Fracturation en un ou plusieursfragments de forme allongée aux arêtes vives. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="cs">Oddělení ostrých, štíhlých kousků kamene odštípnutím nebo odlomením od hlavního kusu kamene. [ICOMOS-ISCS] </skos:definition>
        <skos:prefLabel xml:lang="de">Abscherben</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">fragmentation en esquilles</skos:prefLabel>
        <skos:prefLabel xml:lang="en">splintering</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">tříštění</skos:prefLabel>
    </owl:NamedIndividual>
    


