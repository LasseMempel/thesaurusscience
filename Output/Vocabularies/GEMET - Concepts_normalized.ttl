    skos:closeMatch <http://data.uba.de/umt/_00011516> ;
    skos:definition "The act or process of buying, selling, or exchanging commodities, at either wholesale or retail, within a country or between countries."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Gewerbe"@de,
        "trade (profession)"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Trade_%28occupation%29> .

<http://www.eionet.europa.eu/gemet/concept/8576> a skos:Concept ;
