    <skos:scopeNote xml:lang="en">An ancillary building in a factory or other industrial complex where manufactured goods are packaged.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/139026">
