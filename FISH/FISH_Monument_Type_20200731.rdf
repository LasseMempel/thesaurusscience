  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68608">
    <skos:scopeNote xml:lang="en">Position often screened by earth, stone or wood from which game is shot.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69468">
    <skos:scopeNote xml:lang="en">A structure inclined towards the water on which a ship may be built or lowered into the water.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93536">
    <skos:scopeNote xml:lang="en">A building within a transport terminal, often associated with the registration and clearing of incoming and outgoing passengers or freight.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/100207">
    <skos:scopeNote xml:lang="en">A hospital where people would pay a subscription in order to recieve treatment when ill.</skos:scopeNote>
  </rdf:Description>
