    <!-- https://hist-arch-vocab.org/bvha#c_0709039d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_0709039d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_18b9aa69"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
