    <skos:scopeNote xml:lang="en">A non-vertical kiln where the shaft and burning zone is horizontal to the ground thereby allowing material to be fed in.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68546">
    <skos:scopeNote xml:lang="en">A small outlying farm building, especially common in southern England, used to store ash (which was used as a fertilizer).</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143369">
    <skos:scopeNote xml:lang="en">Buildings and structures used to monitor the accuracy of bombs dropped on a bombing range</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69305">
    <skos:scopeNote xml:lang="en">A mill manufacturing bobbins for the textile industry.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69227">
    <skos:scopeNote xml:lang="en">A building used for the decarburizing of pig iron to produce wrought iron.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141448">
    <skos:scopeNote xml:lang="en">A functioning clock designed to serve also as an ornamental feature or sculpture.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92314">
    <skos:scopeNote xml:lang="en">An enclosed area of parkland used almost exclusively for the hunting of deer.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78168">
    <skos:scopeNote xml:lang="en">A building where reptiles are accommodated at a zoo or wildlife park.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92617">
    <skos:scopeNote xml:lang="en">A hospital for the medical and surgical treatment of military personnel and/or their families.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/152567">
    <skos:scopeNote xml:lang="en">A temporary settlement or encampment erected by construction workers (eg for reservoir construction).</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170091">
    <skos:scopeNote xml:lang="en">Areas of land that have been designated as national property where habitation and commercial activities are restricted to preserve their outstanding landscapes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70196">
    <skos:scopeNote xml:lang="en">Use for places of worship. For later landscape features use, eg. GARDEN TEMPLE.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91553">
    <skos:scopeNote xml:lang="en">A kiln used to reduce the shells of shellfish to calcium carbonate.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141915">
    <skos:scopeNote xml:lang="en">A pit in which lye is used to clean hides/bones/etc. generally as part of the tanning process to remove excess fat, flesh, hair, etc. from the raw hide.  The residue from these pits formed a crude soap which could be used for various cleaning purposes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92014">
    <skos:scopeNote xml:lang="en">Any church which bears signs of fortification. Churches on the Welsh and Scottish borders were often fortified, only allowing access to the tower from a single opening in the nave.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92955">
    <skos:scopeNote xml:lang="en">A building providing lodgings for police constables.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164196">
    <skos:scopeNote xml:lang="en">A processed used to increase the thickness of the natural oxide layer on the surface of metal parts. The part being treated forms the anode of an electrolytic cell.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92662">
    <skos:scopeNote xml:lang="en">A type of stock exchange for tin which replaced the stannary courts in the mid 19th century.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/169404">
    <skos:scopeNote xml:lang="en">A site where Celestine or Celestite (a SrSO4), originally used in sugar beet refinement, is extracted from an open cast mine.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92813">
    <skos:scopeNote xml:lang="en">The residence of a storekeeper of naval ordnance.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93435">
    <skos:scopeNote xml:lang="en">A distilling or brewing house.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70232">
    <skos:scopeNote xml:lang="en">A structure consisting of a box or platform for carrying goods or passengers from one level to another. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78870">
    <skos:scopeNote xml:lang="en">A pile of rough stones and soil used for the growing of ferns and other plants.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69381">
    <skos:scopeNote xml:lang="en">A mechanical structure, consisting of a roller or beam on supports, round which a rope or chain is wound, and used for various purposes, eg. raising a bucket from a well, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94174">
    <skos:scopeNote xml:lang="en">A building where mineral jelly was stored. Mineral jelly was used as a stabilizer in the manufacture of the explosive, cordite.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70048">
    <skos:scopeNote xml:lang="en">A rectangular or trapezoidal non-megalithic stony mound of Neolithic date, with human remains in cists rather than a large chamber. Mound construction and associated features vary considerably in type and complexity.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68793">
    <skos:scopeNote xml:lang="en">A public house for the lodging and entertainment of travellers, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/103232">
    <skos:scopeNote xml:lang="en">A large room, similar to a dormitory, within a hospital, and used for the temporary or permanent accommodation of patients, either waiting for or recovering from operations or undergoing long term treatment.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93287">
    <skos:scopeNote xml:lang="en">A residential establishment for retired armed servicemen and women.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170053">
    <skos:scopeNote xml:lang="en">A step or ramp in the bank of a canal to enable horses to climb out of the water.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140555">
    <skos:scopeNote xml:lang="en">A two-storey watch office, built to Air Ministry drawing number 1959/34. It became the standard design for watch offices with a large, almost square, ground plan with a central observation tower.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92950">
    <skos:scopeNote xml:lang="en">A field or piece of ground used for the playing of games and other activities.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92830">
    <skos:scopeNote xml:lang="en">A hospital department for the medical and surgical treatment of teeth disorders.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162796">
    <skos:scopeNote xml:lang="en">A building or site used as a storage and distribution centre.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142964">
    <skos:scopeNote xml:lang="en">A construction trench dug to receive a line of posts for a wall, with associated packing.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92754">
    <skos:scopeNote xml:lang="en">A works or factory where nitroglycerine is manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70057">
    <skos:scopeNote xml:lang="en">A cemetery of later prehistoric date comprising exclusively cremated human remains, some or all of which may be contained within pottery vessels. The cemetery area is partly or wholly surrounded by an earthwork bank and/or ditch.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164079">
    <skos:scopeNote xml:lang="en">Site for the disposal of unexploded ordnance, possibly attached to a bombing range.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71595">
    <skos:scopeNote xml:lang="en">A steam whistle or siren used for signalling purposes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/104113">
    <skos:scopeNote xml:lang="en">A type of prefabricated house erected, to 11 approved designs, as part of the Temporary Housing Programme, between 1944 and 1948. This scheme was devised to relieve the post-war housing shortage at a time when conventional materials were unavailable.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71442">
    <skos:scopeNote xml:lang="en">An open-sided building known to have been used for sheltering animals other than cattle.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71758">
    <skos:scopeNote xml:lang="en">A building used for the storage of fish.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160417">
    <skos:scopeNote xml:lang="en">A trench cut around a building or structure to prevent the spread of fire.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/82821">
    <skos:scopeNote xml:lang="en">A piece of land, sometimes man-made, completely surrounded by water.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93561">
    <skos:scopeNote xml:lang="en">A basin or harbour, which is open to the tides. Vessels can only enter and leave at high tide and are stranded at low tide.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93699">
    <skos:scopeNote xml:lang="en">Sites associated with the manufacture and engineering of vehicles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71587">
    <skos:scopeNote xml:lang="en">A piece of ice or a floor, often within a building, used for skating.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70031">
    <skos:scopeNote xml:lang="en">An interment of unburnt, articulated human remains. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78215">
    <skos:scopeNote xml:lang="en">A place where osiers (willows) are grown for basket-making.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70042">
    <skos:scopeNote xml:lang="en">A built structure, generally below ground, designed for the interment of several burials over a period of time. Usually constructed with a door or sealed entrance to allow reopening for further burials.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94020">
    <skos:scopeNote xml:lang="en">A pit alignment accompanied by a linear bank (or banks) running parallel and adjacent to the line(s) of pits.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71743">
    <skos:scopeNote xml:lang="en">A building where an officer of a county, district or municipality acting as a representative of the Crown holds inquests, including deaths through violence or accident and treasure trove.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92392">
    <skos:scopeNote xml:lang="en">A crane with a projecting arm, usually one that can be raised and lowered.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68871">
    <skos:scopeNote xml:lang="en">A small enclosure built onto the perimeter of a Roman fortress or fort.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93293">
    <skos:scopeNote xml:lang="en">A vertical structure, sometimes made of steel, often used in the manufacture of cement. Material is loaded at the top, burnt in the middle and removed at the bottom.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68981">
    <skos:scopeNote xml:lang="en">A settlement showing evidence for one or more hut circles, enclosed by a distinct boundary ditch, wall, earth rampart or similar barrier. Characteristic of the later prehistoric period.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70311">
    <skos:scopeNote xml:lang="en">Use for free standing column.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68703">
    <skos:scopeNote xml:lang="en">A group of colleges and associated buildings belonging to a university.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143199">
    <skos:scopeNote xml:lang="en">A building containing soft play equipment for children.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92908">
    <skos:scopeNote xml:lang="en">A factory where pianos are manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91003">
    <skos:scopeNote xml:lang="en">Small engineering works specialising in the production of items such as ploughs and threshing machinery.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160247">
    <skos:scopeNote xml:lang="en">A stand by set house similar to 13244/41 and designed to drawing number 16302/41 and comprising of 4 rooms; a fuel storage room, a transformer chamber, a switchgear chamber and the main engine room with 3 diesel engines.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69336">
    <skos:scopeNote xml:lang="en">A windmill with a rotating cap containing the windshaft, and a stationary body in the form of a tower.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92043">
    <skos:scopeNote xml:lang="en">An indoor or outdoor market where fruit and vegetables are sold.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/146326">
    <skos:scopeNote xml:lang="en">1st World War end-opening aeroplane hangar.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71805">
    <skos:scopeNote xml:lang="en">A farm on the estate of a manor.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93739">
    <skos:scopeNote xml:lang="en">A substantial monument attached to a wall and often standing on the floor.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/108233">
    <skos:scopeNote xml:lang="en">A purpose built pit, usually below a gatehouse or barbican, into which the counterweight of a drawbridge could be lowered, thus enabling the bridge to be raised.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/145080">
    <skos:scopeNote xml:lang="en">An establishment where alcoholic and non alcoholic drinks are served, food may also be served. May be a an individual room within a larger multi purpose building such as a sports pavilion or a theatre.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70263">
    <skos:scopeNote xml:lang="en">A block for mounting a horse.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93224">
    <skos:scopeNote xml:lang="en">A place of worship for Sandemanians, a movement founded by John Glass after his expulsion from the Church of Scotland in 1728. It was spread to England by his son-in-law, Robert Sandeman.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68573">
    <skos:scopeNote xml:lang="en">A place where beehives are kept.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140542">
    <skos:scopeNote xml:lang="en">A fighter satellite station watch office built to Air Ministry design drawing number 17658/40.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69389">
    <skos:scopeNote xml:lang="en">A site where rough stone is processed, shaped, worked or formed into finished products.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91509">
    <skos:scopeNote xml:lang="en">A place where processed cloth is cut for use as garments or soft furnishings, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99578">
    <skos:scopeNote xml:lang="en">A factory or works principally engaged in the production of a single base propellant, using nitrocellulose without the addition of nitroglycerine.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68966">
    <skos:scopeNote xml:lang="en">A hut used by a person who makes items from wood. Often found in a woodland setting.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/139645">
    <skos:scopeNote xml:lang="en">A route across a river, or lake. Use only for small inland ferries and index with LANDING POINT/STAGE/STEPS or PIER where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160369">
    <skos:scopeNote xml:lang="en">A building which has been altered to increase its defensive characteristics. Use more specific term where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/145016">
    <skos:scopeNote xml:lang="en">A building or part of a building used specifically to store items of hardware and ironmongery.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/144466">
    <skos:scopeNote xml:lang="en">A bridge used for carrying liquids, usually water, although sometimes oil, in a pipeline over a river. Mid 19th century onwards.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92700">
    <skos:scopeNote xml:lang="en">A building or room where motor vehicles are exhibited for sale.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69211">
    <skos:scopeNote xml:lang="en">A place where boats are built and stored.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70208">
    <skos:scopeNote xml:lang="en">An aircraft, either whole or in part. Aircraft often survive as commemorative monuments, gate guardians or crash sites.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87509">
    <skos:scopeNote xml:lang="en">Shed for grinding rags, eg. for use in mungo and shoddy mills.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69944">
    <skos:scopeNote xml:lang="en">The principal stand at a sporting ground, eg. at a racecourse.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91243">
    <skos:scopeNote xml:lang="en">An institution for the imprisonment and training of 16-21 year olds first established officially in 1908. Replaced by Youth Custody Centres in 1982.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70455">
    <skos:scopeNote xml:lang="en">A room or building where a pump is worked.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91617">
    <skos:scopeNote xml:lang="en">A camp kitchen, usually associated with the military.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/146387">
    <skos:scopeNote xml:lang="en">A purpose built apparatus for the testing of helicopters.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70299">
    <skos:scopeNote xml:lang="en">A tunnel with a canal running through it.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91919">
    <skos:scopeNote xml:lang="en">A group of buildings, or part of a works, housing apparatus used in the process of fermentation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/121268">
    <skos:scopeNote xml:lang="en">A road, used traditionally for the transportation of a corpse to a place of burial.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69065">
    <skos:scopeNote xml:lang="en">A mill used for the production of mortar; a combination of sand, lime and water, used to make the joints between courses of bricks in buildings. In more recent times cement has replaced lime to create a quicker drying mortar.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91516">
    <skos:scopeNote xml:lang="en">A workshop for the manufacture of clothing, eg. tailor's workshop.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69361">
    <skos:scopeNote xml:lang="en">A simple wind-driven machine used for a variety of purposes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69994">
    <skos:scopeNote xml:lang="en">A stone with a cross carved into the surface.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71504">
    <skos:scopeNote xml:lang="en">A place of worship within the grounds of a cemetery.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68553">
    <skos:scopeNote xml:lang="en">A building, or part of a building, for the milling and pressing of cider apples to produce cider (or pears for perry) and for storing the drink in barrels.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140084">
    <skos:scopeNote xml:lang="en">An area off the coast where ships anchor.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160527">
    <skos:scopeNote xml:lang="en">A building or site used for the storage and distribution of the essential logistical requirements of an armed force.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71614">
    <skos:scopeNote xml:lang="en">A building offering accommodation to people who are visiting a town or locality renowned for its mineral springs.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71373">
    <skos:scopeNote xml:lang="en">A narrow bridge for people and animals to cross on foot.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68753">
    <skos:scopeNote xml:lang="en">A town for citizens of Roman or Latin status with a constitution governed by charter, which if possessing only Latin rights could be promoted to the status of a colonia.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69306">
    <skos:scopeNote xml:lang="en">A factory where buttons are manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68811">
    <skos:scopeNote xml:lang="en">An oval or circular structure with seats rising in tiers around a central open space. Used for religious ceremonies, entertainment, training and armed combat contests.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70176">
    <skos:scopeNote xml:lang="en">The residence of a preceptor, officials and servants, etc, supervising the estates of the Knights Templars military order. Includes the mother house styled the Temple, London. The Order was suppressed in 1312.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69340">
    <skos:scopeNote xml:lang="en">The channel of water that provides a current of water to drive a millwheel.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68716">
    <skos:scopeNote xml:lang="en">An establishment providing medical or surgical treatment for the ill or wounded. Use narrower term where possible.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69255">
    <skos:scopeNote xml:lang="en">Where several minerals produced, use with other products and MINE, eg. ARSENIC MINE.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140156">
    <skos:scopeNote xml:lang="en">A camp where people who fled from danger or problem whithin their country or across international borders and who are in need of international protection are temporarily placed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143374">
    <skos:scopeNote xml:lang="en">Site or building constructed or adapted for indoor and/or outdoor leisure and sport activities, for example archery, team-building and "outward-bound" activities based on military training.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68555">
    <skos:scopeNote xml:lang="en">A mill for grinding corn. Use with power type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68825">
    <skos:scopeNote xml:lang="en">A site containing one or more artillery pieces and/or rocket launchers for firing at enemy aircraft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160339">
    <skos:scopeNote xml:lang="en">A defensive position, often constructed from sandbags, designed to protect a group of infantry.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/129573">
    <skos:scopeNote xml:lang="en">A large tank used for training divers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69191">
    <skos:scopeNote xml:lang="en">A furnace in which the flame is turned back over the substance to be heated.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99579">
    <skos:scopeNote xml:lang="en">A factory or works principally engaged in the manufacture of the mining explosive sabulite.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91168">
    <skos:scopeNote xml:lang="en">A building where beer was sold or displayed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92204">
    <skos:scopeNote xml:lang="en">A shop selling ironmonger's goods, household tools and utensils.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/145088">
    <skos:scopeNote xml:lang="en">An building, often including recreational facilities, provided for the relaxation of serving Royal Air Force Personnel.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91717">
    <skos:scopeNote xml:lang="en">A building in which a view is projected onto a wall by means of a lens.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68951">
    <skos:scopeNote xml:lang="en">An area of ground on which a house is built. A platform is often the sole surviving evidence for a house.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69903">
    <skos:scopeNote xml:lang="en">A large, decorative garden ornament resembling a vase.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170770">
    <skos:scopeNote xml:lang="en">A pit dug to extract Sarsen stones from the superficial geology in which they occur. They range in size from one dug for the extraction of a single boulder to pits from which multiple boulders are extracted &amp; date from the Neolitic to the mid 20th century</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162577">
    <skos:scopeNote xml:lang="en">Cubicles for housing rams, resembling pigsties with their own yard but slightly larger.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69397">
    <skos:scopeNote xml:lang="en">Place where tanned leather is dressed and coloured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167358">
    <skos:scopeNote xml:lang="en">A factory manufacturing fireplaces.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/136990">
    <skos:scopeNote xml:lang="en">An artificial pond or pool constructed for the purpose of watering  livestock, particularly in prehistory.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143957">
    <skos:scopeNote xml:lang="en">Works for the extrusion of aluminium and for creating aluminium products.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68830">
    <skos:scopeNote xml:lang="en">A mound or structure on which an archery, musketry or artillery target is erected. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93713">
    <skos:scopeNote xml:lang="en">A meeting hall of the verderers, who were the officers appointed to maintain the King's forests.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91852">
    <skos:scopeNote xml:lang="en">Use for blocks in Emergency Medical Scheme hospitals (WWII).</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92789">
    <skos:scopeNote xml:lang="en">An underground structure for the storage of mineral oil.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/121255">
    <skos:scopeNote xml:lang="en">A canal tunnel built with one or more integral towpaths</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/88200">
    <skos:scopeNote xml:lang="en">An engineering workshop, often attached to an engine shed, for the running repairs of operational parts, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70159">
    <skos:scopeNote xml:lang="en">An abbey or priory of Gilbertine monks.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94349">
    <skos:scopeNote xml:lang="en">Sites, buildings and structures for the control and mounting of anti aircraft artillery. Also, structures for passive or indirect defence against enemy aircraft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69311">
    <skos:scopeNote xml:lang="en">A factory where jute (plant fibres), was used to make products such as hessian, sacking, cordage and backing materials for carpet and linoleum.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167848">
    <skos:scopeNote xml:lang="en">Feature, typically a ship, boat, aircraft or vehicle, deliberately sunk for recreational and diver educational purposes in inland bodies of water used as dive centres, such as lakes and water-filled quarries, or offshore as artificial reefs.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162552">
    <skos:scopeNote xml:lang="en">A hut used for the accommodation of members of the armed forces.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/152526">
    <skos:scopeNote xml:lang="en">A mine used for the extraction of any hard dark-coloured rock.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140530">
    <skos:scopeNote xml:lang="en">A pillbox design, assigned a drawing number by DFW branch 3. Although originally believed to be a distinct type, FW3/45 has recently been found to be a design for modifications to existing types. Double index with specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69112">
    <skos:scopeNote xml:lang="en">A ravine formed by using water to reveal or exploit a vein.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159180">
    <skos:scopeNote xml:lang="en">A path, or marked lane, designated for use by cyclists.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/144619">
    <skos:scopeNote xml:lang="en">Place where ships and boats are dismantled.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159287">
    <skos:scopeNote xml:lang="en">A garden featrue where several allees radiate from a single point (usually the house). French for 'Goose Foot'</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/144599">
    <skos:scopeNote xml:lang="en">A supported, roof structure covering all, or part, of a railway platform.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91561">
    <skos:scopeNote xml:lang="en">A formal garden consisting of lawns, walks and borders belonging to a college or university, eg. Oxford or Cambridge.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/97263">
    <skos:scopeNote xml:lang="en">A protective structure, often made of sandbags with reinforcement, designed to protect aircraft at airfields from enemy attack.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92328">
    <skos:scopeNote xml:lang="en">A tippler, a machine for loading wagons at a pithead, operated by hydraulic power.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164183">
    <skos:scopeNote xml:lang="en">A type of concrete bridge, developed in the 20th century, that consists of reinforced concrete deck slabs that sit on the supporting bridge piers and/or abutments.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92987">
    <skos:scopeNote xml:lang="en">The ground immediately surrounding a place, particularly a religious building.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/145008">
    <skos:scopeNote xml:lang="en">Platform, usually stone-built, which holds the winding gear of a mine shaft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160536">
    <skos:scopeNote xml:lang="en">A site associated with Operation PLUTO (Pipe Line Under The Ocean) the operation to supply the allies with fuel following the invasion of Normandy.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69158">
    <skos:scopeNote xml:lang="en">A structure used to dry peat on.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143429">
    <skos:scopeNote xml:lang="en">A site used by the Air Raid Precautions network. Use more specific term.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91114">
    <skos:scopeNote xml:lang="en">An indoor play area for the game of badminton.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162621">
    <skos:scopeNote xml:lang="en">Regular courtyard farmsteads where the buildings are arranged as an F-shaped plan around two cattle yards. Cattle housing and stabling typically extend as three ranges from the longer main range which includes a barn or mixing house.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70004">
    <skos:scopeNote xml:lang="en">A Neolithic burial monument comprising a stone-built chamber within a circular or sub-circular earthen mound. See RELIGIOUS, RITUAL AND FUNERARY Class List for context.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93943">
    <skos:scopeNote xml:lang="en">An educational establishment where law is taught.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87689">
    <skos:scopeNote xml:lang="en">A factory where fish are processed into food products.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/134654">
    <skos:scopeNote xml:lang="en">Component part of a Flint Mill where flint is calcined before it is brittle enough to be ground in the mill. Ground, burnt flint is used in the production of earthenware pottery, which whitens and strenghens the body.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71751">
    <skos:scopeNote xml:lang="en">A dwelling house forming part of a Chartist Land Colony.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91680">
    <skos:scopeNote xml:lang="en">A house in which a pair of curved timbers form a bowed A-frame which supports the roof independently of the walls.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91219">
    <skos:scopeNote xml:lang="en">A mill used for the production of cardboard and other similar products.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68827">
    <skos:scopeNote xml:lang="en">A site or structure on which a signal, especially a fire, could be placed as a warning or means of communication. Use for beacon sites or surviving beacon structures.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91871">
    <skos:scopeNote xml:lang="en">A purpose-built model village for the workers on a country house estate.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93335">
    <skos:scopeNote xml:lang="en">A house with an aisle on one side only.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68636">
    <skos:scopeNote xml:lang="en">An area of land which retains distinctive large-scale rectilinear land divisions characteristic of Roman agriculture. Generally aligned with the course of a Roman road.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/84017">
    <skos:scopeNote xml:lang="en">A garden for the cultivation of herbs used for medicinal or culinary purposes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94202">
    <skos:scopeNote xml:lang="en">A type of bridge which has machinery and movable elements, eg. to allow vessels to pass.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140486">
    <skos:scopeNote xml:lang="en">An aircraft hangar built to Air Ministry design number 454/43. Mainly constructed on aircraft factory aerodromes</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91025">
    <skos:scopeNote xml:lang="en">A building or area within a brewery where barrels of ale are stored.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91563">
    <skos:scopeNote xml:lang="en">A place of accommodation at a college for staff and students.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70165">
    <skos:scopeNote xml:lang="en">Houses specifically of nuns/canonesses or religious women.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/119793">
    <skos:scopeNote xml:lang="en">A trough or gutter for conveying liquids such as water or molten metal. It can be cut in the surface or formed of wood or other materials.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93198">
    <skos:scopeNote xml:lang="en">Emergency deceleration lane.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91031">
    <skos:scopeNote xml:lang="en">A factory producing metallic aluminium by an electrolysis process.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70011">
    <skos:scopeNote xml:lang="en">A round barrow in which the mound and ditch are separated from each other by a berm. The ditch may be accompanied by an external (or occasionally internal) bank.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70294">
    <skos:scopeNote xml:lang="en">A channel which feeds water from a reservoir into a canal when the water level gets low.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91890">
    <skos:scopeNote xml:lang="en">A specialist hospital for the medical and surgical treatment of eye and ear disorders and diseases.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91846">
    <skos:scopeNote xml:lang="en">A school in which elementary subjects are taught to young children.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87787">
    <skos:scopeNote xml:lang="en">Specialized engineering workshop particularly for the production of marine engines or other large components of ships.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69050">
    <skos:scopeNote xml:lang="en">A factory where brushes are manufactured. Use for all types of brush.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143229">
    <skos:scopeNote xml:lang="en">A suburb of a town, especially Roman or Medieval, situtated or extending beyond its formal limits, usually demarked by defences.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91708">
    <skos:scopeNote xml:lang="en">A specialist hospital where medical and surgical dental treatment takes place.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70270">
    <skos:scopeNote xml:lang="en">A pathway, not necessarily designed as such, beaten down by the feet of travellers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92702">
    <skos:scopeNote xml:lang="en">A building or structure in which bricks are made.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70488">
    <skos:scopeNote xml:lang="en">A residence of two or three monks dependent on a foreign mother house sent to exploit a distant estate. Alien houses were officially suppressed in 1414.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92171">
    <skos:scopeNote xml:lang="en">A lock where the gates rise vertically. Rarely found on canals but common on navgable rivers in the Fens, particularly the river Nene.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69265">
    <skos:scopeNote xml:lang="en">Use with form of extraction where known. Also use MINE and other ores extracted where relevant, eg. SILVER MINE.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91991">
    <skos:scopeNote xml:lang="en">Buildings, sites and structures associated with the large-scale production, processing and preserving of food and drink.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70222">
    <skos:scopeNote xml:lang="en">A bridge carrying a road over land or water.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/95027">
    <skos:scopeNote xml:lang="en">Floatable vessel used as a floodgate in docks.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71713">
    <skos:scopeNote xml:lang="en">A large building, situated at a railway terminus, used for the temporary storage of goods or merchandise awaiting transportation to or from a railway.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167086">
    <skos:scopeNote xml:lang="en">A building, either purpose-built or modified, used for the co-ordination of the Fire Service.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91836">
    <skos:scopeNote xml:lang="en">One of 12 roadside crosses erected by Edward I in memory of his wife, Eleanor of Castile, the most famous being Charing Cross in London.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70133">
    <skos:scopeNote xml:lang="en">Subsidiary settlement of lay brothers attached to some Carthusian monasteries.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91678">
    <skos:scopeNote xml:lang="en">Production of high quality steel by reheating cementation steel in a refractory crucible.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164191">
    <skos:scopeNote xml:lang="en">A factory where knitted fabrics are manufacterd using knitting machines.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92166">
    <skos:scopeNote xml:lang="en">Cottage provided for guests to a country house.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93594">
    <skos:scopeNote xml:lang="en">A tree-lined way or approach where the trees have been cut into various forms and shapes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71766">
    <skos:scopeNote xml:lang="en">An area within a building open to the public where light meals and drinks can be purchased and consumed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91460">
    <skos:scopeNote xml:lang="en">A factory where chocolate products are produced.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91820">
    <skos:scopeNote xml:lang="en">A hospital department for the medical treatment of ear, nose and throat disorders.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167317">
    <skos:scopeNote xml:lang="en">An underground structure from which operations covering the whole, or part, of the country could be directed in the event of a nuclear attack. Usually equipped with air filtration equipment and supplies for several months.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68624">
    <skos:scopeNote xml:lang="en">Narrow ridges representing the surviving surface traces of later prehistoric cultivation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71492">
    <skos:scopeNote xml:lang="en">A building used for the testing of weapons for quality, accuracy and explosive power.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143197">
    <skos:scopeNote xml:lang="en">Fairground attraction designed to create optical illusions to give a sense of unbalance and unease.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68785">
    <skos:scopeNote xml:lang="en">An accounts office, especially within an industrial or commercial complex.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140528">
    <skos:scopeNote xml:lang="en">A large, rectangular pillbox based on the FW3/28 with the addition of a small infantry chamber to one side of the main gun chamber.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69094">
    <skos:scopeNote xml:lang="en">A building or room where items of pottery are manufactured. Includes handcrafted and machine made pottery.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140551">
    <skos:scopeNote xml:lang="en">Stone used for grinding or polishing during the manufacture of lithic implements</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140532">
    <skos:scopeNote xml:lang="en">A machine gun post designed by James Ruck constructed from hollow blocks and prefabricated concrete sheeting with loopholes allowing for a garrison of eight.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93254">
    <skos:scopeNote xml:lang="en">A mark erected on or near danger or on shore as an aid to pilotage.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91827">
    <skos:scopeNote xml:lang="en">An office which administers the affairs of the church.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94361">
    <skos:scopeNote xml:lang="en">A combination of obstructions, used either to stop enemy forces or force them off the road.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140071">
    <skos:scopeNote xml:lang="en">A piece of forest land converted into arable.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68603">
    <skos:scopeNote xml:lang="en">A house or range of buildings in which dogs are kept, eg. hunting hounds.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93101">
    <skos:scopeNote xml:lang="en">A building as part of a workhouse, prison or hospital, often including porter's lodge, baths, clothes store, washrooms, casual cells, rooms etc, for receiving inmates/patients. Use term from Components thesaurus if it is part of a building complex.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141168">
    <skos:scopeNote xml:lang="en">An establishment where beauty treatments and associated therapies are provided by professional practitioners.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143426">
    <skos:scopeNote xml:lang="en">A site from which troops could be embarked onto transport vessels prior to the D-Day landings can also apply to muster/departure points from which troops embarked for their journey to the Front.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/144553">
    <skos:scopeNote xml:lang="en">A complex of buildings where barytes is processed for industrial use.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69936">
    <skos:scopeNote xml:lang="en">A closely mown piece of ground used for the game of lawn bowling.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159309">
    <skos:scopeNote xml:lang="en">A hut consisting of a frame of reinforced concrete posts into which panels of either pre cast concrete or corrugated asbestos could be slotted. Designed by the British Concrete Federation during WWII.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/90956">
    <skos:scopeNote xml:lang="en">Buildings, sites and structures associated with the production of pottery. Use only for sites where there is evidence of pottery manufacture but no specific monument, otherwise use more specific term.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70221">
    <skos:scopeNote xml:lang="en">A bridge carrying a railway track across a river, valley, road etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92913">
    <skos:scopeNote xml:lang="en">A cheap eating establishment traditionally serving jellied eels, pies and mash.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69461">
    <skos:scopeNote xml:lang="en">A massive structure, usually of stone, serving as a pier or breakwater, or joining two places separated by water.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93680">
    <skos:scopeNote xml:lang="en">Area in a brewery used for the production of beer by the Burton Union method.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70284">
    <skos:scopeNote xml:lang="en">A bridge, usually resting on a series of arches, carrying roadways or railways over low-lying areas.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68796">
    <skos:scopeNote xml:lang="en">An open space or covered building in which cattle, goods, etc, are displayed for sale.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87921">
    <skos:scopeNote xml:lang="en">A building providing accommodation, dining facilities and recreation for non commissioned officers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70367">
    <skos:scopeNote xml:lang="en">A square shaped area of land enclosed by a boundary ditch, bank, wall, palisade or similar barrier. Small square enclosures (with sides of less than c.20m) have been interpreted as the remains of square barrows of Iron Age date.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141275">
    <skos:scopeNote xml:lang="en">An umbrella-shaped pavilion, Indian in origin, constructed over a funerary site. Can also refer to a funerary monument or cenotaph constructed in this style.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70426">
    <skos:scopeNote xml:lang="en">An enclosing structure composed of bricks, stones or similar materials, laid in courses. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141678">
    <skos:scopeNote xml:lang="en">An enclosed feature, usually sub-terranean, constructed to contain water for public or private recreation and sporting activities. Often part of a larger SPORTS CENTRE. Use OUTDOOR SWIMMING POOL for unenclosed pools.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160510">
    <skos:scopeNote xml:lang="en">An airfield, and associated structures, used by one or more fighter squadrons.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69165">
    <skos:scopeNote xml:lang="en">A factory for processing rubber or manufacturing rubber goods, such as tyres.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92368">
    <skos:scopeNote xml:lang="en">A site where scientific and technical instruments such as microscopes are assembled.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92401">
    <skos:scopeNote xml:lang="en">One of a line of blocks on the floor of a building slip on which the keel of the ship to be constructed is laid. Also used in dry docks to rest a ship when a dock is pumped dry.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68954">
    <skos:scopeNote xml:lang="en">The residence of a miller, often attached to a mill.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93173">
    <skos:scopeNote xml:lang="en">A column set on a pedestal and decorated with the bows of warships to celebrate naval victories. Originally a Roman form, it was revived in 17th and 18th century decoration.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160280">
    <skos:scopeNote xml:lang="en">A building housing a flight simulator designed to air ministry drawing number 4188/42.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159242">
    <skos:scopeNote xml:lang="en">A building or complex where skins are prepared, with their hair still on, to make fur products.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92272">
    <skos:scopeNote xml:lang="en">A frame used to lift unco-operative horses off the ground during shoeing.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/139036">
    <skos:scopeNote xml:lang="en">A site used for the extraction of peat.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69096">
    <skos:scopeNote xml:lang="en">A place where stained glass is manufactured, traditionally for church windows.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70310">
    <skos:scopeNote xml:lang="en">A trench dug to contain a sill beam, a horizontal timber beam used as a foundation for the wall of a building. Use wider site type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92512">
    <skos:scopeNote xml:lang="en">A place where railway engines are kept.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143231">
    <skos:scopeNote xml:lang="en">Purposely built camp with recreational facilities and individual chalets for accommodation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160519">
    <skos:scopeNote xml:lang="en">A tall, usually steel, structure used to receive and transmit radio signals in order to determine the height, distance and number of aircraft approaching.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68997">
    <skos:scopeNote xml:lang="en">A parcel of land.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92916">
    <skos:scopeNote xml:lang="en">The residence of a piermaster.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91447">
    <skos:scopeNote xml:lang="en">A shop which dispenses medicinal drugs and other health-related items. Can include an area for the preparation and manufacture of medicines and other drugs.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160281">
    <skos:scopeNote xml:lang="en">A building housing a flight simulator designed to air ministry drawing number 7790/40.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93774">
    <skos:scopeNote xml:lang="en">Buildings, sites and structures associated with water transport.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/144570">
    <skos:scopeNote xml:lang="en">A place of worship for the followers of the Church of Jesus Christ of Latter Day Saints</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69991">
    <skos:scopeNote xml:lang="en">A cross, erected on a highway or in an open place, at which monks and others used to preach.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143176">
    <skos:scopeNote xml:lang="en">A prepared piece of ground on which the game of Petanque is played.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78240">
    <skos:scopeNote xml:lang="en">Long alignment of cairns lying between two large cairns; first recognized as a site type on Sourton Tor, Dartmoor.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70327">
    <skos:scopeNote xml:lang="en">A marker of some form used to indicate the limit of an area or a piece of land.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93776">
    <skos:scopeNote xml:lang="en">A large, undergound watercourse.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70469">
    <skos:scopeNote xml:lang="en">A building over a well housing machinery for raising the water. Often consisting of a DONKEY WHEEL or HORSE GIN.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91277">
    <skos:scopeNote xml:lang="en">Sites and structures associated with the manufacture of bricks and tiles. Includes sites associated with earth extraction and preparation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162646">
    <skos:scopeNote xml:lang="en">A building temporarily requistioned for use as a hospital. Auxiliary hospitals treated the less seriously wounded and were less strict than military hospitals although they remained under military control.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69212">
    <skos:scopeNote xml:lang="en">A brass manufacturing complex incorporating battery mill furnaces, hammers, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140116">
    <skos:scopeNote xml:lang="en">A type of military building associated with military airfields, where air crews were briefed for missions. The room could be a seperate building or part of an operations block and are built of varying types of temporary brick or nissen hut constructions.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91364">
    <skos:scopeNote xml:lang="en">A building where carpets and other floor furnishings were woven.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68557">
    <skos:scopeNote xml:lang="en">A building or group of buildings used for the making, processing, storing and selling of milk and other dairy products.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70369">
    <skos:scopeNote xml:lang="en">A spatially discrete, though sometimes extensive, scatter of flint artefacts recovered from the surface, eg. by fieldwalking, rather than from a particular archaeological context.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93211">
    <skos:scopeNote xml:lang="en">Buildings incorporating a high degree of protection against damp for the bulk storage of salt.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91733">
