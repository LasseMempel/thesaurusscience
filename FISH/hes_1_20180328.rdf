		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1738" />
		<skos:scopeNote xml:lang="en">A site consisting of parallel banks, ditches, stones, post alignments or trees, which delineates the approach to another site or monument.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
