    <!-- https://hist-arch-vocab.org/bvha#c_f2a5513e -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_f2a5513e">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1cb81a92"/>
