    <!-- https://hist-arch-vocab.org/bvha#c_9f8a21ce -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_9f8a21ce">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0e17492b"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_473bbc7d"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_cc7a1644"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-01T11:02:49.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T19:24:19.000</terms:modified>
        <skos:definition xml:lang="de">Gründung auf Grundpfeilern mit Sockelfundamenten, um Bauwerkslasten auf tiefer liegende tragfähige Bodenschichten hinunterzuführen. Gegenüber einer durchgehenden Grundmauer brachte die Auflösung der Wand in einzelne Pfeiler eine erhebliche Einsparung an Mauerwerk. Die einzelnen Pfeiler wurden durch Grundbogen miteinander verbunden, die das aufgehende Mauerwerk trugen. [Bargmann]</skos:definition>
        <skos:prefLabel xml:lang="de">Grundpfeiler</skos:prefLabel>
        <broaderByConstruction rdf:resource="https://hist-arch-vocab.org/bvha#c_473bbc7d"/>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_cc7a1644"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_9f8cff9d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_9f8cff9d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_3k6eiowx"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-25T09:58:28.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-25T09:59:39.000</terms:modified>
        <skos:definition xml:lang="de">Ein ebenes oder gekrümmtes, stat. zweidimensional in Längs- und Querrichtung wirksames Tragwerk aus Stahlbeton oder Kunststoff zur stützenden Überspannung großer Flächen bei geringen Konstruktionshöhen. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Flächentragwerk</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_9f91cf59 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_9f91cf59">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_c11523f4"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_86022011"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-31T16:08:51.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T18:23:12.000</terms:modified>
        <skos:definition xml:lang="cs">Pozdní fáze anglického georgiánského stylu (1760-90), nazvaná podle rodiny architektů Adamů. Vlastním autorem slohu byl Roben (1728-92). John (1721-92) a James (1732-94) byli jeho bratři, William (1689-1745) jeho otec (palladianista). [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Späte Stilphase des engl. Georgian style von 1760-90, benannt nach der Architektenfamilie Adam. Der eigentliche Schöpfer des Stils ist Robert, 1728-92. John, 1721-92, und James, 1732-94, sind seine Brüder; William, 1689-1745, ist sein Vater (Palladianist). [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Adam style</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">adamovský styl</skos:prefLabel>
    </owl:NamedIndividual>
    


