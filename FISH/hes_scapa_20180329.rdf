	<cc:attributionURL rdf:resource="https://www.historicenvironment.scot/"/>
	<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence"/>
	<dct:identifier rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/EME"/>
	<dct:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence"/>
	<dct:spatial rdf:resource="http://dbpedia.org/resource/Scotland"/>
	<dct:spatial rdf:resource="http://vocab.getty.edu/tgn/7002444"/>
	<skos:broadMatch rdf:resource="http://vocab.getty.edu/aat/300019264"/>
	<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/ME"/>
	<skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/11/concepts/508446"/>
	<skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/EME"/>
	<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/scapa"/>
	<skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EME</skos:notation>
	<skos:prefLabel xml:lang="en">Early Mesolithic</skos:prefLabel>
	<skos:prefLabel xml:lang="gd">(todo)</skos:prefLabel>
	<skos:scopeNote xml:lang="en">The Early Mesolithic  or 'Middle Stone Age' is characterised by mainly simple, relatively large microlith types made on broad blades.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="http://purl.org/heritagedata/schemes/scapa/concepts/ENE">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
	<cc:attributionURL rdf:resource="https://www.historicenvironment.scot/"/>
	<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence"/>
	<dct:identifier rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/ENE"/>
	<dct:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence"/>
	<dct:spatial rdf:resource="http://dbpedia.org/resource/Scotland"/>
	<dct:spatial rdf:resource="http://vocab.getty.edu/tgn/7002444"/>
	<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/NE"/>
	<skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/11/concepts/508447"/>
	<skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/ENE"/>
	<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300019270"/>
	<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/scapa"/>
	<skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ENE</skos:notation>
	<skos:prefLabel xml:lang="en">Early Neolithic</skos:prefLabel>
	<skos:prefLabel xml:lang="gd">(todo)</skos:prefLabel>
	<skos:scopeNote xml:lang="en">The earliest subdivision of the Neolithic. Characterised include large rectangular houses, cursus monuments. Burial monuments include long and round barrows and cairns. The first pottery forms appear and artefact types include polished stone axeheads.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="http://purl.org/heritagedata/schemes/scapa/concepts/EPR">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
