    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Gebäuderestaurierung"@de,
        "building restoration"@en .

<http://www.eionet.europa.eu/gemet/concept/11427> a skos:Concept ;
