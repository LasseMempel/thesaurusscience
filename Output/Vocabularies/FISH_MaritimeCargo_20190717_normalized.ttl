    skos:inScheme <http://purl.org/heritagedata/schemes/77> ;
    skos:prefLabel "Mats"@en ;
    skos:scopeNote "Articles, usually woven from coarse fibres or made from hard wearing materials (eg. rubber or cork) used to protect the floor or for lying, sitting or kneeling on."@en .

<http://purl.org/heritagedata/schemes/77/concepts/109233> a skos:Concept ;
