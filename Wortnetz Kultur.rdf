		<skos:prefLabel xml:lang="de">Boot (Wasserfahrzeug)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Boote (Wasserfahrzeuge)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003443"/>
