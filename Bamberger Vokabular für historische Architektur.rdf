        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T14:21:16.000</terms:modified>
        <skos:altLabel xml:lang="cs">naválka</skos:altLabel>
        <skos:altLabel xml:lang="cs">podvalek</skos:altLabel>
        <skos:altLabel xml:lang="cs">vyboulení</skos:altLabel>
        <skos:altLabel xml:lang="cs">vyvýšenina </skos:altLabel>
        <skos:definition xml:lang="de">Stab, Rundstab, Viertelstab u. dergl. als Element von Gesimsen, Friesen, an Säulenbasen: Torus (att. Basis). [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Wulst</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">prut</skos:prefLabel>
        <skos:prefLabel xml:lang="es">toro</skos:prefLabel>
    </owl:NamedIndividual>
    


