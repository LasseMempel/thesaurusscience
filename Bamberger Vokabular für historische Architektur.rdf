        <skos:prefLabel xml:lang="it">occhio di bue</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">oeil-de-boeuf</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">volské oko</skos:prefLabel>
