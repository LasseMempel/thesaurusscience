  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91426">
    <skos:scopeNote xml:lang="en">A factory or complex where chamois leather is produced using fish oils as the tanning agent.</skos:scopeNote>
  </rdf:Description>
