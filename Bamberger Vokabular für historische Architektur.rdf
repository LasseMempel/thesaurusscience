        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-25T23:05:55.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T21:11:10.000</terms:modified>
        <skos:altLabel xml:lang="de">Firstblume</skos:altLabel>
        <skos:altLabel xml:lang="de">Giebelblume</skos:altLabel>
        <skos:altLabel xml:lang="cs">křížová kytka</skos:altLabel>
        <skos:definition xml:lang="de">Giebelblume, Firstblume, pflanzl. Ornament, das den oberen Abschluss got. Fialen, Wimperge und Turmpyramiden bildet. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">KYTKA, též křížová kytka, ornamentální zakončení gotických fiál, vimperků, věží. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Kreuzblume, First-, Giebelblume, in Grund- und Aufriss kreuzförmiges, stilisiertes Blattgebilde, auch zweifach übereinander, als Bekrönung von Fialen, Wimpergen, Turmpyramiden u. dergl., bes. in der Gotik. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Ornamentale Bekrönung gotischer Fialen, Wimperge, Turmhelme. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Kreuzblume</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kytka</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_dbac5de7 -->


