        <skos:prefLabel xml:lang="fr">tropaire</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">tropář</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_61658fcc -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_61658fcc">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f8146cf8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-28T17:22:58.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T11:03:05.000</terms:modified>
        <skos:definition xml:lang="de">Eine Burg mit einer Schildmauer als wesentlichem, markantem Bauteil; meist eine Sonderform der Spornburg. Kleinere Sporn- und Hangburgen weisen statt einer Schildmauer oft nur eine zum überhöhten Gelände verstärkte Ringmauer oder Gebäudewand (Ramberg RP, Alt-Bodman BW: Wohnbau) auf. M. L. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:prefLabel xml:lang="de">Schildmauerburg</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_f8146cf8"/>
    </owl:NamedIndividual>
    


