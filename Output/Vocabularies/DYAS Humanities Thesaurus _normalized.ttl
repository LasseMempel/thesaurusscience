    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Christian religious communities"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1583>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1584>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1656>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1707>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1708>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/458> ;
    skos:scopeNote "Communities of faithful who follow one of the Christian creeds. Christian communities (Orthodox, Catholics, Protestants, Gregorian Armenian, Copts etc.) are defined by their particular faiths and religious practices, by the organization of their Churches, and by the historical and cultural factors that contributed to their formation and development in time.<br />"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/584> a skos:Concept ;
