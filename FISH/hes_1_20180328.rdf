		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/408" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/412" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/493" />
