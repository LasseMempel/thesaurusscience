		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Rigolte Böden</skos:altLabel>
		<skos:altLabel xml:lang="de">Rigolter Boden</skos:altLabel>
		<skos:prefLabel xml:lang="de">Rigosol</skos:prefLabel>
		<skos:altLabel xml:lang="de">Rigosole</skos:altLabel>
