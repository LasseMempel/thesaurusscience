		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk012184"/>
		<xe:explanation_temp xml:lang="de">Die Agrarlandschaft wird charakterisiert durch strukturell angepasste Land- und Forstwirtschaft, Sonderkulturen, Brandflächen, ländliche wie auch kleinere städtische  Siedlungen.</xe:explanation_temp>
		<skos:definition xml:lang="de">Eine Agrarlandschaft ist eine Kulturlandschaft, die durch ihre spezifische agrare Nutzung gekennzeichnet ist.</skos:definition>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300008631"/>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4000766-2"/>
