    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Mechanische Schwingung"@de,
        "mechanical vibration"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Vibration> .

<http://www.eionet.europa.eu/gemet/concept/11921> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5658> ;
    skos:closeMatch <http://dbpedia.org/resource/Background_noise> ;
    skos:definition "Noise coming from source other than the noise source being monitored."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Hintergrundgeräusch"@de,
        "background noise"@en .

<http://www.eionet.europa.eu/gemet/concept/11923> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2884> ;
    skos:closeMatch <http://data.uba.de/umt/_00017663> ;
    skos:definition "General noise from a local source (such as the noise of a factory) which is disturbing to people living in the area."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Nachbarschaftslärm"@de,
        "neighbourhood noise"@en .

<http://www.eionet.europa.eu/gemet/concept/11958> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2606> ;
    skos:closeMatch <http://data.uba.de/umt/_00051325> ;
    skos:definition "Power station where the generation of power is provided by the ebb and flow of the tides. The principle is that water collected at high tide behind a barrage is released at low tide to turn a turbine that, in turn, drives a generator."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Gezeitenkraftwerk"@de,
        "tidal power station"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Tidal_power> .

<http://www.eionet.europa.eu/gemet/concept/11967> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15266>,
        <http://www.eionet.europa.eu/gemet/concept/15271>,
        <http://www.eionet.europa.eu/gemet/concept/4122> ;
    skos:closeMatch <http://data.uba.de/umt/_00050280> ;
    skos:definition "The free renewable source of energy provided by falling water that drives the turbines. Hydropower is the most important of the regenerable energy sources because of its highest efficiency at the energy conversion. There are two types of hydroelectric power plants: a) run-of-river power plants for the use of affluent water; b) storage power plants (power stations with reservoir) where the influx can be regulated with the help of a reservoir. Mostly greater differences in altitudes are being used, like mountain creeks. Power stations with reservoirs are generally marked by barrages with earth fill dam or concrete dams. Though hydropower generally can be called environmentally acceptable, there exist also some problems: a) change of groundwater level and fill up of the river bed with rubble. b) Risk of dam breaks. c) Great demand for land space for the reservoir. d) Diminution, but partly also increase of value of recreation areas. As the hydropowers of the world are limited, the world energy demand however is rising, finally the share of hydropower will decrease."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/751> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Hydroelektrische Energie"@de,
        "hydroelectric energy"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Hydroelectricity> .

<http://www.eionet.europa.eu/gemet/concept/11974> a skos:Concept ;
    skos:broadMatch <http://eurovoc.europa.eu/3782> ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2606> ;
    skos:closeMatch <http://data.uba.de/umt/_00040266> ;
    skos:definition "Power station of small size for the generation of energy at local level."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Kleinkraftwerk"@de,
        "small power station"@en .

<http://www.eionet.europa.eu/gemet/concept/11975> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5258> ;
    skos:closeMatch <http://data.uba.de/umt/_00051480> ;
    skos:definition "A mill whose power is provided by a large wheel which is turned by moving water, especially a river."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_16150> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Wassermühle"@de,
        "water mill"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Watermill> .

<http://www.eionet.europa.eu/gemet/concept/11990> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4040>,
        <http://www.eionet.europa.eu/gemet/concept/7185> ;
    skos:closeMatch <http://data.uba.de/umt/_00050958> ;
    skos:definition "The process by which a power plant is finally taken out of operation."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Steuerbefreiung von Kraftwerken"@de,
        "power station derating"@en .

<http://www.eionet.europa.eu/gemet/concept/120> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7930> ;
    skos:closeMatch <http://data.uba.de/umt/_00001265>,
        <http://dbpedia.org/resource/Adsorption> ;
    skos:definition "The physical or chemical bonding of molecules of gas, liquid or a dissolved substance to the external surface of a solid or the internal surface, if the material is porous, in a very thin layer."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_137> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Adsorption"@de,
        "adsorption"@en .

<http://www.eionet.europa.eu/gemet/concept/1200> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3646> ;
    skos:closeMatch <http://data.uba.de/umt/_00014086>,
        <http://dbpedia.org/resource/Cartography> ;
    skos:definition "The making of maps and charts for the purpose of visualizing spatial distributions over various areas of the earth."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_1344>,
        <http://eurovoc.europa.eu/5269> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Kartographie"@de,
        "cartography"@en .

<http://www.eionet.europa.eu/gemet/concept/12006> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5742> ;
    skos:closeMatch <http://data.uba.de/umt/_00050094> ;
    skos:definition "Nuclear reactor which produces more fissile material than it consumes, using fast-moving neutrons and making plutonium-239 from uranium-238, thereby increasing the reactor's efficiency."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/4341> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Schneller Reaktor"@de,
        "fast reactor"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Fast-neutron_reactor> .

<http://www.eionet.europa.eu/gemet/concept/12007> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12783> ;
    skos:definition "Any site or region that is damaged, harmed or made unfit for use by the introduction of unwanted substances, particularly microorganisms, chemicals, toxic and radioactive materials and wastes."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/4800> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Kontaminierte Böden"@de,
        "contaminated area"@en .

<http://www.eionet.europa.eu/gemet/concept/1201> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8731> ;
    skos:definition "A rubber ring placed over the rim of a wheel of a road vehicle to provide traction and reduce road shocks, especially a hollow inflated ring consisting of a reinforced outer casing enclosing an inner tube."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Autoreifen"@de,
        "car tyre"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Tire> .

<http://www.eionet.europa.eu/gemet/concept/12017> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/298> ;
    skos:closeMatch <http://data.uba.de/umt/_00008928>,
        <http://dbpedia.org/resource/Ethanol> ;
    skos:definition "A colorless liquid, miscible with water, used as a reagent and solvent. Also known as alcohol; ethyl alcohol; grain alcohol."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_10677>,
        <http://eurovoc.europa.eu/890> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Ethanol"@de,
        "ethanol"@en .

<http://www.eionet.europa.eu/gemet/concept/12026> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3110> ;
    skos:definition "The sedimentation of dust or fine particles from the atmosphere."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Atmosphärischer Fallout"@de,
        "atmospheric fallout"@en .

<http://www.eionet.europa.eu/gemet/concept/1203> a skos:Concept ;
    skos:broadMatch <http://eurovoc.europa.eu/2723> ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/219> ;
    skos:closeMatch <http://data.uba.de/umt/_00018330>,
        <http://dbpedia.org/resource/Cash_crop> ;
    skos:definition "Crops that are grown for sale in the town markets or for export. They include coffee, cocoa, sugar, vegetables, peanuts and non-foods, like tobacco and cotton. Huge areas of countries in the developing world have been turned over to cash crops. Those countries with no mineral or oil resources depend on cash crops for foreign money, so that they can import materials do develop roads, for construction, or to buy Western consumer goods and, indeed, food. However, critics argue that cash crops are planted on land that would otherwise be used to grow food for the local community and say this is a cause of world famine. Cash crops, such as peanuts, can ruin the land if it is not left fallow after six years of harvests. Moreover, if the best agricultural land is used for cash crops, local farmers are forced to use marginal land to grow food for local consumption, and this has a further dramatic effect on the environment."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Nutzpflanze"@de,
        "cash crop"@en .

<http://www.eionet.europa.eu/gemet/concept/12045> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1479> ;
    skos:closeMatch <http://data.uba.de/umt/_00018876> ;
    skos:definition "The study of paleoclimates throughout geologic time, and of the causes of their variations, on either a local or a worldwide basis. It involves the interpretation of glacial deposits, fossils and sedimentologic and other types of data."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_5508> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Paläoklimatologie"@de,
        "palaeoclimatology"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Paleoclimatology> .

<http://www.eionet.europa.eu/gemet/concept/12061> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1469> ;
    skos:closeMatch <http://data.uba.de/umt/_00049927>,
        <http://dbpedia.org/resource/Desert_climate> ;
    skos:definition "A climate type which is characterized by insufficient moisture to support appreciable plant life; that is, a climate of extreme aridity."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Wüstenklima"@de,
        "desert climate"@en .

<http://www.eionet.europa.eu/gemet/concept/12062> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1469> ;
    skos:closeMatch <http://data.uba.de/umt/_00050071> ;
    skos:definition "Climate characterized by constant temperatures, abundant rainfall and a very short dry season."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Äquatoriales Klima"@de,
        "equatorial climate"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Tropical_climate> .

<http://www.eionet.europa.eu/gemet/concept/12063> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12066> ;
    skos:closeMatch <http://data.uba.de/umt/_00051704>,
        <http://dbpedia.org/resource/Mediterranean_climate> ;
    skos:definition "A type of climate characterized by hot, dry, sunny summers and a winter rainy season; basically, this is the opposite of a monsoon climate. Also known as etesian climate."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_4697> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Mittelmeerklima"@de,
        "Mediterranean climate"@en .

<http://www.eionet.europa.eu/gemet/concept/12064> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12060> ;
    skos:definition "Very generally, the climate of relatively high elevations; mountain climates are distinguished by the departure of their characteristics from those of surrounding lowlands, and the one common basis for this distinction is that of atmospheric rarefaction; aside from this, great variety is introduced by differences in latitude, elevation, and exposure to the sun; thus, there exists no single, clearly defined, mountain climate. Also known as highland climate."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_4958> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bergklima"@de,
        "mountain climate"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Alpine_climate> .

<http://www.eionet.europa.eu/gemet/concept/12065> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1469> ;
    skos:closeMatch <http://data.uba.de/umt/_00050840>,
        <http://dbpedia.org/resource/Oceanic_climate> ;
    skos:definition "A regional climate which is under the predominant influence of the sea, that is, a climate characterized by oceanity; the antithesis of a continental climate."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_5298> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Meeresklima"@de,
        "oceanic climate"@en .

<http://www.eionet.europa.eu/gemet/concept/12067> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1469> ;
    skos:closeMatch <http://data.uba.de/umt/_00051372>,
        <http://dbpedia.org/resource/Tropical_climate> ;
    skos:definition "A climate which is typical of equatorial and tropical regions, that is, one with continually high temperatures and with considerable precipitation, at least during part of the year."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_7973> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Trophisches Klima"@de,
        "tropical climate"@en .

<http://www.eionet.europa.eu/gemet/concept/12082> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5196> ;
    skos:definition "A temperature inversion in the atmosphere in which the temperature, instead of falling, increases with height above the ground. With the colder and heavier air below, there is no tendency to form upward currents and turbulence is suppressed. Inversions are often formed in the late afternoon when the radiation emitted from the ground exceeds that received from the sinking sun. Inversions are also caused by katabatic winds, that is cold winds flowing down the hillside into a valley, and by anticyclones. In inversion layers, both vertical and horizontal diffusion is inhibited and pollutants become trapped, sometimes for long periods. Low-level discharges of pollutants are more readily trapped by inversions than high level dischargers, hence the case for high stacks. Furthermore, high level discharges into an inversion tend to remain at a high level because of the absence of vertical mixing."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "atmosphärische Inversion"@de,
        "atmospheric inversion"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Inversion_%28meteorology%29> .

<http://www.eionet.europa.eu/gemet/concept/12084> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8115> ;
    skos:closeMatch <http://data.uba.de/umt/_00011562>,
        <http://dbpedia.org/resource/Thunderstorm> ;
    skos:definition "A storm caused by strong rising air currents and characterized by thunder and lightning and usually heavy rain or hail."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_14875> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Gewitter"@de,
        "thunderstorm"@en .

<http://www.eionet.europa.eu/gemet/concept/12091> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5196> ;
    skos:closeMatch <http://data.uba.de/umt/_00011658>,
        <http://dbpedia.org/resource/Glaze> ;
    skos:definition "A coating of ice, generally clear and smooth but usually containing some air pockets, formed on exposed objects by the freezing of a film of supercooled water deposited by rain, drizzle, or fog, or possibly condensed from supercooled water vapour."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Glatteis"@de,
        "glaze"@en .

<http://www.eionet.europa.eu/gemet/concept/12096> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7172> ;
    skos:closeMatch <http://data.uba.de/umt/_00051289> ;
    skos:definition "The process of extracting underground water from a source."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Untergrundwassergewinnung"@de,
        "exploitation of underground water"@en .

<http://www.eionet.europa.eu/gemet/concept/12098> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4291> ;
    skos:definition "The movement of surface water into soil or rock through cracks and pores."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Wasserinfiltration in den Boden"@de,
        "water infiltration into the ground"@en .

<http://www.eionet.europa.eu/gemet/concept/121> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6527> ;
    skos:closeMatch <http://dbpedia.org/resource/Adult> ;
    skos:definition "A person who is fully grown, developed or of a specified age."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/160> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Erwachsene"@de,
        "adult"@en .

<http://www.eionet.europa.eu/gemet/concept/12104> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3485> ;
    skos:closeMatch <http://dbpedia.org/resource/Water_table> ;
    skos:definition "Water that occupies pores, cavities, cracks and other spaces in the crustal rocks. It includes water precipitated from the atmosphere which has percolated through the soil, water that has risen from deep magmatic sources liberated during igneous activity and fossil water retained in sedimentary rocks since their formation. The presence of groundwater is necessary for virtually all weathering processes to operate. Phreatic water is synonymous with groundwater and is the most important source of any water supply."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Freies Grundwasser"@de,
        "water table"@en .

<http://www.eionet.europa.eu/gemet/concept/12108> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12107> ;
    skos:definition "Water table is inherently susceptible to contamination from landuse activities. Remediation is very expensive and often impractical. Prevention of contamination is therefore critical in effective groundwater management."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Wasserstandschutz"@de,
        "water table protection"@en .

<http://www.eionet.europa.eu/gemet/concept/12122> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3298> ;
    skos:closeMatch <http://data.uba.de/umt/_00012775> ;
    skos:definition "The total quantity of water flowing from the catchment during the period of the flood."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Hochwasserabfluß"@de,
        "flood runoff"@en .

<http://www.eionet.europa.eu/gemet/concept/12123> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "The filling or partial filling with silt of a reservoir that receives fine-grained sediment brought in by streams and surface runoff."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Stauseefüllung"@de,
        "silting up"@en .

<http://www.eionet.europa.eu/gemet/concept/12128> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9231> ;
    skos:closeMatch <http://dbpedia.org/resource/Hydrometry> ;
    skos:definition "The science and technology of measuring specific gravities, particularly of liquids."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_25629> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Hydrometrie"@de,
        "hydrometry"@en .

<http://www.eionet.europa.eu/gemet/concept/12131> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3400> ;
    skos:closeMatch <http://data.uba.de/umt/_00012789> ;
    skos:definition "The hydrological processes generating river floods have been studied extensively and several modelling concepts have been proposed. The standard procedure for flood forecasting consists of calibrating the parameters of the model of a particular river basin on a representative set of historical hydrometric data and subsequently applying this calibrated model in a real-time environment."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Hochwasserprognose"@de,
        "flood forecast"@en .

<http://www.eionet.europa.eu/gemet/concept/12135> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4116> ;
    skos:definition "The configuration or arrangement in plan view of the natural stream courses in an area. It is related to local geologic and geomorphologic features and history. Synonym: drainage pattern."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Hydrographisches Netz"@de,
        "hydrographic network"@en .

<http://www.eionet.europa.eu/gemet/concept/12139> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2405> ;
    skos:closeMatch <http://dbpedia.org/resource/Sedimentology> ;
    skos:definition "The scientific study of sedimentary rocks and of the processes by which they were formed; the description, classification, origin, and interpretation of sediments."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/6391> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Sedimentologie"@de,
        "sedimentology"@en .

<http://www.eionet.europa.eu/gemet/concept/1215> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12145> ;
    skos:closeMatch <http://data.uba.de/umt/_00011431>,
        <http://dbpedia.org/resource/Catchment_area> ;
    skos:definition """1) An area from which surface runoff is carried away by a single drainage system.
2) The area of land bounded by watersheds draining into a river, basin or reservoir."""@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Gewässereinzugsgebiet"@de,
        "catchment area"@en .

<http://www.eionet.europa.eu/gemet/concept/12152> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/963> ;
    skos:definition "A body of water that is owned and maintained by a national governmental body or agency."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Privatgewässer"@de,
        "demesnial water"@en .

<http://www.eionet.europa.eu/gemet/concept/12153> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/963> ;
    skos:closeMatch <http://data.uba.de/umt/_00050818> ;
    skos:definition "A body of water that is owned and maintained by an individual or entity other than the national government."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Öffentliches Gewässer"@de,
        "non-demesnial water"@en .

<http://www.eionet.europa.eu/gemet/concept/12161> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9297> ;
    skos:closeMatch <http://data.uba.de/umt/_00017444>,
        <http://dbpedia.org/resource/Bog> ;
    skos:definition "A commonly used term in Scotland and Ireland for a stretch waterlogged, spongy ground, chiefly composed of decaying vegetable matter, especially of rushes, cotton grass, and sphagnum moss."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Moor"@de,
        "bog"@en .

<http://www.eionet.europa.eu/gemet/concept/12166> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/740> ;
    skos:closeMatch <http://data.uba.de/umt/_00049870> ;
    skos:definition "Sea waters in which bathing is explicitly authorised or in which bathing is not prohibited and is traditionally practised by a large number of bathers. Water in such areas must meet specified quality standards relating to chemical, microbiological and physical parameters."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Badegewässer (Meerwasser)"@de,
        "bathing seawater"@en .

<http://www.eionet.europa.eu/gemet/concept/12170> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8766> ;
    skos:definition "The mouth or outlet of a river, drain, sewer or any other place at which drainage or wastewater is discharged into a body of oceanic water."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Meeresauslaß"@de,
        "ocean outfall"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Marine_outfall> .

<http://www.eionet.europa.eu/gemet/concept/12174> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7502> ;
    skos:closeMatch <http://dbpedia.org/resource/Swell> ;
    skos:definition "A regular movement of marine waves created by wind stress in the open ocean which travels considerable distances away from the generating field and into another wind field. The waves are characterized by relatively smooth, generally unbroken, crests and a fairly regular wavelength, but swell increases in wavelength and decreases in wave height as it moves away from the generating area. Local wind waves may be superimposed upon swell waves as they approach a coastline, thereby creating sharper crests and a choppy sea."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Anschwellen"@de,
        "swell"@en .

<http://www.eionet.europa.eu/gemet/concept/12183> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1523> ;
    skos:closeMatch <http://data.uba.de/umt/_00050078> ;
    skos:definition "Contamination of the generally broad portion of a stream near its outlet which is influenced by the tide of the water body into which it flows. Many estuaries have become badly contaminated by wastes that have been generated from heavily populated areas."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Ästuarverschmutzung"@de,
        "estuary pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/12189> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10058> ;
    skos:closeMatch <http://data.uba.de/umt/_00051084> ;
    skos:definition "The administration or handling of a waterway or a stream of flowing water."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Fließgewässerwirtschaft"@de,
        "river management"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/River_engineering> .

<http://www.eionet.europa.eu/gemet/concept/12198> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:closeMatch <http://dbpedia.org/resource/Flushing> ;
    skos:definition "Removing lodged deposits of rock fragments and other debris by water flow at high velocity; used to clean water conduits and drilled boreholes."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Spülen"@de,
        "flushing"@en .

<http://www.eionet.europa.eu/gemet/concept/12199> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9254> ;
    skos:closeMatch <http://data.uba.de/umt/_00049157> ;
    skos:definition "A chamber with gates on both ends connecting two sections of a canal or other waterway, to raise or lower the water level in each section."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Kanalschleuse"@de,
        "canal lock"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Lock_%28water_transport%29> .

<http://www.eionet.europa.eu/gemet/concept/122> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13307> ;
    skos:closeMatch <http://data.uba.de/umt/_00008860>,
        <http://dbpedia.org/resource/Adult_education> ;
    skos:definition "Any instruction or training, informal or formal, which is geared to persons of mature age, regardless of previous education, and typically offered by university extension programs, employers, correspondence courses or community groups."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_8629>,
        <http://eurovoc.europa.eu/674> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Erwachsenenbildung"@de,
        "adult education"@en .

<http://www.eionet.europa.eu/gemet/concept/1220> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3237> ;
    skos:closeMatch <http://data.uba.de/umt/_00031304> ;
    skos:definition "The yield obtained from a given fishery; fishery catches should be strictly controlled so that the fish population can have a sufficient breeding mass and thus give a sustained yield for future generations."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/5255> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Fangertrag"@de,
        "catch yield"@en .

<http://www.eionet.europa.eu/gemet/concept/12202> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7621> ;
    skos:closeMatch <http://data.uba.de/umt/_00051493> ;
    skos:definition "Cutting down by scythe or machine at intervals the vegetation growth and grasses on banks and berms of irrigation and drainage channels or cropped areas."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Schneiden von Wasserpflanzen"@de,
        "water weed cutting"@en .

<http://www.eionet.europa.eu/gemet/concept/12210> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7138> ;
    skos:closeMatch <http://data.uba.de/umt/_00030698> ;
    skos:definition "Basin used to hold water in storage."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Staubecken"@de,
        "retaining reservoir"@en .

<http://www.eionet.europa.eu/gemet/concept/12213> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/78> ;
    skos:definition "The drawing of water from a reservoir by means of draining pipes located at the bottom of the basin and controlled by a system of sluices which ensure, if necessary, the emptying of the basin in a given period of time in respect of downstream conditions."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Dammdrainage"@de,
        "dam draining"@en .

<http://www.eionet.europa.eu/gemet/concept/12215> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9216> ;
    skos:closeMatch <http://data.uba.de/umt/_00051484> ;
    skos:definition "Progress in, or betterment of, the environmental condition and integrity of water."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Wassergüteverbesserung"@de,
        "water quality improvement"@en .

<http://www.eionet.europa.eu/gemet/concept/12216> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11816> ;
    skos:closeMatch <http://data.uba.de/umt/_00024709> ;
    skos:definition "Taste in water can be caused by foreign matter, such as organic compounds, inorganic salts or dissolved gases. These materials may come from domestic, agricultural or natural sources. Some substances found naturally in groundwater, while not necessarily harmful, may impart a disagreeable taste or undesirable property to the water. Magnesium sulphate, sodium sulphate, and sodium chloride are but a few of these. Acceptable waters should be free from any objectionable taste at point of use."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Wassergeschmack"@de,
        "water taste"@en .

<http://www.eionet.europa.eu/gemet/concept/12219> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/303> ;
    skos:definition "A proliferation of a marine green plankton toxic and often fatal to fish, perhaps stimulated by the addition of nutrients."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Grünschlick"@de,
        "green tide"@en .

<http://www.eionet.europa.eu/gemet/concept/12220> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7565> ;
    skos:closeMatch <http://data.uba.de/umt/_00022057> ;
    skos:definition "Matter suspended in a fluid by the upward components of turbulent currents or by colloidal suspension."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Schwebstoffe"@de,
        "suspended matter"@en .

<http://www.eionet.europa.eu/gemet/concept/1224> a skos:Concept ;
    skos:broadMatch <http://eurovoc.europa.eu/3809> ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4493> ;
    skos:closeMatch <http://data.uba.de/umt/_00014125> ;
    skos:definition "A positively charged atom or group of atoms, or a radical which moves to the negative pole (cathode) during electrolysis."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Kationen"@de,
        "cation"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Ion> .

<http://www.eionet.europa.eu/gemet/concept/12254> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9246> ;
    skos:definition "The removal of minerals from water by chemical, ion-exchange, or distillation procedures."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Wasserentmineralisierung"@de,
        "water demineralisation"@en .

<http://www.eionet.europa.eu/gemet/concept/12260> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9143> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Sammelabwasserbehandlung"@de,
        "collective wastewater treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/12273> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7641> ;
    skos:closeMatch <http://data.uba.de/umt/_00051030> ;
    skos:definition "Channels for clearing away rain water."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Regenwasserkanalisation"@de,
        "rain water sewer system"@en .

<http://www.eionet.europa.eu/gemet/concept/12275> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7641> ;
    skos:closeMatch <http://data.uba.de/umt/_00024657> ;
    skos:definition "Sewer system having distinct pipes for collecting superficial water and sewage water."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Trennkanalisation"@de,
        "separate sewer system"@en .

<http://www.eionet.europa.eu/gemet/concept/12276> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7641> ;
    skos:closeMatch <http://data.uba.de/umt/_00017235> ;
    skos:definition "A sewer intended to serve as a sanitary sewer and a storm sewer, or as an industrial sewer and a storm sewer."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Mischkanalisation"@de,
        "combined sewer system"@en .

<http://www.eionet.europa.eu/gemet/concept/12277> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/132>,
        <http://www.eionet.europa.eu/gemet/concept/9143>,
        <http://www.eionet.europa.eu/gemet/concept/9246> ;
    skos:closeMatch <http://data.uba.de/umt/_00051461>,
        <http://dbpedia.org/resource/Water_aeration> ;
    skos:definition "Addition of air to sewage or water so as to raise its dissolved oxygen level."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Wasserbelüftung"@de,
        "water aeration"@en .

<http://www.eionet.europa.eu/gemet/concept/12278> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9143> ;
    skos:closeMatch <http://data.uba.de/umt/_00050368> ;
    skos:definition "The process of using a natural system or mechanical device to collect, treat and discharge or reclaim wastewater from an individual dwelling without the use of community-wide sewers or a centralised treatment facility."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Einzelabwasserbehandlung"@de,
        "individual wastewater treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/12279> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4254> ;
    skos:definition "A basin in which suspended matter is removed either by quiescent settlement or by continuous flow at high velocity and extended retention time to allow deposition."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Sedimentationsbecken"@de,
        "sedimentation basin"@en .

<http://www.eionet.europa.eu/gemet/concept/12280> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3184> ;
    skos:closeMatch <http://data.uba.de/umt/_00005025>,
        <http://dbpedia.org/resource/Trickling_filter> ;
    skos:definition "A system of secondary sewage treatment which is similar to self-purification action of streams; it is more accurately a biological oxidizing bed; the effluent is placed on the stones in the bed and microorganisms present consume the solids as a food supply."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Biofilter"@de,
        "trickling filter"@en .

<http://www.eionet.europa.eu/gemet/concept/12283> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9127> ;
    skos:definition "Wastewater or utilized water from a home, community, farm or industry, which is often discharged after utilization."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Benutztes Wasser"@de,
        "used water"@en .

<http://www.eionet.europa.eu/gemet/concept/12285> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2571> ;
    skos:closeMatch <http://data.uba.de/umt/_00051459> ;
    skos:definition "Partially or completely treated water or waste water flowing out of a waste treatment plant."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Abfallbehandlungsabwasser"@de,
        "waste treatment effluent"@en .

<http://www.eionet.europa.eu/gemet/concept/12289> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9121> ;
    skos:definition "The process in which sunlight, bacterial action and oxygen cause self-purification in waste water, Usually taking place in a shallow pond, or system of such ponds."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Schlammteichverfahren"@de,
        "lagooning"@en .

<http://www.eionet.europa.eu/gemet/concept/1229> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6623> ;
    skos:closeMatch <http://data.uba.de/umt/_00026832> ;
    skos:definition "Principle connected with the precautionary principle: it means that, if there are strong reasons for expecting serious or irreversible damage to the environment following a given project, lack of full scientific certainty should not be used as a reason for postponing cost-effective measures to prevent environmental degradation. Critics of this approach are concerned about large commitments of resources to deal with vaguely defined problems."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Vorsorgeprinzip"@de,
        "cause for concern principle"@en .

<http://www.eionet.europa.eu/gemet/concept/12293> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9143>,
        <http://www.eionet.europa.eu/gemet/concept/9246> ;
    skos:definition "A process in which naturally occurring microorganisms, plants, trees or geophysical processes break down, degrade or filter out hazardous substances or pollutants from a body of water, cleansing and treating contaminated water without human intervention."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Wasserregenerierung"@de,
        "water regeneration"@en .

<http://www.eionet.europa.eu/gemet/concept/12301> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7175> ;
    skos:definition "Measures and activities concerning the supply of water, the improvement of efficiency in its use, the reduction of losses and waste, water-saving practices to reduce costs and to slow the depletion of the water supply to ensure future water availability."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Wasserbewirtschaftung"@de,
        "water resources management"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Water_resources> .

<http://www.eionet.europa.eu/gemet/concept/1231> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4629> ;
    skos:closeMatch <http://data.uba.de/umt/_00030455>,
        <http://dbpedia.org/resource/Cave> ;
    skos:definition """1) An underground hollow with access from the ground surface or from the sea, often found in limestone areas and on rocky coastlines.
2) A natural cavity, chamber or recess which leads beneath the surface of the earth, generally in a horizontal or obliquely inclined direction. It may be in the form of a passage or a gallery, its shape depending in part on the joint pattern or structure of the rock and partly on the type of process involved in its excavation. Thus, caves worn by subterranean rivers may be different in character from, and of considerably greater extent than, a sea-cave eroded by marine waves.
3) A natural underground open space, generally with a connection to the surface and large enough for a person to enter. The most common type of cave is formed in a limestone by dissolution."""@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Höhle"@de,
        "cave"@en .

<http://www.eionet.europa.eu/gemet/concept/12321> a skos:Concept ;
