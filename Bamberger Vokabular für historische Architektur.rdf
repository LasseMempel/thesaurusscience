        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-22T18:01:14.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T17:36:01.000</terms:modified>
        <skos:altLabel xml:lang="de">Abendmahlswein</skos:altLabel>
        <skos:altLabel xml:lang="en">consecrated wine</skos:altLabel>
        <skos:altLabel xml:lang="fr">vin consacré</skos:altLabel>
        <skos:altLabel xml:lang="fr">vin de la messe</skos:altLabel>
        <skos:altLabel xml:lang="fr">vin eucharistique</skos:altLabel>
        <skos:altLabel xml:lang="la">vinum Eucharisticum</skos:altLabel>
        <skos:definition xml:lang="de">Meßwein m; Abendmahlswein m; lat. sanguis dominicus; vinum Eucharisticum: das Symbol des Blutes Christi; unverfälschter Wein (vinum de vita), vom Priester in der Messe geweiht und im eucharistischen Kelch gereicht. In den Westkirchen wird weißer, in den Ostkirchen roter Wein bevorzugt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Messwein</skos:prefLabel>
        <skos:prefLabel xml:lang="la">sanguis dominicus</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">vin du Saint-Sacrement</skos:prefLabel>
        <skos:prefLabel xml:lang="en">wine of the Blessed Sacrament </skos:prefLabel>
    </owl:NamedIndividual>
    


