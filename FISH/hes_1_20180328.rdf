				<skos:prefLabel xml:lang="gd">EAGLAIS CHOLAISTEACH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Eaglais a tha co-cheangailte ri colaiste no a chaidh a chur air bhonn leatha.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">COLLEGIATE CHURCH</skos:prefLabel>
