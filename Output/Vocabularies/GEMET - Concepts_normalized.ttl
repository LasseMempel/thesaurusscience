    skos:definition "Expenditure of money or the amount of money incurred for journeying or going from one place to another by some mode of transportation."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Reisekosten"@de,
        "travel cost"@en .

<http://www.eionet.europa.eu/gemet/concept/8667> a skos:Concept ;
