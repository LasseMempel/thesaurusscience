		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1899">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1899</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">COMHARRA-BÀRR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Rud a tha fon talamh 's a dh'aithnichear air fàs mì-chòmhnard barra. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CROPMARK</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1898" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500476" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500477" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502640" />
		<skos:scopeNote xml:lang="en">A buried feature revealed by the uneven growth of a crop. Use specific term where possible.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
