        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-21T18:24:36.000</terms:modified>
        <skos:definition xml:lang="de">Eine nicht unter, sondern östl. hinter dem Chor liegende, halb eingetiefte und nicht überbaute Krypta, auch zweigeschossig, zumeist von der Krypta unter dem Chor aus zugängl. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Außenkrypta</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_a9bd647a -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_a9bd647a">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
