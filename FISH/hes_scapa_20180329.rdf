	<skos:prefLabel xml:lang="en">Roman</skos:prefLabel>
	<skos:prefLabel xml:lang="gd">Ròmanach</skos:prefLabel>
	<skos:related rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/IA"/>
	<skos:scopeNote xml:lang="en">A term applied to physical traces of the Roman military incursions into Scotland and objects made within the Roman Republic or Empire from the late 1st century until the 4th century BCE.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="http://purl.org/heritagedata/schemes/scapa/concepts/ROAN">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
