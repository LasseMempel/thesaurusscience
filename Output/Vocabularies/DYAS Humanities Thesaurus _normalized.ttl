        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/600> ;
    skos:scopeNote "The aspects of individual or collective identity that relate to the biological, social and cultural characteristics (gender, ethnicity, religion, social class etc.), the conditions of individuals&rsquo; integration into the social environment, and the patterns of their interaction with it."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/49> a skos:Concept ;
    skos:altLabel "Atom of kinship"@en ;
