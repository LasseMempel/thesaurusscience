        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-10T17:04:24.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-10-14T15:48:24.000</terms:modified>
        <skos:definition xml:lang="de">(Anten-)Tempel mit Säulenvorhalle an der Frontseite. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">(Antový) chrám se sloupovou předsíní na čelní straně. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Tempel mit einer den Pronaos umschließenden Säulenvorhalle an der Frontseite. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Prostylos</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">prostylos</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_2cb148fd -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_2cb148fd">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1c130309"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-25T10:59:51.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T17:52:07.000</terms:modified>
        <skos:definition xml:lang="de">In Attika entwickelte Sonderform der Ionischen Ordnung, für die im Gegensatz zur Kleinasiatisch-ionischen Ordnung v. a. der Figurenfries (Zophoros) über dem Gebälk charakteristisch ist. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Attisch-ionische Ordnung</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_2cc25080 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_2cc25080">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
