    <skos:scopeNote xml:lang="en">A garden created within woodland where imported species such as camellias, magnolias and rhododendrons are grown.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71191">
    <skos:scopeNote xml:lang="en">A large site specializing in the manufacture of locomotives.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94360">
    <skos:scopeNote xml:lang="en">Distinctive clerestory-roofed building, used for the drying and storage of military parachutes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/139022">
    <skos:scopeNote xml:lang="en">A structure used to test the aerodynamics of aircraft or vehicles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92074">
    <skos:scopeNote xml:lang="en">A place where gardening tools, plants, etc, are sold.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68544">
    <skos:scopeNote xml:lang="en">A building used for an agricultural and/or subsistence purpose. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69197">
    <skos:scopeNote xml:lang="en">A site used for the production of items derived from animal horns.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143951">
    <skos:scopeNote xml:lang="en">An mill in which manganese was ground to a powder between two horizontal millstones.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/133657">
    <skos:scopeNote xml:lang="en">A site, usually including hardstandings and associated buildings, used for the storage of military vehicles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140496">
    <skos:scopeNote xml:lang="en">A side-opening steel framed shed. A smaller version of the SEAPLANE SHED (TYPE F) they were built from 1916 on RNAS seaplane bases</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/147269">
    <skos:scopeNote xml:lang="en">An establishment where deaf people receive education, training and social support.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68755">
    <skos:scopeNote xml:lang="en">A district, suburb or quarter of a town or village adjacent to a fort, with the lowest legal status accorded to a built up area.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71416">
    <skos:scopeNote xml:lang="en">A building appropriated by a school for the purpose of teaching pupils.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91644">
    <skos:scopeNote xml:lang="en">A building, usually in a rural setting, with a range of facilities for the use of members.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141913">
