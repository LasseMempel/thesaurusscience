		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/508982" />
		<skos:scopeNote xml:lang="en">The principal church of a diocese in which the cathedra or bishop's throne is to be found.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
