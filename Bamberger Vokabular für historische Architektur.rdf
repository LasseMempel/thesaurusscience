        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-16T16:23:42.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T17:36:54.000</terms:modified>
        <skos:altLabel xml:lang="de">Kreuzbogen</skos:altLabel>
        <skos:altLabel xml:lang="fr">branche d\&apos;ogive</skos:altLabel>
        <skos:altLabel xml:lang="en">cross springer</skos:altLabel>
        <skos:definition xml:lang="de">Diagonalbogen, Kreuzbogen; im Kreuzgewölbe der diagonal verlaufende; gratig gekehlte oder gerippte Bogen; er besteht aus zwei Bogenästen (Gewölbeformen). [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Im Kreuzgewölbe diagonal verlaufender gratiger, gekehlter oder berippter Bogen, der sich mit einem zweiten gleichgearteten Bogen oder auch mit einem Transversalbogen kreuzt. Zu unterscheiden vom Kreuzungsbogen. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Diagonalbogen</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">arc diagonal</skos:prefLabel>
        <skos:prefLabel xml:lang="en">diagonal arch</skos:prefLabel>
        <broaderByPosition rdf:resource="https://hist-arch-vocab.org/bvha#c_2026364f"/>
    </owl:NamedIndividual>
    


