@prefix dct: <http://purl.org/dc/terms/> .
@prefix ns1: <http://creativecommons.org/ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/100511> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/97294> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Modified Surface"@en ;
    skos:scopeNote "A monument where the evidence that defines the type of the monument derives from the nature of surface markings. Examples include graffitti on quarry walls."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/111133> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/99976> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Marine Magnetometer Reading"@en ;
    skos:scopeNote "Maritime monument identified as a ferrous object lying on the sea bed detected using marine surveying equipment that detects localised anomalies in the Earth's magnetic field."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/111153> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/82791> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Unstratified Find"@en ;
    skos:scopeNote "Monument whose presence is inferred by discovery of unstratified artefacts, for instance in plough soil."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/135585> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/82791> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Artefact Scatter"@en ;
    skos:scopeNote "A distribution of artefacts indicating the presence, or former presence, of a monument."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/139114> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/97294> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Wreckage"@en ;
    skos:scopeNote "The fragmentary or substantial remains of a vehicle or aircraft. Where recovered from excavation double index with SUB SURFACE DEPOSIT."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/140391> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/97293> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Oral Evidence"@en ;
    skos:scopeNote "A monument whose presence is inferred from verbally delivered information drawn from the speaker's personal knowledge."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/141908> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/141909>,
        <http://purl.org/heritagedata/schemes/eh_evd/concepts/84564> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Moved Building"@en ;
    skos:scopeNote "A building which has been moved from its original site either through active human intervention or natural processes such as erosion. For structures or objects such as gravestones use MOVED STRUCTURE."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/142975> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/97294> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Surface Deposit"@en ;
    skos:scopeNote "A deposit that forms the ground surface (when the evidence is collected), particularly a hard surface such as a floor or road."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/142985> a skos:Concept ;
    skos:altLabel "Partially Destroyed Monument"@en,
        "Ruined Structure  Bonded"@en,
        "Ruined Structure  Unbonded"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/84570> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Ruined Structure"@en ;
    skos:scopeNote "Manmade, roofless edifice or construction visible as substantial aboveground remains retaining evidence of architecture and materials, but which has been substantially destroyed."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/142986> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/84570> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Extant Structure"@en ;
    skos:scopeNote "Manmade roofless edifice or construction which is intact or substantially intact, with significant survival of original features, even if no longer serving original intended function."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/142987> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/84570> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Demolished Structure"@en ;
    skos:scopeNote "A monument consisting of a built structure, but which has been demolished so that only a ground plan and foundations, or similar, are thought to remain. Where all below ground traces have also been removed use DESTROYED MONUMENT."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/143015> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/97294> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Excavated Feature"@en ;
    skos:scopeNote "Feature visible following archaeological excavation"@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/143438> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/99976> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Multibeam Survey"@en ;
    skos:scopeNote "A marine survey in which a multielement transducer provides many (30150) individual soundings of the water depth and echo strength for each ping."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/146360> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/97293> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Marine Trawling Plot"@en ;
    skos:scopeNote "An object in the sea bed recorded on the Hydrographic Office plot of objects snagged by nets during trawling."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/151455> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/97294> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Designed Landscape"@en ;
    skos:scopeNote "A landscape which has been specifically designed or modified. Often indicated by proven below ground stratigraphy, revealed by deliberate investigation including geophysical survey, or other surface monuments or structures."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/167857> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/97294> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Environmental Evidence"@en ;
    skos:scopeNote "Evidence of past environmental conditions, eg insect, seed, pollen remains"@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/169985> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/97294> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Architectural Element"@en ;
    skos:scopeNote "An element such as a window, door or wall decoration, usually associated with a larger monument but which may be found in isolation. For example a stained glass window or panelling saved from a demolished building."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/170018> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/97294> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Movable Object"@en ;
    skos:scopeNote "An object such as an organ, display case or piece of furniture such as a pew, usually associated with a larger monument but which may be found in isolation. For example a war memorial roll of honour in its display case."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/170672> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/82791> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Destroyed Artefact"@en ;
    skos:scopeNote "Any portable artefact of any material which does not qualify as a monument or structure in its own right, and which has been destroyed accidentally or deliberately, either by natural processes or by human agency, such as the explosion of ordnance."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/171220> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/82792> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Magnetometer Reading"@en ;
    skos:scopeNote "A potential monument identified as a ferrous object detected using geophysical surveying equipment that detects localised anomalies in the Earth's magnetic field."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/78253> a skos:Concept ;
    skos:altLabel "Ap Enclosure"@en,
        "Ap Linear Feature"@en,
        "Ap Macula"@en,
        "Ap Site"@en,
        "Crop Mark"@en,
        "Parchmark"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/97294> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Cropmark"@en ;
    skos:scopeNote "Monument visible as a mark in standing crops or parchmarks, but where no subsurface deposits have been proven eg by excavation or other ground disturbance, in which case SUB SURFACE DEPOSIT should be used."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/82785> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/82799> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Buried Vessel Structure"@en ;
    skos:scopeNote "A maritime monument where the vessel remains are buried in the sea bed."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/82786> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/82799> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Coherent Vessel Structure"@en ;
    skos:scopeNote "A maritime monument where the hull structure and fabric of a vessel remain wholly or mainly intact."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/82787> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/82799> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Collapsed Vessel Structure"@en ;
    skos:scopeNote "A maritime monument where the fabric of a vessel has collapsed, leaving the hull structure flat on the sea bed but not widely dispersed."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/82788> a skos:Concept ;
    skos:altLabel "Cartographic Evidence"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/97293> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Documentary Evidence"@en ;
    skos:scopeNote "Monument known only from primary documentary sources eg books, maps, legal records, where no physical evidence exists. Use also where a monument has been planned but never constructed."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/82789> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/99976> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Echosounder Trace"@en ;
    skos:scopeNote "An object in the sea bed detected by marine survey equipment that shows the contours of the sea bed beneath a vessel."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/82793> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/82799> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Intact Vessel Structure"@en ;
    skos:scopeNote "A maritime monument where the hull of a vessel is mostly in one piece, with large pieces of the superstructure intact."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/82795> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/82799> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Scattered Vessel Structure"@en ;
    skos:scopeNote "A maritime monument where the remains of a vessel are scattered over a wide area."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/82796> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/82797> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Side Scan Sonar Contact"@en ;
    skos:scopeNote "An object projecting out of the sea bed detected by marine survey equipment that emits and receives high frequency sound waves projected sideways from a boat or towed array."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/82798> a skos:Concept ;
    skos:altLabel "Uncertain"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/82790> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Uncertain Evidence"@en ;
    skos:scopeNote "Current recorded information does not give the evidence for a monument, or the information is regarded as unreliable."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/84565> a skos:Concept ;
    skos:altLabel "Destroyed"@en,
        "Partially Destroyed Monument"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/82790> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Destroyed Monument"@en ;
    skos:scopeNote "All physical evidence for a monument has certainly been completely destroyed (allowing no future reinvestigation) by activity implying substantial ground disturbance. Eg quarrying, road cutting, or natural disaster, erosion, acts of God etc."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/84567> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/97294> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Enhanced Natural Feature"@en ;
    skos:scopeNote "Natural feature or area deliberately enhanced to construct a monument, eg rock carving, cave, rock shelter."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/84568> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/97294> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Natural Feature"@en ;
    skos:scopeNote "Monument thought to be archaeological or historical but proved to be natural."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/84571> a skos:Concept ;
    skos:altLabel "Subterranean"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/97294> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Subterranean Feature"@en ;
    skos:scopeNote "Monument visible as a below ground manmade structure. Use for tunnels, mineworking, cellars, shelters."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/84573> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/97293> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Conjectural Evidence"@en ;
    skos:scopeNote "Monument type/interpretation is inferred, based on informed speculation eg by comparison with similar monuments, proximity to other monuments, topography, site character etc."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/84574> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/97293> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Placename Evidence"@en ;
    skos:scopeNote "Use where the presence or nature of a monument is inferred from placenames or placename elements."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/87962> a skos:Concept ;
    skos:altLabel "Partially Demolished Building"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/84564> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Ruined Building"@en ;
    skos:scopeNote "Monument visible as substantial above ground remains, retaining evidence of architecture and materials, with walls partially or completely intact but with roof and interior walls substantially or completely destroyed."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/97291> a skos:Concept ;
    skos:altLabel "Building  Bonded"@en,
        "Building  Other"@en,
        "Building Complex"@en,
        "Inhabited Building"@en,
        "Partially Demolished Building"@en,
        "Partially Destroyed Monument"@en,
        "Roofed Building"@en,
        "Roofed Ruin"@en,
        "Uninhabited Building"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/84564> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Extant Building"@en ;
    skos:scopeNote "Monument with roof or walls intact or substantially intact, significant survival of original features, even if building no longer in use for original function."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/97296> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/97294> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Architectural Component"@en ;
    skos:scopeNote "Monument whose existence is inferred from the traces of architectural features. Eg include shadow marks on building walls or beams, pillars, floors incorporated into a later structure, suggesting the existence of an earlier building."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/99691> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/97294> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Botanical Feature"@en ;
    skos:scopeNote "A monument composed of plants or trees which are still extant. Especially relevant for park and garden features. For example tree avenue, orchard, rose garden and lawn."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/99982> a skos:Concept ;
    skos:altLabel "Ap Enclosure"@en,
        "Ap Linear Feature"@en,
        "Ap Macula"@en,
        "Ap Site"@en,
        "Soil Mark"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/97294> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Soilmark"@en ;
    skos:scopeNote "Monument visible, usually from the air, due to the fill of features being of a different colour than the surrounding subsoil. Soilmarks show up well in ploughed fields or areas where the topsoil has been stripped.  Term derived from AN32 Glossary"@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/100510> a skos:Concept ;
    skos:altLabel "Building Foundation"@en,
        "Partially Demolished Building"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/84564> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Demolished Building"@en ;
    skos:related <http://purl.org/heritagedata/schemes/eh_evd/concepts/84569> ;
    skos:scopeNote "A monument previously consisting of a built structure, but which has been demolished, such that only a ground plan and foundations or similar are thought to remain. Where all below ground traces have also been removed use DESTROYED MONUMENT."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/100512> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/82791> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Stratified Find"@en ;
    skos:related <http://purl.org/heritagedata/schemes/eh_evd/concepts/84569> ;
    skos:scopeNote "A Monument whose presence is inferred from artefacts found in stratified below ground deposits, as distinct from surface collection or chance find."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/141909> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/84570> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Moved Structure"@en ;
    skos:scopeNote "A manmade construction or object (such as a gravestone) which has been moved from its original site either through active human intervention or natural processes such as erosion. For buildings which have been moved use MOVED BUILDING."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/151454> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/97294> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Burial"@en ;
    skos:related <http://purl.org/heritagedata/schemes/eh_evd/concepts/84569> ;
    skos:scopeNote "The deliberate deposit of a body in the ground, usually located in a special area set aside for the purpose of burial, such as a graveyard or cemetery."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/78252> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/97294> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
    skos:prefLabel "Earthwork"@en ;
    skos:scopeNote "Monument existing as an upstanding earthwork, ditch or artificial watercourse, or as a low stone built feature not covered by the other categories."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/82792> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_evd/concepts/97293> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_evd> ;
