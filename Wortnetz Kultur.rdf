	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk013827">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Schaft (Webgerät)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Schäfte (Webgeräte)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk018661"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013760"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk018661"/>
		<skos:definition xml:lang="de">Ein Schaft ist ein rahmenartiger Bestandteil von Webstühlen, der mit Litzen versehen ist, durch die die Kettfäden verlaufen. Mit dem Schaft können die Kettfäden gruppenartig gehoben und gesenkt werden, um das Fach zu bilden, durch welches das Weberschiffchen geführt wird.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk013760"/>
