	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1948">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1948</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">SLOC ÈADHRACHAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Sloc a chaidh a dhealbhadh airson adhar a chuairteachadh tro structar fon talamh air dòigh iomchaidh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">VENTILATION SHAFT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
