    <!-- https://hist-arch-vocab.org/bvha#c_xh1ezgu0 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_xh1ezgu0">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0f62a529"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_028abf0f"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_e8b8196b"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-24T16:03:41.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-31T00:18:18.000</terms:modified>
        <skos:altLabel xml:lang="cs">tabernákl</skos:altLabel>
        <skos:definition xml:lang="cs">SVATOSTÁNEK, kamenná schránka k uchovávání posvěcené hostie, většinou na evangelijní straně vedle oltáře; zamřížovaná nika, nebo - v gotice - samostatná ozdobná stavba na soklu s bohatým nástavcem, až 28 m vysoká (Ulm). Tridentský koncil (1545-63) nařídil uchovávat hostii v tabernáklu na oltáři, čímž se svatostánek stal zbytečný, Druhý vatikánský koncil (1962-65) jeho použití opět povolil. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Sakramentshaus, ein turmartiges Bauwerk, das aus einem Fuß, einem Überleitungselement (Korb), dem Gehäuse und einem bekrönenden Baldachin besteht, seltener nur eine Wandnische (Sakramentsnische) an der Nordwand des Chorraums. Das S. diente zur Aufbewahrung der Hostien, Kelche und liturg. Gefäße und wurde in spätgot. Zeit bes. prunkvoll ausgebildet. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Steinernes Gehäuse zur Aufbewahrung der geweihten Hostie, meist auf der Evangelienseite neben dem Altar. Vergitterte Nische oder - in der Gotik - freistehendes zierliches Gebäude auf einem Sockel, mit reichem Gesprenge, bis 28 m hoch (Ulm). Das Tridentinum, 1545-63, ordnet die Unterbringung der Hostie im Tabernakel auf dem Altar an und macht das Sakramentshaus überflüssig. Das 2. Vaticanum, 1962-65, lässt seinen Gebrauch wieder zu. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Sakramentshaus</skos:prefLabel>
        <skos:prefLabel xml:lang="it">edicola del sacramento</skos:prefLabel>
        <skos:prefLabel xml:lang="es">sagrario</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">svatostánek</skos:prefLabel>
        <skos:prefLabel xml:lang="en">tabernacle</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">tabernacle</skos:prefLabel>
    </owl:NamedIndividual>
    


