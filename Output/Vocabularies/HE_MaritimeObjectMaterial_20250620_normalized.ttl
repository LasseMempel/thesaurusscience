    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Graphite"@en ;
    skos:scopeNote "Crystalline allotropic form of carbon used in pencils, as a lubricant etc."@en .

<http://purl.org/heritagedata/schemes/73/concepts/142973> a skos:Concept ;
