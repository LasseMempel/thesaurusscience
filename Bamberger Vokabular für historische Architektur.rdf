        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-16T10:24:28.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-05T10:24:24.000</terms:modified>
        <skos:altLabel xml:lang="de">Kreisbogen</skos:altLabel>
