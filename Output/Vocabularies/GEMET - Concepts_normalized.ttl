    skos:closeMatch <http://data.uba.de/umt/_00014613>,
        <http://dbpedia.org/resource/Aromatic_hydrocarbon> ;
    skos:definition "Hydrocarbons having an unsaturated ring containing alternating double and single bonds, especially containing a benzene ring."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_28994> ;
