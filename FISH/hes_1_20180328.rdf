		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1026" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1027">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1027</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">CASAN-TOGAIL</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Structar sa bheil dà rongas dìreach a tha ceangailte aig a' bharr, a' dèanamh triantan, le acainn togail a' crochadh on bharr. Thathar ga chleachdadh gus carago is cudroman eile a thogail.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">SHEER LEGS</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1018" />
				<skos:scopeNote xml:lang="en">A structure comprising two upright spars, joined at the top to form a triangle, with a hoisting tackle suspended from the apex. Used to lift cargo or other weights.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
