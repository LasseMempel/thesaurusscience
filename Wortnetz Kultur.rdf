	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004237">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">dry ditch</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Trockenrinne</skos:prefLabel>
		<skos:altLabel xml:lang="de">Trockenrinnen</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004346"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk016334"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004346"/>
		<xe:explanation_temp xml:lang="de">Typisch sind Trockenrinnen in Gebieten mit sehr durchlässigem Boden, wo das Niederschlagswasser in der Regel schneller versickert als es oberirdisch abfließt.</xe:explanation_temp>
		<skos:definition xml:lang="de">Eine Trockenrinne ist in der Geologie ein Geländeeinschnitt, der nur zeitweise bei hohem Niederschlagsaufkommen Wasser führt.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004346"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk016334"/>
