		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/81" />
		<skos:scopeNote xml:lang="en">A building used primarily for the storage of hay, grain and farm equipment, or as a shelter for livestock. Use more specific type where known.</skos:scopeNote>
