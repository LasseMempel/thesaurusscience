    <!-- https://hist-arch-vocab.org/bvha#c_imrbnvf1 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_imrbnvf1">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0cb8deb1"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
