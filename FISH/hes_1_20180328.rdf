		<skos:prefLabel xml:lang="gd">TAIGH-TIDSEIR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite-còmhnaidh tidseir, gu tric air raon na sgoile.</skos:scopeNote>
