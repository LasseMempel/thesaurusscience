		<skos:prefLabel xml:lang="fr">poivrons (légumes)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Spanischer Pfeffer</skos:altLabel>
		<skos:altLabel xml:lang="de">Süßpaprika</skos:altLabel>
		<skos:altLabel xml:lang="de">sweet pepper</skos:altLabel>
		<skos:altLabel xml:lang="de">Tomatenpaprika</skos:altLabel>
		<skos:altLabel xml:lang="de">Türkischer Pfeffer</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk011133"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk015315"/>
