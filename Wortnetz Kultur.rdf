	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021064">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Fragment (Dokument)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Fragmente (Dokumente)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006010"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk006010"/>
		<skos:definition xml:lang="de">Ein Fragment ist ein unvollständiges Dokument mit künstlerischem oder wissenschaftlichem Inhalt, in der Regel in Form von Text, Noten oder Bildern. Fragmente können nicht vollendete Werke sein oder Werke, die nur bruchstückhaft überliefert sind.</skos:definition>
