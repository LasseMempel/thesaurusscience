	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004973">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">teakettle</skos:prefLabel>
		<skos:altLabel xml:lang="en">teakettles</skos:altLabel>
		<skos:prefLabel xml:lang="de">Wasserkessel</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk005003"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013703"/>
