        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/824> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/995> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/662> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Light blue alphabets"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/69> ;
    skos:scopeNote "A type of archaic alphabet that gathers common features of the alphabets of Attica, Aegina, the Ionian islands of the Cyclades (Sifnos, Paros, Naxos, Delos and Paros Thassos). The name of the alphabet was established in 1887 by Adolf Kirchhoff."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1027> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/618> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Drawings"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2005>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2013>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2024> ;
    skos:scopeNote "Drawings are essentially images depicted on a surface by making lines. Drawings can also contain tonal areas, washes and other non-linear marks."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1045> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/381> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Μanumission inscriptions"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Inscriptions bearing a part or the whole of the guarantee document drawn up by slave owners, in order to grant them their freedom."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1069> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/584> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Laws (Public inscriptions)"@de ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1862>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2354>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Inscriptions that record rules on issues of the public and private life of citizens. The laws were originally formulated by lawmakers, such as Dragon, the first legislator. Later, they were approved by the Αssembly of citizens (Ecclesia)."@en .

