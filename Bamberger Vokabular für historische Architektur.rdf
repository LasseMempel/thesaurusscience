    <!-- https://hist-arch-vocab.org/bvha#c_6dac28ef -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_6dac28ef">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f651ce64"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_41d5444e"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_4905b6b1"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_ada7f90c"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_c120bfaa"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_d3a22441"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-27T23:08:06.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T12:31:44.000</terms:modified>
        <skos:altLabel xml:lang="de">Fischblase</skos:altLabel>
        <skos:altLabel xml:lang="de">Mouchette</skos:altLabel>
        <skos:altLabel xml:lang="en">mouchette</skos:altLabel>
        <skos:altLabel xml:lang="cs">okenní skulina v gotické kružbé</skos:altLabel>
        <skos:altLabel xml:lang="cs">plamenec (kružba)</skos:altLabel>
        <skos:definition xml:lang="de">Fischblase, Element des gotischen Maßwerks, einer Fischblase ähnlich (seit 14. Jh.) oder flammenartig gelängt (Flamboyant). [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Fischblase, Schneuß, ein im spätgot. Maßwerk häufig vorkommendes Ornamentmotiv, das dem Umriss der Schwimmblase der Fische ähnelt. Die F. kann auch S-förmig geschwungen und in Gruppen angeordnet sein. Die F.n in einem Kreis zusammengestellt ergeben z.B. eine Wirbelform, den sog. Dreischneuß. In der frz. und engl. Spätgotik ist die geschwungene F. in die Länge gezogen, so dass sie eher einer Flamme gleicht, weshalb in Frankreich die ganze Spätgotik &gt;Style flamboyant&lt; (geflammter Stil) genannt wird. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Prvek gotické kružby připomínající tvarem rybí měchýř (od 14. stol.), nebo plaménkovitě protažený, rybí měchýř, flamboyant. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Schneuß, Fischblase, Mouchette (engl. Karnieshobel); ein Zweiblatt, bei dem ein Blatt kürzer als das andere ist; häufig ist das kleinere kielbogenartig ausgebildet und die Nasen kommen sehr eng zusammen. Das S. kann auch S-förmig geschwungen sein und so einer Fischblase ähnl. sehen. Drei S.e in einem Kreis zusammengestellt ergeben eine Wirbelform, das Dreis. Im spätgot. Maßwerk seit Anfang des 14. Jhs. in England, Frankreich und Deutschland weitverbreitet. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Schneuß</skos:prefLabel>
        <skos:prefLabel xml:lang="en">bladder ornament</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">flamme</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">plamének</skos:prefLabel>
        <skos:prefLabel xml:lang="es">tracería burbuja de pez</skos:prefLabel>
        <skos:prefLabel xml:lang="it">vescica di pesce</skos:prefLabel>
    </owl:NamedIndividual>
    


