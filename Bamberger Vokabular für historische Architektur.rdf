        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_5528bc85"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_edb5b0ad"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-10T18:28:22.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T23:53:57.000</terms:modified>
        <skos:altLabel xml:lang="de">Choraltar</skos:altLabel>
        <skos:definition xml:lang="de">Choraltar, der im Chorraum einer Bischofs-, Kloster- oder Pfarrkirche stehende Hauptaltar im Unterschied zu den in den Seitenkapellen, am Lettner, im Kirchenschiff usw. aufgestellten Nebenaltären. Er ist durch Größe und Ausschmückung hervorgehoben. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Hauptaltar</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Der in der Liturgie am Häufigsten genutzte Altar. </skos:scopeNote>
    </owl:NamedIndividual>
    


