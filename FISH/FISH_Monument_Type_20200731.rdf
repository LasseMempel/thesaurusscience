  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71364">
    <skos:scopeNote xml:lang="en">A hotel adjacent to a railway terminus. Railway hotels were often owned by a railway company.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143002">
    <skos:scopeNote xml:lang="en">A civil and administrative area incorporating a town of medieval origin.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160541">
