        <skos:altLabel xml:lang="cs">grafiti</skos:altLabel>
        <skos:definition xml:lang="de">Einritzen, Kratzen, Schneiden oder Aufsprühen von Farbe, Tinte oder ähnlichem auf die Steinoberfläche.[ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="en">Engraving, scratching, cutting or application of paint, ink or similar matter on the stone surface. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="fr">Forme d’altération superficielle résultant d’une incision, rayure ou application de peinture, encre ou matériau assimilé. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="cs">Rytí, škrábání, vyřezávání nebo nanesení barvy,inkoustu nebo podobné hmoty na kamenný povrch;malba sprejem na zeď. [ICOMOS-ISCS]</skos:definition>
        <skos:prefLabel xml:lang="de">Graffiti</skos:prefLabel>
        <skos:prefLabel xml:lang="en">graffiti</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">graffiti</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">vandalské značkování</skos:prefLabel>
    </owl:NamedIndividual>
    


