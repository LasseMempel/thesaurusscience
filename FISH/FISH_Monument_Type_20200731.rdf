    <skos:scopeNote xml:lang="en">A small works used for the production of agricultural tools such as hay rakes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93088">
