    <!-- https://hist-arch-vocab.org/bvha#c_3b32f219 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_3b32f219">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_3e25acca"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_eea5235b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_1ea9614d"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_e7720183"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_269b3c4a"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_ad231bbf"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T20:10:25.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T13:27:49.000</terms:modified>
        <skos:altLabel xml:lang="de">Gurt</skos:altLabel>
        <skos:altLabel xml:lang="de">Querbogen</skos:altLabel>
        <skos:altLabel xml:lang="de">Quergurt</skos:altLabel>
        <skos:altLabel xml:lang="de">Transversalbogen</skos:altLabel>
        <skos:altLabel xml:lang="cs">příčný klenební pas</skos:altLabel>
        <skos:definition xml:lang="de">Der quer zur Längsachse eines Gewölbes verlaufende konstruktive oder gliedernde Bogen. Er kommt hauptsächl. beim Tonnen- und beim Kreuzgewölbe vor und kann sichtbar an der Gewölbelaibung (Untergurt) oder am Gewölberücken (Obergurt) vortreten. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Dlouhé klenby bývají často klenebními pasy, které probíhají kolmo k hlavní ose prostoru (příčné pasy), rozděleny do jednotlivých klenebních polí. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Quer zur Längsachse eines Gewölbes gespannter Verstärkungsbogen, z. B. in einem Tonnengewölbe. Man unterscheidet zwischen dem an der Gewölbeleibung sichtbaren Untergurt und dem nur über dem Gewölberücken gespannten Obergurt. Gurtbogen haben neben konstruktiver auch gliedernde Funktion. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Quer zur Längsachse eines Raumes gespannter Entlastungsbogen. [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Verstärkungsbogen, der quer zur Längsachse eines Tonnengewölbes oder einer Gewölbereihung verläuft, markiert die Jocheinteilung. Längsgurte begrenzen die Joche seitlich. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="es"> arco transversal</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Gurtbogen</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">arc doubleau transversal</skos:prefLabel>
        <skos:prefLabel xml:lang="it">arcone transversale</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">klenební pas</skos:prefLabel>
        <skos:prefLabel xml:lang="en">transverse arch</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_3e25acca"/>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_eea5235b"/>
    </owl:NamedIndividual>
    


