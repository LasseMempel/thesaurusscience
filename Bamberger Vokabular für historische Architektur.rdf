    <!-- https://hist-arch-vocab.org/bvha#c_0c96cb38 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_0c96cb38">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_c4eed245"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-21T13:44:57.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T15:50:32.000</terms:modified>
        <skos:definition xml:lang="de">Unterste Schicht des aufgehenden Mauerwerks eines Gebäudes, die aus größeren und manchmal hochkant gestellten Steinen  besteht, beim gr. Tempelbau die Schicht über dem Mauerfuß, die den Sockel der Cella bildet und von einer Abdeckplatte abgeschlossen ist. In der Baukunst Mesopotamiens und der Hethiter war nur das 0. aus Stein und meist mit Reliefs geschmückt. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="en"> orthostat</skos:prefLabel>
        <skos:prefLabel xml:lang="it"> ortostata</skos:prefLabel>
        <skos:prefLabel xml:lang="es"> sócalo de la cella</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Orthostat</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">orthostate</skos:prefLabel>
    </owl:NamedIndividual>
    


