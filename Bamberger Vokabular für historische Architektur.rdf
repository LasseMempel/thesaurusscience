        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-14T17:03:06.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T14:05:34.000</terms:modified>
        <skos:definition xml:lang="de">Speicher der skandinav. Bauernhäuser, meist auf Pfählen stehende Blockbauten. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Stabbur</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_7e0ec234 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_7e0ec234">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
