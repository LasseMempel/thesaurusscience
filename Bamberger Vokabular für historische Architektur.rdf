        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-23T12:58:16.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T12:13:52.000</terms:modified>
        <skos:definition xml:lang="de">Lady Chapel (engl. Kapelle Unserer Lieben Frau), Marienkapelle in englischen Kathedralen, meist mit rechteckigem Grundriss und meist an den Scheitel des Ostchores angesetzt (Scheitelkapelle). [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Lady Chapel, angl. kaple Macky boží), kaple P. Marie v anglických katedrálách, většinou obdélníkového půdorysu, většinou v závěru východního chóru (kaple v závěru chóru, Salisbury). [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Lady Chapel, der Maria geweihte und nach außen vorstehende Scheitelkapelle am Ostende einer engl. Kathedrale. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="cs">Lady Chapel</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Lady Chapel</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_a5f0b363"/>
    </owl:NamedIndividual>
    


