		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk001083"/>
		<skos:definition xml:lang="de">Ein Feuchtgebiet ist eine Landschaft, die stark durch Gewässer geprägt ist und einen zeitweilig oder ständig hohen Feuchtegehalt des Bodens aufweist.</skos:definition>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300008899"/>
