	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk012197">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Takenplatte</skos:prefLabel>
		<skos:altLabel xml:lang="de">Takenplatten</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006915"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk014720"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk006915"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk005602"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk003366"/>
		<skos:definition xml:lang="de">Eine Takenplatte ist ein Bauteil, das als gusseiserne Platte zwischen dem Herd der Küche und dem Wohnzimmer in Mauern eingesetzt ist, so dass die im Küchenherd erzeugte Wärme auch für die Heizung des Wohnzimmers genutzt werden kann. Diese Platten sind auf der Zimmerseite durch Reliefdarstellungen verziert.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4237174-0"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk006915"/>
