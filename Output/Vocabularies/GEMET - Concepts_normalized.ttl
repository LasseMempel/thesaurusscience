<http://www.eionet.europa.eu/gemet/concept/3431> a skos:Concept ;
    skos:broadMatch <http://eurovoc.europa.eu/651> ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3439> ;
    skos:definition "Forests produce a range of products including firewood and charcoal, lumber, paper, and crops such as coffee, oil palm, and rubber. With careful planning of growth and harvesting, wood and other forest products are, in principle, renewable resources. But achieving renewability takes time - often decades, sometimes centuries. Without careful management, pressure for short-term exploitation can lead to tree removal, soil degradation, and conversion of woodland to other uses. Consumption of forest resources can lead to environmental problems as well as loss of critical habitat and species."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:narrowMatch <http://eurovoc.europa.eu/2994> ;
    skos:prefLabel "Forstwirtschaftliche Produktion"@de,
        "forest production"@en .

<http://www.eionet.europa.eu/gemet/concept/3437> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7169> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bewertung der Waldressourcen"@de,
        "forest resource assessment"@en .

<http://www.eionet.europa.eu/gemet/concept/3441> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3442> ;
    skos:closeMatch <http://data.uba.de/umt/_00010075> ;
    skos:definition "A binding rule or body of rules prescribed by a government to regulate any extensive area of woodland, for the protection and preservation of game, timber and other forest resources."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/563> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Forstgesetz"@de,
        "forestry law"@en .

<http://www.eionet.europa.eu/gemet/concept/3460> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3026> ;
