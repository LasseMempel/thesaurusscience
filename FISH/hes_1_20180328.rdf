		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1230" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1014" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1080" />
		<skos:scopeNote xml:lang="en">Steam engine, usually, driving a centrifugal fan to provide an air blast for a blast furnace.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1232">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1232</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH EINNSEAN-EICH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach cruinn, ceàrnagach no ioma-cheàrnach sa bheil einnsean eich. Gheibhear seo air tuathanasan mar is trice, ri taobh an t-sabhail-bhualaidh far a bheil e a' gintinn cumhachd dhan innealra.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HORSE ENGINE HOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1230" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1212" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1213" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1237" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/17" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/807" />
		<skos:scopeNote xml:lang="en">A round, square or polygonal building that contains a horse engine. Commonly found on farms next to the threshing barn, where it is used to power the machinery.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1233">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1233</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH EINNSEAN-SMÙIDE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach sa bheil einnsean-smùide.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">STEAM ENGINE HOUSE</skos:prefLabel>
