    <!-- https://hist-arch-vocab.org/bvha#c_3664b4d9 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_3664b4d9">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_438111ab"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_871503e4"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_e02fc4c5"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_f592f958"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_5204de19"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-04T14:12:09.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T22:48:55.000</terms:modified>
        <skos:altLabel xml:lang="en">candelabrum</skos:altLabel>
        <skos:altLabel xml:lang="la">candelabrum</skos:altLabel>
        <skos:altLabel xml:lang="el">kerostates</skos:altLabel>
        <skos:altLabel xml:lang="el">manoyalion</skos:altLabel>
        <skos:definition xml:lang="de">Kandelaber (lat. candelabrum), Kerzenständer. Seit der Antike in zahlreichen Formen: als siebenarmiger Leuchter (hebräisch Menora, jüdischer Kultleuchter, in der christlichen Kirche als Symbol der Erfüllung des Alten Testaments); als achtarmiger Leuchter (hebräisch Chanukka = Tempelweihe, Symbol des Judentums; ein 9. Licht = Schames dient als Anzünder); mit einer menschlichen Gestalt als Kerzenträger; als Osterleuchter usw. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Kandelaber m; gr. polykerion; manoyalion; kerostates; lat. candelabrum; polycandilum: ein hoher Standleuchter mit säulenartigem, reich dekorierten Schaft, von dem oft mehrere Arme nach allen Seiten ausgehen. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="cs">Lat. candelabrum, stojan na svíce, od antických dob se vyskytuje v nejrůznějších tvarech: jako sedmiramenný svícen (hebr. menora, židovský kultovní svícen, v křesťanské církvi jako symbol naplnění Starého zákona), jako osmiramenný svícen (hebr. chanuka= posvěcení chrámu, židovský symbol, deváté světlo = šames slouží k zapálení), jako svícen s lidskou postavou jako nositelem svící, velikonoční svícen atd. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Kandelaber</skos:prefLabel>
        <skos:prefLabel xml:lang="en">candelabra</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">candélabre</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kandelábr</skos:prefLabel>
        <skos:prefLabel xml:lang="la">polycandilum</skos:prefLabel>
        <skos:prefLabel xml:lang="el">polykerion</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_36751d31 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_36751d31">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_5ogzoa7b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_5bf6bcac"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-15T12:43:09.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T18:08:31.000</terms:modified>
        <skos:definition xml:lang="de">Gebrauchter Mauerziegel aus einem Bauwerk, das im Rahmen eines selektiven Rückbaus in seine Einzelteile zerlegt wird und danach wieder für Neubauten oder für die Restaurierung von Altbauten Verwendung finden kann. [Schrader / Voigt 2003]</skos:definition>
        <skos:prefLabel xml:lang="de">Abbruchziegel</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_36782565 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_36782565">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_c782f146"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_5dd67053"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-10T18:04:33.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T23:58:13.000</terms:modified>
        <skos:definition xml:lang="de">Das Reliquiendepositorium im Altar, entweder in der Mensaplatte oder in der Stipes. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Reliquiengrab in einem Altar. </skos:definition>
        <skos:definition xml:lang="cs">SEPULCRUM (lat. hrob) = relikviář. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Sepulcrum</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">sepulcrum</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_367871ef -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_367871ef">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_64dd3656"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
