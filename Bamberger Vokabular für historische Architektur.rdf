        <skos:altLabel xml:lang="fr">coupole pointue</skos:altLabel>
        <skos:definition xml:lang="de">Kuppel mit der Wölblinie eines Spitzbogens. Zu unterscheiden von der Steilkuppel. (Glossarium Artis)</skos:definition>
        <skos:prefLabel xml:lang="de">Spitzkuppel</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">coupole brisée</skos:prefLabel>
        <skos:prefLabel xml:lang="en">pointed dome</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_ad800342"/>
    </owl:NamedIndividual>
    


