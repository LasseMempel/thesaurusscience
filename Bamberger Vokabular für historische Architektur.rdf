    <!-- https://hist-arch-vocab.org/bvha#c_449295d4 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_449295d4">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1d49f89c"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
