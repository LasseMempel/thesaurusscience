        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-25T16:04:05.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T16:57:56.000</terms:modified>
        <skos:altLabel xml:lang="de">Situla</skos:altLabel>
        <skos:altLabel xml:lang="de">Weihwasserkessel</skos:altLabel>
        <skos:altLabel xml:lang="en">holy water bucket </skos:altLabel>
        <skos:altLabel xml:lang="la">urceolus</skos:altLabel>
        <skos:altLabel xml:lang="la">vas ad aquam benedictam </skos:altLabel>
        <skos:altLabel xml:lang="la">vas lustrale</skos:altLabel>
        <skos:definition xml:lang="de">Aspersorium n (lat.); Weih(wasser)kessel m; auch Situla f (lat.); Weihwassereimer m; lat. aspergitorium; vas aquae benedictae; urceolus; vas lustrale:ein Eimer für das bei den liturgischen Besprengungen benötigte Weihwasser. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Aspersorium</skos:prefLabel>
        <skos:prefLabel xml:lang="la">aspergitorium</skos:prefLabel>
        <skos:prefLabel xml:lang="en">aspersorium</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">bénitier</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_5ogzoa7b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_5ogzoa7b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_2pqtnskw"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_jqmv6iaq"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_0cb8deb1"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_36751d31"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_7becmxjs"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_89bb0645"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-07T14:22:43.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T20:07:29.000</terms:modified>
        <skos:altLabel xml:lang="de">Backstein</skos:altLabel>
        <skos:definition xml:lang="de">Altes Mauerziegelformat, z.B. als Holsteiner Acht-Zoll-Format 190 x 90 x 40 mm. [Schrader / Voigt 2003]</skos:definition>
        <skos:definition xml:lang="de">Backstein, (lat. later), aus Ton oder Lehm geformter Baustein, der im Unterschied zum luftgetrockneten B. durch Brennen gehärtet und wetterfest gemacht ist, meist längsrechteckiges Format, dessen Größe sich aus den jeweiligen techn. Gegebenheiten und aus traditionellen Verfahren in den Verbreitungsgebieten ergibt. Die Farbe hängt von der chem. Zusammensetzung des Rohmaterials und von der Brenntemperatur ab, auch farbige Glasuren sind möglich. Zur Verbindung von Backsteinen zu Mauern s. Mauerwerk, zur Verwendung als Dachdeckung s. Ziegel. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Cihla z jílu nebo hlíny, tvrzená proti meteorologickým vlivům (pále­ná). [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Ziegelstein, Ziegel, aus Ton oder Lehm wetterfest gehärtet (gebrannt). [Koch 2009]</skos:definition>
        <skos:editorialNote xml:lang="de">Bitte Begriffe für &quot;Ziegel&quot; (Dachziegel) und &quot;Backstein&quot; genau umgekehrt verwenden - hier auch die narrower nachführen (TAR)</skos:editorialNote>
        <skos:prefLabel xml:lang="de">Ziegel</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">cihla</skos:prefLabel>
    </owl:NamedIndividual>
    


