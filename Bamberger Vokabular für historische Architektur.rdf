        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T13:45:24.000</terms:modified>
        <skos:altLabel xml:lang="en">mitra aurifrygiata</skos:altLabel>
        <skos:altLabel xml:lang="cs">mitra auriphrygiata</skos:altLabel>
        <skos:altLabel xml:lang="fr">mitre dorée</skos:altLabel>
        <skos:altLabel xml:lang="fr">mitre orfrayée</skos:altLabel>
        <skos:altLabel xml:lang="en">orphreyed mitre</skos:altLabel>
        <skos:definition xml:lang="de">Mitra auriphrygiata f: aus Goldbrokat oder bestickter weißer Seide gefertigte, mit Goldborte gezierte Mitra. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Mitra auriphrygiata</skos:prefLabel>
        <skos:prefLabel xml:lang="en">golden mitre</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">mitra auriphrygiata</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">mitra protkávaná zlatem</skos:prefLabel>
