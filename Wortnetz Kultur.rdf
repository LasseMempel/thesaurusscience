		<skos:altLabel xml:lang="de">Heimatvertriebener</skos:altLabel>
		<skos:altLabel xml:lang="de">Ostvertriebener</skos:altLabel>
		<skos:altLabel xml:lang="de">Vertriebene</skos:altLabel>
		<skos:prefLabel xml:lang="de">Vertriebener</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk008973"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk006926"/>
