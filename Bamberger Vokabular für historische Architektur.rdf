        <skos:definition xml:lang="cs">Chrám, jehož cella je obklopena sloupovým ochozem. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Peripteraltempel, Tempel mit einer von einem Umgang (Pteron) umgebenen Cella. [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Tempel, dessen Cella von einem Säulenkranz umgeben ist. [Koch 2009]</skos:definition>
