	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/19">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/19</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">SABHAL GOBHAL-CHEANGALACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Sabhal le paidhear mhaidean an cruth A agus iad lùbte gus am mullach a chumail suas gun taic o na ballachan.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CRUCK FRAMED BARN</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
