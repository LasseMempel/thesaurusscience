	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1299">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1299</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">STÒR LÌN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach far an cumar lìon mus deach a ghiullachd.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">FLAX STORE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1296" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/922" />
		<skos:scopeNote xml:lang="en">A building where flax is stored before processing.</skos:scopeNote>
