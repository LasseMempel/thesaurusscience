        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_fdf5a8a5"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-22T09:32:34.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T16:39:45.000</terms:modified>
        <skos:altLabel xml:lang="de">Pontificale romanum</skos:altLabel>
        <skos:altLabel xml:lang="la">liber episcopalis </skos:altLabel>
        <skos:altLabel xml:lang="la">liber ministerialis</skos:altLabel>
        <skos:altLabel xml:lang="la">ordinarium episcopi</skos:altLabel>
        <skos:definition xml:lang="de">Pontifikale n, Pontificale romanum n, liber pontificalis, liber episcopalis, liber ministerialis, ordinarium episcopi: Buch mit den Texten und rituellen Anweisungen für alle den Bischöfen obliegenden liturgischen Funktionen (Firmung und Ordination, Weihe und Benediktion von Personen und Sachen, Visitationen usw.); zu unterscheiden vom Liber pontificalis als der Lebensbeschreibung von Päpsten. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Pontifikale</skos:prefLabel>
        <skos:prefLabel xml:lang="la">liber pontificalis</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">pontifical</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">pontifikál</skos:prefLabel>
    </owl:NamedIndividual>
    


