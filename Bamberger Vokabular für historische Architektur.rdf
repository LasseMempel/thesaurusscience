        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0ea453f7"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-06T12:42:05.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T15:11:02.000</terms:modified>
        <skos:altLabel xml:lang="de">Mastenkirche</skos:altLabel>
        <skos:altLabel xml:lang="cs">sloupkový kostel s vnitřními podporami</skos:altLabel>
        <skos:definition xml:lang="de">Skandinav. Holzkirche, deren konstruktives Gerüst aus Masten besteht (Stabbau). Der Innenraum ist relativ klein und durch die Masten verstellt. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Skandinavische Holzkirche, vermutlich eine Nachform der nordischen Königshalle. Nach der Bauweise der Wände aus senkrechten, mastenähnlichen Pfosten und Planken auch Mastenkirche genannt. Stufige Dächer. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Z norštiny stavkirke. Skandinávský dřevěný kostel, patrně na základě nordické královské haly. Podle způsobu stavby stěn ze svislých sloupků a fošen zvaný též sloupkový kostel s vnitřními podporami. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Stabkirche</skos:prefLabel>
        <skos:prefLabel xml:lang="it">chiesa lignea norvegese</skos:prefLabel>
        <skos:prefLabel xml:lang="es">iglesia escandinava empalizada</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">sloupkový kostel</skos:prefLabel>
        <skos:prefLabel xml:lang="en">stave church</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">stavkirke</skos:prefLabel>
    </owl:NamedIndividual>
    


