    <!-- https://hist-arch-vocab.org/bvha#c_ne734chh -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_ne734chh">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_e5eb81f8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_2d098355"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_3d983f36"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_70415aed"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_7a0c7ef3"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_8599e5fd"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_a163d2b0"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_2e6f0e40"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-06T11:22:30.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T11:23:41.000</terms:modified>
        <skos:altLabel xml:lang="de">Kruzifixus</skos:altLabel>
        <skos:altLabel xml:lang="la">crux exemplata</skos:altLabel>
        <skos:altLabel xml:lang="en">rood</skos:altLabel>
        <skos:definition xml:lang="de">Kruzifix (lat. crucifixus = der Gekreuzigte), gemalte oder plastische Darstellung Jesu am Kreuz. Crux = Kreuz ohne den Leib Christi. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Kruzifix n; gr. estayromenos; lat. crucifixus; crux exemplata: ein Kreuz mit der Darstellung bzw. der plastischen Nachbildung des gekreuzigten Christus. In der karolingischen Kunst wurde Christus als Lebender und Leidender mit geöffneten Augen dargestellt, in ottonischer Kunst seit dem Ende des 10. Jh. dann meist als Toter mit geschlossenen Augen (Beispiel: Gero-Kruzifix, Köln, um 970). [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="cs">Lat. crucifixus = ukřižovaný. Malované nebo plastické znázornění Ježíše na kříži, crux = kříž, bez Kristova těla. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Kruzifix</skos:prefLabel>
        <skos:prefLabel xml:lang="en">crucifix</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">crucifix</skos:prefLabel>
        <skos:prefLabel xml:lang="la">crucifixus</skos:prefLabel>
        <skos:prefLabel xml:lang="el">estayromenos</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">krucifix</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_nskxcexd -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_nskxcexd">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_6975d802"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_4d7d769a"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_689b3384"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_841edb00"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_8c4139d7"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_964b67ec"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_cf2c1992"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_f718d208"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_a5fccf1b"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_baad22f3"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-21T17:34:03.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T15:54:21.000</terms:modified>
        <skos:altLabel xml:lang="de">Kragstein</skos:altLabel>
        <skos:altLabel xml:lang="de">Tragstein</skos:altLabel>
        <skos:altLabel xml:lang="es">cartela</skos:altLabel>
        <skos:altLabel xml:lang="fr">corbeau</skos:altLabel>
        <skos:altLabel xml:lang="en">corbel</skos:altLabel>
        <skos:altLabel xml:lang="it">modiglione</skos:altLabel>
        <skos:altLabel xml:lang="es">ménsula</skos:altLabel>
        <skos:definition xml:lang="de">(frz. console aus consolateur ›Tröster, Helfer‹, auch ›Stützpfeiler‹) Vorkragender oder einem Dienst aufgelegter Tragstein. K.n können entweder Friese (Rundbogenfries, K.n-Fries) oder auch einzelne Standfiguren tragen. Im Burgenbau kommen sie besonders häufig an den steinernen Kaminen der Wohn- und Repräsentationsräume vor (Burg Neipperg BW). Als auffallendes Konstruktionsglied war die K. ähnlich wie das Kapitell Träger von baukünstlerischem Schmuck (Chambord F). B. Sch.-W. . [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:definition xml:lang="de">Aus der Mauer vorspringender Tragstein (Kragstein) für Balkone, Figuren, Balken, Dienste usw., bei Holzbau (Fachwerk) auch Knagge genannt. Oft ornamental oder mit - häufig grotesken - Figuren geschmückt. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Ein aus der Wand vorkragender, häufig profilierter oder mit figürlichen Skulpturen dekorierter Stein, der im Gewölbebau z. B. einen Dienst oder eine Rippe aufnehmen kann. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Konsole (frz.), vorspringendes Tragelement, im Steinbau ein Kragstein (Kraft-, Not- oder Balkenstein), auf dem ein Bogen, ein Gesims (K.ngesims), Skulpturen, Balken, Balkone, Erker, Dienste, Gewölbeanfänger u. dergl. ruhen. Eine nur zur Unterstützung von Diensten und Gewölbeanfängern vorkommende Sonderform sind die Hornkonsolen. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Ze zdi vystupující nosný článek (též krakorec) podpírající balkony, sochy, trámy, přípory aj., u dřevěných staveb (hrázděné zdivo) nazývaná také: závěrník. Knagge (= suk). Konzola je často zdobená ornamenty, nebo - obvykle groteskními - figurami. [Koch 2008] </skos:definition>
        <skos:prefLabel xml:lang="de">Konsole</skos:prefLabel>
        <skos:prefLabel xml:lang="es">consola</skos:prefLabel>
        <skos:prefLabel xml:lang="en">console</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">console</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">konzola</skos:prefLabel>
        <skos:prefLabel xml:lang="it">mensola</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_obbnm01i -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_obbnm01i">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_be880384"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_bqjysq71"/>
