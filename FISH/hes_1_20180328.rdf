				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/503810" />
				<skos:scopeNote xml:lang="en">Purposely built camp with recreational facilities and individual chalets for accommodation.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
