    skos:closeMatch <http://data.uba.de/umt/_00031393> ;
    skos:definition "The exchange of information about health or environmental risks among risk assessors and managers, the general public, news media, interest groups, etc."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Risikokommunikation"@de,
        "risk communication"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Risk_management> .

<http://www.eionet.europa.eu/gemet/concept/7240> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7236> ;
    skos:closeMatch <http://data.uba.de/umt/_00031408>,
        <http://dbpedia.org/resource/Risk_perception> ;
    skos:definition "A subjective appreciation by individuals which will more often than not bear little relation to the statistical probability of damage or injury."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Risikowahrnehmung"@de,
        "risk perception"@en .

<http://www.eionet.europa.eu/gemet/concept/7251> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12145>,
        <http://www.eionet.europa.eu/gemet/concept/15281>,
        <http://www.eionet.europa.eu/gemet/concept/15282> ;
    skos:closeMatch <http://data.uba.de/umt/_00605476> ;
    skos:definition "Any growth, maturation or change in an area of land drained by a river and its tributaries."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Entwicklung des Flussbeckens"@de,
        "river basin development"@en .

<http://www.eionet.europa.eu/gemet/concept/7257> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1288> ;
    skos:closeMatch <http://data.uba.de/umt/_00030376> ;
    skos:definition "The alteration of a natural stream by excavation, realignment, lining or other means to accelerate the flow of water."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Flußregulierung"@de,
        "river channelling"@en .

<http://www.eionet.europa.eu/gemet/concept/726> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5346> ;
