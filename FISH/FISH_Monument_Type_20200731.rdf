  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71453">
    <skos:scopeNote xml:lang="en">A residential district planned as a unit.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69098">
    <skos:scopeNote xml:lang="en">Traditionally a building or site where stage coaches were built. Nowadays the term is applied to buildings used for the manufacturing of the body work and furnishings of motor vehicles and railway carriages.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92334">
    <skos:scopeNote xml:lang="en">A 19th century spa building, usually consisting of a hotel with baths used for water treatment.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92585">
