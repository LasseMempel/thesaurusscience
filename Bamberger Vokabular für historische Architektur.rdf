    <!-- https://hist-arch-vocab.org/bvha#c_91d6c331 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_91d6c331">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_7c0b4654"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_c11523f4"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_c11523f4"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T15:06:42.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T18:23:38.000</terms:modified>
        <skos:definition xml:lang="de">Empire (lat. imperium = Kaiserreich [Napoleons!]), Schlussphase des Klassizismus, verbreitet sich zwischen 1800 und 1830 von Paris aus über Europa. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Lat. imperium = císařství - Napoleona I. Závěrečná fáze klasicismu, v letech 1800-1830 se rozšířil z Paříže do celé Evropy. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Empire</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_91ea8513 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_91ea8513">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
