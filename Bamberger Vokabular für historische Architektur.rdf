        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-05T14:23:20.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T14:32:37.000</terms:modified>
        <skos:altLabel xml:lang="de">Auriphrygium</skos:altLabel>
        <skos:definition xml:lang="de">Aurifrisium n, auch Auriphrygium n; mit Seiden- und Goldfäden durchwebter oder bestickter, häufig auch mit Perlenstickerei verzierter Besatz, der vor aller an Albe, Amikt, Dalmatik, Mitra und Antependium vorkommt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Aurifrisium </skos:prefLabel>
        <skos:prefLabel xml:lang="cs">aurifrisium</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">orfroi</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_16c00524 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_16c00524">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_7039254c"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_b41bd73a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c7b144d0"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-22T18:53:20.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T14:12:38.000</terms:modified>
        <skos:definition xml:lang="de">Bei Türen und Fenstern ein schmaler, rings um die Maueröffnung laufender Absatz (Falz), in den der hölzerne Blendrahmen eingefügt ist; allg. auch jede Fläche, gegen die ein anderer Teil, z.B. ein Fensterflügel oder Schlagladen schlägt. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Die Ebene eines Falzes, gegen die der Flügel beim Verschließen im Fensterrahmen schlägt. [Pax - Fenster &amp; Türen Fachbegriffe]</skos:definition>
        <skos:prefLabel xml:lang="de">Anschlag</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_16c06a6d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_16c06a6d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_ad800342"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-28T23:15:34.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:30:12.000</terms:modified>
        <skos:altLabel xml:lang="de">Kuppelkalotte </skos:altLabel>
        <skos:altLabel xml:lang="de">Stichkugelgewölbe </skos:altLabel>
        <skos:altLabel xml:lang="fr">calotte (coupole)</skos:altLabel>
        <skos:altLabel xml:lang="en">saucer dome</skos:altLabel>
        <skos:altLabel xml:lang="en">segmental calotte</skos:altLabel>
        <skos:definition xml:lang="de">Flachkuppel, eine Kuppel, deren Wölbung von einem Kugelabschnitt (Kalotte), nicht von einer Halbkugel gebildet wird, so dass ihr Pfeil (Stich) geringer als der Halbmesser ist. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Kuppel, deren Gewölbehöhe geringer ist als der Halbmesser ihrer Grundfläche bzw. deren Wölblinie nur einen Kugelabschnitt (= Kalotte) beschreibt. Im Barock entstehen ellipsoide, auch sich gegenseitig durchdringende Flachkuppeln. (Glossarium Artis, Bd.6)</skos:definition>
        <skos:prefLabel xml:lang="de">Flachkuppel</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">coupole surbaissée</skos:prefLabel>
        <skos:prefLabel xml:lang="en">surbased dome</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_ad800342"/>
    </owl:NamedIndividual>
    


