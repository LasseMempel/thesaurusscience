		<skos:prefLabel xml:lang="gd">OSPADAL GHALARAN GABHALTACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Ospadal leth-oireachd airson tinneasan gabhaltach; gu math tric aig oir baile. Airson lòbhradh, cleachd OSPADAL LOBHARAN.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">INFECTIOUS DISEASES HOSPITAL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-10-22T11:13:26</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-10-29T09:34:00</dcterms:modified>
