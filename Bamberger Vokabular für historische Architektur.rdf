        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T14:12:13.000</terms:modified>
        <skos:definition xml:lang="de">Cottage (engl.), im 19. Jh. verbreitete Bezeichnung für das kleinere Einfamilienhaus bes. auf dem Land; England war seit dem Ende des 18. Jhs. führend im Bau bequemer kleiner Landhäuser. c. orne ist ein künstl. rustikal gestaltetes Landhaus, vorwiegend in engl. Parks des späten 18. und frühen 19. Jhs. unter Verwendung von Strohdächern, Holzverkleidungen und roh behauenen Balken. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Cottage</skos:prefLabel>
    </owl:NamedIndividual>
    


