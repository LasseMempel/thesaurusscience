    <!-- https://hist-arch-vocab.org/bvha#c_f487be8c -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_f487be8c">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0d76b5c2"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-25T09:37:11.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-25T09:38:00.000</terms:modified>
        <skos:definition xml:lang="de">Filigran (ital. filigrana, aus lat. filum: Faden, und granum: Korn), Schmuckstück aus dünnem, kunstvoll gebogenem Gold- oder Silberdraht mit angeschmolzenen bzw. aufgelöteten Körnchen. Der Begriff wird vielfach auf jedes ähnl. feingliedrige Zierwerk angewendet, in der Baukunst z. B. auf das got. Maßwerk. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Filigran (Schmuckstück)</skos:prefLabel>
    </owl:NamedIndividual>
    


