    skos:broader <http://lvr.vocnet.org/wnk/wk004283> ;
    skos:definition "Ein Turmtor ist ein Einturmtor, bei dem der Torweg im Untergeschoss des Turmes liegt."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
