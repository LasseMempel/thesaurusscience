	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/536">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/536</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BARRAID THAIGHEAN-MHÈINNEIREAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Sreath de thaighean beaga a chaidh a thogail mar àitichean-còmhnaidh do mhèinnearan 's na teaghlaichean aca.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MINERS ROW</skos:prefLabel>
