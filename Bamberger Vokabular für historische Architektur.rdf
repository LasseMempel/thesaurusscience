        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T15:55:57.000</terms:modified>
        <skos:altLabel xml:lang="de">Hauptreliquiar</skos:altLabel>
        <skos:altLabel xml:lang="de">Schädelreliquiar</skos:altLabel>
        <skos:altLabel xml:lang="la">capitum</skos:altLabel>
        <skos:definition xml:lang="de">Kopfreliquiar n; auch Hauptreliquiar n; Schädelreliquiar n; lat. caput; capitum: ein Reliquienbehälter in Gestalt des Hauptes eines Heiligen, oft nahezu in Lebensgröße, manchmal aber auch als Miniatur. Beispiel: die Häupter von 29 hl. Jungfrauen in St. Andreas zu Basel. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Kopfreliquiar</skos:prefLabel>
        <skos:prefLabel xml:lang="la">caput</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">chef-reliquaire</skos:prefLabel>
        <skos:prefLabel xml:lang="en">head-reliquary</skos:prefLabel>
    </owl:NamedIndividual>
    


