        <skos:altLabel xml:lang="fr">roue de Saint-Cathérine</skos:altLabel>
        <skos:altLabel xml:lang="cs">rozetové okno s radiálními sloupky</skos:altLabel>
        <skos:definition xml:lang="cs">Kruhové okno členěné radiálními sloupky nebo pruty, předchůdce rozetového okna, románské období. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Rundfenster mit speichenartiger Unterteilung, die als Vorform des Maßwerks bezeichnet werden kann. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="fr"> rose du bras</skos:prefLabel>
        <skos:prefLabel xml:lang="it"> rosone</skos:prefLabel>
        <skos:prefLabel xml:lang="es"> ventana tipo rueda</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Radfenster</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">rozetové okno se sloupky nebo pruty</skos:prefLabel>
        <skos:prefLabel xml:lang="en">wheel window</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_ada19998 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_ada19998">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a832bfbe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-04-10T15:28:01.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-30T11:34:26.000</terms:modified>
        <skos:definition xml:lang="de">Mauerwerk mit Hohlräumen im Gegensatz zum Vollmauerwerk. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Zweischalige Mauer mit einem inneren Hohlraum, dessen Luftschicht wärme- und feuchtigkeitsisolierend wirkt; zur Verbesserung der Isolierung werden neuerdings Dämmstoffe eingebracht. (Glossarium Artis, Bd. 3, Bögen und Mauerwerk)</skos:definition>
        <skos:prefLabel xml:lang="de">Hohlmauerwerk</skos:prefLabel>
    </owl:NamedIndividual>
    


