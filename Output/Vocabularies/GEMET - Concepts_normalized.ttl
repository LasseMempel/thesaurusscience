    skos:closeMatch <http://data.uba.de/umt/_00028734>,
        <http://dbpedia.org/resource/Rehabilitation> ;
    skos:definition "A conservation measure involving the correction of past abuses that have impaired the productivity of the resources base."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_330897> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
