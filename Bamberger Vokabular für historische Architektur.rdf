        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_c1c07882"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_4baddbfe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_80c625c3"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_85769239"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_9c65939f"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_d46e4748"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_e8d6fdf0"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_05cd53cd"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T23:18:02.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:07:51.000</terms:modified>
        <skos:altLabel xml:lang="de">Haubengewölbe</skos:altLabel>
        <skos:altLabel xml:lang="de">Kappengewölbe</skos:altLabel>
        <skos:altLabel xml:lang="de">Walmgewölbe</skos:altLabel>
        <skos:altLabel xml:lang="de">abgewalmtes Gewölbe</skos:altLabel>
        <skos:altLabel xml:lang="en">cloister vault</skos:altLabel>
        <skos:altLabel xml:lang="en">cloistered vault</skos:altLabel>
        <skos:definition xml:lang="de">Das Klostergewölbe besteht aus 4 oder mehr Wangen einer Tonne. Es belastet die Mauern allseitig. Oft über polygonalem Grundriss. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Ein zylindrisches Gewölbe, das bei der rechtwinkligen, Durchdringung von zwei gleich hohen Tonnen mit horizontaler Scheitellinie entsteht,[...]. Die Tonnenabschnitte bilden beim Aufeinandertreffen eine Kehle aus. Das vierteilige geschlossene Klostergewölbe ist der Normalfall, über polygonalen Zentralräumen kommen häufig achtteilige oder sechsteilige Klostergewölbe vor. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="cs">Klášterní klenba se skládá ze 4 nebo více kápí jedné valené klenby, zatěžuje stěny na všech stranách, často bývá nad polygonálním půdorysem. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Klostergewölbe</skos:prefLabel>
        <skos:prefLabel xml:lang="en">coved vault</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">klášterní klenba</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte en arc-de-cloître</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_5f9418c5"/>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_c1c07882"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_6b286d33 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_6b286d33">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
