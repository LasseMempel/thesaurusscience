        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-17T13:54:36.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T17:45:21.000</terms:modified>
        <skos:altLabel xml:lang="cs">poprsník</skos:altLabel>
        <skos:definition xml:lang="de">Brüstung oder Brustwehr. [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Brüstung, Parapet (frz.), waagerechte, brusthohe Sicherung von Fenster, Terrasse, Balkon aus Stein, Holz oder Eisen, entweder aus Platten oder aus Pfosten mit eingestellten Platten, auch aus Mauerwerk, in der Gotik mit Maßwerk, im Barock als Balustrade, seit Ende des 17. und im 18. Jh. als schmiedeeiserne Konstruktion. [Koepf / Binding 2016]</skos:definition>
