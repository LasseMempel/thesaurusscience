        <skos:prefLabel xml:lang="en">Edwardian</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The period covering the reign of Edward VII (1902 CE to 1910 CE). Do not use for the reigns of Edwards I-VI.</skos:scopeNote>
        <skos:notation xml:lang="en">EDW</skos:notation>
      </skos:Concept>
