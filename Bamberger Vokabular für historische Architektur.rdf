    <!-- https://hist-arch-vocab.org/bvha#c_11c9287f -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_11c9287f">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_11ec36ef"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_380577c3"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-05T20:52:12.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-24T10:26:31.000</terms:modified>
        <skos:altLabel xml:lang="de">Terrakotta</skos:altLabel>
        <skos:altLabel xml:lang="de">terra cotta</skos:altLabel>
        <skos:note xml:lang="en">A glazed or unglazed product made with clay and mixed with fillers (grog – calcinated clay, chamotte, brick dust or pot clay) and natural binders which are then baked at a high temperature (above 600 °C). [EwaGlos]</skos:note>
        <skos:note xml:lang="de">Ein glasiertes oder unglasiertes Produkt aus Ton, das vermischt mit Zusatzmitteln (Schamotte – kalzinierter Ton, Ziegelmehl oder Attapulgit) und natürlichen Bindemitteln bei hohen Temperaturen (über 600 °C) gebrannt wird. [EwaGlos]</skos:note>
        <skos:note xml:lang="cs">Lat. terra = země, hlína, ital. cotta = pálená) Hlína, která vypálením dostane bílou, žlutou, hnědou nebo červenou barvu; pro odolnost vůči klimatickým vlivům se používala často jako stavební keramika (chrámové štíty, antefixy) nebo v plastice (starořecké figurky z Tanagry, v renesanci ji používali především Donatello, Robbia). [Koch 2008]</skos:note>
        <skos:prefLabel xml:lang="de">Terracotta (Tonprodukt)</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">terakota</skos:prefLabel>
        <skos:prefLabel xml:lang="en">terracotta (product of clay)</skos:prefLabel>
    </owl:NamedIndividual>
    


