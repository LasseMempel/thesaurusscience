		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1739" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1762" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1968" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/506" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/662" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/758" />
		<skos:scopeNote xml:lang="en">A hole or cavity in the ground, either natural or the result of excavation. Use more specific type where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
