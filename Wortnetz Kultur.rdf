	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk003150">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Drahtseilbahn</skos:altLabel>
		<skos:altLabel xml:lang="de">Drahtseilbahnen</skos:altLabel>
		<skos:prefLabel xml:lang="de">Seilbahn</skos:prefLabel>
		<skos:altLabel xml:lang="de">Seilbahnen</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk020386"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk003754"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019698"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk020386"/>
		<skos:definition xml:lang="de">Eine Seilbahn ist eine Bahn, die durch ein oder mehrere umlaufende Drahtseile hängend oder auf Schienen laufend bewegt oder gezogen wird. Der überwiegend elektrische Antrieb erfolgt ortsfest an einer Station. Es können in kurzer Zeit und ohne Anstrengung große Höhenunterschiede und unwegsames Gelände überwunden werden.</skos:definition>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4140044-6"/>
		<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1424016"/>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300008597"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003754"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019698"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk020386"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003151"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003152"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
