	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/299">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/299</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BALLA-ÙIR CEARCALLACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Dìg is uchdan dìonach a tha cruinn no ugh-chruthach a tha mun cuairt air co-dhiù aon togalach.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">RINGWORK</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/295" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1525" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/297" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/298" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/330" />
		<skos:scopeNote xml:lang="en">A defensive bank and ditch, circular or oval in plan, surrounding one or more buildings.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
