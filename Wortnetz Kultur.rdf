	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004635">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Federhalter</skos:prefLabel>
		<skos:prefLabel xml:lang="en">pen holder</skos:prefLabel>
		<skos:altLabel xml:lang="en">pen holders</skos:altLabel>
		<skos:altLabel xml:lang="en">penholder</skos:altLabel>
		<skos:altLabel xml:lang="en">penholders</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004633"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk020553"/>
		<gvp:aat2416_requires rdf:resource="http://lvr.vocnet.org/wnk/wk018838"/>
		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk011280"/>
		<skos:definition xml:lang="de">Ein Federhalter ist ein stiftartiges, stabförmiges Gerät, dessen vorderes Ende gestaltet ist, um eine austauschbare Federspitze aufzunehmen. Der Halter besteht meist aus Holz, Kunststoff oder auch Metall und dient dazu Schreib-, Zeichen- oder Schneidefedern zu führen. Im Gegensatz zum Füllfederhalter hat der Federhalter keine integrierte Tintenquelle, sondern die Federspitze muss immer wieder in Tinte getaucht werden, um damit schreiben oder zeichnen zu können.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300411361"/>
		<skos:mappingRelation rdf:resource="http://www.wikidata.org/entity/Q14524284"/>
