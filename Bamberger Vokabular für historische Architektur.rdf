        <skos:altLabel xml:lang="de">Beschwörung</skos:altLabel>
        <skos:altLabel xml:lang="en">exorcism</skos:altLabel>
        <skos:definition xml:lang="de">Exorzismus m; Beschwörung f: die Austreibung von Dämonen und bösen Geistern durch Gebet und liturgische Gesten, durch Anrufung des Hl. Geistes. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Exorzismus</skos:prefLabel>
        <skos:prefLabel xml:lang="en">exorcisation</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">exorcisme</skos:prefLabel>
    </owl:NamedIndividual>
    


