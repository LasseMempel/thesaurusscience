				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/442</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TAIGH A’ MHARSANTA</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Taigh aig cuideigin aig an robh inbhe nas àirde ann am baile no port, gu math tric le seilear stòrais.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">MERCHANTS HOUSE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/422" />
				<skos:scopeNote xml:lang="en">Originally, a house of higher social status in a town or port, often with a storage cellar.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
