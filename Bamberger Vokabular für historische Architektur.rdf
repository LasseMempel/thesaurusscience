        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T17:44:48.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T18:16:06.000</terms:modified>
        <skos:prefLabel xml:lang="de">Sondergotik</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">partikulární gotika</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Der Stilbegriff &quot;Sondergotik&quot; wird in der Forschung nicht mehr verwendet. Gründe dafür sind einerseits die spätestens durch Norbert Nussbaum (Nussbaum, Norbert: Deutsche Kirchenbaukunst der Gotik, Köln 1985, S. 214-218) herausgestellten Mängel in der Studie Kurt Gerstenbergs (Gerstenberg, Kurt: Deutsche Sondergotik: eine Untersuchung über das Wesen der deutschen Baukunst im späten Mittelalter, München 1913), andererseits auch die völkischen Implikationen des Begriffs. [S. Schmidt] </skos:scopeNote>
        <skos:scopeNote xml:lang="de">Es gibt sowohl die deutsche als auch die katalanische Sondergotik. [Koch 2009]</skos:scopeNote>
        <skos:scopeNote xml:lang="cs">Německá, katalánská partikulární gotika. [Koch 2008]</skos:scopeNote>
    </owl:NamedIndividual>
    


