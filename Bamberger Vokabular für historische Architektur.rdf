        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T12:27:16.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T01:21:29.000</terms:modified>
        <skos:definition xml:lang="de">Schmale Halle zur Erschließung der Haupträume mancher antiken Wohnhäuser, öffnet sich zum Hof mit Säulen- oder Pfeilerstellungen. Pastashaus: Olynth; Prostashaus mit Pastas: Priene. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Úzká hala sloužící k přístupu do hlavních prostor četných antických obytných domů, vedoucí do nádvoří se sloupořadími a pilíři; pastasový dům: Olynt, prostasový dum s pastasem: Priene. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Pastas</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">pastas</skos:prefLabel>
    </owl:NamedIndividual>
    


