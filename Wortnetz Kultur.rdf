	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk003018">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">garden city</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Gartenstadt</skos:prefLabel>
		<skos:altLabel xml:lang="de">Gartenstädte</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000436"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010254"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013751"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019812"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk020435"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000436"/>
		<skos:scopeNote xml:lang="de">Benutzt für die planmäßig als Gartenstadt gegründete und gestaltete Stadt, nicht für eine aufgrund ihrer besonderen Begrünung umgangssprachlich als &amp;quot;Gartenstadt&amp;quot; bezeichnete Stadt.</skos:scopeNote>
		<xe:explanation_temp xml:lang="de">Eine Gartenstadt besteht aus mehreren eigenständigen, durch Agrargürtel voneinander getrennten und durch Eisenbahnen miteinander verbundenen Teilen, die funktional voneinander getrennt sind – also z.B. ringförmig um eine Kernstadt angeordnete Wohnstädte mit außerhalb dieses Wohnrings liegenden industriellen und gewerblichen Arbeitsplätzen.</xe:explanation_temp>
		<skos:definition xml:lang="de">Eine Gartenstadt ist eine Stadt, die nach dem Modell der ursprünglich britischen Gartenstadtbewegung (&amp;quot;Garden City movement&amp;quot;) planmäßig neu gegründet und gestaltet ist.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000436"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010254"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk013751"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019812"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk020435"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
