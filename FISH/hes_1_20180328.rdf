	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/38">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/38</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BEACHLANN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite a tha na dhachaigh do sheillein. 's e coirceagan a bhiodh annta o thùs, cuach-mhullach de shùgan tiugh ach uaireannan 's e soithichean fiodha a bhiodh annta cuideachd.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BEEHIVE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/37" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/7" />
		<skos:scopeNote xml:lang="en">A receptacle used as a home for bees, traditionally made of thick straw-work in the shape of a dome, but sometimes made of wood.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/40">
