    <!-- https://hist-arch-vocab.org/bvha#c_a86b1e2b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_a86b1e2b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b320e26f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-16T11:49:23.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T12:11:54.000</terms:modified>
        <skos:definition xml:lang="de">(frz., ›Halbmond‹), Außenwerk der entwickelten Bastionärfestung vor der Bastionsspitze. Meist ähnlich wie ein Ravelin und deshalb oft verwechselt, aus zwei Facen zusammengesetzt, doch mit halbmondförmiger Kehllinie. M. L. [Wörterbuch der Burgen, Schlösser und Festungen] </skos:definition>
        <skos:prefLabel xml:lang="de">Demi lune</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">Demi-lune</skos:prefLabel>
    </owl:NamedIndividual>
    


