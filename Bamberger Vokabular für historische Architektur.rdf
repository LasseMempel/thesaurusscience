        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_da40e328"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_e23cc446"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_e2eed9a1"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_ea7f6ea5"/>
