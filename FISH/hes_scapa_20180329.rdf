	<dct:spatial rdf:resource="http://dbpedia.org/resource/Scotland"/>
	<dct:spatial rdf:resource="http://vocab.getty.edu/tgn/7002444"/>
	<skos:altLabel xml:lang="en">Late Prehistory</skos:altLabel>
	<skos:broadMatch rdf:resource="http://vocab.getty.edu/aat/300019257"/>
	<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/PR"/>
	<skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/LPR"/>
	<skos:editorialNote xml:lang="en">Neolithic / Iron Age. LBA - Iron Age</skos:editorialNote>
	<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/scapa"/>
	<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/BA"/>
	<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/IA"/>
	<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/NE"/>
	<skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LAT</skos:notation>
	<skos:prefLabel xml:lang="en">Late Prehistoric</skos:prefLabel>
	<skos:prefLabel xml:lang="gd">(todo)</skos:prefLabel>
	<skos:scopeNote xml:lang="en">For monuments or objects that can be identifed only to a date range from the introduction of agriculture in the Neolithic to the Iron Age. Use more specific term where appropriate</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="http://purl.org/heritagedata/schemes/scapa/concepts/LBA">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
	<cc:attributionURL rdf:resource="https://www.historicenvironment.scot/"/>
	<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence"/>
	<dct:identifier rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/LBA"/>
	<dct:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence"/>
	<dct:spatial rdf:resource="http://dbpedia.org/resource/Scotland"/>
	<dct:spatial rdf:resource="http://vocab.getty.edu/tgn/7002444"/>
	<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/BA"/>
	<skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/11/concepts/508452"/>
	<skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/LBA"/>
	<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300019278"/>
	<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/scapa"/>
	<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/LON"/>
	<skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LBA</skos:notation>
	<skos:prefLabel xml:lang="en">Late Bronze Age</skos:prefLabel>
	<skos:prefLabel xml:lang="gd">Linn an Umha anmoch</skos:prefLabel>
	<skos:scopeNote xml:lang="en">The third and latest subdivision of the Bronze Age. The earliest hillforts appear. Sophisticated metal working forms emerge including sheet metal working and complex casting processes. Flat-rimmed ware appears in the pottery record.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="http://purl.org/heritagedata/schemes/scapa/concepts/LEM">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
	<cc:attributionURL rdf:resource="https://www.historicenvironment.scot/"/>
	<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence"/>
	<dct:identifier rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/LEM"/>
	<dct:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence"/>
	<dct:spatial rdf:resource="http://dbpedia.org/resource/Scotland"/>
	<dct:spatial rdf:resource="http://vocab.getty.edu/tgn/7002444"/>
	<skos:broadMatch rdf:resource="http://purl.org/heritagedata/schemes/11/concepts/505127"/>
	<skos:broadMatch rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/EM"/>
	<skos:broadMatch rdf:resource="http://vocab.getty.edu/aat/300020760"/>
	<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/EM"/>
	<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/scapa"/>
	<skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LEM</skos:notation>
	<skos:prefLabel xml:lang="en">Late Early Medieval</skos:prefLabel>
	<skos:prefLabel xml:lang="gd">(todo)</skos:prefLabel>
	<skos:scopeNote xml:lang="en">Used in some areas to describe the transition from the Long Iron Age to the Medieval period, following the Norse invasions of the 9th century</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="http://purl.org/heritagedata/schemes/scapa/concepts/LIA">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
	<cc:attributionURL rdf:resource="https://www.historicenvironment.scot/"/>
	<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence"/>
	<dct:identifier rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/LIA"/>
	<dct:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence"/>
	<dct:spatial rdf:resource="http://dbpedia.org/resource/Scotland"/>
	<dct:spatial rdf:resource="http://vocab.getty.edu/tgn/7002444"/>
	<skos:altLabel xml:lang="en">Later Iron Age</skos:altLabel>
	<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/IA"/>
	<skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/11/concepts/508455"/>
	<skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/LIA"/>
	<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300106745"/>
	<skos:editorialNote xml:lang="en">ScARF Iron Age Panel runs the LIA well into Early Medieval&gt; D and G and Highland Council start their Late Iron Age much earlier than elsewhere.</skos:editorialNote>
	<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/scapa"/>
	<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/PI"/>
	<skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LIA</skos:notation>
	<skos:prefLabel xml:lang="en">Late Iron Age</skos:prefLabel>
	<skos:prefLabel xml:lang="gd">Linn an Iarainn anmoch</skos:prefLabel>
	<skos:scopeNote xml:lang="en">The third sub-division of the Iron Age in Scotland. The label is applied variously to the last part of the Iron Age up to the end of the Roman incursions or from the end of the Roman incursions to the 9th Century Norse incursions.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="http://purl.org/heritagedata/schemes/scapa/concepts/LME">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
	<cc:attributionURL rdf:resource="https://www.historicenvironment.scot/"/>
	<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence"/>
	<dct:identifier rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/LME"/>
	<dct:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence"/>
	<dct:spatial rdf:resource="http://dbpedia.org/resource/Scotland"/>
	<dct:spatial rdf:resource="http://vocab.getty.edu/tgn/7002444"/>
	<skos:broadMatch rdf:resource="http://vocab.getty.edu/aat/300019264"/>
	<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/ME"/>
	<skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/11/concepts/508445"/>
	<skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/LME"/>
	<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/scapa"/>
	<skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LME</skos:notation>
	<skos:prefLabel xml:lang="en">Late Mesolithic</skos:prefLabel>
	<skos:prefLabel xml:lang="gd">(todo)</skos:prefLabel>
	<skos:scopeNote xml:lang="en">The Late Mesolithic is characterised by more elaborate stone tools including more elaborately retouched 'narrow blade' microliths and other edge-blunted forms.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="http://purl.org/heritagedata/schemes/scapa/concepts/LNE">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
	<cc:attributionURL rdf:resource="https://www.historicenvironment.scot/"/>
	<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence"/>
	<dct:identifier rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/LNE"/>
	<dct:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence"/>
	<dct:spatial rdf:resource="http://dbpedia.org/resource/Scotland"/>
	<dct:spatial rdf:resource="http://vocab.getty.edu/tgn/7002444"/>
	<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/NE"/>
	<skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/11/concepts/508449"/>
	<skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/LNE"/>
	<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300019272"/>
	<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/scapa"/>
	<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/CH"/>
	<skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LNE</skos:notation>
	<skos:prefLabel xml:lang="en">Late Neolithic</skos:prefLabel>
	<skos:prefLabel xml:lang="gd">(todo)</skos:prefLabel>
	<skos:scopeNote xml:lang="en">The third subdivision of the Neolithic sees the widespread appearance of novel burial practices and novel material culture, including Grooved Ware pottery, carved stone balls and maceheads. Monument types include Stone Circles and Henges, and rock art.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="http://purl.org/heritagedata/schemes/scapa/concepts/LON">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
	<cc:attributionURL rdf:resource="https://www.historicenvironment.scot/"/>
	<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence"/>
	<dct:identifier rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/LON"/>
	<dct:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence"/>
	<dct:spatial rdf:resource="http://dbpedia.org/resource/Scotland"/>
	<dct:spatial rdf:resource="http://vocab.getty.edu/tgn/7002444"/>
	<skos:broadMatch rdf:resource="http://purl.org/heritagedata/schemes/11/concepts/505125"/>
	<skos:broadMatch rdf:resource="http://purl.org/heritagedata/schemes/11/concepts/505127"/>
	<skos:broadMatch rdf:resource="http://purl.org/heritagedata/schemes/11/concepts/508452"/>
	<skos:broadMatch rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/EM"/>
	<skos:broadMatch rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/IA"/>
	<skos:broadMatch rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/LBA"/>
