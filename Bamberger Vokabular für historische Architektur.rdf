    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_169b3f12 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_169b3f12">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_2d93c3e7"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_bc31cf9b"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-04T10:46:00.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T12:57:27.000</terms:modified>
        <skos:definition xml:lang="cs">Prostor se světcovým hrobem pod presbytářem raně křesťanského kostela, často viditelný půlkruhovitou štolou, předchůdce krypty. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Raum mit Heiligengrab unter dem Altarraum einer frühchristlichen Kirche, oft von einem halbkreisförmigen Stollen aus durch eine Wandöffnung zu besichtigen. Vorform der Krypta. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Confessio</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">confesio</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_16b80c80 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_16b80c80">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_be091023"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_19d56a39"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-14T10:31:59.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T14:10:06.000</terms:modified>
        <skos:definition xml:lang="de">Verblattungen werden mit einem oder mehreren Blattnägeln gegen Ausdrehen aus der Sasse gesichert. Bei einem geraden Blatt übernimmt der Blattnagel die Kraftschlüssigkeit, wenn die Kraft in Richtung des Blattes wirkt. Holznagelöffnungen im Blatt können vierkantig oder rund ausgebildet sein. (Eißing et al. 2012)</skos:definition>
        <skos:prefLabel xml:lang="de">Blattnagel</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_16b837ff -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_16b837ff">
