    <!-- https://hist-arch-vocab.org/bvha#c_bc1a3522 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_bc1a3522">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
