		<skos:prefLabel xml:lang="de">Hornstein</skos:prefLabel>
		<skos:altLabel xml:lang="de">Hornsteine</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004108"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010567"/>
