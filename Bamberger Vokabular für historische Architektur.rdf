        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-17T10:47:26.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T12:12:27.000</terms:modified>
        <skos:definition xml:lang="de">Chorhaupt, Ostabschluss der Kirche mit der Stellung des Hauptaltars, entweder halbkreisförmig als Apsis oder rechteckig und polygonal als Chor, auch mit innerem Umgang (Chorumgang). [Koepf / Binding 2016]</skos:definition>
