	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1301">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1301</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÒN BOGADH LÌN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Uisgeadan beag nàdarra no fuadain sa bheilear a' bogadh cuiseagan lìn gus a' phàirt fhiodhach dheth a dhèanamh nas buige airson 's gun gabh na teudagan a sgaradh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">RETTING POND</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">RETTING POOL</skos:altLabel>
		<skos:altLabel xml:lang="en">LINT POOL</skos:altLabel>
		<skos:altLabel xml:lang="en">LINT STEEPING PIT</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1296" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/927" />
		<skos:scopeNote xml:lang="en">A small natural or artificial body of water used for the prolonged soaking of flax straw, in order to soften the woody tissue and enable the fibres to be separated.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1307">
