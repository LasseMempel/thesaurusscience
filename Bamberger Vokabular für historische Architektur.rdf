        <skos:altLabel xml:lang="fr">pierres tendres;</skos:altLabel>
        <skos:definition xml:lang="de">Steine, zu deren Bearbeitung der Meißel vorwiegend mit dem Klopfholz (Knüppel) getrieben wird. Dazu gehören u. a. Kalkstein (mit Marmorarten), Muschelkalkstein, Jurakalkstein, Sandstein und Tuffstein. [Glossarium Artis, Bd. 3, Bögen und Mauerwerk]</skos:definition>
        <skos:prefLabel xml:lang="de">Weichgestein</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">roches tendres</skos:prefLabel>
        <skos:prefLabel xml:lang="en">soft stone</skos:prefLabel>
    </owl:NamedIndividual>
    


