	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021096">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">gelatin silver process</skos:prefLabel>
		<skos:altLabel xml:lang="de">Gelatine-Silber-Verfahren</skos:altLabel>
		<skos:altLabel xml:lang="de">Silber-Gelatine-Verfahren</skos:altLabel>
		<skos:prefLabel xml:lang="de">Silbergelatineverfahren</skos:prefLabel>
		<skos:altLabel xml:lang="en">silver bromide process</skos:altLabel>
		<skos:altLabel xml:lang="en">silver gelatin process</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk008946"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk008946"/>
		<skos:definition xml:lang="de">Das Silbergelatineverfahren ist ein fotografisches Verfahren, das Gelatine als Bindemittel für lichtempfindliche Silbersalze verwendet. Es wird auf verschiedenen Trägern angewendet, darunter Barytpapier, PE-Papier, historisch auch auf Glasplatten und flexiblen Kunststoffen wie Rollfilmen. Bei diesem Verfahren wird das Material mit einer lichtempfindlichen Emulsion aus in Gelatine suspendierten Silberhalogeniden beschichtet, belichtet und dann durch chemische Entwicklungsprozesse verarbeitet, um das Silber in der Gelatinebeschichtung zu fixieren und das sichtbare Bild zu erzeugen.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300139114"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q172984"/>
