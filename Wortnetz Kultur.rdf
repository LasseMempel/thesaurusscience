	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk003840">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">explosion crater</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Explosionskrater</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk020260"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk004310"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk017632"/>
		<xe:explanation_temp xml:lang="de">Die Vertiefung kann dabei durch eine vulkanische Eruption oder durch die Explosion einer Bombe oder eines Geschosses entstanden sein.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Explosionskrater ist ein offener Raum, welcher durch eine trichterförmige Vertiefung der Erdoberfläche gekennzeichnet ist.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004310"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk017632"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002937"/>
