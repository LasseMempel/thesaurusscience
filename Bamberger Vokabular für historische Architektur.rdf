    <!-- https://hist-arch-vocab.org/bvha#c_4d9dfad6 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_4d9dfad6">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1df9f722"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_b4b2e9b5"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-31T16:04:35.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T17:44:49.000</terms:modified>
        <skos:altLabel xml:lang="de">Abgraten</skos:altLabel>
        <skos:altLabel xml:lang="de">Abkanten</skos:altLabel>
        <skos:altLabel xml:lang="de">Abschrägen</skos:altLabel>
        <skos:definition xml:lang="de">Abkanten, abgraten, abschrägen, im Holz- und Steinbau eine Kante so abarbeiten, dass eine schräge Fläche, die Fase, entsteht, die auch als Schmiege ausgebildet sein kann. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Abfasen</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">okosení</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_4da5b007 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_4da5b007">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_537f5b30"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_b41bd73a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c7b144d0"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-23T08:00:05.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-29T14:58:56.000</terms:modified>
        <skos:definition xml:lang="de">Fensterrahmen-Typ in Holz- und Steinbauten, bei dem die Schenkel und die Innenkonstruktion einen den Leisten der Flügelrahmen nahezu gleichen querrechteckigen Querschnitt haben. Es ist ein leichter Fensterrahmen, der mit dem Gefüge der Wand konstruktiv nicht verbunden ist. In Sachsen ist der Blendrahmen die bisher einzige nachweisbare Form des Fensterrahmens, sie kann bis ins 16. Jh. zurückverfolgt werden. [Noky 1996]</skos:definition>
        <skos:definition xml:lang="de">Fest mit der Mauer verbundener Holzrahmen, an dem bei Türen und Fenstern die Flügel mit Beschlägen befestigt sind. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Blendrahmen (Fenster)</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_4dab9383 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_4dab9383">
