    <skos:scopeNote xml:lang="en">A small monastery or nunnery of the Augustinian order dependent on a larger mother house.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/95049">
    <skos:scopeNote xml:lang="en">A site used for the production of dyes from controlled chemical reactions. In use from the mid 19th century onwards.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99572">
    <skos:scopeNote xml:lang="en">A works engaged principally in the manufacture of the explosive bellite.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71546">
    <skos:scopeNote xml:lang="en">A round or polygonal building containing a HORSE ENGINE. Commonly found on farms next to the threshing barn, where it is used to power the machinery.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164377">
    <skos:scopeNote xml:lang="en">Establishments responsible for the research into and the design, development and manufacture of nuclear warheads.</skos:scopeNote>
  </rdf:Description>
