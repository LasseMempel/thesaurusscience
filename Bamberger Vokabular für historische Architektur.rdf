        <skos:altLabel xml:lang="de">Antiphonale</skos:altLabel>
        <skos:altLabel xml:lang="de">Antiphonarium</skos:altLabel>
        <skos:altLabel xml:lang="de">Responsorial</skos:altLabel>
        <skos:altLabel xml:lang="de">Responsoriale</skos:altLabel>
        <skos:altLabel xml:lang="fr">antiphonier</skos:altLabel>
        <skos:altLabel xml:lang="la">liber responsalis </skos:altLabel>
        <skos:altLabel xml:lang="fr">responsorial</skos:altLabel>
        <skos:definition xml:lang="de">Antiphonar n, Antiphonarium n, Antiphonale n, Responsoriale n, liber antiphonarius, liber responsalis: Buch mit den antiphonen und responsorialen Gesängen des Stundengebetes (Antiphonarium officii) und der Messe (Antiphonarium missarum); seit dem 9. Jh. auch Graduale; neuerdings enthält das Antiphonar auch Psalmen, Hymnen u.a. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Antiphonar</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">antifonář</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">antiphonaire</skos:prefLabel>
        <skos:prefLabel xml:lang="la">liber antiphonarius</skos:prefLabel>
    </owl:NamedIndividual>
    


