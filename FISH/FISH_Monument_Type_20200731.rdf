  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78141">
    <skos:scopeNote xml:lang="en">A small roofed shelter for cattle without tethering point or stalls, but with a small yard attached. It is often detached from the main range of farm buildings.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69238">
    <skos:scopeNote xml:lang="en">A site used for the production and/or working of metallic lead.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71462">
    <skos:scopeNote xml:lang="en">A place of worship at the site of a mortuary.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/100211">
    <skos:scopeNote xml:lang="en">A barn which is constructed with a timber framework; between the members are panels which are infilled with timber, wattle and daub, plaster, brickwork, stone or other materials.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93511">
    <skos:scopeNote xml:lang="en">A school where the applied sciences and the mechanical arts are taught.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/151870">
    <skos:scopeNote xml:lang="en">Former terrestrial landscape of any kind now submerged through erosion, as at Dunwich, or historical inundation processes, eg. post-glacial submersion of the North Sea landscape ("Doggerland").</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140449">
    <skos:scopeNote xml:lang="en">An area on post-war military airfields for parking aircraft on quick reaction alert to allow immediate access to the runway. Abbreviation ORP.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/111253">
    <skos:scopeNote xml:lang="en">A factory or complex of buildings where creosote oil is produced. Creosote oil is distilled from coal tar and used as a wood preservative.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68866">
    <skos:scopeNote xml:lang="en">A usually temporary earthwork or fortification, the latter constructed by military forces operating in the field. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70635">
    <skos:scopeNote xml:lang="en">Textile mill producing calico, ie. coarse, unbleached cotton cloth.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69025">
    <skos:scopeNote xml:lang="en">A complex maze incorporating tall hedges. A popular feature of 16th and 17th century gardens.</skos:scopeNote>
  </rdf:Description>
