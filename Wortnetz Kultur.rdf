	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk003847">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Kalifeldspat</skos:altLabel>
		<skos:prefLabel xml:lang="en">orthoclase</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Orthoklas</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003842"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk003842"/>
		<skos:definition xml:lang="de">Ein Orthoklas ist ein Feldspat, der Kalium enthält, in prismatischen oder tafeligen großen Kristallen auftritt und der häufigste Typ der Feldspate ist.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003842"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003938"/>
