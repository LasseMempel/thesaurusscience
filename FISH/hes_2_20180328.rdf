	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/2/concepts/501140">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/2" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/2/concepts/501140</dcterms:identifier>
		<skos:prefLabel xml:lang="en">ARROWHEAD</skos:prefLabel>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:56:41</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/2/concepts/501483" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/2/concepts/501159">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/2" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/2/concepts/501159</dcterms:identifier>
				<skos:prefLabel xml:lang="en">BARBED AND TANGED ARROWHEAD</skos:prefLabel>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:56:41</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/2/concepts/501140" />
				<skos:scopeNote xml:lang="en">A triangular arrowhead retouched to form a central tang and lateral barbs. The sides may be straight or concave.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
