		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500922" />
		<skos:scopeNote xml:lang="en">A group of planted trees or shrubs, generally of uniform age and of a single species.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
