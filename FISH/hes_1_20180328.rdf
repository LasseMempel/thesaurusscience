	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/848">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/848</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FACTARAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach no aitreabh sa bheil innealan airson saothrachadh bathair. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">FACTORY</skos:prefLabel>
