        <skos:altLabel xml:lang="es">galería</skos:altLabel>
        <skos:altLabel xml:lang="fr">salle des pas perdus</skos:altLabel>
        <skos:definition xml:lang="de">Eine zum Umhergehen bestimmte Halle, bes. an öffentl. Gebäuden wie Theater, Bäder, auch an Plätzen (Stoa), ein gegen Regen geschützter, teilweise offener Raum unterschiedl.Gestaltung. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Wandelhalle</skos:prefLabel>
        <skos:prefLabel xml:lang="en">covered walk</skos:prefLabel>
        <skos:prefLabel xml:lang="es">paseo</skos:prefLabel>
        <skos:prefLabel xml:lang="it">portiei</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">promenoir</skos:prefLabel>
    </owl:NamedIndividual>
    


