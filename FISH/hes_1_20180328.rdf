		<skos:prefLabel xml:lang="en">GUN CREW ACCOMMODATION</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-01-26T11:44:59</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-01-26T11:48:22</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/503173" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/337" />
		<skos:scopeNote xml:lang="en">A building located close to gun emplacements in order to allow gun crews to respond quickly in emergencies. Unlike other forms of military camp accommodation, usually simple timber huts, the gun crew accommodation was constructed in brick and concrete, with thick walls, flat roofs and, where necessary, entrances and windows protected by blast walls.</skos:scopeNote>
