    skos:prefLabel "Soil heave"@en ;
    skos:scopeNote "Lifting of the ground due to the swelling of the soil."@en .

<http://purl.org/heritagedata/schemes/38076/concepts/20500> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/38076/concepts/2050> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/38076> ;
    skos:prefLabel "Desertification"@en ;
