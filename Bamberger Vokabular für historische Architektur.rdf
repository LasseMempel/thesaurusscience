    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_8e64a27b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_8e64a27b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_2b8c8e23"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_2b831ad9"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_2d8e36df"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_41bc5336"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_bf6746b8"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-04T11:32:14.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T13:41:17.000</terms:modified>
        <skos:definition xml:lang="de">Dekoration (lat. decorare = schmücken), Gesamtheit aller zur Ausschmückung dienenden Gegenstände und Ornamente, auch die Gesamtheit der schmückenden Einzelmotive, die für einen Einzelgegenstand wie eine bestimmte Fassade, einen bestimmten Innenraum usw. angeordnet werden. Bei keramischen Erzeugnissen spricht man von Dekor. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Dekoration (v. lat. decorare: schmücken), die Anwendung von Ornament auf einem Ornamentsträger (Bau, Bild); die Gesamtheit der &gt;Ausschmückung&lt; von Bauwerken, bes. von Innenräumen, im Gegensatz zum Ornament, das als einzelnes Schmuckmotiv nur ein Teil der D. ist. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Lat. decorare = zdobit. Soubor všech předmětů a ornamentů sloužících k výzdobě, rovněž soubor jednotlivých výzdobných motivů, které jsou použity u některého dílčího předmětu, např. určitého průčelí, určitého interiéru apod., u keramických výrobků hovoříme o dekoru. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Dekoration</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">dekorace</skos:prefLabel>
    </owl:NamedIndividual>
    


