		<skos:altLabel xml:lang="de">Tragflügel</skos:altLabel>
		<skos:prefLabel xml:lang="en">wing (vehicle component)</skos:prefLabel>
		<skos:altLabel xml:lang="en">wings (vehicle components)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004182"/>
