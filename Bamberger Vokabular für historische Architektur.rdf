        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_9d437393"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_a011c664"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_a905e8f0"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_aefad218"/>
