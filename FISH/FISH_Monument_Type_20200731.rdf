    <skos:scopeNote xml:lang="en">A burial ground for Nonconformists. Use more specific term where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70373">
    <skos:scopeNote xml:lang="en">Casual scribbles or pictographs on ancient walls, stones or other surfaces. In more recent times applied to humourous, satiric or obscene writings or drawings executed anonymously in public places.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70216">
    <skos:scopeNote xml:lang="en">A simple form of stone slab bridge, particularly associated with South West England.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/169871">
    <skos:scopeNote xml:lang="en">A building specifically built to house life saving apparatus used when conditions prevented the lifeboat from deploying.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69127">
    <skos:scopeNote xml:lang="en">A place where fish are processed after being caught.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68576">
    <skos:scopeNote xml:lang="en">A receptacle used as a home for bees, traditionally made of thick straw-work in the shape of a dome, but sometimes made of wood.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93614">
    <skos:scopeNote xml:lang="en">A building housing transformers to convert AC electricity supply to DC supply for use by tramcars.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92158">
    <skos:scopeNote xml:lang="en">A building for the crushing of stones and minerals.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92579">
    <skos:scopeNote xml:lang="en">A self-contained establishment (out-patients) where pregnant women receive check-ups, counselling and medical treatment.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71782">
    <skos:scopeNote xml:lang="en">A bridge, usually resting on raised arches, carrying a road across low-lying land or water.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92883">
    <skos:scopeNote xml:lang="en">Sites and structures associated with pedestrian transport.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70194">
    <skos:scopeNote xml:lang="en">An arrangement of one or more standing stones. Use particularly for isolated recumbent stones, or where original form of monument unclear. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68908">
    <skos:scopeNote xml:lang="en">A temporary earthwork or fortification constructed by forces laying siege to a castle or town, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93857">
    <skos:scopeNote xml:lang="en">A college founded for the education and betterment of the working classes. Lectures usually being held after the end of the working day.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170019">
    <skos:scopeNote xml:lang="en">A building, usually associated with, or found within the grounds of, a cemetery and used for the storage of coffins prior to burial. Reception houses were introduced as a result of concerns around the implcations for public health of C19 burial practices.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/136730">
    <skos:scopeNote xml:lang="en">A large, vertical revolving wheel with passenger cars or pods on the periphery used to give a bird's eye view of the surrounding area.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93791">
    <skos:scopeNote xml:lang="en">The residence of a well keeper.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92421">
    <skos:scopeNote xml:lang="en">A building used by visitors at a health resort.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/139319">
    <skos:scopeNote xml:lang="en">A group of electricity-producing windmills or wind turbines.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69157">
    <skos:scopeNote xml:lang="en">A site where peat (vegetable matter decomposed in water and partly carbonised), used for fuel, is cut.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/144507">
    <skos:scopeNote xml:lang="en">An inclined ramp of earth, stone or brick used to deliver fuel to the firing hole of a kiln. Mediaeval and later.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167334">
    <skos:scopeNote xml:lang="en">19th century school for the daughters of clergymen.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71190">
    <skos:scopeNote xml:lang="en">A building used to house railway carriages.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70062">
    <skos:scopeNote xml:lang="en">A cemetery comprising inhumations or cremations interred in stone cists.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70396">
    <skos:scopeNote xml:lang="en">A brick, stone or iron receptacle for baking bread or other food in.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91389">
    <skos:scopeNote xml:lang="en">A training college for chefs and other catering students.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/145103">
    <skos:scopeNote xml:lang="en">A layer of remains left by a single culture, from which the culture can be dated or identified.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71531">
    <skos:scopeNote xml:lang="en">A place providing social, recreational, and educational facilities for a neighbourhood.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68802">
    <skos:scopeNote xml:lang="en">Traditionally a place where meat and fish were sold.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91042">
    <skos:scopeNote xml:lang="en">Buildings and structures associated with the use of animals to generate power.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69206">
    <skos:scopeNote xml:lang="en">A temporary kiln, in which the pots are stacked and baked in a pit underneath a bonfire.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69429">
    <skos:scopeNote xml:lang="en">Used for boiling sections of willow for basket making, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94051">
    <skos:scopeNote xml:lang="en">A building in which textile rags are sorted according to fibre types.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91006">
    <skos:scopeNote xml:lang="en">The premises of an agricultural merchant where agricultural equipment, animal feed and fertilizers can be bought.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164105">
    <skos:scopeNote xml:lang="en">The limit line of a county.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91476">
    <skos:scopeNote xml:lang="en">A circular kiln or oven used in the manufacture of bricks. Common in Staffordshire in the 18th century.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140163">
    <skos:scopeNote xml:lang="en">A permanent military RAF aircraft hangar type, designed in 1924. It features a steel frame (with longitudinal ridge and valley trusses for the roof) reinforced concrete and brick infilling for the walls. Typically 122 foot span by 249 foot in length.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68944">
    <skos:scopeNote xml:lang="en">An island, partly or wholly artificial, built up by dumping timber, earth and stones onto a lake or river bed. Often revetted with timber piles or palisade.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71496">
    <skos:scopeNote xml:lang="en">A pool of water and associated ancillary buildings designed to accommodate sea lions.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78809">
    <skos:scopeNote xml:lang="en">An unidentified feature on the seabed recorded by fishermen as an obstruction to trawling.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70352">
    <skos:scopeNote xml:lang="en">A bank or mound of earth used as a rampart or fortification.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93945">
    <skos:scopeNote xml:lang="en">The residence of a person employed in the textile industry.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91662">
    <skos:scopeNote xml:lang="en">A tread-wheel by which a crane was formerly worked.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87672">
    <skos:scopeNote xml:lang="en">An often stately or ornate entrance to a railway tunnel.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70833">
    <skos:scopeNote xml:lang="en">A small settlement, usually consisting of one dwelling with ancillary buildings.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91005">
    <skos:scopeNote xml:lang="en">A site for the sale or hire of agricultural machinery.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/100532">
    <skos:scopeNote xml:lang="en">A one or two storey reinforced concrete structure, usually associated with two T shaped radio masts. Term is specific to army anti-aircraft control centres operational between 1950-55.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92545">
    <skos:scopeNote xml:lang="en">A place where marble is extracted from the ground.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70227">
    <skos:scopeNote xml:lang="en">A large, metal or wooden structure, used for raising, lowering and moving heavy objects. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92429">
    <skos:scopeNote xml:lang="en">The residence of a lacemaker.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71632">
    <skos:scopeNote xml:lang="en">A kiln in which the prolonged heating or roasting of materials to drive off water, volatiles and sulphur so that they may be reduced to a powder, was performed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71513">
    <skos:scopeNote xml:lang="en">Unspecified landscape feature. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93395">
    <skos:scopeNote xml:lang="en">A site occupied by people who have no legal right to the land or buildings on it.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68543">
    <skos:scopeNote xml:lang="en">Sites, buildings, structures, features and areas of land associated with cultivation, the rearing of livestock, gathering, hunting &amp; fishing. Includes farm based processing of foodstuffs &amp; storage of agricultural produce.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141431">
    <skos:scopeNote xml:lang="en">A building providing business premises to companies or individuals, sometimes for short periods, in exchange for a membership fee.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70243">
    <skos:scopeNote xml:lang="en">A railway, usually by the sea, linking the beach with the cliff top. Various mechanisms were used the most common being that the cars were attached to a cable and winding drum and were balanced so that one travelled up, as the other came down.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94350">
    <skos:scopeNote xml:lang="en">Sites and buildings used in the coordination of the defence of the civilian population during times of war. Could also be used during times of national emergency.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92327">
    <skos:scopeNote xml:lang="en">Buildings and structures associated with the creation and use of hydraulic power.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68560">
    <skos:scopeNote xml:lang="en">The main dwelling-house of a farm, it can be either detached from or attached to the working buildings.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71528">
    <skos:scopeNote xml:lang="en">A special type of barn, lacking a threshing floor, usually with open walls, intended for the dry and well ventilated storage of hay only.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68622">
    <skos:scopeNote xml:lang="en">The homestead of a farm consisting of a farmhouse and working farm buildings, with yards, other working areas and usually a garden to the house.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70027">
    <skos:scopeNote xml:lang="en">Inhumation rite in which charcoal is included with the buried corpse, possibly in an attempt to preserve the body. Thought to be associated with high status burials of the early medieval and medieval period.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91117">
    <skos:scopeNote xml:lang="en">The horizontal beam on a lock gate.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160534">
    <skos:scopeNote xml:lang="en">A mobile piece of equipment used by the Royal Observer Corps to track the movements of enemy aircraft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92870">
    <skos:scopeNote xml:lang="en">Detached block comprising one or more storeys of wards.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68749">
    <skos:scopeNote xml:lang="en">A building or group of buildings owned and operated by a governing body and often occupied by a government agency. Use specific type of building where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70411">
    <skos:scopeNote xml:lang="en">A structure which protects an area of ground from the weather.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91807">
    <skos:scopeNote xml:lang="en">A pit used for containing manure.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69940">
    <skos:scopeNote xml:lang="en">A club founded to provide education, relaxation, and recreation for working men.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92511">
    <skos:scopeNote xml:lang="en">A place where padlocks and rim locks for doors are made from iron and brass.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70344">
    <skos:scopeNote xml:lang="en">A vault or crypt under a church or chapel. Use wider site type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/118873">
    <skos:scopeNote xml:lang="en">A barrier, usually of wood or chain, stretched across the entrance to a harbour, port or anchorage, to control entry and/or limit the effect of the weather on the wave action.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92933">
    <skos:scopeNote xml:lang="en">A place where appropriate acts, rites and ceremonies are performed to honour or revere a supernatural being, power or holy entity. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/151399">
    <skos:scopeNote xml:lang="en">A site where a cable was fired into the air, with parachutes attached to either end, to present an aerial obstruction to bring down, through contact, fouling and general drag, or obstruct the passage of an aircraft. Usually found as one of a group.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70128">
    <skos:scopeNote xml:lang="en">A residence of two or three monks of the Cistercian order dependent on an English mother house.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/100543">
    <skos:scopeNote xml:lang="en">A building used as a headquarters and reporting centre for an Army, Navy or Air Force Group.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/144613">
    <skos:scopeNote xml:lang="en">Heavy anti aircraft battery used from June 1944-May 1945 to combat the V-bomb threat. They are distinct from normal HAA batteries, being laid out in a V-shape, and early on were mainly for mobile 3.7-inch guns.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92399">
    <skos:scopeNote xml:lang="en">A school attended by children between the ages of seven and eleven.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/121256">
    <skos:scopeNote xml:lang="en">An instrument for gauging the amount of rain which has fallen over a stated period.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/103673">
    <skos:scopeNote xml:lang="en">Buildings and structures inhabited by agricultural workers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162984">
    <skos:scopeNote xml:lang="en">A golf course, usually situated on or near the coast, consisting of sand dunes with few trees or water obstacles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69087">
    <skos:scopeNote xml:lang="en">A mill for crushing flint. Crushed flint was used in the manufacture of pottery in order to whiten and strengthen the body of earthenware pottery.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93575">
    <skos:scopeNote xml:lang="en">A place where processed wood is sold.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/136950">
    <skos:scopeNote xml:lang="en">A complex of buildings with the purpose of providing and storing food and drink supplies (esp. for the navy).</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93270">
    <skos:scopeNote xml:lang="en">A stepped, roadside platform, usually of stone on which a sedan chair was placed to allow the porters to lift the chair without having to bend.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164106">
    <skos:scopeNote xml:lang="en">A garden created to commemorate a person or event.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71639">
    <skos:scopeNote xml:lang="en">An establishment dedicated to the study of theology and religious training.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69103">
    <skos:scopeNote xml:lang="en">A bell-shaped pit used in early coal mining. Use with functional type if known, eg. COAL WORKINGS.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91184">
    <skos:scopeNote xml:lang="en">A Hall where billiards was played.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160225">
    <skos:scopeNote xml:lang="en">A siren used to warn of an impending attack by enemy aircraft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91386">
    <skos:scopeNote xml:lang="en">A funerary site, either totally or partially underground, for the depositing of the dead. Often found in cemeteries in the form of a circular or semi-circular sunken area comprising of several galleries with vault entrances built into the side.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69044">
    <skos:scopeNote xml:lang="en">A circular bank in which trees have been planted for ornamental purposes or to create an enclosure. May exist purely as a bank which has been formed over the stumps of the trees which had been planted to form the enclosure.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68739">
    <skos:scopeNote xml:lang="en">A type of guildhall belonging primarily to the London livery companies, but also found elsewhere in the country, so called because of the livery worn by members of the guild.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69137">
    <skos:scopeNote xml:lang="en">Buildings and plant used for the extraction and purification of arsenic oxide into various forms of pure arsenic.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69319">
    <skos:scopeNote xml:lang="en">Usually a cotton spinning factory, although some mills have weaving sheds attached, in which case the end product is completed cloth, not yarn only.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68682">
    <skos:scopeNote xml:lang="en">Civil building in Cornwall and Devon for assay and sale of tin ingots.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71817">
    <skos:scopeNote xml:lang="en">A defensive gun battery positioned to face out to sea to fire on enemy ships and amphibious craft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68605">
    <skos:scopeNote xml:lang="en">A free-standing building with enough space to hang and dry nets.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/118514">
    <skos:scopeNote xml:lang="en">A church, usually found in East Anglia, of early Medieval and/or Medieval date with attached or detached round tower.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70251">
    <skos:scopeNote xml:lang="en">A place where trams are maintained and refitted, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78211">
    <skos:scopeNote xml:lang="en">A single ditched 3-sided rectilinear enclosure.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143457">
    <skos:scopeNote xml:lang="en">A site equipped for active defensive action against an airborne enemy assault.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70421">
    <skos:scopeNote xml:lang="en">An artificially raised level of ground.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91132">
    <skos:scopeNote xml:lang="en">A cemetery for baptist followers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69378">
    <skos:scopeNote xml:lang="en">The rectangular pit in which the lower part of a waterwheel revolves.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68666">
    <skos:scopeNote xml:lang="en">Mushroom-shaped stones used to raise the floor of barns, granaries etc. above ground level, to prevent vermin gaining access to stored grain and fodder.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68996">
    <skos:scopeNote xml:lang="en">Underground chambers and stone passages of Iron Age date found in South West England.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93111">
    <skos:scopeNote xml:lang="en">A library where books may be consulted but not taken away.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/147272">
    <skos:scopeNote xml:lang="en">A residential home for children with physical or learning disabilities, sensory impairment and/or mental health issues but who do not necessarily need medical attention.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69224">
    <skos:scopeNote xml:lang="en">A building or room used for any type of engineering work. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68815">
    <skos:scopeNote xml:lang="en">A place where weapons are kept.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70435">
    <skos:scopeNote xml:lang="en">A covered tank in which rainwater is stored for use when required.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68967">
    <skos:scopeNote xml:lang="en">A Roman under-floor heating system in which hot air heated by a stoked furnace, flowed through channels, created by either raising the floor on pillars of brick and tile or cutting channels into the concrete floor and tiling over them.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91847">
    <skos:scopeNote xml:lang="en">A monument consisting of parallel banks, normally accompanied by ditches, which appears to mark out an approach to another monument or monuments.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93677">
    <skos:scopeNote xml:lang="en">A waterwheel where the inflow of water strikes the paddles or floatboards well below the axis of the wheel, ie. the water more or less passes under it.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69107">
    <skos:scopeNote xml:lang="en">A pit for the extraction of fullers earth (a hydrous silicate of alumina), which was used for cleansing, and finishing, cloth and wool.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170055">
    <skos:scopeNote xml:lang="en">A factory that manufactures watches.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69171">
    <skos:scopeNote xml:lang="en">A building or buildings where soap is manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92098">
    <skos:scopeNote xml:lang="en">A power station used to produce electricity, fired by coal gas.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70180">
    <skos:scopeNote xml:lang="en">A decorative design or illustration, often an anthropomorphic or geometrical image, carved into a stone surface, such as a cave wall or free-standing stone. Usually, though not always, of Prehistoric date.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93413">
    <skos:scopeNote xml:lang="en">A workshop or factory where statues are made by casting molten material into moulds.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91183">
    <skos:scopeNote xml:lang="en">A building containing a bier; a movable stand on which a corpse, often in a coffin, is placed prior to burial.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164397">
    <skos:scopeNote xml:lang="en">A prototype semi-underground silo based launch system specifically designed to hold and fire the Blue Streak Missile. The silo was constructed at RAF Spadeadam in c1959 and abandoned in April 1960.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140491">
    <skos:scopeNote xml:lang="en">A semi-permanent ahed designed to Air Ministry specification 1136/27 as a quick and cheap hangar for stations overseas</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70377">
    <skos:scopeNote xml:lang="en">An area of land which has been drained or cleared for habitation and/or cultivation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93299">
    <skos:scopeNote xml:lang="en">A structure comprising two upright spars, joined at the top to form a triangle, with a hoisting tackle suspended from the apex. Used to lift cargo or other weights.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70402">
    <skos:scopeNote xml:lang="en">A levelled area of ground, circular in shape, used as the base on which a monument was built.Sometimes raised, a platform is often the sole surviving evidence for a monument.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71860">
    <skos:scopeNote xml:lang="en">A place of worship for Christian Scientists, a sect founded in the mid-19th century in America who believe that God is the only reality and can bring healing to humanity.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/152319">
    <skos:scopeNote xml:lang="en">Vertical or horizontal levels driven into a hill slope to assess the viability of mineral resources but never fully exploited.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93185">
    <skos:scopeNote xml:lang="en">A private chapel for a royal court.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71660">
    <skos:scopeNote xml:lang="en">A large room with fixed seating, designed for lectures.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71374">
    <skos:scopeNote xml:lang="en">A building in which goods or items are stored. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94000">
    <skos:scopeNote xml:lang="en">A house of Roman Catholic nuns or canonesses.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91071">
    <skos:scopeNote xml:lang="en">An armoured fighting vehicle. Often survive as commemorative monuments, targets and coastal wrecks.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93043">
    <skos:scopeNote xml:lang="en">A building, within a gas works, housing a gas purifier.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91055">
    <skos:scopeNote xml:lang="en">An indoor market used for the sale of antique goods.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91794">
    <skos:scopeNote xml:lang="en">A shed, often found at a quarry, in which rough stone is shaped or dressed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69337">
    <skos:scopeNote xml:lang="en">An artificial mound of earth indicating either the former site of a windmill or built as the base of a post windmill.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69161">
    <skos:scopeNote xml:lang="en">A factory for the production of plastics by chemical processes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142000">
    <skos:scopeNote xml:lang="en">A building or site where lead is obtained from ore.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70442">
    <skos:scopeNote xml:lang="en">A long, narrow ditch designed to carry water away from a waterlogged area.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93515">
    <skos:scopeNote xml:lang="en">The main office of a telegraph company containing rows of tables set with Morse sounders, keys, relays and pigeon holes from where MORSE coded messages were transmitted and received and telegrams dispatched.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160537">
    <skos:scopeNote xml:lang="en">A military base for the training of SOE operatives in the skills and techniques required to survive in enemy-occupied territory.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70298">
    <skos:scopeNote xml:lang="en">A channel for taking a rapidly flowing stream of water away from a canal lock, or away from the canal itself.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68699">
    <skos:scopeNote xml:lang="en">A building containing celestial telescopes in which astronomical or meteorological phenomena may be observed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69379">
    <skos:scopeNote xml:lang="en">A building to house waterwheels, attached to a WATERMILL or water-powered factory.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69354">
    <skos:scopeNote xml:lang="en">A type of engine house creating power by means of compressed air, typically associated with collieries where it is used for raising coal.</skos:scopeNote>
  </rdf:Description>
