    <skos:scopeNote xml:lang="en">A site, containing installations and machinery, used for measuring the power of explosives.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93784">
    <skos:scopeNote xml:lang="en">A continuous row of WEALDEN HOUSES.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160375">
    <skos:scopeNote xml:lang="en">A building, administered by the Navy, Army and Air Force Institutes, providing retail and leisure services to members of the armed forces.</skos:scopeNote>
  </rdf:Description>
