        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_444992fe"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_465873a0"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_952d41bc"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_b22a4b85"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_ef40cc12"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-03T16:05:57.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T13:45:12.000</terms:modified>
        <skos:altLabel xml:lang="de">Bischofsmütze</skos:altLabel>
        <skos:altLabel xml:lang="de">Infel</skos:altLabel>
        <skos:altLabel xml:lang="de">Inful</skos:altLabel>
        <skos:altLabel xml:lang="fr">infule</skos:altLabel>
        <skos:altLabel xml:lang="en">miter</skos:altLabel>
        <skos:definition xml:lang="de">Mitra f, Inful f, auch Bischofsmütze f, Infel f, infula: aus dem Phrygium entstandene pontifikale Kopfbedeckung; zunächst eine kegelförmige oder runde Haube mit Infulae und Zierbesatz am unteren Rand (mitra cum aurifrisio in circulo); im Laufe des 12. Jh. wird sie eingebuchtet, so dass sich zwei zunächst höckerartige, später  hörnerähnliche Seitenteile ausbilden, wobei die Vertiefung oft durch eine von vorn nach hinten verlaufende Zierborte betont wird (mitra cum aurifrisio in titulo); in der Folge wird die Mitra größer und so aufgesetzt, daß sich die zunächst dreieckigen, später schildförmigen Teile über der Stirn und dem Hinterkopf des Trägers erheben. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Mitra</skos:prefLabel>
        <skos:prefLabel xml:lang="la">infula</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">mitra</skos:prefLabel>
        <skos:prefLabel xml:lang="en">mitre</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">mitre</skos:prefLabel>
    </owl:NamedIndividual>
    


