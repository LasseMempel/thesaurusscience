        <skos:altLabel xml:lang="de">Säulenstuhl</skos:altLabel>
        <skos:altLabel xml:lang="cs">podlaží sloupu</skos:altLabel>
        <skos:altLabel xml:lang="cs">postament sloupu</skos:altLabel>
        <skos:definition xml:lang="cs">Nejvyšší stupeň stereobatu (spodní část stavby antického chrámu), na něm stojí sloupy. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Oberste Stufe des antiken Tempelunterbaus (Stereobat), auf dem die Säulen aufruhen. Dorische Ordnung. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Stylobat, -es, oberste Stufe des Stereobats (Unterbau des antiken Tempels). Auf ihm stehen die Säulen. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Stylobat</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">stylobat</skos:prefLabel>
    </owl:NamedIndividual>
    


