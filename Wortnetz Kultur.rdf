		<skos:prefLabel xml:lang="en">exposed masonry</skos:prefLabel>
		<skos:altLabel xml:lang="en">fairfaced  brickwork</skos:altLabel>
		<skos:prefLabel xml:lang="de">Sichtmauerwerk</skos:prefLabel>
