<http://purl.org/heritagedata/schemes/572/concepts/146457> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/572/concepts/147027> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/572> ;
    skos:prefLabel "Accessway"@en ;
    skos:scopeNote "Means by which access is enabled onto, into and through a vessel. Use more specific narrow terms."@en .

<http://purl.org/heritagedata/schemes/572/concepts/146599> a skos:Concept ;
    skos:altLabel "Decking"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/572/concepts/146610> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/572> ;
    skos:prefLabel "Deck"@en ;
    skos:scopeNote "A floor running the length of a vessel or only part of it, connecting the sides and forming the roof of the compartments or holds."@en .

<http://purl.org/heritagedata/schemes/572/concepts/147101> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/572/concepts/147028> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/572> ;
    skos:prefLabel "Superstructure"@en ;
    skos:scopeNote "The constructions on board a vessel above the upper deck, including deck houses, conning towers etc."@en .

<http://purl.org/heritagedata/schemes/572/concepts/147010> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/572/concepts/146993> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/572> ;
