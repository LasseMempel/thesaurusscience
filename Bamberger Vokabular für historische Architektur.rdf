        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-21T15:19:21.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T19:18:40.000</terms:modified>
        <skos:altLabel xml:lang="cs">větev mimoúrovňové křižovatky</skos:altLabel>
        <skos:definition xml:lang="de">Schräg ansteigende Zufahrt oder Zugang (schiefe Ebene) zu einem erhöhten Platz, einer Terrasse oder einem Bauwerk. Monumentale R.n kommen bei ägypt. Terrassentempeln, bei assyr. Palästen und Zikkurats vor. Beim Bau der Pyramiden verwendete man R.n zum Materialtransport.  R.n mit gewendeltem Lauf nennt man Wendelr.n (Wendeltürme: Samarra, Spiralturm, Minar). [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Rampe</skos:prefLabel>
        <skos:prefLabel xml:lang="en">ramp</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">rampa</skos:prefLabel>
        <skos:prefLabel xml:lang="es">rampa</skos:prefLabel>
        <skos:prefLabel xml:lang="it">rampa</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">rampe (d\&apos;accés)</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_df3fefed -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_df3fefed">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0cb8deb1"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_5bf6bcac"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-15T14:29:40.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T16:36:10.000</terms:modified>
        <skos:altLabel xml:lang="de">Abdeckstein</skos:altLabel>
        <skos:definition xml:lang="de">Jede Art von Dachziegel oder Mauerziegel, der zur Abdeckung einer Mauer verwendet wird. Von den Dachziegeln eignen sich hierzu insbesondere  Biberschwanzziegel, Hohlpfannen sowie Mönch-Nonne-Ziegel, aber auch Falzdachziegel. [Schrader / Voigt 2003]</skos:definition>
        <skos:definition xml:lang="de">Zur Abdeckung von freistehenden Mauern als Backsteine (Rollschicht), Dachsteine, Formsteine oder Betonplatten zum Schutz gegen das Eindringen von Niederschlägen in die Stoßfugen des Mauerwerks. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Abdeckziegel</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_0cb8deb1"/>
    </owl:NamedIndividual>
    


