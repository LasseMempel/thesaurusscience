	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk003153">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Ädicula</skos:altLabel>
		<skos:prefLabel xml:lang="de">Ädikula</skos:prefLabel>
		<skos:prefLabel xml:lang="en">aedicula</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006917"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk012074"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk012142"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk006917"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk001407"/>
		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk001935"/>
		<xe:explanation_temp xml:lang="de">Eine Ädikula besteht wenigstens aus Stützen (Pilaster, Wandpfeiler o.ä.) und einer Überdachung. Die Ädikula wird von der Bekrönung dadurch unterschieden, dass die Höhe der Stützen der Höhe des gerahmten Elements entsprechen. Eine Ädikula ist immer Zierelement, nicht Front eines Gebäudes oder Raumes.</xe:explanation_temp>
		<skos:definition xml:lang="de">Eine Ädikula ist ein Architekturelement, das als kleine übergiebelte Hausfront in antikisierender Form eine Nische, ein Portal, ein Fenster oder ähnliches rahmt.</skos:definition>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4367330-2"/>
