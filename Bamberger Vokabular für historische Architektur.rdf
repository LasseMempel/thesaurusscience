        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-25T14:26:28.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T18:47:59.000</terms:modified>
        <skos:definition xml:lang="de">Konstruktion einer Tür aus einem Futterrahmen und einer beidseitigen Bekleidung. Das überfälzte Türblatt schlägt in einen Falz ein, der aus dem Futter und der bandseitigen Falzbekleidung gebildet wird. [Schrader / Voigt 2003]</skos:definition>
        <skos:prefLabel xml:lang="de">Futtertür</skos:prefLabel>
    </owl:NamedIndividual>
    


