        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-03T17:37:41.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T15:16:04.000</terms:modified>
        <skos:altLabel xml:lang="de">Klosterfrau</skos:altLabel>
        <skos:altLabel xml:lang="de">Klosterschwester</skos:altLabel>
        <skos:altLabel xml:lang="de">Ordensfrau</skos:altLabel>
        <skos:altLabel xml:lang="de">Ordensschwester</skos:altLabel>
        <skos:definition xml:lang="de">Nonne f; auch Ordensfrau f; Klosterschwester f; Klosterfrau f; lat. monacha: Angehörige eines religiösen Frauenordens. Sie hat die Gelübde (Armut, Keuschheit, Gehorsam) abgelegt und lebt nach festen Regeln der Gemeinschaft. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Nonne</skos:prefLabel>
        <skos:prefLabel xml:lang="la">monacha</skos:prefLabel>
        <skos:prefLabel xml:lang="en">nun</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">religieuse</skos:prefLabel>
    </owl:NamedIndividual>
    


