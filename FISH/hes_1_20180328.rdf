	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/572">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/572</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">SAOBH-THOGALACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar anns nach eil cus feum no a tha gu tur gun fheum. Gheibhear iad seo gu tric ann an gàrraidhean dealbhaichte on 18mh linn agus tha iomadh coltas orra eadar tùir, caistealan, teampaill, cùirn agus cillean aonaran.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">FOLLY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/569" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/594" />
		<skos:scopeNote xml:lang="en">A structure with little or no practical purpose. Often found in 18th century landscaped gardens, they may take many forms, including towers, castles, temples, cairns and hermit's cells.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/573">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/573</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH-GÀRRAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach beag sgeadachail ann an gàrradh, mar is trice cha bhi ann ach aon làr is aon seòmar. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GARDEN HOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/569" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/106" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/604" />
		<skos:scopeNote xml:lang="en">A small ornamental building in a garden, usually one-storied and consisting of one room. Use a more specific term where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/574">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/574</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TEAMPALL GÀRRAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach gàrraidh, mar is trice le dreach Gothach no clasaigeach air. Faodar am briathar seo a thoirt air iomadh seòrsa de thogalach gàrraidh aig a bheil àite suidhe no seasaimh na bhroinn.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GARDEN TEMPLE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/569" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1751" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500648" />
		<skos:scopeNote xml:lang="en">A garden building, usually in the Gothic or classical style. The term can be applied to many types of garden building with an interior space in which to stand or sit.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/576">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/576</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">PÀILLEAN GÀRRAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Taigh-gàrraidh a tha ann an àite far a bheil deagh-radharc mun cuairt.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GAZEBO</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/569" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/503640" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/503700" />
		<skos:scopeNote xml:lang="en">A garden house situated to provide a commanding view.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/578">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/578</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">GRIANAN-GLAINNE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Taigh-glaine, co-dhiù ri togalach eile no na sheasamh leis fhèin far a bheilear a' toirt fàs air lusan 's gan sealltainn.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CONSERVATORY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/35" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/107" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/424" />
		<skos:scopeNote xml:lang="en">A glasshouse, either adjoining a building or freestanding, used to grow and display plants.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/580">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/580</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH-AONARAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Ionad nàdarra no rud a chaidh a thogail ann an àite aonaranach mar dhìseart no àite tàimh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HERMITAGE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1645" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/569" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/594" />
		<skos:scopeNote xml:lang="en">A built or natural feature in a secluded location, used as a retreat or resting place.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/584">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/584</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FEART GÀRRAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Cruth san tìr gun sònrachadh. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GARDEN FEATURE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/552" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/106" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/424" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/604" />
		<skos:scopeNote xml:lang="en">Unspecified landscape feature. Use more specific term where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/585">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/585</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BALL-SGEADACHAIDH  GÀRRAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Cruth no structar sgeadachail am broinn gàrraidh. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GARDEN ORNAMENT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">ORNAMENT</skos:altLabel>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/588" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/552" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/586" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/587" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/590">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/590</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">UAIREADAIR-GRÈINE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Structar a sheallas àm an latha, 's a' ghrian a' tilgeil sgàil a-rèir faileasaiche air uachdar an daitheal air a bheil pàtran a tha a' sealltainn uairean an latha. Faodaidh seo seasamh leis fhèin, mar is trice air carragh, no a bhith ri togalach.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">SUNDIAL</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/585" />
				<skos:scopeNote xml:lang="en">A structure used to show the time of day by means of the sun shining on a 'gnomon', the shadow of which falls on the surface of the dial which is marked with a diagram showing the hours. Can be freestanding, usually on a pillar, or fixed to a building.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/591" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/506141" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/106" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/560" />
		<skos:scopeNote xml:lang="en">A decorative feature or structure set within the area of a garden. Use more specific term where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/586">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/586</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">OBEILEASG</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Carragh cloiche a tha ceàrnagach no ceart-cheàrnach air a roinn-tarsainn le ceann biorramaideach. Ga chleachdadh mar chuimhneachan poblach, tìodhlacaidh no gàrraidh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">OBELISK</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/585" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500546" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/589" />
		<skos:scopeNote xml:lang="en">A stone pillar, square or rectangular in cross section, with a pyramidal top. Used as a public, funerary or garden monument.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/587">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/587</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TOBAR SGEADAICHTE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Tobar agus structar na cheann a chaidh a thogail mar rud sgeadachail ann an gàrraidh no àite poblach.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ORNAMENTAL WELL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/585" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1989" />
		<skos:scopeNote xml:lang="en">A well and superstructure constructed as an ornamental feature in a garden or public space.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/588">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/588</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">ÌOMHAIGH-SHNAIGHTE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Dealbhadh figearail no eas-chruthach na rilif no air a cheithir timcheall 's a chaidh a chruthachadh le bhith a' snaidheadh clach no fiodh, a' cumadh criadh no a' mòlltachadh meatailt no dòigh mar sin.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SCULPTURE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">SCULPTED ROCK</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/585" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/589" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/609" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1499" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1504" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/203" />
		<skos:scopeNote xml:lang="en">A figurative or abstract design in the round or in relief, made by chiselling stone, carving wood, modelling clay, casting metal, or similar processes.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/589">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/589</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">ÌOMHAIGH-EALAIN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Riochd, air a cheithir thimcheall, de chreutair beò, pearsa samhlachail, duine no beathach ainmeil is msaa, air a shnaidheadh no a mhòlltachadh ann am marmor, meatailt, plàst is msaa.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">STATUE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/588" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500546" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/506121" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/506122" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/586" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/591" />
		<skos:scopeNote xml:lang="en">A representation in the round of a living being, allegorical personage, eminent person or animal, etc, sculptured, moulded or cast in marble, metal, plaster, etc.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/591">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/591</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BIOR-PHOIT</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Ball-maise gàrraidh, mar is trice de chlach no meatailt, air cruth bhàsa airson luaithre nam marbh. Ma tha ceangal ri tìodhlacadh losgadh-cuirp ro-eachdraidheil, cleachd POIT-TASGAIDH LUAITHRE</skos:scopeNote>
		<skos:prefLabel xml:lang="en">URN (GARDEN)</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-07-24T10:43:18</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/585" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/589" />
		<skos:scopeNote xml:lang="en">A garden ornament, usually of stone or metal, in the form of a vase used to receive the ashes of the dead. When associated with prehistoric cremation burials use CINERARY URN from Objects Thesaurus.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/592">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/592</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BALLA GÀRRAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Balla cloiche no bhreigean ann an gàrradh no mun cuairt air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GARDEN WALL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/552" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1454" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/106" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/595" />
		<skos:scopeNote xml:lang="en">A stone or brick wall either in, or enclosing, a garden.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/593">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/593</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">RÈIDHLEAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite feurach no pàirc, gu h-àraidh am meadhan clachain.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GREEN</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/552" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/106" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/600" />
		<skos:scopeNote xml:lang="en">An area of grass or parkland, especially at the centre of a village.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/594">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/594</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">GROTTO</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Uamh no cill fhuadain, gu math tric air a sgeadachadh le aol-chluigean is sligeanan. Chaidh a' chuid as motha dhiubh a thogail mar bhuill-mhaise gàrraidh air talamh taighean mòra na 18mh linn.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GROTTO</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/552" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/572" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/580" />
		<skos:scopeNote xml:lang="en">An artificial cave or cell, often decorated with stalactites and shells. Most were constructed as  garden features in the grounds of large 18th century houses.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/595">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/595</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">HA HA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Dìg thioram no dubh-fheansa a tha a' sgaradh an gàrradh foirmeil on phàirc dhealbhaichte gun a bhith a' briseadh a-steach air an t-sealladh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HA HA</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/552" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/108" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1460" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/592" />
		<skos:scopeNote xml:lang="en">A dry ditch or sunken fence which divided the formal garden from the landscaped park without interrupting the view.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/599">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/599</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">IOMA-SHLIGHE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Pàtran breisleachail 's toinnte de shlighean is trannsachan, gu math tric ann an gàrradh foirmeil 's le callaidean no ballachan àrda mun cuairt air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MAZE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">LABYRINTH</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/552" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/108" />
		<skos:scopeNote xml:lang="en">A confusing and baffling network of paths or passages, often set within a formal garden and bounded by high hedges or walls.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/600">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/600</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">PÀIRC</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Talamh cuairtichte, mar is trice pìos gu math mòr, far a bheilear a' sealg, a' toirt fàs air craobhan, ag ionaltradh caoraich 's crodh no a tha dìreach taitneach dhan t-sùil. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PARK</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/552" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/87" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/602" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500637" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501702" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/106" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/593" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/91" />
		<skos:scopeNote xml:lang="en">An enclosed piece of land, generally large in area, used for hunting, the cultivation of trees, for grazing sheep and cattle or visual enjoyment. Use more specific type where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/602">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/602</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">PÀIRC PHOBLACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Pàirc airson tlachd is fois a' phobaill.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PUBLIC PARK</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/600" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502200" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/508622" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/556" />
		<skos:scopeNote xml:lang="en">A park for the use of the public for entertainment and relaxation.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/604">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/604</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">PÀILLEAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar aotrom (uaireannan rud sgeadachail) ann an gàrradh, pàirc no àite foise airson tlachd no fasgadh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PAVILION</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/552" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502888" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/569" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/573" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/584" />
		<skos:scopeNote xml:lang="en">A light, sometimes ornamental structure in a garden, park or place of recreation, used for entertainment or shelter.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/606">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/606</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÒN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Uisgeadan no àite far an deach sruth a leudachadh. Faodaidh seo a bhith na rud nàdarra no fuadain. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">POOL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/552" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/607" />
		<skos:scopeNote xml:lang="en">A small body of water or widened section of a watercourse, either natural or artificially created. Use specific term where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/607">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/607</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">AMAR-SNÀMH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Linn mhòr fhuadain, mar is trice air a lìnigeadh le leacagan, rubair no rud mar sin. Gheibhear seo air an taobh a-muigh no ann an togalach le mullach mar phàirt de thaigh-snàmh no ionad-spòrs. Mas e togalach sa bheil amar-snàmh agus togalaichean co-cheangailte ann, cuir TAIGH AMAIR-SHNÀIMH ris a' chlàr-amais cuideachd.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SWIMMING POOL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-05-20T15:49:52</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1627" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/606" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502191" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/504740" />
		<skos:scopeNote xml:lang="en">A large artificial pool, usually lined with tiles, rubber or similar. Can be placed in the open air, or built as part of a covered swimming baths or sports centre. For a building with a swimming pool and associated buildings, double index with BATHS.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/608">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/608</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">PROMANAD</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite poblach airson coiseachd ann is msaa. Mar is trice gheibhear seo ann am bailtean turasachd air a' chosta.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PROMENADE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/552" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1384" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1433" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1796" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501684" />
		<skos:scopeNote xml:lang="en">A place for strolling, public walks, etc. Usually associated with coastal resorts.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
