    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_c9937a95 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_c9937a95">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b4ffaac7"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_60999343"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_5063ecfd"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T18:08:42.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T12:18:07.000</terms:modified>
        <skos:definition xml:lang="de">Kapellenkranz, radial auf einen Mittelpunkt bezogene Kapellen, an einem halbrunden oder polygonalen Chor bzw. Chorumgang. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Na tento ochoz často navazují chórové kaple jako věnec kaplí, které se otevírají směrem do chórového ochozu a bývají většinou patrné na vnějším půdorysu kostela. Jestliže se jejich osy protínají v jednom bodě, nazýváme je radiální kaple. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Kapellenkranz</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">věnec kaplí</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_c997baa1 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_c997baa1">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_298d4e12"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T10:18:24.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T14:05:47.000</terms:modified>
        <skos:altLabel xml:lang="de">Muschelwerk</skos:altLabel>
        <skos:altLabel xml:lang="cs">lasturový ornament</skos:altLabel>
        <skos:altLabel xml:lang="cs">rokaj</skos:altLabel>
        <skos:definition xml:lang="de">1. Muschelwerk in künstl. Grotten. 2. Muschelformen ähnl., asymmetr. Dekorationselement der Spätbarockzeit, nach dem der ganze Stil auch Rokoko genannt wurde. [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Muschelartiges unsymmetrisches Ornament des Spätbarock. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Ornament der Spätrenaissance, als Rocaille im frz., besonders im deutschen Rokoko stil- und namenbildend. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Pozdní renesance - jako rokaj ve francouzském rokoku, charakteristický zvl. pro německé rokoko. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="es"> rocalla</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Rocaille</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">mušlový ornament</skos:prefLabel>
        <skos:prefLabel xml:lang="en">rocaille</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">rocaille</skos:prefLabel>
        <skos:prefLabel xml:lang="it">rocaille</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_c99a60cb -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_c99a60cb">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_ca67fbbf"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-07T09:52:49.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T17:57:55.000</terms:modified>
        <skos:definition xml:lang="de">Verringerung des Eckinterkolumniums. Die E. tritt am dor. Tempel als Folge des Triglyphenkonfliktes auf. Bei den anderen Säulenordnungen tritt manchmal eine E. (meist über zwei Interkolumnien) als opt. Korrektur auf. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Eckkontraktion</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_c99ce325 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_c99ce325">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
