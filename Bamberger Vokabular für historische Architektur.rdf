        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-10T09:56:27.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T15:39:29.000</terms:modified>
        <skos:altLabel xml:lang="fr">mur porteur</skos:altLabel>
        <skos:definition xml:lang="de">Eine Mauer, die konstruktiv tragend ausgebildet ist. [Koepf / Binding 2016]</skos:definition>
