        <skos:definition xml:lang="de">(1) Handelsname für ein spezielles gegossenes Ornamentglas. (2) Modernes farbiges Gussglas mit bewusst herbeigeführten Schlieren, um den Eindruck von altem, mundgeblasenem Glas herbeizuführen. [Schrader / Voigt 2003]</skos:definition>
        <skos:prefLabel xml:lang="de">altdeutsches Glas</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_559aaa4e -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_559aaa4e">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_2b8c8e23"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
