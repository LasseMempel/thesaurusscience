        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-18T08:37:37.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-18T08:38:52.000</terms:modified>
        <skos:definition xml:lang="de">Auf das Querholz meist aufgesetzte, seltener mit diesem aus einem Stück gefertigter äußerer Zierstab mit einem Zierprofil. Bei entsprechender Gestaltung ist eine Wirkung als Wetterbrett, vergleichbar mit dem Wetterschenkel, beabsichtigt. [Noky 1996]</skos:definition>
        <skos:prefLabel xml:lang="de">Querzierholz</skos:prefLabel>
    </owl:NamedIndividual>
    


