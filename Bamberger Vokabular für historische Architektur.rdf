        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-11T20:50:53.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T17:52:30.000</terms:modified>
        <skos:altLabel xml:lang="fr"> brique de mur</skos:altLabel>
        <skos:altLabel xml:lang="de">Backstein</skos:altLabel>
        <skos:altLabel xml:lang="de">Klinker</skos:altLabel>
        <skos:altLabel xml:lang="de">Klinkerziegel</skos:altLabel>
        <skos:altLabel xml:lang="de">Lehmziegel</skos:altLabel>
        <skos:altLabel xml:lang="de">Tonziegel</skos:altLabel>
        <skos:altLabel xml:lang="de">Ziegel</skos:altLabel>
        <skos:altLabel xml:lang="de">Ziegelstein</skos:altLabel>
        <skos:altLabel xml:lang="es">ladrillo</skos:altLabel>
        <skos:altLabel xml:lang="it">mattone</skos:altLabel>
        <skos:altLabel xml:lang="en">tile</skos:altLabel>
        <skos:note xml:lang="en">A manufactured structural unit of clay or shale produced in the form of a rectangular block, either sun-dried or baked (fired), and used as a building material in masonry. [EwaGlos]</skos:note>
        <skos:note xml:lang="de">Der aus gebranntem Ton hergestellte Dachziegel: Biberschwanz, Pfannendach, Leistenziegel, Hohlziegel, Krempz„ Falzz. sowie Sonderformen wie Grat-, First und Ortz. (Dachdeckung). Heute häufig fälschl. für Backstein verwandt. [Koepf / Binding 2016]</skos:note>
        <skos:note xml:lang="de">Ein aus tonhaltigem Lehm oder Tonschiefer gefertigtes Bauelement in Form eines rechteckigen Blocks, entweder getrocknet oder gebrannt und als Baumaterial für Mauerwerk verwendet. [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="de">Mauerziegel</skos:prefLabel>
        <skos:prefLabel xml:lang="en">brick</skos:prefLabel>
        <skos:prefLabel xml:lang="it">tegola</skos:prefLabel>
        <skos:prefLabel xml:lang="es">teja</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">tuile</skos:prefLabel>
    </owl:NamedIndividual>
    


