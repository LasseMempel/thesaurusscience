        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T15:40:16.000</terms:modified>
        <skos:definition xml:lang="de">Beinreliquiar n: ein Reliquienbehälter in Form eines menschlichen Beines, auch nur eines Ober- oder Unterschenkels. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Beinreliquiar</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">jambe-reliquaire</skos:prefLabel>
