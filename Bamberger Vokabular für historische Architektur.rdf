        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-23T17:01:14.000</terms:modified>
        <skos:definition xml:lang="de">Massivdecke aus Stahlbeton. Die an der Untersicht vortretenden Balken und die quer darüber verlegte Deckenplatte bilden eine stat. Einheit. Werden schlankere Balken (Rippen) in geringeren Abständen angeordnet, spricht man von Rippendecke. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="es"> cubierta de losa con vigas T. </skos:prefLabel>
        <skos:prefLabel xml:lang="it"> solaio pieno su travi di c.c.a.</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Plattenbalkendecke</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">plancher de poutres en T</skos:prefLabel>
    </owl:NamedIndividual>
    


