        <skos:altLabel xml:lang="fr">chrœur bas</skos:altLabel>
        <skos:definition xml:lang="de">Am östl. Ende des Kirchenschiffs, westl. vom Hohen Chor, tiefer als dieser gelegen, von Schranken umgrenzter Raum für Sänger und niedere Kleriker oder in Klosterkirchen für kranke Mönche. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Unterchor</skos:prefLabel>
        <skos:prefLabel xml:lang="en">antechoir</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">chrœur inférieur</skos:prefLabel>
        <skos:prefLabel xml:lang="es">coro inferior</skos:prefLabel>
        <skos:prefLabel xml:lang="it">coro inferiore</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">nezvýšená část chóru určená zpěvákům a nižším klerikům</skos:prefLabel>
    </owl:NamedIndividual>
    


