		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/2010" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1875" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1248" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500693" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/504220" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/503394" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/902" />
		<skos:scopeNote xml:lang="en">A channel used for or formed by the conveyance of water. Can be natural, e.g. a river or artificial e.g. an aqueduct. Use more specific type where known.</skos:scopeNote>
