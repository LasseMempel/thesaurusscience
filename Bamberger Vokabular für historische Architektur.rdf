        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-28T15:58:20.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-21T18:19:27.000</terms:modified>
        <skos:definition xml:lang="de">Chorus minor (lat.), in Kirchen der Hirsauer oder der Cluniazenser der &gt;kleinere Chor&lt;, der sich anschließend an den Chorus major bis zum ersten Stützenpaar des Langhauses erstreckt. Zur Markierung der Grenze gegen den Gemeinderaum besteht dieses Stützenpaar bei Säulenbasiliken aus Pfeilern, auch ist über ihm manchmal ein Querbogen angeordnet. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Chorus minor</skos:prefLabel>
    </owl:NamedIndividual>
    


