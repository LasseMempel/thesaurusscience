    <!-- https://hist-arch-vocab.org/bvha#c_a2f5fc82 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_a2f5fc82">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_6c7aaf05"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_1002d8ed"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_19ead827"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_3760a879"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_be8e5275"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_c435cb0f"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T13:39:57.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-24T09:01:54.000</terms:modified>
        <skos:definition xml:lang="de">Gebrannte, meist glasierte Tonfliese als Wand-, Fußboden- oder Ofenbelag. Berühmt sind die kobaltblau bemalten Delfter Kacheln, die islamisch-spanischen Azulejos (span. azul = blau, arab. al zulaich = kleiner Stein) und die Kacheln des englischen Mittelalters. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Pálená, většinou glazovaná keramická dlaždice používaná k obkladu stěn, podlah nebo kamen; proslulé jsou delftské kachle v kobaltové modři, islámsko-španělské azulejos (špaň. azul = modrý, arab. al culaich = kamínek), a kachle anglického středověku. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Kachel</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kachel</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_a3070567 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_a3070567">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_36969a5d"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_v04spf8z"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-24T18:26:44.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-18T17:50:27.000</terms:modified>
        <skos:note xml:lang="en">A sculptural technique which creates high, mid or low projections from a flat surface or excavated forms below a surface. [EwaGlos]</skos:note>
        <skos:note xml:lang="de">Eine plastische Technik, mit der hohe, mittlere oder niedrige Strukturen aus einer ebenen Fläche heraus geformt werden oder in die Oberfläche versenkte Strukturen eingetieft werden. [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="de">Relief (Technik)</skos:prefLabel>
        <skos:prefLabel xml:lang="en">relief</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">reliéf (technika)</skos:prefLabel>
    </owl:NamedIndividual>
    


