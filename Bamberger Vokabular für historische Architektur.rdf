        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T15:42:30.000</terms:modified>
        <skos:note xml:lang="en">A solution of a binder in a solvent, applied for aesthetic or protective purposes as a thin, transparent coating, as a final layer over a painting. [EwaGlos]</skos:note>
        <skos:note xml:lang="de">Lösung aus Bindemittel in Lösemittel, die aus ästhetischen Gründen oder zum Schutz als dünne, transparente Beschichtung zuletzt auf die Malerei aufgetragen wird. [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="de">Firnis</skos:prefLabel>
        <skos:prefLabel xml:lang="en">varnish</skos:prefLabel>
    </owl:NamedIndividual>
    


