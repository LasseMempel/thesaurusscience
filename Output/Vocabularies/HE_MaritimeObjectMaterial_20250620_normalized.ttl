    skos:prefLabel "Fir"@en ;
    skos:scopeNote "The wood of the evergreen coniferous tree characterized by single needlelike leaves and errect cones."@en .

<http://purl.org/heritagedata/schemes/73/concepts/141284> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75414> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Elm"@en ;
    skos:scopeNote "A hard, durable wood obtained from trees of the genus Ulmus."@en .

<http://purl.org/heritagedata/schemes/73/concepts/141340> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75414> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Pine"@en ;
    skos:scopeNote "A straightgrained, durable and often resinous timber obtained from trees of the genus Pinus."@en .

<http://purl.org/heritagedata/schemes/73/concepts/141973> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75414> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Spruce"@en ;
