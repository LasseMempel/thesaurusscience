<http://www.eionet.europa.eu/gemet/concept/10666> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5507> ;
    skos:closeMatch <http://data.uba.de/umt/_00049668> ;
    skos:definition "The sum of the earth's or a particular region's non-human, non-vegetable, multicellular organisms viewed as the inheritance of the present generation, especially animal species deemed worthy of preservation and protection from extinction."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Tiererbgut"@de,
        "animal heritage"@en .

<http://www.eionet.europa.eu/gemet/concept/10667> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5507> ;
    skos:closeMatch <http://data.uba.de/umt/_00050922> ;
    skos:definition "The sum of the earth's or a particular region's herb, vegetable, shrub and tree life viewed as the inheritance of the present generation, especially plant species deemed worthy of preservation and protection from extinction."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Pflanzenerbgut"@de,
        "plant heritage"@en .

<http://www.eionet.europa.eu/gemet/concept/1067> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1899> ;
    skos:closeMatch <http://data.uba.de/umt/_00047352> ;
    skos:definition "The cultivation of flower bulb is divided into two sectors: for forcing (flower bulbs used by professional growers for the production of cut flowers and potted plants) and for dry sales (flower bulbs for garden planting, flower pots, landscaping and parks)."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Blumenzwiebelkultur"@de,
        "bulb cultivation"@en .

<http://www.eionet.europa.eu/gemet/concept/10671> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7986> ;
    skos:closeMatch <http://data.uba.de/umt/_00049680> ;
    skos:definition "Attempts made to prevent the extinction of threatened species and populations by reintroducing them in their natural habitat. The reintroduction of species in a region requires a preliminary study to establish the reasons of their disappearance and the modifications that might have occurred in the biotopes."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Wiedereinbürgerung von Tierarten"@de,
        "animal species reintroduction"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Reintroduction> .

<http://www.eionet.europa.eu/gemet/concept/10672> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7986> ;
    skos:closeMatch <http://data.uba.de/umt/_00050925> ;
    skos:definition "Reintroducing wild plant species to their natural habitat. The reintroduction of species in a region requires a preliminary study to establish the reasons of their disappearance and the modifications that might have occurred in the biotopes."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Wiedereinbürgergung von Pflanzenarten"@de,
        "plant species reintroduction"@en .

<http://www.eionet.europa.eu/gemet/concept/10685> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8664> ;
    skos:closeMatch <http://data.uba.de/umt/_00051506>,
        <http://dbpedia.org/resource/Windfall> ;
    skos:definition """1) Falling of old trees in a forest caused by a storm or strong wind. It plays an important role in the spontaneous regeneration of forest ecosystems.
2) A plot of land covered with trees blown down by the wind."""@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Windbruch"@de,
        "windfall"@en .

<http://www.eionet.europa.eu/gemet/concept/10691> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/210> ;
    skos:closeMatch <http://dbpedia.org/resource/Pruning> ;
    skos:definition "The cutting off or removal of dead or living parts or branches of a plant to improve shape or growth."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_6274>,
        <http://eurovoc.europa.eu/832> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Beschneiden"@de,
        "pruning"@en .

<http://www.eionet.europa.eu/gemet/concept/10694> a skos:Concept ;
