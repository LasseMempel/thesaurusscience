        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_dl5bae0w"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_f203c4ff"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_ocrgmb3c"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-18T14:03:33.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-10-26T16:40:09.000</terms:modified>
        <skos:prefLabel xml:lang="de">Historisches Ereignis</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Ein Ereignis ist die konkrete, lokal wie temporal einzugrenzende Manifestation eines an sich abstrakten Vorgangs, einer Handlung oder eines Prozesses. Concepts unter &quot;Historisches Ereignis&quot; können als Instanzen für allgemeine Begriffe unter dem Top Concept &quot;Vorgang&quot; angesehen werden. So stellt das Concept „Wiederaufbau nach dem Zweiten Weltkrieg“ ein zeitlich wie räumlich klar zu fassendes historisches Ereignis dar, wohingegen das Concept „Wiederaufbau“ den allgemeinen Vorgang des Wiederaufbauens, der an unterschiedlichen Orten zu unterschiedlichen Zeitpunkten stattfinden kann, meint.</skos:scopeNote>
    </owl:NamedIndividual>
    


