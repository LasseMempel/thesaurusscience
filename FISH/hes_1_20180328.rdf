		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500625" />
		<skos:scopeNote xml:lang="en">A multi-purpose commercial building, used primarily as a trading place for merchants, but also incorporating shops, public offices, guildhalls, etc.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
