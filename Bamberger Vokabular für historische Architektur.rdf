    <!-- https://hist-arch-vocab.org/bvha#c_4850c487 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_4850c487">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a9fbb4e9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_a9fbb4e9"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T16:24:39.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T23:51:18.000</terms:modified>
        <skos:definition xml:lang="de">Buleuterion, (gr. bouleuterion), das Rathaus der gr. Stadt, im Unterschied zum Sitz der städt. Beamten (Prytaneion) der Ort für die Vollversammlungen des Rats (Bule), meist in der Nähe des Marktes (Agora) gelegen. In hellenist. Zeit bestand das B. aus einem Vorhof, den man durch einen Torbau (Propylon) betrat, und dem eigentl. Rathaus, das im Innern halbkreisförmig ansteigende Sitzstufen wie im Theater (jedoch ohne Bühne), manchmal auch in U-förmiger Anordnung, besaß. Außen häufig durch Halbsäulen oder Pfeiler gegliedert, hoch liegende Fenster. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Buleuterion, Bouleuterion (griech. bule = Rat), städtischer Versammlungsraum, Rathaus der griechischen und hellenistischen Antike. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Místo pro městská shromáždění, radnice v období řecké a helénistické antiky. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Buleuterion</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">buleuterion</skos:prefLabel>
    </owl:NamedIndividual>
    


