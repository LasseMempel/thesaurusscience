		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk008679"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk015390"/>
		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk015079"/>
		<skos:definition xml:lang="de">Ein Bräter ist ein großes ofenfestes Kochgefäß mit hohem Rand, ovaler oder rechteckiger Form, zwei Griffen und hohem Deckel, in der Speisen, meist Fleisch, auf dem Herd gebraten und anschließend im Ofen geschmort werden. Bräter sind meist aus Eisen, vor allem Gusseisen oder Emaille,  können aber auch aus Ton, Keramik oder Glas bestehen. Sie können sowohl zu den Pfannen als auch zu den Töpfen gezählt werden.</skos:definition>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300196792"/>
		<skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q20820315"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk013704"/>
