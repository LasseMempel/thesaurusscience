    <!-- https://hist-arch-vocab.org/bvha#c_60f1ef40 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_60f1ef40">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_be091023"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_19d56a39"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-14T10:31:51.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T14:10:14.000</terms:modified>
        <skos:definition xml:lang="de">Fugennägel sind relativ kurze, vierkantig spitz zulaufende Nägel, die schräg gegenständig in die Fuge zwischen Blatt und Sasse eingetrieben werden. Eine Vorbohrung ist erforderlich. Der Fugennagel sichert vor allem das Herausdrehen des Blattes aus der Sasse. (Eißing et al. 2012)</skos:definition>
        <skos:prefLabel xml:lang="de">Fugennagel</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_60fcc7d2 -->


