        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-25T10:20:52.000</terms:modified>
        <skos:altLabel xml:lang="de">Fledermausdachfenster</skos:altLabel>
        <skos:altLabel xml:lang="de">Froschmaul</skos:altLabel>
        <skos:definition xml:lang="de">Fledermausdachfenster, Fledermausgaube, Dachfenster mit senkrechter Stirnwand, deren obere Begrenzung bogenförmig ausgebildet ist, wobei die Dachdeckung der Gaube ohne Kehlenbildung stetig in die Dachfläche übergeht, bes. für Biberschwanz-, Schiefer- und Strohdeckung geeignet. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Fledermausgaube</skos:prefLabel>
    </owl:NamedIndividual>
    


