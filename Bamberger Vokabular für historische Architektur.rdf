        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-28T16:35:53.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T16:55:58.000</terms:modified>
        <skos:definition xml:lang="de">Ein schwächer ausgebildeter Dienst. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Junger Dienst, weniger betonter, dünnerer Dienst eines Bündelpfeilers im Gegensatz zum Alten Dienst. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Junger Dienst</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">colonnette mineure</skos:prefLabel>
        <skos:prefLabel xml:lang="en">secondary vaulting shaft</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">vedlejší přípora</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Ein unter den Längsgurten und Diagonalrippen (Kreuzrippen) verlaufender schwacher Dienst. [Koch 2009]</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_f6c108c4 -->


