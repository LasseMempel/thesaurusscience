	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/122">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/122</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">POILEASAIDHEAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Am fearann leasaichte mun cuairt air taigh-dùthcha ann an Alba.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">POLICIES</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
