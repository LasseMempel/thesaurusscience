        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_8fa30f59"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-18T16:22:55.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T21:04:56.000</terms:modified>
        <skos:altLabel xml:lang="de">Leiste</skos:altLabel>
        <skos:altLabel xml:lang="en">frontlet</skos:altLabel>
        <skos:altLabel xml:lang="de">Überhang</skos:altLabel>
        <skos:definition xml:lang="de">Superfrontale η, lat.; Überhang m; auch Leiste f: einem kurzen Volant ähnelnder, in ganzer Breite von der Mensa herunterhängender Stoffstreifen, meist aus Seide und mit Gold- oder Seidenfransen besetzt. Das Superfrontale war ursprünglich ein am oberen Altartuch festgemachtes, eigenständiges Parament, wurde dann aber mit dem Antependium verbunden. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Superfrontale</skos:prefLabel>
        <skos:prefLabel xml:lang="en">superfrontal</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">superfrontal</skos:prefLabel>
    </owl:NamedIndividual>
    


