    <!-- https://hist-arch-vocab.org/bvha#c_503471f6 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_503471f6">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b8ea47ea"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_b41bd73a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-11T18:30:00.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T14:11:18.000</terms:modified>
        <skos:definition xml:lang="de">Falz am Flügelrahmen, welcher sich an den Überschlag am Flügel nach außen anschließt und den Wind brechen soll, der sonst in den Einschlagfalz drückt. [Noky 1996]</skos:definition>
        <skos:prefLabel xml:lang="de">Windfalz</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_503d0ca1 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_503d0ca1">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_194b08ce"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T13:37:16.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-02T16:17:23.000</terms:modified>
        <skos:definition xml:lang="de">Parallelprojektion, Parallelriss, zur Unterscheidung von der Zentralperspektive auch Parallelperspektive genannt. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Axonometrie</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">axonometrie</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Parallelprojektion</skos:scopeNote>
        <skos:scopeNote xml:lang="cs">Rovnoběžná projekce. [Koch 2008]</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_504c6bc3 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_504c6bc3">
