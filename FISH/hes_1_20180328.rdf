		<skos:scopeNote xml:lang="gd">Àitichean-fuirich airson beathaichean, eòin is msaa mar pheatachan no airson rannsachadh no dibhearsan.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ANIMAL HOUSE</skos:prefLabel>
