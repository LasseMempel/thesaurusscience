	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk014075">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Schi</skos:altLabel>
