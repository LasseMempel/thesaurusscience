	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk001430">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Arbeitshaus</skos:prefLabel>
		<skos:altLabel xml:lang="de">Arbeitshäuser</skos:altLabel>
		<skos:prefLabel xml:lang="en">workhouse</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000886"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk020986"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk003726"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk003737"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk014385"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019674"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019684"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000886"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk020986"/>
		<xe:explanation_temp xml:lang="de">Arbeitshäuser wurden seit der Frühen Neuzeit einerseits als soziale Anstalten für von Armut betroffene Menschen, häufig aber auch für Waisen oder geistig Behinderte, eingerichtet, andererseits aber auch im Sinne von Strafanstalten oder Besserungsanstalten geführt, in denen Straftäter, Obdachlose oder so genannte Müßiggänger durch Zwangsarbeit umerzogen und gebessert werden sollten.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Arbeitshaus ist ein Gebäude, in dem Menschen gegen die Ableistung von Arbeit Unterkunft und Versorgung erhalten, um Sozialkosten für die Öffentlichkeit zu sparen.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000886"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003726"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003737"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk014385"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019674"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019684"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk020986"/>
