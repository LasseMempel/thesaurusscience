	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/180">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/180</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">ÀITE-CRUINNEACHAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach no blàr far an tig daoine còmhla cruinn.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MEETING PLACE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">GATHERING SITE</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/151" />
