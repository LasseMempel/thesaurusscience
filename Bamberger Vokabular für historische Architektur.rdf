        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_iyznvop1"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-22T12:08:46.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T16:33:12.000</terms:modified>
        <skos:altLabel xml:lang="de">Exultetrotel</skos:altLabel>
        <skos:definition xml:lang="de">Exsultetrolle f, auch Exsultetrotel m, rotulus: mit Miniaturen reich verzierte Pergamentrolle mit dem Text des Exsultet (Lobpreis auf Ostern); die Illustrationen standen für den lesenden Geistlichen verkehrt herum, konnten aber von den Gläubigen richtig betrachtet werden, wenn die Rolle über den Ambo herabhing. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Exultetrolle</skos:prefLabel>
        <skos:prefLabel xml:lang="la">rotolus</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">rotulus</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">rouleau d\&apos;exsultet</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_c5048011 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_c5048011">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_298d4e12"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_78eff904"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_bb13d443"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-30T13:02:52.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T14:03:12.000</terms:modified>
        <skos:altLabel xml:lang="en"> bead and reel</skos:altLabel>
        <skos:altLabel xml:lang="it"> fusaiola</skos:altLabel>
        <skos:altLabel xml:lang="it"> fusarola</skos:altLabel>
        <skos:altLabel xml:lang="fr"> fusarolle</skos:altLabel>
        <skos:altLabel xml:lang="es"> moldura de cuentas</skos:altLabel>
        <skos:altLabel xml:lang="de">Perlstab</skos:altLabel>
        <skos:altLabel xml:lang="en">chaplet</skos:altLabel>
        <skos:altLabel xml:lang="cs">perlovec</skos:altLabel>
        <skos:definition xml:lang="de">Astragal (gr. astragalos: Sprungbein, Würfel; die rundl. Fußknochen von Lämmern dienten im alten Griechenland als Würfel), in der gr. Baukunst ein schmaler, halbrund profilierter und als Perlenschnur gebildeter Stab (Perlstab ), der die waagerechte Grenzlinie zwischen Bau- oder Ornamentgliedern betont. An der Säule der Ionischen Ordnung bezeichnet der A. die Grenze zwischen Schaft und Kapitell, als Perlstab bildet er die untere Begrenzung des ion. Kyma. Zwischen die einzelnen runden oder längl. Perlen sind gewöhnl. zwei Plättchen eingeschoben. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Astragal (griech. astragalos = Sprungbein; auch: Würfel aus Lammfußknöchlein), antikes Ornament aus Perlen und Scheibchen. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Astragal, aus runden oder längl. Perlen und dazwischenliegenden Scheiben gebildeter Stab, der den Abschluss des ion. Kyma bildet. [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Ein scharf profilierter Ring am oberen Ende des Säulenschaftes der ionischen Säulenordnung. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="cs">Podhrdlek, astragal (řec. astragalos = kotník; též kostka z iehnečí kosti), antický ornament z perel a čoček. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Astragal</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">astragal</skos:prefLabel>
        <skos:prefLabel xml:lang="en">astragal</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">astragale</skos:prefLabel>
        <skos:prefLabel xml:lang="it">astragalo</skos:prefLabel>
        <skos:prefLabel xml:lang="es">astrágalo</skos:prefLabel>
    </owl:NamedIndividual>
    


