        <skos:definition xml:lang="de">Auch Auszug, Ausgedinge, Abnahme, Abschied, Leibzucht genannte, mehr oder weniger abgesonderte Räume für die Unterbringung der Alten im Bauernhaus, auch als Altenteilerhaus innerhalb des Hofs gebaut. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Altenteil</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_611acba3 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_611acba3">
