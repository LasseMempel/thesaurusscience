		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/476" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/508" />
		<skos:scopeNote xml:lang="en">A building or settlement enclosure with a thick drystone wall, generally circular or oval in plan, usually sited in an elevated position.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
