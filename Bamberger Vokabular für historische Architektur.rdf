        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-28T15:40:04.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T16:25:41.000</terms:modified>
        <skos:definition xml:lang="de">Zugang zu einer Burg, vielfach ein nahezu selbständiges Gebäude mit Tor, Fallgatter und überwölbtem Torweg. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Burgtor</skos:prefLabel>
    </owl:NamedIndividual>
    


