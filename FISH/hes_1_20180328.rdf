		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1018" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1023" />
		<skos:scopeNote xml:lang="en">A dry dock where the hulls of ships are repaired and maintained.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
