		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/595" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/599" />
		<skos:scopeNote xml:lang="en">A garden of regular, linear or geometrical design, often associated with the traditional Italian, French and Dutch styles.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
