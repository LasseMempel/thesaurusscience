        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-28T08:54:03.000</terms:modified>
        <skos:definition xml:lang="de">Glockenhammer m: ein hammerartiger Schläger, der von außen auf die Glocke trifft und den Ton erzeugt. [Glossarium Artis]</skos:definition>
