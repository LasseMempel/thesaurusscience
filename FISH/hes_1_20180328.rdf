		<skos:prefLabel xml:lang="gd">TOGALACH OIGHREACHD</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach a tha am broinn oighreachd taighe-dhùthcha.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ESTATE BUILDING</skos:prefLabel>
