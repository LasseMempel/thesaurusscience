    <!-- https://hist-arch-vocab.org/bvha#c_63b3e5f7 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_63b3e5f7">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_bfa40c59"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-04T14:53:33.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T16:29:16.000</terms:modified>
        <skos:definition xml:lang="de">Koncha (griech. konche, lat. concha = Muschel), im Grundriss halbrunde Nische, Apsis, genauer: deren halbkuppelige Kalotte. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Konche (gr.-lat. concha: Muschel), halbrunder Anraum mit Halbkuppel wie Apsis, jedoch ohne Altar, auch an profanen Räumen. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Řec. konche, lat. concha = mušle. V půdorysu půlkruhová nika, apsida, přesněji řečeno její půlkupolová kalota, trikonchos, chór, tetrakonchos kaple. [Koch 2008] </skos:definition>
        <skos:prefLabel xml:lang="de">Konche</skos:prefLabel>
        <skos:prefLabel xml:lang="it">conca (absidale)</skos:prefLabel>
        <skos:prefLabel xml:lang="en">conch</skos:prefLabel>
        <skos:prefLabel xml:lang="es">concha</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">conque</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">koncha</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_63b7401e -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_63b7401e">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1fcb2666"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-08-23T16:44:03.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-30T11:45:54.000</terms:modified>
        <skos:definition xml:lang="de">Mit Zwischenräumen verlegte Balken, die mit Zwischendecken geschlossen werden, entweder als Windelboden, bei dem mit Strohlehm umwickelte Stakhölzer in Nuten an den Balkenseiten eingeschoben werden, oder als Einschubdecke, bei der auf die an den Balkenseiten genagelten Leisten der Einschub oder Fehlboden (Bretter, Schwarten, Gipsdielen) gelegt werden, darauf Lehm, Sand oder Schlacke als Schall- und Wärmeschutz. Bei H.n wird die Deckenuntersicht entweder verputzt oder verschalt oder die Balken bleiben sichtbar. Bei verputzten H.n wird an die Balkenunterseite ein Putzträger (Rohrgeflecht, Leichtbauplatten, Drahtgewebe) genagelt und verputzt. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Balkendecke</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">trámový strop</skos:prefLabel>
        <broaderByConstruction rdf:resource="https://hist-arch-vocab.org/bvha#c_1fcb2666"/>
    </owl:NamedIndividual>
    


