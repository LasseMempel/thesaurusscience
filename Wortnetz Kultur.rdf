		<gvp:aat2815_composed_of rdf:resource="http://lvr.vocnet.org/wnk/wk004263"/>
		<skos:definition xml:lang="de">Ein Lehmmauerwerk ist ein Mauerwerk, bei dem Lehmmörtel als Bindemittel verwendet wird.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002319"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010555"/>
