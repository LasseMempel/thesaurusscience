        <skos:altLabel xml:lang="la">furcheta</skos:altLabel>
        <skos:altLabel xml:lang="la">tenacula</skos:altLabel>
        <skos:definition xml:lang="de">Zange f, eucharistische; lat. forcipes; furcheta; tenacula: eine silberne oder goldene Zange, mit der früher die Hostien an die Gläubigen ausgeteilt wurden, besonders an Kranke. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="en">communion-tongs</skos:prefLabel>
        <skos:prefLabel xml:lang="de">eucharistische Zange</skos:prefLabel>
        <skos:prefLabel xml:lang="la">forcipes</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">pince liturgique</skos:prefLabel>
    </owl:NamedIndividual>
    


