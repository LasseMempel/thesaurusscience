    skos:inScheme <http://purl.org/heritagedata/schemes/38076> ;
    skos:prefLabel "Sea level rise"@en ;
    skos:scopeNote "Rising mean sea surface height. Caused by melting ice sheets and glaciers and the expansion of seawater as it warms."@en .

<http://purl.org/heritagedata/schemes/38076/concepts/30101> a skos:Concept ;
    skos:altLabel "Storm flood"@en,
