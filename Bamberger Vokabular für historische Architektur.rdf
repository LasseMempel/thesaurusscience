        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T17:37:09.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-21T18:50:06.000</terms:modified>
        <skos:altLabel xml:lang="de">Barkenkammer</skos:altLabel>
        <skos:definition xml:lang="de">Das Allerheiligste des ägypt. Tempels, in dem das Götterbild meist auf einer Barke stand. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Griechische Tempelkammer, Heroen oder Halbgöttern geweiht. Ägypten: Barkenkammer. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Sekos, das Allerheiligste im ägypt. Tempelbau, ein eigenes Gehäuse, in dem hinter Vorhängen das Götterbild in einer meist goldenen Barke stand. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Řecká chrámová komora, zasvěcená heróům nebo polobohům. Egypt: bárková komora (loď pro bohy). [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Sekos</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">sekos</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_929de7f7 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_929de7f7">
