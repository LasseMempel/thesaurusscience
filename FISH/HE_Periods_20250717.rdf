        <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
        <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
        <skos:prefLabel xml:lang="en">Second World War</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Used to record buildings, defensive monuments and sites dating to, and associated with, the Second World War (1939 CE to 1945 CE). For other types of building, such as houses, built during this period use Mid 20th Century.</skos:scopeNote>
        <skos:notation xml:lang="en">WW2</skos:notation>
      </skos:Concept>
    </skos:narrower>

    <skos:narrower>
      <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_period/concepts/WW3">
        <skos:broader rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/M20"/>
        <time:hasBeginning xml:lang="en">1946</time:hasBeginning>
        <time:hasEnd xml:lang="en">1991</time:hasEnd>
        <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_period"/>
        <dc:identifier>http://purl.org/heritagedata/schemes/eh_period/concepts/WW3</dc:identifier>
        <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-17T16:46:30</dc:issued>
        <cc:license rdf:resource="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"/>
        <cc:attributionURL rdf:resource="https://historicengland.org.uk/"/>
        <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
        <dc:publisher rdf:resource="https://historicengland.org.uk/"/>
        <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
        <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
        <skos:prefLabel xml:lang="en">Cold War</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The period of political and military opposition between the major Superpowers (USA and USSR) and their allies. Known as the Cold War as there were no direct military conflicts between the two main protagonists (1946 CE to 1991 CE).</skos:scopeNote>
        <skos:notation xml:lang="en">WW3</skos:notation>
      </skos:Concept>
    </skos:narrower>

