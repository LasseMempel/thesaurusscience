<http://lvr.vocnet.org/wnk/wk021255> a skos:Concept ;
    skos:altLabel "Ichnofossil"@de,
        "Ichnofossilien"@de,
        "Spurenfossilien"@de,
        "trace fossils"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk001811> ;
    skos:definition "Ein Spurenfossil ist ein Fossil, das aus den erhaltenen Spuren der Aktivität eines Lebewesens besteht, etwa Fährten, Fraßspuren, Grabgängen, Wohnbauten oder Ausscheidungen. Es handelt sich dabei nicht um körperliche Überreste des Organismus selbst."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4261161-1>,
        <http://www.wikidata.org/entity/Q853800> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:narrowMatch <http://vocab.getty.edu/aat/300379470> ;
    skos:prefLabel "Spurenfossil"@de,
