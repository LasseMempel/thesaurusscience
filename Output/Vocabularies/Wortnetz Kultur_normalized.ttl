    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Waldsaum"@de,
        "forest edge"@en .

<http://lvr.vocnet.org/wnk/wk002568> a skos:Concept ;
    skos:altLabel "Klostermühlen"@de ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000691> ;
