        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_420fb9c1"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-23T18:13:58.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T15:01:44.000</terms:modified>
        <skos:altLabel xml:lang="de">Schale</skos:altLabel>
        <skos:altLabel xml:lang="la">vas</skos:altLabel>
        <skos:altLabel xml:lang="cs">číše</skos:altLabel>
        <skos:definition xml:lang="de">Kuppa f; Becher m; lat. vas; cuppa: die innen meist vergoldete, außen oft reich verzierte Schale des Kelches, häufig mit einer umlaufenden Inschrift. Manchmal ist die Stelle, an der die Lippen angesetzt werden sollen (Labialstelle f), eigens markiert. Ein bIütenkelchähnIicher Dekor am unteren Teil der Kuppa heißt Korb (m). [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Kuppa</skos:prefLabel>
        <skos:prefLabel xml:lang="en">bowl</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">coupe</skos:prefLabel>
        <skos:prefLabel xml:lang="la">cuppa</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kupa</skos:prefLabel>
    </owl:NamedIndividual>
    


