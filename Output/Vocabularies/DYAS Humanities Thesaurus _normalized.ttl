        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/668> ;
    skos:scopeNote "Families consisting of a widowed, divorced or unmarried parent and at least one child in their custody."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/724> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/127> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Communities (social groups)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2033>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/208>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/348>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/75> ;
    skos:scopeNote "Groups of persons who recognise and display their common cultural and/or social characteristics as intrinsic elements of these groups. Communities are constructed and reproduced through the interaction of their members and/or the imaginary bonds between them (e.g. diasporic communities)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/730> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/417> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Anisochronies (Narratology-Methods)"@en ;
    skos:scopeNote "Types of narration that consist of various forms of discordances between the duration of the events in the story and the duration in which they are presented in the narrative."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/75> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/26> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Primary groups"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/101>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/127>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/336>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/724> ;
    skos:scopeNote "Small and multifunctional groups that constitute the primary social context of their members' socialisation and identity formation."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/79> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Diaeresis"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/392>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/53>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/560> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/800> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/385> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Internal focalization"@en ;
    skos:scopeNote "Narrative way in which the narrator knows as much as the focal character. This character filters the information provided to the reader. He cannot report the thoughts of other characters."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/801> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/584> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Interstate affairs inscriptions"@en ;
    skos:scopeNote "Inscriptions concerning the relations between city-states in antiquity."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/818> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/622> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Codices (Bearers of inscriptions)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Albums composed of two or more tablets joined together by metal rings or thin leather strips."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/821> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/665> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Stichic metre"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/129>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/634>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/696>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/709> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/89> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/33> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Production of works and/or phenomena of aesthetic value"@en ;
    skos:scopeNote "This term classifies disciplines concerning activities which, while they may involve the construction of material objects or of installations, are primarily designed to attach aesthetic value to them or to foster aesthetic values through the creation of corresponding phenomena."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1044> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/584> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Accounts (Public inscriptions)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2356>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2357>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Inscriptions that refer to ministrations concerning the property of a city-state or a sanctuary, such as safekeeping and managing it."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/106> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/26> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Castes (social groups)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/127>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/288>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/380>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/457>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/52> ;
    skos:scopeNote "Groups of persons with inherited social standing and identity, which are intrinsically related to specific social practices (e.g. endogamy) and/or trades. As a metaphor, the term is also used to describe priviledged social groups or classes."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/118> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Material culture"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1463>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2469>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2470>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/472>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/613> ;
    skos:scopeNote "Term used to designate collectively the tangible objects whose production, use, conveyance and preservation are intrinsically related to the reproduction of cultural practices, identities, perceptions and beliefs."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1291> a skos:Concept ;
    skos:altLabel "Antike griechische Tragödie"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/856> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ancient Greek tragedy"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/139>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1797>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1799>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1806>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/914> ;
    skos:scopeNote "Ancient (Greek) tragedy is a genre of poetic drama that appeared in ancient Greece. According to the Aristotelian definition in <em>Poetics</em>, it is the imitation (stage representation) of an action that is important and complete, has a significant length and its parts are morphologically distinct from one another. It is enacted rather than recited and, by means of pity and fear, leads to the catharsis (purgation of emotions aroused by the tragic action). Major elements of the tragedy are the &ldquo;hamartia&rdquo;, i.e. the tragic flaw or error of judgment that sets in motion the system leading to the hero&rsquo;s destruction, and &ldquo;hubris&rdquo;, i.e. the arrogant behaviour that defies and insults the gods bringing about his downfall. The themes of ancient tragedy draw on the mythological epic substratum consisting mainly of three entities, the Argonautic expedition, the Trojan and the Theban cycles."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/133> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/32> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "States"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/312> ;
    skos:scopeNote "Entities exercising legitimate authority over territories and people. States are supported by legal and administrative institutional systems that regulate sociopolitical relations within their territory, as well as their relations with other states."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1465> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/24> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Dies (Numismatics)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2211>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2481>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2483> ;
    skos:scopeNote "Metal pieces engraved with an inverse version of the designs and inscriptions which were stamped on the flans thus creating the coin."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1475> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1801> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Archaeology"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1506> ;
    skos:scopeNote "The humanistic discipline which aims at the reconstruction and understanding of past societies mainly through the study and processing of the material remains of human activity. These remains have survived or come to light with excavations and constitute the relics of the material culture of former societies."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1484> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2406> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Engraving"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/777>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/783>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/851>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/890>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/900> ;
    skos:scopeNote "Engraving is the art of incising a design onto a hard, usually flat surface by cutting grooves into it. The result may be a decorated object in itself or may provide an intaglio printing plate for printing images on paper or other soft substances, such as prints or illustrations."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1495> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/157> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Navigation"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1494>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/192>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2106>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2195>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2424> ;
    skos:scopeNote "The set of competences, dexterities and practices that enable the realization of travels with floating vessels. Navigation practices vary over time and space. They depend on the methods and technologies for identifying geographical features and weather conditions, for setting the course of the vessels, and for steering them in accordance with their type and with the means of watercraft propulsion."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1525> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1513> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Hyponymy"@en ;
    skos:scopeNote "A hyponym is a word or phrase whose semantic field is included within that of another word, its hypernym. In simpler terms, a hyponym shares a type-of relationship with its hypernym. For example, scarlet, vermilion, carmine, and crimson are all hyponyms of red, which is, in turn, a hyponym of colour. Computer science often terms this relationship an &quot;is-a&quot; relationship. For example, the phrase &quot;Red is-a colour&quot; can be used to describe the hyponymic relationship between red and colour."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1568> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/575> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Oriental Orthodox Christians"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1589>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/458> ;
    skos:scopeNote "Christians who follow one of the pre-Chalcedonian Oriental Orthodox Churches, which form a distinct ecclesiastical communion. Oriental Orthodox Christians recognize only the first three Ecumenical Councils. As to the Christological issue, they follow the dogma of miaphysitism."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1819> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Stavrata"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1820>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2351>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2431>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2488> ;
    skos:scopeNote "Large silver coins of the late Byzantine Empire (14th-15th c. CE) which had half the value of the hyperpyra."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1899> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1657> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Scientific societies"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1457>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1610>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1658>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2529>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2540> ;
    skos:scopeNote "Groups of people who share science as their common research or professional interest and pursuit, and aim at the communication among their members, as well as the advancement, occasionally dissemination to broader audiences, and/or professional demarcation of their discipline or science in general. A first kind of scientific societies were the scientific academies of the 17th century that had a crucial role in the social organisation of science. In the early 19th century many scientific societies, which specialised in particular scientific fields, emerged, contributing significantly to the professionalisation of sciences."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/19> a skos:Concept ;
    skos:exactMatch <https://vocabs.dariah.eu/bbt/Concept/000012> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Intentional destructions"@en ;
    skos:scopeNote "This term classifies intentional activities aimed at causing the end of the existence of entities and states of affairs."@en ;
    skos:topConceptOf <https://humanitiesthesaurus.academyofathens.gr> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1900> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/89> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Literature (discipline)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1547>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1858>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1860>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2205>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2209> ;
    skos:scopeNote "The production of written or oral verbal works deemed to have an aesthetic value, often due to deploying language in ways that differ from ordinary usage."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/192> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/24> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ships"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1494>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1495> ;
    skos:scopeNote "Water transport vessels, hollow and elongated, usually oblate in the middle and narrower at the extremes, which are used for the transport of humans and cargoes."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1985> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Archon (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1953>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1954>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1955>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1956>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2157> ;
    skos:scopeNote "A general term for all holders of office in a city-state. Also, the term was frequently attributed to a person who held the highest office of the State. Archontes are found in most States of central Greece, including Athens, and in States dependent on or influenced by Athens."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/202> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/20> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/208> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/26> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Communities (collectivities)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/336>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/348>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/724> ;
    skos:scopeNote "Groups of persons constructed on the basis of common aims, cultural and/or social features, and characterized by common beliefs, perceptions and practices, as well as by collectively accepted values and orientations (e.g. the academic community)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2158> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Communication systems"@en ;
    skos:scopeNote "Communication systems are the medium of conveying meanings and messages from one entity or group or transmitter to another entity or group or receiver through the use of mutually understood signs, signals, symbols, images and semiotic rules. The main steps inherent to all communication systems are: (a) the formation of communicative motivation or reason, (b) message composition, (c) message encoding, (d) transmission of the message as a sequence of units/signals using a specific channel or medium, (e) reception of signals and reassembling of the message from a sequence of received signals, (f) decoding of the reassembled message and (g) interpretation and making sense of the presumed original message."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2221> a skos:Concept ;
    skos:altLabel "World fairs"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/202> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "International exhibitions"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1658>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1678>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2471>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2517>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2529> ;
    skos:scopeNote "Organised public displays of agricultural, industrial, scientific and/or artistic products, in order to promote the production, commerce and culture internationally and to stimulate the public&#39;s interest. During their first period, between 1851 and 1939, they reflected both the emerging internationalism and the antagonism among imperialistic powers. At the same time they functioned as the main sites for the advertising and commercialisation of science, incorporating and propagating the ideology of progress and technological utopianism."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2249> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/21> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Tourism"@en ;
    skos:scopeNote "Tourism is a leisure activity that implies moving to and staying for a short period of time in a destination in order to visit sites with social and cultural characteristics different from the visitors' everyday experience, in anticipation of pleasure and knowledge. This anticipation is created and sustained through information channels and networks of communication. Tourism is a mass phenomenon in modern societies and sustains -and is sustained by- a huge market worldwide."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2422> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2529> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Biotechnology"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1602>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2377>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2423>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2475>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2477> ;
    skos:scopeNote "The development of techniques for the application of biological processes to the production of materials of use in medicine and industry, related to food, health, environment, energy etc. It includes traditional techniques, such as fermentation processes, antibiotic production, sewage treatment, but also novel and growing techniques, grounded in molecular and cell biology, for analyzing and manipulating the molecular building blocks of life. These techniques, such as recombinant DNA technology, monoclonal antibodies, in vitro fertilization etc, have raised major ethical issues related to bioethics. The term \"biotechnology\" also designates products, such as pharmaceuticals or genetically-modified foods, created using these techniques. At times, it refers to an economic sector or area of research."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2433> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1657> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Botanical gardens"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1602>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1603>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1658>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2347>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2377> ;
    skos:scopeNote "Scientific organisations that collect, cultivate and demonstrate diverse plant species, aiming mostly to promote scientific research and education. Botanical gardens were established in the early modern period as collections of plants useful in the education of medical students. In the 17th and 18th centuries they were enriched with rare and exotic plants from the Εuropean colonies, advancing scientific research in natural history and supporting scientific imperialism of colonial countries. From the 19th century onwards they also functioned as sites of entertainment and education for the wide public."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2439> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2582> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Sociology of science"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1457>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1657>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2440>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2469>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2529> ;
    skos:scopeNote "The field that makes science the object of sociological analysis. It includes mainly two different research areas, the traditional sociology of knowledge, that focuses on the institutional context and social organisation and function of science as provider of certified knowledge, and the sociology of scientific knowledge, which focuses on the sociological examination of the very content of scientific knowledge. It includes also studies that emphasise the cognitive and cultural authority of scientists and their linkages with power, politics and economy."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/245> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Metre (poetry)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/129>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/392>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/696> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2463> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1581> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Philosophy of mind"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2462>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2523>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2525>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2526> ;
    skos:scopeNote "The branch of philosophy that includes the philosophy of psychology, philosophical psychology, and the area of metaphysics concerned with the nature of mental phenomena and how they fit into the causal structure of reality. Some of the main metaphysical problems in the philosophy of mind is the mind-body problem, the free will problem, the problem of personal identity, and the problem of how, if at all, irrational phenomena such as akrasia and self-deception are possible."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2501> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2529> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Meteorology"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2347>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2500>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2503>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2521>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2548> ;
    skos:scopeNote "The study of the physical phenomena and processes that take place in the atmosphere and its interactions with the ground surface, leading to knowledge, which, among others, is applied to weather forecasting. The modern science of meteorology began in the late 16th and the first half of the 17th century, and was defined by the invention of meteorological instruments, such as the thermometer, the barometer and the hygrometer, which enabled systematic recordings of weather observations. Modern meteorology of the 20th and 21st centuries, in contrast, is theory driven, and discussions on instrumentation have been sparse. The chief branches of modern meteorology are dynamical meteorology, micrometeorology and synoptic meteorology."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2526> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/248> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cognitive science"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1506>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1581>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2463>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2525>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/541> ;
    skos:scopeNote "The interdisciplinary research field that seeks to account for intelligent activity, whether exhibited by living organisms (especially adult humans) or machines. Cognitive science is unique in its basic tenet that cognitive processes are computations, a perspective which allows for direct comparison of natural and artificial intelligence. Cognitive psychology and artificial intelligence constitute its core, while a number of other disciplines, such as neuroscience, linguistics, anthropology, and philosophy, as well as other fields of psychology, such as developmental psychology, are more peripheral contributors."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2540> a skos:Concept ;
    skos:altLabel "Scientific academies"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2581> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Academies of science"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1657>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1899>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2347>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2529>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2604> ;
    skos:scopeNote "Formal institutions with a restricted membership, which were founded in 17th century Europe, aiming mostly at the advancement of all the natural sciences (which were summarised in the terms &quot;natural philosophy&quot; and &quot;natural history&quot;), particularly through the communication and mutual encouragement of its members. Scientific academies had a crucial role in the organisation of modern science within the Scientific Revolution and the Enlightenment, until at least the early 19th century and the emergence of specialised and professional scientific societies and the establishment of scientific institutes and departments in the higher schools and universities."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2542> a skos:Concept ;
    skos:altLabel "Schools of mines"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2581> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Mining academies"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1610>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1641>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2467>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2470>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2529> ;
    skos:scopeNote "University-level institutions for training managers of state mining monopolies. They were established by the state authorities in central Europe in the 18th century, after the Seven Years War that led to an increased demand for silver. They maintain a significant part in the history of education in applied science and engineering, since their curriculum included mathematics, chemistry, metallurgy, mineralogy and mining techniques."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/256> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Religions"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/186>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2350>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/369> ;
    skos:scopeNote "Systems of beliefs, symbols and practices that formulate integral conceptions of a cosmic order of existence, often in regard to one or more transcendental beings, and of the meaning of human life in it."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/33> a skos:Concept ;
    skos:exactMatch <https://vocabs.dariah.eu/bbt/Concept/000010> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Disciplines"@en ;
    skos:scopeNote "This term classifies professional or potentially professional areas of employment, that are socially and/ or legally recognized on the basis of the criteria of self-coherence, the efficacy of the practices they employ, the adoption of common methods and the ability to transfer knowledge and expertise in the relevant professional sector. Each sector includes types of activities that point to a certain unity of action characteristic of some sort of professional or potentially potential specialization. The specialization may relate to the production or modification of material objects, the conception and understanding of activities or phenomena, the provision /transfer of services, knowledge and know-how and the creation of works and phenomena with aesthetic value.<br /><br />Note<strong>: </strong>It is important to clarify that the terms classified in the “disciplines” term should not be confused with the actor who performs an act or the results of his activity or the method used in order to achieve this result. The actor as “the efficient cause”, the result as “the final cause” and the method as the sum of the rules and constraints that an actor follows in order to perform an act, are different terms which belong to different facets and hierarchies.<br /><br />When determining the activities classified in the “Disciplines” hierarchy we should not confuse the history of a specific discipline i.e. the specific temporal and spatial environment in which this discipline appeared and was perceived with the type of activities characterizing this discipline."@en ;
    skos:topConceptOf <https://humanitiesthesaurus.academyofathens.gr> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/352> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ideologies"@en ;
    skos:scopeNote "Structures of perceptions, beliefs and values that constitute the background of social representations, which the members of a social group share in order to give sense to societal function and to identify or claim their position within society. Ideologies are the intellectual and legitimating framework that organizes the social groups’ practices and aspirations, particularly in regard to other groups and to power structures."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/374> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/201> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Agreeing modifier"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/748> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/429> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/78> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Strophe"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/244>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/445> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/475> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/232> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Political violence"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2625> ;
    skos:scopeNote "Instances of political violence are the social conflicts focused on the overthrow or defense, partial or total, of the sociopolitical conditions at a point in time through the use of physical violence."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/619> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/279> ;
