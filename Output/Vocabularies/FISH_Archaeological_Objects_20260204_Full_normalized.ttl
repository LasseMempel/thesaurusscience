    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Strap Hinge"@en ;
    skos:scopeNote "A metal, often decorative, hinge constructed with a single large strap attached to the surface of the moving part wiht a loop in the end which fits over a pintle attached to the adjacent stationary frame."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/137093> a skos:Concept ;
