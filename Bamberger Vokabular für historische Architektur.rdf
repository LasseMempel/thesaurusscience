        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_0422b318"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_6ce4540b"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-05T14:26:19.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T13:16:52.000</terms:modified>
        <skos:definition xml:lang="de">Busung (gebust, busig), sphär. Ausbauchung des Gewölbes, bes. die überhöhung der Gewölbekappen des Kreuzgewölbes, so dass der Schnittpunkt der Kappen höher als der Scheitelpunkt der Gurtund Schildbogen liegt. Die B. der Gewölbekappen vermehrt die Verspannung des Gewölbes. B. ist zu unterscheiden vom Stich. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Eine sphärische Ausformung der Gewölbekappen beim Kreuzgewölbe. Sie ergibt sich durch eine Krümmung der ansteigenden ScheitelIinien und bewirkt eine effektivere Verspannung des Gewölbes. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Busung</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">bombement des quartiers</skos:prefLabel>
        <skos:prefLabel xml:lang="en">doming of severies</skos:prefLabel>
    </owl:NamedIndividual>
    


