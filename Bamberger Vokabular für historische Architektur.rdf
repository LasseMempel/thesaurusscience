        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_fc121fad"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_hvqjmvb3"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-16T10:39:39.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-18T13:58:37.000</terms:modified>
        <skos:altLabel xml:lang="de">Malerei</skos:altLabel>
        <skos:altLabel xml:lang="de">Maltechnik</skos:altLabel>
        <skos:definition xml:lang="de">Die malerischen Techniken werden unterschieden: nach ihren Untergründen in Wandmalerei, Sgraffito, Mosaik, Glas-, Tafel-, Fass-, Buchmalerei, nach den Lösungsmitteln, mit denen die Farbpigmente streichfähig gemacht werden, bzw. nach den Bindemitteln, mit denen die Farbpigmente untereinander und auf ihren Untergrund gebunden werden. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Malířské techniky se rozlišují: podle podkladu na nástěnnou malbu (sgrafito, mozaiku), vitrail (malbu na skle), deskovou malbu, štafírování, knižní malbu a podle rozpouštědla, jímž se barevné pigmenty stávají natíratelnými, resp. podle pojiva, ktere spojuje barevné pigmenty navzájem a s jejich podkladem. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Malereitechnik</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">malířské techniky</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_7ad18ec1 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_7ad18ec1">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_89b7da10"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-22T17:44:21.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T14:40:21.000</terms:modified>
        <skos:altLabel xml:lang="de">Befundsicherung</skos:altLabel>
        <skos:altLabel xml:lang="de">Bestandsuntersuchung</skos:altLabel>
        <skos:altLabel xml:lang="de">Voruntersuchung</skos:altLabel>
        <skos:note xml:lang="en">A study in which information regarding the original form, materials and state of conservation of an object is obtained. (EwaGlos)</skos:note>
        <skos:note xml:lang="de">Eine Untersuchung, die zu weiteren Erkenntnissen des Objektes und seiner Oberfläche führt. (EwaGlos)</skos:note>
        <skos:note xml:lang="fr">Étude visant à approfondir la connaissance de l’objet étudié dans sa forme originale, en caractérisant ses matériaux et son état de conservation. (EwaGlos)</skos:note>
        <skos:prefLabel xml:lang="de">Befunduntersuchung</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">constat d’état</skos:prefLabel>
        <skos:prefLabel xml:lang="en">object investigation</skos:prefLabel>
    </owl:NamedIndividual>
    


