	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk020793">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="en">aryballoi</skos:altLabel>
		<skos:altLabel xml:lang="de">Aryballoi</skos:altLabel>
		<skos:prefLabel xml:lang="de">Aryballos</skos:prefLabel>
		<skos:prefLabel xml:lang="en">aryballos</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk008768"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk020865"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk008768"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk020865"/>
		<skos:definition xml:lang="de">Ein Aryballos ist ein meist kleines, kugeliges Vorratsgefäß mit einem oder zwei Henkeln, das zur Aufbewahrung von Ölen, Salben oder Parfüms verwendet wurde. Das Gefäß ist häufig aufwendig bemalt und wurde vorwiegend aus Ton, aber auch aus Glas, seltener aus Metall hergestellt. Aryballoi wurden in der Antike hauptsächlich von Athleten an einem Riemen am Handgelenk getragen.</skos:definition>
		<skos:mappingRelation rdf:resource="http://vocab.getty.edu/aat/300198885"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk008768"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk020865"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-06-20T15:15:06+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk020794">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="en">amphoriskoi</skos:altLabel>
		<skos:altLabel xml:lang="de">Amphoriskoi</skos:altLabel>
		<skos:prefLabel xml:lang="de">Amphoriskos</skos:prefLabel>
		<skos:prefLabel xml:lang="en">amphoriskos</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk004588"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk020865"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004588"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk020865"/>
		<skos:definition xml:lang="de">Ein Amphoriskos ist eine kleine Amphore, die häufig bemalt und in der Regel zur Aufbewahrung von Duftölen verwendet wurde. Manche Amphoriskoi wurden aus Glas hergestellt.</skos:definition>
		<skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q477146"/>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300264915"/>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4694859-4"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004588"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk020865"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-11-08T12:02:03+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk020795">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Bleuel</skos:prefLabel>
		<skos:altLabel xml:lang="de">Wäschebleuel</skos:altLabel>
		<skos:prefLabel xml:lang="en">washing paddle</skos:prefLabel>
		<skos:altLabel xml:lang="en">washing paddles</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006137"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk006137"/>
		<skos:definition xml:lang="de">Ein Bleuel ist ein Gerät zum Ausschlagen von Wäsche. Es besteht aus einer flachen, breiten Schlagfläche und einem Handgriff. Meistens sind der Handgriff und die Schlagfläche aus einem einfachen Holzbrett gefertigt. Es gibt auch Bleuel, bei denen der Griff auf die Oberseite aufgesetzt ist und mit Schnitzereien verziert wurde.</skos:definition>
		<xe:explanation_temp xml:lang="de">Der Bleuel wird verwendet, um Wäsche auszuschlagen und dadurch den Schmutz zu entfernen. Nachdem Einweichen der Wäsche in Wasser und behandeln mit Seife, wird sie auf eine stabile Unterlage gelegt. Mit dem Bleuel schlägt man auf den Stoff, wodurch der Schmutz von den Fasern gelöst und das Laugenwasser zusammen mit dem Schmutz aus dem Gewebe herausgepresst wird.</xe:explanation_temp>
		<skos:mappingRelation rdf:resource="https://www.wikidata.org/wiki/Q3817547"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk006137"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
