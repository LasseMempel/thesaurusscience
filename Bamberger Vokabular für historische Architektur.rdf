    <!-- https://hist-arch-vocab.org/bvha#c_5545f6af -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_5545f6af">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
