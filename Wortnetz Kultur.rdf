	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk002801">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">basin (vessel)</skos:prefLabel>
		<skos:altLabel xml:lang="en">basins (vessels)</skos:altLabel>
		<skos:prefLabel xml:lang="de">Becken (Behälter)</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000202"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk004497"/>
		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk002769"/>
		<skos:scopeNote xml:lang="de">Für kleine und mittlere Flüssigkeitsbehälter als Teil der Ausstattung von Innenräumen. Für größere bauliche Anlagen, meist im Außenbereich, benutze &amp;quot;Becken (Bauwerk)&amp;quot; wk002769.</skos:scopeNote>
		<skos:definition xml:lang="de">Ein Becken ist ein offener und eher flacher Behälter für Flüssigkeiten, der fest mit einem Untergrund verbunden ist. Es besteht meist aus Stein oder Keramik und ist dann entsprechend dickwandig, oder ist aus Metall gefertigt.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4144247-7"/>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300045614"/>
