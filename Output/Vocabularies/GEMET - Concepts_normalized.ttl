    skos:closeMatch <http://data.uba.de/umt/_00040496> ;
    skos:definition "Management of all the stages involved in the life of a product such as raw materials acquisition, manufacturing, distribution and retail, use and re-use and maintenance, recycling and waste management, in order to create less environmentally harmful products."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
