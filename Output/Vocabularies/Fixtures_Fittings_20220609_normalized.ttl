    skos:inScheme <http://purl.org/heritagedata/schemes/572> ;
    skos:prefLabel "Deck Plate"@en ;
    skos:scopeNote "A metal plate forming part of the deck."@en .

<http://purl.org/heritagedata/schemes/572/concepts/146606> a skos:Concept ;
