	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk006013">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">liturgical costume</skos:prefLabel>
		<skos:altLabel xml:lang="en">liturgical costumes</skos:altLabel>
