    <!-- https://hist-arch-vocab.org/bvha#c_69d6210a -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_69d6210a">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_546cb22f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_1a9644a7"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_786d0b37"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_eef3ed7d"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_eieuwx7k"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-27T12:24:16.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T16:14:28.000</terms:modified>
        <skos:altLabel xml:lang="de">Dreifaltigkeit</skos:altLabel>
        <skos:altLabel xml:lang="de">Trinität</skos:altLabel>
        <skos:definition xml:lang="cs">Bůh Otec, Syn (= Kristus) a Duch svatý (,,jeden jediný Bůh ve třech osobách&quot;) byli od raného středověku zobrazováni různě: jako tři postavy sedící vedle sebe (od 10. stol.), jako jedna postava s třemi hlavami, nebo třemi tvářemi (od 13. stol.), později jako dvě postavy s holubicemi (= Duch svatý), nebo symbolicky jako 3 kruhy, které se protínají, nebo jako rovnostranný trojúhelník s okem uprostřed (po 15. stol.). [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Dreifaltigkeit, Trinität. Gott Vater, Sohn ( = Christus) und Heiliger Geist (»in 3 Personen ein Einziger«) werden seit dem frühen Mittelalter verschieden dargestellt: als 3 nebeneinander sitzende Personen (seit 10. Jh.); als eine Gestalt mit 3 Köpfen oder 3 Gesichtern (seit 13. Jh.); später als 2 Personen mit Taube (= für den Heiligen Geist) oder symbolisch als 3 Kreise, die sich schneiden, oder als gleichseitiges Dreieck mit dem Auge in der Mitte (nach 15. Jh.). [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Heilige Dreifaltigkeit</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">Nejsvětější trojice</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_69ea170d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_69ea170d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_89b7da10"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-04T16:09:13.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T14:35:51.000</terms:modified>
        <skos:note xml:lang="de">Beobachtung und Beschreibung der Materialien, aus denen Wandmalereien und Architekturoberflächen bestehen, um Informationen über deren Zusammensetzung, Zustand, Datierung oder die beste Folgemaßnahme zu gewinnen. [EwaGlos]</skos:note>
        <skos:note xml:lang="en">The observation and characterisation of wall painting materials or those making up architectural surfaces in order to give information on the composition of an object and its state of conservation and to provide information useful for dating or for choosing the best possible follow-up action. [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="de">Materialuntersuchung</skos:prefLabel>
        <skos:prefLabel xml:lang="en">materialanalysis and examination</skos:prefLabel>
    </owl:NamedIndividual>
    


