    <skos:scopeNote xml:lang="en">Permanently moored historic maritime craft preserved and converted into a museum and open to the public.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141982">
    <skos:scopeNote xml:lang="en">A rectilinear ritual enclosure of Iron Age date</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/151952">
    <skos:scopeNote xml:lang="en">A shed for storing fishing bait.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70069">
    <skos:scopeNote xml:lang="en">A megalithic tomb of Neolithic date comprising a chamber bounded by large upright orthostats, often only three or four in number, which support a large capstone.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92447">
    <skos:scopeNote xml:lang="en">Steps found at a landing point.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68687">
    <skos:scopeNote xml:lang="en">A building or tower used to communicate information to shipping or other stations using signals such as flags, fires or lights. Roman signal stations took the form of a stone tower surrounded by a ditched enclosure and were used to warn of Saxon raids.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68789">
    <skos:scopeNote xml:lang="en">A site where a periodical gathering of buyers, sellers and entertainers, meet at a time ordained by charter or statute or by ancient custom.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92389">
    <skos:scopeNote xml:lang="en">A burial ground for followers of the Jewish faith.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87796">
    <skos:scopeNote xml:lang="en">An underground bomb-proof structure used as a command centre for military operations.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91862">
    <skos:scopeNote xml:lang="en">Buildings, sites and structures associated with the engineering industry.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71731">
    <skos:scopeNote xml:lang="en">A row of columns supporting an entablature.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70191">
