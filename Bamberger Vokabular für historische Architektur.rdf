    <!-- https://hist-arch-vocab.org/bvha#c_52e9e4b7 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_52e9e4b7">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_02fc3080"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_a3e668d3"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_30831661"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_d1a705c6"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_ef40cc12"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-09T15:43:39.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T17:32:48.000</terms:modified>
        <skos:altLabel xml:lang="de">Corporaltasche</skos:altLabel>
        <skos:altLabel xml:lang="de">Korporalienkästchen</skos:altLabel>
        <skos:altLabel xml:lang="de">Korporalienschrein</skos:altLabel>
        <skos:altLabel xml:lang="de">Korporalientasche</skos:altLabel>
        <skos:altLabel xml:lang="de">Korporaltasche</skos:altLabel>
        <skos:altLabel xml:lang="de">Messbursa</skos:altLabel>
        <skos:altLabel xml:lang="la">capsa corporalis</skos:altLabel>
        <skos:altLabel xml:lang="fr">corporalier</skos:altLabel>
        <skos:altLabel xml:lang="la">domus corporalis</skos:altLabel>
        <skos:altLabel xml:lang="la">pera</skos:altLabel>
        <skos:altLabel xml:lang="en">purse</skos:altLabel>
        <skos:definition xml:lang="de">Bursa f, auch Messbursa f: 1. Korporalientasche f, auch Corporaltasche f, pera: taschen- oder mappenartiger Behälter zur Aufbewahrung für das zusammengefaltete Korporale; die Oberseite besteht oft aus dem gleichen Material wie die Kasel; die Bursa unterliegt dem Farbenkanon. 2. Korporalienschrein m, Korporalienkästchen n, domus corporalis, capsa corporalis: mit Seide bezogenes und ausgekleidetes Kästchen als Behälter für das Korporale; im Mittelalter die häufigere Form der Bursa. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Bursa</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">bourse</skos:prefLabel>
        <skos:prefLabel xml:lang="en">burse</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">burza</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_52ed134b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_52ed134b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_7acece55"/>
