        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_b41bd73a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c7b144d0"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-13T14:58:47.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T14:44:55.000</terms:modified>
        <skos:definition xml:lang="de">Aus zwei Teilen bestehender Kloben. Ein Teil ist unten zu einem Stützblech mit einer Zierform und oben zu einem Dorn ausgearbeitet, das Zweite wird um den Dorn gelegt und ins Holz geschlagen. Es dient zugleich als Lauffläche für das Band. Das Stützblech wird am unteren Ende in der Zierform mit einem Nagel im Holz befestigt. [Noky 1996]</skos:definition>
        <skos:prefLabel xml:lang="de">Stützkloben</skos:prefLabel>
    </owl:NamedIndividual>
    


