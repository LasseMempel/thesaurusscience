        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T14:42:55.000</terms:modified>
        <skos:altLabel xml:lang="de">Farbselektion</skos:altLabel>
        <skos:note xml:lang="de">Die Fehlstelle wird mit kurzen, parallelen Strichen in reinen Farben auf hellem Grund ergänzt, die dem Verlauf der Formen des angrenzenden Originals folgen. (EwaGlos)</skos:note>
        <skos:note xml:lang="fr">Lacune réintégrée avec de courtes lignes parallèles en couleur pure sur un fond clair, qui suit les formes et contours de l’original. (EwaGlos)</skos:note>
        <skos:note xml:lang="en">The lacuna is reintegrated with short parallel lines in pure colours on a light background, which follow the shapes and contours of the original alongside them. (EwaGlos)</skos:note>
        <skos:prefLabel xml:lang="de">Selezione cromatica</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">réintégration chromatique</skos:prefLabel>
        <skos:prefLabel xml:lang="es">selección cromática</skos:prefLabel>
        <skos:prefLabel xml:lang="ro">selecție cromatică</skos:prefLabel>
        <skos:prefLabel xml:lang="pl">selekcja chromatyczna</skos:prefLabel>
        <skos:prefLabel xml:lang="en">selezione cromatica</skos:prefLabel>
        <skos:prefLabel xml:lang="hr">selezione cromatica</skos:prefLabel>
        <skos:prefLabel xml:lang="hu">selezione cromatica</skos:prefLabel>
        <skos:prefLabel xml:lang="it">selezione cromatica</skos:prefLabel>
        <skos:prefLabel xml:lang="tr">seçilmiş renkle tamamlama</skos:prefLabel>
        <skos:prefLabel xml:lang="bg">Хроматична селекция</skos:prefLabel>
    </owl:NamedIndividual>
    


