        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-18T13:12:52.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T14:21:58.000</terms:modified>
        <skos:altLabel xml:lang="fr">spirale</skos:altLabel>
        <skos:definition xml:lang="de">Schneckenlinie, 1. eine häufige ornamentale Grundform, z. B. der Laufende Hund (Fries). 2. Um ein Auge als Zentrum entwickelt sich die Volute des ion. Kapitells. [Koepf / Binding 2016]</skos:definition>
