		<skos:prefLabel xml:lang="gd">TOGALAICHEAN  NÈIBHIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach no grunn thogalaichean is structaran a tha gan cleachdadh leis a' chabhlach. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">NAVAL ESTABLISHMENT</skos:prefLabel>
