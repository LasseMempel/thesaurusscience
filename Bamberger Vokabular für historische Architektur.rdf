        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T11:24:22.000</terms:modified>
        <skos:definition xml:lang="de">Doppelkruzifix n: ein Kruzifix, das auf zwei Seiten, als Doppelfigur, einen Gekreuzigten zeigt. Beispiel: am Salzburger KaIvarienberg vom Linzer Tor (15. Jh.). [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Doppelkruzifix</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">crucifix à double face</skos:prefLabel>
        <skos:prefLabel xml:lang="en">two-sided crucifix</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_ne734chh"/>
    </owl:NamedIndividual>
    


