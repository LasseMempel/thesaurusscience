        <skos:prefLabel xml:lang="en">arm-reliquary</skos:prefLabel>
        <skos:prefLabel xml:lang="la">brachium</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">bras-reliquaire</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">relikviář paže</skos:prefLabel>
    </owl:NamedIndividual>
    


