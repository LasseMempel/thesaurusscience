    <!-- https://hist-arch-vocab.org/bvha#c_54cc966e -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_54cc966e">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
