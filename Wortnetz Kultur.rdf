	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk018764">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Altkarte</skos:prefLabel>
		<skos:altLabel xml:lang="de">Altkarten</skos:altLabel>
		<skos:prefLabel xml:lang="en">early map</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk018765"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk018765"/>
		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk018762"/>
		<skos:definition xml:lang="de">Eine Altkarte ist eine Landkarte, die in der Regel im großen Maßstab einen komplexen Sachverhalt überschaubar darstellt, beispielsweise zur Orientierung im Gelände für das Militär, zur Darstellung von Besitzverhältnissen oder ähnliches. Meist handelt es sich um archivalische Unikate, wie handgezeichnete Pläne oder Risse, welche im Wesentlichen in der Zeit von der Mitte des 16. Jahrhunderts bis in die erste Hälfte des 19. Jahrhunderts entstanden sind.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk018765"/>
