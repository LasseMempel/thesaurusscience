        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_5f5f2ac0"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_8cd9df30"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_f140d346"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_ea0c92d2"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T20:28:53.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T17:26:40.000</terms:modified>
        <skos:altLabel xml:lang="fr">arcade aérienne</skos:altLabel>
        <skos:altLabel xml:lang="es">arco arbotante</skos:altLabel>
        <skos:altLabel xml:lang="it">arco rampante</skos:altLabel>
        <skos:altLabel xml:lang="en">flying buttress</skos:altLabel>
        <skos:definition xml:lang="de">Hochschiffstrebe, veraltet fliegende Strebe; im got. Strebewerk ansteigender Bogen zur Aufnahme des Gewölbeschubs und des Winddrucks, meist ein mit Aufmauerung (Spreize) versehener Halbbogen; auch als Schwebende Arkade oder Maßwerkbrücke ausgebildeter, durchbrochener S.; waagerecht verlaufende S„ die der Abstützung zwischen zwei Mauern oder Gebäuden dienen, heißen Schwibbogen. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Im gotischen Strebewerk ein ansteigender Halbbogen bzw. einhüftiger Bogen mit einer aufliegenden Strebe bzw. Spreize, welche den Gewölbeschub vom Mittelschiff einer Basilika über die Dächer der Seitenschiffe auf die Strebepfeiler überträgt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Strebebogen</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">arc-boutant</skos:prefLabel>
        <skos:prefLabel xml:lang="es">arco rampante</skos:prefLabel>
        <skos:prefLabel xml:lang="en">buttress</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">opěrný oblouk</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_eea5235b"/>
    </owl:NamedIndividual>
    


