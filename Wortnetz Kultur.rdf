		<skos:prefLabel xml:lang="de">Konstatieruhr</skos:prefLabel>
		<skos:prefLabel xml:lang="en">pigeon clock</skos:prefLabel>
		<skos:altLabel xml:lang="en">pigeon clocks</skos:altLabel>
		<skos:altLabel xml:lang="de">Taubenuhr</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003319"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk003319"/>
		<skos:definition xml:lang="de">Eine Konstatieruhr ist eine Uhr, die die spezielle Funktion erfüllt, Ankunftszeiten von Brieftauben manipulationssicher zu dokumentieren. Sie besteht aus einem Uhrwerk, das mit einem Schlagwerk verbunden ist, das die Ankunftszeiten von Brieftauben auf einem Papierstreifen festhält. Sie hat oft eine Vorrichtung zur Aufnahme von Gummiringen, die den Tauben zugeordnet sind.</skos:definition>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1782910"/>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/1175406635"/>
