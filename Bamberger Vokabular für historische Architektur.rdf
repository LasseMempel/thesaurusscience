        <skos:definition xml:lang="de">Herzkreuz n: ein Kreuz über einem Herzen, als dem Sitz des geistigen Lebens. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Herzkreuz</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">croix de Sacré Coeur </skos:prefLabel>
        <skos:prefLabel xml:lang="en">cross of the Sacred Heart</skos:prefLabel>
    </owl:NamedIndividual>
    


