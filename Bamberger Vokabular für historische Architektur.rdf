        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-22T15:25:56.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T16:38:42.000</terms:modified>
        <skos:definition xml:lang="de">Ordines romani m pl : Bezeichnung der Bücher, in denen die Riten, Zeremonien und der Beginn aller für die gottesdienstlichen Handlungen bestimmten Texte niedergelegt sind; die Ordines romani entstanden zwischen dem 7. und 14. Jh. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="cs">Ordines Romani</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Ordines Romani</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Ordines romani</skos:prefLabel>
    </owl:NamedIndividual>
    


