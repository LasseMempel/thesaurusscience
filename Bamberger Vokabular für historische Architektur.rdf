    <!-- https://hist-arch-vocab.org/bvha#c_6e30844d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_6e30844d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_237c1721"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_557cee40"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_9b2e611c"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T11:21:46.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T18:11:41.000</terms:modified>
        <skos:altLabel xml:lang="de">Ausrichtung</skos:altLabel>
        <skos:definition xml:lang="de">Auch Ostung, Ausrichtung der Längsachse christlicher Kirchen von Westen nach Osten, so dass Chor und Altar nach Osten (d.h. zum Heiligen Land im Orient bzw. zur aufgehenden Sonne) weisen. Bei Bestattungen in der Kirche (Grablege) zeigen Füße und Gesicht des Toten gewöhnlich nach Osten. Auch nicht-christliche Kultbauten werden oft »orientiert« (griech.Tempel; Moschee; Synagoge). [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Ausrichtung einer Bauachse nach Osten (Ostung). [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Nasměrování podélné osy křesťanských kostelů ze západu na východ, takže chór a oltář ukazují směrem na východ (tj. ke Svaté zemi, resp. k vycházejícímu slunci). Při pohřbu v kostele směřují nohy a obličej zemřelého zpravidla k východu. Rovněž pohanské a židovské kultovní stavby bývají často „orientovány&quot; (řec. chrám). [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="it"> orientamento</skos:prefLabel>
        <skos:prefLabel xml:lang="en"> orientation</skos:prefLabel>
        <skos:prefLabel xml:lang="fr"> orientation</skos:prefLabel>
        <skos:prefLabel xml:lang="es"> oríentación</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Orientierung</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">orientace</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_6e3f44f4 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_6e3f44f4">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_ef163f2f"/>
