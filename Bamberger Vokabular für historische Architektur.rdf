        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-04T12:30:38.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T16:23:44.000</terms:modified>
        <skos:altLabel xml:lang="de">Schlafsaal</skos:altLabel>
        <skos:definition xml:lang="de">Dorment (lat. dormire: schlafen), urspr. jedes Schlafgemach, dann Schlafsaal der Mönche, meist im Obergeschoss des östl. Klosterflügels, auch die Gesamtheit der späteren Einzelzellen und somit der entsprechende Klosterflügel. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Schlafsaal eines Klosters. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Společná ložnice v klášteře. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Dormitorium</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">dormitář</skos:prefLabel>
    </owl:NamedIndividual>
    


