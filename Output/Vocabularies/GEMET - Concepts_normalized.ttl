    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Kürschnerei"@de,
        "furriery"@en .

<http://www.eionet.europa.eu/gemet/concept/3548> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/912> ;
    skos:definition "The order of birds that includes grouse, ptarmigan, capercaillie, partridges, pheasants, quails, turkeys and peacocks. These are mainly grain-eating, heavy-bodied, ground-nesting birds, capable of only short, rapid flights. The cocks are usually more colourful than the hens."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Hühnervögel"@de,
        "gallinacean"@en .

<http://www.eionet.europa.eu/gemet/concept/355> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1673> ;
    skos:closeMatch <http://data.uba.de/umt/_00041434> ;
    skos:definition "Amount of aluminium contained in a solution."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Aluminiumgehalt"@de,
        "aluminium content"@en .

<http://www.eionet.europa.eu/gemet/concept/3550> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12605> ;
