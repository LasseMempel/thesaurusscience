	<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/IA"/>
	<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/LBA"/>
	<skos:editorialNote xml:lang="en">ScARF Iron Age Panel recognises a Long Iron Age breaking down the perceived barriers between the Late Bronze Age, the Iron Age and the Early Medieval periods</skos:editorialNote>
	<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/scapa"/>
	<skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LON</skos:notation>
	<skos:prefLabel xml:lang="en">Long Iron Age</skos:prefLabel>
	<skos:prefLabel xml:lang="gd">(todo)</skos:prefLabel>
	<skos:scopeNote xml:lang="en">The Long Iron Age reflects the continuity and evolution of society, breaking down the perceived barriers between the Late Bronze Age, the Iron Age and much of the Early Medieval Period ending with the Norse incursions of the 9th century.</skos:scopeNote>
</rdf:Description>

