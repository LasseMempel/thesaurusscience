        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-30T14:08:39.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-04T14:34:24.000</terms:modified>
        <skos:definition xml:lang="de">Eine Säule, auf der kämpfende Tiere dargestellt sind, dämonische Mächte symbolisierend. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Freistehende Stütze (Säule oder Pfeiler), die mit plast. Darstellungen miteinander kämpfender Tiere (Löwen, Fabeltiere) bedeckt ist. Die B. kommt nur in der roman. Kunst vor, in Frankreich und Italien mehrfach, sonst selten. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Bestiensäule</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">colonne decorée d\&apos;animaux </skos:prefLabel>
        <skos:prefLabel xml:lang="en">column decorated with animals </skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_9278284e"/>
    </owl:NamedIndividual>
    


