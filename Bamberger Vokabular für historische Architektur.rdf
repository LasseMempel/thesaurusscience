        <skos:altLabel xml:lang="de">Hostienhäubchen</skos:altLabel>
        <skos:altLabel xml:lang="fr">petite bourse de ciboire</skos:altLabel>
        <skos:definition xml:lang="de">Hostiensäckchen n, auch Hostienhäubchen n, bursula: aus Leinen gefertigtes Säckchen, das als Unterlage für die konsekrierten Hostien im Ziborium dient. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Hostiensäckchen</skos:prefLabel>
        <skos:prefLabel xml:lang="la">bursula</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">petit linge de ciboire</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">sáček na hostie</skos:prefLabel>
    </owl:NamedIndividual>
    


