        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_b3578e38"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_bb130123"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_cc7a1644"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_cd36cd8a"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_dc8fc75b"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T17:20:02.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T17:29:33.000</terms:modified>
        <skos:altLabel xml:lang="it">colonna</skos:altLabel>
        <skos:altLabel xml:lang="fr">colonne</skos:altLabel>
        <skos:altLabel xml:lang="en">column</skos:altLabel>
        <skos:altLabel xml:lang="es">columna de apoyo</skos:altLabel>
        <skos:altLabel xml:lang="cs">opěra</skos:altLabel>
        <skos:altLabel xml:lang="es">pilar de apoyo</skos:altLabel>
        <skos:altLabel xml:lang="it">pilastrino</skos:altLabel>
        <skos:altLabel xml:lang="en">pillar</skos:altLabel>
        <skos:altLabel xml:lang="cs">podpora</skos:altLabel>
        <skos:altLabel xml:lang="fr">poteau</skos:altLabel>
        <skos:altLabel xml:lang="cs">rámová stojka</skos:altLabel>
        <skos:altLabel xml:lang="cs">sloup rámu</skos:altLabel>
        <skos:altLabel xml:lang="en">support</skos:altLabel>
        <skos:definition xml:lang="de">Aufrechtes, meist stabförmiges Bauglied, das je nach seinem Querschnitt als Säule oder als Pfeiler bezeichnet wird. Im Holzbau nennt man die S.n Pfosten, Ständer, Mast, Steher, Stiel oder auch Säule. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Stütze</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">podpěra</skos:prefLabel>
        <skos:prefLabel xml:lang="it">puntello</skos:prefLabel>
        <skos:prefLabel xml:lang="es">soporte</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">support</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_b4dbeb90 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b4dbeb90">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_3e25acca"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_zafa5lop"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_5bf6bcac"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-15T15:30:03.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T13:15:30.000</terms:modified>
        <skos:altLabel xml:lang="de">Hängeschlußstein</skos:altLabel>
        <skos:altLabel xml:lang="de">Hängezapfen</skos:altLabel>
        <skos:altLabel xml:lang="en">cul-de-lampe</skos:altLabel>
        <skos:altLabel xml:lang="fr">cul-de-lampe</skos:altLabel>
        <skos:altLabel xml:lang="fr">fausse clef pendante</skos:altLabel>
        <skos:altLabel xml:lang="en">pendent</skos:altLabel>
        <skos:definition xml:lang="de">Ein in der Gewölbeleibungverfugter und herabhängender, häufig knauf -oder zapfenförmiger Stein, meist im Gewölbescheitel als Schlußstein.Zu unterscheiden vom Absenker und vom hängenden Trichter. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Herabhängender Zapfen als Schlussstein eines Gewölbes oder schmückende Verzierung an sich kreuzenden Hölzern. [Schrader / Voigt 2003]</skos:definition>
        <skos:definition xml:lang="de">Hängezapfen, zapfenförmiger, herabhängender Schlussstein (hängender Schlussstein) an Rippengewölben bes. in spätgot. Zeit. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Pozdně gotický typ svorníku, visí dolů do prostoru. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Abhängling (Gewölbe)</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">clef pendante</skos:prefLabel>
        <skos:prefLabel xml:lang="en">pendant</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">visutý svorník</skos:prefLabel>
        <broaderByPosition rdf:resource="https://hist-arch-vocab.org/bvha#c_3e25acca"/>
    </owl:NamedIndividual>
    


