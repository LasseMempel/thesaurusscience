	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk008144">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">blacksmith aprons</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Schmiedeschürze</skos:prefLabel>
		<skos:altLabel xml:lang="de">Schmiedeschürzen</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk007927"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk007927"/>
		<skos:definition xml:lang="de">Eine Schmiedeschürze ist eine Latzschürze, die aus Leder gefertigt ist und zur Schutzbekleidung gehört.</skos:definition>
		<xe:explanation_temp xml:lang="de">Besonders bei Schürzen von Hufschmieden ist diese im unteren Bereich geteilt und an den Beinen fixiert, um so die Schienbeine zu schützen.</xe:explanation_temp>
