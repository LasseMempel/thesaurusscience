		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk002319"/>
		<skos:definition xml:lang="de">Sichtmauerwerk ist ein Mauerwerk, bei dem die Steinoberflächen sichtbar und weder verputzt noch geschlämmt sind. </skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002319"/>
