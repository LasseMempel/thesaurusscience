		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1317</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FACTARAIDH THARPÀILEAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Factaraidh far a bheilear a' dèanamh cainb-thearra, mar is trice de chanabhas.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TARPAULIN WORKS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
