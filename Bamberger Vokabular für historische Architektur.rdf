        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-22T11:34:40.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T16:31:12.000</terms:modified>
        <skos:definition xml:lang="de">Diurnale n, horae diurnae: Auszug aus dem Brevier mit den Tageshoren. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Diurnale</skos:prefLabel>
