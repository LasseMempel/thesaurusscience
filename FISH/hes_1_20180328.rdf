		<skos:prefLabel xml:lang="gd">TAIGH-BARRAID</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Taigh ann an sreath de thaighean a tha balla ri balla agus a chaidh a phlanadh 's a thogail mar aon aonad.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TERRACED HOUSE</skos:prefLabel>
