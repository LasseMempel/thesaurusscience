<http://www.eionet.europa.eu/gemet/concept/935> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8494> ;
    skos:closeMatch <http://data.uba.de/umt/_00005257>,
        <http://dbpedia.org/resource/Blood> ;
    skos:definition "A fluid connective tissue consisting of the plasma and cells that circulate in the blood vessels."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:narrowMatch <http://eurovoc.europa.eu/5717> ;
    skos:prefLabel "Blut"@de,
        "blood (tissue)"@en .

<http://www.eionet.europa.eu/gemet/concept/9352> a skos:Concept ;
    skos:broadMatch <http://eurovoc.europa.eu/339> ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2036> ;
    skos:closeMatch <http://data.uba.de/umt/_00000649> ;
    skos:definition "The permanent clear-felling of an area of forest or woodland. On steep slopes this can lead to severe soil erosion, especially where heavy seasonal rains or the melting of snow at higher levels cause sudden heavy flows of water. In the humid tropics it may also lead to a release of carbon dioxide from the soil."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Auslichtung"@de,
        "woodland clearance"@en .

<http://www.eionet.europa.eu/gemet/concept/9353> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8388> ;
    skos:closeMatch <http://data.uba.de/umt/_00027055> ;
    skos:definition "The interacting system of a biological community and its non-living environmental surroundings in wooded areas or land areas covered with trees and shrubs."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Waldökosystem"@de,
        "woodland ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/9356> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:closeMatch <http://data.uba.de/umt/_00029841>,
        <http://dbpedia.org/resource/Wood_preservation> ;
    skos:definition "The use of chemicals to prevent or retard the decay of wood, especially by fungi or insects; widely used preservatives include creosote, pitch, sodium fluoride and tar; especially used on wood having contact with the ground."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_8428> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Holzschutz"@de,
        "wood preservation"@en .

<http://www.eionet.europa.eu/gemet/concept/9363> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/451> ;
    skos:closeMatch <http://dbpedia.org/resource/Wool> ;
    skos:definition "A textile fiber made from raw wool characterized by absorbency, resiliency and insulation."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_8436>,
        <http://eurovoc.europa.eu/1564> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Wolle"@de,
        "wool"@en .

<http://www.eionet.europa.eu/gemet/concept/9367> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3032> ;
    skos:closeMatch <http://data.uba.de/umt/_00030632> ;
    skos:definition "A mine where all the mineral that could be profitably exploited has been removed."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Restloch"@de,
        "worked-out open cut"@en .

<http://www.eionet.europa.eu/gemet/concept/9371> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10837> ;
    skos:definition "The time devoted to gainful employment or job-related activities, usually calculated as hours per day or per week."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_8449>,
        <http://eurovoc.europa.eu/1257> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Arbeitszeit"@de,
        "working hours"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Working_time> .

<http://www.eionet.europa.eu/gemet/concept/9389> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13260> ;
    skos:closeMatch <http://data.uba.de/umt/_00000829>,
        <http://dbpedia.org/resource/Write-off> ;
    skos:definition "Accounting procedure that is used when an asset is uncollectible and is therefore charged-off as a loss."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Abschreibung"@de,
        "write-off"@en .

<http://www.eionet.europa.eu/gemet/concept/939> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6646> ;
    skos:closeMatch <http://data.uba.de/umt/_00005173> ;
    skos:definition "Microorganisms, formerly classified as algae but now regarded as bacteria, including nostoc, which contain a blue pigment in addition to chlorophyll."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Blaualgen"@de,
        "blue-green alga"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Cyanobacteria> .

<http://www.eionet.europa.eu/gemet/concept/9392> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9391> ;
    skos:definition "A deed performed by a government official or agent in exercise of police, constitutional, legislative, administrative or judicial powers that infringes upon the rights of another and causes damage, without protecting an equal or superior right."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Unerlaubter Regierungsakt"@de,
        "wrongful government act"@en .

<http://www.eionet.europa.eu/gemet/concept/9395> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6724> ;
    skos:definition "A substance which would not normally be found in a given environment, and usually means a toxic chemical which is entirely artificial, such as a chlorinated aromatic compound or an organomercury compound."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Xenobiotische Stoffe"@de,
        "xenobiotic substance"@en .

<http://www.eionet.europa.eu/gemet/concept/9398> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4491> ;
    skos:closeMatch <http://data.uba.de/umt/_00020984> ;
    skos:definition "A penetrating electromagnetic radiation, usually generated by accelerating electrons to high velocity and suddenly stopping them by collision with a solid body, or by inner-shell transitions of atoms with atomic number greater than 10; their wavelength ranges from about 10(-5) angstrom to 10(3) angstroms, the average wavelength used in research being 1 angstrom."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_8453> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Röntgenstrahlung"@de,
        "X ray"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/X-ray> .

<http://www.eionet.europa.eu/gemet/concept/9403> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3528> ;
    skos:closeMatch <http://data.uba.de/umt/_00012422>,
        <http://dbpedia.org/resource/Yeast> ;
    skos:definition "Many species of unicellular fungi, most of which belong to the Ascomycetes and reproduce by budding. The genus Saccharomyces is used in brewing and winemaking because in low oxygen concentration it produces zymase, an enzyme system that breaks down sugars to alcohol and carbon dioxide. Saccharomyces is also used in bread-making. Some yeasts are used as a source of protein and of vitamins of the B group."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Hefe"@de,
        "yeast"@en .

<http://www.eionet.europa.eu/gemet/concept/9404> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10940> ;
    skos:closeMatch <http://dbpedia.org/resource/Yield_%28finance%29> ;
    skos:definition "Profit or income created through an investment or a business transaction."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Ertrag (ökonomisch)"@de,
        "yield (economy)"@en .

<http://www.eionet.europa.eu/gemet/concept/9406> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1350> ;
    skos:closeMatch <http://data.uba.de/umt/_00014430>,
        <http://dbpedia.org/resource/Infant> ;
    skos:definition "A young child in the first years of life."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/2594> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Kleinkind"@de,
        "infant"@en .

<http://www.eionet.europa.eu/gemet/concept/9407> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/173> ;
    skos:closeMatch <http://dbpedia.org/resource/Youth> ;
    skos:definition "The state of being young; the period between childhood and adult age."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/1528> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Jugend"@de,
        "youth"@en .

<http://www.eionet.europa.eu/gemet/concept/9409> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9369> ;
    skos:closeMatch <http://data.uba.de/umt/_00013860>,
        <http://dbpedia.org/resource/Youth_work> ;
    skos:definition "Job opportunities and employment for adolescents, either for financial reward or educational enrichment."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/3529> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Jugendarbeit"@de,
        "youth work"@en .

<http://www.eionet.europa.eu/gemet/concept/9412> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8629> ;
    skos:closeMatch <http://data.uba.de/umt/_00028296>,
        <http://dbpedia.org/resource/Zinc> ;
    skos:definition "A brittle bluish-white metallic element that becomes coated with a corrosion-resistant layer in moist air and occurs chiefly in sphalerite and smithsonite. It is a constituent of several alloys, especially brass and nickel-silver, and is used in die-casting, galvanizing metals, and in battery electrodes."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_20119>,
        <http://eurovoc.europa.eu/4783> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Zink"@de,
        "zinc"@en .

<http://www.eionet.europa.eu/gemet/concept/9422> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1911> ;
    skos:closeMatch <http://data.uba.de/umt/_00030387> ;
    skos:definition "Area in which animals, especially wild animals, are kept so that people can go and look at them, or study them."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/6121> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
