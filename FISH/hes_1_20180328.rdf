		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501055" />
		<skos:scopeNote xml:lang="en">A kiln in which kelp is burnt to produce alkali, used in the manufacture of soap, glass, fertilisers and other products.</skos:scopeNote>
