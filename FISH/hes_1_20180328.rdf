	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1422">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1422</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">OIFIS PAIDHLEIT</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Oifis aig paidhleat aig a bheil teisteanas agus sàr-eòlach air làimhseachadh longan agus air an àite agus a bheir taic do chaiptean no maighstir soithich a gluasad a-steach no a-mach à cala no tro chaolas.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PILOT OFFICE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
