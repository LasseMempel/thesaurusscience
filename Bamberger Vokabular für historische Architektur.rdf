        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-23T12:19:21.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T11:40:03.000</terms:modified>
        <skos:definition xml:lang="de">Den unteren Winkel zwischen zwei Gerüsthölzern aussteifendes, maximal geschosshohes Holz. [Eißing et al. 2012]</skos:definition>
        <skos:definition xml:lang="de">Strebe Zwischen Ständer und Schwelle im Fachwerkbau zur Dreiecksversteifung. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Fußstrebe</skos:prefLabel>
    </owl:NamedIndividual>
    


