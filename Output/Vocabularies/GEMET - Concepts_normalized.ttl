    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Diskontinuierliches Verfahren"@de,
        "batch process"@en .

<http://www.eionet.europa.eu/gemet/concept/7369> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7367> ;
    skos:closeMatch <http://data.uba.de/umt/_00051778> ;
    skos:definition "A collection of rules and regulations adopted by authorities concerning structural and mechanical standards for safety."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Sicherheitsstandard für Gebäude"@de,
        "safety standard for building"@en .

<http://www.eionet.europa.eu/gemet/concept/7370> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7236> ;
    skos:closeMatch <http://data.uba.de/umt/_00022446> ;
    skos:definition "Research, detailed examination and usually a written report on the need for or efficacy of actions, procedures or devices intended to lower the occurrence or risk of injury, loss and danger to persons, property or the environment."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Sicherheitsstudie"@de,
        "safety study"@en .

<http://www.eionet.europa.eu/gemet/concept/7373> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/387> ;
    skos:closeMatch <http://data.uba.de/umt/_00021263>,
        <http://dbpedia.org/resource/Salamander> ;
    skos:definition "Any of various urodele amphibians, such as Salamandra salamandra of central and S Europe. They are typically terrestrial, have an elongated body, and only return to water to breed."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_6743> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Salamander"@de,
        "salamander"@en .

<http://www.eionet.europa.eu/gemet/concept/7384> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1561> ;
    skos:closeMatch <http://data.uba.de/umt/_00021270>,
        <http://dbpedia.org/resource/Salmonella> ;
    skos:definition "General name for a family of microorganisms, one of the largest groups of bacteria, that includes those most frequently implicated in food poisoning and gastroenteritis. Unhygienic handling and inadequate cooking of poultry and meat, improper storage of cold meats and, more recently, contamination of battery-reared hen eggs, are the most common sources of salmonella infections."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_6757> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Salmonellen"@de,
        "salmonella"@en .

<http://www.eionet.europa.eu/gemet/concept/7396> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8252> ;
    skos:closeMatch <http://dbpedia.org/resource/Salt_marsh> ;
    skos:definition "Areas of brackish, shallow water usually found in coastal areas and in deltas. There are also inland marshes in arid areas where the water has a high salt level because of evaporation. They are environmentally delicate areas, extremely vulnerable to pollution by industrial or agricultural chemicals, or to thermal pollution, which often results when river water has been used as the coolant in power stations and industrial plants."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Salzsumpf"@de,
        "salt marsh"@en .

<http://www.eionet.europa.eu/gemet/concept/7397> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5110> ;
    skos:closeMatch <http://data.uba.de/umt/_00021303> ;
    skos:definition "A meadow subject to overflow by salt water."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Salzwiese"@de,
        "salt meadow"@en .

<http://www.eionet.europa.eu/gemet/concept/7400> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5264> ;
    skos:closeMatch <http://data.uba.de/umt/_00021294> ;
    skos:definition "A mass of salt which is injected as a diapir (a dome in which the overlying rocks have been ruptured by the squeezing-out of plastic core material) into overlying sedimentary rocks, thereby piercing and deforming them. The mechanism is similar to that of an intrusive magma, with the salt deforming and behaving plastically under pressure. It is of great economic importance because it assists in the formation of a \"trap\" structure for oil accumulation, in addition to its associated deposits of anhydrite, gypsum and sulphur."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Salzstock"@de,
        "salt plug"@en .

<http://www.eionet.europa.eu/gemet/concept/7410> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7407> ;
    skos:definition "Method of selecting items at random from a set in such a manner that the sample will be representative of the whole."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Probenahmemethode"@de,
        "sampling technique"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Sampling_%28statistics%29> .

<http://www.eionet.europa.eu/gemet/concept/7419> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/78> ;
    skos:definition "Stabilization of dunes effected by the planting of marram grass (Ammophila arenaria), or rice grass, whose long roots bind the surface layers of sand and so hinder its removal by wind. A larger scale method of dealing with the same problem is by afforestation."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Sanddünenstabilisierung"@de,
        "sand dune fixation"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Sand_dune_stabilization> .

<http://www.eionet.europa.eu/gemet/concept/7420> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2377> ;
    skos:definition "An accumulation of loose sand heaped up by the wind, commonly found along low-lying seashores above high-tide level, more rarely on the border of large lakes or river valleys, as well as in various desert regions, where there is abundant dry surface sand during some part of the year."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Sanddüne"@de,
        "sand dune"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Dune> .

