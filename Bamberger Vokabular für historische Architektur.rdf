    <!-- https://hist-arch-vocab.org/bvha#c_bdef47f5 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_bdef47f5">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_85c6b98d"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_34ca6582"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-14T12:31:36.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T16:41:50.000</terms:modified>
        <skos:altLabel xml:lang="de">Zurundung</skos:altLabel>
        <skos:definition xml:lang="de">Bevorzugte Erosion von ursprünglich scharfen Kanten und Ecken zu einem gerundeten Profil. Zurundung wird besonders bei Gesteinen beobachtet, die durch „Körnigen Zerfall“ verwittern, oder wenn die Umgebungsbedingungen den „Körnigen Zerfall“ fördern. [ICOMOS-ISCS] </skos:definition>
        <skos:definition xml:lang="en">Preferential erosion of originally angular stoneedges leading to a distinctly rounded profile. Rounding canespecially be observed on stones which preferably deterioratethrough granular disintegration, or when environmentalconditions favor granular disintegration. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="fr">forme arrondie résultant de l’érosionpréférentielle des bords originellement anguleux d’une pierre.On observe cette forme d’altération sur les pierres sujettes àla désagrégation granulaire, ou placées dans des conditionstelles que la désagrégation granulaire peut se développer. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="cs">přednostní eroze původně ostrohranného kamene vedoucí k výrazně zakulacenému profilu. Zakulacení může být obzvláště pozorováno na kamenech, které přednostně chátrají v důsledku zrnitého rozpadu, nebo když jsou podmínky prostředí pro zrnitý rozpad příznivé. [ICOMOS-ISCS] </skos:definition>
        <skos:prefLabel xml:lang="de">Abrundung</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">erosion en boule</skos:prefLabel>
        <skos:prefLabel xml:lang="en">rounding</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">zakulacení</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_bdf08c99 -->


