		<skos:prefLabel xml:lang="de">Faltbrief</skos:prefLabel>
		<skos:altLabel xml:lang="de">Faltbriefe</skos:altLabel>
		<skos:prefLabel xml:lang="en">letter sheet</skos:prefLabel>
		<skos:altLabel xml:lang="en">letter sheets</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk010097"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk010097"/>
		<skos:definition xml:lang="de">Ein Faltbrief ist ein auf besondere Weise gefalteter Brief, der ohne Umschlag versendet werden kann. Die Postanschrift wird außen, der Brieftext innen verfasst. In der Regel wird ein Faltbrief vor dem Versenden zugeklebt, beispielsweise mit einem Siegel.</skos:definition>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1394947"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010097"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-11-16T15:04:37+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk020962">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">telegram</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Telegramm</skos:prefLabel>
		<skos:altLabel xml:lang="de">Telegramme</skos:altLabel>
		<skos:altLabel xml:lang="en">telegrams</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk020967"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk020967"/>
		<skos:definition xml:lang="de">Ein Telegramm ist Schriftverkehr, der über elektronische oder telegrafische Mittel versandt wird. Ursprünglich erfolgte die Übertragung der Nachrichten per Telegrafie, bei der kurze Botschaften in Form von Morsecodes von einem Ort zum anderen geschickt wurden. Sie dienten oft für wichtige, dringende oder geschäftliche Mitteilungen, da das Verschicken eine schnelle und zuverlässige Kommunikationsmethode darstellte.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4184647-3"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1522225"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk020967"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
