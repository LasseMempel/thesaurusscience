    <!-- https://hist-arch-vocab.org/bvha#c_4970fedc -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_4970fedc">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b07a7fe9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-20T18:11:57.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T11:47:08.000</terms:modified>
        <skos:definition xml:lang="de">Ehemaliger Standort einer verschwundenen Burg. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Burgstall</skos:prefLabel>
