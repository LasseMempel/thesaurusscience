    <!-- https://hist-arch-vocab.org/bvha#c_b4d2bfb6 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b4d2bfb6">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1df9f722"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-15T11:06:05.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-18T14:03:38.000</terms:modified>
        <skos:altLabel xml:lang="de">Markierung mit Schlagleine</skos:altLabel>
        <skos:altLabel xml:lang="de">Schnurschlag</skos:altLabel>
        <skos:altLabel xml:lang="en">chalk line</skos:altLabel>
        <skos:altLabel xml:lang="en">snapped cord</skos:altLabel>
        <skos:definition xml:lang="en">A method of applying a straight line on plaster (can be coloured or without colour) by stretching a piece of string, pulling back and releasing it so that it snaps against the painting, leaving a mark. [EwaGlos]</skos:definition>
        <skos:definition xml:lang="de">Eine Methode, gerade Linien auf Putzmörtel aufzubringen (kann farbig oder farblos sein), indem eine Schnur gespannt, leicht abgehoben und wieder losgelassen wird, sodass sie auf den Putz zurückschnellt und dabei eine Spur hinterlässt. [EwaGlos]</skos:definition>
        <skos:prefLabel xml:lang="de">Markierung durch Schlagschnur</skos:prefLabel>
        <skos:prefLabel xml:lang="en">snapped line</skos:prefLabel>
    </owl:NamedIndividual>
    


