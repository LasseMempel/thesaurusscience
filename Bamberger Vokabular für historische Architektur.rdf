        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-15T09:52:08.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-28T13:26:44.000</terms:modified>
        <skos:example xml:lang="de">Die aussteifenden Gerüstelemente umfassen alle Hölzer, die schräg zu den tragenden Gerüstelementen verlaufen und deren Aufgabe vorrangig darin besteht, Deformation und Verschiebung zu verhindern. Beinhaltet das Gerüst unverschiebliche Dreiecke, z. B. Sparrenpaare, übernehmen diese nicht nur tragende, sondern auch aussteifende Funktion. (Eißing et al. 2012)</skos:example>
        <skos:prefLabel xml:lang="de">aussteifendes Holzgerüstelement</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_46f8305f"/>
    </owl:NamedIndividual>
    


