    <!-- https://hist-arch-vocab.org/bvha#c_34bbdee2 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_34bbdee2">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_effad513"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-15T13:05:21.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T14:50:24.000</terms:modified>
        <skos:altLabel xml:lang="bg">Pетуш</skos:altLabel>
        <skos:altLabel xml:lang="de">Reintegration</skos:altLabel>
        <skos:altLabel xml:lang="de">Retusche</skos:altLabel>
        <skos:altLabel xml:lang="tr">bütünleme</skos:altLabel>
        <skos:altLabel xml:lang="de">farbliche Reintegration</skos:altLabel>
        <skos:altLabel xml:lang="tr">tümleme</skos:altLabel>
        <skos:note xml:lang="de">Ihr Ziel ist, die Auswirkung eines Schadens und einer Fehlstelle zu reduzieren, indem die künstlerische und ikonographische Lesbarkeit erhöht wird. Zwei- und dreidimensionale Ergänzungen können mit verschiedenen Methoden und Techniken ausgeführt werden. (EwaGlos)</skos:note>
        <skos:note xml:lang="fr">Réduction de l’impact visuel des détériorations et lacunes sur une oeuvre d’art pour accroître sa lisibilité artistique et iconographique. Les réintégrations peuvent être biou tridimensionnelles et réalisées selon différentes méthodes et techniques. (EwaGlos)</skos:note>
        <skos:note xml:lang="en">To reduce the visual impact of damage and lacunae on a work of art, thus increasing its artistic and iconographic legibility. Two- and even three-dimensional reintegrations can be carried out using different methods and techniques. (EwaGlos)</skos:note>
        <skos:prefLabel xml:lang="en"> reintegration</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Integration</skos:prefLabel>
        <skos:prefLabel xml:lang="hu">kiegészítés</skos:prefLabel>
        <skos:prefLabel xml:lang="hr">reintegracija</skos:prefLabel>
        <skos:prefLabel xml:lang="es">reintegración</skos:prefLabel>
        <skos:prefLabel xml:lang="ro">reintegrare cromatică</skos:prefLabel>
        <skos:prefLabel xml:lang="it">reintegrazione</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">réintégration</skos:prefLabel>
        <skos:prefLabel xml:lang="tr">tamamlama</skos:prefLabel>
        <skos:prefLabel xml:lang="pl">uzupełnianie ubytków warstwy malarskiej, reintegracja</skos:prefLabel>
        <skos:prefLabel xml:lang="bg">Реинтеграция</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_34c17184 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_34c17184">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_ddcb8c64"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_19d56a39"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-27T17:33:43.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-13T11:33:56.000</terms:modified>
        <skos:altLabel xml:lang="en">tie beam</skos:altLabel>
        <skos:definition xml:lang="de">Ankerbalken: horizontal verlaufendes Holz, das durch seine spezielle, auf Zug beanspruchte Endpunktverbindung ein Auseinanderweichen der Konstruktion verhindert; kann häufig auch Doppelfunktionen als Deckenbalken, Geschossriegel o. Ä. besitzen.  (Eißing et al. 2012) </skos:definition>
        <skos:prefLabel xml:lang="de">Ankerbalken</skos:prefLabel>
        <skos:prefLabel xml:lang="en">ancher beam</skos:prefLabel>
        <skos:prefLabel xml:lang="it">catena</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">entrait</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Ankerbalken, hölzerner Zuganker zur Sicherung der Wände gegen den Schub des Dachwerks oder Gewölbes. [Koepf / Binding 2016]</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_34c90188 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_34c90188">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
