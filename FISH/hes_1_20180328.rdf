		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1665" />
		<skos:scopeNote xml:lang="en">A long narrow rectilinear enclosure of Neolithic date defined by a ditch, sometimes with a central bank.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1665">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1665</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CURSUS CUAIRTICHTE LE SLUIC E</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Lann ceart-cheàrnach fhada a tha ga chomharradh le slocan no tuill puist, gu tric le co-dhiù aon tallan na bhroinn. Thathar dhen bheachd gur ann airson deas-ghnàthan a bha e ann an linn ùr na cloiche.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PIT DEFINED CURSUS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1663" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1649" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1664" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1738" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1901" />
		<skos:scopeNote xml:lang="en">A long, rectangular enclosure defined by pits or post-holes, often with one or more internal divisions. Presumed to be ritual in function and of Neolithic date.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1667">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1667</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÀRACH TÒRRAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làraichean a thathar dhen bheachd gun robh ceangal aca ri tìodhlacadh mar is àbhaist no gu tric agus uaireannan gur e cleachdadh cràbhach no deas-ghnàthach an aon chleachdadh a bha annta.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">FUNERARY SITE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1708" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1494" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1668" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1487" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1692" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1703" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1712" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1716" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1727" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1645" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1673" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1526" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1695">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1695</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">CEARCALL CHÀRN BARPA CRUINN TURSACH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Cearcall de leacan a tha nan seasamh astar o chèile 's a tha a' stobadh à torr ìseal leth-chruinn creagach. Faodaidh gum bi na leacan ag aomadh a-mach air sgàth brùthadh an stutha sa chàrn.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">CAIRN CIRCLE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1667" />
				<skos:scopeNote xml:lang="en">A circle of spaced upright boulders emerging from a low, hemispherical, stony mound. The boulders may lean outwards due to pressure from the cairn material.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1697" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1709" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1714" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1715" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1718" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1724" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1725" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1726" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1693" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1723" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1679" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1722" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500631" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501658" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501718" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1497" />
		<skos:scopeNote xml:lang="en">Site types normally or frequently associated with burials which in some instances may have had solely religious or ritual functions.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1668">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1668</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BARPA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Tom ùir agus/no mòna 's cloiche fuadain a chaidh a thogail os cionn co-dhiù aon tìodhlacaidh, uaireannan le dìg mun cuairt air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BARROW</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">TUMULUS</skos:altLabel>
		<skos:altLabel xml:lang="en">BURIAL MOUND</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1667" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1670" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1671" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1669" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1672" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/506301" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1487" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1564" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1698" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1725" />
		<skos:scopeNote xml:lang="en">An artificial mound of earth and/or turf and stone raised over one or more burials, sometimes surrounded by a ditch.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1669">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1669</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BARPA UCHDAIN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Cuimhneachan à Linn Ùr na Cloiche a tha na thorr fhada chaol ùir. Faodaidh gun deach a thogail aig an aon àm no gur e torr no barpa fada a bha ann mu thràth 's a chaidh a leudachadh a tha ann.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BANK BARROW</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1668" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1670" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1671" />
		<skos:scopeNote xml:lang="en">A Neolithic monument comprising a long, narrow earthen mound. May be of single-phase construction, or represent the addition of a linear extension to an existing mound or long barrow.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1670">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1670</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BARPA FADA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Cuimhneachan tìodhlacaidh à linn ùr na cloiche. Tha seo na thom ùir ceart-cheàrnach no trapasoideach, gu tric le dìgean mun cuairt air no air an dà thaobh air. Bidh an tom seo os cionn marbh-lainn air choireigin mar is trice.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">LONG BARROW</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1668" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1669" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1671" />
		<skos:scopeNote xml:lang="en">A Neolithic funerary monument, consisting of a rectangular or trapezoidal earthen mound, often with flanking or encircling ditches. The mound usually covers a mortuary structure of varying construction.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1671">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1671</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BARPA CRUINN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Torr leth-chruinn mun a bheil dìg (no uaireannan a dhà no barrachd dhìgean co-mheadhanach), gu tric le uchdan air an taobh a-muigh (ach uaireannan air an taobh a-staigh cuideachd). Bidh beirm eadar an torr 's an dìg uaireannan. Cleachd seòrsa nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ROUND BARROW</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-08-02T08:02:06</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">BELL BARROW</skos:altLabel>
		<skos:altLabel xml:lang="en">BELL DISC BARROW</skos:altLabel>
		<skos:altLabel xml:lang="en">BOWL BARROW</skos:altLabel>
		<skos:altLabel xml:lang="en">DISC BARROW</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1668" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1580" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1669" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1670" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1672" />
		<skos:scopeNote xml:lang="en">A hemispherical mound surrounded by a ditch (or occasionally two or more concentric ditches), often accompanied by an external (or occasionally internal) bank. Mound and ditch may sometimes be separated by a berm. Use specific type where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1672">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1672</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BARPA CEÀRNAGACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Cuimhneachan tìodhlacaidh sa bheil lann bheag cheàrnagach le dìg 's a tha mun cuairt air an àite-tìodhlacaidh sa mheadhan agus faodaidh gum bi torr os a chionn. Chithear seo mar chomharra-barra gu tric.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SQUARE BARROW</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1668" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1495" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1671" />
		<skos:scopeNote xml:lang="en">A burial monument comprising a small square ditched enclosure surrounding a central interment, which may be covered by a mound. Often visible as a cropmark.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1673">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1673</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TÒRRADH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Tìodhlacadh iarsmaidhean duine no beathaich. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BURIAL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">VIKING BURIAL</skos:altLabel>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1674">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1674</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TÒRRADH BOGLAICH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Corp a chaidh a thìodhlacadh ann am boglach no talamh fliuch. Dh'fhaoidte gun deach a thìodhlacadh a dh'aona-ghnothach no gu tubaisteach.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">BOG BURIAL</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1673" />
				<skos:scopeNote xml:lang="en">A body which has been interred in boggy or waterlogged ground. Interment may have been deliberate or accidental.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1667" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1677">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1677</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">CLADH PLÀIGHE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Àite-tìodhlacaidh do dhaoine a bhàsaich leis a' phlàigh dhubh, nan aonar no ann am mòr-uaigh, gu math tric air falbh o àitichean-tìodhlacaidh eile.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">PLAGUE BURIAL</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1673" />
				<skos:scopeNote xml:lang="en">A burial place for the victims of plague, in either single or mass graves, often isolated from other burials.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1678">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1678</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TÒRRADH LUINGE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Tìodhlacadh san deach an corp a chur ann an long no bàta, a chur fo long no bàta no am broinn clachan air cruth luinge.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">SHIP BURIAL</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:altLabel xml:lang="en">BOAT BURIAL</skos:altLabel>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1673" />
				<skos:scopeNote xml:lang="en">A burial in which the body is placed in or covered by a ship or boat, or within a setting of stones in the shape of a ship.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1675" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502868">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502868</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TÒRRADH CHNÀMHAN</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Tìodhlacadh iarsmaidhean duine no beathaich ann an òrdugh nan cnàmhan 's gun a losgadh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">INHUMATION</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-08-08T11:16:48</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-08-08T11:17:50</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1673" />
				<skos:scopeNote xml:lang="en">An interment of unburnt, articulated human remains.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/508602" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1716" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1723" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1726" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1742" />
		<skos:scopeNote xml:lang="en">An interment of human or animal remains. Use specific term where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1675">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1675</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">IARMAD LUATHA-CUIRP</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Iarsmaidhean loisgte corp duine. Gheibhear iad air an tìodhlacadh mar is trice, uaireannan ann an soitheach le earrasan-uaige còmhla riutha.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CREMATION</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1673" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1700" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1708" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1714" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1715" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1726" />
		<skos:scopeNote xml:lang="en">The fragmentary, burnt remains of a human body. Usually found buried, occasionally in a container associated with grave goods.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1679">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1679</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TRANNSA TÒRRAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Sgiath a tha a' stobadh a-mach no seipeal am broinn eaglaise no togalach a sheasas leis fhèin a tha teaghlach ga chleachdadh airson tìodhlacaidhean prìobhaidean.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BURIAL AISLE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1667" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1742" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1744" />
		<skos:scopeNote xml:lang="en">A projecting wing or chapel within a church, or a freestanding building, used privately by a family for burial.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1692">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1692</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CLADH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Pìos talmhainn a chaidh a chleachdadh airson tìodhlacaidhean, mar is trice a-mach o na meadhan-aoisean suas gun 19mh linn. Dh'fhaoidte gum bi seo dealaichte on eaglais.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BURIAL GROUND</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1667" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1526" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1697" />
		<skos:scopeNote xml:lang="en">An area of land used for burials, generally used from the medieval period up to the 19th century. It may also be detached from the church.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1693">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1693</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CRÙISLE TÒRRAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Seòmar fon talamh a chaidh a dhealbhadh airson tìodhlacadh grunn chisteachan-laighe.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BURIAL VAULT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1667" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1724" />
		<skos:scopeNote xml:lang="en">An underground room designed to accommodate the internment of several coffins.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1697">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1697</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CLADH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Pìos talmhainn a chaidh a shònrachadh airson tìodhlacadh nam marbh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CEMETERY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">NECROPOLIS</skos:altLabel>
		<skos:altLabel xml:lang="en">GRAVEYARD</skos:altLabel>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1698" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1667" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1700" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1702" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1699" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/507850" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1526" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1692" />
		<skos:scopeNote xml:lang="en">An area of ground set apart for the burial of the dead.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1698">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1698</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CLADH BHARPANNAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Badan de bharpannan agus cuimhneachain cho-cheangailte a tha glè fhaisg air a chèile, m.e. cuairt-dìgean.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BARROW CEMETERY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1697" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1668" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1699" />
		<skos:scopeNote xml:lang="en">A cluster of closely-spaced barrows and related monuments, e.g. ring ditches.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1699">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1699</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CLADH CHÀIRN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Grunn chàrn a tha glè fhaisg air a chèile 's a chaidh a chleachdadh airson tìodhlacadh no deas-ghnàthan mar is trice.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CAIRN CEMETERY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1697" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1487" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1698" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/49" />
		<skos:scopeNote xml:lang="en">A group of cairns in close proximity which are predominantly funerary or ritual in nature.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1700">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1700</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CLADH LUATH-CHORP</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Cladh anns nach eil ach iarsmaidhean loisgte dhaoine le co-dhiù cuid dhiubh ann an soithichean criadha.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CREMATION CEMETERY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1697" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1701" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1675" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1714" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1715" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1726" />
		<skos:scopeNote xml:lang="en">A cemetery comprising exclusively cremated human remains, some or all of which may be contained within pottery vessels.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1701">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1701</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CLACH LUATH-CHORP CUAIRTICHTE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite-tìodhlacaidh à Linn an Umha sa bheil àite iadhta cearcallach far an deach cuirp a losgadh agus faodaidh gu bheil cuid dhiubh ann am poitean-tasgaidh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ENCLOSED CREMATION CEMETERY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1700" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1525" />
		<skos:scopeNote xml:lang="en">A burial site of Bronze Age date comprising a circular enclosed area containing cremations, some of which may be in urns.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1702">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1702</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CLADH LEAC-CHISTEAN FADA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach thràth Chrìostail sa bheil grunn chisteachan fada sa bheil tìodhlacaidhean dhaoine nan sìneadh. Chaidh an tìodhlacadh a' dol siar on ear.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">LONG CIST CEMETERY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1697" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1710" />
		<skos:scopeNote xml:lang="en">An early Christian site with a number of long cists containing extended inhumation burials. Burials are usually oriented E-W.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1703">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1703</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BARPA SEÒMARACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Cuimhneachan tìodhlacaidh à Linn Ùr na Cloiche sa bheil seòmar cloiche am broinn torr ùir no cloiche. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CHAMBERED TOMB</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">BURIAL CHAMBER</skos:altLabel>
		<skos:altLabel xml:lang="en">CHAMBERED MOUND</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1667" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1488" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/506301" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1727" />
		<skos:scopeNote xml:lang="en">A Neolithic burial monument comprising a stone-built chamber within a mound of earth or stone. Use more specific term where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1708">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1708</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">ULAINN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach far a bheilear a' cumail cnàmhan nam marbh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CHARNEL HOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1667" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1675" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1724" />
		<skos:scopeNote xml:lang="en">A building where the bones of the dead are stored.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1709">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1709</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LEAC-CHISTEAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar a bhios ceart-cheàrnach a ghnàth 's a chaidh a chleachdadh airson tìodhlacadh mar is trice; leacan a chaidh a sheasamh air oir agus co-dhiù aon leac chòmhnard no clach-mhullaich os an cionn. Dh'fhaoidte gun deach na cisteanan a thogail air an uachdar no san talamh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CIST</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1667" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1710" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1711" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1716" />
		<skos:scopeNote xml:lang="en">Generally rectangular structure normally used for burial purposes; formed from stone slabs set on edge and covered by one or more horizontal slabs or capstones. Cists may be built on the surface or sunk into the ground.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1710">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1710</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LEAC-CHISTE FHADA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Ciste fhada cheart-cheàrnach, mar is trice le tìodhlacadh sìnte na broinn.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">LONG CIST</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1709" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1702" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1711" />
		<skos:scopeNote xml:lang="en">A long rectangular cist, usually containing an extended inhumation burial.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1711">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1711</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LEAC-CHISTE GHOIRID</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Ciste ghoirid ceart-cheàrnach no ceàrnagach. Dh'fhaoidte gum bi tìodhlacadh crùbanach na bhroinn no tìodhlacadh losgaidh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SHORT CIST</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1709" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1710" />
		<skos:scopeNote xml:lang="en">A short rectangular or square cist. May contain a crouched inhumation burial or a cremation.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1712">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1712</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CISTE-LAIGHE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Bogsa cloiche, fiodha no luaidhe anns an cuirear corp marbh airson tìodhlacadh no losgadh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">COFFIN</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1667" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1713" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/508222">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/508222</dcterms:identifier>
				<skos:prefLabel xml:lang="en">TREE TRUNK COFFIN</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2015-07-07T11:14:10</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2015-07-07T14:00:28</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1712" />
				<skos:scopeNote xml:lang="en">A coffin made out of a hollow tree trunk.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1716" />
		<skos:scopeNote xml:lang="en">A stone, wood, or lead box in which a dead body is placed for interment or cremation.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1713">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1713</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LEAC-CHISTE SHNAIGHTE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Ciste cloiche a chaidh a shnaidheadh air an taobh a-muigh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SARCOPHAGUS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1712" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1653" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1716" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1720" />
		<skos:scopeNote xml:lang="en">A stone coffin embellished with sculpture.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1714">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1714</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">SLOC LOSGADH-CUIRP</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far an deach corp a losgadh air breò-chual os cionn sluic anns an do thuit na h-iarsmaidhean an dèidh na cùise. Bidh earrasan-uaighe loisgte a chaidh a chur ri taobh a' chuirp air a' bhreò-chual na chois uaireannan.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CREMATION PIT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1667" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1675" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1700" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1901" />
		<skos:scopeNote xml:lang="en">A site where a corpse has been burnt on a pyre over a pit, which acts as a receptacle for the remains. Occasionally accompanied by burnt grave goods, placed with the body on the pyre.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1715">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1715</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">IONAD LOSGADH-CHORP</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach no làrach far a bheilear a' losgadh cuirp; thèid an luaithre a chruinneachadh airson tìodhlacadh no sgapadh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CREMATORIUM</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1667" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1675" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1700" />
		<skos:scopeNote xml:lang="en">A building or site where bodies are burnt, and the ashes collected for burial or dispersal.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1716">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1716</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">UAIGH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite far an deach cuideigin tìodhlacadh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GRAVE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">VIKING GRAVE</skos:altLabel>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1922" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1667" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1717">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1717</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">UAIGH CREIGE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Tìodhlacadh leis fhèin a chaidh a shnaidheadh san fho-chreag.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">ROCK CUT GRAVE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1716" />
				<skos:scopeNote xml:lang="en">A single burial cut into bedrock.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
