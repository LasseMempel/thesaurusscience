    <!-- https://hist-arch-vocab.org/bvha#c_7698a523 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_7698a523">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_depjwldn"/>
