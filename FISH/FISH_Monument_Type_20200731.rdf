    <skos:scopeNote xml:lang="en">A searchlight battery used to light a beach.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68924">
