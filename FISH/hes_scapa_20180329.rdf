	<dct:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence"/>
	<dct:spatial rdf:resource="http://dbpedia.org/resource/Scotland"/>
	<dct:spatial rdf:resource="http://vocab.getty.edu/tgn/7002444"/>
	<skos:altLabel xml:lang="en">Early Prehistory</skos:altLabel>
	<skos:broadMatch rdf:resource="http://vocab.getty.edu/aat/300019257"/>
	<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/PR"/>
	<skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/EPR"/>
	<skos:editorialNote xml:lang="en">Palaeolithic / Mesolithic</skos:editorialNote>
	<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/scapa"/>
	<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/ME"/>
	<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/PA"/>
	<skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EPR</skos:notation>
	<skos:prefLabel xml:lang="en">Early Prehistoric</skos:prefLabel>
	<skos:prefLabel xml:lang="gd">Tràth Ro-eachdraidheil</skos:prefLabel>
	<skos:scopeNote xml:lang="en">For objects or monuments characteristic of hunter gatherer societies during the Palaeolithic (Old Stone Age) or Mesolithic but cannot be specifically assigned. Use more specific term where appropriate.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="http://purl.org/heritagedata/schemes/scapa/concepts/GEO">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
	<cc:attributionURL rdf:resource="https://www.historicenvironment.scot/"/>
	<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence"/>
