    <!-- https://hist-arch-vocab.org/bvha#c_24a51a7d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_24a51a7d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_d498d507"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-15T15:51:40.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-12T17:56:04.000</terms:modified>
        <skos:altLabel xml:lang="de">Beletage</skos:altLabel>
        <skos:altLabel xml:lang="de">Hauptgeschoss</skos:altLabel>
        <skos:altLabel xml:lang="cs">beletáž</skos:altLabel>
        <skos:definition xml:lang="de">Beletage (frz. schönes Geschoss), Piano nobile, Geschoss, in dem sich die Repräsentationsräume befinden, meist 1. Obergeschoss. Seit Barock. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Beletage (frz. schönes Stockwerk), das Hauptgeschoss eines Gebäudes (Geschoss) mit den Repräsentationsräumen, meist über dem Erdgeschoss. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Beletage, Hauptgeschoss eines größeren Gebäudes.[Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Franc. krásné podlaží, též piano nobile. Podlaží s reprezentačními prostorami, většinou v 1. patře, od baroka. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Piano nobile n (ital.), auch Beletage, Hauptgeschoss in einem größeren Gebäude bzw. im Schloss. Das P. n. befindet sich im Allgemeinen im ersten Obergeschoss, selten im zweiten. Im 18. Jh. ist es aber auch möglich, dass es im Erdgeschoss liegt, besonders bei Lustschlössern. Über Fenstertüren kann dann der Garten zum erweiterten Nutzungsraum des Gebäudes werden. H. L. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:prefLabel xml:lang="de">Piano nobile</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">piano nobile</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_d498d507"/>
    </owl:NamedIndividual>
    


