    skos:broader <http://lvr.vocnet.org/wnk/wk002252> ;
    skos:definition "Ein Kämpfergesims ist ein Gesims, das in Kämpferhöhe verläuft und als Gliederung einer Außenwand die Kämpfer mehrerer Öffnungen miteinander verbinden oder bei einem Tonnengewölbe oder einer ähnlichen Form die Kämpferzone betonen kann."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Kämpfergesims"@de,
        "impost (architecture)"@en .

