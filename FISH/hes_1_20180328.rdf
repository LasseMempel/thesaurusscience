		<skos:prefLabel xml:lang="gd">LÀRACH ULLACHADH STUTHAN-AODAICH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Tha seo a' gabhail a-steach gealachadh, cur an treisginn, dathadh is clò-bhualadh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TEXTILE FINISHING SITE</skos:prefLabel>
