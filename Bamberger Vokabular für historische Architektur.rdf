        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-20T16:33:00.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T17:27:27.000</terms:modified>
        <skos:altLabel xml:lang="de">Abrasion</skos:altLabel>
        <skos:definition xml:lang="de">Eine Form der Erosion, die durch Abtragen oder Abreiben mit harten Werkzeugen oder durch den Aufprall von Partikeln (Sandstrahl) erzeugt wird. [ICOMOS-ISCS] </skos:definition>
        <skos:definition xml:lang="en">Erosion due to wearing down or rubbing awayby means of friction, or to the impact of particles. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="fr">Erosion due à un frottement (attrition) ou àl’impact de particules. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="cs">Eroze, způsobená odnosem nebo obrušováním, dřením a třením, nebo dopadem částic (např. při pískování). [ICOMOS-ISCS] </skos:definition>
        <skos:definition xml:lang="de">Oberflächlicher Verlust oder Schaden als Ergebnis eines mechanisch verursachten Abriebs. [EwaGlos]</skos:definition>
        <skos:definition xml:lang="en">Superficial loss or damage as a result of mechanical action due to friction. [EwaGlos]</skos:definition>
        <skos:prefLabel xml:lang="de">Abrieb</skos:prefLabel>
        <skos:prefLabel xml:lang="en">abrasion</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">abrasion</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">odírání</skos:prefLabel>
    </owl:NamedIndividual>
    


