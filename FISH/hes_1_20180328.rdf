		<skos:prefLabel xml:lang="gd">IONAD-BLUMAIREACHD</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Fùirneis shimplidh airson meatailt a leaghadh gus blùmairean iarainn a dhèanamh de chlach-iarainn.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BLOOMERY</skos:prefLabel>
