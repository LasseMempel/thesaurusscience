	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1805">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1805</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LIOFT</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar a tha na bhogsa no ùrlar airson bathar no daoine a ghluasad o làr gu làr. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">LIFT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1806" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1799" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500530" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500671" />
		<skos:scopeNote xml:lang="en">A structure consisting of a box or platform for carrying goods or passengers from one level to another. Use specific term where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1806">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1806</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CRANN-TOGAIL BHÀTAICHEAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar airson bàtaichean is soithichean uisge eile a thogail.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BOAT LIFT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1805" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1869" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1875" />
		<skos:scopeNote xml:lang="en">A structure used for the lifting of boats and other water craft.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1807">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1807</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">UNNDAIS</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Inneal togail suidhichte sa bheil druma cuairteachaidh mun a bheil càball, ròpa no slabhraidh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">WINCH</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1799" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1808">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1808</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">UNNDAIS-LÀIMHE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Inneal-làimh a chleachdar gus cuideaman a thogail 's ìsleachadh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">HAND WINCH</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1807" />
				<skos:scopeNote xml:lang="en">A mechanism used for lifting and lowering weights, operated by hand.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:scopeNote xml:lang="en">A stationary hoisting machine consisting of a rotating drum around which a cable, rope or chain is attached.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1810">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1810</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CEUM</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Slighe do luchd-coiseachd, gu h-àraid tè a nochd an cois daoine a' coiseachd am badeigin ('s nach deach a thogail a dh'aona-ghnothach).</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PATH</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502197" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1853" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501708" />
		<skos:scopeNote xml:lang="en">A way made for pedestrians, especially one merely made by walking (often not specially constructed).</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1811">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1811</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÀRACH CÒMHDHAIL- RÈILE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalaichean, làraichean agus structaran a tha co-cheangailte le còmhdhail rèile.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">RAILWAY TRANSPORT SITE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">GOODS OFFICE</skos:altLabel>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1819">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1819</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">GEARRADH-RÈILE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Dìg mhòr a chaidh a chladhach gus àite a chruthachadh do rathad-iarainn thairis air talamh cas no garbhlach.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">RAILWAY CUTTING</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1811" />
				<skos:scopeNote xml:lang="en">An artificial excavation cut through steep or uneven ground to make a way for a railway track.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1820" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1821">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1821</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">SNAIDHM-RÈILE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Àite far a bheil co-dhiù dà rathad-iarainn a' coinneachadh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">RAILWAY JUNCTION</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1811" />
				<skos:scopeNote xml:lang="en">A place where two or more railways meet.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1822">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1822</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">CABHSAIR  RÈILE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Ùrlar togte ri taobh rathaid-iarainn aig stèisean-rèile airson 's gun urrainn dhan luchd-siubhail tighinn far nan trèanaichean no a dhol orra gun duilgheadas.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">RAILWAY PLATFORM</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-04-20T13:53:59</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1811" />
				<skos:scopeNote xml:lang="en">A raised floor along the side of a line at a railway station, for convenience in entering and alighting from a train.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1823">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1823</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">SEACHADAN RÈILE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Traca goirid a tha co-shìnte ris a' phrìomh rathad-iarainn airson 's gum faigh trèanaichean is làraidhean seachad air a chèile. Cleachdar taobh-rèilean cuideachd gus trèanaichean a phàirceadh ann nuair nach eilear gan cleachdadh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">RAILWAY SIDING</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1811" />
				<skos:scopeNote xml:lang="en">A short piece of track lying parallel to the main railway line enabling trains and trucks to pass one another. Sidings can also be used to park trains which are not in use.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1824" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1826" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1827" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1828" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/264" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1830" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1813" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1775" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1812" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1814">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1814</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">CROIS-RÈILE FHOSGAILTE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Àite stiùirichte le solais rabhaidh, geataichean no crann-bacaidh far a bheil rathad a' dol thairis air rathad-iarainn.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">LEVEL CROSSING</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1811" />
				<skos:scopeNote xml:lang="en">A controlled point with warning lights and gates or barriers where a road crosses a railway line.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1815" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1791" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500583" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500584" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500585" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500586" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500644">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500644</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">CARAIDS-RÈILE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Cleachd airson carbad-rèile a tha na sheasamh 's ga chleachdadh airson adhbharan eile seach an fheadhainn a chaidh a dhealbhadh air an son - mar oifis, àite-fuirich is msaa.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">RAILWAY CARRIAGE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-30T11:26:35</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-30T11:26:51</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1811" />
				<skos:scopeNote xml:lang="en">Use for stationary railway carriage being used for a purpose it wasn't originally intended for - office, shelter, etc.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502186" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502234" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/503683">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/503683</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">MEANBH-RÈILE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Rathad-iarainn beag, gu math tric airson clann a' gluasad mun cuairt aig ionad chur-seachadan.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">MINIATURE RAILWAY</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-10-09T09:44:14</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-10-09T09:44:22</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1811" />
				<skos:scopeNote xml:lang="en">A small-scale railway, often for the transportation of children at a place of recreation.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/503841">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/503841</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">OIFIS RÈILE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Togalach no seòmar far an urrainnear tiocaidean rèile a cheannach agus far a bheilear ri obair-rianachd nan rathaidean-iarainn.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">RAILWAY OFFICE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-12-18T09:43:57</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-12-18T09:44:13</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:altLabel xml:lang="en">GOODS STATION OFFICE</skos:altLabel>
				<skos:altLabel xml:lang="en">PORTERS OFFICE</skos:altLabel>
				<skos:altLabel xml:lang="en">PANELS OFFICE</skos:altLabel>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1811" />
				<skos:scopeNote xml:lang="en">A building or room where railway tickets may be bought and administrative duties associated with a railway are conducted.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/504371">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/504371</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">FRÈAM LÀIR</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Frèam beag a tha faisg air uachdar na talmhainn 's a stiùireas puingean rèile agus/no siognailean, mar is trice airson smachd a chumail air na dh'fhalbhas a dh'ionnsaidh taobh-rèile (agus/no na thig a-steach uaipe) a thig far loidhne bheò. Thathar ga obrachadh le slatan agus/no uèirichean. Tha frèam mar seo dìreach nas lugha na am frèam am broinn bogsa siognaileadh làimhe ach chan eil e ga dhìon le iuchair no uidheam tèarainteachd.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">GROUND FRAME</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-05-11T16:22:01</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-05-11T16:23:03</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:altLabel xml:lang="en">LEVER FRAME</skos:altLabel>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1811" />
				<skos:scopeNote xml:lang="en">A small frame placed at ground level to operate railway points and/or signals, typically controllong exit and/or entrance from and to local sidings off a running line. These are operated by rodding and/or wires. Such a frame is essentially a smaller version of the frame within a manual signal box, but does not have any interlocking, protection being provided by a key or other security device.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:scopeNote xml:lang="en">Buildings, sites and structures associated with railway transport.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1812">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1812</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">SEADA EINNSEANAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach sa bheilear a' stòradh einnseanan-rèile.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ENGINE SHED</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">RAILWAY ENGINE SHED</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1811" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1476" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1813" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1828" />
		<skos:scopeNote xml:lang="en">A building used to house railway engines.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1813">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1813</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">SEADA BATHAR RÈILE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach far an tèid bathar a luchdadh far carbadan-rèile gus an sgaoileadh gu ionadail.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GOODS SHED</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">RAILWAY GOODS SHED</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1811" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1476" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1812" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1813" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500583" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500584" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500585" />
		<skos:scopeNote xml:lang="en">A building in which railway wagons can unload goods for local distribution.</skos:scopeNote>
