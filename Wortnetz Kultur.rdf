		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk003458"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk008403"/>
		<skos:definition xml:lang="de">Eine Höhenmarke ist ein Informationsträger, der eine bestimmte, genau vermessene Höhe markiert und als Orientierungspunkt für weitere Vermessungen dient.</skos:definition>
		<xe:explanation_temp xml:lang="de"> Eine Höhenmarke kann sowohl einen Nivellementpunkt markieren und muss dann aus besonders dauerhaftem Material bestehen als auch der zeitweisen Höhenfestlegung, etwa auf einer Baustelle, dienen.</xe:explanation_temp>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004569"/>
