        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T13:56:15.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T11:09:17.000</terms:modified>
        <skos:altLabel xml:lang="de">Zweiturmfassade</skos:altLabel>
        <skos:definition xml:lang="de">Flankiert mit ihren beiden Türmen den in das Mittelschiff führenden westl. Haupteingang; der Giebel des Mittelschiffs kann sichtbar in die Vorderflucht der Türme vorgezogen oder durch einen horizontal schließenden Vorbau verdeckt sein. In der 2. Hälfte des 11. Jhs. aus Westwerken entwickelt, in Oberitalien und Frankreich verbreitet, in Süddeutschland und in der Normandie vorhanden, im 12. Jh. von den frz. Kathedralen übernommen und in der Hochgotik weitergeführt. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Doppelturmfassade</skos:prefLabel>
        <skos:prefLabel xml:lang="it">facciata a due torri</skos:prefLabel>
        <skos:prefLabel xml:lang="es">fachada de dos torres</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">façade à deux tours</skos:prefLabel>
        <skos:prefLabel xml:lang="en">twin-tower facade</skos:prefLabel>
    </owl:NamedIndividual>
    


