		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/503015" />
		<skos:scopeNote xml:lang="en">A pump used to transfer petrol from a storage tank into cars, lorries and other road vehicles.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
