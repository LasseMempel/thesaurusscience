    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_80ba1410 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_80ba1410">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_13ca858d"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-21T11:35:21.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-23T20:16:58.000</terms:modified>
        <skos:definition xml:lang="de">Stütze über regelmäßig vieleckigem Grundriss mit Abakus als Kapitell (Abakussäule). Sie tritt im Neuen Reich Ägyptens auf und gilt formal als Vorstufe der dor. Säule. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="en"> proto-Doric column</skos:prefLabel>
        <skos:prefLabel xml:lang="it">colonna protodorica</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">colonne protodorique</skos:prefLabel>
        <skos:prefLabel xml:lang="es">columna protodórica</skos:prefLabel>
        <skos:prefLabel xml:lang="de">protodorische Säule</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_80ba4e6c -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_80ba4e6c">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_5a138dc5"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-08-19T14:10:12.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-08T15:03:29.000</terms:modified>
        <skos:definition xml:lang="cs">Horkou žehličkou přežehlený tenký povlak z alabastrové sádry, mramorového prachu a bílé křídy s barevnou lazurou. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Stucco lustro (ital.), Stuckmarmor, ein seit dem Barock angewandter, marmorierter Innenputz, der aus verschieden gefärbten Pasten geknetet, aufgetragen, gebügelt und poliert wurde. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Stucco lustro = mit heißem Eisen gebügelter dünner Überzug aus Alabastergips, Marmorstaub und Weißkalk mit Farblasur. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Stucco lustro</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">stucco lustro</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_80bbd1d2 -->


