    <skos:scopeNote xml:lang="en">A farm with a pond, river, lake or tanks where fish are kept and bred for commercial purposes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/109353">
    <skos:scopeNote xml:lang="en">A missile base armed with the Bristol Bloodhound surface-to-air missile. Bloodhounds were deployed to defend the launch sites of Thor Intermediate Range Ballistic Missiles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142959">
