        <skos:prefLabel xml:lang="fr">machine d\&apos;eau</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">vodní umělecké dílo</skos:prefLabel>
        <skos:prefLabel xml:lang="en">waterworks</skos:prefLabel>
    </owl:NamedIndividual>
    


