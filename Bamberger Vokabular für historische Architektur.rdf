        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T22:48:40.000</terms:modified>
        <skos:definition xml:lang="de">Expositionsleuchter m: der Leuchter für die Kerze, die bei der feierlichen Aussetzung des AllerheiIigsten brennt. Heute sind im allgemeinen zwei Leuchter üblich, es können aber auch sechs oder mehr Kerzen brennen. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Expositionsleuchter</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">chandelier d\&apos;exposition</skos:prefLabel>
        <skos:prefLabel xml:lang="en">exposition-candlestick</skos:prefLabel>
    </owl:NamedIndividual>
    


