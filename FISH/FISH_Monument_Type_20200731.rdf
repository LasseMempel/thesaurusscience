    <skos:scopeNote xml:lang="en">A vane usually combined with crossed rods to show the four compass points. Used to indicate the direction of the wind.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91040">
    <skos:scopeNote xml:lang="en">Including accommodation for animals, birds, reptiles and fish in captivity.</skos:scopeNote>
  </rdf:Description>
