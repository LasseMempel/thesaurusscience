        <skos:prefLabel xml:lang="fr">mur portant</skos:prefLabel>
        <skos:prefLabel xml:lang="es">muro portante</skos:prefLabel>
        <skos:prefLabel xml:lang="it">muro portante</skos:prefLabel>
    </owl:NamedIndividual>
    


