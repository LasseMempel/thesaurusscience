    <!-- https://hist-arch-vocab.org/bvha#c_ddc75860 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_ddc75860">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_219f468f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T14:38:51.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T09:55:51.000</terms:modified>
        <skos:definition xml:lang="cs">Děti s křídly v podobě malého Erata. V helénistické době oblíbený přídavek k plastikám, rovněž v nástěnných malbách (Pompeje). Podle jejich vzoru vznikli gotičtí andílkové a putti v době renesance a baroka. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Kinder mit Flügeln als kleine Erosgestalten. Im Hellenismus als Zugabe zu Plastiken beliebt, auch in Wandmalereien (Pompeji). Nach ihrem Vorbild entstanden die got. Kinderengel und die Putten in Renaissance und Barock. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Erote</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">erotové</skos:prefLabel>
    </owl:NamedIndividual>
    


