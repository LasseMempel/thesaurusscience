        <skos:altLabel xml:lang="de">einschenkliger Bogen</skos:altLabel>
        <skos:altLabel xml:lang="en">half arch</skos:altLabel>
        <skos:altLabel xml:lang="en">quadrant arch</skos:altLabel>
        <skos:definition xml:lang="de">Bogen, bei dem nur ein Bogenschenkel ausgebildet ist, der vom Kämpfer bis zum Bogenscheitel reicht und z. B. gegen eine Mauer läuft. Zu unterscheiden vom einhüftigen Bogen. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Halbbogen</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">demi-arc</skos:prefLabel>
        <skos:prefLabel xml:lang="en">semiarch</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_eea5235b"/>
    </owl:NamedIndividual>
    


