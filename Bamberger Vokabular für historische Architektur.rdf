    <!-- https://hist-arch-vocab.org/bvha#c_0bbaa2c3 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_0bbaa2c3">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b564a427"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-12T10:08:20.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T16:05:55.000</terms:modified>
        <skos:definition xml:lang="de">Typologie (griech. Vorbild, Beispiel), Lehre von der Übereinstimmung des Alten und Neuen Testaments (»Concordia veteris et novi testamenti«). Danach sind die Ereignisse des Alten Testaments prophetische Hinweise auf das Neue Testament. Die bildende Kunst stellt daher z.B. gern die 12 Propheten den 12 Aposteln, Elias im feurigen Wagen der Himmelfahrt Christi gegenüber. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Řec. vzor, příklad. Nauka o shodě Starého a Nového zákona (,,Concordia veteris et novi testamenti&quot;), podle níž jsou události Starého zákona prorockými odkazy na Nový zákon; výtvarné umění proto staví např. často 12 proroků proti 12 apoštolům, Eliáše v ohnivém voze proti nanebevstoupení Krista. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Typologie</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">typologie</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_0bc42efa -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_0bc42efa">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_c921098b"/>
