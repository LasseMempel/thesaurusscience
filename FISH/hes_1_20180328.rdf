		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1103" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1106" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501680" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502107" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502298" />
		<skos:scopeNote xml:lang="en">Buildings, sites and structures associated with the extraction of clay.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
