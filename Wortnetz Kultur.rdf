	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk020587">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">forging die</skos:prefLabel>
		<skos:altLabel xml:lang="en">forging dies</skos:altLabel>
		<skos:prefLabel xml:lang="de">Gesenk (Gerät)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Gesenke (Geräte)</skos:altLabel>
		<skos:altLabel xml:lang="en">swage</skos:altLabel>
		<skos:altLabel xml:lang="en">swages</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006998"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk019052"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk006998"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk019052"/>
		<skos:definition xml:lang="de">Ein Gesenk ist ein Gerät zur Metallbearbeitung, meist aus gehärtetem Werkzeugstahl, das aus zwei Teilen besteht: dem Untergesenk, das im Amboss eingesetzt ist, und dem Obergesenk, das im Hammer oder der Presse geführt wird. Beide tragen eine Hohlform (Kavität). Beim Gesenkschmieden wird das erhitzte Metallstück in das Untergesenk gelegt und durch Schlag oder Druck in die gewünschte Form umgeformt.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4122169-2"/>
		<skos:mappingRelation rdf:resource="http://www.wikidata.org/entity/Q124653669"/>
		<skos:broadMatch rdf:resource="http://vocab.getty.edu/aat/300023117"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk006998"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019052"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-09-08T13:14:10+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk020588">
