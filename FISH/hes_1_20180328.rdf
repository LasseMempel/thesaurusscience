				<skos:prefLabel xml:lang="gd">RATHAD DRÒBHA</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Rathad no ceum a chaidh a chleachdadh gu sònraichte le dròbhairean no buachaillean 's iad ag iomain a' chruidh gu margaid.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">DROVE ROAD</skos:prefLabel>
