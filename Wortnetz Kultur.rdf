	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021136">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Schuhanzieher</skos:prefLabel>
		<skos:altLabel xml:lang="de">Schuhlöffel</skos:altLabel>
		<skos:prefLabel xml:lang="en">shoehorn</skos:prefLabel>
		<skos:altLabel xml:lang="en">shoehorns</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk018000"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk018000"/>
		<skos:definition xml:lang="de">Ein Schuhanzieher ist ein länglicher, löffelartiger Gegenstand, der an der Ferse des Schuhs angesetzt wird, um ein leichteres Hineingleiten des Fußes zu ermöglichen.</skos:definition>
		<skos:exactMatch rdf:resource="https://d-nb.info/gnd/4701969-4"/>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300236449"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q14983"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk018000"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-03-27T19:54:05+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021137">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Rasierklingen-Schärfer</skos:altLabel>
		<skos:prefLabel xml:lang="de">Rasierklingenschärfer</skos:prefLabel>
		<skos:prefLabel xml:lang="en">razor sharpener</skos:prefLabel>
		<skos:altLabel xml:lang="en">razor sharpeners</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk009927"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk009927"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk012371"/>
		<skos:definition xml:lang="de">Ein Rasierklingenschärfer ist ein Gerät zum Nachschärfen von Rasierklingen. In der Regel erfolgt die Schärfung durch Schleifsteine, über die die Klingen geführt werden. Je nach Modell kommen unterschiedliche Techniken zum Einsatz.</skos:definition>
		<xe:explanation_temp xml:lang="de">Eine Variante von Rasierklingenschärfern funktioniert nach diesem Prinzip: Die Rasierklinge wird auf eine Halterung mit Zapfen gelegt und das Gerät geschlossen. Durch das wiederholte Hin- und Herziehen einer außen angebrachten Kordel werden die Klingen im Inneren über Schleifsteine geführt, die beide Schneiden nachschärfen.
Mit der Massenproduktion von Rasierklingen ab den ca. 1950er Jahren und der Einführung von Systemrasierern in den 1970er Jahren verloren Rasierklingenschärfer zunehmend an Bedeutung und wurden nicht mehr hergestellt.</xe:explanation_temp>
		<skos:mappingRelation rdf:resource="http://vocab.getty.edu/aat/300431187"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk009927"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-03-11T09:09:13+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021138">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">top hat</skos:prefLabel>
