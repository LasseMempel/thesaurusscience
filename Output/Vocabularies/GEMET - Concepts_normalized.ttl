    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Umweltschutzkosten"@de,
        "environmental protection cost"@en .

<http://www.eionet.europa.eu/gemet/concept/2905> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2900> ;
    skos:closeMatch <http://data.uba.de/umt/_00041524> ;
    skos:definition "Precautionary actions, procedures or installations undertaken by non-governmental, business or industrial entities to prevent or reduce harm to the ecosystem and human health."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Betrieblicher Umweltschutz"@de,
        "environmental protection in the enterprise"@en .

<http://www.eionet.europa.eu/gemet/concept/2907> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11494> ;
    skos:closeMatch <http://data.uba.de/umt/_00025292> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Umweltschutzauflage"@de,
        "environmental protection order"@en .

<http://www.eionet.europa.eu/gemet/concept/2908> a skos:Concept ;
    skos:broadMatch <http://eurovoc.europa.eu/2825> ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10012> ;
    skos:closeMatch <http://data.uba.de/umt/_00025316> ;
    skos:definition "A government agency, committee or group that is responsible for preserving and safeguarding ecological or natural resources."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Umweltschutzorganisation"@de,
        "environmental protection organisation"@en .

<http://www.eionet.europa.eu/gemet/concept/2909> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11514> ;
    skos:closeMatch <http://data.uba.de/umt/_00025331> ;
    skos:definition "A government or management prescribed rule for the preservation of natural resources and the prevention of damage or degradation of the ecosystem."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Umweltschutzvorschrift"@de,
        "environmental protection regulation"@en .

<http://www.eionet.europa.eu/gemet/concept/2910> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2932> ;
    skos:closeMatch <http://data.uba.de/umt/_00025326> ;
    skos:definition "Technologies that meet environmental objectives by incorporating pollution prevention concepts in their design. Environmental control strategies introduced in the early design stages of a process, rather than an end-of-pipe control option introduced in the later stages, improve the technical and economic performance of a process."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Umweltschutztechnik"@de,
        "environmental protection technology"@en .

<http://www.eionet.europa.eu/gemet/concept/2911> a skos:Concept ;
