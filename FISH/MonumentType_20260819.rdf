        <skos:prefLabel xml:lang="en">AERIAL LIFT</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A means of transportation where cars, chairs or cabins are carried above the ground by means of one or more cables suspended between towers or pylons.</skos:scopeNote>
