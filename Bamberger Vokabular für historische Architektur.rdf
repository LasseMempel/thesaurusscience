    <!-- https://hist-arch-vocab.org/bvha#c_d56109a3 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_d56109a3">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_18b9aa69"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_b41bd73a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-12T18:27:39.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T14:42:34.000</terms:modified>
        <skos:definition xml:lang="de">Reiber mit einseitigem Riegel, der nur einen Flügel verschließt. Er ist i. d. R. am Fensterrahmen befestigt, kann aber auch am Fensterflügel befestigt sein, z. B. beim Lüftungsflügelfenster oder bei nach außen zu öffnenden Fenstern. [Noky 1996]</skos:definition>
        <skos:prefLabel xml:lang="de">Einreiber</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_d57f9db1 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_d57f9db1">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0f7d8a02"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-04T16:01:54.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:43:09.000</terms:modified>
        <skos:altLabel xml:lang="de">Bogenrippengewölbe</skos:altLabel>
        <skos:altLabel xml:lang="de">Gewundene Reihung</skos:altLabel>
        <skos:altLabel xml:lang="de">Schlingrippengewölbe</skos:altLabel>
        <skos:altLabel xml:lang="en">looped vault</skos:altLabel>
        <skos:definition xml:lang="de">Gewundene Reihung, Kurvatur, im Grundriss kurvenförmige Ausbildung von Gewölberippen. In der spätgot. Baukunst v.a. in Böhmen, Mähren und Österreich vorkommend. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Gewölbe mit kurvig geführten, oft miteinander verflochtenen und verschlungenen Rippen. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="cs">Kroužená klenba  vzniká tehdy, když jsou žebra (pozdně gotické) hvězdové nebo síťové klenby zakřivena i ve svém půdorysu. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Ziergewölbe, dessen Rippen dreidimensionale Kurven bilden. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Schwingrippengewölbe</skos:prefLabel>
        <skos:prefLabel xml:lang="es">bóveda de nervios entrelazados</skos:prefLabel>
        <skos:prefLabel xml:lang="en">curvilinear rib vault</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kroužená klenba</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte à nervures curvilignes</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_d5825b62 -->


