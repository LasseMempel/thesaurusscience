    <!-- https://hist-arch-vocab.org/bvha#c_96e3b4fc -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_96e3b4fc">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_049c4c22"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0f3cab11"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-04T16:16:12.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:16:18.000</terms:modified>
        <skos:altLabel xml:lang="de">Muldengewölbe</skos:altLabel>
        <skos:altLabel xml:lang="cs">rovová klenba</skos:altLabel>
        <skos:altLabel xml:lang="fr">voûte en miroir</skos:altLabel>
        <skos:altLabel xml:lang="fr">voûte à fond plat</skos:altLabel>
        <skos:definition xml:lang="de">Ein Spiegelgewölbe entspricht einem Mulden- oder Kreuzgewölbe, dessen oberer Teil abgeschnitten ist. Die obere ebene, rechteckige oder elliptische (Barock!) Fläche heißt Spiegel. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Gewölbe, das aus mehreren trapezförmigen Ausschnitten aus einer Zylinderfläche, den Vouten und aus einem ebenen Mittelstück, dem Spiegel, gebildet ist. Über quadratischer Grundfläche ähnelt es einem abgeflachten Klostergewölbe, über rechteckiger Grundfläche einem abgeflachten Muldengewölbe. Es kann auch über kreisförmiger oder polygonaler Grundfläche errichtet sein und hat dann dementsprechend einen runden, ovalen oder polygonalen Spiegel. Durch die Einfügung ansteigender Stichkappen wird das Spiegelgewölbe oft eng mit vertikal gegliederten Wandflächen verbunden. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Irreführende Bezeichnung für eine Spiegeldecke. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Zrcadlová klenba je vlastně necková nebo křížová klenba s odříznutou horní částí; horní plochá, obdélníková nebo eliptická (baroko!) plocha se nazývá zrcadlo. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Spiegelgewölbe </skos:prefLabel>
        <skos:prefLabel xml:lang="es">bóveda amoldada</skos:prefLabel>
        <skos:prefLabel xml:lang="en">cloister vault with a horizontal crown area</skos:prefLabel>
        <skos:prefLabel xml:lang="it">volta a schifo</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte en arc-de-cloître déprimé</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">zrcadlová klenba</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_049c4c22"/>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_0f3cab11"/>
    </owl:NamedIndividual>
    


