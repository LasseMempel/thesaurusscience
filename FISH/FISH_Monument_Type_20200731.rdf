  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78224">
    <skos:scopeNote xml:lang="en">A prepared area of grass on which the game of football is played.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/97279">
    <skos:scopeNote xml:lang="en">A site where the magnetic signature of ships was lowered thereby making them less susceptible to magnetic mines.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92859">
    <skos:scopeNote xml:lang="en">A shelter in a public park.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69013">
    <skos:scopeNote xml:lang="en">A structure, often found in 18th century landscape gardens, that demonstrates eccentricity or excess rather than practical purpose. They can take many forms - ruins, sham castles, towers, hermits' cells or grottoes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141946">
    <skos:scopeNote xml:lang="en">A bridge which has had mines placed within its structure to enable it to be destroyed in the event of an invasion.</skos:scopeNote>
  </rdf:Description>
