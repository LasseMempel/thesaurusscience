    <skos:scopeNote xml:lang="en">An enclosed piece of land adjoining a house.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68556">
