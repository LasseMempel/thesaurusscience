        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-25T10:58:59.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:17:57.000</terms:modified>
        <skos:altLabel xml:lang="de">Gurtgewölbe</skos:altLabel>
        <skos:altLabel xml:lang="en">banded barrel vault </skos:altLabel>
        <skos:altLabel xml:lang="en">vault on transverse arches</skos:altLabel>
        <skos:definition xml:lang="de">Gewölbe, das durch Gurtbogen in Joche gegliedert ist. Die Gurtbogen verbessern die Statik des Gewölbes und bewirken eine Rhythmisierung der Gewölbefläche. Zu unterscheiden vom Gurtengewölbe. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Gurtbogengewölbe</skos:prefLabel>
        <skos:prefLabel xml:lang="en">banded vault</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte sur doubleaux</skos:prefLabel>
        <broaderByConstruction rdf:resource="https://hist-arch-vocab.org/bvha#c_049c4c22"/>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_049c4c22"/>
    </owl:NamedIndividual>
    


