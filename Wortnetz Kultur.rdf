		<skos:prefLabel xml:lang="de">Eisenware</skos:prefLabel>
		<skos:altLabel xml:lang="de">Eisenwaren (Bestandteile)</skos:altLabel>
		<skos:altLabel xml:lang="en">fittings (components)</skos:altLabel>
		<skos:prefLabel xml:lang="en">hardware (components)</skos:prefLabel>
		<skos:altLabel xml:lang="en">ironmongery</skos:altLabel>
		<skos:altLabel xml:lang="en">metal hardware</skos:altLabel>
