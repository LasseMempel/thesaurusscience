    <skos:broader>
      <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93325">
        <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2"/>
        <skos:prefLabel xml:lang="en">SIGNAL TOWER</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A tower in a semaphore communication system. Often a three-storey building on a hill in line-of-sight, signal towers provided working and living space, usually for two crewmen with their families.</skos:scopeNote>
        <dc1:identifier rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93325"/>
