        <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
        <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
        <skos:prefLabel xml:lang="en">Hadrianic</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Referring to the reign of Hadrian, 117 to 138 CE.</skos:scopeNote>
        <skos:notation xml:lang="en">ROHA</skos:notation>
      </skos:Concept>
    </skos:narrower>

    <skos:narrower>
      <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_period/concepts/ROSE">
