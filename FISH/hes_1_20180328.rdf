				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/2067</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TAIGH NEACH-CÙRAIM</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Àite-fuirich aig neach-cùraim, gu math tric co-cheangailte ri àite-obrach, no faisg air, m.e. sgoil.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">CARETAKERS HOUSE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-01-30T09:29:10</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:altLabel xml:lang="en">JANITORS HOUSE</skos:altLabel>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/422" />
				<skos:scopeNote xml:lang="en">Residence of a caretaker or janitor, often attached to, or adjacent to a place of work, e.g. a school.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
