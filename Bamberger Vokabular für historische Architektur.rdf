    <!-- https://hist-arch-vocab.org/bvha#c_a62474b7 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_a62474b7">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_6e8e74ba"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_19d56a39"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-11-05T09:05:43.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T11:21:50.000</terms:modified>
        <skos:definition xml:lang="de">Schwelle auf Massivbauten zur Gründung von Dachgerüsten. [Eißing et al. 2012]</skos:definition>
        <skos:definition xml:lang="de">Waagerechter, rechtwinklig zu den Binderbalken laufender und mit diesen verkämmter Balken, der am Dachfuß angeordnet ist, um den Druck liegender Stuhlsäulen auf mehrere Balken zu übertragen oder um den Schub der Sparren aufzunehmen. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Dachschwelle</skos:prefLabel>
        <skos:prefLabel xml:lang="it">banchina di gronda</skos:prefLabel>
        <skos:prefLabel xml:lang="en">pole plate</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">racinal de comble</skos:prefLabel>
        <skos:prefLabel xml:lang="es">viga de alero</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_a62b62c5 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_a62b62c5">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1f3378ac"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f4e2bee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_19d56a39"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-15T09:36:30.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-30T10:08:16.000</terms:modified>
        <skos:definition xml:lang="de">Werden die aus der Dachhaut resultierenden Lasten in firstparallel verlaufende Balken abgetragen, handelt es sich um ein Balkendach. In seiner Grundform besteht das Balkendach aus von Giebel zu Giebel ohne Unterstützung frei gespannten Balken. Bei einer Variante des Balkendaches bilden dicht aneinandergelegte Balken die Traghölzer der Dachhaut. Das Balkendach ist das einzige Grundsystem, das horizontal als Flachdach ausgeführt werden kann. (Eißing et al. 2012)    </skos:definition>
        <skos:prefLabel xml:lang="de">Balkendach</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">trámová střecha</skos:prefLabel>
        <broaderByConstruction rdf:resource="https://hist-arch-vocab.org/bvha#c_f4e2bee8"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_a62e2d44 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_a62e2d44">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_6628bcb3"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T17:56:47.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T17:59:19.000</terms:modified>
        <skos:altLabel xml:lang="fr">croix bretessée </skos:altLabel>
        <skos:altLabel xml:lang="de">gezinneltes Kreuz</skos:altLabel>
        <skos:definition xml:lang="de">Wiederkrückenkreuz n; auch gezinneltes Kreuz n: ein Krückenkreuz mit einem oder mehreren Querhölzern auf jedem BaIken. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Wiederkrückenkreuz</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">croix crénelée</skos:prefLabel>
        <skos:prefLabel xml:lang="en">embattled cross</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_a63420c9 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_a63420c9">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0b1e85cc"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_1a9644a7"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_eef3ed7d"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_eieuwx7k"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-05T12:01:46.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T12:08:21.000</terms:modified>
        <skos:definition xml:lang="de">Darstellung der Dreifaltigkeit seit dem 12. Jh.: Gottvater auf dem Thron hält mit beiden Händen das Kreuz mit Christus (oder im Schoß Christi Leichnam), der Heilige Geist wird durch eine schwebende Taube dargestellt. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Zobrazení Nejsvětější Trojice od 12. stol.: Bůh Otec sedí na trůnu a oběma rukama drží kříž s Kristem (nebo na klíně Krista ukřižovaného), Duch svatý bývá znázorněn jako holubice. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Gnadenstuhl</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">trůn milosti</skos:prefLabel>
    </owl:NamedIndividual>
    


