        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_6d7fd588"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_7f718198"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_989fd4d2"/>
