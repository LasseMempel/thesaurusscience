    skos:closeMatch <http://data.uba.de/umt/_00041319> ;
    skos:definition "EC Directive proposed on 15 July 1992 aiming at harmonizing national measures concerning the management of packaging and packaging waste; the directive covers all packaging placed on the market."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "EU-Verpackungsrichtlinie"@de,
