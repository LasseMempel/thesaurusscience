        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-08T16:57:36.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T17:35:03.000</terms:modified>
        <skos:definition xml:lang="en">Crack that crosses completely the stone piece. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="de">Ein Riss, der vollständig durch ein Gestein hindurchgeht. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="fr">Fissure traversant complètement une pierre. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="cs">prochází napříč celým kamenným objektem. [ICOMOS-ISCS]</skos:definition>
        <skos:prefLabel xml:lang="de">Bruch</skos:prefLabel>
        <skos:prefLabel xml:lang="en">fracture</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">fracture</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">lomová trhlina</skos:prefLabel>
