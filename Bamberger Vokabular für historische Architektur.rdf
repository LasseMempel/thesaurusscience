        <skos:definition xml:lang="de">Ministrant, der den Weihrauchbehälter trägt. </skos:definition>
        <skos:prefLabel xml:lang="de">Navikular</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_4b37676b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_4b37676b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_dd883e1f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-27T10:53:54.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T13:00:52.000</terms:modified>
        <skos:altLabel xml:lang="cs">bok</skos:altLabel>
        <skos:definition xml:lang="de">(frz. flanc ›Weiche, Seite‹), eine Seite der Bastion zwischen der anschließenden Kurtine und einer Face der Bastion. Die F. war, insbesondere bei frühen Festungen, manchmal eingezogen (Stadtbefestigung Forchheim BY) und (bisweilen mehrstöckig) kasemattiert. Bei eingezogenen F.n war das äußere Ende der Face anfangs häufig mit einem Orillon besetzt (Bad Pyrmont, 16. Jh.). Im 19. Jh. wurde F. definiert als »die Linie einer verteidigungsfähigen Deckung, die das unmittelbare Vorfeld bzw. den Graben einer anderen Verteidigungslinie der Länge nach bestreicht (flankiert)« (Frobenius 1901). M. L. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:prefLabel xml:lang="de">Flanke (Bauteil)</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">strana</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_4b3fd0f8 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_4b3fd0f8">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_219f468f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-25T10:20:20.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T16:57:51.000</terms:modified>
        <skos:definition xml:lang="de">Die Darstellung von Bauwerken, Bauteilen und Innenräumen mit den Mitteln der Malerei und Graphik (Architekturbild, Architekturmalerei, Vedute), als Planzeichnung (Bauplan, Bauriss) oder in der Form eines plast. Modells (Baumodell). [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Architekturdarstellung</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_4b4e99f7 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_4b4e99f7">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_86c8b719"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_aa0d1c4c"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-09T19:20:27.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T13:38:13.000</terms:modified>
        <skos:altLabel xml:lang="de">Chormeisterstab</skos:altLabel>
        <skos:altLabel xml:lang="de">Praecentorstab</skos:altLabel>
        <skos:altLabel xml:lang="de">Vorsängerstab</skos:altLabel>
        <skos:altLabel xml:lang="la">baculus praecentoris</skos:altLabel>
        <skos:altLabel xml:lang="en">precentor\&apos;s staff</skos:altLabel>
        <skos:definition xml:lang="de">Kantorstab m; auch Chormeisterstab m; Vorsängerstab m; Praecentorstab m; lat. baculus cantoris; baculus praecentoris: das Insigne eines Kantors als Leiter der Kirchenmusik; ein Stab, der durch unterschiedliche Schmuckformen bekrönt tist, z. B. durch ein pflanzliches Motiv, eine Kugelform oder figürliche Darstellung. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Kantorstab</skos:prefLabel>
        <skos:prefLabel xml:lang="la">baculus cantoris</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">bâton de chantre</skos:prefLabel>
        <skos:prefLabel xml:lang="en">cantor\&apos;s staff</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_4b599987 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_4b599987">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
