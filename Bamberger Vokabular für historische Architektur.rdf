        <skos:prefLabel xml:lang="es">cuatrifolio</skos:prefLabel>
        <skos:prefLabel xml:lang="en">pointed quatrefoil</skos:prefLabel>
        <skos:prefLabel xml:lang="it">quadrifoglio</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">quatrefeuille( s)</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">čtyřlist</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Maßwerkfigur, aus vier spitzbogig geformten Bättern zusammengesetzt. [BVHA]</skos:scopeNote>
    </owl:NamedIndividual>
    


