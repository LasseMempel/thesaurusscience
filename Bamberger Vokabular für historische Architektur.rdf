        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-21T17:11:12.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T15:27:20.000</terms:modified>
        <skos:altLabel xml:lang="de">Bogengang</skos:altLabel>
        <skos:definition xml:lang="de">Auf einer Seite von einer Arkade begrenzter Gang. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Durch Bogenstellungen nach einer Seite hin geöffneter Gang, z. B. bei den Triforien der Kathedralen oder auch entlang einer Häuserfront. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Arkadengang</skos:prefLabel>
        <skos:prefLabel xml:lang="en">arcade (corridor)</skos:prefLabel>
        <skos:prefLabel xml:lang="es">corredor arqueado</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">passage à arcades</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_7e6088ec -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_7e6088ec">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_5c1316e1"/>
