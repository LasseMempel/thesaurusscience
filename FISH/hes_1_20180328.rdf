		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/742" />
		<skos:scopeNote xml:lang="en">An engineering works that makes products used in agriculture.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
