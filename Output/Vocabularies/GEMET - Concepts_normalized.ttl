<http://www.eionet.europa.eu/gemet/concept/9186> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3313> ;
    skos:closeMatch <http://data.uba.de/umt/_00500264>,
        <http://dbpedia.org/resource/Water_hyacinth> ;
    skos:definition "Floating aquatic plant, Eichornia crassipes of tropical America, having showy bluish-purple flowers and swollen leafstalks: family Pontederiaceae. It forms dense masses in rivers, ponds, etc., and is a serious pest in the southern U.S., Java, Australia, New Zealand, and parts of Africa."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Wasserhyazinthe"@de,
        "water hyacinth"@en .

<http://www.eionet.europa.eu/gemet/concept/9190> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4116> ;
    skos:closeMatch <http://data.uba.de/umt/_00027345> ;
    skos:definition "The level reached by the surface of a body of water."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_29685> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
