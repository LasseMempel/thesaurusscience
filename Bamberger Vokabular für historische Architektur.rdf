        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-17T09:38:08.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-17T09:39:35.000</terms:modified>
        <skos:definition xml:lang="de">Querstab aus Holz oder Stein, der Fenster (oder Tür) unterteilt, bildet mit dem senkrecht teilenden Setzholz das Fensterkreuz. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Kämpfer (Fenster)</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_af2e58fb -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_af2e58fb">
