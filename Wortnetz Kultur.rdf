		<skos:altLabel xml:lang="en">heaters (equipment)</skos:altLabel>
		<skos:prefLabel xml:lang="de">Heizgerät</skos:prefLabel>
		<skos:altLabel xml:lang="de">Heizgeräte</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006132"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk006132"/>
		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk004129"/>
		<skos:definition xml:lang="de">Ein Heizgerät ist ein einzelnes technisches Gerät, das elektrische oder andere Energie in Wärme umwandelt, um Räume, Gegenstände oder Flüssigkeiten zu erwärmen. Im Unterschied zur Heizungsanlage, die aus mehreren Komponenten besteht und ein ganzes Gebäude oder mehrere Räume zentral beheizt, arbeitet das Heizgerät eigenständig und wird meist zur punktuellen oder temporären Beheizung eingesetzt.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300427136"/>
		<skos:narrowMatch rdf:resource="http://www.wikidata.org/entity/Q12069731"/>
