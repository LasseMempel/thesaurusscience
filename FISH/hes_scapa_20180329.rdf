	<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/PA"/>
	<skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/11/concepts/508444"/>
	<skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/UPA"/>
	<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300019262"/>
