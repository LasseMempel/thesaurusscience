	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk003833">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Islam</skos:prefLabel>
		<skos:prefLabel xml:lang="en">Islam</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk020939"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk003836"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019758"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk020939"/>
		<xe:explanation_temp xml:lang="de">Zentraler Glaubensgrundsatz für die sich Muslime oder Moslems nennenden Anhänger ist die unbedingte Ergebung des Willens Allahs, des einzigen Gottes, Schöpfer aller Dinge und Herrscher über die Welt.</xe:explanation_temp>
		<skos:definition xml:lang="de">Der Islam ist eine Religion, die als abrahamitische und monotheistische Glaubensgemeinschaft auf der Offenbarung Gottes (Allah) in der heiligen Schrift des Koran, der Verkündigung des arabischen Propheten Mohammed, beruht.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003836"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019758"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk020939"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-08-22T14:16:50+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk003834">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">Hinduism</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Hinduismus</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk020939"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk003836"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019758"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk020939"/>
		<skos:definition xml:lang="de">Der Hinduismus ist eine polytheistische Religion, die im 1. Jahrtausend vor Christus entstanden ist und in Indien praktiziert wird. Im Hinduismus gibt es im gegensatz zu den anderenWeltreligionen keine Lehre, sondern eine Sammlung von religiösen und ethischen Anschauungen.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003836"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019758"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk020939"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-08-22T14:16:43+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk003835">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Gebück</skos:prefLabel>
		<skos:altLabel xml:lang="de">Gehag</skos:altLabel>
