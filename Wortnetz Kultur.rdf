	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk015676">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Dübel</skos:prefLabel>
		<skos:prefLabel xml:lang="en-US">screw anchor</skos:prefLabel>
		<skos:altLabel xml:lang="en-US">screw anchors</skos:altLabel>
		<skos:prefLabel xml:lang="en-UK">wall plug</skos:prefLabel>
		<skos:altLabel xml:lang="en-UK">wall plugs</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006114"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk006114"/>
		<skos:definition xml:lang="de">Ein Dübel ist ein kleines, zylindrisches Verbindungselement, um Schrauben, Nägeln oder Haken in Wänden, Decken, Böden und anderen Baustoffen zu verankern. Die Oberfläche eines Dübels kann glatt oder leicht gerillt sein. Die Rillen oder Vertiefungen auf der Oberfläche können dazu beitragen, dass ein Dübel im Bohrloch besseren Halt findet. Einige Dübel weisen Schlitze, Kerben oder Flügel auf, die während der Installation eine Ausdehnung oder Verankerung ermöglichen.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4150813-0"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1098256"/>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300081964"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk006114"/>
		<xe:status>candidate</xe:status>
