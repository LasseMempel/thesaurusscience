		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502130">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502130</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">STRUCTAR GAS NÀDARRA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalaichean is structaran a tha co-cheangailte ri saothrachadh is stòradh gas nàdarra.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">NATURAL GAS STRUCTURE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-15T08:54:31</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-15T08:54:44</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1210" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502129">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502129</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">STÈISEAN DÙMHLACHAIDH GAS</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Ionad far a bheilear a' lùghdachadh tomhas gas nàdarra airson 's gum bi e nas fhasa a sgaoileadh tron t-Siostam Tar-chuir Nàiseanta. Gabhaidh am briathar seo a chleachdadh cuideachd air stèisean a dhùmhlaicheas an gas a-rithist airson 's gum bi e aig brùthadh a tha iomchaidh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">GAS COMPRESSOR STATION</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-15T08:53:29</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-15T08:53:44</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502130" />
				<skos:scopeNote xml:lang="en">A facility where natural gas is made smaller in volume, to facilitate its distribution through the National Transmission System. Term can also be used for a station, which recompresses the gas to the required pressure.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:scopeNote xml:lang="en">Buildings and structures associated with the processing and storage of natural gas.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502131">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502131</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TÙR-GEATA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Tùr sa bheil geata 's a chaidh a thogail ann am balla baile, caisteil no daingneachaidh mar sin.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GATE TOWER</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-15T08:56:25</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-15T09:02:54</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/328" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/331" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500574" />
		<skos:scopeNote xml:lang="en">A tower, containing a gate, built into the walls of a town, castle or similar fortification.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502132">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502132</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">ÀTH-THÌORAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach no seòmar ann an sìol-lann far an robhar a' tiormachadh sìol. Gu math tric bha seo na àmhainn le ùrlar de bhreigean teas-fhulangach os a cionn air an deach an sìol a chur.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GRAIN DRIER</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-15T09:06:39</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-15T09:07:22</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/9" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/504361" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/81" />
		<skos:scopeNote xml:lang="en">A building or room within a granary used to dry grain. Often consisting of an oven with a refractory-brick drying floor above, on which the grain was placed.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502143">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502143</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">STÈISEAN DEALAN-UISGE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Gintinn cumhachd le bhith a' sgaoileadh uisge a chaidh a stòradh tro thurbain a tha ag obrachadh gineadair.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HYDROELECTRIC POWER STATION</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-15T09:32:56</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-15T09:33:09</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501688" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1226" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1249" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500673" />
		<skos:scopeNote xml:lang="en">Power generation by releasing stored water through a turbine driving a generator.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
