	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk003151">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en-US">aerial lift</skos:prefLabel>
		<skos:altLabel xml:lang="en-US">aerial lifts</skos:altLabel>
		<skos:prefLabel xml:lang="en-UK">cable car</skos:prefLabel>
		<skos:altLabel xml:lang="en-UK">cable cars</skos:altLabel>
		<skos:prefLabel xml:lang="de">Luftseilbahn</skos:prefLabel>
		<skos:altLabel xml:lang="de">Luftseilbahnen</skos:altLabel>
		<skos:altLabel xml:lang="de">Seilschwebebahn</skos:altLabel>
		<skos:altLabel xml:lang="de">Seilschwebebahnen</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003150"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk003754"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019698"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk003150"/>
		<skos:definition xml:lang="de">Eine Luftseilbahn ist eine Seilbahn, bei der die Fahrbetriebsmittel an einem beweglichen tragenden Element hängen, das heißt an einem oder mehreren Seilen in der Luft bewegt werden. Eine Pendelbewegung ist in alle Richtungen möglich. Die Mehrzahl an Luftseilbahnen sind Pendelbahnen oder Umlaufbahnen.</skos:definition>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300250956"/>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4180750-9"/>
		<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q13409250"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003150"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003754"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019698"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003385"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
