        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-25T15:08:54.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T11:58:37.000</terms:modified>
        <skos:altLabel xml:lang="de">Odeion</skos:altLabel>
        <skos:altLabel xml:lang="de">Odeon</skos:altLabel>
        <skos:definition xml:lang="de">Konzerthaus v. a. der gr. und röm. Antike. In der Grundanlage dem röm. Theater verwandt, jedoch manchmal ganz oder teilweise überdeckt. Im 19. Jh. in Anspielung auf das gr. Theater Bezeichnung für einen Konzertsaal. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="es"> odeón</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Odeum</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">odeon</skos:prefLabel>
    </owl:NamedIndividual>
    


