<http://purl.org/heritagedata/schemes/38076/concepts/10200> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/38076/concepts/1020> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/38076> ;
