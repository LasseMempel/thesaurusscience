	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1184">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1184</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">MÈINN CLACH-OLA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite far an robhar a' cladhach gus ola cloiche-guail a lorg no a tharraing às. Bhathar a' dùsgadh ola cloiche-guail ann an Alba, gu h-àraid ann an Lodainn an Iar, o mheadhan na 19mh linn gu toiseach ann 1960an.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SHALE OIL MINE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">SHALE PIT</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1170" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1280" />
		<skos:scopeNote xml:lang="en">An excavation made in order to locate or extract oil-shale. Oil-shale was mined in Scotland, especially in West Lothian, from the mid-19th century to the early 1960s.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1186">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1186</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">MÈINN STAOIN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far a bheil acainnean is structaran airson tiona a tharraing à clach-mhèinnir.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TIN MINE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
