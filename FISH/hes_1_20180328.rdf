	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/170">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/170</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">DAOR-THAIGH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Prìosan far a bheilear a' cumail an greim daoine fad greis. Bhiodh glas-thaigh àbhaisteach ann am baile beag na thogalach le aon ùrlar agus aon chealla, uaireannan cruinn no ioma-cheàrnach.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">LOCK UP</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/167" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/169" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/201" />
		<skos:scopeNote xml:lang="en">A prison used for temporary detention. The typical village lock-up was a one-storeyed, one-celled building, sometimes of round or polygonal plan.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/171">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/171</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">ÀITE-PEANAIS</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite far an robhar a' cur an gnìomh peanasan corporra is mòr-chiontach.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PUNISHMENT PLACE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/161" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/173" />
