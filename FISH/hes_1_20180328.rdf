		<skos:prefLabel xml:lang="gd">TAIGH-TALLA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Taigh sa bheil talla poblach agus le àite-fuirich prìobhaideach ris. Chaidh an togail a-mach o na meadhan-aoisean.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HALL HOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/422" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/468" />
		<skos:scopeNote xml:lang="en">A house consisting of a public hall with private living accommodation attached. Built from the medieval period onwards.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
