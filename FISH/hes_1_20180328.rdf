		<skos:prefLabel xml:lang="gd">GÀRRADH TOGAIL-BHÀTAICHEAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite far a bheilear a' togail, a' càradh is a' stòradh bàtaichean.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BOAT YARD</skos:prefLabel>
