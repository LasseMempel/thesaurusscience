        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/69> ;
    skos:scopeNote "Type of arranging inscription texts, according to which the direction of the letters follows a path alternately from left to right and from right to left, imitating the course followed by a pair of oxen in plowing a field."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/845> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/391> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "International law"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2516>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2517> ;
    skos:scopeNote "The system of international rules and standards that deal with the relationships between sovereign states and organizations internationally recognized as legal entities. The modern concept of international law emerged in Europe during the early modern period and was gradually developed and established throughout the whole planet."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/854> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/491> ;
