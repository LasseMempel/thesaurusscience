    <!-- https://hist-arch-vocab.org/bvha#c_1d45568a -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_1d45568a">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_fe387ba0"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_6b36b369"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_d2b7a17b"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-05T12:07:00.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T16:16:22.000</terms:modified>
        <skos:altLabel xml:lang="de">römisch-katholische Kirche</skos:altLabel>
        <skos:definition xml:lang="de">Katholische Kirche f; präzis, römisch-katholische die unter des Leitung des Papstes als des Nachfolgers des Urapostels Petrus stehende Kirche. Vor allem die abendländische Kirche, bzw. Westkirche, nach ihrer Trennung von der Ostkirche (1054) und die kath. Kirche nach der Trennung von den prot. Kirchen im 16. Jh. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="fr">Eglise catholique romaine</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Katholische Kirche</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Roman Catholic Church</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_1d49f89c -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_1d49f89c">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
