		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk015634"/>
		<skos:definition xml:lang="de">Ein Eckpfosten ist ein Pfosten, der in einer Kante oder Ecke liegt, die durch zwei zusammenstoßende Bundwände entstanden ist.</skos:definition>
