        <skos:prefLabel xml:lang="en">ridge purlin</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_9acc8ebb -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_9acc8ebb">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_e2a5d877"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
