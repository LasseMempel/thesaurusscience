	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/459">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/459</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BOTHAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach gu math bunasach, mar is trice nas lugha na taigh agus air a thogail de dhiofar rudan, a' gabhail a-steach criadha, sgrath, geugan, fiodh, bricean, concrait no meatailt. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HUT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">BEEHIVE HUT</skos:altLabel>
		<skos:altLabel xml:lang="en">NORSE HUT</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/413" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/31" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/461" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/496" />
		<skos:scopeNote xml:lang="en">A building of basic construction, usually smaller in size than a house and constructed from a variety of materials such as clay, turf, branches, wood, brick, concrete or metal. Use more specific type where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/461">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/461</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CEARCALL BHOTHAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Uchdan sgratha, ùir no cloiche ìseal is cearcallach. 'S e seo iarsmadh taighe-chruinn à deireadh na linne ro-eachdraidheil.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HUT CIRCLE</skos:prefLabel>
