	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1952">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1952</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">STRUCTAR FO THALAMH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Feart fuadain a tha fo uachdar na talmhainn. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SUBTERRANEAN STRUCTURE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
