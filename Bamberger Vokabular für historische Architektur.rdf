        <skos:altLabel xml:lang="de">geistlicher Orden</skos:altLabel>
        <skos:altLabel xml:lang="de">religiöser Orden</skos:altLabel>
        <skos:definition xml:lang="de">Orden m, geistlicher; religiöser lat. ordo religiosus: von der Kirche gebilligte, dauernde Vereinigung von Gläubigen, die an die lebenslange Beachtung der drei Gelübde Armut, Keuschheit und Gehorsam gebunden sind und unter einer gemeinschaftlichen Ordensregel leben. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Orden</skos:prefLabel>
        <skos:prefLabel xml:lang="la">ordo religiosus</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">ordre religieux</skos:prefLabel>
        <skos:prefLabel xml:lang="en">religious order</skos:prefLabel>
    </owl:NamedIndividual>
    


