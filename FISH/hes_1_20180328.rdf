				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/98" />
				<skos:scopeNote xml:lang="en">A stone-walled enclosure primarily for growing kale, often characterised by a build-up of soil in the interior.</skos:scopeNote>
