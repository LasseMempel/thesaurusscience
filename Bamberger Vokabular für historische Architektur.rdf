        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-14T12:18:29.000</terms:modified>
        <skos:altLabel xml:lang="fr">arc de fenêtre</skos:altLabel>
        <skos:definition xml:lang="de">1. der obere Abschluss eines Bogenfensters. 2. An der Außenwand über einem Fenster angeordneter, vorspringender Bogen (Fensterverdachung). 3. Entlastungsbogen in der Mauer über dem Fenstersturz. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Aus Wölbsteinen gemauerte Überdeckung einer Fensteröffnung. Man unterscheidet den äußeren Fensterbogen und den inneren Fensterbogen bzw. Leibungsbogen, zwischen denen der Anschlag liegt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Fensterbogen</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voussure</skos:prefLabel>
        <skos:prefLabel xml:lang="en">window arch</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_eea5235b"/>
    </owl:NamedIndividual>
    


