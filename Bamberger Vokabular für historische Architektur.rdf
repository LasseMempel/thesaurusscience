        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_37f74dbd"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_2fce538c"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_baad22f3"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-12T16:09:14.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:51:30.000</terms:modified>
        <skos:altLabel xml:lang="de">Kragsteingewölbe</skos:altLabel>
        <skos:altLabel xml:lang="de">Kragwölbung</skos:altLabel>
        <skos:altLabel xml:lang="en">corbeled vault</skos:altLabel>
        <skos:altLabel xml:lang="fr">voûte en encorbellement</skos:altLabel>
        <skos:definition xml:lang="de">Ein aus Kragsteinen errichtetes Scheingewölbe. Da die Aufstandsflächen horizontal sind, entsteht kein Seitenschub. Teilweise werden die Steine verzahnt oder erhalten einen Aufguss von Zement. Der Gewölbescheitel wird durch Auflage eines Kragsturzes abgesichert. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Kraggewölbe</skos:prefLabel>
        <skos:prefLabel xml:lang="en">corbel vault</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte en tas-de-charge</skos:prefLabel>
        <broaderByConstruction rdf:resource="https://hist-arch-vocab.org/bvha#c_053d8697"/>
    </owl:NamedIndividual>
    


