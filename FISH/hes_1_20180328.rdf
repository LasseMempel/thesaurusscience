	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1400">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1400</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CIDHE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar a tha coltach ri ceidhe no làimhrig aig beul calaidh no a tha a' stobadh a-mach air loch-mara gus an cala no an costa a dhìon.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">JETTY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1399" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1869" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1390" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1401" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1404" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1405" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1406" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1433" />
		<skos:scopeNote xml:lang="en">A mole or pier-like structure situated at the entrance of a harbour, or running out into a lake of the sea, so as to defend the harbour or coast.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1401">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1401</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CIDHE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Ùrlar, uaireannan fear air fleòd, airson tìreachadh luchd-siubhail is bathair o shoithichean.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">LANDING STAGE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1869" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1399" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1391" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1400" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1404" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1405" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1406" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/508082" />
		<skos:scopeNote xml:lang="en">A platform, sometimes floating, for the landing of passengers and goods from vessels.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1404">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1404</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CIDHE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar, gu math tric de dh'iarann no fiodh, a tha fosgailte foidhe, a' stobadh a-mach air a' mhuir 's ga chleachdadh mar àite-spaistireachd is làimhrig.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PIER</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-05-18T14:21:58</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1399" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1400" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1401" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1405" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1406" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/509182" />
		<skos:scopeNote xml:lang="en">A structure, often of iron or wood, open below, running out into the sea and used as a promenade and landing stage. Please use PLEASURE PIER for piers used as a promenade and amusement park.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1405">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1405</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CIDHE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Uchdan leacaichte no làimhrig chruaidh a chaidh a thogail co-sìnte ris a' chladach no bruach aibhne (no a' stobadh a-mach uaithe) gus luchdan a thoirt far shoithichean is luchdadh a chur orra.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">QUAY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1869" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1399" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1400" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1401" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1404" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1406" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/508082" />
		<skos:scopeNote xml:lang="en">An artificial paved bank or solid landing place built parallel to, or projecting out from, a shoreline or riverbank to serve in the loading and unloading of vessels.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1406">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1406</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CIDHE-BATHAIR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar mòr fiodha a chaidh a thogail ri taobh an uisge far am bi longan air acarsaid gus na luchdan thoirt uapa.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">WHARF</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1399" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1869" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502095" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1387" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1400" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1401" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1404" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1405" />
		<skos:scopeNote xml:lang="en">A large wooden structure built alongside the water's edge, where ships may lie for unloading.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
