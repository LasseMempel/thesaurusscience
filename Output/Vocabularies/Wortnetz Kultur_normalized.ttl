    skos:broader <http://lvr.vocnet.org/wnk/wk004631> ;
    skos:closeMatch <http://d-nb.info/gnd/4000030-8>,
        <http://vocab.getty.edu/aat/300263522> ;
    skos:definition "Ein Abakus ist ein Rechengerät, auf dem mit Hilfe von Rechensteinen oder Kugeln, die auf einer Führung innerhalb eines Rahmens bewegt werden, die vier Grundrechenarten sowie teilweise das Ziehen von Wurzeln ausgeführt werden, wobei der Wert der Rechensteine durch ihre Lage bestimmt wird."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Abakus (Rechengerät)"@de,
        "abacus (calculator)"@en .

<http://lvr.vocnet.org/wnk/wk004635> a skos:Concept ;
    skos:altLabel "pen holders"@en,
        "penholder"@en,
        "penholders"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk004633> ;
    skos:definition "Ein Federhalter ist ein stiftartiges, stabförmiges Gerät, dessen vorderes Ende gestaltet ist, um eine austauschbare Federspitze aufzunehmen. Der Halter besteht meist aus Holz, Kunststoff oder auch Metall und dient dazu Schreib-, Zeichen- oder Schneidefedern zu führen. Im Gegensatz zum Füllfederhalter hat der Federhalter keine integrierte Tintenquelle, sondern die Federspitze muss immer wieder in Tinte getaucht werden, um damit schreiben oder zeichnen zu können."@de ;
    skos:exactMatch <http://vocab.getty.edu/aat/300411361> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Federhalter"@de,
        "pen holder"@en .

