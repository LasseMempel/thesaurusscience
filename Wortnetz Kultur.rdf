		<skos:altLabel xml:lang="en">sheath dresses</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk005834"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk005834"/>
		<skos:definition xml:lang="de">Ein Etuikleid ist ein eng anliegendes, gerade geschnittenes Kleid. Etuikleider enden in der Regel knapp oberhalb oder unterhalb des Knies. Meistens sind sie ärmellos oder besitzen sehr kurzen Ärmel. Der Ausschnitt eines Etuikleids kann variieren, ist aber oft höher geschnitten. Rundhalsausschnitte oder der V-Ausschnitt sind häufig.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300211788"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q15008044"/>
