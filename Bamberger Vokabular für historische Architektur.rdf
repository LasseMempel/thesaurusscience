        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-14T16:17:11.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T15:42:54.000</terms:modified>
        <skos:altLabel xml:lang="en">City</skos:altLabel>
        <skos:altLabel xml:lang="fr">centre-ville</skos:altLabel>
        <skos:definition xml:lang="de"> City (engl.), vom Namen der Innenstadt Londons abgeleitete Bezeichnung für den Stadtkern, bes. bei Ballung von Geschäfts- und Verwaltungsfunktionen. [Koepf / Binding 2016] </skos:definition>
        <skos:definition xml:lang="de">Innenstadt, Zentrum einer Stadt. Der S. ist bei europ. Städten meist der ehemals von Mauern, Gräben und Wällen umgebene Teil (Altstadt), im weiteren Sinne des Worts auch das Zentrum mit den Hauptgeschäftsstraßen und öffentl.Gebäuden (City) im Gegensatz zu den Außenbezirken bzw. Vorstädten. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Stadtkern</skos:prefLabel>
        <skos:prefLabel xml:lang="it">centro (della città)</skos:prefLabel>
        <skos:prefLabel xml:lang="es">centro urbano</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">centrum města, městské jádro</skos:prefLabel>
        <skos:prefLabel xml:lang="en-us">city center</skos:prefLabel>
        <skos:prefLabel xml:lang="en">city centre</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">noyau urbain</skos:prefLabel>
    </owl:NamedIndividual>
    


