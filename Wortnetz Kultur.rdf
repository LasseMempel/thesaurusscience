		<skos:prefLabel xml:lang="de">Jackett</skos:prefLabel>
		<skos:altLabel xml:lang="de">Jacketts</skos:altLabel>
		<skos:prefLabel xml:lang="en">lounge jacket</skos:prefLabel>
		<skos:altLabel xml:lang="de">Sakko</skos:altLabel>
		<skos:altLabel xml:lang="de">Sakkos</skos:altLabel>
		<skos:altLabel xml:lang="en">sport coat</skos:altLabel>
		<skos:altLabel xml:lang="en">suit jacket</skos:altLabel>
