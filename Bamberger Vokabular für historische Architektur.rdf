        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-21T16:59:06.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-18T15:09:31.000</terms:modified>
        <skos:altLabel xml:lang="en">rampart</skos:altLabel>
        <skos:definition xml:lang="de">Vorgeschobenes Verteidigungswerk auch der Raum zwischen innerem Flügeltor und äußerem Fallgatter bei röm. Kammertoren. Im MA Fanghof (Torzwinger). [Koepf/Binding 2016]</skos:definition>
