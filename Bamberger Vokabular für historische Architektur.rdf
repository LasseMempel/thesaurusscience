        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-01T11:02:10.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T19:23:57.000</terms:modified>
        <skos:altLabel xml:lang="de">Balkenrostgründungen</skos:altLabel>
        <skos:definition xml:lang="de">Balkenrost, sich überkreuzende Balken als Unterlage für Fundamentmauern auf sumpfigem oder nicht ausreichend tragfähigem Boden; unter Luftabschluss haltbar. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Sie kamen zur Ausführung bei kleineren Gebäuden mit geringer Belastung. Als einfaches Balkenrost oder doppeltes Bohlenrost. [Bargmann]</skos:definition>
        <skos:prefLabel xml:lang="de">Bohlenrostgründung</skos:prefLabel>
    </owl:NamedIndividual>
    


