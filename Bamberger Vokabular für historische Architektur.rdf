        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-28T20:15:58.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T17:10:35.000</terms:modified>
        <skos:definition xml:lang="de">Fünf freudenreiche Geheimnisse n pl: die erste Abteilung des Rosenkranzes. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Fünf freudenreiche Geheimnisse</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">cinq mystères joyeux</skos:prefLabel>
        <skos:prefLabel xml:lang="en">five joyful mysteries</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Die fünf freudenreichen Geheimnisse sind: Verkündigung, Heimsuchung, Geburt Christi, Mariae Reinigung/ Darstellung im Tempel und Wiederfinden des Jesusknaben im Tempel. [Glossarium Artis]</skos:scopeNote>
    </owl:NamedIndividual>
    


