        <skos:altLabel xml:lang="de">Ankerbaum</skos:altLabel>
        <skos:altLabel xml:lang="de">Ankerbinder</skos:altLabel>
        <skos:altLabel xml:lang="de">Zugbalken</skos:altLabel>
        <skos:altLabel xml:lang="de">Zugstange</skos:altLabel>
        <skos:altLabel xml:lang="en">anchor bolt</skos:altLabel>
        <skos:altLabel xml:lang="it">catena</skos:altLabel>
        <skos:altLabel xml:lang="en">tension tie</skos:altLabel>
        <skos:altLabel xml:lang="en">tie rod</skos:altLabel>
        <skos:altLabel xml:lang="en">timber bar</skos:altLabel>
        <skos:altLabel xml:lang="cs">táhlo</skos:altLabel>
        <skos:definition xml:lang="de">Ein oft von Wand zu Wand reichender stabförmiger Anker aus Eisen oder Holz zur Absicherung des Gewölbes gegen den Seitenschub. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Zuganker, ein meist eiserner Anker, der Zugspannungen aufzunehmen hat; aus Holz: Ankerbalken. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Zuganker</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">tahová kotva</skos:prefLabel>
        <skos:prefLabel xml:lang="en">tie bar</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">tirant</skos:prefLabel>
        <skos:prefLabel xml:lang="es">tirante</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_ddd5c3cc -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_ddd5c3cc">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a36fd146"/>
