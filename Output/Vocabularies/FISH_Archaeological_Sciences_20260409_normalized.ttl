@prefix dct: <http://purl.org/dc/terms/> .
@prefix ns1: <http://creativecommons.org/ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://purl.org/heritagedata/schemes/560/concepts/142099> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142171> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Altered By Animals"@en ;
    skos:scopeNote "Modified or damaged by an animal."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142100> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142128> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Amino Acid Racemisation"@en ;
    skos:scopeNote "The measurement of chemical alterations in the amino acids in protein molecules from bones, shells and teeth. Date range can be between 1,000 and several million years."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142101> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142119> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Ancient Biomolecular Analysis"@en ;
    skos:scopeNote "Characterisation of organic molecules extracted from fossil or sub-fossil materials, including lipids, DNA etc."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142102> a skos:Concept ;
    skos:altLabel "Waterlogged"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142171> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Anoxic"@en ;
    skos:scopeNote "Material preserved by the exclusion of oxygen usually due to saturation with water which inhibits decay by micro-organisms."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142103> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Antler"@en ;
    skos:scopeNote "Outgrowths of bone borne by most members of the deer family (Cervidae). They are shed and re-grow each year."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142104> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142128> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Archaeomagnetism"@en ;
    skos:scopeNote "Measures the remanent magnetisation direction of magnetic minerals. Useful for dating fired structures, in-situ since their last firing, and for sediments settling from non turbulent water bodies. In the UK, calibration data extends back to 1000BC."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142106> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142197> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Available Phosphorus Analysis"@en ;
    skos:scopeNote "The analysis of the amount of phosphorus (P) (liable fraction) available to plants."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142107> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142128> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Biostratigraphy"@en ;
    skos:scopeNote "A technique in which the date is deduced from the presence of fauna and/or flora considered to be characteristic of a given peirod of time or that gives and indication of a probable date."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142108> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142162> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Block Lifting"@en ;
    skos:scopeNote "The removal of fragile or complex remains from an investigation as a block of earth for excavation under laboratory conditions. Typical examples are grave goods and cremation burials."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142109> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Bone"@en ;
    skos:scopeNote "Any of the pieces of hard tissue consisting largely of calcium phosphate that make up the skeleton of a vertebrate animal."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142113> a skos:Concept ;
    skos:altLabel "Cremated"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142111> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Calcined"@en ;
    skos:scopeNote "Material burnt at high temperature (above 700 degrees Celsius) leaving only the mineral component."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142120> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142171> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Chemically Altered"@en ;
    skos:scopeNote "Material that has been altered as a result of chemical action."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142121> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142182> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Clast Lithological Analysis"@en ;
    skos:scopeNote "The identification and grouping of stone types in stratigraphy."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142122> a skos:Concept ;
    skos:altLabel "Bulk Sampling"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142162> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Coarse Sieving"@en ;
    skos:scopeNote "The method of retrieving animal remains, artefacts and other remains by dry or wet-sieving whole earth samples, typically over 100 litres, sieved through a 2mm or larger mesh."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142124> a skos:Concept ;
    skos:altLabel "Colored"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142215> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Coloured"@en ;
    skos:scopeNote "Material with evidence of the application of a pigment or dye."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142125> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142174> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Copper Alloy"@en ;
    skos:scopeNote "Use for a combination (alloy) of two or more different metals where copper (Cu) is the principal component."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142126> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Coprolite"@en ;
    skos:scopeNote "Waste material from the digestive tract of animals. The term coprolite comes from the Greek 'kopros' meaning dung and 'lithos' meaning stone, and is used for faecal matter that has been preserved by mineral replacement or dessication."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142129> a skos:Concept ;
    skos:altLabel "Decoration"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142215> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Decorated"@en ;
    skos:scopeNote "Use where decoration is present."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142131> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142128> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Dendrochronology"@en ;
    skos:scopeNote "The measuring of annual tree-ring growth shown by most tree species in temperated regions. Regional chronoliges are required to date any particular piece of wood, the longest of which, for Germany, works for the present to approximately 14,000 yrs ago."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142132> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142171> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Desiccated"@en ;
    skos:scopeNote "Material preserved due to very low humidity which inhibits decay by micro-organisms."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142135> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Egg Shell"@en ;
    skos:scopeNote "Use for the remains of an egg whether from a bird, reptile or amphibian."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142136> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142128> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Electron Spin Resonance"@en ;
    skos:scopeNote "The measurement of trapped electrons by exposure to high-frequency electromagnetic radiation. A useful technique for dating tooth enamel, shells, coral and calcite form 5,000-1,000,000 years old."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142137> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Feather"@en ;
    skos:scopeNote "Use for feathers, an epidermal growth found in birds consisting of a quill, shaft and two vanes of barbs."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142138> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142161> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Ferrous Metal"@en ;
    skos:scopeNote "Any metal prinicipally composed of the chemical element Iron (Fe)."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142139> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Fibre"@en ;
    skos:scopeNote "Use for any thread-like material."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142140> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142128> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Fission Track Analysis"@en ;
    skos:scopeNote "A technique for the dating of damage tracks in volcanic materials caused by the fissioning of decaying radioactive uranium (U) isotopes. Useful in samples more than 50,000 years old."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142141> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142162> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Flotation"@en ;
    skos:scopeNote "Method used for the recovering of material by floating large whole earth samples, usually between 40-60 litres per context (or 100% if context contains less than this)."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142142> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142128> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Fluorine, Uranium And Nitrogen Tests"@en ;
    skos:scopeNote "A relative dating technique for assessing bones from the same deposit. Often used to check for contemporaneity of bones selected for radiocarbon dating or to check for hoaxes such as the Piltdown Man."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142144> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142171> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Fungal Damage"@en ;
    skos:scopeNote "Material that has been damaged by fungal growth or secretions."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142145> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142174> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Gold"@en ;
    skos:scopeNote "A precious metal characterised by its yellow colour and resistance to tarnishing."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142146> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Hair"@en ;
    skos:scopeNote "Use for hair, fur etc: filaments growing out of the outermost layer of mammalian skin."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142147> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142162> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Hand Retrieval"@en ;
    skos:scopeNote "The retrieval of material from deposits by hand, normally large objects visible with the naked eye, eg. Mammal remains and marine molluscs."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142149> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142171> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Hydrolysis"@en ;
    skos:scopeNote "The chemical breakdown of a material by water."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142150> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142171> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Impression"@en ;
    skos:scopeNote "The negative trace left by an object type or material (eg. animal, plant or textile) on another object type or material, often on ceramics or metal corrosion products."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142151> a skos:Concept ;
    skos:altLabel "IRSL"@en,
        "IRSL Dating"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/144511> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Infra-Red Stimulated Luminescence"@en ;
    skos:scopeNote "The light emitted from sedimentary minerals or mineral inclusions in bricks when stimulated in the laboratory by infrared light. Used to date samples up to 250,000 years old; especially appropriate for geological sediments containing feldspars"@en .

<http://purl.org/heritagedata/schemes/560/concepts/142152> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142197> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Inorganic Phosphorus Analysis"@en ;
    skos:scopeNote "The analysis of inorganic phosphorus (P)."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142154> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142207> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Ivory"@en ;
    skos:scopeNote "Use for a tusk or tooth of a mammal large enough to be carved or used to make objects such as those of mammoths, elephants, walruses and whales."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142155> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142128> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Lead Isotope Dating"@en ;
    skos:scopeNote "A technique which uses the measurement of decay in radioactive lead (Pb) isotopes to determine a date. Useful for sediments and lead-based paints between 1 and 400 years old."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142156> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Leather"@en ;
    skos:scopeNote "Animal skin that has been tanned or tawed."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142157> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142182> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Loss On Ignition Determination"@en ;
    skos:scopeNote "The weight loss from low-temperature burning of material. It correlates well with organic matter (material derived from living things) content."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142158> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142182> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Magnetic Susceptibility"@en ;
    skos:scopeNote "The degree to which a material will become magnetised when placed in a magnetic field."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142159> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142148> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Manufacturing Debris"@en ;
    skos:scopeNote "Use where the material presents debris or waste from manufacturing."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142164> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142182> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Micromorphology"@en ;
    skos:scopeNote "The microscopic analysis of thin sections of resin impregnated stratigraphy."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142166> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142171> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Mineral Preserved"@en ;
    skos:scopeNote "Preservation of material by toxic effect of corrosion products in the immediate vicinity, or within, the material."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142167> a skos:Concept ;
    skos:altLabel "Fossilised"@en,
        "Mineralised"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142171> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Mineral Replaced"@en ;
    skos:scopeNote "Replacement of organic material by minerals, including calcium carbonate and calcium phosphate."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142169> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142182> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Mineralogy"@en ;
    skos:scopeNote "The study of minerals."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142170> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142128> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Mitochondrial Dna Dating"@en ;
    skos:scopeNote "A dating technique for the founding of individual populations based on the assumption of steady rates of mutation in mitochondrial DNA. Sometimes used to produce dates for stratigraphic layers containing fossil specimens of populations."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142175> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142173> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Non-Metric Traits"@en ;
    skos:scopeNote "Use for congenital (present at birth) abnormalities (absent/extra or morphologically unusual features) present in an individual or population."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142176> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142128> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Obsidian Hydration"@en ;
    skos:scopeNote "A technique used to date obsidian (volcanic glass) of all ages and is thus not commonly used in the UK."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142177> a skos:Concept ;
    skos:altLabel "OSL"@en,
        "OSL Dating"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/144511> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Optically Stimulated Luminescence"@en ;
    skos:scopeNote "The light emitted from sedimentary minerals or mineral inclusions in bricks when stimulated in the laboratory by light of a different wavelength. Used to date samples up to 250,000 years old; especially appropriate for geological sediments."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142178> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142128> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Oxygen Isotope Analysis"@en ;
    skos:scopeNote "The use of oxygen (O) isotope ratios in ice or ocean sediment cores to date global environmental change."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142179> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142182> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Particle Size Analysis"@en ;
    skos:scopeNote "The analysis of the distribution and proportion of sand, silt and clay in a deposit."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142180> a skos:Concept ;
    skos:altLabel "Disease"@en,
        "Diseased"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142173> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Pathology"@en ;
    skos:scopeNote "Use for bone remodelling, new growth, loss or destruction caused by age, activity, disease or trauma during life."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142181> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142119> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Ph Determination"@en ;
    skos:scopeNote "The degree of acidity or alkalinity of a material."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142183> a skos:Concept ;
    skos:altLabel "Microfossils"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Phytolith"@en ;
    skos:scopeNote "Microscopic mineral body (usually silica) found in many plants."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142184> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142171> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Plant Damage"@en ;
    skos:scopeNote "Material that has been penetrated or disrupted by the roots or rhizomes of plants."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142185> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142165> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Polarised Light Microscopy"@en ;
    skos:scopeNote "Light microscopy in which vibration directions of the light are constrained into single planes."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142186> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Pollen"@en ;
    skos:scopeNote "Use for pollen and diaspores. Pollen consists of pollen grains which are the male gametes of flowering plants. Diaspores are the dispersive units of mosses, ferns, fern allies and some plants. To describe the actual object use PLANT REMAINS."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142187> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142128> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Potassium Argon Dating"@en ;
    skos:scopeNote "The measurement of the ratio of a radioactive potassium (K) isotope and the argon (Ar) gas produced as a by-product of its decay. Useful for dating volcanic material older than 1,000 years."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142188> a skos:Concept ;
    skos:altLabel "C14 Dating"@en,
        "Carbon 14 Dating"@en,
        "Carbon Dating"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142128> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Radiocarbon Dating"@en ;
    skos:scopeNote "The measurement of the ratio of the radioactive Carbon 14 (C-14) isotope and non-radioactive carbon isotopes. Useful for dating organic materials such as wood and bone between 500 and 45,000 years old."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142189> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142214> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Roundwood"@en ;
    skos:scopeNote "Material comprising entrie or partial transverse sections of stems. Bark may be present or not. Can include complete sections of tree trunk but generally comprises smaller (<20cm diameter) material."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142191> a skos:Concept ;
    skos:altLabel "S.E.M."@en,
        "SEM"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142165> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Scanning Electron Microscopy"@en ;
    skos:scopeNote "A process using an electron microscope in which the surface of the specimen is scanned by a beam of electrons which are reflected to form an image. Very high magnification is possible."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142193> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Shell"@en ;
    skos:scopeNote "Use for any shell of an animal, principally, molluscs, crabs etc."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142194> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142111> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Silicified"@en ;
    skos:scopeNote "Use for material that has been burnt at high temperature in a good air supply such that only the silica component remains."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142195> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142174> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Silver"@en ;
    skos:scopeNote "A precious metal of lustrous, white colour with great malleability and ductility."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142196> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Skin"@en ;
    skos:scopeNote "Use for the remains of epidermis or outermost layer. Relates to both animals and plants. If describing the actual object use PLANT REMAINS, ANIMAL REMAINS or HUMAN REMAINS."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142198> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142162> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Specialist Sampling"@en ;
    skos:scopeNote "The recovery of material from samples collected during field investigations, usually taken by specialists with a particular area of expertise. Normally processed in the laboratory. Also use for the processing of samples subsequent to investigation."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142199> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142119> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Spot Test"@en ;
    skos:scopeNote "The application of a chemical test to a material, usually as a rapid approximation."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142200> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142119> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Stable Isotope Analysis"@en ;
    skos:scopeNote "Comparison of different proportions of natural occurring isotopes of lead (Pb), strontium (Sr), oxygen (O), carbon (C) and nitrogen (N)."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142201> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142182> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Stratigraphic Description"@en ;
    skos:scopeNote "The careful observation and written description of the physical characteristics of stratigraphy. It will normally include information on texture, colour and the nature of the different components."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142202> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142128> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Tephrochronology"@en ;
    skos:scopeNote "The use of ash and tephra deposits characteristic of single known-date volcanic eruptions to date stratigraphic sequences."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142203> a skos:Concept ;
    skos:altLabel "TL"@en,
        "TL Dating"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/144511> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Thermoluminescence"@en ;
    skos:scopeNote "The measurement of the light emitted from sedimentary minerals, mineral inclusions in bricks, burnt flint or unburnt calcite when they are heated. The signal relates to their prior exposure to radioactivity. Used to date samples up to 500,000 years old."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142205> a skos:Concept ;
    skos:altLabel "Tool Marks"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142215> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Tool Marked"@en ;
    skos:scopeNote "Use where evidence of tool marks is present"@en .

<http://purl.org/heritagedata/schemes/560/concepts/142208> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142197> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Total Phosphorus Analysis"@en ;
    skos:scopeNote "The analysis of organic plus inorganic phosphorus (P)."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142209> a skos:Concept ;
    skos:altLabel "Tree-Ring Studies"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142182> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Tree-Ring Analysis"@en ;
    skos:scopeNote "The use of annual incremental growth in temperate trees to investigate environmental, especially local, parameters and the history of individual trees."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142211> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142214> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Twig"@en ;
    skos:scopeNote "Small (<2cm diameter) roundwood often complete with buds or leaf scars."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142212> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142128> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Uranium Series Dating"@en ;
    skos:scopeNote "The measurement of the decay of radioactive uranium (U) isotopes. Particularly useful for dating calcite and sometimes bone, tooth and shell up to 70,000 years old."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142216> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142182> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "X-Radiography"@en ;
    skos:scopeNote "The production of an image on a photographic plate as a result of X-rays (very short wavelength electromagnetic radiation) being passed through an object."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142217> a skos:Concept ;
    skos:altLabel "XRD"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142172> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "X-Ray Diffraction"@en ;
    skos:scopeNote "A surface technique that uses the diffraction of X-rays to examine the mineral composition of a sample. Useful for identifying corrosion products, pigments etc. but of little use with organic compounds which consist largely of carbon, oxygen and hydrogen."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142218> a skos:Concept ;
    skos:altLabel "XRF"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142172> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "X-Ray Fluorescence Spectrometry"@en ;
    skos:scopeNote "A surface technique of spectroscopic analysis which relies on the interaction of primary X-rays with the sample to generate a range of secondary X-rays. These have energies characteristic of the elements present in the sample."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142977> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Estuarine Deposit"@en ;
    skos:scopeNote "An alluvial deposit laid down in an estuary."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142979> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Tufaceous Deposit"@en ;
    skos:scopeNote "A naturally occuring deposit of calcareous tufa ('shell marl') sometimes found in alluvial deposits."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142980> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Peat Deposit"@en ;
    skos:scopeNote "A naturally occurring deposit formed by the decomposition and partial carbonisation of vegetable matter in waterlogged conditions."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142981> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Beach Deposit"@en ;
    skos:scopeNote "A deposit formed by wave and tidal action on an estuarine or marine beach."@en .

<http://purl.org/heritagedata/schemes/560/concepts/144513> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142119> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Gamma Spectrometry"@en ;
    skos:scopeNote "A technique that uses the emission of gamma rays of specific energies to identify the presence and concentration of certain radioactive isotopes in a sample"@en .

<http://purl.org/heritagedata/schemes/560/concepts/144514> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142119> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Alpha Spectrometry"@en ;
    skos:scopeNote "A technique that uses the emission of alpha particles of specific energies to identify the presence and concentration of certain radioactive isotopes in a sample"@en .

<http://purl.org/heritagedata/schemes/560/concepts/144515> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Brick"@en ;
    skos:scopeNote "Material used for construction, commonly fired in its manufacture."@en .

<http://purl.org/heritagedata/schemes/560/concepts/144516> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Pottery"@en ;
    skos:scopeNote "Object produced commonly by firing clay, but can include coarser material to temper it."@en .

<http://purl.org/heritagedata/schemes/560/concepts/144517> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Burnt Flint"@en ;
    skos:scopeNote "A form of silica, similar to quartz. Commonly black or white in colour and used for tool manufacture. Flints heated in antiquity may be dated using thermoluminescence."@en .

<http://purl.org/heritagedata/schemes/560/concepts/144519> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Biogenic Carbonate"@en ;
    skos:scopeNote "Any carbonate material produced by biological activity, for instance operculae of snails."@en .

<http://purl.org/heritagedata/schemes/560/concepts/144520> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/144518> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Quartz"@en ;
    skos:scopeNote "A mineral composed of SiO2. Commonly clear or milky in appearance. A common constituent of rocks and sediments."@en .

<http://purl.org/heritagedata/schemes/560/concepts/144521> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/144518> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Feldspar"@en ;
    skos:scopeNote "A group of aluminosilicate minerals with varying compositions. The most common mineral in igneous rocks, and common in other rocks and sediments."@en .

<http://purl.org/heritagedata/schemes/560/concepts/144522> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/144518> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Zircon"@en ;
    skos:scopeNote "A mineral of the composition Zr[SiO4]. Commonly brown or yellow in colour. May contain high levels of uranium and thorium. Can be used for dating using luminescence or fission track methods."@en .

<http://purl.org/heritagedata/schemes/560/concepts/144523> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/144518> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Polymineral"@en ;
    skos:scopeNote "A general term to describe a sediment or sample that contains a variety of different minerals."@en .

<http://purl.org/heritagedata/schemes/560/concepts/147276> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142117> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Micro-Charcoal"@en ;
    skos:scopeNote "Microscopic charcoal fragments that are concentrated and counted as part of standard pollen preparation techniques."@en .

<http://purl.org/heritagedata/schemes/560/concepts/147277> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142182> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Moisture Content"@en ;
    skos:scopeNote "A measure of the proportion of water within a sample."@en .

<http://purl.org/heritagedata/schemes/560/concepts/147278> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142119> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Peat Humification"@en ;
    skos:scopeNote "A method of determining peat degradation; quantified as the percentage light transmission value of the extracted humic acids, measured at a specific wavelength."@en .

<http://purl.org/heritagedata/schemes/560/concepts/148327> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142215> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Carved"@en .

<http://purl.org/heritagedata/schemes/560/concepts/148328> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142171> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Waterworn"@en ;
    skos:scopeNote "Material, especially rock, worn smooth by the passage of water."@en .

<http://purl.org/heritagedata/schemes/560/concepts/148433> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Flot"@en ;
    skos:scopeNote "The material which floats during the floatation of samples as a means of recovering charred plant remains from an archaeological context."@en .

<http://purl.org/heritagedata/schemes/560/concepts/148434> a skos:Concept ;
    skos:altLabel "Heavy Residue"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Residue"@en ;
    skos:scopeNote "The material that does not float during the floatation of samples as a means of recovering charred plant remains from an archaeological context. Also, the material remaining following wet or dry sieving of course sieved samples."@en .

<http://purl.org/heritagedata/schemes/560/concepts/170612> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142182> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Palynology"@en ;
    skos:scopeNote "The study of pollen and non-pollen palyomorphs preserved within deposits, including peat."@en .

<http://purl.org/heritagedata/schemes/560/concepts/170613> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142182> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Palaeoenvironmental Analysis"@en ;
    skos:scopeNote "The study of biological remains preserved within  deposits, including peat."@en .

<http://purl.org/heritagedata/schemes/560/concepts/170614> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142182> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Diatom Analysis"@en ;
    skos:scopeNote "The study of diatoms preserved in deposits."@en .

<http://purl.org/heritagedata/schemes/560/concepts/170615> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142182> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Archaeomalacology"@en ;
    skos:scopeNote "The study of mollusca remains preserved within archaeological deposits and palaeoenvironmental archives."@en .

<http://purl.org/heritagedata/schemes/560/concepts/170616> a skos:Concept ;
    skos:altLabel "Archaeozoology"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142182> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Zooarchaeology"@en ;
    skos:scopeNote "The study of vertebrate remains, excluding human remains, preserved within archaeological deposits and palaeoenvironmental archives. Use archaeomalacology for the study of mollus remains and palaeoentomology for the study of insect remains."@en .

<http://purl.org/heritagedata/schemes/560/concepts/170618> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142182> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Archaeobotany"@en ;
    skos:scopeNote "The study of plant remains, typically seeds, fruits, wood, leaves etc, preserved within archaeological deposits and palaeoenvironmental archives. Use palynology when pollen and spores are being analysed as opposed to macroscopic plant remains."@en .

<http://purl.org/heritagedata/schemes/560/concepts/170619> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142182> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Foraminifera Analysis"@en ;
    skos:scopeNote "The study of foraminifera preserved in deposits."@en .

<http://purl.org/heritagedata/schemes/560/concepts/170620> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142182> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Palaeoentomology"@en ;
    skos:scopeNote "The study of insect remains preserved within archaeological deposits and palaeoenvironmental archives."@en .

<http://purl.org/heritagedata/schemes/560/concepts/170621> a skos:Concept ;
    skos:altLabel "Bioarchaeology"@en,
        "Osteoarchaeology"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142182> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Human Osteology"@en ;
    skos:scopeNote "The study of human remains preserved within archaeological deposits and palaeoenvironmental archives."@en .

<http://purl.org/heritagedata/schemes/560/concepts/170642> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Slag"@en ;
    skos:scopeNote "A by-product usually from the smelting process."@en .

<http://purl.org/heritagedata/schemes/560/concepts/170670> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142182> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Mortar Analysis"@en ;
    skos:scopeNote "Sampling and analysis of historic mortars to determine mortar composition. For radiocarbon dating of organic traces within the mortar (relict mortar fuel), use Radiocarbon Dating."@en .

<http://purl.org/heritagedata/schemes/560/concepts/170671> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142182> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Archaeometallurgy"@en ;
    skos:scopeNote "The the study of metalworking structures, tools, waste products and finished metal artefacts, from the Bronze Age to the recent past. It can be used in the field and in post excavation to identify and interpret metalworking structures, tools, waste etc."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171000> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Plant Macrofossil"@en ;
    skos:scopeNote "Use for seeds, fruits, buds etc. To describe the actual object use Plant Remains"@en .

<http://purl.org/heritagedata/schemes/560/concepts/171004> a skos:Concept ;
    skos:altLabel "Pets"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171002> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Companion Animals"@en ;
    skos:scopeNote "Use for presence of animals interpreted as being kept primarily as companions or for social display rather than as working animals. May include domestic or wild species. Evidence might include depositional context."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171006> a skos:Concept ;
    skos:altLabel "Draught Animals"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171002> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Traction Animals"@en ;
    skos:scopeNote "Use for presence of animals interpreted as having been used to for traction such as pulling ploughs, carts, carriages or canal boats, or powering mills. Evidence may include species, pathology, archaeological context or material culture."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171010> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171002> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Guard Animals"@en ;
    skos:scopeNote "Use for presence of animals interpreted as performing a guarding function for example, sheep dogs or guard dogs, geese. May be based on  morphological characteristics, archaeological context or material culture."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171011> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171002> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Pack Animals"@en ;
    skos:scopeNote "Use for presence of animals interpreted as having been used to carry loads, for example equids. May be based on species and pathological evidence, or material culture."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171012> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171002> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Riding Animals"@en ;
    skos:scopeNote "Use for the presence of animals interpreted as having been ridden e.g. horses with pathology or associated with riding paraphernalia."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171014> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171013> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Caulking"@en ;
    skos:scopeNote "Use where the presence of mosses, plant or animal fibres is interpreted as caulking material (including oakum, specifally hemp or flax fibres), used to fill gaps between timbers, particularly on ships (Cappers et al 2000), especially from in situ contexts or if coated or impregnated with tar or pitch."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171015> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171013> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Cereal Thatchng"@en .

<http://purl.org/heritagedata/schemes/560/concepts/171016> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171013> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Non-Cereal Thatching"@en ;
    skos:scopeNote "Use where there  heather, turfs or reeds are present and where other proxies or the context suggest the presence of roofing material."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171017> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171013> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Packing Material"@en ;
    skos:scopeNote "Use where plant material is present in a container (context) or associated with artefacts that suggest it was used as packing."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171018> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171013> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Turves"@en ;
    skos:scopeNote "Use where indicators of turves are present, including the roots and basal plants of grasses and/ or heathers, Cenococcum sclerotia, and earthworm egg capsules  (Hall 2003)."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171019> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171013> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Structural Timber"@en ;
    skos:scopeNote "Evidence for the presence of structural timber. Can include possible re-use as fuel. This interpreatation might be put forward where there is evidence of working and insect infestation."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171021> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171020> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Basketry"@en ;
    skos:scopeNote "Use where there is visible indicators of woven plant material indicative of basketry (including matting)."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171022> a skos:Concept ;
    skos:altLabel "Antler Working"@en,
        "Horn Working"@en,
        "Tooth Working"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171020> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Bone Working"@en ;
    skos:scopeNote "Use for evidence of working of bone, antler, horn or tooth including waste."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171027> a skos:Concept ;
    skos:altLabel "Tawning"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171026> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Tanning"@en .

<http://purl.org/heritagedata/schemes/560/concepts/171028> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171020> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Textile Production"@en ;
    skos:scopeNote "Use where textile production is indicated e.g. by presence of dye plants, stems or bast fibres of textile plants, or animal fibres. May be evidenced through artefacts or archaeological features."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171031> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171030> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Kitchen Waste"@en ;
    skos:scopeNote "Use where remains suggest discard during the preparation of food. Evidence might include animal species, butchery mark and skeletal representation profiles, and/or archaeological context."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171032> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171030> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Stable Waste"@en ;
    skos:scopeNote "Use where there is evidence for a mixture of animal bedding and dung."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171033> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171030> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Structured Deposition"@en ;
    skos:scopeNote "Use where remains, including Associated Bone Groups (ABGs), in their own right, or in association with other remains indicate carefully considered placement, suggesting the act of depositing the material held significance to those involved. Use for deliberate deposits in sacred spaces."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171034> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171030> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Table Waste"@en ;
    skos:scopeNote "Use where remains suggest discard following consumption rather than during the preparation of food. Evidence might include animal species, butchery mark and skeletal representation profiles, and/or archaeological context."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171036> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171035> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Dairying"@en ;
    skos:scopeNote "Use where remains suggest husbandry of mammals for milk production. Evidence may include species and age profiles in bone assemblage or material culture including its chemical analysis."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171037> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171035> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Egg Production"@en ;
    skos:scopeNote "Use where remains suggest husbandry of birds for egg production. Evidence may include eggshell from domestic species, or sex profile of domestic bird bone assemblage."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171038> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171035> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Fodder Production"@en ;
    skos:scopeNote "Use where there is clear evidence for the production of fodder. Use hay where this is indicated and stable waste where the remains of animal bedding and animal dung are present."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171039> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171035> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Manuring"@en ;
    skos:scopeNote "Use where manuring is interpreted on the basis of arable weed assemblage (Stroud et al 2024) and/or stable crop isotopes (Fraser et al 2011)."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171040> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171035> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Meat Production"@en ;
    skos:scopeNote "Use where meat production is interpreted as a primary economic focus for species which may have multiple functions or products e.g. sheep, rabbits, pigeons."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171041> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171035> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Nutritional Stress"@en ;
    skos:scopeNote "Use where palaeopathological evidence suggests nutritional stress within human or animal populations."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171042> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171035> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "On-Site Breeding"@en ;
    skos:scopeNote "Use where evidence of foetal or neonatal animals or of hatched domestic eggshell suggests local breeding of livestock."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171043> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171035> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Selective Breeding"@en ;
    skos:scopeNote "Use where there is evidence for change in size and shape or other characteristics (e.g. coat colour), through intended manipulation or introductions."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171044> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171035> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Transhumance"@en ;
    skos:scopeNote "Use where there is evidence for the seansonal movement of livestock across a landscape. Evidence may include animal species, bone morphology and biochemistry, or archaeological features."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171045> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171035> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Wool Production"@en ;
    skos:scopeNote "Use where remains suggest husbandry of sheep for wool production. Evidence may include age or sex profiles of sheep remains."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171047> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171046> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Fungal Infestation"@en ;
    skos:scopeNote "Use when ergot or other fungi  are present and associated with a particular taxa."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171048> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171046> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Insect Infestation"@en ;
    skos:scopeNote "Use when either the remains of insect pests are presencet or there is clear evidence of their presence such as holes or frass"@en .

<http://purl.org/heritagedata/schemes/560/concepts/171050> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171049> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Brewing"@en ;
    skos:scopeNote "Use where brewing waste and/or the presence of beer additives are present after K E Behre (1999). Use malting where sprouted grain or detached sprouts are present."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171051> a skos:Concept ;
    skos:altLabel "Cereal Processing By-Product"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171049> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Crop Processing By-Product"@en ;
    skos:scopeNote "Use where there is evidence for use (eg as fuel, temper, thatch, fodder) or discard of crop processing by-products including cultivated legumes, fibre crops and cereals (especially from early crop processing stages, or of free-threshing varieties)."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171052> a skos:Concept ;
    skos:altLabel "Cereal Processing Product"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171049> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Crop Processing Product"@en ;
    skos:scopeNote "Use where crop product (the seeds, grain etc) is present with an absence or rarity of chaff, pods, stems, or arable weed seeds, suggesting crops arrived or were stored in a processed state."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171053> a skos:Concept ;
    skos:altLabel "Flax Retting"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171049> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Retting"@en ;
    skos:scopeNote "Use where remains of flax, hemp, or nettle stems, especially of uniform length, are recovered with or without associated fruiting parts."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171054> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171049> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Malting"@en ;
    skos:scopeNote "Use for the remains of sprouted grain and/or large numbers of detached coleoptiles (comings) are present.  Van der Veen (1987) suggests a percentage of sprouted grain >75%  can be taken as conclusive, though lower percentages may be more typical."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171055> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171049> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Bone Processing"@en ;
    skos:scopeNote "Use where there is evidence for the extraction of non-muscle meat components from bones, e.g. marrow, fats, collagen, including soup kitchen assemblages."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171057> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171049> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Food Preservation"@en ;
    skos:scopeNote "Use where there is evidence for the preservation of food, including salting, smoking, drying of meat or fish."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171059> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171049> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Roasting"@en ;
    skos:scopeNote "Use for evidence of roasting meat, nuts etc including in situ deposits."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171063> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171061> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Feasting"@en ;
    skos:scopeNote "Use where evidence suggests consumption of unusual or high-status foods, or of a large quantity of foods, suggestive of social activity rather than everyday sustenance. Evidence may also come from archaeological context or associated finds."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171064> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171061> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Funerary Use"@en ;
    skos:scopeNote "Use for pyre material, pyre goods, grave goods or components."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171065> a skos:Concept ;
    skos:altLabel "Falconry"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171061> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Hunting And Trapping"@en ;
    skos:scopeNote "Use where there is evidence that hunting or trapping reflects social factors."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171066> a skos:Concept ;
    skos:altLabel "Importation"@en,
        "Redistribution"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171061> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Importation  Of Goods"@en ;
    skos:scopeNote "Importation of animals, animal parts, plants, plant parts"@en .

<http://purl.org/heritagedata/schemes/560/concepts/171067> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171061> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Seasonality"@en ;
    skos:scopeNote "Use where there is evidence for activities happening at a  particular time of year (season)."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171068> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171061> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Social Differentiation"@en ;
    skos:scopeNote "Use where there is evidence that allows the distinction of social status, e.g. elite, ecclesiastical, impoverished."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171069> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171061> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Storage"@en ;
    skos:scopeNote "Use where storage of material is implied, usually due to association of context (eg granary structure, storage jar, storage pit) and assemblage composition (eg processed product, or by-product), and possibly including evidence of pests of storage."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171071> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171070> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Charcoal Production"@en ;
    skos:scopeNote "Evidence for the on-site production of charcoal from wood, traditionally made in pits or in stacks. Primarily  charcoal would have been used as fuel, but also used for other purposes e.g. gunpowder."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171072> a skos:Concept ;
    skos:altLabel "Coppicing"@en,
        "Pollarding"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171070> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Woodland Management"@en ;
    skos:scopeNote "Use where there is evidence of woodland management, including coppicing and/or pollarding."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171075> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171070> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Fuel Use"@en ;
    skos:scopeNote "Evidence of combustible material, usually wood, peat or turf, being used as fuel. Information on the types and potential sourcing of these materials can include, wood type use and selection preferences, and local availability."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171076> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171070> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Gathering"@en ;
    skos:scopeNote "Use when there is clear evidence for gathered plants due to the taxon (taxa) being found in a particular context such as a container or in significant concentrations."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171077> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171070> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Hay"@en ;
    skos:scopeNote "Use where the distinctive flora associated with traditionally managed hay meadows has been found in association, including Rhinanthus minor, Leucanthemum vulgare, Centaurea nigra, Sanguisorba officinalis, Filipendula ulmaria and various grasses."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171079> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171061> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Medicinal Use"@en ;
    skos:scopeNote "Use where plants or animal parts have been interpreted as used for medicinal purposes by the specialist, because of context or associated finds, or because of concentrations of a limited range of taxa with known properties."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171080> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171070> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Peat Burning"@en ;
    skos:scopeNote "Use where peat or sods (turf) has been used as fuel."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171082> a skos:Concept ;
    skos:altLabel "Baiting"@en,
        "Cockfighting"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171002> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Animal Fighting"@en ;
    skos:scopeNote "Use where there is zooarchaeological evidence for animal types, physical modifications or pathologies, or contextual associations, which suggest use of animals for fighting, such as bear-baiting or cockfighting."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171402> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171013> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Cereal Thatching"@en ;
    skos:scopeNote "Use where there is evidence for straw/ whole sheavesand where other proxies or the context suggest the presence of roofing material."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171403> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171030> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Sewage"@en ;
    skos:scopeNote "Human waste, often in association with other refuse and liquid. Use where mineralised or waterlogged plants and/or invertebrate and other remains such as highly fragmented bone, partially digested bone, mineral concretions or coprolites, indicate sewage."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171404> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171030> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Natural Plant Accumulation"@en ;
    skos:scopeNote "Use for non-anthropogenic accumulations of plants, for example pitfalls, natural infilling, vegetation succession, peat growth."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171405> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171030> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Natural Faunal Accumulation"@en ;
    skos:scopeNote "Use where local habitat characteristics or site use are interpreted from non-anthropogenic accumulation of animals, for example pitfall, predator or littoral accumulations."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171406> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171013> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Organic Additive"@en ;
    skos:scopeNote "Use where plant or animal material is visibly contained within a lime based or unbaked clay matrix, such as daub, plaster or cobb (including in situ  remains)."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171407> a skos:Concept ;
    skos:altLabel "Hurdle"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171013> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Wattle"@en ;
    skos:scopeNote "Use where there are indicators of woven round wood or split lengths of wood, used for example in hurdles or wattle and daub coinstruction."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171409> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171013> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Daub"@en ;
    skos:scopeNote "An earth based plaster the mixture of which may contain clay, dung, straw, lime putty, sand or horsehair."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171410> a skos:Concept ;
    skos:altLabel "Cobb"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171013> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Cob"@en ;
    skos:scopeNote "Walls composed of clay, earth, straw, lime and sand, mixed with water. Constructed without shutters in layers upon a stone or brick plinth and usually covered with protective limewash."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171412> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171013> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Plaster"@en ;
    skos:scopeNote "A building material used for coating walls and ceilings. Plaster can refer to gypsum plaster (also known as plaster of Paris), lime plaster, or cement plaster. Lime plaster, consisting of lime and sand, is the oldest type of render. Applied externally to walls or onto laths for infill panels and usually limewashed."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171413> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171029> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Wood Working By-Product"@en ;
    skos:scopeNote "Use where there is evidence of wood chips, off cuts or other by-products of wood working."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171414> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171029> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Wood Working Product"@en ;
    skos:scopeNote "Use where there is evidence of tool marks, turned wood and other indicators of working but not necessarily obviously objects/artefacts."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142118> a skos:Concept ;
    skos:altLabel "Carbonised"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142111> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Charred"@en ;
    skos:related <http://purl.org/heritagedata/schemes/560/concepts/142117> ;
    skos:scopeNote "Material that has been burnt and at least in part reduced to carbon as a result of burning in a reducing atmosphere below 500 degrees Celsius."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142207> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Tooth"@en ;
    skos:scopeNote "Use for teeth, hard structures found in the jaws of vertebrates used principally for chewing and eating."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171026> a skos:Concept ;
    skos:altLabel "Skin Working"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171020> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Skin Processing"@en ;
    skos:scopeNote "Use where there is  evidence for tanning (could include evidence for use of plant remains such as oak bark or evidence from skeletal element distribution or butchery)."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142117> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142214> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Charcoal"@en ;
    skos:related <http://purl.org/heritagedata/schemes/560/concepts/142118> ;
    skos:scopeNote "Wood that has been burnt and largely reduced to carbon as a result of burning in a reducing atmosphere below 500 degress C (Celsius)."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142148> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142105> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Human Aspects"@en ;
    skos:scopeNote "Aspects of a material which result from the modification or use of the material by humans."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142161> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Metal"@en ;
    skos:scopeNote "Class of elements and alloys that are characteristically lustrous, ductile, fusible and malleable. These are extracted from ore minerals originally existing in nature and processed before becoming a recognisable metal."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142165> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142182> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Microscopy"@en ;
    skos:scopeNote "The use of magnifying equipment to examine materials not visible to the naked eye."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142172> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142119> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Multi-Element Analysis"@en ;
    skos:scopeNote "Techniques investigating more than one element at a time."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142173> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142105> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Natural Aspects"@en ;
    skos:scopeNote "Aspects associated with the genetic make up and/or factors that affected the organism from which the material is derived during its life"@en .

<http://purl.org/heritagedata/schemes/560/concepts/171029> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171020> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Wood Working"@en ;
    skos:scopeNote "Use where there is general evidence for wood working. Use a narrow term where possible"@en .

<http://purl.org/heritagedata/schemes/560/concepts/171046> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171001> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Infestation"@en ;
    skos:scopeNote "Use where there is clear evidence of the presence of pests or other detrimental organisms."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142105> a skos:Concept ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Aspect"@en ;
    skos:topConceptOf <http://purl.org/heritagedata/schemes/560> .

<http://purl.org/heritagedata/schemes/560/concepts/142111> a skos:Concept ;
    skos:altLabel "Burnt Deposit"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142171> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Burnt"@en ;
    skos:scopeNote "Use for material that has been burnt."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142174> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142161> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Non-Ferrous Metal"@en ;
    skos:scopeNote "Any metal that does not contain the chemical element Iron (Fe) as a principal component."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142197> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142119> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Soil Phosphorus Analysis"@en ;
    skos:scopeNote "The analysis of the amount of phosphorus (P) present in a soil."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142214> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Wood"@en ;
    skos:scopeNote "Hard, compact, unprocessed, fibrous cellulose substance. The roots, trunks and branches of trees and shrubs consist of this tissue."@en .

<http://purl.org/heritagedata/schemes/560/concepts/144511> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142128> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Luminescence Dating"@en ;
    skos:scopeNote "A range of techniques that use the build up of charge stored within a crystalline material to estimate its age"@en .

<http://purl.org/heritagedata/schemes/560/concepts/142153> a skos:Concept ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Investigative Techniques"@en ;
    skos:topConceptOf <http://purl.org/heritagedata/schemes/560> .

<http://purl.org/heritagedata/schemes/560/concepts/142215> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142148> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Worked"@en ;
    skos:scopeNote "Use for any material that shows evidence of modification by humans."@en .

<http://purl.org/heritagedata/schemes/560/concepts/144518> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142160> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Geological Sediment"@en ;
    skos:scopeNote "A material composed of mineral grains derived from the breakdown of rocks by environmental processes."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171020> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171001> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Craft Working"@en ;
    skos:scopeNote "Use where there is evidence for the use of plants and animals in the manufacture of objects. Use more specific terms where known."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142162> a skos:Concept ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Method Of Recovery"@en ;
    skos:topConceptOf <http://purl.org/heritagedata/schemes/560> .

<http://purl.org/heritagedata/schemes/560/concepts/171002> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171001> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Animal Roles"@en ;
    skos:scopeNote "Use where there is evidence for specific roles being performed by animals."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171070> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171001> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Wild Plant Use"@en ;
    skos:scopeNote "Use where there is evidence for the use of wild resources by people as opposed to evidence for the presence of a particular type of habitat or vegetation."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171030> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171001> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Deposition"@en ;
    skos:scopeNote "Use for the deposition of material that has a documented signature in the archaeological record. Can include both natural deposition  or depostion by people or other organisms."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171049> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171001> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Processing"@en ;
    skos:scopeNote "Use where there is evidence for the processing of plants and animals to produce different types of product. Use terms under craft working where manufacture of objects is evidenced."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171061> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171001> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Social Behaviour"@en ;
    skos:scopeNote "Use where the remains of plants and animals can be interpreted as evidence for a specific social behaviour."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142119> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142153> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Chemical Techniques"@en ;
    skos:scopeNote "Examination of a material using chemical means."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171001> a skos:Concept ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Interpretations"@en ;
    skos:topConceptOf <http://purl.org/heritagedata/schemes/560> .

<http://purl.org/heritagedata/schemes/560/concepts/171035> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171001> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Husbandry"@en ;
    skos:scopeNote "Use where the remains of plants and animals indicate husbandry regimes, including the care and raising of animals and the cultivation of plants for food and other uses. Use a narrow term where possible."@en .

<http://purl.org/heritagedata/schemes/560/concepts/171013> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/171001> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Construction Materials"@en ;
    skos:scopeNote "Use where there is evidence materials have been used in construction, including decoration."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142171> a skos:Concept ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Modification State"@en ;
    skos:topConceptOf <http://purl.org/heritagedata/schemes/560> .

<http://purl.org/heritagedata/schemes/560/concepts/142128> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142153> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Dating Techniques"@en ;
    skos:scopeNote "Techniques applied to a material in order to date it or material associated with it. Use more specific terms."@en .

<http://purl.org/heritagedata/schemes/560/concepts/142182> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/560/concepts/142153> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/560> ;
    skos:prefLabel "Physical Techniques"@en ;
    skos:scopeNote "The examination of material by physical means, including detailed observation."@en .

