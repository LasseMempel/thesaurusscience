	<skos:prefLabel xml:lang="en">Post Roman</skos:prefLabel>
	<skos:prefLabel xml:lang="gd">(todo)</skos:prefLabel>
	<skos:scopeNote xml:lang="en">Loosely defined as the centuries after the breakdown of the Roman Empire.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="http://purl.org/heritagedata/schemes/scapa/concepts/RO">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
