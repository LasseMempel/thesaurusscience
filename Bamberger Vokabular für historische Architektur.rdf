        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T13:24:56.000</terms:modified>
        <skos:definition xml:lang="de">Pylon (gr.), Torbau des ägypt. Tempels mit zwei turmähnl., geböschten Bauten, in deren Schlitzen Fahnenmasten aufgestellt werden. Im Innern des P.s sind Treppen, die Fronten waren oft mit Reliefs geschmückt. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Pylon (griech. Portal, Mz. Pylonen), Tempeltoranlage mit Flankentürmen. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Pylon (Tempel)</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_36fea3c7"/>
    </owl:NamedIndividual>
    


