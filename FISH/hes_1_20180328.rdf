		<skos:prefLabel xml:lang="gd">TUINEACHADH SONNACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Tuineachadh mun a bheil co-dhiù aon sreath de phuist fhiodha faisg air a chèile 's nan seasamh ann an dìg bunait chaol.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PALISADED SETTLEMENT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
