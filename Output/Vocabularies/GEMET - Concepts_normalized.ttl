    skos:broader <http://www.eionet.europa.eu/gemet/concept/3087> ;
    skos:definition "Extraction of crushed rock or gravel screened to sizes for use in road surfaces, concretes, or bituminous mixes."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Gesamtentnahme"@de,
        "aggregate extraction"@en .

