    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Epode"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/445> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/953> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/542> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Omniscient narrator"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/871> ;
    skos:scopeNote "Narrative technique in which the narrator knows more than the characters in the plot. He may know the facts about all of the protagonists, as well as their thoughts and gestures. This is a third person narrative form."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/957> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Silversmiths"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/568> ;
    skos:scopeNote "Craftsmen specialising in silver processing."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/962> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/429> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Proode"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/445> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/967> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/584> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Milestones"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Inscriptions indicating the number of miles (in Roman miles) from the starting point of the road or from the previous large city or the number of miles to the end of the road at the next large city."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/970> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/569> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Orphic inscriptions"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Inscriptions that usually refer to the fate of the soul after the death of the human being. They are usually found engraved on gold plates and accompany the dead."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/981> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/381> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Dedicatory inscriptions"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Inscriptions refering to the dedication of a votive offering to a deity. Usually they include the name of the dedicator, the divinity to whom it was dedicated and sometimes the artist who engraved the text."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/986> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/515> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Quadruple ratio"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/498> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/989> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1858> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Literary theory"@en ;
    skos:scopeNote "Discipline dealing with the study of the literary phenomenon and of the methods for analyzing literature. More specifically it studies the intrinsic elements of literary texts, as well as the mutual relationship between literary text and context."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1004> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/618> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Happenings"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1250>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/159> ;
    skos:scopeNote "Works from the 1950s and 1960s that were unique, unrehearsed events, often combining elements of theater, music, and the visual arts. Usually nonverbal, they may incorporate audience participation. The term was coined by artist Allan Kaprow."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1021> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/381> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Oracles (Private inscriptions)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Oracular texts recorded on inscriptions and including either the queries of the believer or the answers of the god. They are found on stone, or on objects used to receive the oracle, especially on lead or brass plates."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1040> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/372>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/412> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Fustas"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/459>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/617> ;
    skos:scopeNote "Vessels that were in use in the Mediterranean during the early modern period. They were narrow, long and fast, with a length/width ratio of 7:1, and 18 to 22 rows for oarsmen. They were powered mainly by oars and only incidentally by sails. Fustas were often used in piracy."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1050> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Tailors"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/501>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/563> ;
    skos:scopeNote "Craftsmen who sew and repair garments."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1056> a skos:Concept ;
    skos:altLabel "Anapaest"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/727> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Anapest"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/528>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/813> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1067> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/515>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/694> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Double ratio"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/160>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/641> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1070> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Tanners"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1942>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/658> ;
    skos:scopeNote "Craftsmen involved in leather processing."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1087> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/377> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Oligarchy"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1090> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/717> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Schauspiel"@de,
        "Drama"@en ;
    skos:scopeNote "Dramatic genre developed in the mid-18th century in western theatre under the influence of Enlightenment ideas, as a reaction to the classicist tragedy. The new form of drama deals with serious situations, intense confrontations and conflicts of common people, moving between tragedy and comedy."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1101> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/491> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Retrograde script style"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/69> ;
    skos:scopeNote "Inscription text layout, according to which the direction of the text follows a path from right to left."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1110> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/662> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Dark blue alphabets"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/69> ;
    skos:scopeNote "A type of archaic alphabet that gathers common features of the alphabets of Corinth, the Ionian Islands, the islands of the eastern Aegean (Rhodes, Samos, Chios, etc.), cities of Western Asia Minor, Cilicia and Hellespont, as well as Macedonia, Thrace and Cyprus. The name of the alphabet was established in 1887 by Adolf Kirchhoff."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1120> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/491> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Circular script style"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/69> ;
    skos:scopeNote "Inscription text layout, according to which the letters follow a circular direction."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1174> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/730> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Pause (Narratology-Methods)"@en ;
    skos:scopeNote "A narrative technique in which the story-time comes to a standstill, while the narrative time continues. In other words the event-story is interrupted to make room exclusively for narratorial discourse. Static descriptions or narrator's comments fall into this category."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1287> a skos:Concept ;
    skos:altLabel "Attische Komödie"@de,
        "Attic comedy"@en,
        "Greek comedy"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/856> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Antike Komödie"@de,
        "Ancient comedy"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1802>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1806> ;
    skos:scopeNote "Attic comedy, a dramatic genre with Dionysian origins (from the word Κomos, a procession in honour of god Dionysos), draws inspiration from everyday life, the social and political reality and is -unlike tragedy- characterised by considerable freedom regarding the form. Distinctive structural elements of attic comedy are the Agon and the Parabassis. The members of the choruses wore masks and held phalluses performing a comic and obscene dance called Kordax. It is divided into the old (end of the 5th century BCE) that was highly political, the middle (beginning of the 4th) and the new (4th-3rd century BCE) comedy, the latter two focusing on family life and character study."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/13> a skos:Concept ;
    skos:exactMatch <https://vocabs.dariah.eu/bbt/Concept/000016> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Geneses"@en ;
    skos:scopeNote "This term classifies changes in states of affairs, things and entities that result from natural phenomena and lead either to a) the creation of new states of affairs/things/entities or b) to the modification of already existing states of affairs/things/entities with the overall effect that their former identity is lost and they are transformed into new entities with a fundamentally different nature."@en ;
    skos:topConceptOf <https://humanitiesthesaurus.academyofathens.gr> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1325> a skos:Concept ;
    skos:altLabel "Anticipation"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/852> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Prolepsis (Narratology-Methods)"@en ;
    skos:scopeNote "Α narrative thechnique that consists of narrating or evoking in advance an event that will take place later. The narrative's discourse re-orders a given story by \"flashing forward\" to a moment later in the chronological sequence of the events. The classic example of prolepsis is prophecy, as when Oedipus is told that he will sleep with his mother and kill his father."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1334> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/989> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Narratology"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2538>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2635> ;
    skos:scopeNote "A branch of the Literary Theory, whose object is the study of the narrative techniques used by the narrative discourse in order to unroll a story."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1373> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1332> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Prefix"@en ;
    skos:scopeNote "A prefix is an affix which is placed before the stem of a word. Adding it to the beginning of one word changes it into another word. For example, when the prefix un- is added to the word happy, it creates the word unhappy. Particularly in the study of languages, a prefix is also called a preformative, because it alters the form of the words to which it is affixed. Prefixes, like other affixes, can be either inflectional, changing the syntactic category, or derivational, changing either the lexical category or the semantic meaning."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1420> a skos:Concept ;
    skos:altLabel "Ending affix"@en,
        "Postfix"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1332> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Suffix"@de,
        "Suffix"@en ;
    skos:scopeNote "In linguistics, a suffix is an affix which is placed after the stem of a word. Common examples are case endings, which indicate the grammatical case of nouns or adjectives, and verb endings, which form the conjugation of verbs. A word-final segment that is somewhere between a free morpheme and a bound morpheme is known as a suffixoid or a semi-suffix (e.g., English -like or German -freundlich 'friendly'). Suffixes can carry grammatical information (inflectional suffixes) or lexical information (derivational suffixes). An inflectional suffix is sometimes called a desinence."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/146> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/17> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Koilon"@de,
        "Koilon"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/87>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/966> ;
    skos:scopeNote "Koilon was the amphitheatrical inclined plane surrounding the orchestra in ancient Greek theatres. It was the seating area of the theatre where the edolia (seats) deployed."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1468> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/29> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Exergue (Numismatics)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:scopeNote "The lowest part of a coin, divided from the rest by a horizontal line. It is often found on the reverse of a coin and usually it is used for the insertion of the date or other minor inscriptions."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1469> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/158> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Μints"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:scopeNote "The places where coins are manufactured. In the ancient Graeco-Roman world these were usually permanent facilities built probably only in cities or kingdoms with a steady and voluminous coin production. In other cases mints could be temporary establishments or even itinerant. We know very little about the nature of these buildings, as today only a few of them have been identified. The term is therefore rather loosely used (at least for the ancient world) to indicate the city of production."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/147> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/31> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Thick description"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/316>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/527> ;
    skos:scopeNote "Ethnographic method that focuses on the contextual analysis and the successive interpretation of social phenomena within the frame of their occurence, with an aim to outline the multiple meanings and significations underpinning any social milieu."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1472> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/69> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ethnic (Numismatics)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1456> ;
    skos:scopeNote "A legend indicating the collective group of people (usually the citizens of a city, but sometimes the members of a wider federal association) acting as the authority for issuing a coinage. Most often the legend consists of the name of the people in the genitive plural, or sometimes the city's name in the genitive singular, at times abbreviated."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1485> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/232> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Brigandage"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/459>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/617> ;
    skos:scopeNote "Category of actions by organized armed groups of the countryside aiming at plundering goods and acquiring material gains (e.g. through ransom money). Brigandage is connected to upheavals in life conditions (e.g. war), to radical changes in the relationship of the population with state power (e.g. the emergence of the nation-state), as well as to local economic and cultural factors (stockbreeding economy, perceptions of honour). Brigandage may be an action of resistance, an effort to overcome poverty, or an attempt to impose economic and social control; it may also be embedded in wider power networks. The approaches and definitions of brigandage by contemporaries and subsequent generations differ and vary from idealization to demonization, constituting thus distinct interpretations of power relations and of the legitimation of violence."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1499> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/240> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Journalistic texts"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1702> ;
    skos:scopeNote "Texts composed in order to be disseminated through print or digital media."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/150> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/834> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Modern Art"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/113> ;
    skos:scopeNote "1. The European art of the modern times, namely the art of the historical period that begins from the Renaissance. 2. The art that appears at the second half of the 19th century and aims at the multiple division from the European artistic tradition."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1505> a skos:Concept ;
    skos:altLabel "Physical anthropology"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1506> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Biological anthropology"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1538>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1602> ;
    skos:scopeNote "Subfield of anthropology, also referred to as physical anthropology, that focuses upon biological aspects of human adaptation and evoution, human ancestors, the relationship of humans to other organisms and patterns of biologic variation within and among human populations."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1508> a skos:Concept ;
    skos:altLabel "Epistemology"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1581> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Theory of knowledge"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1575>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2606> ;
    skos:scopeNote "The branch of philosophy, which in English is also referred to as 'Epistemology' and deals with issues surrounding the nature of knowledge, its substantive conditions or sources, its extent and the limits of knowledge and justification."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1521> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1513> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Synonymy"@en ;
    skos:scopeNote "Synonymy is the semantic relationship that exists between two (or more) words that have the same (or nearly the same) meaning and belong to the same part of speech, but are spelled differently. In other words, we can say that synonymy is the semantic equivalence between lexical items. The (pairs of) words that have this kind of semantic relationship are called synonyms, or are said to be synonymous."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1566> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/31> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Digital text analysis"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1542> ;
    skos:scopeNote "Digital text analysis is a method of computationally-driven text analysis of large text corpora, which derives information from texts such as novels, monographs, articles, web pages, etc., with the help of algorithms developed by computer scientists, statisticians and linguists."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/159> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Body Art"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1004>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1250> ;
    skos:scopeNote "An art form, a precursor to Performance Art, in which the artist's body is the medium. Body Art often took the form of public or private performances, many of which became known more widely through photographic and textual documentation."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1614> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/22> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Obverses"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:scopeNote "The depictions on the head's side of a coin, produced by the obverse die. They are most often potraits or other forms of head which sometimes, mainly from the Hellenistic period onwards, provide an indication of the authority responsible for issuing the coin."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1615> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/22> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Reverses"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:scopeNote "The depictions on the tail's side of a coin, produced by the reverse die. They are often accompanied by a legend which provides a clear indication of where the coin was minted."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1656> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1584> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Priest (Christianity)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/458>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/575> ;
    skos:scopeNote "Ordained member of Christian Churches, who performs liturgical and pastoral duties in the framework of a small community of believers. With the expansion of the Christian church in late antiquity, priests undertook many of the bishops' functions, such as the administration of the sacraments and mass celebration, and were acknowledged as heads of local parishes. This common tradition has marked the development of the office in all Christian denominations despite their differences, as for instance in the issue of the celibacy of the clergy.<br />"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1660> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Mint magistrate"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:scopeNote "The official, whether elected or appointed, responsible for oversight of the production of coins. The names of many private individuals that appear on ancient coins, either with monograms, or symbols or with their full signatures, are sometimes assumed to be those of mint magistrates."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1663> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/335> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Serration"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:scopeNote "The technique of creating an irregular sawtooth pattern around the edge of coins, devised to eliminate the fraudulent practice of clipping."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/168> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/23> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Complexes"@en ;
    skos:scopeNote "This term classifies aggregates of single built works of varying types, sizes and usages that have a functional relation between them. Complexes can also be unitary built structures that serve multiple purposes and functions."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/169> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/136>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/67> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1691> a skos:Concept ;
    skos:altLabel "Partial homonymy"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1524> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Heteronymy"@en ;
    skos:scopeNote "Heteronymy is the relationship between two words with different meanings and either the same spelling or the same pronunciation but not both."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1708> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1584> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Abbot"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1707>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/575> ;
    skos:scopeNote "The head of a monastic community. The office of the abbot originates in the emergence of Christian monasticism in late antiquity Egypt. In the course of time, the authority of the abbots over the monks was formalized with the development of canonical law and of the provisions concerning the administration of the monasteries. At the same time, the abbots became members of the clergy, as they were ordained into priesthood. The relationship of the abbots with ecclesiastical administration varies according to whether the monastery lies within the jurisdiction of the local bishop or is subordinated directly to a higher ecclesiastical authority (stauropegic monastery)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1732> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2635> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Short story"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/215>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2536> ;
    skos:scopeNote "A short story is a fully developed invented prose narrative which is shorter than a novel and a&nbsp;novella. Compared to the novel, the short story has often a few characters and a less complicated structure and plot."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1733> a skos:Concept ;
    skos:altLabel "Novelette"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2635> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Novella"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/215>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2536> ;
    skos:scopeNote "A type of prose fiction which is shorter than novels and longer than short stories. It is a well-structured yet short narrative, that usually focuses on one incident, or issue with one or two main characters."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1738> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1731> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Epistolary novel"@en ;
    skos:scopeNote "Type of the novel in which the narrative is conveyed entirely by an exchange of letters. Epistolary novel can be categorized based on the number of people whose letters are included. This gives two types of epistolary novel: monologic and polylogic."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1744> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1742> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Hieropoioi"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1722>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1795> ;
    skos:scopeNote "Committees of sacred officials who were responsible for the ceremonies at various ancient festivities, such as Hephaestus' feasts, and/or for sacrifices at various sacred ceremonies. Their members were elected from the Council and, in a few cases, from members who belonged to a prytany."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1747> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/627> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Shiites"@en ;
    skos:scopeNote "Οriginally the ‘‘partisans’’ of Ali, Muhammad’s cousin and husband of the Prophet’s daughter, Fatima. Today, however, the term designates a number of distinct groups that have arisen over the course of Islamic history and which are united by a belief that the leader of the Muslim community should be a member of the Prophet’s family, and that this continuity in leadership is expressed through the line of the legitimate Muslim imams, distinct from the Sunni caliphs. Taken together, the Shiites represent more than 10 percent of the world's Muslim population."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1762> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Collector (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1742>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1743> ;
    skos:scopeNote "An office that appears in ancient Athens. This office was held by the members of the Collectors, a Special Committee. They had the duty of controlling the indigenousness of Athenian citizens when they entered the Assembly."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1765> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Triremes builder (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1742>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1764> ;
    skos:scopeNote "An office that appears in ancient Athens. This office was held by the members of the Triremes builders committees. Their duty was to inspect shipbuilding of triremes and pay off contractors."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1778> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Syngrapheys (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1767>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1777> ;
    skos:scopeNote "An office that appears in ancient Athens. A person or a committee (as a special committee of syngrapheis) appointed by the Assembly to prepare a financial and technical study (syngraphe, as it was called) of public work."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1786> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1742> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Poletai (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1082>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1787> ;
    skos:scopeNote "Committees consisting of ten financial officers who were responsible for the auctioning of public works and the concessions for the collection of taxes."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1787> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Poletis (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1082>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1786> ;
    skos:scopeNote "An office that occurs in ancient Athens. Poletai were officials elected by draw to manage public works auctions."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1798> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Alexanders (coins)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2360> ;
    skos:scopeNote "Gold and silver coins, in the name of Alexander the Great, minted during his lifetime, and also after his death. Alexanders were issued in Macedonia, Greece proper, Black Sea, Asia Minor, Cyprus, Syria, Phoenicia, Babylonia and Egypt."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1799> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/31> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Deus ex machina"@de,
        "Deus ex machina"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1291>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2172> ;
    skos:scopeNote "Theatrical convention mainly of the ancient Greek tragedy, whereby a divine figure intervenes suddenly and provides solution to an apparently insoluble plot situation. The deus ex machina foretells the offstage future of the characters, their relatives, or descendants, establishes a custom, an institution or a cult, interprets a place name etc. Its appearance may be announced or realised suddenly with the aid of a stage mechanism. It is a typical feature of Euripidean tragedy."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1803> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Argentei"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2351> ;
    skos:scopeNote "Roman silver coins that were first introduced during Diocletian's coinage reform in 294 CE and continued to be struck until ca. 310 CE. They were of similar weight and fineness as the denarius of the time of Nero, as they were produced at a theoretical weight of 1/96th of a Roman libra."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1804> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2277> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Talents"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:scopeNote "A talent is a copper ingot in the shape of an ox-hide, in use as a medium of exchange before the invention of coinage. Later on, it was used as a unit of weight; an Attic talent, e.g. was the equivalent of 60 minas or 6,000 drachms and its weight was 26.196 kg."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1816> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Decadrachms"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1446> ;
    skos:scopeNote "Ancient greek coins, equal to 10 drachms. They were minted exclusively in Athens, Acragas, Syracuse (signed by the engravers Kimon and Euainetos), Carthago, Babylon, and Ptolemaic Egypt."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1818> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Maiorinas"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1504> ;
    skos:scopeNote "Argentiferous copper-alloy Roman coins which replaced nummi during the monetary reform of Diocletian in 348 CE, and weighed 1/60 of a libra. They were replaced by Julian in 362 CE by a large coin weighing 1/36 of a libra."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1826> a skos:Concept ;
    skos:altLabel "New Style"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Stephanephora (coins)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2351> ;
    skos:scopeNote "Silver Athenian tetradrachms and drachms of the 2nd and 1st c. BCE. Stephanephora derived their name from their reverse which depicts an owl surrounded by a laurel wreath. The exact date of their introduction is still a matter of controversy among researchers. In modern bibliography they are called New Style coins."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1832> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/14> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Earthquakes"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2520>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2600> ;
    skos:scopeNote "Violent tremors of the earth's surface due to the sudden release of energy in the lithosphere, like the collision of tectonic plates. Powerful earthquakes, often combined with other phenomena (e.g. volcanic eruptions), have provoked major catastrophes among living beings and in human establishments and social structures (fire, collapse of buildings, flood, tsunami, landslide etc.)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1836> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/14> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Volcanic eruptions"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2520>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2600> ;
    skos:scopeNote "Violent phenomena of sudden discharge of lava, gas, and ash on the earth's surface through fissures in the earth's crust (volcanoes). Powerful volcanic eruptions have provoked fundamental changes in geomorphology, climate, flora and fauna, while they have been destructive for human life and establishment even within a relatively long range from their locus."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1857> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Victoriati"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2351> ;
    skos:scopeNote "Roman silver coins which derived their name from the depiction of Victory placing a wreath upon a trophy on their reverse. They circulated in S. Italy and Gaul from about 221 to 170 BCE. The victoriati weighed three-quarters of a denarius but they were a debased coinage throughout their production as they averaged about 80% silver and 20% copper unlike the denarii which were from pure silver."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1859> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cistophori"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2351> ;
    skos:scopeNote "Reduced-weight silver tetradrachms that were introduced by the Attalid monarchs and circulated only within the Attalid dependent territories in Asia Minor. They owe their name to the depiction of the sacred chest (cista mystica) on the obverse of the first issues. The date of their introduction is still a matter of controversy, ranging from ca 192 to 155 BCE. Cistophori continued to be minted and circulated long after the kingdom was bequeathed to Rome in 133 BCE. During Roman times their local designs were gradually supplanted by imperial portraits and other Roman coin types."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1866> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/289> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cheese makers"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1979>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1980> ;
    skos:scopeNote "Persons engaged in cheese production."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/190> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/31> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Fieldwork (Anthropology)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/316>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/355> ;
    skos:scopeNote "Method of research based on the physical presence of researchers in the field. In Anthropology, fieldwork focuses on the study of social phenomena and/or groups, and includes activities such as interviewing, participant observation and small scale surveys."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1942> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/158> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Tanneries"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1070>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/658> ;
    skos:scopeNote "Skin processing workshops or organised units."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1949> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ship builders"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1494>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1950> ;
    skos:scopeNote "Craftsmen or mechanical engineers engaged in the design of vessels and floating structures, as well as the repair or conversion of old ships."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1950> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/168> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Shipyards"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1494>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1949> ;
    skos:scopeNote "Facilities used for the construction and repair or refurbishment of ships or other floating means."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1956> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Thesmothetis (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1862>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1985> ;
    skos:scopeNote "An office that first appears in ancient Athens. Α a member of the college of six Thesmothetai. His duties were mainly of a legal nature. He was responsible for several kinds of cases. Also, he determined the time and the location where the courts would be in session."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1979> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/158> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Creameries"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1866>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1980> ;
    skos:scopeNote "Places where milk and cream are processed and where butter and cheese are produced."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1980> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/205> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cheesemaking"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1866>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1979> ;
    skos:scopeNote "The production of cheese and cheese products."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1988> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/21> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Liturgies (Ancient Greece)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2065> ;
    skos:scopeNote "In ancient Athens certain public mandatory duties conferred upon the wealthiest citizens. The constitution of liturgies was a kind of indirect regular or occasional taxation. Regular liturgies were the choregia, gymnasiarchy etc. while trierarchies and eisphora were occasional."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2024> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1321> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Drawing"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1027>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2016> ;
    skos:scopeNote "Term that refers both to the act of marking lines on a surface and to the product of such manual work. Manipulating line, form, value, and texture, with an emphasis on line and value rather than colour."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2033> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/127> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Migrants"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1989>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/724> ;
    skos:scopeNote "People who move and settle down over a relatively long range of geographical distance and for a relatively long period of time. In their places of settlement, migrants form informal communities according to their ethnic characteristics and their places of origin. Their incorporation into the broader social context, the degree to which they are accepted by it, and the degree to which they preserve a distinct collective identity depend on political, economic, social and cultural factors."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2039> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2253> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "International organisations"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2516> ;
    skos:scopeNote "Institutionally recongised organisations that are based on a set of rules and objectives, have a formal technical, material and administrative structure, and develop their activity between governments, social groups or individuals from numerous states, often on a global level."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2046> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Resin collectors"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2047>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2048> ;
    skos:scopeNote "Men and/ or women working individually or in groups to collect resin from the bark of coniferous trees."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2047> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/289> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Resin cultivators"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2046>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2048> ;
    skos:scopeNote "Professionals engaged in the cultivation of coniferous trees."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2048> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/148> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Resin cultivation"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2046>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2047> ;
    skos:scopeNote "Branch of forestry which deals with the cultivation of coniferous trees for the production and harvesting of ricin."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2068> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Astynomos (ancient Athens)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2069>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2616> ;
    skos:scopeNote "An office known in many ancient Greek states, mainly Ionian. In Athens there were five for the city and five for Piraeus. Their principal duties were to enforce building regulations, keep the streets and sanctuaries clean and free from obstructions and supervise the hiring prices for certain categories of entertainers. They also had the power to impose fines or bring the perpetrators to trial in an heliastic court under their presidency."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2069> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2622> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Astynomoi (Collective authorities)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2068>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2615> ;
    skos:scopeNote "Magistrates encountered in many ancient Greek states, mainly Ionian. In Athens, there were five for the city and five for Piraeus. Their principal duties were to enforce building regulations, keep the streets and sanctuaries clean and free from obstructions and supervise the hiring prices for certain categories of entertainers. They also had the power to impose fines or bring the perpetrators to trial in an heliastic court under their presidency."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2086> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ateleia (privileges in ancient Athens)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1218>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/767> ;
    skos:scopeNote "A privilege granted to foreigners in ancient Athens. It involved immunity from special taxes paid by foreigners (such as the \"metoikion\", the tax paid by metics in Athens\"), and also exemption from military service."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2106> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1888> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Astrolabes"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1495>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2195> ;
    skos:scopeNote "Instruments used widely from Antiquity until around the 17th century in observational astronomy and navigation for complex astronomical and geometrical calculations with respect to the positions of the Sun, planets and stars, time, geographical latitude and the direction of the North, as well as the determination of horoscopes in astrology."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2153> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Trichrysa"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2353> ;
    skos:scopeNote "Gold coins weighing around 17.80 gr and valued at 60 silver drachms. They were first introduced by Ptolemy I (305-285 BCE) and continued to be minted under Ptolemy II (285-246 BCE) during the first half of his reign. They are called pentadrachms by numismatists who consider their weight and not their value in silver."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2159> a skos:Concept ;
    skos:altLabel "Artificial languages"@en,
        "Constructed languages"@en,
        "Non-human languages"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2158> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Techincal languages"@en ;
    skos:scopeNote "A constructed language (sometimes called a conlang) is a language whose phonology, grammar, and vocabulary, instead of having developed naturally, are consciously devised. Constructed languages may also be referred to as artificial languages, planned languages or invented languages and in some cases fictional languages. Planned languages are languages that have been purposefully designed. They are the result of deliberate controlling intervention, thus of a form of language planning."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2160> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2158> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Animal communication systems"@en ;
    skos:scopeNote "Animal communication is the transfer of information from one or a group of animals (sender or senders) to one or more other animals (receiver or receivers) that affects the current or future behavior of the receivers. Information may be sent intentionally, as in a courtship display, or unintentionally, as in the transfer of scent from predator to prey. Information may be transferred to an \"audience\" of several receivers. Animal communication is a rapidly growing area of study in disciplines including animal behavior, sociology, neurology and animal cognition. Many aspects of animal behavior, such as symbolic name use, emotional expression, learning and sexual behavior, are being understood in new ways. Species-specific systems of communication whose investigation can be carried out only through interdisciplinary effort by (behavioral) psychologists, anthropologists, biologists, linguists, and others. Differences and similarities between animal and human systems of communication provide the basis for hypotheses and theories about the origin and development of human language from earlier forms of communication in the animal kingdom. To be sure, the results of such comparative investigations and their interpretation are largely dependent on the given fundamental definition of language. If natural language is defined as a system of phonetic signs, through the production of which the speaker can express objects, states of affairs (including those that are not spatially or temporally present), and conceptual generalizations in symbols, then the ‘language’ of animals can be distinguished from human languages accordingly: (a) Natural languages are characterized by the feature of double articulation, i.e. complex linguistic expressions are composed of meaningful elements, monemes or morphemes, which in turn can be described as combinations of the smallest meaningful phonetic elements, phonemes. The signals of animal communication, however, can only be analyzed on the first level of articulation for form and meaning, but not as the combination of smaller, more formal elements. (b) Utterances in animal communication are generally reflexes of external signals, i.e. they are connected with released stimuli and thus are not produced intentionally. (c) The meaning of the species-specific signals is apparently known largely by instinct (indeed, in many animals such signals are completely instinctive), and thus do not have to be learned. (d) It is not possible to combine elements of a given communication system to fit new situations, though more recent investigations seem to indicate that chimpanzees may possess latent, though unexploited, combinatory abilities (see Marler 1965). (e) In contrast to natural languages, animal communication cannot express conceptual generalizations with symbols."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2172> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/17> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Theologeion"@de,
        "Theologeion"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1799>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/966> ;
    skos:scopeNote "A kind of platform projected from the roof of the skene of the ancient Greek theatre where gods or demigods appeared."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2173> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/17> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Thymele"@de,
        "Thymeli"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/87>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/966> ;
    skos:scopeNote "Altar of Dionysus in the centre of the ancient Greek theatre orchestra upon which stood the leader of the chorus."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2175> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/24> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Kostüme (Darstellende Künste)"@de,
        "Costumes (Performing arts)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2177>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/822> ;
    skos:scopeNote "Costume is the dress of an actor/performer who represents a character on stage, or in film or television. The theatrical costume defines the character the actor impersonates in the place and time of the dramatic action. It signifies their social status and psychological state, while at the same time emphasising the dramatic position and the internal relationship of the characters of a performance. Costumes give the spectator explicit information about age, gender, profession or social class, the place and time of the action. They are not a complete whole unless presented to the audience, creating a parallel, visual narrative plane that complements the actor&rsquo;s words and movements."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2176> a skos:Concept ;
    skos:altLabel "Scenery"@en,
        "Stage sets"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/128> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Bühnenbilder"@de,
        "Sets (Perfroming arts)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2177>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/683> ;
    skos:scopeNote "In the performing arts sets refer to all the elements representing a setting that establishes the frame of the action (backdrops, constructions, lighting, sound systems, etc.) used in a dramatic performance on stage, television, or film."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/219> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ego"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/351>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/49> ;
    skos:scopeNote "The notional person used as primary reference in the description of kinship structures and/or relationships."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2204> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/17> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Backstage"@de,
        "Backstage"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/425>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/683> ;
    skos:scopeNote "The part of the stage and theatre which is out of the sight of the audience. The service areas of the theatre, behind, beside or underneath the stage."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2209> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/20> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Bühnenbearbeitung"@de,
        "Adaptation"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1331>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1900> ;
    skos:scopeNote "The transformation of a source work into a new form or genre, for a purpose, use, or medium other than that for which the original was intended, e.g. commonly a novel rewritten as a play (theatrical adaptation) or as a film (film adaptation). This creative process is sometimes associated with postmodernist notions of intertextuality and hybridity and the study of the interweaving of different texts and textual traditions in literature, art, film, and music. In a theatrical adaptation the narrative content, which is retained more or less faithfully, although sometimes with significant differences, is adapted, while the discursive structure undergoes a radical change from one enunciative mechanism to another. The recast work adapts to the norms and conventions governing the new genre&rsquo;s framework to which it is ascribed, often with the purpose of offering a commentary on the source."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2210> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Authority (Numismatics)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:scopeNote "The formal guarantor of the value of a coin. For civic coinages, the authority is generally presumed to be the government of the city itself. Within kingdoms and empires, the authority may be the supreme ruler (e.g. king or emperor), or an appointee (e.g. satrap or provincial governor)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2212> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2277> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Aes rude"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:scopeNote "Nuggets of rough irregular ingots of bronze, of unequal weight and without any official stamp or mark, used as a proto-currency, mainly in northern and central Italy. Aes rude were first introduced during the 8th c. BCE and were produced until the end of the 4th or maybe even the first half of the 3rd c. BCE."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/223> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Hyposynaphe"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/599>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/642> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2232> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2253> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Musical ensembles"@en ;
    skos:scopeNote "Ensembles consisting of musicians performing instrumental and/or vocal music. The structure of musical ensembles displays a wide variety according to diverse cultural traditions and musical genres."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2243> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2277> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Aes signatum"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:scopeNote "Heavy, cast, rectangular ingots, made of highly impure and heavily leaded bronze. They carried variοus designs and were used as official currency by the Roman state during the period between the end of the 4th and the middle of the 3rd c. BCE."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2246> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2160> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Visual animal communication systems"@en ;
    skos:scopeNote "Visual signals are very effective for animals that are active during the day. Some visual signals are permanent advertisements; for example, the bright red epaulets of male red-winged blackbirds, Agelaius phoeniceus, which are always displayed, are important for territory defense. When researchers experimentally blackened epaulets, males were subject to much higher rates of intrusion by other males. Alternatively, some visual signals are actively produced by an individual only under appropriate conditions. Male green anoles, Anolis carolinensis, bob their head and extend a brightly colored throat fan (dewlap) when signaling territory ownership."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2275> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2277> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Aes grave"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:scopeNote "Heavy, cast, bronze discs used as a currency in central Italy from around 280-275 BCE until the introduction of the denarii, in 211 BCE. They can be understood as a Roman hybrid between the Greek round coins and the central Italian heavy bronze currency. The basic aes grave unit, theoretically weighting a Roman pound, was the assarius."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2276> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2277> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Aes formatum"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:scopeNote "Bronze pieces, of unequal weight and without any official stamp or mark, used as a proto-currency in Italy. They were cast and have various shapes.<br />"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2278> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2277> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Obols"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:scopeNote "Iron rods, measuring 1 to 1.5 meters in length, used as a medium of exchange in the premonetary Greek world. Their thickness was such that six rods could be held together in the palm of the hand. From the Greek verb drattomai, which means grasp in the fist, comes the word drachm, which was equivalent to six obols."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2279> a skos:Concept ;
    skos:altLabel "Servants"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2534> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Zanni"@de,
        "Zanni"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2274> ;
    skos:scopeNote "Types of comic servants, the zanni or zani of the improvisational Italian Commedia dell&rsquo; arte take on various names (Arlecchino, Scaramuccia, Pulcinella, Scapini etc.) and wear respective costumes and masks. In each scenario, that formed the canvas on which the performances were based, there was at least one pair of servants, who often played contrasting roles, the first a cunning and witty valet who carries the plot and the second a dull-witted foil, a simpleminded, awkward character, helping to highlight his partner&#39;s spirit."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/231> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/28> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Identity"@en ;
    skos:scopeNote "The specific qualities and characteristics that forge the self-apprehension of individuals and/or groups. Identity refers to the process of structuring the individual or collective &quot;self&quot;, in the context of the cognitive and performative interaction with significant &quot;others&quot;."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2316> a skos:Concept ;
    skos:altLabel "Pentekontalitra"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Demareteia"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2351> ;
    skos:scopeNote "Silver decadrachms of the 5th c. BCE from Syracuse. They derived their name from an old theory that considered them to have been struck from the proceeds of a gift of one hundred talents of gold made by the defeated Carthaginians, after the battle of Himera (480 BCE), to Demarete, the wife of the tyrant Gelon. The exact date of their introduction is still a matter of controversy among researchers. The coins bear the image of a quadriga crowned by a flying Nike and a lion in the exergue as an obverse and the head of the nymph Arethusa wearing an olive wreath as a reverse."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2324> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2349> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cast coins"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1879> ;
    skos:scopeNote "Coins made by pouring melted metal into molds with the embossed image of the desired coins. During antiquity coins were usually cast when they were too large to be struck. Some forgers also used casting as the easiest way to copy official coins."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2350> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/248> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Natural theology"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/256>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2604> ;
    skos:scopeNote "The attempt to establish fundamental religious truths, especially with respect to the existence and attributes of christian God, by means of reason applied to nature, without invoking or appealing to revealed truths. Natural theology was systematised in the late 18th and the early 19th centuries by the teleological argument from design, which identified that&nbsp;nature functions so perfectly, that it could not have come about by chance, but must have been designed by an intelligent Creator. In this way, natural theology argued that the divine wisdom can be discerned in nature."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2354> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/285> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Epicheirotonia of the laws"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1069>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "A process that took place in ancient Athens from 403 BC onwards in the first Assembly of each year. Any citizen could propose a law in writing to the secretary of the Council to replace an earlier law. The process of legislation took the form of a trial. The man proposing the new law appeared as the prosecutor, while the defence of the earlier law was assumed by Athenians called syndikoi (advocates). The nomothetai decided by a show of hands either in favour or against the proposed law."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2355> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2349> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Electrum coins"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:scopeNote "Coins that are made of electrum."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2359> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Tetrachma Antigoneia"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2351> ;
    skos:scopeNote "Silver tetradrachms issued by Antigonos Gonatas (283-239 BCE) with the head of Pan in the centre of a Macedonian shield on the obverse and Athena Alkidemos on the reverse."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2363> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1467> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Aeginetan weight standard"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2361> ;
    skos:scopeNote "The weight standard that included staters of 12.4 gr., half-staters, or in other words drachms, of 6.2 gr., quarters or hemidrachms of 3 gr., twenty-fourths of a stater and sixths of a drachm or obols of 1 gr. and subdivisions of the obol."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2364> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1467> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Corinthian weight standard"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1877> ;
    skos:scopeNote "The weight standard that was based on a stater of 8.6 gr. which was equivalent to an Attic didrachm, but was divided into thirds of 2.9 gr. called drachms, to hemidrachms etc."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2365> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1467> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Euboeic weight standard"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2366> ;
    skos:scopeNote "The weight standard that was based on a stater of 17.2 gr. divided into thirds of 5.7 gr., sixths of 2.86 gr., half-sixths of 1.43 gr. etc."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2371> a skos:Concept ;
    skos:altLabel "Nurses"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2190> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Nursing professionals"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2102>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2369> ;
    skos:scopeNote "Health professionals who provide treatment, support and care services for people who are in need of nursing care due to the effects of ageing, injury, illness or other physical or mental impairment, or potential risks to health. Nursing professionals assume responsibility for the planning and management of the care of patients, including the supervision of other health care workers, working autonomously or in teams with medical doctors and others in the practical application of preventive and curative measures."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2373> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2190> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Midwifery professionals"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2369>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/736> ;
    skos:scopeNote "Health professionals who plan, manage, provide and evaluate midwifery care services before, during and after pregnancy and childbirth. They provide delivery care for reducing health risks to women and newborn children, working autonomously or in teams with other health care providers."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2385> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/31> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cleruchia"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2386>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/742> ;
    skos:scopeNote "A method by which the ancient Athenians expanded their domination to various regions. The Athenians settled landless citizens in the new territories by distributing land plots to them.&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2386> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/26> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cleruchs"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2385>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/742> ;
    skos:scopeNote "Cleruchs, during antiquity, were landless citizens, whom Athens deployed in areas of strategic importance. The cleruchs retained their status as Athenian citizens. They continued to pay taxes just like the rest of the citizens and were also recruited as hoplites."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2406> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/834> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Applied Arts"@en ;
    skos:scopeNote "The term refers to the application of artistic design to utilitarian objects. The broad range of the applied arts includes ceramics, furniture, glass, leather, metalwork, textiles, jewellery."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2426> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2425> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Environmental ethics"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1462>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2223> ;
    skos:scopeNote "Major component of environmental philosophy that constitutes a domain of applied ethics and addresses the normative significance of the relations between human beings and their non-human environment. At the heart of environmental ethics lies the attempt to articulate the basis of concern for the natural world, wherein an \"intrinsic value\" is recognized. Some of the issues it debates are how to balance the claims of present and future, human and non-human, sentient and non-sentient beings, individuals and wholes, as well as the prospects for a sustainable relationship between economic and ecological systems, taking into consideration its implications with respect to social justice and political institutions."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2430> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Aspra (coins)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2351> ;
    skos:scopeNote "Silver coins of the Empire of Trebizond. They were issued from 1204 CE until the 15th c. CE. They weighed 2.9 gr."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2432> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1657> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Astronomical observatories"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2105>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2195> ;
    skos:scopeNote "Scientific organisations housed in buildings or sites where regular observations of celestial bodies and phenomena are made with special instruments, such as telescopes. Observatories focus on scientific research, although occasionally they may be transformed into sites of observation and spectacle (of celestial phenomena) for the wide public, a function that was quite popular in the 19th century."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2436> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Praise (honor awarded)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1218>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2438> ;
    skos:scopeNote "An honor awarded&nbsp; with honorary decrees to Athenian citizens and foreigners in ancient Athens. A moral reward, that was the main honor by which the Athenian people recompensed a citizen for his actions. It was normally accompanied by the award of a wreath."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2438> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Wreath (honor awarded)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1218>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2436> ;
    skos:scopeNote "An honor awarded to Athenian citizens and foreigners in ancient Athens. The state crowned the honored persons with wreaths of ivy, laurel, olive tree branches or gold, the cost of the latter was defined by the state and was written on honorary decrees where the decision of the Assembly was recorded. The reasons for awarding the prize were also briefly stated. The public award of the wreath took place after a public proclamation at one of the city festivals."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2441> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Hospitality (privilege in ancient Athens)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1218>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2080> ;
    skos:scopeNote "Hospitality was one of the privileges granted to foreigners (proxenoi, ambassadors, etc.) in ancient Athens in recompense for outstanding services toward the city. Though it is not clear precisely what the term implies, it probably means that the foreigner was cared for. The grant of this privilege was registered in the honorific decree which recorded the resolution of the Assembly."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2442> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Dinner in the prytaneion (privilege in ancient Athens)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1218>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1715> ;
    skos:scopeNote "A privilege granted to Athenian citizens in ancient Athens. Honored Athenians were invited to dine in the prytaneion along with the prytaneis. The granting of this privilege was registered in the honorific decree which recorded the resolution of the Assembly."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2485> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/26> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Symmoriai (Ancient Greece)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2486>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2487> ;
    skos:scopeNote "Groups of citizens who were obliged to pay tax (eisphora) or to undertake the liturgy of the trierarchy in Athens during the 4th century BC. The groups were made up of citizens with roughly the same amount of property so that members of a symmoria paid the same sums of money. The initial number of these groups was one hundred (100) and it changed several times when it was considered appropriate or when circumstances required it. The metics were assigned to special symmoriai and paid the sums specified for them, which were not the same as those paid by Athenian citizens. The institution of symmoriai appears in several city-states in ancient Greece."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2486> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Eisphorai (Ancient Greece)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2485>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2487> ;
    skos:scopeNote "A type of irregular taxation that was imposed in proportion to the property of the citizens in various cities of ancient Greece. Particularly, in Athens this tax was paid by Athenian citizens and metics, according the decision of the Assembly in times of war."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2487> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Proeisforai (Ancient Greece)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2485>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2486> ;
    skos:scopeNote "A type of irregular taxation that was imposed after 378 BC on the three wealthiest Athenians of each tax group (symmoria) who were invited to prepay the whole sum that corresponded to their symmoria as an advance payment (proeisphora), and were left to reimburse themselves from the other members.&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2563> a skos:Concept ;
    skos:altLabel "Old men"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2534> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Vecchi"@de,
        "Vecchi"@en ;
    skos:scopeNote "Τhe elder types of Commedia dell&rsquo; arte are the parents of young people in love (<em>innamorati</em>), shouting, advising, displaying austerity, glorifying old times and mistreating others. But sometimes they fall in love with a young woman or a widow and at other times they marry the maid. They are mocked when they pretend to be openhanded."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2615> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2622> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Amphodarchai (Collective authorities)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2069>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2616> ;
    skos:scopeNote "Magistrates in ancient Pergamos. Their responsibility was the supervision of neighbourhoods, which involved keeping them clean, preventing anybody from digging ditches, making bricks, or installing uncovered pipes and receiving pledges when fines were not paid. They reported to the Astynomoi to whom they were accountable.&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2616> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Amphodarches (ancient Pergamos)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2068>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2615> ;
    skos:scopeNote "An office that appears in ancient Pergamos. Their responsibility was the supervision of neighbourhoods, which involved keeping them clean, preventing anybody from digging ditches, making bricks, or installing uncovered pipes and receiving pledges when fines were not paid. They reported to the Astynomoi to whom they were accountable.&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2629> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/31> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Eugenics"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1602>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/394> ;
    skos:scopeNote "The theory and practice that emerged in the late 19th century aiming at improving human heredity, typically through control of reproduction. A central distinction was made between &quot;positive&quot; and &quot;negative&quot; eugenics. &quot;Positive&quot; eugenics encouraged breeding by those considered to possess &quot;superior&quot; hereditary qualities.&nbsp;&quot;Negative&quot; eugenics, which flourished in the first half of the 20th century also as policies, deterred or prevented, through segregation or sterilisation, breeding by those considered to be physically, mentally, or morally &quot;defective&quot;. Eugenics began to decline after World War I and the emergence of genetics."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/286> a skos:Concept ;
    skos:altLabel "Sentences"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/22> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Clauses"@en ;
    skos:scopeNote "Clauses are parts of a sentence/utterance. Each clause has only one main verb. \"I love you\" is a sentence which has only one clause. \"I love you and I will always love you\" is a sentence which has two clauses. The two clauses are \"I love you\" and \"I will always love you\". These clauses are joined together by the word 'and', which is a conjunction. Clauses may be independent or dependent."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/288> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Endogamy"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/106>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/251> ;
    skos:scopeNote "The rules that enforce marriages exclusively between the members a specific social, tribal or kinship group."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/295> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/30> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Twelvetide"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/345>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/760> ;
    skos:scopeNote "The Christian festive season between Christmas and Epiphany. It is a period of intense social and religious activity, marked by various celebrations and other customary events."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/312> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/21> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Political regimes"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/133> ;
    skos:scopeNote "Organization and legitimation forms of governance, of institutionalized power relations, and of sociopolitical processes within a state. Political regimes vary according to their typological features and their historical context."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/345> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Carols"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/295>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/760> ;
    skos:scopeNote "Traditional greeting or praising songs performed with musical instruments on the eve of important religious celebrations."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/355> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/31> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Participant observation"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/190>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/316> ;
    skos:scopeNote "Method of fieldwork applied by researchers in the Social Sciences and the Humanities. It involves the collection of primary information through the observation of the studied groups, the active engagement in the activities of these groups, and the development of sustained relationships with their members."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/361> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/22> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Alphabets"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/69> ;
    skos:scopeNote "The set of letters (symbols representing sounds) of a language and by extension any writing system or set of symbols used in communication."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/375> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/202> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Customs"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/613> ;
    skos:scopeNote "Repeated and symbolically invested actions with specific spatiotemporal references and performative elements."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/391> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2582> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Law"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/102> ;
    skos:scopeNote "Law is the discipline and profession concerned with the customs, practices, and rules of conduct of a community that are recognized as binding by the community. Enforcement of the body of rules is through a controlling authority.<br />"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/397> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/315> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Manumission"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/390>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/483> ;
    skos:scopeNote "The release of a person from the status of slavery through a legal act by the former owner, who renounces his property rights."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/404> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/362> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Horoi (Bearers of inscriptions)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/69> ;
    skos:scopeNote "Inscribed stelae marking the boundaries of public or private spaces."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/417> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/215> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Time of the narrative"@en ;
    skos:scopeNote "The succession of the events with the order and the duration that the writer chooses to represent them in his narrative. The term \"narrative time\" must not be confused with the \"story time\", that is the real chronological order of the events as it can be concluded from the text."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/430> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/256> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Branches of Islam"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1583>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/627> ;
    skos:scopeNote "Systems of religious beliefs and practices that share the basic principles of Islam, as exposed in the Quran, but vary as to the interpretation of sacred law and tradition (Hadith), as well as to the assessment of the history of early Islam."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/44> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2253> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Political organizations"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2625> ;
    skos:scopeNote "Institutionally sanctioned collective organizations that are active in the political field and seek the realization of goals that serve the interests of their members and of the social groups they represent."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/443> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/339> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Bilineal descent"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/108>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/693> ;
    skos:scopeNote "Descent system in which children become members of both the paternal and maternal kinship group."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/471> a skos:Concept ;
    skos:altLabel "Wilamowitz-Knox's law"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/115> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Wilamowitz-Knox's bridge"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/666>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/709> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/483> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/315> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Abolition of slavery"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/390>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/397> ;
    skos:scopeNote "A legislative act that abrogates any right of property over humans, prohibits any practices connected with or deriving from it, and offers slaves equal legal status with the rest of the population. The abolition of slavery in Europe and America took place in the late 18th and early 19th centuries and was the outcome of political movements or liberal revolutions."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/509> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/335> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ancient abbreviations"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/69> ;
    skos:scopeNote "Abbreviations for words, which were repeated frequently in epigraphic texts. These words were familiar to all and the use of their abbreviation would not cause confusion. This method was used by scribes of ancient texts mainly for reasons of space. For example, in Attic inscriptions it was common practise to abbreviate the name of a citizen's deme (e.g. ΛΑΜ instead of Λαμ(πτρεύς) (= from the deme of Lamptrai)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/519> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/362> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Stelae (Bearers of inscriptions)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/69> ;
    skos:scopeNote "Pieces of stone, erected usually vertically, on which the inscription was engraved. Most often, these monuments have been removed from their in situ location, and can be found in museums or other places."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/52> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Caste (propositional object)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/106>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/127> ;
    skos:scopeNote "System of social stratification manifested in the hierarchical classification of social groups according to specific conceptualisations of &quot;purity&quot; and &quot;impurity&quot;. It entails the exclusion of certain groups from religious rites, and shapes customary patterns of social interaction."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/520> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/44> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Political parties"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1695>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2625> ;
    skos:scopeNote "Political organizations that aim at fulfilling their goals through the acquisition of political power. The institutionalization of political parties, as well as their significance within the whole political system, are pertinent mainly for modern and contemporary parliamentary democratic states."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/527> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/240> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ethnography (informational object)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/147>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/316> ;
    skos:scopeNote "The output of ethnographic research, as derived from the collection, interpretation and combined reproduction of ethnographic material."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/529> a skos:Concept ;
    skos:altLabel "Bucolic caesura"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/79> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Bucolic diaeresis"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/634>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/663> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/548> a skos:Concept ;
    skos:altLabel "Havet's law"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/115> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Havet's bridge"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/396>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/666> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/553> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/53> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Hephthemimeral caesura"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/634>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/709> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/554> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/279> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Schisma (Harmonic science)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/433>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/86> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/559> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/50> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Social institutions"@en ;
    skos:scopeNote "Regulative norms that consolidate the fabric of social relations, establish patterns of collective behaviour and steer collective action towards the accomplishment of socially important objectives."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/574> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/291> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Longum"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/451>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/583> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/586> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/161> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Morphem"@de,
        "Morpheme"@en ;
    skos:scopeNote "Α morpheme is the smallest grammatical and meaningful unit of a language. A morpheme is not identical to a word, and the principal difference between the two is that a morpheme may or may not stand alone, whereas a word, by definition, is freestanding. When it stands by itself, it is considered a root because it has a meaning of its own and when it depends on another morpheme to express an idea, it is an affix because it has a grammatical function. Every word comprises one or more morphemes.The more combinations a morpheme is found in, the more productive it is said to be."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/597> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/89> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Künste"@de,
        "Arts"@en ;
    skos:scopeNote "Branches of creative activity comprising any process intending to the production of material objects, phenomena or experiences endowed with a significant degree of aesthetic interest. According to most art classification systems, they mainly include the visual and the performing arts."@en .

