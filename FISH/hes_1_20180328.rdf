	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1082">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1082</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LEAGHADAIR LUAIDHE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Acainnean no structaran air a bheil feum gus luaidhe mheatailteach a sgaradh o chlach-mhèinnir le bhith ga theasachadh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">LEAD SMELTER</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">LEAD SMELTING PLANT</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1081" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1050" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1083" />
		<skos:scopeNote xml:lang="en">Equipment or structures used to separate metallic lead from its ores by the use of heat.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
