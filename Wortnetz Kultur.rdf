		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013551"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019899"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019929"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000313"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000797"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk000836"/>
		<skos:definition xml:lang="de">Ein Gebück ist eine Befestigungsanlage oder eine Hecke, deren Äste so mit einander verflochten und beschnitten werden, dass ein undurchdringliches Hindernis entsteht.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000313"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000797"/>
