        <skos:altLabel xml:lang="de">Kerzenstachel</skos:altLabel>
        <skos:definition xml:lang="de">Lichtdorn m; Dorn m; auch Kerzenstachel m; Einsteckdorn m: die Metallspitze auf dem Leuchter, auf den die Kerze gesteckt wird. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Lichtdorn</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">pointe</skos:prefLabel>
        <skos:prefLabel xml:lang="en">pricket</skos:prefLabel>
    </owl:NamedIndividual>
    


