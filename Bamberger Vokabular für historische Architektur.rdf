    <!-- https://hist-arch-vocab.org/bvha#c_6d9883bf -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_6d9883bf">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0f3f1d26"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-12T16:49:29.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-27T18:48:51.000</terms:modified>
        <skos:altLabel xml:lang="cs">stavba ocelového skeletu</skos:altLabel>
        <skos:altLabel xml:lang="en">steel skeleton construction</skos:altLabel>
        <skos:definition xml:lang="de">Aus Stahlprofilen gebildetes, in sich starres, tragendes Gerippe, dessen Wände nur dem Raumabschluss zu dienen haben. Vorgefertigte Teile werden auf der Baustelle vernietet oder verschweißt. Vorteilhaft ist die weitgehende Vorbereitung in der Werkstatt, die Kontrolle der Werkstoffbeschaffenheit, die Witterungsunabhängigkeit und die Möglichkeit, ohne Gerüst schnell zu montieren. Die witterungsbeeinflusste Außenwand kann vorgehängt werden, so dass die Konstruktion geschützt ist. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Stahlskelettbau</skos:prefLabel>
        <skos:prefLabel xml:lang="es">construcción con estructura metálica</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">construction à ossature en acier</skos:prefLabel>
        <skos:prefLabel xml:lang="it">costruzione a scheletro d\&apos;acciaio</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">ocelová skeletová konstrukce</skos:prefLabel>
        <skos:prefLabel xml:lang="en">steel-frame construction</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_6d9e49ef -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_6d9e49ef">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1c8ef562"/>
