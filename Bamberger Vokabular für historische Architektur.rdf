        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-29T08:50:08.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T14:50:08.000</terms:modified>
        <skos:altLabel xml:lang="de">Verriegelung</skos:altLabel>
        <skos:definition xml:lang="de">Im konstruktiven Fenster- und Türenbau Teil des Schließmechanismus aus Holz oder Metall. Nach der Bewegungsart kann sich um einen Schieberiegel, Drehriegel, Schwenkriegel, aber auch um einen Vorreiber oder ein Ruder handeln. [Schrader / Voigt 2003]</skos:definition>
        <skos:prefLabel xml:lang="de">Riegel (Beschlag)</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_ff300c4e"/>
    </owl:NamedIndividual>
    


