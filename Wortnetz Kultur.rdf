		<crm:P32 rdf:resource="http://lvr.vocnet.org/wnk/wk007129"/>
		<skos:definition xml:lang="de">Ein Trockenmauerwerk ist ein Mauerwerk, bei dem das Material ohne Bindemittel aufeinander geschichtet wird und das sich häufig bei kleineren Stützmauern, z.B. in Weinberghängen findet.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002319"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010555"/>
