	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021077">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Bestrahlungslampe</skos:prefLabel>
		<skos:altLabel xml:lang="de">Bestrahlungslampen</skos:altLabel>
		<skos:prefLabel xml:lang="en">radiation lamp</skos:prefLabel>
		<skos:altLabel xml:lang="en">radiation lamps</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk019093"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk019093"/>
		<skos:definition xml:lang="de">Eine Bestrahlungslampe ist ein medizinisches Gerät, das speziell für therapeutische Zwecke eingesetzt wird, indem es verschiedene Arten von Strahlung abgibt, wie Infrarotstrahlung, ultraviolette Strahlung, Full-Spectrum-Licht oder andere spezifische Wellenlängen, um beispielsweise Muskelverspannungen, rheumatische Erkrankungen, Hautkrankheiten, Neugeborenenikterus oder saisonale Depressionen zu behandeln.</skos:definition>
		<skos:relatedMatch rdf:resource="http://d-nb.info/gnd/4264333-8"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019093"/>
