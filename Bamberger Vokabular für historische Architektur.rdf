        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_e393b624"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_e668eabb"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_e7fd37d1"/>
