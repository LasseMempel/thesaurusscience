		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk020342"/>
		<skos:definition xml:lang="de">Eine topographische Karte ist eine Landkarte, auf der sichtbare Erscheinungen der Erdoberfläche mit hoher kartografischer Genauigkeit abgebildet und durch Kartenrahmen und Kartenrand erläutert werden.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300028361"/>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4322897-5"/>
