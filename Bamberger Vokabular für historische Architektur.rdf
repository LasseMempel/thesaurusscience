    <!-- https://hist-arch-vocab.org/bvha#c_f0300093 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_f0300093">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_5f9418c5"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_9afe9adf"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_56df9f05"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T23:18:42.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:09:24.000</terms:modified>
        <skos:altLabel xml:lang="en">groined vault</skos:altLabel>
        <skos:definition xml:lang="de">Das Kreuzgratgewölbe entsteht, wenn 2 Tonnengewölbe gleicher Höhe sich rechtwinklig schneiden, d.h. es setzt sich aus 4 Tonnenkappen zusammen. Die Schnittstellen heißen Grate. Den Druck fangen die Stützen auf, den Seitenschub die Widerlagsmauern bzw. die Strebepfeiler. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Kreuzgewölbe, dessen Kappen in Graten zusammenstoßen. Die Römer bauten ein Kreuzgewölbe mit tragenden Gratsteinen, Vorläufer der mittelalterlichen Rippengewölbe. Die Grate wurden als vollständige, sich selbst tragende Diagonalbogen zuerst gespannt, danach wurden die Kappen mit Gußmauerwerk oder anderem Material geschlossen. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Kreuzgratgewölbe</skos:prefLabel>
        <skos:prefLabel xml:lang="en">groin vault</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûtes d\&apos;arêtes</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_5f9418c5"/>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_9afe9adf"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_f0341b69 -->


