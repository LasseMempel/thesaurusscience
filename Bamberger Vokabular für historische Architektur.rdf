        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T19:24:32.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T19:24:50.000</terms:modified>
        <skos:definition xml:lang="de">Schüttfundamente, die als Bodenaustausch zu betrachten sind und teilweisebeachtliche Tiefen (bis 10 m unter OK Erdreich) erreichten; teilweisewurden diese Schüttungen in weichen plastischem Boden einfach durch das Gewicht des aufgehenden Gebäudes in den Baugrund eingepresst, bis die Setzungen zum (in einem kurzen, begrenzten Zeitraum wahrgenommenen)Stillstand kamen. [Nodoushani]</skos:definition>
        <skos:prefLabel xml:lang="de">Schüttfundament</skos:prefLabel>
        <broaderByConstruction rdf:resource="https://hist-arch-vocab.org/bvha#c_473bbc7d"/>
    </owl:NamedIndividual>
    


