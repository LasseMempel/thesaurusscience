		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013607"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk009755"/>
		<skos:definition xml:lang="de">Ein Kondom ist ein Gerät der mechanischen Empfängnisverhütung und Gesundheitsvorsorge, das als dünne, meist aus feinem Latex hergestellte Hülle vor dem Geschlechtsverkehr über den erigierten Penis gezogen wird, um die Übertragung von Krankheiten sowie eine Schwangerschaft zu verhindern.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300265582"/>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4164941-2"/>
