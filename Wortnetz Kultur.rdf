	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk013872">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Sonntagsspeise</skos:prefLabel>
		<skos:altLabel xml:lang="de">Sonntagsspeisen</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk008333"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk018622"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk008333"/>
		<skos:definition xml:lang="de">Eine Sonntagsspeise ist eine Speise, die an Sonntagen oder zu besonderen Anlässen verzehrt wird. </skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk018622"/>
