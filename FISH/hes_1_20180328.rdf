		<skos:prefLabel xml:lang="gd">CUIBHLE ASAIL</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Cuibhle-choise a tha ga thionndadh le asal. Gheibhear seo còmhla ri tobraichean ma is trice.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">DONKEY WHEEL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">DONKEY MILL</skos:altLabel>
