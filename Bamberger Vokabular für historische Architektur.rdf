    <!-- https://hist-arch-vocab.org/bvha#c_fd3fd41e -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_fd3fd41e">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
