        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_262f7dbe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_b8248b61"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_ba0426b4"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_d96146d9"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_e019cf31"/>
