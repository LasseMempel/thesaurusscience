		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/73" />
		<skos:scopeNote xml:lang="en">A building for the storage and drying of hops, often including a hop drying kiln. Usually built as part of a farm.</skos:scopeNote>
