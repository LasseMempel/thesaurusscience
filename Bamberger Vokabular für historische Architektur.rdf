        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_50b90d6b"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_f592f958"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-28T17:47:57.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T21:09:41.000</terms:modified>
        <skos:altLabel xml:lang="en">Easter candle</skos:altLabel>
        <skos:definition xml:lang="de">Osterkerze f; lat. cereus paschalis: eine große, reich verzierte und mit fünf Weihrauchkörnern (Symbol der Wunden Christi) besteckte Wachskerze (seit 5. Jh.). Sie steht in der Osterzeit beim Hochaltar und brennt während der Messe. Früher wurde sie am Himmelfahrtsfest nach der Lesung aus dem Evangelium gelöscht und entfernt; jetzt geschieht dies erst am Abend des Pfingstfestes als dem Ende der Osterzeit. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Osterkerze</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Paschal candle</skos:prefLabel>
        <skos:prefLabel xml:lang="la">cereus paschalis</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">cierge pascal</skos:prefLabel>
    </owl:NamedIndividual>
    


