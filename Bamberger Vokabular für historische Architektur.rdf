        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-20T17:57:42.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T18:09:22.000</terms:modified>
        <skos:altLabel xml:lang="de">Elsässer Ziegel</skos:altLabel>
        <skos:altLabel xml:lang="de">Gilardoniziegel</skos:altLabel>
        <skos:definition xml:lang="de">Ende des 19. Jahrhunderts von den Gebr. Gilardoni in Altkirch im Elsass industriell als Pressziegel hergestellter Falzdachziegel mit einer doppelten Kopfverfalzung sowie einer breiten Mulde. [Schrader / Voigt 2003]</skos:definition>
        <skos:prefLabel xml:lang="de">altkirchener Falzziegel</skos:prefLabel>
    </owl:NamedIndividual>
    


