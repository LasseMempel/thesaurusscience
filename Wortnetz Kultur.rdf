		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk003921"/>
		<xe:explanation_temp xml:lang="de">Hämatit ist ein typisches Verwitterungsprodukt rötlicher Bodentypen in wärmeren Regionen und wird sowohl als farbgebendes Pigment als auch als Schmuckstein verarbeitet.</xe:explanation_temp>
		<skos:definition xml:lang="de">Hämatit ist ein Eisenoxid, das eine braune bis rote Färbung aufweist und meist als hexagonales Kristall auftritt.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300011105"/>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4158672-4"/>
