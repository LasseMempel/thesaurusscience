  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69256">
    <skos:scopeNote xml:lang="en">Mill for fine grinding of tin ore between millstones.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69427">
    <skos:scopeNote xml:lang="en">An open yard or place where timber is stacked or stored.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93474">
    <skos:scopeNote xml:lang="en">A pond located at or near a swannery.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71634">
    <skos:scopeNote xml:lang="en">A winch powered by a small steam engine used to drag barges, boats and other vehicles up an inclined plane.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/152578">
    <skos:scopeNote xml:lang="en">Mud walled building found on the Solway Plain.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140268">
    <skos:scopeNote xml:lang="en">A modern building system in which both steel and concrete are utilized together to carry the load in ways that neither material predominates over the other. There are many varieties e. g. a steel frame surrounding a concrete core.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/147457">
    <skos:scopeNote xml:lang="en">An area of either natural or artificial stone arranged to resemble a rocky outcrop or cliff face within animal cages/enclosures of a Zoo.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143222">
    <skos:scopeNote xml:lang="en">A pass, vulnerable to attack from the enemy but essential for the movement of troops and which, if captured, could divide a defending force. As a result such passes are defended with anti invasion defences such as pillboxes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68864">
    <skos:scopeNote xml:lang="en">An enclosure created by constructing one or more lines of ramparts across a promontory which projects into the sea.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160245">
    <skos:scopeNote xml:lang="en">A stand by set house built to Air Ministry drawing number 1039/41.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141293">
    <skos:scopeNote xml:lang="en">Garden associated with a crematorium where the ashes of the deceased are scattered or buried.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70273">
    <skos:scopeNote xml:lang="en">A path for pedestrians only.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92741">
    <skos:scopeNote xml:lang="en">A building for the storage of all stores supplied for naval service other than victualling and armament.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143391">
    <skos:scopeNote xml:lang="en">An establishment used for the manufacture of jacquards and dobbys, which are textile loom components that control the weaving of complicated or figured patterns.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162932">
    <skos:scopeNote xml:lang="en">Armoured military vehicle with its own firepower, which operates on tracks for troop mobility over rough terrain. Some may be adapted, or purpose-built, to be amphibious, and may then be double-indexed as AMPHIBIOUS VEHICLE.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68814">
    <skos:scopeNote xml:lang="en">A building used to store military equipment and ammunition.</skos:scopeNote>
  </rdf:Description>
