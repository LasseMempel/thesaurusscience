        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_9f74e321"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_b7584b90"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_d5e19558"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_e58c5b19"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-18T10:10:42.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T18:09:49.000</terms:modified>
        <skos:definition xml:lang="de">Crocia f, it.: von Kardinälen im Konklave und seit dem 16. Jh. von Angehörigen der römischen Kurie getragener, weiter Mantel mit halblangen, weiten Ärmeln und Kapuze, gefertigt aus scharlachrotem bzw. violettem Wollstoff, mit gleichfarbiger Seide gefüttert, am Kragen und an den Ärmeln mit Hermelin besetzt. Die Crocia wird vorne mit Bändern aus Spitze geschlossen, die den Nacken kragenartig umgeben und lang herunterhängen. Vor 1969 gehörte sie zur Kleidung der Sondergesandten des Papstes. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Crocia</skos:prefLabel>
        <skos:prefLabel xml:lang="en">crocia</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">crocia</skos:prefLabel>
    </owl:NamedIndividual>
    


