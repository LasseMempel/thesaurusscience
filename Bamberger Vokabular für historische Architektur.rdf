    <!-- https://hist-arch-vocab.org/bvha#c_7ed2950f -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_7ed2950f">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_25d5f91f"/>
