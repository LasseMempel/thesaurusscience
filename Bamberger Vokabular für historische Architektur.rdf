        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T09:06:13.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T14:05:19.000</terms:modified>
        <skos:altLabel xml:lang="fr">moresque</skos:altLabel>
        <skos:definition xml:lang="de">Ornament aus streng stilisierten Pflanzen, islamisch nach hellenistischen Vorbildern, seit der Renaissance wieder angewandt. Vgl. Arabeske. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="en"> arabesque</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Maureske</skos:prefLabel>
        <skos:prefLabel xml:lang="it">arabesco moresco</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">maureska</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">mauresque</skos:prefLabel>
        <skos:prefLabel xml:lang="es">morisco</skos:prefLabel>
    </owl:NamedIndividual>
    


