        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-22T08:41:07.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T16:03:48.000</terms:modified>
        <skos:altLabel xml:lang="fr">arcade à sculptures</skos:altLabel>
        <skos:definition xml:lang="de">Blendarkaden, in denen Skulpturen aufgestellt sind. Eine verbreitete Form sind die sogenannten Königsgalerien, eine Folge von Königsstatuen unter Blendarkaden oder in Nischen an der Fassade gotischer Kathedralen, namentlich in Frankreich. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Figurenarkade</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">arcade à figures</skos:prefLabel>
        <skos:prefLabel xml:lang="en">figured arcade</skos:prefLabel>
    </owl:NamedIndividual>
    


