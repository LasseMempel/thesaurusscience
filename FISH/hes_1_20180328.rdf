				<skos:prefLabel xml:lang="gd">TAIGH-DUBHAIRICHE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Taigh beag, mar is trice air oighreachd taighe-dhùthcha, na phàirt de dhubhar banntraich is mar àite-còmhnaidh dhi.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">DOWER HOUSE</skos:prefLabel>
