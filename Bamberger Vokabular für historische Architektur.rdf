        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T17:43:28.000</terms:modified>
        <skos:definition xml:lang="de">Handschuhe m pl: zur Amtstracht in der passenden Rangfarbe getragen: rot für Kardinäle, violett für Bischöfe, schwarz für die übrigen Kleriker. Neuerdings nicht mehr vorgeschrieben. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Handschuh</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">gant de ville</skos:prefLabel>
        <skos:prefLabel xml:lang="en">glove</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">rukavice</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_a95e9b52 -->


