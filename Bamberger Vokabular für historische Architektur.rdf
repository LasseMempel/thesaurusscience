        <skos:altLabel xml:lang="de">Reliquienpult</skos:altLabel>
        <skos:definition xml:lang="de">Messpultreliquiar n; auch Reliquienpult n: ein Reliquienbehälter in Form eines kleinen Lesepultes. Beispiel: in der Pfarrkirche zu Küssnacht/ Schweiz. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Messpultreliquiar</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">reliquaire en forme d\&apos;un porte-missel</skos:prefLabel>
        <skos:prefLabel xml:lang="en">reliquary in the shape of a missal-stand</skos:prefLabel>
    </owl:NamedIndividual>
    


