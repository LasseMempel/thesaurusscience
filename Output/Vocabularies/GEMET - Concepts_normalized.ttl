    skos:closeMatch <http://data.uba.de/umt/_00002540>,
        <http://dbpedia.org/resource/Occupational_medicine> ;
    skos:definition "The branch of medicine which deals with the relationship of humans to their occupations, for the purpose of the prevention of disease and injury and the promotion of optimal health, productivity, and social adjustment."@en ;
