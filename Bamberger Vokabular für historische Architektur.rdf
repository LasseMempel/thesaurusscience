        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T10:12:22.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T01:19:01.000</terms:modified>
        <skos:definition xml:lang="de">Die Säulenhalle des vorderasiat. und pers. Hauses, die sich zum Hof oder Garten öffnet und zu beiden Seiten von Räumen umgeben ist. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Talar (Halle)</skos:prefLabel>
    </owl:NamedIndividual>
    


