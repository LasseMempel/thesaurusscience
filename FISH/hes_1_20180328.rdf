		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1580">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1580</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CUAIRT-DHÌG</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Dìg shlàn no cha mhòr cearcallach a chithear, mar is trice, mar chomharra-barra. Dh'fhaoidte gur e seo iarsmadh de bharpa, taigh-cruinn no feart ùr a chaidh a sgriosadh leis an treabhadh. Cleachd am briathar seo mur eil fios dè am feum a bha ann.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">RING DITCH</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1442" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1463" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1671" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500554" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501093" />
		<skos:scopeNote xml:lang="en">An unbroken circular or sub-circular ditch, usually seen as a cropmark. May be the remains of a ploughed-out barrow, roundhouse or modern feature. Use the term where function is unknown.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1584">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1584</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">STRUCTAR FIODHA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Rud a chaidh a thogail ach aig nach eil feum soilleir, co-dhiù an-diugh no a-rèir fianais àrc-eòlaich, cuid mhath dheth air a dhèanamh de dh'fhiodh. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TIMBER STRUCTURE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1442" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1478" />
		<skos:scopeNote xml:lang="en">A construction of indeterminate function, either extant or implied by archaeological evidence, made largely from wood. Use specific term where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
