	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/503700">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/503700</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CNOC-SEALLAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Torr fuadain, cruachan mar is trice, a tha ann an gàrradh no pàirc mar ionad seallaidh thairis air a' ghàrradh no air a' phàirc. Faodaidh gum bi seo na fhòcas lèirsinn sa ghàrradh no sa phàirc.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PROSPECT MOUND</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-10-22T16:19:31</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-10-31T11:45:31</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/552" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1564" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/576" />
		<skos:scopeNote xml:lang="en">An artificial mound, generally conical, placed within a garden or park to provide a viewing point to overlook the garden or park. It may also serve as a visual focus in the garden or park layout.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
