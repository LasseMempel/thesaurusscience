        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-28T10:48:38.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T10:48:22.000</terms:modified>
        <skos:definition xml:lang="de">Auf Kirchhöfen ein kleiner Anbau neben der Kirche oder auch eine Gruft unter der Kirche oder unter dem Karner, um die beim Graben neuer Gräber aufgedeckten alten Knochen zu lagern. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Beinhaus</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kostnice</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_a3f1d1df -->


