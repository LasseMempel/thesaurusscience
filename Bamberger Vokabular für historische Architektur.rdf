        <skos:altLabel xml:lang="de">elliptisches Gewölbe</skos:altLabel>
        <skos:definition xml:lang="de">Gewölbe über dem Grundriss einer Ellipse, hauptsächl. im böhm. und fränk. Barock vorkommend. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Gewölbe über ellipsenförmigem Grundriss; vor allem im böhmischen und fränkischen Barock. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Ellipsengewölbe</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">elipsovitá klenba</skos:prefLabel>
        <skos:prefLabel xml:lang="en">elliptical vault</skos:prefLabel>
