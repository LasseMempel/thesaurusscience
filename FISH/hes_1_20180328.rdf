	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502431">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502431</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">GÀRRADH SAOTHRACHAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Ionad gnìomhachais far a bheilear a' dèanamh co-structaran einnseanaireachd mòra mar phìosan de longan no drochaidean.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">FABRICATION YARD</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-01T09:09:23</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-10-02T12:02:45</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/728" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/740" />
		<skos:scopeNote xml:lang="en">An industrial facility for making large engineered constructions such as sections of ships or bridges.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
