    <!-- https://hist-arch-vocab.org/bvha#c_ef7e48c4 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_ef7e48c4">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_e5eb81f8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T16:34:41.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T11:23:13.000</terms:modified>
        <skos:altLabel xml:lang="de">Calvaire</skos:altLabel>
        <skos:definition xml:lang="de">Gemalte oder plastische Darstellung der Kreuzigung Christi mit vielen Figuren. Besonders bekannt sind die Kalvarienberge (Calvaire) in der Bretagne (Skulpturengruppen im Freien). [Koch 2009] </skos:definition>
        <skos:definition xml:lang="cs">Malba nebo plastické znázornění ukřižovaného Krista s dalšími postavami, zvl. známé jsou kalvárie (,,calvaire &quot;) v Bretani (skupiny soch ve volné přírodě). [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Kalvarienberg</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kalvárie</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_ef9286b9 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_ef9286b9">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
