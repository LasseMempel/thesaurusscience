    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_9c5bacc9 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_9c5bacc9">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_e40768cc"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_fc540a39"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_f10222e0"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-03T14:22:12.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-03T16:45:08.000</terms:modified>
        <skos:altLabel xml:lang="de">Nuteisen</skos:altLabel>
        <skos:definition xml:lang="de">Die schmale Form des Schlageisens mit etwa 0,5 - 1,5 cm Schneidebreite wird heute Beiz- oder Nuteisen genannt. [Voelkle 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Beizeisen</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Die einfachste Methode, um dünne Löcher in Stein zu bohren, besteht darin ein rund geschliffenes Beizeisen zwischen den Händen hin und her zu drehen. [Voelkle 2016]</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_9c65939f -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_9c65939f">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_6b1efaf3"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-08T20:21:02.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:08:15.000</terms:modified>
        <skos:definition xml:lang="de">Ein zylindrisches Gewölbe, das bei der rechtwinkligen, Durchdringung von zwei gleich hohen Tonnen mit horizontaler Scheitellinie entsteht, deren Auflager erhalten bleibt. [Glossarium Artis] </skos:definition>
        <skos:prefLabel xml:lang="de">geschlossenes Klostergewölbe</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_9c682310 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_9c682310">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_8916f563"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-16T14:25:28.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-18T18:13:53.000</terms:modified>
        <skos:altLabel xml:lang="de">Maßwerkbogen</skos:altLabel>
        <skos:definition xml:lang="de">Jeder Bogen, in dessen Leibung Zierformen bzw. Maßwerkelemente wie Blatt, Nase und Pass als schmückende Details hineinreichen, ohne jedoch die eigentliche Form der Bogenlinie (als Rundbogen, Segmentbogen, Spitzbogen etc.) zu bestimmen. Zu unterscheiden von Bogen, in deren Bogenlinien selbst Maßwerkformen nachgebildet werden, wie z. B. Kleeblattbogen und Vielpassbogen. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="fr">arc à réseau d\&apos;intrados</skos:prefLabel>
        <skos:prefLabel xml:lang="en">arch with tracery in the intrados</skos:prefLabel>
        <skos:prefLabel xml:lang="de">eingeschriebener Bogen</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Bogenform, die sich aus Maßwerkelementen zusammensetzt.</skos:scopeNote>
    </owl:NamedIndividual>
    


