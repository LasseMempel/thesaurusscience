        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T18:45:46.000</terms:modified>
        <skos:altLabel xml:lang="de">Blindtür</skos:altLabel>
        <skos:definition xml:lang="de">Eine Tür mit einem Blendrahmen, der bei massiver Bauweise mit einem Bankeisen an einem rohen oder vorgeputzten Mauerfalz verankert ist. War die Standardtür seit dem ausgehenden 19. Jahrhundert. [Schrader / Voigt 2003]</skos:definition>
        <skos:prefLabel xml:lang="de">Blendrahmentür</skos:prefLabel>
        <broaderByConstruction rdf:resource="https://hist-arch-vocab.org/bvha#c_62508dc5"/>
    </owl:NamedIndividual>
    


