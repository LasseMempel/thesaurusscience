    skos:closeMatch <http://data.uba.de/umt/_00028813>,
        <http://dbpedia.org/resource/Soot> ;
    skos:definition "Impure black carbon with oily compounds obtained from the incomplete combustion of resinous materials, oils, wood, or coal."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Russ"@de,
        "soot"@en .

<http://www.eionet.europa.eu/gemet/concept/7938> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/57> ;
    skos:closeMatch <http://data.uba.de/umt/_00021614> ;
    skos:definition "The sound pressure level (in decibels) at a point in a sound field, averaged over the audible frequency range and over a time interval."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Schallpegel"@de,
        "sound level"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Sound_pressure> .

<http://www.eionet.europa.eu/gemet/concept/7939> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5119> ;
    skos:closeMatch <http://data.uba.de/umt/_00021612> ;
    skos:definition "Because of the large variations in sound magnitudes, and because the human hearing sensation seems to vary in a logarithmic way, logarithms are used in measurement of sound. The sound pressure level is given in decibels (dB)."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Schallmessung"@de,
        "sound measurement"@en .

<http://www.eionet.europa.eu/gemet/concept/794> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9098> ;
    skos:closeMatch <http://data.uba.de/umt/_00004966> ;
    skos:definition "Waste oil that accumulates, usually in small quantities, inside the lower spaces of a ship, just inside the shell plating, and usually mixed with larger quantities of water."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bilgenöl"@de,
        "bilge oil"@en .

<http://www.eionet.europa.eu/gemet/concept/7941> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:closeMatch <http://data.uba.de/umt/_00021623>,
        <http://dbpedia.org/resource/Soundproofing> ;
    skos:definition "Reducing or eliminating reverberation in a room by placing sound-absorbing materials on the walls and ceiling."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Schallschutz"@de,
        "soundproofing"@en .

<http://www.eionet.europa.eu/gemet/concept/7942> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/59> ;
    skos:closeMatch <http://data.uba.de/umt/_00021580> ;
    skos:definition "The travelling of acoustic waves in the atmosphere with a speed independent of their amplitude. The speed only depends on the acoustic medium and is proportional to the square route of the absolute temperature for any given medium."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Schallausbreitung"@de,
        "sound propagation"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Sound> .

<http://www.eionet.europa.eu/gemet/concept/7945> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/59> ;
    skos:closeMatch <http://data.uba.de/umt/_00051240> ;
    skos:definition "Passage of a sound wave through a medium or series of media."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Geräuschübertragung"@de,
        "sound transmission"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Acoustic_transmission> .

<http://www.eionet.europa.eu/gemet/concept/7947> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/367> ;
    skos:closeMatch <http://data.uba.de/umt/_00100695>,
        <http://dbpedia.org/resource/South_America> ;
    skos:definition "A continent in the southern part of the western hemisphere, astride the equator and the Tropic of Capricorn, bordered by the Caribbean Sea to the north and between the Atlantic and Pacific Oceans, connected to North America by the Isthmus of Panama, and divided into twelve countries:  Argentina, Bolivia, Brazil, Chile, Columbia, Ecuador, Guyana, Paraguay, Peru, Suriname, Uruguay and Venezuela."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_7253>,
        <http://eurovoc.europa.eu/1624> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Südamerika"@de,
        "South America"@en .

<http://www.eionet.europa.eu/gemet/concept/7948> a skos:Concept ;
    skos:broadMatch <http://eurovoc.europa.eu/2110> ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9380> ;
    skos:closeMatch <http://data.uba.de/umt/_00100697> ;
    skos:definition "An ocean south of the equator between the eastern coast of South America and the western coast of Africa that extends southward to the Antarctic continent, including the Drake Passage, South Sandwich Islands and Falkand Islands."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Südatlantik"@de,
        "South Atlantic Ocean"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Atlantic_Ocean> .

<http://www.eionet.europa.eu/gemet/concept/7949> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/598> ;
    skos:closeMatch <http://data.uba.de/umt/_00100708>,
        <http://dbpedia.org/resource/Southeast_Asia> ;
    skos:definition "A geographic region of continental Asia, south of China, west of the South Pacific Ocean, north of the Indian Ocean, and east of the Bay of Bengal and the Indian subcontinent, including the Indochina Peninsula, the Malay Peninsula and the Indonesian and Philippine Archipelagos, and countries such as Brunei, Cambodia, Indonesia, Laos, Malaysia, Myanmar, the Philippines, Singapore, Thailand and Vietnam."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/2858> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Südostasien"@de,
        "Southeast Asia"@en .

<http://www.eionet.europa.eu/gemet/concept/795> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9127> ;
    skos:closeMatch <http://data.uba.de/umt/_00004968> ;
    skos:definition "Water that builds up in the bottom of a ship's bilge."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Bilgenwasser"@de,
        "bilge water"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Bilge> .

<http://www.eionet.europa.eu/gemet/concept/7950> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/170> ;
    skos:closeMatch <http://data.uba.de/umt/_00652002>,
        <http://dbpedia.org/resource/Southern_Africa> ;
    skos:definition "A geographic region of the African continent astride the Tropic of Capricorn, including Angola, Botswana, Lesotho, Malawi, Mozambique, Namibia, South Africa, Swaziland, Zambia and Zimbabwe, and also the Kalahari Desert, Zambezi River and Orange River."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_7265>,
        <http://eurovoc.europa.eu/342> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "südliches Afrika"@de,
        "Southern Africa"@en .

<http://www.eionet.europa.eu/gemet/concept/7951> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/598> ;
    skos:closeMatch <http://data.uba.de/umt/_00100696> ;
    skos:definition "A geographic region of the Asian continent bordered in the north by the countries of Central Asia and in the south by the Arabian Sea and the Bay of Bengal, extending  westward into Iran and eastward into China, including Afghanistan, Pakistan, India, Nepal, Bangladesh, Burma, Bhutan and Sri Lanka."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/2848> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Südasien"@de,
        "Southern Asia"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/South_Asia> .

<http://www.eionet.europa.eu/gemet/concept/7952> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9380> ;
    skos:closeMatch <http://data.uba.de/umt/_00100709> ;
    skos:definition "An ocean south of the equator between Southeast Asia and Australia in the Eastern hemisphere and South America in the Western hemisphere, extending southward to the Antarctic region, including the Tasman and Coral seas and numerous islands, such as Galapagos, Solomon, Easter, Samoa, Fiji and Tonga islands, and also New Zealand and its islands."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/2112> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Südpazifik"@de,
        "South Pacific Ocean"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Pacific_Ocean> .

<http://www.eionet.europa.eu/gemet/concept/7973> a skos:Concept ;
    skos:broadMatch <http://eurovoc.europa.eu/1759> ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4288> ;
    skos:closeMatch <http://data.uba.de/umt/_00020011> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Pseudo-Krupp"@de,
        "spasmodic croup"@en .

<http://www.eionet.europa.eu/gemet/concept/7974> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9369> ;
    skos:closeMatch <http://data.uba.de/umt/_00031191> ;
    skos:definition "The rate of moves or migrations made by a given population within a given time frame."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/1948> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Räumliche Mobilität"@de,
        "spatial mobility"@en .

<http://www.eionet.europa.eu/gemet/concept/7975> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/662> ;
    skos:closeMatch <http://data.uba.de/umt/_00003380> ;
    skos:definition "An exceptional granting of power or permission or a legislative act authorizing money to be spent on government programs."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Ausnahmegenehmigung"@de,
        "special authorisation"@en .

<http://www.eionet.europa.eu/gemet/concept/7978> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2655> ;
    skos:closeMatch <http://dbpedia.org/resource/Special_law> ;
    skos:definition "One relating to particular persons or things; one made for individual cases or for particular places or districts; one operating upon a selected class, rather than upon the public generally. A law is special when it is different from others of the same general kind or designed for a particular purpose, or limited in range or confined to a prescribed field of action or operation."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Sonderrecht"@de,
        "special law"@en .

<http://www.eionet.europa.eu/gemet/concept/7984> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2897> ;
    skos:closeMatch <http://data.uba.de/umt/_00030227> ;
    skos:definition "An organized group of activities and procedures, often run by a government agency or a nonprofit organization, to preserve and protect living organisms designated as being at risk."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Artenschutzprogramm"@de,
        "species conservation programme"@en .

<http://www.eionet.europa.eu/gemet/concept/7985> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2782> ;
    skos:closeMatch <http://data.uba.de/umt/_00002712> ;
    skos:definition "Loss of species due to factors such as climate change or random events such as persistent drought, natural catastrophe, the emergence of a new predator, or genetic mutation."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Artenverarmung"@de,
        "species impoverishment"@en .

<http://www.eionet.europa.eu/gemet/concept/7992> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4574> ;
    skos:closeMatch <http://dbpedia.org/resource/Spectroscopy> ;
    skos:definition "The branch of physics concerned with the production, measurement, and interpretation of electromagnetic spectra arising from either emission or absorption of radiant energy by various substances."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_14498> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Spektroskopie"@de,
        "spectroscopy"@en .

<http://www.eionet.europa.eu/gemet/concept/7994> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:closeMatch <http://data.uba.de/umt/_00011222>,
        <http://dbpedia.org/resource/Speed> ;
    skos:definition "A scalar measure of the rate of movement of a body expressed either as the distance travelled divided by the time taken (average speed) or the rate of change of position with respect to time at a particular point (instantaneous speed). It is measured in metres per second, miles per hour, etc."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_24248> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Geschwindigkeit"@de,
