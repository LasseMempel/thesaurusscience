        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-16T14:38:42.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T16:32:29.000</terms:modified>
        <skos:definition xml:lang="fr">Contour scaling : desquamation dont l’interface avec la partie saine de la pierre reproduit le modelé de la pierre, parallèlement à sa surface. Dans le cas où cette surface est plane, l’expression Desquamation en plaque (préférée à déplacage ou encore formation de plaques) peut être utilisée. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="en">Contour scaling : scaling in which the interface with the sound part of the stone is parallel to the stone surface. In the case of flat surfaces, contour scaling may be called spalling. [ICOMOS-ISCS]</skos:definition>
        <skos:prefLabel xml:lang="fr">desquamation en plaque</skos:prefLabel>
        <skos:prefLabel xml:lang="en">spalling</skos:prefLabel>
    </owl:NamedIndividual>
    


