    <!-- https://hist-arch-vocab.org/bvha#c_4c0cac98 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_4c0cac98">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_5f9418c5"/>
