    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1767>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1777>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1786>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1787>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2356>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2357>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Inscriptions refering to works related to buildings or major building projects."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1104> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/629> ;
