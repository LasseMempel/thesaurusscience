		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk008693"/>
		<skos:definition xml:lang="de">Eine Maurerkelle ist ein Handwerkzeug mit einem dreieckigen oder trapezförmigen Blatt, mit dem Mörtel auf Mauern aufgetragen und anschließend geglättet wird.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk013539"/>
