		<skos:prefLabel xml:lang="de">Maske (Bildwerk)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Masken (Bildwerke)</skos:altLabel>
		<skos:altLabel xml:lang="en">masks (sculptures)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000742"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk018688"/>
