	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk012870">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Einlegen (Lebensmittelkonservierung)</skos:prefLabel>
		<skos:prefLabel xml:lang="en">pickling (food preservation)</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk014695"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013706"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk014695"/>
		<skos:definition xml:lang="de">Einlegen ist ein Verfahren der Lebensmittelkonservierung, beim dem etwa Gemüse, Eier, Fleisch oder Fisch in bestimmten, auch gewürzten, Flüssigkeiten haltbar gemacht werden, wozu vor allem Essig, Öl und Salzlake zählen.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4256141-3"/>
		<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1503967"/>
