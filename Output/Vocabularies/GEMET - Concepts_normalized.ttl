<http://www.eionet.europa.eu/gemet/concept/6594> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7796> ;
    skos:closeMatch <http://data.uba.de/umt/_00013585> ;
    skos:definition "Any politically active group with a common set of values about resource use allocation. Pressure groups seek to influence decisions on resource use allocation in excess of their proportional representation in the planned-for populace by seeking preferential consideration for their resource use choices."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_13567> ;
