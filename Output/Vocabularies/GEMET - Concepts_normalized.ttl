    skos:broader <http://www.eionet.europa.eu/gemet/concept/12605> ;
    skos:closeMatch <http://data.uba.de/umt/_00017718> ;
    skos:definition "An afterburner is a gadget fitted to the exhaust flues of furnaces and also to the exhaust systems of motor vehicles. They remove polluting gases and particles, which are the result of incompletely combusted fuel, by incineration and break down other chemical molecules associated with combustion into inert chemicals."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Nachverbrennung"@de,
        "afterburning"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Afterburner> .

