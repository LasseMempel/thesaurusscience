    skos:inScheme <http://purl.org/heritagedata/schemes/38076> ;
    skos:prefLabel "Tropical cyclone"@en ;
    skos:scopeNote "Low-pressure systems forming over oceans characterised by high winds, heavy precipitation, and storm surge."@en .

<http://purl.org/heritagedata/schemes/38076/concepts/40400> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/38076/concepts/4040> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/38076> ;
    skos:prefLabel "Sand storm"@en ;
    skos:scopeNote "Strong winds causing the transportation of sand and soil."@en .

<http://purl.org/heritagedata/schemes/38076/concepts/40401> a skos:Concept ;
