    <!-- https://hist-arch-vocab.org/bvha#c_d55bfb5b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_d55bfb5b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
