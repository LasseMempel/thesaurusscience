	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/730">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/730</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FACTARAIDH EINNSEANAIREACHD THROM</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Aitreabh gnìomhachais a nì mòran saothrachaidh, obrach-càraidh agus/no obrach-glèidhidh.  Faodaidh seo a ghabhail a-steach stuthan fùirneis, innealachaidh, co-chuir/togail, gu h-àraid meatailtean, agus faodaidh e a bhith àraid no coitcheann na nàdar.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HEAVY ENGINEERING WORKS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/731" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/732" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/733" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/734" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/735" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/729" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/736">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/736</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">FACTARAIDH THURBINEAN</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Factaraidh a tha a' dèanamh turbainean (innealan a chleachdas rotar liaghach a thionndaidheas an lùth-ghluasaid a tha ann an sruthadh uisge, ceòtha no adhair na lùths mheacanaigeach).</skos:scopeNote>
				<skos:prefLabel xml:lang="en">TURBINE WORKS</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/730" />
				<skos:scopeNote xml:lang="en">A factory which produces turbines (machines which use a bladed rotor to convert the kinetic energy of moving fluid, steam or air to mechanical energy).</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:scopeNote xml:lang="en">An industrial complex devoted to large-scale manufacturing, maintenance and/or repair work.  Activities can include founding, forging, machining and assembling/erecting materials, especially metals, and can be general or specialised in nature.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/731">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/731</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FACTARAIDH EINNSEANAIREACHD ÀITEACHAIS</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">FACTARAIDH einnseanaireachd a nì bathar a chleachdar ann an àiteachas.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">AGRICULTURAL ENGINEERING WORKS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
