    <!-- https://hist-arch-vocab.org/bvha#c_b78e308a -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b78e308a">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_69367952"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b320e26f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_d9d49e81"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-09T18:24:19.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T12:57:32.000</terms:modified>
        <skos:altLabel xml:lang="de">Zwingeranlage</skos:altLabel>
        <skos:altLabel xml:lang="cs">hradní příkop </skos:altLabel>
        <skos:definition xml:lang="de">Bei mittelalterlichen Burgen und Städten das Terrain zwischen äußerem und innerem Mauerring. Seit Barock auch als Vergnügungs- oder Festplatz umgebaut. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Geländestreifen zwischen der Ringmauer und einer weiteren, vorgelegten Mauer (Z.-Mauer, teils mit Flankierungstürmen versehen). Durch die Z.-Anlage wurde dem Gegner ein weiteres Annäherungshindernis entgegengelegt. Bisweilen konnten Z. Stallungen, Schuppen und Scheunen aufnehmen (Ortenberg HE). M. L. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:definition xml:lang="de">Parcham, Bereich zwischen zwei Wehrmauern oder Wällen, zumeist zwischen Ring- und Vormauer. Diente zur Verbesserung der Verteidigungsfähigkeit und war vor der Einführung der Feuerwaffen von Bedeutung, auch als Tiergehege oder für Wettkämpfe genutzt, wurde durch den Festungsbau abgelöst. [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">U středověkých hradů a měst prostor mezi vnější a vnitřní okružní hradbou; od baroka též přestavován jako slavnostní a zábavní prostor (Drážďany). [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Zwinger</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">bayle extérieur</skos:prefLabel>
        <skos:prefLabel xml:lang="en">outer courtyard, enclosure</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">parkán</skos:prefLabel>
        <skos:prefLabel xml:lang="it">pomerio</skos:prefLabel>
        <skos:prefLabel xml:lang="es">recinto exterior cercado</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_69367952"/>
    </owl:NamedIndividual>
    


