	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk000008">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Holländermühle</skos:altLabel>
		<skos:prefLabel xml:lang="de">Holländerwindmühle</skos:prefLabel>
		<skos:prefLabel xml:lang="en">smock mill</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk002571"/>
