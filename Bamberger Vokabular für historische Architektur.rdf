    <!-- https://hist-arch-vocab.org/bvha#c_763f693e -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_763f693e">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_myt7sb2b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T15:01:26.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-21T16:57:41.000</terms:modified>
        <skos:definition xml:lang="de">Hypokausten (griech. Heizung von unten), Warmluftheizung unter dem Fußboden von Wohn- und Baderäumen in der Antike, in mittelalterlichen Burgen und Klöstern. Ähnliche System weist die sogenannte » Kunst« im Schwarzwald und in der Schweiz auf. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Řecké topení odspodu. Topení horkým vzduchem pod podlahou obytných a lázeňských antických objektů, ve středověkých hradech a klášterech, podobný systém se vyskytuje i v oblasti Schwarzwaldu a ve Švýcarsku. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Hypokausten</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">hypokaust</skos:prefLabel>
    </owl:NamedIndividual>
    


