    <skos:prefLabel xml:lang="en">FLINT KILN</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Component part of a Flint Mill where flint is calcined before it is brittle enough to be ground in the mill. Ground, burnt flint is used in the production of earthenware pottery, which whitens and strenghens the body.</skos:scopeNote>
    <dc1:identifier rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/134654"/>
