        <skos:definition xml:lang="de">(Triklinium), Grundrissform des barocken Schlossbaus mit einem Hauptgebäude (Corps de Logis) und zwei meist kürzeren Seitenflügeln, die einen offenen Hof (Ehrenhof, Cour d\&apos;honneur) U-förmig umfassen. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Dreiflügelanlage</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">trojkřídlá dispozice</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_6a2b5c14 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_6a2b5c14">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
