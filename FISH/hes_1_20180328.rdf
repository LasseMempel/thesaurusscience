		<skos:prefLabel xml:lang="gd">GÀRRADH-CÙIL</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Gàrradh prìobhaideach a chaidh a chur air chois gus fàs a thoirt air glasraich is luibhean a chleachdar san taigh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">KITCHEN GARDEN</skos:prefLabel>
