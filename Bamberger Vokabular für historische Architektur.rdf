        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-12T10:23:40.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T23:20:06.000</terms:modified>
        <skos:altLabel xml:lang="cs">štítek</skos:altLabel>
        <skos:definition xml:lang="de">Scheibe in Glasmalerei mit dem Wappen einer Person oder Personengruppe als Stiftung an ein öffentliches Gebäude, mit einer Geldspende (»Bauschilling«) verbunden. Besonders in der Schweiz im 15. und 16. Jh. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Tabulka skla s namalovaným znakem určité osoby nebo skupiny osob jako donace pro veřejnou budovu, spjatá s určitým peněžním darem. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Wappenscheibe</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">tabulka s erbem</skos:prefLabel>
    </owl:NamedIndividual>
    


