	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk020967">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Briefwechsel</skos:altLabel>
		<skos:prefLabel xml:lang="en">correspondence</skos:prefLabel>
		<skos:altLabel xml:lang="de">Korrespondenz</skos:altLabel>
		<skos:prefLabel xml:lang="de">Schriftverkehr</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk005823"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk005824"/>
		<skos:definition xml:lang="de">Schriftverkehr ist ein Informationsmittel, in dem Informationen, Nachrichten oder Mitteilungen zwischen Personen, Organisationen oder Unternehmen schriftlich und adressiert ausgetauscht werden. Dieser schriftliche Austausch kann in Form von Briefen, E-Mails, Telegrammen, Berichten, Dokumenten, Notizen oder anderen schriftlichen Kommunikationsmitteln erfolgen.</skos:definition>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1277575"/>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300026877"/>
		<skos:mappingRelation rdf:resource="http://d-nb.info/gnd/4180011-4"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk005824"/>
