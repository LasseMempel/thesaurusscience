	<dct:spatial rdf:resource="http://vocab.getty.edu/tgn/7002444"/>
	<skos:altLabel xml:lang="en">Paleolithic</skos:altLabel>
	<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/EPR"/>
	<skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/11/concepts/505122"/>
