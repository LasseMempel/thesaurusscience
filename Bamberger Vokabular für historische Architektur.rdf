    <!-- https://hist-arch-vocab.org/bvha#c_a652dea1 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_a652dea1">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_3afe76f7"/>
