		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/647" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/848" />
		<skos:scopeNote xml:lang="en">Any building designed or adapted to accommodate trades and manufacturing activity. Use more specific site where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
