        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-18T15:21:30.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-24T16:57:09.000</terms:modified>
        <skos:altLabel xml:lang="en">clerical overcoat</skos:altLabel>
        <skos:altLabel xml:lang="en">quilted overcoat</skos:altLabel>
        <skos:definition xml:lang="de">Überzieher m: langer, lose fallender, bis zur Hüfte zweireihig geknöpfter Mantel, der etwa seit Mitte des 19. Jh. von Seminaristen, Priestern und Prälaten, ebenso wie vom Papst getragen wird. Der Mantel des Papstes ist weiß; derjenige aller anderen Kleriker schwarz. Die Knöpfe haben die gleiche Farbe wie der Mantel. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="cs">douillette</skos:prefLabel>
        <skos:prefLabel xml:lang="en">douillette</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">douillette d\&apos;ecclésiastique</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Überzieher</skos:prefLabel>
    </owl:NamedIndividual>
    


