		<skos:prefLabel xml:lang="de">Umzug (Veranstaltung)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Umzüge (Veranstaltungen)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk002840"/>
