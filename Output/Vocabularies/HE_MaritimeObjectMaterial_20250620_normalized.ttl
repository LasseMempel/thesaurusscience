    skos:prefLabel "Fibreglass"@en ;
    skos:related <http://purl.org/heritagedata/schemes/73/concepts/75361> ;
    skos:scopeNote "A material made from extremely fine fibres of glass and is used as a reinforcing agent for many polymer products."@en .

<http://purl.org/heritagedata/schemes/73/concepts/160192> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75405> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Chalk"@en ;
    skos:scopeNote "Soft, white, porous sedimentary rock, a form of limestone composed of the mineral calcite."@en .

<http://purl.org/heritagedata/schemes/73/concepts/164110> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75405> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
