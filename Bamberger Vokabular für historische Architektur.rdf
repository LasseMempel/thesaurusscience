        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-18T08:45:51.000</terms:modified>
        <skos:definition xml:lang="de">Fensterform des späten 19. Jh., aus dem Fenster mit Kreuzstock entwickelt. Ein ungeteiltes Oberlicht liegt über zwei Flügeln mit aufgehendem Pfosten. [Noky 1996]</skos:definition>
        <skos:prefLabel xml:lang="de">Galgenfenster</skos:prefLabel>
        <broaderByConstruction rdf:resource="https://hist-arch-vocab.org/bvha#c_f88a153a"/>
    </owl:NamedIndividual>
    


