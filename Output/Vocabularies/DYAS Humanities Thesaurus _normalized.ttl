        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/71>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/716> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1407> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1218> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Proxenia decrees"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2080>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2081>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2082>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2083>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2087>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2198>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Decrees by which a city expresses gratitude to a foreign citizen, who has undertaken to host or serve its citizens in his home city presenting them to the competent authorities and representing them wherever necessary."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1462> a skos:Concept ;
    skos:altLabel "Biological diversity"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/28> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Biodiversity"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1538>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1602>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1603>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2223>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2362>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2426>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2458> ;
    skos:scopeNote "Biodiversity may express the variety of species (plants, animals, fungi and microorganisms) in a natural community or habitat; the genetic variation in a species or among the populations of the same species; and the variety of ecosystems in a given region."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1507> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1445> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Solidi"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1501>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2121>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2353>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2372>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2375>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2376> ;
    skos:scopeNote "Gold Roman coins that were first introduced by Constantine in 310 CE and gradually replaced aureus. They weighted 1/72 of a Roman libra and they continued to be used during the Byzantine period."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/157> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/33> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Provision of knowledge and expertise"@en ;
    skos:scopeNote "This term classifies disciplines about activities aiming at the provision and communication of already acquired knowledge and expertise. In this sense, the activities classified under this term do not aim to produce new knowledge and/or expertise or to change the existing, but to maintain it (e.g. teaching, provision of services)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1583> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/34> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Religious offices"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/430>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/458>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/575>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/627> ;
    skos:scopeNote "Types of institutionalized roles attributed to persons or groups of persons, which grant specific authorities of control, governance and administration within the framework of a religious organization or community. Religious offices, being sources of power, often constitute fields of antagonism and contestation and are subject to dynamic development over time."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1715> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Prytanis (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1218>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1716>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1721>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1722>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2442>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/742> ;
    skos:scopeNote "An office that first appears in ancient Athens during the times of Athenian politician Cleisthenes. The office of prytanis was assumed by members of the Council of Five Hundred who constituted a prytany. Their main tasks were to determine the matters on which the Council was to decide and to draw up the agenda for meetings of the Assembly."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1716> a skos:Concept ;
    skos:altLabel "Heads of prytaneis"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Epistates ton prytaneon (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1218>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1651>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1715>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1721>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1722>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/69>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/742> ;
    skos:scopeNote "An office that first appears in ancient Athens during the times of Athenian politician Cleisthenes. The term refers to the holder of an office, a different person, each day who was chosen by lot among the members of a prytany. If the Council or the Assembly met on that day, the Epistates served as the president of the Council or the Assembly, and his name was recorded in the prescript of decrees."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1801> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/248> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Geistes- und Kulturwissenschaften"@de,
        "Humanities"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2525> ;
    skos:scopeNote "The Humanities can be described as the branches of knowledge that study how people document, process, and interpret the human experience over time. According to one of the most widely used classification systems, these are Language studies, Classics, Literature, History, Archaeology, Philosophy, Anthropology, Religious studies, Law and the Arts."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2080> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Proxenos (city-state period)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1407>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2081>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2082>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2083>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2087>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2198>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2441> ;
    skos:scopeNote "An office that appears in ancient Athens. The Athenian Demos awarded the office of proxenos to foreign citizens who served the interest of Athenians in their city, either in private affairs (usually commercial) or in public, inter-state matters (e.g. embassies). Proxenoi ensured that hospitality was extended to Athenians in their city, presented them to the competent officials and represented them where this was deemed necessary."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2195> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2529> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Astronomy"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1495>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2105>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2106>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2432>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2604>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2605>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2611> ;
    skos:scopeNote "The science that studies the physics and morphology of space beyond the earth and its atmosphere. From antiquity until the 17th century, astronomy was one of the mathematical arts and focused on the description and calculation of apparent motions and positions of the then-known celestial bodies (Sun, Moon and planets) both for theoretical and practical purposes, relating to horoscopes, time, calendar, navigation and natural disasters. In the 17th century astronomy became part of the natural philosophy, claiming to describe how the structure of the universe and the motions of celestial bodies were in reality and not just seemingly."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2277> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/240> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Premonetary means of exchange"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1444> ;
    skos:scopeNote "The practices and transaction units used by human societies to assess values and wealth savings up to the invention of coined money."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/232> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/20> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Confrontations or conflicts"@en ;
    skos:scopeNote "This term classifies complex activities (a combination of activities) that presuppose at least two actors or groups of actors, who understand their interests and demands as competitive and thus aim at their satisfaction through their involvement in situations of controversy (coups d’etat, legal actions, wars, revolutions, strikes et c.)"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/236> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Prosody"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/129>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/244>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/287>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/43>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/560>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/665>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/78> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2424> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2002> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Physical and earth science professionals"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/148>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1495>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1602>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1610>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2377>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2529>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2626> ;
    skos:scopeNote "Physical and earth science professionals conduct research; improve or develop concepts, theories and operational methods; or apply scientific knowledge relating to fields such as physics, astronomy, meteorology, chemistry, geology and geophysics. Tasks performed usually include: enlarging scientific knowledge through research and experiments related to mechanics, thermodynamics, optics, sonics, electricity, magnetism, electronics, nuclear physics, astronomy, various branches of chemistry, atmospheric conditions and the physical nature of the Earth; advising on or applying this knowledge in such fields as manufacturing, agriculture, medicine, navigation, space exploration, oil, gas, water and mineral exploitation, telecommunications and other services, or civil engineering; preparing scientific papers and reports."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/244> a skos:Concept ;
    skos:altLabel "Lyric (poetry)"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Sung verse"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/236>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/392>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/429>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/560>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/696>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/727> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2448> a skos:Concept ;
    skos:altLabel "STS"@en,
        "Science, technology and society"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/248> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Science and technology studies"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1657>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2440>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2469>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2470>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2475>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2529>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2582> ;
    skos:scopeNote "The interdisciplinary field which is the result of the intersection of work by sociologists, historians, philosophers, anthropologists, and others who study science, technology and medical science exclusively or primarily as social activities, investigating their complex relationships with power, politics, economy and culture. Within the STS various research areas and approaches have been developed, with distinct or intersecting methods, such as social constructivism, laboratory studies, ethnomethodology, engineering studies, actor-network theory, gender and technology studies, experts and expertise, science and technology communication and many others."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2458> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2529> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Evolutionary biology"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1462>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1538>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1602>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2223>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2362>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2434>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2457> ;
    skos:scopeNote "Discipline of biology (and ecology) that is devoted to understanding the origin and maintenance of biological diversity. It is directly concerned with evolutionary processes leading to the origin of new species, and with descent from shared ancestors. It also studies the characteristics, behaviour and systematics of populations of organisms. As a discipline it has roots in the theories of evolution of 18th and 19th centuries, but in its modern form it was established in the 1930s through the formation of the new-Darwinian synthesis, which was a union of darwinism and genetics, combining elements of genetics, ecology, systematics and paleontology."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2467> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2529> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Chemistry"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1602>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1610>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1641>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2377>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2476>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2477>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2542> ;
    skos:scopeNote "The branch of science that studies the composition and structure of matter, and the changes that matter undergoes. It focuses on the study of elements and the compounds they form, and it is mainly concerned with effects that depend on the outer electrons in atoms. Its shaping as a science started in the 17th century, whereas the establishment of its scientific character took place in the late 18th century with the discovery of oxygen and the understanding of the function of combustion. The 19th century, which is a landmark for the demarcation of scientific disciplines, designated chemistry&#39;s affinities with other sciences (e.g. with physics, biology, physiology, geology), since their disciplinary boundaries were often renegotiated. It also designated its affinities with industry, agriculture and technology, which defined chemistry&#39;s identity over the next centuries."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/315> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/20> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2516>,
