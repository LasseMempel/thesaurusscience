<http://www.eionet.europa.eu/gemet/concept/1759> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6465> ;
    skos:closeMatch <http://data.uba.de/umt/_00006423> ;
    skos:definition "The amount or quantity of polluting material found in a transporting agent that flows at a steady rate, in contrast to a sudden or dramatic influx."@en ;
