	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk015701">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Bügelfries</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk001994"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk001994"/>
		<skos:definition xml:lang="de">Bügelfries ist ein Fries, der als Schmuckform im Fachwerkbau, z.B. auf der Schwelle, kommt. Dabei wird die Fläche des Frieses durch klammer-, bügel- oder trapezförmige Verzierungen rhythmisiert.</skos:definition>
