				<skos:prefLabel xml:lang="gd">CLACH-THACHAIS</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Clach mhòr as urrainn dhan chrodh suathadh ris agus iad fhèin a sgròbadh mar sin.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">RUBBING STONE</skos:prefLabel>
