    <!-- https://hist-arch-vocab.org/bvha#c_c5af4126 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_c5af4126">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a2025113"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-16T12:12:38.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T13:43:00.000</terms:modified>
        <skos:altLabel xml:lang="de">Danzker</skos:altLabel>
        <skos:definition xml:lang="de">Abortanlage in den Ordensburgen (Marienwerder PL, Thorn PL), gekennzeichnet durch einen frei im Wasser stehenden Turm, der durch einen gedeckten, über den Graben führenden Brückengang von der Burg aus zugänglich war. Die D., 1393 als solche bezeichnet, stammen aus dem 13. und 14. Jh. H. W. B. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:prefLabel xml:lang="de">Dansker</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">záchodová věž </skos:prefLabel>
    </owl:NamedIndividual>
    


