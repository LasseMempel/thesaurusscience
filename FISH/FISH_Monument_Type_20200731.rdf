    <skos:scopeNote xml:lang="en">A factory manufactoring caravans.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/83578">
    <skos:scopeNote xml:lang="en">A site, including hangars, moorings and ancillary buildings, used for the storage, maintenance, take off and landing of airships.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93714">
