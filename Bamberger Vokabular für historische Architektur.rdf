    <!-- https://hist-arch-vocab.org/bvha#c_fa78a1c4 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_fa78a1c4">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_174d6ba6"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_6bbae62d"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f59d9141"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_5ff5dad9"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-28T09:09:03.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T11:33:53.000</terms:modified>
        <skos:altLabel xml:lang="fr">bois de clayonnage</skos:altLabel>
        <skos:altLabel xml:lang="fr">polisson</skos:altLabel>
        <skos:altLabel xml:lang="en">stake</skos:altLabel>
        <skos:definition xml:lang="de">1. Ausfüllung der Balkengefache einer Wand oder Decke mit Stakhölzern, die verflochten und mit Strohlehm umgeben sind. 2. Abkreuzung (Versteifung) von Balken durch kreuzweise angeordnete Stakhölzer (Kreuzstakung). [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Staken: meist gespaltene, halbrunde oder eckige Hölzer.\n(Eißing et al. 2012)\n</skos:definition>
        <skos:prefLabel xml:lang="de">Stake</skos:prefLabel>
        <skos:prefLabel xml:lang="it">introduzione di torselli fra le travi</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">palancon</skos:prefLabel>
        <skos:prefLabel xml:lang="en">pole</skos:prefLabel>
        <skos:prefLabel xml:lang="es">tapiar</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">výplň polí příhradoviny lepenicí s pruty a větvemi (pl.)</skos:prefLabel>
    </owl:NamedIndividual>
    


