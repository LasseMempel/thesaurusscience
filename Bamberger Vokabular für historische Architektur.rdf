        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T15:24:58.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T15:59:39.000</terms:modified>
        <skos:definition xml:lang="de">Bildnerei, seit den Anfängen der Geschichte vorhandene körperbildende Kunst. Formen: Vollplastik und Relief (Bauplastik). Materialien: Bronze, Stein, Holz, Ton, Elfenbein, Wachs, Edelmetalle, Kunststoffe u. a. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Umění vytvářející od počátku dějin hmotná, trojrozměrná díla. Druhy: plná plastika a reliéf (viz architektonická plastika). Materiály: bronz, kámen, dřevo, hlína, slonovina, vosk, ušlechtilé kovy, plastické hmoty aj. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Bildhauerkunst</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">sochařství</skos:prefLabel>
    </owl:NamedIndividual>
    


