    <!-- https://hist-arch-vocab.org/bvha#c_93b9ef28 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_93b9ef28">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_d936f79a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_b41bd73a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-13T17:10:33.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T14:42:54.000</terms:modified>
        <skos:altLabel xml:lang="de">Schubstange</skos:altLabel>
        <skos:definition xml:lang="de">Beschlag zum Feststellen des v. i. linken Flügels bei Fenstern mit aufgehendem Pfosten und Reibern oder Ruderverriegelung. Am oberen und unteren Ende des v. i. rechten Höhenschenkel des linken Flügels sind sie auf das Holz aufgesetzt oder in das Holz eingelassen und werden in Ausnehmungen im Querholz und an Ober- und / oder Unterschenkel des Fensterrahmens geschoben. [Noky 1996]</skos:definition>
        <skos:prefLabel xml:lang="de">Schubriegel</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_93c80c29 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_93c80c29">
