  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70044">
    <skos:scopeNote xml:lang="en">A stony mound containing or concealing deliberately deposited human remains. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92041">
    <skos:scopeNote xml:lang="en">A house with a pitched roof with a double slope and gables on the front and rear elevations of the building.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91285">
