    <!-- https://hist-arch-vocab.org/bvha#c_9af0d6ac -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_9af0d6ac">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1c8ef562"/>
