    <!-- https://hist-arch-vocab.org/bvha#c_6507148e -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_6507148e">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_9b5b214b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
