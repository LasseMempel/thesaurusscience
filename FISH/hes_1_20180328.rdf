		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1754" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/503166" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/504180" />
		<skos:scopeNote xml:lang="en">A freestanding building, or a room or recess serving as a place of Christian worship in a church or other building.</skos:scopeNote>
