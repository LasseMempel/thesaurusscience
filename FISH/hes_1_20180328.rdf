	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1234">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1234</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH EINNSEAN-DÈILE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar sa bheil einnsean sparra.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BEAM ENGINE HOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
