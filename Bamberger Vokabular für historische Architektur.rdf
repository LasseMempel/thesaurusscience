        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T16:10:59.000</terms:modified>
        <skos:definition xml:lang="de">Eine Anordnung von Spitzhieben auf einer Werksteinoberfläche. Diese folgen, je nach Herstellungswerkzeug, Bahnen in gerader oder gebogener und manchmal auch einer wilden Form. [BVHA]</skos:definition>
        <skos:prefLabel xml:lang="de">Grobe Abspitzung</skos:prefLabel>
    </owl:NamedIndividual>
    


