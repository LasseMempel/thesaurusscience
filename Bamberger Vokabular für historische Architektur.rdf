        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-09T17:40:05.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:52:31.000</terms:modified>
        <skos:altLabel xml:lang="de">schräges Gewölbe</skos:altLabel>
        <skos:altLabel xml:lang="en">skew vault</skos:altLabel>
        <skos:altLabel xml:lang="en">vault with an oblique axis</skos:altLabel>
        <skos:altLabel xml:lang="fr">voûte à axe biais </skos:altLabel>
        <skos:definition xml:lang="de">Ein Gewölbe, meist eine Tonne, dessen Achse nicht rechtwinklig zur HörizontaIprojektion des Stirnbogens verläuft. Die Grundfläche des überwölbten Raumes ist meist rautenförmig. Das schiefe Gewölbe verlangt Keilsteine mit einem besonderen, schrägen Fugenschnitt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="en">oblique vault</skos:prefLabel>
        <skos:prefLabel xml:lang="de">schiefes Gewölbe</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte biaise</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_049c4c22"/>
    </owl:NamedIndividual>
    


