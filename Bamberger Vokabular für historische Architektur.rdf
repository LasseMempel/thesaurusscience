        <skos:definition xml:lang="de">Eine Reihe schräg liegender Backsteine bei gewissen Mauer- oder Gewölbeverbänden. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Schrägschar</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">řada cihel při klenutí &quot;na vlaštovčí ocas&quot;</skos:prefLabel>
    </owl:NamedIndividual>
    


