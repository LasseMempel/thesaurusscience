    <!-- https://hist-arch-vocab.org/bvha#c_2607d677 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_2607d677">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1f0a3ce6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_jquheldj"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-17T14:33:00.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T14:40:41.000</terms:modified>
        <skos:definition xml:lang="de">Architekt (gr. architekton: Erzfüger). Der A. versucht, die Umwelt menschl. Bedürfnissen entsprechend zu ordnen und einzurichten und den Lebensraum oder seine Teile nach den Regeln der Baukunst zu gestalten (Architektur). Der Stand des A.en entwickelte sich vom Leiter der Bauleute (Parlier, Polier: Sprecher) und Werkmeister (magister operis, wercmeistere) zum entwerfenden und theoretisierenden Künstler, der mit dem konstruierenden und experimentierenden Ingenieur verantwortl. Planer wird. Als Attribute des A.en gelten Richtscheit, Winkel, Lotwaage und Zirkel. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Architekt</skos:prefLabel>
    </owl:NamedIndividual>
    


