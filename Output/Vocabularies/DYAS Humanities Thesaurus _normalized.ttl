    skos:prefLabel "Serpentine script style"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/69> ;
    skos:scopeNote "Inscription text layout, according to which the direction of the text follows a path that resembles a snake movement."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/900> a skos:Concept ;
    skos:altLabel "Rotogravure printing"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/378> ;
