<https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme/concept532> a skos:Concept ;
    skos:broader <https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme/concept516> ;
    skos:definition "Relative dating is determining the order of events. In archaeology stratigraphy, typology, cross-dating , and sequence dating are used."@en ;
    skos:inScheme <https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme> ;
