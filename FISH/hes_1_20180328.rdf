				<skos:prefLabel xml:lang="gd">GEADAG BIOLAIR-UISGE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Planntachadh biolair-uisge, mar is trice faisg air fuaran no uillt bheaga.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">WATERCRESS BED</skos:prefLabel>
