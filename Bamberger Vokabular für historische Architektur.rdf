        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-21T17:14:13.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T13:55:08.000</terms:modified>
        <skos:definition xml:lang="de">Eine von Säulen (Säulenp.), seltener von Pfeilern getragene Vorhalle vor der Hauptfront eines Gebäudes. Bes. häufig kommt die P. in der klassizist. Architektur vor. Auch eine Säulenhalle mit geschlossener Rückwand (ähnlich der Stoa). [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Portikus m (lat., ›Säulenhalle‹), ein an den Seiten offener oder geschlossener, von Säulen getragener Raum vor dem Eingang oder der Mitte eines Gebäudes. Der aus dem römischen Tempelbau übernommene P. wird an Schlössern der Barockzeit (Schloss Pillnitz / Dresden S) und des Klassizismus (Schloss Rosenstein / Stuttgart BW) als offene Säulenhalle zur Betonung der Mitte verwendet. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:definition xml:lang="cs">Předstupující část stavby na straně hlavního vchodu, nesená sloupy nebo pilíři, často s trojúhelníkovým štítem, antika, renesance až klasicismus. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Vorbau an der Haupteingangsseite, von Säulen oder von Pfeilern getragen, häufig mit Dreiecksgiebel. Antike, Renaissance bis Klassizismus. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="fr"> portique</skos:prefLabel>
        <skos:prefLabel xml:lang="es"> pórtico</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Portikus</skos:prefLabel>
        <skos:prefLabel xml:lang="en">portico</skos:prefLabel>
        <skos:prefLabel xml:lang="it">portico</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">portikus</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_de30207d"/>
    </owl:NamedIndividual>
    


