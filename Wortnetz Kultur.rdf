		<skos:prefLabel xml:lang="de">Weichtier</skos:prefLabel>
		<skos:altLabel xml:lang="de">Weichtiere</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk001769"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk018121"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk001769"/>
		<gvp:aat2801_conjuncted_with rdf:resource="http://lvr.vocnet.org/wnk/wk010504"/>
		<skos:definition xml:lang="de">Weichtiere sind wirbellose Tiere mit einem weichen Körper, der meist in vier Abschnitte (Kopf, Fuß, Eingeweidesack und Mantel) gegliedert ist. Viele Weichtiere bilden Hartteile, häufig in Form einer Schale oder eines Gehäuses. Sie besiedeln zahlreiche Lebensräume der Erde mit Ausnahme der Polargebiete und Hochgebirgsregionen. Bekannte Vertreter sind Schnecken (Gastropoden), Muscheln (Bivalven) oder Kopffüßer (Cephalopoden).</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4189417-0"/>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300266510"/>
