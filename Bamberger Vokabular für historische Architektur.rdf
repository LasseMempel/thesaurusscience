        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_hvqjmvb3"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-23T08:06:28.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-12-03T15:15:34.000</terms:modified>
        <skos:definition xml:lang="de">Jedes nicht klare Glas, dessen Farbe in Abhängigkeit von seinen Rohstoffen zwischen stark bräunlich und stark grünlich liegt. Wasserklares (sog. optisches) Glas kann nur mit ausgesuchten Zutaten und durch eine Beimengung von Chemikalien erreicht werden. [Pax - Fenster &amp; Türen Fachbegriffe]</skos:definition>
        <skos:prefLabel xml:lang="de">Buntglas</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_bd2f1d31 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_bd2f1d31">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_86c8b719"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_d96402bc"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
