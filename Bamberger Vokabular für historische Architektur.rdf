        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-12T16:28:29.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T14:22:15.000</terms:modified>
        <skos:definition xml:lang="de">Muqarnas, zellenartiges Schmuckelement der islam. Baukunst. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Stalaktit</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">stalaktit</skos:prefLabel>
    </owl:NamedIndividual>
    


