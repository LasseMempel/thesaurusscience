        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-31T11:08:40.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T14:40:27.000</terms:modified>
        <skos:definition xml:lang="de">Turmkreuz n: ein Kreuz auf der Spitze eines Kirchturms. Es trägt oft einen Wetterhahn. Der Hahn ist Symbol des reuigen Sünders (Verleugnung Christi durch Petrus, Mt 26, 34) und der Erweckung (Christus, der die Sünder aufweckt). [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Turmkreuz</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">croix de flèche </skos:prefLabel>
        <skos:prefLabel xml:lang="en">spire-cross</skos:prefLabel>
    </owl:NamedIndividual>
    


