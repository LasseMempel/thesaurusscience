	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1517">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1517</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">UCHDAN-DÌON</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Uchdan no tom ùir a chaidh a chleachdadh mar rampair no daingneachadh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">EARTHWORK</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">EARTHWORK CASTLE</skos:altLabel>
		<skos:altLabel xml:lang="en">EARTHWORK FORTIFICATION</skos:altLabel>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1518" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1465" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1523" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1442" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1564" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/504824" />
		<skos:scopeNote xml:lang="en">A bank or mound of earth used as a rampart or fortification.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1518">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1518</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">STRUCTAR-ÙIR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar ùir, sgratha 's cloiche loidhneach no lùb-loidhneach gu tric ach chan ann an-còmhnaidh le dìg. Cleachd seòrsa nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BANK (EARTHWORK)</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">EARTHEN BANK</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1517" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1520" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1521" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1466" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1454" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/317" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/318" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/394" />
		<skos:scopeNote xml:lang="en">Linear or curvilinear construction of earth, turf and stone, often, but not always accompanied by a ditch. Use specific type where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1520">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1520</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">UCHDAN  CEARCALLACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Lann chearcallach mun a bheil uchdan ach gun dìg. Cleachd seòrsa nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">RING BANK</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1518" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1466" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1521" />
		<skos:scopeNote xml:lang="en">Circular enclosure featuring an enclosing bank with no accompanying ditch. Use specific type where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
