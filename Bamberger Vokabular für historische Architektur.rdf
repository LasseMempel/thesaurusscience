        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-16T23:01:40.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T16:44:18.000</terms:modified>
        <skos:altLabel xml:lang="de">Kircheninventar</skos:altLabel>
        <skos:definition xml:lang="de">Schatzverzeichnis n; präzis. Kircheninventar n; lat. repertorium bonorum ecclesiasticorum: Verzeichnis der Besitztümer einer Kirche. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de"> Schatzverzeichnis</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">inventaire d\&apos;un trésor d\&apos;église</skos:prefLabel>
        <skos:prefLabel xml:lang="en">inventory of church treasury</skos:prefLabel>
        <skos:prefLabel xml:lang="la">repertorium bonorum ecclesiasticorum</skos:prefLabel>
    </owl:NamedIndividual>
    


