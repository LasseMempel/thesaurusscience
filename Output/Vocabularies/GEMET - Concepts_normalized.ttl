    skos:definition "The production, distribution, and consumption of usable power such as fossil fuel, electricity, or solar radiation."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Energiewirtschaft"@de,
