        <skos:prefLabel xml:lang="fr">chasuble (brodée) à deux faces</skos:prefLabel>
        <skos:prefLabel xml:lang="en">reversible chasuble</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_d1a705c6"/>
    </owl:NamedIndividual>
    


