        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-09T19:35:20.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-08T14:22:10.000</terms:modified>
        <skos:definition xml:lang="de">Musivische Arbeit, Einlegearbeit aus Steinen oder Glasstücken oder aus zurechtgeschnittenen und eingefassten Glasscherben. [Koepf / Binding 2016]</skos:definition>
