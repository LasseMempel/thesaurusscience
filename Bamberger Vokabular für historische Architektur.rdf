    <!-- https://hist-arch-vocab.org/bvha#c_kqjbswgs -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_kqjbswgs">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_4mgalztg"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_847c0729"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_jqmv6iaq"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
