        <skos:altLabel xml:lang="en">columned hall</skos:altLabel>
        <skos:altLabel xml:lang="cs">hypostyl</skos:altLabel>
        <skos:altLabel xml:lang="it">portico colonnato</skos:altLabel>
        <skos:altLabel xml:lang="cs">portikus</skos:altLabel>
        <skos:altLabel xml:lang="es">pórtico</skos:altLabel>
