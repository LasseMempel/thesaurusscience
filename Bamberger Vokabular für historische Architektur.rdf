        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_c0b4d263"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_c3660820"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_c591c1ca"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_cd5e1eb9"/>
