  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142997">
    <skos:scopeNote xml:lang="en">Residence of a leading land-holding family within the district.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71663">
    <skos:scopeNote xml:lang="en">An educational institution for the training of teachers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91735">
    <skos:scopeNote xml:lang="en">A school where theological subjects are taught.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92893">
    <skos:scopeNote xml:lang="en">A cutting through a wood to open up a view or establish an allee.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70190">
    <skos:scopeNote xml:lang="en">An approximately circular or oval setting of spaced, usually freestanding, upright stones. More than one circle may be present, arranged concentrically.</skos:scopeNote>
  </rdf:Description>
