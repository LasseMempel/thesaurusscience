    <!-- https://hist-arch-vocab.org/bvha#c_023ba6a4 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_023ba6a4">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
