    skos:prefLabel "Atemtrakt"@de,
        "respiratory tract"@en .

<http://www.eionet.europa.eu/gemet/concept/7187> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/767> ;
    skos:closeMatch <http://data.uba.de/umt/_00006429> ;
    skos:definition "Resistant structure that allows the organism to survive adverse environmental conditions."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Dauerform"@de,
        "resting form"@en ;
    skos:scopeNote "resistant form of life, like spores, resting eggs, seeds  <D>"@en .

<http://www.eionet.europa.eu/gemet/concept/7189> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13187> ;
    skos:closeMatch <http://data.uba.de/umt/_00028758> ;
    skos:definition "Procedure or course of action taken to reestablish or bring back to state of environmental or ecological health."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Sanierungsmassnahme"@de,
        "restoration measure"@en .

<http://www.eionet.europa.eu/gemet/concept/719> a skos:Concept ;
    skos:broadMatch <http://eurovoc.europa.eu/1882> ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2637> ;
    skos:closeMatch <http://data.uba.de/umt/_00003733>,
        <http://dbpedia.org/resource/Barium> ;
    skos:definition "A soft silvery-white metallic element of the alkaline earth group. It is used in bearing alloys and compounds are used as pigments."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_819> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Barium"@de,
        "barium"@en .

<http://www.eionet.europa.eu/gemet/concept/7191> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2009> ;
    skos:closeMatch <http://data.uba.de/umt/_00019827> ;
    skos:definition "Any decision, action or policy which limits or constrains the making of valued goods or services."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/3633> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Produktionsbeschränkung"@de,
        "restriction of production"@en .

<http://www.eionet.europa.eu/gemet/concept/7192> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:closeMatch <http://data.uba.de/umt/_00002387> ;
    skos:definition "A limitation on the utilization of land or some other property, often inscribed in a deed or lease document."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Anwendungsbeschränkung"@de,
        "restriction on use"@en .

<http://www.eionet.europa.eu/gemet/concept/7193> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8563> ;
    skos:closeMatch <http://data.uba.de/umt/_00007732> ;
    skos:definition "The sale of goods to ultimate consumers, usually in small quantities."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/5> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Einzelhandel"@de,
        "retail trade"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Retailing> .

<http://www.eionet.europa.eu/gemet/concept/7194> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4234> ;
    skos:closeMatch <http://data.uba.de/umt/_00021119> ;
    skos:definition "A basin designed and operated to provide temporary storage and thus reduce the peak flood flows of a stream."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Rückhaltebecken"@de,
        "retarding basin"@en .

<http://www.eionet.europa.eu/gemet/concept/7195> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:closeMatch <http://data.uba.de/umt/_00017707>,
        <http://dbpedia.org/resource/Retrofitting> ;
    skos:definition """1) Addition of a pollution control device on an existing facility without making major changes to the generating plant.
2) Providing a jet, an automobile, a computer, or a factory, for example, with parts, devices or equipment not in existence or available at the time of original manufacture."""@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Nachrüstung"@de,
        "retrofitting"@en .

<http://www.eionet.europa.eu/gemet/concept/7197> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5003> ;
    skos:closeMatch <http://data.uba.de/umt/_00003534> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Auswilderung"@de,
        "return to nature"@en .

<http://www.eionet.europa.eu/gemet/concept/72> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:closeMatch <http://data.uba.de/umt/_00001474>,
        <http://dbpedia.org/resource/Activated_carbon> ;
    skos:definition "A powdered, granular or pelleted form of amorphous carbon characterized by a very large surface area per unit volume because of an enormous number of fine pores."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_15934> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Aktivkohle"@de,
        "activated carbon"@en .

<http://www.eionet.europa.eu/gemet/concept/7202> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7104> ;
    skos:closeMatch <http://dbpedia.org/resource/Revegetation> ;
    skos:definition "Planting of new trees and, particularly, of native plants in disturbed sites where the vegetation cover has been destroyed, to stabilize the land surface from wind and water erosion and to reclame the land for other uses. Revegetation practices are employed in mined lands, roadsides, parks, wetlands, utility corridors, riparian areas, etc."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_26815> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Wiederbegrünung"@de,
        "revegetation"@en .

<http://www.eionet.europa.eu/gemet/concept/7204> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5949> ;
    skos:closeMatch <http://data.uba.de/umt/_00025062>,
        <http://dbpedia.org/resource/Reverse_osmosis> ;
    skos:definition "A method of obtaining pure water from water containing a salt, as in desalination. Pure water and the salt water are separated by a semipermeable membrane and the pressure of the salt water is raised above the osmotic pressure, causing water from the brine to pass through the membrane into the pure water. This process requires a pressure of some 25 atmospheres, which makes it difficult to apply on a large scale."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_26870> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Umkehrosmose"@de,
        "reverse osmosis"@en .

