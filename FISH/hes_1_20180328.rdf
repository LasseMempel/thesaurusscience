		<skos:prefLabel xml:lang="gd">CAMPA COLBY</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Campa sealach, gu math tric air talamh àrd, far an robh an t-Suirbhidh Òrdanais stèidhichte 's iad air falbh air na h-iomairtean mapachaidh aca. Ainmichte air Màidsear-seanalair Thomas Colby, stiùirich na Suirbhidhe Òrdanais, 1820 - 1846.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">COLBY CAMP</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-04-12T11:33:49</dcterms:created>
