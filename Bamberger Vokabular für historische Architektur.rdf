        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_45f45045"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T17:38:27.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-02T12:26:27.000</terms:modified>
        <skos:definition xml:lang="de">Rinnleiste der dor., der ion. und anderer antiker Ordnungen.[Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Traufgesims am antiken Gebälk. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Též zvonovnice. Architektonický článek ve tvaru písmene S, tj. konkávně konvexně profilovaný; podle funkce rozlišujeme nosnou simu, nebo ukončovací simu, jako horní ukončení např. u říms, podle uspořádání rozlišujeme stoupající simu, je-li vydutá část profilu nahoře (např. u sloupových hlavic), a klesající simu, je-li vydutá část profilu dole. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Sima</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">sima</skos:prefLabel>
    </owl:NamedIndividual>
    


