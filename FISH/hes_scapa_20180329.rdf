	<skos:prefLabel xml:lang="en">Early Iron Age</skos:prefLabel>
	<skos:prefLabel xml:lang="gd">Linn an Iarainn tràth</skos:prefLabel>
	<skos:scopeNote xml:lang="en">The earliest subdivision of the Iron Age in Scotland.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="http://purl.org/heritagedata/schemes/scapa/concepts/EM">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
	<cc:attributionURL rdf:resource="https://www.historicenvironment.scot/"/>
	<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence"/>
	<dct:identifier rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/EM"/>
	<dct:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence"/>
	<dct:spatial rdf:resource="http://dbpedia.org/resource/Scotland"/>
	<dct:spatial rdf:resource="http://vocab.getty.edu/tgn/7002444"/>
	<skos:altLabel xml:lang="en">Dark Age</skos:altLabel>
	<skos:altLabel xml:lang="en">Early Mediaeval</skos:altLabel>
	<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/PRO"/>
	<skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/11/concepts/505127"/>
	<skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/EM"/>
	<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300020760"/>
	<skos:editorialNote xml:lang="en">Preferred term for a range of cultural and other labels.***note that some consider the Long Iron Age to continue well into the Early Medieval period</skos:editorialNote>
	<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/scapa"/>
	<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/AN"/>
	<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/ASA"/>
	<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/LEM"/>
	<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/LON"/>
	<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/NO"/>
	<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/PI"/>
	<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/SA"/>
	<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/VK"/>
	<skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EM</skos:notation>
	<skos:prefLabel xml:lang="en">Early Medieval</skos:prefLabel>
	<skos:prefLabel xml:lang="gd">Tràth sna meadhan linntean</skos:prefLabel>
	<skos:scopeNote xml:lang="en">Early medieval Scotland can be defined by the adoption of Christianity and emergence of identity from cultural groupings leading to state formation after the end of the Roman Empire. Overlaps with the end of the Long Iron Age.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="http://purl.org/heritagedata/schemes/scapa/concepts/EME">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
