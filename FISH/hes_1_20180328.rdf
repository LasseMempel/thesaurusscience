				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502178</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">LÀRACH CHUNGAIDHEAN-LEIGHIS CEIMIGEACH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Làraichean far a bheilear a' dèanamh cungaidhean-leighis is bathar meadaigeach eile.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">PHARMACEUTICAL CHEMICAL SITE</skos:prefLabel>
