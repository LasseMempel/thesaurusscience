    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Tripod Pipkin"@en ;
    skos:scopeNote "A jar adapted by the addition of a straight handle and three feet. Profiles vary and should be double indexed with the appropriate JAR type. (Source: MPRG)"@en .

