        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_aa7a9a9b"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_d0ef8eb2"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_e3ddd266"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_fa347a71"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-03T13:06:13.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T17:40:36.000</terms:modified>
        <skos:altLabel xml:lang="la">sarcotium</skos:altLabel>
        <skos:definition xml:lang="de">Rochett n, rochettum, sarcotium: etwa bis zum 15. Jh. ein knöchellanges, später verkürztes und vom 18. Jh. an nur noch hüftlanges, weißes Leinengewand mit engen Ärmeln und reichem Spitzenbesatz; Bestandteil der Chorkleidung der höheren Geistlichkeit; bei den regulierten Chorherren wird es im 17. Jh. zu einem langen, schmalen, weißen Band mit der Bezeichnung Sarrozium n; --&gt; Superpelliceum, --&gt; Augustiner-Chorherren. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Rochett</skos:prefLabel>
        <skos:prefLabel xml:lang="en">rochet</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">rochet</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">rocheta</skos:prefLabel>
        <skos:prefLabel xml:lang="la">rochettum</skos:prefLabel>
    </owl:NamedIndividual>
    


