  <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142868">
    <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2"/>
    <skos:prefLabel xml:lang="en">NODAL POINT</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A designated area, usually sited at a strategic crossroads, with fixed defences such as pillboxes, anti tank ditches and gun emplacements, designed to act as a rallying point for defenders.</skos:scopeNote>
    <dc1:identifier rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142868"/>
