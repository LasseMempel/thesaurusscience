    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Energiemarkt"@de,
        "energy market"@en .

<http://www.eionet.europa.eu/gemet/concept/2736> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2749> ;
    skos:closeMatch <http://data.uba.de/umt/_00008144>,
        <http://dbpedia.org/resource/Energy_recovery> ;
    skos:definition "A form of resource recovery in which the organic fraction of waste is converted to some form of usable energy. Recovery may be achieved through the combustion of processed or raw refuse to produce steam through the pyrolysis of refuse to produce oil or gas; and through the anaerobic digestion of organic wastes to produce methane gas."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/2945> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Energierueckgewinnung"@de,
        "energy recovery"@en .

