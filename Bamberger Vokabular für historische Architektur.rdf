    <!-- https://hist-arch-vocab.org/bvha#c_6c42f8fb -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_6c42f8fb">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_eea5235b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T20:29:21.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-27T12:41:24.000</terms:modified>
        <skos:altLabel xml:lang="de">Schwebebogen</skos:altLabel>
        <skos:altLabel xml:lang="fr">arc-boutant</skos:altLabel>
        <skos:altLabel xml:lang="it">cavalcavia</skos:altLabel>
        <skos:altLabel xml:lang="it">fornice</skos:altLabel>
        <skos:altLabel xml:lang="cs">opěrný oblouk</skos:altLabel>
        <skos:altLabel xml:lang="en">pier arch</skos:altLabel>
        <skos:altLabel xml:lang="en">straining arch</skos:altLabel>
        <skos:altLabel xml:lang="cs">visutý oblouk</skos:altLabel>
        <skos:altLabel xml:lang="cs">vzpěrný oblouk</skos:altLabel>
        <skos:definition xml:lang="de">1. Der gotische Strebebogen; 2. großer Stützbogen zwischen zwei Gebäuden oder Innenmauern. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Der Verstrebung zweier Mauern dienender, frei gespannter Bogen, meist mit einer horizontalen Aufmauerung. Schwibbogen stützen auch die Außenwände gegenüberliegender Häuser in engen Gassen gegeneinander ab und tragen, wenn sie entsprechend breit angelegt sind, einen häufig gedeckten Gang, der die oberen Geschosse der Gebäude miteinander verbindet. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Schwebebogen, waagrecht gespannter Bogen zur Übertragung des Horizontalschubs zwischen zwei Gebäuden, meist über engen Gassen. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Velký rozpěrný oblouk mezi dvěma budovami nebo vnitřními stěnami (Florencie). [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Schwibbogen</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">arc-diaphragme</skos:prefLabel>
        <skos:prefLabel xml:lang="es">arco de tensión</skos:prefLabel>
        <skos:prefLabel xml:lang="it">arco rampante</skos:prefLabel>
        <skos:prefLabel xml:lang="en">diaphragm arch</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">prampouch</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_eea5235b"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_6c4424ca -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_6c4424ca">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a2025113"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_f8146cf8"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-08-19T14:56:43.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T13:46:04.000</terms:modified>
        <skos:definition xml:lang="de">Nach der Eroberung Englands 1066 durch den Normannen Wilhelm eingeführt, häufig auf einer Motte. Zumeist über rechteckigem Grundriss mit dicken Mauern, in die Wehrnischen, Treppen und Abtritte eingefügt sind. Die Außenmauern werden durch Lisenen oder halbrunde Vorlagen gegliedert oder die Ecken risaliartig betont. Im Innern wird der Keep durch Längsmauern zweigeteilt und durch Zu- oder Einbau einer Kapelle bereichert. Im Untergeschoss, das nur vom 1. Obergeschoss zugängl. ist, befinden sich Lager- und Mannschaftsräume. Über einen hochgelegenen Eingang erreicht man durch einen Wachraum, häufig in einem Anbau, das 1. Obergeschoss mit dem großen, beheizbaren Saal. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Keep</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">keep</skos:prefLabel>
        <skos:prefLabel xml:lang="en">keep</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_a2025113"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_6c44457b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_6c44457b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_049c4c22"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_03b12eaf"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_88e0e3e1"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_9f78aef6"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-09T13:04:53.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:03:42.000</terms:modified>
        <skos:altLabel xml:lang="de">dreikappiges Gewölbe</skos:altLabel>
        <skos:altLabel xml:lang="en">three-part vault</skos:altLabel>
        <skos:definition xml:lang="de">Eine Gewölbefläche, die sich aus drei Gewölbekappen zusammensetzt. [BVHA] </skos:definition>
        <skos:prefLabel xml:lang="de">dreiteiliges Gewölbe</skos:prefLabel>
        <skos:prefLabel xml:lang="en">tripartite vault</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">trojdílná klenba</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte à trois quartiers </skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_049c4c22"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_6c4e380a -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_6c4e380a">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_39738fa5"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_b41bd73a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-17T15:42:59.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-17T15:45:12.000</terms:modified>
        <skos:altLabel xml:lang="de">Scheibe</skos:altLabel>
        <skos:definition xml:lang="de">Technologisch bedingtes, kreisförmiges Flachglas. Butzen und unzerteiltes Mondglas treten in Scheibenform aus der Herstellung hervor. Heute ist der Begriff Scheibe für Fensterglas weithin gebräuchlich, was letztendlich auf die große Verbreitung der Butzenscheibe bis zum Barock zurückzuführen ist. [Noky 1996]</skos:definition>
        <skos:prefLabel xml:lang="de">Glasscheibe</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_6c6289be -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_6c6289be">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_9cd2be38"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_55e56166"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-18T17:23:29.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-12T18:00:23.000</terms:modified>
        <skos:prefLabel xml:lang="de">geschiedenes Joch</skos:prefLabel>
        <skos:prefLabel xml:lang="en">the central nave bay aligns with two side-aisle bays</skos:prefLabel>
