        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-03T16:40:03.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T11:42:27.000</terms:modified>
        <skos:definition xml:lang="de">Dornenkrone f: die aus Zweigen mit Dornen geflochtene Krone, die Christus zum Spott tragen musste. Sie wurde als große Reliquie in der Sainte Chapelle zu Paris verwahrt. Einzelne Dornen werden noch an vielen anderen Orten verehrt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="fr">Couronne d\&apos;Epines</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Crown of Thorns</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Dornenkrone Christi (Reliquie)</skos:prefLabel>
    </owl:NamedIndividual>
    


