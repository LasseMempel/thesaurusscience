    skos:closeMatch <http://dbpedia.org/resource/Codification> ;
    skos:definition "The process of collecting and arranging systematically, usually by subject, the laws of a state or country, or the rules and regulations covering a particular area or subject of law or practice."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/6023> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Kodifizierung"@de,
        "codification"@en .

<http://www.eionet.europa.eu/gemet/concept/11468> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10084> ;
    skos:definition "A rule, principle, theory, or tenet of the law, as the doctrine of merger, the doctrine of relation, etc."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Lehrmeinung"@de,
        "doctrine (law)"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Legal_doctrine> .

<http://www.eionet.europa.eu/gemet/concept/11476> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/206> ;
    skos:definition "A binding rule or body of rules prescribed by a government pertaining to matters of importance to residents of sparsely populated regions, especially agricultural and other economic issues."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Ländliches Recht"@de,
        "rural law"@en .

<http://www.eionet.europa.eu/gemet/concept/11478> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4060> ;
    skos:definition "The moral, legal or ethical claims of posterity on present people, based on the recognition that the young and unborn are vulnerable to contemporary decision-making, especially decisions having long-term effect on the societies and environment they inherit."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Rechte der zukünftigen Generationen"@de,
        "rights of future generations"@en .

<http://www.eionet.europa.eu/gemet/concept/11479> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4060> ;
