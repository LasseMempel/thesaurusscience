	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1826">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1826</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TUNAIL-RÈILE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Tunail a tha a' dol fo abhainn no tro leathad 's rathad-iarainn a' dol troimhe.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">RAILWAY TUNNEL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
