        <skos:altLabel xml:lang="en"> round temple</skos:altLabel>
        <skos:altLabel xml:lang="it"> tempio circolare</skos:altLabel>
        <skos:altLabel xml:lang="de">Rundtempel</skos:altLabel>
        <skos:altLabel xml:lang="fr">temple circulaire</skos:altLabel>
        <skos:altLabel xml:lang="it">tolo</skos:altLabel>
        <skos:definition xml:lang="de">Ein Tempel mit runder Cella und runder Säulenhalle  heißt Tholos (Tempelformen), ein R. ohne Cella Monopteros (meist in barocken Parkanlagen). [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Rundtempel, dessen Cella von einem Säulenkranz umgeben war. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Tholos (griech. Kuppeldach, Mz.: Tholoi), Rundbau mit Säulenkranz und Innenraum. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Řec. kopulová střecha, mn.č. tholoi, kruhová stavba se sloupovým ochozem a vnitřním prostorem. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Tholos</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">temple rond</skos:prefLabel>
        <skos:prefLabel xml:lang="es">templo circular</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">tholos</skos:prefLabel>
        <skos:prefLabel xml:lang="en">tholos</skos:prefLabel>
        <skos:prefLabel xml:lang="it">tholos</skos:prefLabel>
    </owl:NamedIndividual>
    


