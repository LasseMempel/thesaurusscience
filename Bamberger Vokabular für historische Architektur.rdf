    <!-- https://hist-arch-vocab.org/bvha#c_260c6309 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_260c6309">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_78eff904"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
