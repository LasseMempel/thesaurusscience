	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk019093">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">medical equipment</skos:prefLabel>
		<skos:altLabel xml:lang="de">Medizingerät</skos:altLabel>
		<skos:altLabel xml:lang="de">Medizingeräte</skos:altLabel>
		<skos:altLabel xml:lang="de">Medizinische Geräte</skos:altLabel>
		<skos:prefLabel xml:lang="de">Medizinisches Gerät</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk021338"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019153"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk021338"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk019265"/>
		<xe:explanation_temp xml:lang="de">Medizinische Geräte umfassen eine Vielzahl von Geräten, Instrumenten, Apparaten oder Maschinen, die in der medizinischen Versorgung eingesetzt werden. Medizinische Geräte können sowohl für diagnostische als auch therapeutische Zwecke verwendet werden und reichen von einfachen Instrumenten bis hin zu komplexen technologischen Systemen.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein medizinisches Gerät ist ein Medizinprodukt, das für medizinische Anwendungen genutzt wird. Dazu gehören Instrumente, Apparate und Vorrichtungen, die der Diagnostik, Therapie, gesundheitlichen Überwachung und Verhütung von Krankheiten oder Verletzungen am Menschen dienen.</skos:definition>
		<skos:narrowMatch rdf:resource="http://d-nb.info/gnd/4169226-3"/>
