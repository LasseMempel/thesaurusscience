    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_a9b5d0f4 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_a9b5d0f4">
