        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-07T19:06:39.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T15:15:52.000</terms:modified>
        <skos:altLabel xml:lang="de">Klosterpriester</skos:altLabel>
        <skos:altLabel xml:lang="de">Priestermönch</skos:altLabel>
        <skos:altLabel xml:lang="en">padre</skos:altLabel>
        <skos:definition xml:lang="de">Pater m, lat.; auch Klerikermönch m; Klosterpriester m: Mönch, der die Priesterweihe empfangen hat. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Pater</skos:prefLabel>
        <skos:prefLabel xml:lang="en">father</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">père</skos:prefLabel>
    </owl:NamedIndividual>
    


