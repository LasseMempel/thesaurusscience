        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-01T09:22:04.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T12:15:36.000</terms:modified>
        <skos:definition xml:lang="de">Abschlussgesims zwischen Baukörper und Dachkörper, zu dem es konstruktiv gehört (Gesims, Dachdeckung). [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Dachgesims</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_6a4df887 -->


