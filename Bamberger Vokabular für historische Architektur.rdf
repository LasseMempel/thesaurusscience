    <!-- https://hist-arch-vocab.org/bvha#c_5a9eb4ed -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_5a9eb4ed">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_e39b6c90"/>
