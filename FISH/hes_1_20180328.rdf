		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/410" />
		<skos:scopeNote xml:lang="en">An artificial elevation of earth or stones. Use more specific term where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
