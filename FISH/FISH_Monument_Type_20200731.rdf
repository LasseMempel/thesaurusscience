  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70300">
    <skos:scopeNote xml:lang="en">A large wooden structure built alongside the edge of a canal where narrow boats may lie for the loading and unloading of goods.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160277">
    <skos:scopeNote xml:lang="en">A building containing a flight siumlator used to provide safe training for pilots.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/147248">
    <skos:scopeNote xml:lang="en">A tall multi-storey block of flats, slender with a square plan.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99587">
