		<gvp:aat2801_conjuncted_with rdf:resource="http://lvr.vocnet.org/wnk/wk000769"/>
		<gvp:aat2801_conjuncted_with rdf:resource="http://lvr.vocnet.org/wnk/wk001439"/>
		<xe:explanation_temp xml:lang="de">Das Ha-Ha ist vom Garten aus nicht zu erkennen und ermöglicht unverstellte Blicke in die Landschaft. Dadurch dehnt sich der Garten optisch aus.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Ha-Ha ist ein Graben, der in der Gartenkunst als Gestaltungsmittel der Einfriedung von Gärten und Parks dient.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000942"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000318"/>
