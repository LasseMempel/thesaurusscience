    <!-- https://hist-arch-vocab.org/bvha#c_79b594ad -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_79b594ad">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_e5de1856"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-13T16:37:55.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T18:38:17.000</terms:modified>
        <skos:definition xml:lang="de">Ein Mauerverband, bei dem die Ringschichten geneigt verlegt sind, wodurch ein seitliches Ausweichen der Bogenringe unmöglich wird. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Wölbung in geneigten Ringschichten</skos:prefLabel>
        <skos:prefLabel xml:lang="en">laying of voussoirs in inclined arched courses</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte appareillée en assises arquées inclinées</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_79b87b82 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_79b87b82">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_7acece55"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-15T11:46:55.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-18T14:01:36.000</terms:modified>
        <skos:definition xml:lang="en">Design technique producing an outline by dabbing a cloth sack containing a dark powder, such as charcoal, onto the surface of a pierced sheet of paper or parchment. [EwaGlos]</skos:definition>
        <skos:definition xml:lang="de">Technik zur Anfertigung einer Zeichnung, bei der ein Stoffbeutel, gefüllt mit dunklem Puder, wie etwa Kohle, auf die Oberfläche eines durchstochenen Papiers gedrückt wird. [EwaGlos]</skos:definition>
        <skos:prefLabel xml:lang="de">Spolvero-Methode</skos:prefLabel>
        <skos:prefLabel xml:lang="en">spolvero</skos:prefLabel>
    </owl:NamedIndividual>
    


