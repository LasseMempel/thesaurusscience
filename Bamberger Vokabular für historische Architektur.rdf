        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T11:05:32.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T18:05:42.000</terms:modified>
        <skos:definition xml:lang="de">Eigenart des Rokoko, bei der paarige Kunstwerke (z.B. Seitenaltäre) nicht - wie etwa noch im Barock - in sich symmetrisch sind, sondern erst miteinander eine Symmetrie ergeben. Die Symmetrieachse verläuft also außerhalb des Einzelstücks und fällt mit der Achse des Gesamtraumes zusammen. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Specifický rys rokoka, kdy párová umělecká díla (např. boční oltáře) nejsou, jako tomu bylo ještě v baroku, sama o sobě symetrická, nýbrž vytvářejí symetrii teprve společně; symetrická osa tak prochází mimo jednotlivé dílo a je shodná s osou celého prostoru. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Optische Ergänzung</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">optické doplnění</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_4d966c72 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_4d966c72">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_278f0834"/>
