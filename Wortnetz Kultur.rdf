		<skos:prefLabel xml:lang="de">Nikolausankunft</skos:prefLabel>
		<skos:prefLabel xml:lang="nl">Sinterklaas Aankomst</skos:prefLabel>
		<skos:altLabel xml:lang="nl">Sinterklaas Intocht</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006601"/>
