        <skos:altLabel xml:lang="de">Halbkreisbogen</skos:altLabel>
        <skos:altLabel xml:lang="en">Roman arch</skos:altLabel>
        <skos:altLabel xml:lang="fr">arc en demi-cercle</skos:altLabel>
        <skos:altLabel xml:lang="cs">kruhový oblouk</skos:altLabel>
        <skos:altLabel xml:lang="en">semicircular arch</skos:altLabel>
        <skos:definition xml:lang="de">Bogen mit einer genau halbkreisförmigen Bogenlinie. Sein Kreismittelpunkt liegt auf der Mitte der Kämpferlinie, der Stich entspricht dem Radius. Diese Form ist charakteristisch für die von den Römern erbauten Bogen, weshalb man manchmal auch vom römischen Bogen spricht. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="it"> arco a tutto sesto</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Rundbogen</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">arc en plein cintre</skos:prefLabel>
        <skos:prefLabel xml:lang="es">arco de medio punto</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">půlkruhový oblouk</skos:prefLabel>
        <skos:prefLabel xml:lang="en">round arch</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_2026364f"/>
    </owl:NamedIndividual>
    


