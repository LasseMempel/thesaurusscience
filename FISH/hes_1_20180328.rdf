		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">CHIMNEY POT</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1913" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500881" />
		<skos:scopeNote xml:lang="en">A cylindrical, polygonal, or square element fixed on top of a chimney stack to extend the flue and improve the extraction of smoke and gases. Often of red or yellow fireclay.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
