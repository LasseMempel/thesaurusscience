    <!-- https://hist-arch-vocab.org/bvha#c_3761c6c1 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_3761c6c1">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b2356bd0"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_c55445fe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_b41bd73a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_e9f9bbef"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-13T16:43:20.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T16:35:49.000</terms:modified>
        <skos:altLabel xml:lang="cs">nadpraží</skos:altLabel>
        <skos:definition xml:lang="de">Fenstersturz, oberer waagerechter Abschluss eines Fensters als Balken, Stein oder scheitrechter Bogen. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Obere waagerechte Begrenzung einer Fensteröffnung. Sind die Höhen einer Werksteinrahmung profiliert, trägt auch der Sturz das gleiche Profil. [Noky 1996]</skos:definition>
        <skos:definition xml:lang="cs">Též nadpraží, horní vodorovný ukončující prvek. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Fenstersturz</skos:prefLabel>
        <skos:prefLabel xml:lang="en">lintel</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">překlad</skos:prefLabel>
    </owl:NamedIndividual>
    


