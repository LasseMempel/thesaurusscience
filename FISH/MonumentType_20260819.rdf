    <skos:prefLabel xml:lang="en">TIDAL SWIMMING POOL</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Manmade structure for bathing or swimming that is located on the beachfront and filled by tidal waters. Similar to a LIDO, with the main difference being the extent of the built up complex around the pool.</skos:scopeNote>
    <dc1:identifier rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141874"/>
