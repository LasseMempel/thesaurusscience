		<skos:prefLabel xml:lang="gd">FÙIRNEIS IARAINN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Fùirneis leaghaidh a thathar a' sèideadh adhar teth dùmhlaichte innte.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BLAST FURNACE</skos:prefLabel>
