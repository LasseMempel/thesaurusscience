		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1245" />
		<skos:scopeNote xml:lang="en">A structure which houses a beam engine.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
