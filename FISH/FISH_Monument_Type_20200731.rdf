    <skos:scopeNote xml:lang="en">A workshop or factory for casting metals.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140516">
    <skos:scopeNote xml:lang="en">A pillbox built to a design drawn up by the commander of the Royal Engineers for the Colchester Garrison.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140092">
    <skos:scopeNote xml:lang="en">A depot or warehouse for the storage, distribution and repair of shoe making machines.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68988">
    <skos:scopeNote xml:lang="en">A group of related buildings, primarily with a domestic function, which is arranged along a principle axis such as a main road or routeway.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71742">
    <skos:scopeNote xml:lang="en">A spa building to which water was pumped from springs or wells; usually also serving a social function as an ASSEMBLY ROOM, eg. as at Bath.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71381">
    <skos:scopeNote xml:lang="en">The room housing the looms in a domestic handloom weavers cottage. In general, wool loomshops were above the living quarters, whereas cotton loomshops were often below in a cellar, since the floor was usually kept damp to aid the weaving of the cotton.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93564">
    <skos:scopeNote xml:lang="en">An instrument for measuring and indicating the height of tide.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/103693">
    <skos:scopeNote xml:lang="en">A workshop used for the manufacture of statues, either cast or carved.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69138">
    <skos:scopeNote xml:lang="en">For chemical processes making nylon, rayon, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/102683">
    <skos:scopeNote xml:lang="en">A structure, often sited underground, from where it was intended to conduct the business of government in the event of nuclear war. Sub RSGs were introduced between the RSGs and local authorities to allow the RSGs to focus on strategic direction.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91881">
    <skos:scopeNote xml:lang="en">A building or a room for accounts.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69220">
    <skos:scopeNote xml:lang="en">A site or establishment for the casting and refining of metallic copper.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94115">
    <skos:scopeNote xml:lang="en">A house with an open hall whose main span is separated by an arcade from the side aisles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141949">
    <skos:scopeNote xml:lang="en">Obstacles like concrete cubes, cylinders or pimples erected in the defence of Britain.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91831">
    <skos:scopeNote xml:lang="en">A stall where eels, either raw or cooked, are sold.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/74791">
    <skos:scopeNote xml:lang="en">A plant for bottling manufactured goods, as opposed to a BOTTLE WORKS where bottles were made.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94363">
    <skos:scopeNote xml:lang="en">Usually a small, two or three man trench, dug as an isolated fieldwork rather than as part of a defensive system. A WWI and WWII feature.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160539">
    <skos:scopeNote xml:lang="en">A building used for the administration of a squadron.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/139766">
    <skos:scopeNote xml:lang="en">Part of the WWII air defence radar system, whereby in 1939 a chain of radar stations were established along the south and east coast of Britain. The equipment was based upon apparatus developed for ionospheric research.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91228">
    <skos:scopeNote xml:lang="en">A building, or part of a building for the boiling and preparation of animal feed, usually attached to pigsties.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71859">
    <skos:scopeNote xml:lang="en">A place of meeting and worship for Brethren, a fundamentalist puritan sect founded in Ireland in the late 1820s and established in England in Plymouth in the 1830s.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140494">
    <skos:scopeNote xml:lang="en">An aircraft hangar designed to Air Ministry specifications (drawing number 2243/41). Constructed from prefabricated A-frames and clad in corrugated iron.</skos:scopeNote>
  </rdf:Description>
