	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk002485">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Atrien (Gebäudeteile)</skos:altLabel>
		<skos:prefLabel xml:lang="it">atrio</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Atrium (Gebäudeteil)</skos:prefLabel>
		<skos:prefLabel xml:lang="en">atrium</skos:prefLabel>
		<skos:prefLabel xml:lang="fr">atrium</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000316"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk005746"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk014718"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000316"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk004187"/>
		<gvp:aat2801_conjuncted_with rdf:resource="http://lvr.vocnet.org/wnk/wk001540"/>
		<gvp:aat2801_conjuncted_with rdf:resource="http://lvr.vocnet.org/wnk/wk003106"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk001353"/>
		<gvp:aat2100_distinguished_from rdf:resource="http://lvr.vocnet.org/wnk/wk004193"/>
		<xe:explanation_temp xml:lang="de">In neuerer Zeit wird der Begriff auf Innenhöfe übertragen, die unmittelbar und ausschließlich dem Wohnbereich zugeordnet sind.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Atrium ist ein Gebäudeteil, der ursprünglich den im Dach geöffneten Hauptraum des italisch-römischen Wohnhauses bezeichnet.</skos:definition>
		<skos:scopeNote xml:lang="de">Benutzt für den zentralen Raum eines römischen Hauses, bei dem die Dachöffnung zwischen einem Viertel und einem Drittel der Raumbreite liegt, und für einen dem Wohnbereich unmittelbar zugeordneten Innenhof eines modernen Hauses. Ein von Säulen umstellter Innenhof eines römischen Hauses, dessen Öffnung größer ist als ein Drittel der Gesamtbreite von Hof und begleitenden Räumen ist ein Peristylhof (wk004187) oder Peristylgarten (wk004190); für das Atrium einer Kirche siehe Atrium (Kirchengebäude) (wk004193); für die oft als Atrium bezeichnete zentrale Erschließungshalle in moderner Architektur siehe Halle (wk002410).</skos:scopeNote>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000316"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk005746"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk014718"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-08-20T12:08:11+02:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk002486">
