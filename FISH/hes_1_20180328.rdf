	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/300">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/300</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÀRACH DÌON CATHARRA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làraichean is togalaichean a chuirear gu feum gus dìon a' phobaill a stiùireadh rè cogaidh. Gabhaidh an cleachdadh cuideachd ma bhios èiginn nàiseanta ann.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CIVIL DEFENCE SITE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/278" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/301">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/301</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">FASGADH IONNSAIGH-ADHAIR</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Structar daingnichte a chleachdar gus daoine a dhìon o bhomadh nàmhad.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">AIR RAID SHELTER</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:altLabel xml:lang="en">BOMB SHELTER</skos:altLabel>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/300" />
				<skos:scopeNote xml:lang="en">A fortified structure used to protect people from the effects of enemy bombing.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/509042" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/634" />
		<skos:scopeNote xml:lang="en">Sites and buildings used in the coordination of the defence of the civilian population during times of war. Could also be used during times of national emergency.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/302">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/302</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÀRACH DÌON-CLADAICH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làraichean, togalaichean is structaran a dhìonas an cladach o ionnsaigh mara no adhair.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">COASTAL DEFENCE SITE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/289" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/278" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/303" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/304" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/306">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/306</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TÙR MHARTELLO</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Tùr freiceadain/ghunnaichean air a' chladach a chaidh a thogail mar phàirt dhe na goireasan dìon o ionnsaighean aig àm Chogaidhean Napoleon.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">MARTELLO TOWER</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/302" />
				<skos:scopeNote xml:lang="en">A coastal gun/watch tower built as part of the anti-invasion defences during the Napoleonic Wars.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/307" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/308">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/308</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">STÈISEAN MÈINNEARACHD-MARA</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Làrach far a bheil togalaichean is structaran co-cheangailte ri sìoladh mèinnean-mara.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">SUBMARINE MINING STATION</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/302" />
				<skos:scopeNote xml:lang="en">A site with buildings and structures associated with the laying of sea mines.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/507905" />
		<skos:scopeNote xml:lang="en">Sites, buildings and structures for the defence of the coastline from sea and air invasion.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/303">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/303</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BACADH LUINGEIS</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Sreath de phuist no ceithir-shliosnaich concrait eadar an cladach is eilean, gu tric fo dhìon bataraidh ghunnaichean.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ANTI SHIPPING BARRIER</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/302" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/281" />
		<skos:scopeNote xml:lang="en">A Line of concrete posts or tetrahedra laid between the shore and an island, often protected by a gun-battery.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/304">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/304</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BACADH ACARSAID</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Bacadh, mar is trice bacadh fiodha, slabhraidh no lìn, tarsainn air beul cala, puirt no acarsaid gus smachd a chumail air cò thig a-steach 's cò dh'fhalbhas a-mach agus air buaidh na h-aimsire air na tuinn.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BOOM DEFENCE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">ANTI SUBMARINE NETTING</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/302" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1431" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/507905" />
		<skos:scopeNote xml:lang="en">A barrier, usually of wood, chain or netting, stretched across the entrance to a harbour, port or anchorage, to control entry and/or limit the effect of the weather on wave action.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/307">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/307</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">IONAD-PHLEÀNAICHEAN-MARA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite far a bheil togalaichean is structaran anns an cumar plèanaichean-mara agus far an dèanar obair-chàraidh orra.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SEAPLANE BASE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
