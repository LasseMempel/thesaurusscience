        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-09T13:39:01.000</terms:modified>
        <skos:definition xml:lang="cs">Střídání různobarevných kamenných vrstev (Hildesheim, Siena), nebo vrstev zdiva z nepravidelných a pravidelných kamenů. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Wechsel von verschiedenfarbigen Steinschichten oder von Mauerschichten aus unregelmäßigen und regelmäßigen Steinen. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Schichtenwechsel</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">střídání vrstev</skos:prefLabel>
    </owl:NamedIndividual>
    


