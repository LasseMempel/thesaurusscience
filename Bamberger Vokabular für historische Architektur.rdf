        <skos:altLabel xml:lang="de">Bildervelum</skos:altLabel>
        <skos:altLabel xml:lang="de">Hülltuch</skos:altLabel>
        <skos:altLabel xml:lang="en">veil</skos:altLabel>
        <skos:altLabel xml:lang="fr">voile de la passion</skos:altLabel>
        <skos:definition xml:lang="de">Passionsvelum n, velum crucifixi et imaginis: violettes Tuch, mit dem Kreuze und Bildwerke während der Passionszeit verhüllt werden; zu unterscheiden vom Fastenvelum. [Glossarium Artis]</skos:definition>
