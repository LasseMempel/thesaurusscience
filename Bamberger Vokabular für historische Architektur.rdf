        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_b395f284"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-05T11:32:20.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T12:16:22.000</terms:modified>
        <skos:definition xml:lang="de">1. ausladendes Gesims in der Höhe einer Fensterbank an der Außenwand eines Gebäudes. 2. Eine Form der Fensterverdachung, die seit der ital. Renaissance meist nur noch als Mittel zur Belebung von Fassaden durch Schattenwirkung angewendet wird. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Fenstergesims</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">nadokenní římsa</skos:prefLabel>
        <broaderByPosition rdf:resource="https://hist-arch-vocab.org/bvha#c_01e49620"/>
    </owl:NamedIndividual>
    


