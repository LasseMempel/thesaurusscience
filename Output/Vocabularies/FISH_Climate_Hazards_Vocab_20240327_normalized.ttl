        <http://purl.org/heritagedata/schemes/38076/concepts/4020> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/38076> ;
    skos:prefLabel "Storm surge"@en ;
    skos:scopeNote "Rise of sea level due to high storm winds."@en .

<http://purl.org/heritagedata/schemes/38076/concepts/30102> a skos:Concept ;
    skos:altLabel "Salt-water inundation"@en,
        "Saltwater inundation"@en ;
