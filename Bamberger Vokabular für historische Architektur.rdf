        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-19T13:23:54.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:53:00.000</terms:modified>
        <skos:altLabel xml:lang="de">Schirmgewölbe</skos:altLabel>
        <skos:altLabel xml:lang="de">Schirmkuppel</skos:altLabel>
        <skos:altLabel xml:lang="es">bóveda en paraguas</skos:altLabel>
        <skos:altLabel xml:lang="en">sail vault</skos:altLabel>
        <skos:altLabel xml:lang="en">umbrella dome</skos:altLabel>
        <skos:altLabel xml:lang="it">volta a ombrello</skos:altLabel>
        <skos:definition xml:lang="de">Schirmgewölbe, Gewölbe mit segelartig geblähten Kappen zwischen den Graten oder Rippen einer Kuppel. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Schirmkuppel, Flachkuppel auf fächerförmigem Grundriss mit gebusten Kappen zwischen Graten oder Rippen, die den Eindruck geblähter Segel (Segelkuppel) vermitteln; zu unterscheiden vom Fächergewölbe. [Koepf /Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Segelgewölbe</skos:prefLabel>
        <skos:prefLabel xml:lang="es">bóveda con forma de quitasol</skos:prefLabel>
        <skos:prefLabel xml:lang="en">umbrella vault</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte en forme de parasol</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_ca605999 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_ca605999">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0a18e053"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_3e0c1197"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_64dd3656"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_cb3125a1"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
