        <skos:definition xml:lang="cs">Štukový dekor islámského původu jako sgrafito, nebo ve tvaru stalaktitů, často zdobeno malbou. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Yeseria</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">yesería</skos:prefLabel>
    </owl:NamedIndividual>
    


