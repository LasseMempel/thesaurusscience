        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-06T19:41:09.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T16:44:22.000</terms:modified>
        <skos:altLabel xml:lang="de">Loch</skos:altLabel>
        <skos:altLabel xml:lang="en">gap</skos:altLabel>
        <skos:definition xml:lang="de">Eine Hohlstelle in der Steinoberfläche. [ICOMOS-ISCS] </skos:definition>
        <skos:definition xml:lang="cs">duté nebo prázdné místo v povrchu kamene, díra. [ICOMOS-ISCS] </skos:definition>
        <skos:definition xml:lang="fr">espace vide, cavité.[ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="en">hollow place in the stone surface, hole. [ICOMOS-ISCS]</skos:definition>
        <skos:note xml:lang="en">A hollow space (a loss of components) usually enclosed within solid material. [EwaGlos]</skos:note>
        <skos:note xml:lang="de">Hohlraum (Substanzverlust), in der Regel umgeben von festem Material. [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="de">Lücke</skos:prefLabel>
        <skos:prefLabel xml:lang="en">cavity</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">mezera</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">trou</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_114b35b3 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_114b35b3">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f8146cf8"/>
