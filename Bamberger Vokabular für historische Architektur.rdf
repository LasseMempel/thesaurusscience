    <!-- https://hist-arch-vocab.org/bvha#c_70a11673 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_70a11673">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b320e26f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-16T10:51:35.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T12:12:45.000</terms:modified>
        <skos:definition xml:lang="de">(frz.), Umwallungslinie einer Befestigung, unterschieden in Kern- und Hauptumwallung. Die Hauptumwallung ist die für die Verteidigung wichtigste E., sie ist beim bastionären System der Wall mit den Bastionen, bei Gürtelfestungen die Kette der detachierten Forts (detachierte Werke; Fort). Kernumwallung ist hingegen der Wall, der nach dem Verlust der Hauptumwallung noch verteidigungsfähig bleibt. E. B. / M. L. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:prefLabel xml:lang="de">Enceinte</skos:prefLabel>
    </owl:NamedIndividual>
    


