	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk020968">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="en">copies (derivative objects)</skos:altLabel>
