		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk012244"/>
		<skos:definition xml:lang="de">Elektrum ist eine natürliche Legierung aus Gold und  Silber. Der Goldanteil ist stark schwankend und liegt in etwa zwischen 90% und 20%.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4125978-6"/>
