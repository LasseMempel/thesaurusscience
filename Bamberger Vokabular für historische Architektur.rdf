    <!-- https://hist-arch-vocab.org/bvha#c_230e1e22 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_230e1e22">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_d37353f8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-04T13:13:42.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T12:25:11.000</terms:modified>
        <skos:altLabel xml:lang="es"> galería de las monjas</skos:altLabel>
        <skos:altLabel xml:lang="de">Nonnenempore</skos:altLabel>
        <skos:altLabel xml:lang="de">Prieche</skos:altLabel>
        <skos:altLabel xml:lang="cs">chór jeptišek</skos:altLabel>
        <skos:altLabel xml:lang="cs">empora jeptišek</skos:altLabel>
        <skos:altLabel xml:lang="cs">kruchta jeptišek</skos:altLabel>
        <skos:definition xml:lang="cs">Empora jeptišek v ženském klášteře. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Emporenraum; Empore in Damenstifts- und Nonnenklosterkirchen, die der Abschirmung der Nonnen von den übrigen Teilnehmern am Gottesdienst diente, meist mit Altar, Orgel und Chorgestühl. Die N. lag meist im W, seltener auch über den Seitenschiffen oder in einem Querhausarm. Sie kann bühnenartig über Säulenstellungen weit in das Mittelschiff hineingezogen werden oder auf den Westbau beschränkt bleiben. [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Prieche, Nonnenempore im Frauenkloster oder Damenstift. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Zpravidla v západní části, nebo jsou na ní umístěny varhany (též kruchta, většinou na západě), nebo má především členící funkci. Zvláště v románské době empory otvíraly stěny chrámové lodi a představovaly třecí rytmický prvek mezi arkádami v přízemí a horní okenní stěnou. V renesančních a barokních emporových kostelích zasahovala empora až do klenby a nabývala zároveň většího prostorového významu. Empora však není nezbytnou součástí chrámového prostoru. V centrální stavbě se nachází nad ochozem, v bazilice nad bočními loděmi, v příčné lodi, nebo nad západním vchodem, v halových nebo jednolodních kostelích stojí na vlastní konstrukci a bývala často zabudována až dodatečně, především v reformovaných kostelích. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="es"> coro de las monjas</skos:prefLabel>
        <skos:prefLabel xml:lang="fr"> tribune de religieuse</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Nonnenchor</skos:prefLabel>
        <skos:prefLabel xml:lang="it">matroneo delle monache</skos:prefLabel>
        <skos:prefLabel xml:lang="en">nun\&apos;s gallery</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">tribuna jeptišek</skos:prefLabel>
    </owl:NamedIndividual>
    


