		<skos:altLabel xml:lang="de">Knochenkocherei</skos:altLabel>
		<skos:prefLabel xml:lang="de">Knochensiederei</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk002248"/>
