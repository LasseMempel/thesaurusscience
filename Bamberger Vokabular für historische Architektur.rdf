        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-15T15:57:23.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T14:30:07.000</terms:modified>
        <skos:altLabel xml:lang="cs">prevít</skos:altLabel>
        <skos:definition xml:lang="de">Abortanlage in mittelalterlichen Burgen, die an der Außenmauer angebracht war und direkt in die Landschaft entsorgte.Seit dem 13. Jahrhundert ist sie auch für die Häuser der städtischen Oberschicht belegt. Hier konnte sie auch über Fallschächte in Abortgruben münden. [Schrader / Voigt 2003]</skos:definition>
        <skos:definition xml:lang="cs">Arkýřový záchod umístěný na vnější straně hradební zdi, otevřený směrem dolů. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Nach unten geöffnete Abtritterker an der Außenseite von Wehrmauern. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Aborterker</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">prevét</skos:prefLabel>
    </owl:NamedIndividual>
    


