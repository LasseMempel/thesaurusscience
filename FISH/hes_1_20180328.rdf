				<skos:prefLabel xml:lang="gd">CHALET</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Àite-còmhnaidh air nòs na h-Eilbheise, gu ìre mhòr de dh'fhiodh agus le mullach cas is stobach air mar is trice.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">CHALET</skos:prefLabel>
