        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T21:07:51.000</terms:modified>
        <skos:altLabel xml:lang="de">Altargitter</skos:altLabel>
        <skos:definition xml:lang="de">Niedrige Schranken aus Stein, Holz oder Metall zur Abgrenzung des den Priestern vorbehaltenen Raums vor dem Altar vom übrigen Innern der (kath.) Kirche, hervorgegangen aus den Cancelli der Basilika (Chorschranken). [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Altarschranke</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_6910f3c3 -->


