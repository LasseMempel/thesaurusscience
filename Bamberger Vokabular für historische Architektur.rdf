    <!-- https://hist-arch-vocab.org/bvha#c_0f3f1d26 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_0f3f1d26">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_8b190e59"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_6d9883bf"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_ea0c92d2"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T17:41:45.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-27T15:06:38.000</terms:modified>
        <skos:altLabel xml:lang="cs">skeletová stavba</skos:altLabel>
        <skos:definition xml:lang="de">Bauweise aus einem Gerippe von Holz (Fachwerk), Stein (z.B. Strebewerk), Stahl oder Stahlbeton über einem Rastersystem. Das Skelett übernimmt alle Tragefunktionen, seine Form wird deshalb von den statischen Kräften bestimmt. Es kann - wie das gotische Strebewerk - außen sichtbar bleiben oder durch eine selbsttragende bzw. eine Vorhang-Fassade verdeckt werden. Der Skelettbau bezweckt u.a. ökonomischen Materialeinsatz durch weitestgehende rationelle Ausnutzung der statischen Gesetze. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Gerippebau, eine Bauweise, bei der im Gegensatz zum Massivbau alle tragenden Funktionen auf ein System tragfähiger Glieder, für die der Kräfteverlauf formbildend und maßgebend ist (Skelett), beschränkt werden. Die Funktionen des Raumabschlusses werden gegebenenfalls von nichttragenden Füllungen übernommen. Als Material eignen sich Holz (Fachwerkbau), Stahl, Stein (Strebewerk) und Stahlbeton. Das Skelett kann außen sichtbar sein (wie z.B. bei den got. Kathedralen) oder von einer meist vorgehängten Fassade verdeckt werden (Vorhangfassade). Allen S.ten liegen Rastersysteme zugrunde. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Způsob stavby sestávající z kostry ze dřeva (hrázděné zdivo), kamene (např. opěrný systém), oceli nebo železobetonu nad konstrukční sítí - rastrem. Skelet přebírá všechny nosné funkce, jeho tvar je proto určován statickými silami. Může - podobně jako gotický opěrný systém být zvenčí viditelný, nebo zakrytý samonosnou, resp. zavěšenou fasádou. Racionálním využitím statických zákonitostí umožňuje skeletová konstrukce mj. ekonomické využití stavebního materiálu. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Skelettbau</skos:prefLabel>
        <skos:prefLabel xml:lang="es">construcción con estructura de entramado</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">construction en ossature (portante)</skos:prefLabel>
        <skos:prefLabel xml:lang="it">costruzione con struttura a scheletro</skos:prefLabel>
        <skos:prefLabel xml:lang="en">skeleton construction</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">skeletová konstrukce</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_0f408aaa -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_0f408aaa">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0b71e4f3"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_cbe4df8d"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_34ca6582"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-19T10:59:57.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T16:46:34.000</terms:modified>
        <skos:altLabel xml:lang="de">Salzausblühung </skos:altLabel>
        <skos:altLabel xml:lang="en">salt efflorescence</skos:altLabel>
        <skos:definition xml:lang="cs"> Je složena z rozpustných solí. Vyvíjí se za přítomnosti vysokého obsahu solí a tvoří se při cyklickém střídání vlhnutí a vysýchání. [ICOMOS-ISCS] </skos:definition>
        <skos:definition xml:lang="fr">Croûte composée de sels solubles, qui se développe dans un contexte de forte teneur en sel, au gré des cycles d’humectation-dessiccation. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="en">Crust composed of soluble salts, which develop in the presence of high salt levels, and form from wetting and drying cycles. [ICOMOS-ISCS] </skos:definition>
        <skos:definition xml:lang="de">Salzkrusten setzen sich aus löslichen Salzen zusammen und bilden sich in Gegenwart hoher Salzkonzentrationen durch Feucht-Trocken-Zyklen. [ICOMOS-ISCS] </skos:definition>
        <skos:prefLabel xml:lang="de">Salzkruste</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">croûte saline</skos:prefLabel>
        <skos:prefLabel xml:lang="en">salt crust</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">solná krusta</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_0f43d231 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_0f43d231">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
