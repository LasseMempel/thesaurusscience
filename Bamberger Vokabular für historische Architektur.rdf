    <!-- https://hist-arch-vocab.org/bvha#c_ae4e93a2 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_ae4e93a2">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_804ab319"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_eea5235b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-16T14:06:27.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T19:33:52.000</terms:modified>
        <skos:altLabel xml:lang="de">Wandbogen</skos:altLabel>
        <skos:altLabel xml:lang="fr">arc en orbevoie</skos:altLabel>
        <skos:altLabel xml:lang="fr">arc engagé</skos:altLabel>
        <skos:altLabel xml:lang="fr">arc incorporé</skos:altLabel>
        <skos:altLabel xml:lang="fr">arc mural</skos:altLabel>
        <skos:altLabel xml:lang="de">blinder Bogen</skos:altLabel>
        <skos:altLabel xml:lang="cs">čelní oblouk</skos:altLabel>
        <skos:definition xml:lang="de">Eein der Mauer dekorativ oder gliedernd vorgebauter Bogen, der jedoch keine Maueröffnung umschließt. Oft zur Blendarkade gereiht. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Ein Bogen, der keine Maueröffnung überbrückt und nicht als konstruktiver Entlastungsbogen in der Mauerfläche liegt, sondern der geschlossenen Wand nur vorgeblendet, d.h. aufgelegt ist. Der B. ist bes. in der roman. und got. Baukunst ein beliebtes Mittel zur Wandgliederung. In erweitertem Sinne wird der Begriff B. auch für eine Blendarkade verwendet. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Einer Wand direkt aufgelegter Bogen; ein Dekorationsmotiv zur Wandgliederung. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="cs">Opěrný stavební prvek s kruhovým, polygonálním nebo jinak profilovaným průřezem, původně nesl kladí, od římských dob také zdi nad oblouky, a byl používán i dekorativně, bez nosné funkce. Může stát samostatně, nebo je předsazený před pilíř nebo zeď, z nichž jen částečně vystupuje (čtvrtsloup, polosloup, tříčtvrteční sloup). Při větší výšce, ale menším průřezu se nazývá přípora. Základními součástmi jsou patka, dřík a hlavice, funkčně nezbytný je však pouze dřík. Může se zužovat směrem nahoru nebo dolů, mít entázi, nebo neměnnou tloušťku. Jednotlivé názvy odrážejí jeho tvary nebo seskupení: 1. monolitický sloup (z jednoho kusu), 2. sloup složený z tamburů (bubnovitých částí), 3. krétský (zužuje se směrem dolů), 4. kanelovaný (se svislými výžlabky, viz kandování), 5. přepásaný (s jedním nebo několika prstenci na dříku), 6.stáčený (tordovaný, spirálově zatočený,) 7. zauzlený, 8. hadovitý, 9. zoomorfní s šelmami, 10. kandelábrový (a jiné renesanční sloupy), 11. sdružené sloupy, 12. svazkový sloup. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Blendbogen</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">arc aveugle</skos:prefLabel>
        <skos:prefLabel xml:lang="es">arco mural de refuerzo</skos:prefLabel>
        <skos:prefLabel xml:lang="en">blind arch</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">slepý oblouk</skos:prefLabel>
        <broaderByPosition rdf:resource="https://hist-arch-vocab.org/bvha#c_eea5235b"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_ae5e6a76 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_ae5e6a76">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_7123c6b1"/>
