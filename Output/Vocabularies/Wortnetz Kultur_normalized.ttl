<http://lvr.vocnet.org/wnk/wk021044> a skos:Concept ;
    skos:altLabel "Druckfahnen"@de,
        "Fahne (Probedruck)"@de,
        "Korrekturabzug"@de,
        "Korrekturabzüge"@de,
        "Korrekturfahne"@de,
