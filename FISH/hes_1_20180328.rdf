	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1083">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1083</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FACTARAIDH LUAIDHE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Factaraidh far a bheilear a' dèanamh luaidhe dhearg air a bheil feum ann an saothrachadh GLAINNE no luaidhe gheal airson peant geal a dhèanamh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">LEAD WORKS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
