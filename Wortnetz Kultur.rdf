		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk020385"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk003754"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019698"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk003150"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk020385"/>
		<skos:definition xml:lang="de">Eine Standseilbahn ist eine Seilbahn mit ortsfestem Antrieb in einer Station. Bewegt wird das Fahrbetriebsmittel auf Bodenschienen durch ein oder mehrere fest mit dem Wagen verbundene Zugseile.. Die Standseilbahn fährt in der Regel gegenläufig im Pendelverkehr auf eingleisigen Strecken, kürzere Strecken sind oft zweigleisig angelegt.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4199947-2"/>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300155910"/>
		<skos:closeMatch rdf:resource="https://www.wikidata.org/wiki/Q142031"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003754"/>
