        <skos:prefLabel xml:lang="la">oleum catechumenorum (o. c .)</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_49600518 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_49600518">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_bb055578"/>
