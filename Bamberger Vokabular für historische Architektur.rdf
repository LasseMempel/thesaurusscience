        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T16:04:13.000</terms:modified>
        <skos:definition xml:lang="de">Bogenstellung im Obergeschoss einer Kirche, oft mit dahinterliegendem Gang. [Glossarium Artis]</skos:definition>
