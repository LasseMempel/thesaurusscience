		<skos:prefLabel xml:lang="de">Dolium</skos:prefLabel>
		<skos:prefLabel xml:lang="en">dolium</skos:prefLabel>
		<skos:altLabel xml:lang="en">doliums</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk008768"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk020392"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk012069"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk008768"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk020392"/>
		<skos:definition xml:lang="de">Ein Dolium ist ein sehr großes Gefäß aus gebranntem Ton, das in weiten Teilen des Römischen Reichs vor allem zur Lagerung von Lebensmitteln verwendet wurde. Diese größte römische Gefäßform zeichnet sich durch einen bauchigen Körper ohne Henkel, meist ohne Hals und eine weite Öffnung aus. Dolia konnten mannshoch sein und ein Volumen von bis zu zwei Kubikmetern besitzen.</skos:definition>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300400601"/>
		<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q973597"/>
