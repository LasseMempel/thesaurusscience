    skos:broader <http://www.eionet.europa.eu/gemet/concept/6287> ;
    skos:closeMatch <http://data.uba.de/umt/_00015706> ;
    skos:definition "The step by step method and process of defining, developing and outlining various possible courses of actions to meet existing or future needs, goals and objectives for a country or a large body of people associated with a particular territory, often sharing similar ethnic backgrounds, customs and language."@en ;
