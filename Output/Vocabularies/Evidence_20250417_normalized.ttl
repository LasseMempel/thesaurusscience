        <http://purl.org/heritagedata/schemes/eh_evd/concepts/99974> ;
    skos:scopeNote "Monument either never or no longer visible above ground surface, but whose presence is indicated by proven below ground stratigraphy revealed by deliberate investigation, including geophysical survey, or other surface disturbance."@en .

<http://purl.org/heritagedata/schemes/eh_evd/concepts/84570> a skos:Concept ;
    skos:altLabel "Other Structure"@en,
