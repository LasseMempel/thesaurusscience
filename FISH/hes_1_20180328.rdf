		<skos:prefLabel xml:lang="gd">CUACH-CREIGE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Lagan ann an cruth bobhla no amair a chaidh a shnaidheadh ann an clach no loman creagach.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ROCK CUT BOWL</skos:prefLabel>
