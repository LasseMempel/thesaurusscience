        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_19d56a39"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-28T08:48:48.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-12-01T12:41:15.000</terms:modified>
        <skos:altLabel xml:lang="de">Windrispe</skos:altLabel>
        <skos:altLabel xml:lang="fr">queue de vache</skos:altLabel>
        <skos:altLabel xml:lang="en">sprocket</skos:altLabel>
        <skos:altLabel xml:lang="cs">vaznice</skos:altLabel>
        <skos:altLabel xml:lang="cs">zavětrování</skos:altLabel>
        <skos:definition xml:lang="de">Eine schräg zurTrauflinie verlaufende Latte, die als Windverband (Längsverband) eines Sparrendachs dient (Dachkonstruktion). [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Schräg vom Dachfuß gegen den First verlaufendes, latten-, brett- oder bohlenartiges Holz, das auf der unteren oder oberen Seite der Sparren aufgenagelt, überkämmt oder überblattet ist. [Eißing et al. 2012]</skos:definition>
        <skos:prefLabel xml:lang="de">Rispe</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">contrevent</skos:prefLabel>
        <skos:prefLabel xml:lang="it">controvento</skos:prefLabel>
        <skos:prefLabel xml:lang="en">cross lath</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">podélný spoj pod krokví přibitý šikmo ke směru okapu</skos:prefLabel>
        <skos:prefLabel xml:lang="es">riostra de contraviento</skos:prefLabel>
    </owl:NamedIndividual>
    


