    <!-- https://hist-arch-vocab.org/bvha#c_a2b6d884 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_a2b6d884">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_39738fa5"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_b41bd73a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c7b144d0"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-23T08:07:21.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-08T14:11:08.000</terms:modified>
        <skos:altLabel xml:lang="de">Butze</skos:altLabel>
        <skos:definition xml:lang="de">Butzenscheibe (und Mondscheibe) entsteht aus einem geweiteten, aufgetriebenen und geschleuderten Ballon oder Becher, wobei die Mondscheibe einer übergroßen Butze entspricht. [Pax - Fenster &amp; Türen Fachbegriffe]</skos:definition>
        <skos:definition xml:lang="de">Butzenscheiben, kleine, runde, meist grünl. Glasscheiben mit einseitiger Verdickung in der Mitte (Butze), mit Bleistegen im Profanbau zu Fensterscheiben verbunden (15./16. Jh.) und in ma. Wiederaufnahme im 19./20. Jh. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Glasscheibe, deren runde Form im Herstellungsprozess durch die Fliehkraft beim schnellen Drehen entsteht. In der Mitte bleibt die verdickte Bruchstelle des abgeschlagenen Hefteisens, der Butzen, der Rand ist meistens umgeschlagen. Die Butze ist nicht zu verwechseln mit Mondglas. [Noky 1996]</skos:definition>
        <skos:definition xml:lang="de">Meist runde, grünliche Glasscheibe in Bleifassung und mit einer Verdickung (»Butzen«) in der Mitte. Im 15./16. Jh. als Fensterverglasung. Daher noch heute Fenster-»Scheibe« auch für rechteckige Gläser. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Většinou kruhová nazelenalá skleněná tabulka zasazená do olověného rámu, uprostřed zesílená (terčík, lidově „pucna&quot;), v 15. a 16. století jako zasklení oken. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Butzenscheibe</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">skleněný terčík</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_a2b9a729 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_a2b9a729">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_c80851cf"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-10-25T14:17:00.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T17:53:35.000</terms:modified>
        <skos:definition xml:lang="de">Modifizierte gr. Dorische Ordnung, deren Säulen eine Basis und unter dem Echinus einen Halsring haben. Der R.-d. 0. ist die toskan. Ordnung ähnlich. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Römisch Dorische Ordnung</skos:prefLabel>
    </owl:NamedIndividual>
    


