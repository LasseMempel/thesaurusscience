		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1212" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1214">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1214</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">MUILEANN-COISE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Structar a ghineas cumhachd slighe gluasad cuairteachaidh is cuideigin no beathach air choireigin a' coiseachd air sreath steapaichean no air nàdar de bhann sìor-leantainneach.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">TREADMILL</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1211" />
				<skos:scopeNote xml:lang="en">A structure for producing power through a rotary motion achieved by the weight of people or animals treading on a succession of moving steps or a belt that forms a kind of continuous path.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
