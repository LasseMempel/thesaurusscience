	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk005422">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Schere (Schneidewerkzeug)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Scheren (Schneidewerkzeuge)</skos:altLabel>
		<skos:prefLabel xml:lang="en">scissor</skos:prefLabel>
		<skos:altLabel xml:lang="en">shears (cutting tools)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk007001"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010189"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk018390"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk007001"/>
		<gvp:aat2416_requires rdf:resource="http://lvr.vocnet.org/wnk/wk015497"/>
		<skos:definition xml:lang="de">Eine Schere ist ein Schneidewerkzeug zum Zertrennen oder Einschneiden diverser Materialien mittels zweier gegeneinander beweglicher Klingen mit Schneiden.</skos:definition>
		<xe:explanation_temp xml:lang="de">Zum Öffnen und Schneiden müssen die Finger in den meist ringförmig auslaufenden Griffen verkantet werden. Das Schneiden erfolgt durch die gegeneinander gerichtete Bewegung der zwei Hebelenden.</xe:explanation_temp>
