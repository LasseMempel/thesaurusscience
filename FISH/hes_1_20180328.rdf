	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/501005">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/501005</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CEANN-SIMILEIR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar àrd barr-chaol de bhreigean, concrait no stàilinn a bheir an àirde ceò 's gas cho àrd 's gun gabh an leigeil a-mach san adhar.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CHIMNEY STALK</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-02-20T09:56:38</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-02-20T10:05:46</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1913" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1242" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1357" />
		<skos:scopeNote xml:lang="en">A tall, usually tapering, structure built of brick, concrete or steel, used to carry smoke and gases to an altitude where they can be exhausted into the atmosphere.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
