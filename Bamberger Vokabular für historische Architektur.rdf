        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_49b69f36"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_227b1d8a"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_cf0ec846"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-11-26T10:53:22.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T10:47:41.000</terms:modified>
        <skos:altLabel xml:lang="en">carpenter\&apos;s mark</skos:altLabel>
        <skos:definition xml:lang="de">Zimmermannszeichen zur Kennzeichnung der Einzelteile einer Holzkonstruktion je nach ihrer späteren Lage im Bauwerk. Es gibt sie in verschiedenen Zählweisen, römisch oder arabisch oder mit speziellen Zeichen, wie z.B. Strich mit Fähnchen. [Schrader / Voigt 2003]</skos:definition>
        <skos:prefLabel xml:lang="de">Abbundzeichen</skos:prefLabel>
        <skos:prefLabel xml:lang="en">assembly mark</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">marque d\&apos;assemblage</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Kombination aus Abbundmarken zur Markierung der zu einem Bund gehöhrenden Hölzer. [BVHA]</skos:scopeNote>
    </owl:NamedIndividual>
    


