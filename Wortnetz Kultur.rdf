	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk003026">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en-US">jute fiber</skos:prefLabel>
		<skos:prefLabel xml:lang="en-UK">jute fibre</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Jutefaser</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003027"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk003027"/>
		<skos:definition xml:lang="de">Eine Jutefaser ist eine Bastfaser, die aus den Stengeln der Jutepflanze gewonnen wird und insbesondere der Herstellung von Garn und Säcken dient.</skos:definition>
