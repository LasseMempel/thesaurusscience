        <skos:altLabel xml:lang="it">navata centrale</skos:altLabel>
        <skos:altLabel xml:lang="en">nave</skos:altLabel>
        <skos:altLabel xml:lang="fr">vaisseau centrale</skos:altLabel>
        <skos:definition xml:lang="de">Der Teil der (Langbau-)Kirche zwischen Fassade und Chor bzw. Querhaus. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Langhaus, Teil der Kirche zwischen Fassade bzw. Westbau und Querhaus bzw. Chor. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Část podélného kostela mezi západním průčelím a chórem, resp. příčnou lodí. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="es"> nave central</skos:prefLabel>
