    <skos:scopeNote xml:lang="en">A place for strolling, public walks, etc. Usually associated with coastal resorts.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142870">
    <skos:scopeNote xml:lang="en">A fortified river or river bank forming part of the anti invasion infrastructure.</skos:scopeNote>
  </rdf:Description>
