        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T18:10:35.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T12:13:21.000</terms:modified>
        <skos:altLabel xml:lang="de">Chorscheitelkapelle</skos:altLabel>
        <skos:altLabel xml:lang="cs">zvláště mariánská</skos:altLabel>
        <skos:definition xml:lang="de">Scheitelkapelle, eine meist der Gottesmutter geweihte und im O. vorstehende Kapelle in der Mittelachse eines Chors; in England Lady Chapel genannt. [Koepf / Binding 2016]</skos:definition>
