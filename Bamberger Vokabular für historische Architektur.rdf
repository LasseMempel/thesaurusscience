        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-17T10:04:33.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T17:42:38.000</terms:modified>
        <skos:prefLabel xml:lang="de">Johannistonsur</skos:prefLabel>
        <skos:prefLabel xml:lang="la">tonsura s. Johannis</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Johannistonsur f, lat. tonsura s. Joannis, bei der die vordere Kopfhälfte glattrasiert wird, während die Haare des Hinterhauptes stehen bleiben, besonders in England und Irland üblich. [Glossarium Artis]</skos:scopeNote>
    </owl:NamedIndividual>
    


