        <skos:altLabel xml:lang="pl">drenaż</skos:altLabel>
        <skos:altLabel xml:lang="pl">dreny</skos:altLabel>
        <skos:altLabel xml:lang="pl">odwadnianie</skos:altLabel>
        <skos:altLabel xml:lang="tr">tahliye kanalı</skos:altLabel>
        <skos:note xml:lang="fr">Action d’évacuer artificiellement l’eau de ruissellement ou contenue dans les sols ou dans les structures, afin d’assécher un bâtiment et sa maçonnerie. (EwaGlos)</skos:note>
        <skos:note xml:lang="de">Der künstliche Abtransport von Regenwasser, Wasser im Boden oder im Bauwerk, um das Gebäude und seine Mauern zu trocknen. (EwaGlos)</skos:note>
        <skos:note xml:lang="en">The artificial evacuation of runoff water, water in the soil, or water that is in the structure in order to dry a building and its walls. (EwaGlos)</skos:note>
        <skos:prefLabel xml:lang="de">Drainage</skos:prefLabel>
        <skos:prefLabel xml:lang="en">drainage</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">drainage</skos:prefLabel>
        <skos:prefLabel xml:lang="it">drenaggio</skos:prefLabel>
        <skos:prefLabel xml:lang="ro">drenaj</skos:prefLabel>
        <skos:prefLabel xml:lang="tr">drenaj</skos:prefLabel>
        <skos:prefLabel xml:lang="es">drenaje</skos:prefLabel>
        <skos:prefLabel xml:lang="hr">drenaža</skos:prefLabel>
        <skos:prefLabel xml:lang="pl">odpływy</skos:prefLabel>
        <skos:prefLabel xml:lang="hu">vízelvezetés</skos:prefLabel>
        <skos:prefLabel xml:lang="bg">Дренаж</skos:prefLabel>
    </owl:NamedIndividual>
    


