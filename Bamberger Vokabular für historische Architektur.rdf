    <!-- https://hist-arch-vocab.org/bvha#c_8ee05367 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_8ee05367">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_43e35ceb"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-07T10:19:47.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T16:25:59.000</terms:modified>
        <skos:definition xml:lang="de">Ein für kurze Zeit bei Festlichkeiten errichtetes Tor im Zuge der Feststraße, aus Holz mit Stoffen, Fahnen, Blumen und Emblemen geschmückt, im Unterschied zu den dauerhaft aus Stein errichteten Triumphbogen. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Ehrentor</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_8ee3a25e -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_8ee3a25e">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_2b8c8e23"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-07T09:27:07.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T14:22:25.000</terms:modified>
        <skos:definition xml:lang="de">1. Siegesdenkmal 2. Embleme des Krieges, wie Fahnen, Standarten, Schilde, Lanzen, Rüstungen, Helme, Schwerter oder dergl., die an einem Tropaion oder an einem Triumphbogen angebracht sind. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Různé zbraně dekorativně uspořádané kolem kyrysu, přilby nebo štítu, jako napodobenina řeckého památníku vítězství (tropaion), počínaje renesancí. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Verschiedene Waffen, die in Nachahmung griechischer Siegesdenkmäler (Tropaion) dekorativ um einen Brustpanzer, Helm oder Schild angeordnet sind. Seit der Renaissance. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Trophäe</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">trofej</skos:prefLabel>
