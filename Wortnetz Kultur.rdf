	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004667">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Umsiedelungsort</skos:altLabel>
		<skos:altLabel xml:lang="de">Umsiedelungsorte</skos:altLabel>
		<skos:prefLabel xml:lang="de">Umsiedlungsort</skos:prefLabel>
		<skos:altLabel xml:lang="de">Umsiedlungsorte</skos:altLabel>
		<skos:altLabel xml:lang="de">Umsiedlungsstandort</skos:altLabel>
		<skos:altLabel xml:lang="de">Umsiedlungsstandorte</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000433"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010254"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013750"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019812"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000433"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk006492"/>
		<xe:explanation_temp xml:lang="de">Schlagwort: Umsiedlung&lt;br&gt;
Erläuterung: Auf gesetzl. oder vertragl. Wege eingeleitete Veränderung des Wohnsitzes ganzer Bevölkerungsgruppen, z. B. von Minderheiten zwischen Staaten oder einzelner Orte durch staatl. Planung&lt;br&gt;
Übergeordnete Begriffe: &lt;br&gt;
   Auswanderung&lt;br&gt;
Verwandte Begriffe: &lt;br&gt;
   Vertreibung&lt;br&gt;
Systematik: 8.1&lt;br&gt;
SWD Identnummer: 4061614-9</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Umsiedlungsort ist eine Siedlung, die nach einer vollzogenen Umsiedlungsmaßnahme neu angelegt wurde und die von den Einwohnern der verlassenen oder aufgegebenen Siedlung bewohnt wird.</skos:definition>
