        <skos:altLabel xml:lang="cs">jednoduchá tašková krytina</skos:altLabel>
        <skos:definition xml:lang="de">Beim Spließdach (Spandach) wird unter jede seitl. Fuge [in der Dachdeckung] ein Spließ (Span) aus Holz eingelegt. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Dachdeckung, deren senkrechte Fugen mit einem Spließ (Span) abgedichtet sind. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Eine einfache Dachdeckung, deren senkr. Fugen mit unterlegten Spließen (Spänen) abgedichtet sind. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Spließdach</skos:prefLabel>
        <skos:prefLabel xml:lang="en">shingle roof</skos:prefLabel>
