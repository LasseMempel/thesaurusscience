        <http://dbpedia.org/resource/Chlorination> ;
    skos:definition "The application of chlorine to water, sewage or industrial wastes for disinfection or other biological or chemical purposes."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_34803> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
