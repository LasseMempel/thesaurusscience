    <!-- https://hist-arch-vocab.org/bvha#c_8374abb2 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_8374abb2">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_537f5b30"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c7b144d0"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-15T11:55:31.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-12-01T13:33:18.000</terms:modified>
        <skos:altLabel xml:lang="es">marco de una ventana</skos:altLabel>
        <skos:altLabel xml:lang="fr">prédormant</skos:altLabel>
        <skos:definition xml:lang="de">Eine Tür- oder Fensterumrahmung, die eine Breite aufweist, die der Dicke der umgebenden Mauer entspricht. Zargen aus Holz verfügen auf der Rückseite häufig über zwei Nuten zur Aufnahme von Putzabschlußprofilen. [Pax - Fenster &amp; Türen Fachbegriffe]</skos:definition>
        <skos:definition xml:lang="de">Rahmenartige, hölzerne Einfassung von Türen und Fenstern (Zargenfenster) aus Bohlen oder Vierkantholz; die Z. ist bündig mit der äußeren Mauerflucht versetzt und wird beim Aufführen des Mauerwerks mit eingemauert. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Zarge</skos:prefLabel>
        <skos:prefLabel xml:lang="es">cerco de una ventana</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">dormant (d\&apos;attente)</skos:prefLabel>
        <skos:prefLabel xml:lang="en">surround (of doors, windows)</skos:prefLabel>
        <skos:prefLabel xml:lang="it">telaio fisso</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">zárubeň</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_83789b81 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_83789b81">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_da0504c3"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-21T14:22:34.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-21T14:24:40.000</terms:modified>
        <skos:definition xml:lang="de">Unechter Bogen, bei dem die vorkragenden Steine an ihrer Unterseite derart behauen werden, dass die gewünschte Bogenlinie entsteht.</skos:definition>
        <skos:prefLabel xml:lang="de">abgefaster Kragbogen</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">arc en tas-de-charge délardé</skos:prefLabel>
        <skos:prefLabel xml:lang="en">chamfered corbel arch</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_837e89e0 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_837e89e0">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_klbrisjd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_b641aad9"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-06T23:13:35.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-31T00:28:14.000</terms:modified>
        <skos:altLabel xml:lang="de">Sarkophag</skos:altLabel>
        <skos:altLabel xml:lang="cs">sarkofág</skos:altLabel>
        <skos:definition xml:lang="de">Ein sichtbares, nicht wie ein Sarg mit Erde überdecktes Grabdenkmal aus Holz, Stein, Metall oder Ton in Form einer einfachen Kiste, in Ägypten auch in Formen, die dem menschl. Körper bzw. der Mumie angepasst sind. Bei den Griechen und Römern, häufig auch im MA, nimmt der S. hausähnl. Formen an und erhält meist ein Giebel-, seltener ein Walmdach. Es kommen sogar Analogien zum Tempel- und Kirchenbau mit Querschiffen und bei der Sonderform der Reliquiare sogar mit Kuppeln vor, die Wände zeigen Architekturgliederung (Portale, Säulenarkaden u. dergl.), das Dach Ziegel und Dachbekrönungen (Akroterien). [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Řec. ,,masožrout&quot;, podle Plinia kamenečná břidlice z trojské oblasti, která údajně urychluje tlení. Většinou zdobená rakev z kamene, hlíny, dřeva či kovu ve tvaru domu, vany nebo truhly, často s ležící postavou zemřelého. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Sarg</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">rakev</skos:prefLabel>
        <skos:prefLabel xml:lang="it">sarcofago</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">sarcophage</skos:prefLabel>
        <skos:prefLabel xml:lang="en">sarcophagus</skos:prefLabel>
        <skos:prefLabel xml:lang="es">sarcófago</skos:prefLabel>
    </owl:NamedIndividual>
    


