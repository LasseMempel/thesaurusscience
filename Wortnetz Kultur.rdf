		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk020406"/>
		<skos:definition xml:lang="de">Ein Hochbehälter ist ein Wasserspeicher, dessen Wasserspiegel höher liegt als die Entnahmestelle, sodass ausreichend Wasserdruck für die Einspeisung in Druckleitungen erzeugt wird. Ein Hochbehälter kann als Bauwerk in einem höhergelegenen Gebiet ausgeführt sein oder als Wasserturm.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4356742-3"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1621678"/>
