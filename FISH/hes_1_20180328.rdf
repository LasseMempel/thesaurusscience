		<skos:prefLabel xml:lang="gd">IONAD-STAD GIÙLAIN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite far am b' urrainnear corp a chur 's e ga ghiùlan gu àite-tìodhlacaidh 's an luchd-giùlain a' gabhail anail.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CORPSE REST</skos:prefLabel>
