    <skos:prefLabel xml:lang="en">SQUARE ENCLOSURE</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A square shaped area of land enclosed by a boundary ditch, bank, wall, palisade or similar barrier. Small square enclosures (with sides of less than c.20m) have been interpreted as the remains of square barrows of Iron Age date.</skos:scopeNote>
    <dc1:identifier rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70367"/>
