		<skos:altLabel xml:lang="en">boiler suits</skos:altLabel>
		<skos:prefLabel xml:lang="en">coverall</skos:prefLabel>
		<skos:altLabel xml:lang="en">coveralls</skos:altLabel>
		<skos:prefLabel xml:lang="de">Overall</skos:prefLabel>
		<skos:altLabel xml:lang="de">Overalls</skos:altLabel>
