        <skos:altLabel xml:lang="de">Altarstaffel</skos:altLabel>
        <skos:prefLabel xml:lang="fr"> prédelle</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Predella</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">predela</skos:prefLabel>
        <skos:prefLabel xml:lang="es">predela</skos:prefLabel>
        <skos:prefLabel xml:lang="en">predella</skos:prefLabel>
        <skos:prefLabel xml:lang="it">predella</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Altarstaffel auf der Mensa als Unterbau für ein Retabel oder für den Schrein eines Flügelaltars. [Koch 2009]</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Altarstaffel, der auf der Mensa aufsitzende Sockel eines Altarretabels oder des Schreins eines Flügelaltars, meist mit Malereien oder Bildwerken geschmückt oder als Reliquienbehälter. [Koepf/Binding 2016]</skos:scopeNote>
        <skos:scopeNote xml:lang="cs">Oltářní stupeň na mense jako hranolový podstavec retabula nebo skříně křídlového oltáře. [Koch 2008]</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Predella, Zwischenstück zwischen Mensa und Altarretabel (Flügelaltar). [Koepf / Binding 2016]</skos:scopeNote>
    </owl:NamedIndividual>
    


