        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-12T10:22:07.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-12T17:04:52.000</terms:modified>
        <skos:altLabel xml:lang="cs">kamenná skříň</skos:altLabel>
        <skos:definition xml:lang="de">Ein vorgeschichtl. Grab mit Grabkammer aus Steinen (Grabbau, Dolmen) und darüber aufgeschüttetem Erdhügel. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Steinkammer</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kamenná (megalitická) hrobka</skos:prefLabel>
        <skos:prefLabel xml:lang="en">megalithic tomb</skos:prefLabel>
        <skos:prefLabel xml:lang="es">tumba megalítica</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_ea53ad5d -->


