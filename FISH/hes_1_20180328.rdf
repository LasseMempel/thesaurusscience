		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1933</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LEAC TEINTEIN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Leac, structar no àite a nithear teine orra.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HEARTH</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1897" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1938" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/410" />
		<skos:scopeNote xml:lang="en">A slab, structure or place on which fires are made.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
