    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "D SHAPED BARROW"@en ;
    skos:scopeNote "Not a round barrow ploughed out at one end, but a specific type, the flat edge being additionally defined by stone slabs."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70007> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70006> ;
