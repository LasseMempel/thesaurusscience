  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70003">
    <skos:scopeNote xml:lang="en">A Neolithic burial monument comprising a stone-built chamber within a rectangular or trapezoidal earthen mound.</skos:scopeNote>
  </rdf:Description>
