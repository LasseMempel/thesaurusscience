        <skos:definition xml:lang="de">Sakramentskapelle, Kapellenanbau, in der das Sakrament (Hostie, Kelch usw.) aufbewahrt wird, stiller Andachtsraum, zumeist in einer Seitenkapelle auf der Nordseite großer, vielbesuchter Kirchen. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Sakramentskapelle</skos:prefLabel>
        <skos:prefLabel xml:lang="es">capilla del sagrario</skos:prefLabel>
        <skos:prefLabel xml:lang="it">cappella del sacramento</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">chapelle de tabernacle</skos:prefLabel>
        <skos:prefLabel xml:lang="en">sacrament chapel</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_b5206255"/>
    </owl:NamedIndividual>
    


