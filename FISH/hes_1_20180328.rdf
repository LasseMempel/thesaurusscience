	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1228">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1228</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LOSGADAIR SGUDAIL</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Ionad far a bheilear a' losgadh sgudal is cleachdar an teas a thig às uaireannan gus cumhachd a ghintinn.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">REFUSE DESTRUCTOR</skos:prefLabel>
