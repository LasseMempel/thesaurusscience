  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70264">
    <skos:scopeNote xml:lang="en">A way between different places, used by horses, travellers on foot and vehicles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70156">
    <skos:scopeNote xml:lang="en">An abbey or priory of Carthusian monks.</skos:scopeNote>
  </rdf:Description>
