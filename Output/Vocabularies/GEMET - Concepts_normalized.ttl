    skos:closeMatch <http://data.uba.de/umt/_00051719> ;
    skos:definition "Clean fuel that does not release polluting emissions in the environment, such as methane."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Umweltfreundlicher Brennstoff"@de,
