    <!-- https://hist-arch-vocab.org/bvha#c_c16919e8 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_c16919e8">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_219f468f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T14:39:04.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T10:28:10.000</terms:modified>
        <skos:altLabel xml:lang="de">Putte</skos:altLabel>
        <skos:definition xml:lang="cs">Nazí chlapečkové s křídly nebo bez křídel. Putti vznikly přetvořením gotických andílků a od dob renesance, zvláště však baroka byly umisťovány na oltářích, obrazech, varhanách, stěnách, stropech a galeriích kostelů, Jejich činnost většinou symbolicky opakuje hlavní téma, k němuž jsou přidruženy. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Putte (it. putto = kleines Kind, Mz. putti), nackte kleine Knaben mit oder ohne Flügel, sind eine Umformung der gotischen Kinderengel und bevölkern seit der Frührenaissance, besonders aber im Barock Altäre, Bilder, Orgeln, Wände, Decken und Galerien der Kirchen. Ihre Tätigkeiten sind meist symbolische Wiederholungen des Hauptthemas, dem sie beigesellt sind. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="cs">Putti (mn. č.)</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Putto</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_c16cfb5b -->


