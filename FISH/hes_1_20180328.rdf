				<skos:prefLabel xml:lang="gd">ÀTH HOFFMAN</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Àth a thathar a' cleachdadh gus breigean a dhèanamh mar is trice agus a tha ag obrachadh fad na h-ùine.</skos:scopeNote>
