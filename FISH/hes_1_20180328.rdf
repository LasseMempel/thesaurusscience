		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/766" />
		<skos:scopeNote xml:lang="en">A factory in which logs are converted to timber by running them through a series of saws.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
