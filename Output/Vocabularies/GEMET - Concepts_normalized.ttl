    skos:closeMatch <http://data.uba.de/umt/_00051403> ;
    skos:definition "A binding rule or body of rules prescribed by government to regulate public services and the competing claims of residential, commercial and industrial interests in municipal areas generally characterized by moderate to high population density."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/3124> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Stadtentwicklungsrecht"@de,
        "urban development law"@en .

