        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-09T17:33:22.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T16:05:35.000</terms:modified>
        <skos:altLabel xml:lang="de">Schoßtuch</skos:altLabel>
        <skos:altLabel xml:lang="en">lapcloth</skos:altLabel>
        <skos:altLabel xml:lang="la">tobalea</skos:altLabel>
        <skos:altLabel xml:lang="la">velum gremiale</skos:altLabel>
        <skos:definition xml:lang="de">Gremiale n, auch Schoßtuch n, velum gremiale: Seiden- oder Leinentuch, das dem Bischof über die Knie gebreitet wird, wenn er bei bestimmten Pontifikalhandlungen auf seinem Thron sitzt; es unterliegt dem Farbenkanon. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Gremiale</skos:prefLabel>
        <skos:prefLabel xml:lang="en">gremial</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">gremiál</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">grémial</skos:prefLabel>
        <skos:prefLabel xml:lang="la">pannus</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_f9d8858d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_f9d8858d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_9cd2be38"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-18T16:46:04.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-12T18:00:45.000</terms:modified>
        <skos:altLabel xml:lang="de">Gewölbefeld</skos:altLabel>
        <skos:altLabel xml:lang="de">Travée</skos:altLabel>
        <skos:altLabel xml:lang="de">überwölbtes Joch</skos:altLabel>
        <skos:definition xml:lang="de">Der zwischen vier Stützen liegende bzw. durch Gurtbogen und Scheidbogen begrenzte Abschnitt eines Gewölbes, der sich mehrfach wiederholt, z . B. bei einem gegliederten Tonnengewölbe. Im Deutschen bezeichnet Travée vorzugsweise das querrechteckige, schmale Joch der Hochgotik, oft unter Einbeziehung der Gewölbefelder und des Strebesystems der Seitenschiffe. Die Anzahl der Joche wird in Längsrichtung des Raumes gezählt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Gewölbejoch</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">klenebné pole</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">travée voutée</skos:prefLabel>
        <skos:prefLabel xml:lang="en">vaulting bay</skos:prefLabel>
    </owl:NamedIndividual>
    


