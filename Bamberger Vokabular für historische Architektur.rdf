        <skos:altLabel xml:lang="de">Etoile</skos:altLabel>
        <skos:altLabel xml:lang="de">Feldschanze</skos:altLabel>
        <skos:altLabel xml:lang="fr">fort à étoile</skos:altLabel>
        <skos:definition xml:lang="de">Als geschlossenes Außenwerk auf sternförmiger Grundfläche, auch mit einspringenden Winkeln,in regelmäßigen oder unregelmäßigen Formen eines drei- bis zehnstrahligen Sterns.Im 17. Jh. bes. von Vauban für Festungsbauten angewandt. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Sternschanze</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">fort étoile</skos:prefLabel>
        <skos:prefLabel xml:lang="en">star fort</skos:prefLabel>
        <skos:prefLabel xml:lang="it">trincea a stella</skos:prefLabel>
        <skos:prefLabel xml:lang="es">trinchera en forma de estrella</skos:prefLabel>
    </owl:NamedIndividual>
    


