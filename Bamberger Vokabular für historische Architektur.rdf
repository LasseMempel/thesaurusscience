        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_d2999582"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_dc7abe96"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_dd999fd5"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_ef9f925d"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_fe1ad47b"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_146492b6"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_3f816c0e"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-21T16:08:48.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-25T15:15:13.000</terms:modified>
        <skos:altLabel xml:lang="de">Habit</skos:altLabel>
        <skos:altLabel xml:lang="de">Ordensgewand</skos:altLabel>
        <skos:altLabel xml:lang="de">Ordenskleidung</skos:altLabel>
        <skos:altLabel xml:lang="la">forma habitus religiosi</skos:altLabel>
        <skos:altLabel xml:lang="fr">habits monacaux</skos:altLabel>
        <skos:altLabel xml:lang="cs">hábit</skos:altLabel>
        <skos:altLabel xml:lang="fr">vêtements monastiques</skos:altLabel>
        <skos:definition xml:lang="de">Ordenstracht f, Ordensgewand n: durch Regeln vorgeschriebene Kleidung der Angehörigen katholischer Orden und religiöser Gemeinschaften. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Ordenstracht f; Ordensgewand η; Ordenskleidung f; Habit n; lat. habitus religiosus; forma habitus religiosi: durch Statuten, Regeln oder Herkommen vorgeschriebene Kleidung von Angehörigen geistlicher Orden und ähnlicher religiöser Gemeinschaften (seit den Regeln des Benedikt von Nursia für die Klosterkleidung um 530). Die Tracht wird am Beginn des Noviziats bei einer zeremoniellen Einkleidung angenommen. Die Farben der verschiedenen Ordenstrachten variieren im Lauf der Zeit. Nach dem 2. Vatikanischen Konzil befreiten manche Orden ihre männlichen Angehörigen vom Tragen eines Ordenshabits. Die Gewänder der weiblichen Orden wurden modernisiert, z. B. kürzer, auch enger geschnitten oder man wählte zeitgemäße, schlichte Kleidung in Schwarz oder anderen dunklen Farben. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Ordenstracht</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">habit monastique</skos:prefLabel>
        <skos:prefLabel xml:lang="la">habitus religiosus</skos:prefLabel>
        <skos:prefLabel xml:lang="en">monastic habit</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">řeholní hábit</skos:prefLabel>
    </owl:NamedIndividual>
    


