    <!-- https://hist-arch-vocab.org/bvha#c_28b2b8b0 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_28b2b8b0">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
