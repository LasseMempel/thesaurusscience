		<skos:altLabel xml:lang="de">Rieselwiese</skos:altLabel>
		<skos:altLabel xml:lang="de">Stauwiese</skos:altLabel>
		<skos:altLabel xml:lang="de">Wässerwiese</skos:altLabel>
		<skos:prefLabel xml:lang="en">watermeadow</skos:prefLabel>
