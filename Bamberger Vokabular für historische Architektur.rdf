        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_07ffae54"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_54b5911c"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_ec2a9411"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_zafa5lop"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_06776218"/>
