        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T19:10:52.000</terms:modified>
        <skos:definition xml:lang="de">Umlaufender Holzrahmen mit Friesen einer gestemmten Füllungstür. [Schrader / Voigt 2003]</skos:definition>
