		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk009556"/>
		<skos:definition xml:lang="de">Eine Oblate ist eine Dauerbackware in Form einer flachen, runden oder eckigen Scheibe aus ungesäuertem Teig aus Mehl und Wasser. Sie dient als Unterlage für verschiedenes Gebäck oder in der Kirche als Hostie beim Abendmahl.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4172316-8"/>
