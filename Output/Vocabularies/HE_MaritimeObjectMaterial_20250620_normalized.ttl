<http://purl.org/heritagedata/schemes/73/concepts/143453> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75405> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Schist"@en ;
    skos:scopeNote "Medium to coarse grained metamorphic rock, colour being determined by its dominant mineral. Often used for floor and wall claddin"@en .

<http://purl.org/heritagedata/schemes/73/concepts/143960> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75380> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Zinc"@en ;
    skos:scopeNote "Bluewhite metal, obtained from ore, and used commercially for roofing, galvanizing iron, or in alloys. Also used in the 19th century as sheathing for ship's hulls."@en .

<http://purl.org/heritagedata/schemes/73/concepts/144473> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75414> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Beech"@en ;
    skos:scopeNote "A deciduous tree in the family Fagaceae, native to temperate Europe, Asia, and North America."@en .

<http://purl.org/heritagedata/schemes/73/concepts/144480> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/144479> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Felt"@en ;
    skos:scopeNote "Fabric of fibrous materials consolidated by heat and mechanical action so that the fibres are matted together."@en .

<http://purl.org/heritagedata/schemes/73/concepts/146359> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75395> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Onyx"@en ;
    skos:scopeNote "Onyx is a cryptocrystalline form of quartz. It is a semiprecious stone that is usually cut as a cabochon, or into beads, and is also used for intaglios and cameos."@en .

<http://purl.org/heritagedata/schemes/73/concepts/146408> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75381> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Alabaster"@en ;
    skos:scopeNote "Alabaster is a name applied to varieties of two distinct minerals: gypsum and calcite. The finer kinds of alabaster are employed as an ornamental stone, especially for internal decoration as it's softness allows it to be carved into elaborate forms."@en .

<http://purl.org/heritagedata/schemes/73/concepts/147357> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75414> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Birch"@en ;
    skos:scopeNote "The timber from genus Betula, found in Europe and North America, particularly in northern regions."@en .

<http://purl.org/heritagedata/schemes/73/concepts/152383> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75414> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Teak"@en ;
    skos:scopeNote "A strong durable wood originating in India and southeast Asia."@en .

<http://purl.org/heritagedata/schemes/73/concepts/159154> a skos:Concept ;
    skos:altLabel "Aluminum"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75380> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Aluminium"@en ;
    skos:scopeNote "A white ductile metal used, for example, in alloys, for instruments, and in aircraft construction."@en .

<http://purl.org/heritagedata/schemes/73/concepts/160444> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75414> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Ebony"@en ;
    skos:scopeNote "Dark and dense hardwood timber which may be sourced from various species of true ebony from southern Asia and Africa, but the name may also be given to dark hardwoods from elsewhere, e.g. the Americas."@en .

<http://purl.org/heritagedata/schemes/73/concepts/163222> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75381> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Coal"@en ;
    skos:scopeNote "Use for objects made from coal or for stray finds of coal where the association with a wreck site is not proven and thus cannot be stated as either cargo or bunkers."@en .

<http://purl.org/heritagedata/schemes/73/concepts/164107> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75414> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Hazel"@en ;
    skos:scopeNote "A commonly coppiced wood from the genus Corylus."@en .

<http://purl.org/heritagedata/schemes/73/concepts/164111> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/164110> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Hertfordshire Puddingstone"@en ;
    skos:scopeNote "A conglomerate rock comprising well rounded flint pebbles in a very hard matrix of fine pale coloured sand, bound together by hard natural silica cement. The pebbles are usually coloured ochre or red and have black rims."@en .

<http://purl.org/heritagedata/schemes/73/concepts/164394> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75414> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Larch"@en ;
    skos:scopeNote "A deciduous conifer native to Britain and Europe supplying durable and waterproof timber suitable for shipbuilding features such as masts."@en .

<http://purl.org/heritagedata/schemes/73/concepts/166986> a skos:Concept ;
    skos:altLabel "Cornelian"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75405> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Carnelian"@en ;
    skos:scopeNote "A brownishred mineral commonly used as a semiprecious gemstone. A variety of the silica mineral chalcedony coloured by impurities of iron oxide."@en .

<http://purl.org/heritagedata/schemes/73/concepts/166988> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75381> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Plaster"@en ;
    skos:scopeNote "A building material used for coating walls and ceilings. Plaster can refer to gypsum plaster (also known as plaster of Paris), lime plaster, or cement plaster."@en .

<http://purl.org/heritagedata/schemes/73/concepts/166989> a skos:Concept ;
    skos:altLabel "Utahlite"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75381> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Variscite"@en ;
    skos:scopeNote "A brownishred mineral commonly used as a semiprecious gemstone. A variety of the silica mineral chalcedony coloured by impurities of iron oxide."@en .

<http://purl.org/heritagedata/schemes/73/concepts/166991> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75395> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Amethyst"@en ;
    skos:scopeNote "A purple or violet variety of quartz often used in jewelry. Amethyst is a semiprecious stone which owes its violet colour to irridation, iron impurities, and the presence of  trace elements, which result in complex crystal lattice substitutions."@en .

<http://purl.org/heritagedata/schemes/73/concepts/166992> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75381> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Garnet"@en ;
    skos:scopeNote "A silicate mineral used since the Bronze Age as gemstones and abrasives. Found in many colours including red, orange, yellow, green, purple, brown, blue, black, pink and colourless."@en .

<http://purl.org/heritagedata/schemes/73/concepts/166993> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75381> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Emerald"@en ;
    skos:scopeNote "A green coloured gemstone. A variety of the mineral beryl coloured green by trace amounts of chromium and sometimes vanadium."@en .

<http://purl.org/heritagedata/schemes/73/concepts/169900> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75385> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Rubber"@en ;
    skos:scopeNote "Elastic polymeric substance made from the latex of a tropical plant or synthetically."@en .

<http://purl.org/heritagedata/schemes/73/concepts/169986> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75385> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Bakelite"@en ;
    skos:scopeNote "An early plastic formed from a condensation reaction of phenol with formaldehyde which was developed by Leo Baekeland in 1907."@en .

<http://purl.org/heritagedata/schemes/73/concepts/170068> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75405> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Amphibolite"@en ;
    skos:scopeNote "A coarse grained metamorphic rock that is composed maily of green, brown or black amphibole minerals and plagioclase feldspar. Amphiboles are usually members of the hornblende group."@en .

<http://purl.org/heritagedata/schemes/73/concepts/170069> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75405> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Siltstone"@en ;
    skos:scopeNote "A sedimentary rock primarily composed of silt sized particles."@en .

<http://purl.org/heritagedata/schemes/73/concepts/170070> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75405> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Mudstone"@en ;
    skos:scopeNote "A sedimantary rock composed of fine grained clay particles. Flaky mudstone is called shale."@en .

<http://purl.org/heritagedata/schemes/73/concepts/170108> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75385> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Paper"@en ;
    skos:scopeNote "A thin, flexible material made from the pulp of wood or other fibrous matter which is then pressed and dried to form sheets."@en .

<http://purl.org/heritagedata/schemes/73/concepts/170109> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75385> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Charcoal"@en ;
    skos:scopeNote "The black, lightweight and porous residue of partly burnt wood."@en .

<http://purl.org/heritagedata/schemes/73/concepts/170818> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/160192> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Totternhoe Clunch"@en ;
    skos:scopeNote "A relatively hard type of chalk that is sufficiently strong for use as a building stone. Quarried at Totternhoe, Bedfordshire."@en .

<http://purl.org/heritagedata/schemes/73/concepts/170819> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75414> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Ash"@en ;
    skos:scopeNote "A native, broadleaf tree of the Fraxinus species, native to Europe."@en .

<http://purl.org/heritagedata/schemes/73/concepts/170820> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75381> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Sapphire"@en ;
    skos:scopeNote "A blue coloured gem variety of the mineral corunndum, made up of aluminium oxide."@en .

<http://purl.org/heritagedata/schemes/73/concepts/170837> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75405> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Argillite"@en ;
    skos:scopeNote "A finegrained sedimentary rock composed mainly of indurated clay particles which is not as fissile as shale."@en .

<http://purl.org/heritagedata/schemes/73/concepts/170892> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75405> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Soapstone"@en ;
    skos:scopeNote "A talcshist and type of metamorphic rock commonly used for carved stone objects. Also known as Steatite."@en .

<http://purl.org/heritagedata/schemes/73/concepts/170893> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75405> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Andesite"@en ;
    skos:scopeNote "An extrusive igneous, volcanic rock, of intermediate composition, with aphanitic to porphyritic texture. In a general sense, it is the intermediate type between basalt and dacite."@en .

<http://purl.org/heritagedata/schemes/73/concepts/170896> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/171257> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Picrite"@en ;
    skos:scopeNote "A type of basalt rich in the mineral olivine."@en .

<http://purl.org/heritagedata/schemes/73/concepts/170897> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75338> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Wool"@en ;
    skos:scopeNote "Animal fibre that consists of protein held together by lipids obtained from sheep."@en .

<http://purl.org/heritagedata/schemes/73/concepts/171210> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75394> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Porcelain"@en ;
    skos:scopeNote "Hard semitranslucent ceramic material made out of kaolin, quartz and feldspar which is biscuit fired at around 1000 degrees Celsius and glaze fired at around 1300 degrees Celsius."@en .

<http://purl.org/heritagedata/schemes/73/concepts/171262> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75345> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Mortar"@en ;
    skos:scopeNote "A mixture of lime or more recently cement with sand and water used for bonding stones or bricks."@en .

<http://purl.org/heritagedata/schemes/73/concepts/171268> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75405> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Gritstone (Sandstone)"@en ;
    skos:scopeNote "Carboniferous sandstone varying in grain size from coarse to fine and in colour from white, yellow, pink to brown. When only Gritstone is mentioned, unless otherwise specified, assume it to be Gritstone (Sandstone), as this is the more common usage."@en .

<http://purl.org/heritagedata/schemes/73/concepts/171269> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75380> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Slag"@en ;
    skos:scopeNote "Waste material or dross separated from metals during smelting or refining."@en .

<http://purl.org/heritagedata/schemes/73/concepts/171270> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/171264> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Flax"@en ;
    skos:scopeNote "The fibrous stalks of the plant, Linum usitatissimum, which can be processed and used to manufacture linen."@en .

<http://purl.org/heritagedata/schemes/73/concepts/171271> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75414> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Alder"@en ;
    skos:scopeNote "Wood from trees of the genus Alnus in the birch family Betulaceae."@en .

<http://purl.org/heritagedata/schemes/73/concepts/171272> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/170838> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Plastic"@en ;
    skos:scopeNote "Any of large class of polymers based on synthetic resins or modified natural polymers which may be moulded, extruded or cast while soft or liquid, which then set rigidly or slightly elastic in form."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75337> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75381> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Amber"@en ;
    skos:scopeNote "A semiprecious, fossilised resin usually used for ornamentation and jewellery."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75339> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75342> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Antler"@en ;
    skos:scopeNote "A form of bone, which grows on the heads of members of the deer family and is shed annually. Antler can be used by man for a variety of purposes."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75343> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75335> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Brass"@en ;
    skos:scopeNote "Easily formed metal alloy composed of copper and zinc."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75344> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75335> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Bronze"@en ;
    skos:scopeNote "Hard, corrosive alloy of copper and tin."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75346> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75381> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Chert"@en ;
    skos:scopeNote "A hard silica rich rock, black or brown coloured, commonly found in nodular form."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75348> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75381> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Clay"@en ;
    skos:scopeNote "A fine grained earth which becomes more plastic when water is added and can be moulded and dried to make bricks, tile, pottery, etc."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75349> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75381> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Concrete"@en ;
    skos:scopeNote "Composed of sand, stones or other aggregate and cement mixed with water which sets in a hard mass. The material is usually associated with modern building but was developed by Romans where cement was obtained from quicklime."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75350> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75380> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Copper"@en ;
    skos:scopeNote "Metal used primarily for roofing and ornamental purposes, being lighter and stronger than lead."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75351> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75335> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Copper Alloy"@en ;
    skos:scopeNote "An alloy where the predominant component metal is copper."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75353> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75394> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Earthenware"@en ;
    skos:scopeNote "A claybased ceramic fired at low kiln temperatures (c.8001200 degrees). Essentially, earthenwares are porous and require glazing for most applications. This term has been used interchangeably with TERRACOTTA and with POTTERY"@en .

<http://purl.org/heritagedata/schemes/73/concepts/75357> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75381> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Enamel"@en ;
    skos:scopeNote "A coloured, glasslike substance (opaque or partially opaque) that is fused to the surface of metal or glass or pottery for decorative or protective purposes."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75358> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75381> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Faience"@en ;
    skos:scopeNote "A glasslike compound first made in ancient Egypt. It involves coating a core material of powdered quartz with a vitreous alkaline glaze. Also the name given to a tinglazed earthenware."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75359> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75381> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Flint"@en ;
    skos:scopeNote "Hard, durable, dark grey stone, the purest native form of silica, which can either be used decoratively or as a main material. Predominantly found in East Anglia and the South East."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75362> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75380> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Gold"@en ;
    skos:scopeNote "A malleable, ductile ferromagnetic metal widely used for structural and decorative purposes."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75363> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75405> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Granite"@en ;
    skos:scopeNote "A hard, coarse grained, durable igneous rock. Can be used decoratively or as a main material. Found throughout the country."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75364> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75405> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Greenstone"@en ;
    skos:scopeNote "Geologist's term for any dark coloured, slightly metamorphosed igneous rock. Index with specific stone type where given."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75368> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75338> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Horn"@en ;
    skos:scopeNote "Horn is a hollow, bonelike projection consisting mainly of keratin, found on certain animals (sheep, cows, goats etc.)"@en .

<http://purl.org/heritagedata/schemes/73/concepts/75369> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75380> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Iron"@en ;
    skos:scopeNote "A malleable, ductile ferromagnetic metal widely used for structural and decorative purposes."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75370> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75411> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Ivory"@en ;
    skos:scopeNote "A hard, white, finegrained substance forming the main part of the tusks of elephants, walruses, hippos and narwhals."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75372> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75381> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Jet"@en ;
    skos:scopeNote "A hard, black form of lignite that takes a brilliant polish. It is used in jewellery and for ornamentation."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75373> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75405> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Lava"@en ;
    skos:scopeNote "A hard, igneous rock formed from the cooling of molten volcanic magma."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75374> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75380> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Lead"@en ;
    skos:scopeNote "Metal used primarily for roof coverings and window fittings. It is easy to work, can be worked cold and does not rust which makes it suitable for holding or repelling water."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75376> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75338> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Leather"@en ;
    skos:scopeNote "Animal skin that has been hardened or treated by a tanning process."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75377> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75405> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Limestone"@en ;
    skos:scopeNote "Sedimentary rock consisting mainly of calcium carbonate. Varying in grain size, colour and hardness, quarried and used throughout the country."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75379> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75405> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Marble"@en ;
    skos:scopeNote "Collective name for, in a true geological sense, a metamorphosed limestone, eg. Carrara marble, and, in the British sense any decorative stone that will take a polish, eg. Purbeck marble. In the latter's case index with specific stone type where given"@en .

<http://purl.org/heritagedata/schemes/73/concepts/75384> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75414> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Oak"@en ;
    skos:scopeNote "A native hardwood of the Beech family with hard and durable characteristics which traditionally made it appropriate for structural work."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75386> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75381> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Obsidian"@en ;
    skos:scopeNote "A form of volcanic glass with similar properties to FLINT and often used in the manufacture of sharpedged tools."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75390> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75335> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Pewter"@en ;
    skos:scopeNote "An alloy which is composed predominantly of tin (c.8599 percent)."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75396> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75405> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Sandstone"@en ;
    skos:scopeNote "Geologically sandstone consists of particles of quartz naturally cemented together by either silica, calcium or iron. It is this geological composition that accounts for the varying colours and grain sizes found in the many building sandstones."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75398> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75405> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Shale"@en ;
    skos:scopeNote "Soft, very fine grained, dark coloured, sedimentary rock which splits easily."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75399> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75338> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Shell"@en ;
    skos:scopeNote "Hard, protective covering made largely of calcium salts secreted by soft bodied invertebrate animals."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75401> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75380> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Silver"@en ;
    skos:scopeNote "A precious metal of lustrous white colour with great malleability and ductility."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75403> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75405> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Slate"@en ;
    skos:scopeNote "Collective term for a hard, fine grained, dark coloured metamorphic rock, which splits easily; hence its common use as a roofing and flooring material, and a functional description for any rectangular, sheet, roofing material."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75404> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75335> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Steel"@en ;
    skos:scopeNote "A strong, durable alloy of iron and carbon."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75408> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75394> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Terracotta"@en ;
    skos:scopeNote "Hard, unglazed, brown, versatile earthenware which can be used as a tile or moulded into statuary."@en .

<http://purl.org/heritagedata/schemes/73/concepts/75410> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75380> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Tin"@en ;
    skos:scopeNote "A soft, lustrous lowmelting crystalline metallic element that is malleable and ductile at ordinary temperatures and that is used as a protective coating, in tinfoil, and in soft solders and alloys."@en .

<http://purl.org/heritagedata/schemes/73/concepts/99959> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75335> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Quartzite"@en ;
    skos:scopeNote "Medium grained, hard, white/grey coloured stone consisting of quartz and often silica, produced by the metamorphosis of sandstone"@en .

<http://purl.org/heritagedata/schemes/73/concepts/143865> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75380> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Antimony"@en ;
    skos:related <http://purl.org/heritagedata/schemes/73/concepts/75335> ;
    skos:scopeNote "A metallic element often used in alloys and historically used in pottery and glassmaking, paints, enamelling, and in cosmetics and medicine. Often derived from its sulphite ore, stibnite."@en .

<http://purl.org/heritagedata/schemes/73/concepts/144479> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75385> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Textile"@en ;
    skos:scopeNote "A woven or bonded fabric or cloth."@en .

<http://purl.org/heritagedata/schemes/73/concepts/146351> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75405> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Jade"@en ;
    skos:related <http://purl.org/heritagedata/schemes/73/concepts/75371> ;
    skos:scopeNote "An ornamental green stone of the mineral nephrite."@en .

<http://purl.org/heritagedata/schemes/73/concepts/151858> a skos:Concept ;
    skos:altLabel "Fiberglass"@en,
        "Glass Fibre"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75385> ;
