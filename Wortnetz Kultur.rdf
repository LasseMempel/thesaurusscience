		<skos:prefLabel xml:lang="en">internment camp</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003611"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk003737"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019684"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk003611"/>
		<xe:explanation_temp xml:lang="de">Ein Internierungslager dient dem Inhaftnehmen (Internieren) und zwangsweise Festhalten von Kriegsgefangenen, nicht erwünschten oder als staatsfeindlich betrachteten Personen oder Gruppen, aber auch von Emigranten, Flüchtlingen oder infolge eines Krieges nicht am Ort beheimateten Zivilpersonen so genannten &amp;quot;Displaced Persons&amp;quot;</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Internierungslager ist ein Gefangenenlager, das von einer kriegsführenden Partei oder einer neutralen Macht auf eigenem oder fremdem Staatsgebiet errichtet und militärisch bewacht ist.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003611"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003737"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019684"/>
