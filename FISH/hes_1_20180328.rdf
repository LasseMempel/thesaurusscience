		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502121" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1019" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1393" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1400" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1409" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1433" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1801" />
		<skos:scopeNote xml:lang="en">A sheltered port for ships.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
