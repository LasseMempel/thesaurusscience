        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-22T14:35:44.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T17:58:20.000</terms:modified>
        <skos:definition xml:lang="de">Ein wiederkehrender Wechsel von Pfeilern und Säulen, bei dem ein Pfeiler auf eine oder mehrere Säulen folgen kann, auch Wechsel von runden und quadrat. Pfeilern mit Diensten. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Eine sich nach einem bestimmten Rhythmus vollziehende Abfolge unterschiedlicher Stützen, z. B. der Wechsel zwischen Pfeilern und Säulen. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="cs">Střídání pilířů (P) a sloupů (S) v pořadí P-S-P-S, nebo P-S-S-P. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Wechsel von Pfeiler P und Säule S im Mittelschiff romanischer Basiliken, entweder in der Abfolge P-S-P-S oder P-S-S-P. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Stützenwechsel</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">alternance de supports</skos:prefLabel>
        <skos:prefLabel xml:lang="it">alternanza dei supporti</skos:prefLabel>
        <skos:prefLabel xml:lang="es">soportes dispuestos alternadamente</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">střídání podpor</skos:prefLabel>
        <skos:prefLabel xml:lang="en">system of alternating supports</skos:prefLabel>
    </owl:NamedIndividual>
    


