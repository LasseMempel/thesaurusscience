        <skos:altLabel xml:lang="fr">velum</skos:altLabel>
        <skos:altLabel xml:lang="fr">vélum</skos:altLabel>
        <skos:definition xml:lang="de">Velum n: Tuch, das zum Bedecken, Verhüllen oder Berühren von liturgischen Geräten und Opfergaben dient. [Glossarium Artis]</skos:definition>
