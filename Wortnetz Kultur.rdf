		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk011755"/>
		<skos:definition xml:lang="de">Schluff ist ein Sediment, das aus Partikeln in der Größe zwischen 0,063 mm und 0,002 mm besteht. </skos:definition>
