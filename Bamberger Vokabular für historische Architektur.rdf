        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-18T16:38:42.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T13:28:36.000</terms:modified>
        <skos:definition xml:lang="de">Die Ausmauerung der Hohlräume hinter einer vorgeblendeten Schale aus besserem Material, auch das Ausfüllen des Hohlraums zwischen der Gewölbeschale und dem aufgehenden Mauerwerk. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Eine Aufmauerung zwischen Widerlagsmauer und Gewölberücken. Sie stabilisiert  die Gewölbeschale und wird bis zu zwei Dritteln ihrer Höhe aufgeführt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Hintermauerung (Gewölbe)</skos:prefLabel>
        <skos:prefLabel xml:lang="en">backing (vault)</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">maçonnerie de remplissage (voûte)</skos:prefLabel>
    </owl:NamedIndividual>
    


