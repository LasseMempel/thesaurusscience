        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-31T00:01:58.000</terms:modified>
        <skos:definition xml:lang="de">Polyptychon (griech. polys = viel; ptyx, Genitiv ptychos = Falte; polyptychos = faltenreich), Flügelaltar (Altar) oder Gemälde mit mehr als 2 Flügeln. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Řec. polys = mnoho; ptyx, 2. p. ptychos = záhyb; polyprychos = s četnými záhyby,  křídlový oltář, nebo obraz s více než 2 křídly. [Koch 2008]</skos:definition>
        <skos:note xml:lang="de">Mehrflügeliger (&gt;3), klappbarer Altaraufsatz. </skos:note>
        <skos:prefLabel xml:lang="de">Polyptychon</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">polyptych</skos:prefLabel>
        <skos:prefLabel xml:lang="en">polyptych</skos:prefLabel>
    </owl:NamedIndividual>
    


