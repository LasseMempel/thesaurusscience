<http://www.eionet.europa.eu/gemet/concept/9241> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8076> ;
    skos:closeMatch <http://data.uba.de/umt/_00027347> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Wasserstatistik"@de,
