        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-04T09:10:52.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-20T09:49:43.000</terms:modified>
        <skos:altLabel xml:lang="de">9. Seraph</skos:altLabel>
        <skos:altLabel xml:lang="cs">9. serafín</skos:altLabel>
        <skos:altLabel xml:lang="de">Seraphim</skos:altLabel>
        <skos:definition xml:lang="cs">Podle Izaiáše 6,2 a 6,6 andělé u božího trůnu, kteří si 2 křídly zakrývají tvář a nohy a 2 dalšími křídly létají, symboly rychlosti, jíž má být uskutečněna boží vůle, symbolická barva: modrá. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Seraph</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">serafín</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_84c3d82b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_84c3d82b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_89b7da10"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-04T15:20:22.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T14:35:10.000</terms:modified>
        <skos:note xml:lang="en">A study which involves any number of professionals using a systematic approach and analytical tools to answer diverse questions concerning the conservation of wall paintings or decorative stone surfaces. [EwaGlos]</skos:note>
        <skos:note xml:lang="de">Untersuchung durch eine beliebige Anzahl von Fachleuten, die einen systematischen Ansatz und analytische Werkzeuge benutzen, um verschiedene Fragen über den Erhaltungszustand einer Wandmalerei oder dekorativer Steinoberflächen zu beantworten. [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="de">naturwissenschaftliche Untersuchung </skos:prefLabel>
        <skos:prefLabel xml:lang="en">scientific investigation</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_84ce464e -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_84ce464e">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_d936f79a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c7b144d0"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-22T19:02:12.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T14:41:14.000</terms:modified>
        <skos:definition xml:lang="de">Spezielle zweiteilige Verriegelung, die aus einem einarmigen Hebel auf Platte mit Griffolive sowie einem Haken auf Platte als Gegenstück besteht. Sie dient bei einem zweiflügeligen Fenster als Verschluss und ist in Griffhöhe etwa mittig auf beiden Fensterflügelrahmen befestigt. Wird häufig durch einen Vorreiber oben und unten ergänzt, die in den Fensterrahmen eingelassen sind. [Pax - Fenster &amp; Türen Fachbegriffe]</skos:definition>
        <skos:prefLabel xml:lang="de">Aufreiber</skos:prefLabel>
    </owl:NamedIndividual>
    


