	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk014338">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Trauzettel</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk018001"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013670"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk018001"/>
		<skos:definition xml:lang="de">Ein Trauzettel ist eine Aufzeichnung, die vom Pfarrer vor der Trauung ausfüllt wird. Der Trauzettel ist kein rechtlich bindendes Dokument sondern beinhaltet neben den persönlichen Angaben der Brautleute auch Ort und Datum der Eheschließung.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk013670"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk018001"/>
