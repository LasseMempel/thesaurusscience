    <!-- https://hist-arch-vocab.org/bvha#c_1c7f7aaf -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_1c7f7aaf">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_pjvitn4h"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
