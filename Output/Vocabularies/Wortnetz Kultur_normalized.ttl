<http://lvr.vocnet.org/wnk/wk009226> a skos:Concept ;
    skos:altLabel "Farne"@de,
        "Farnpflanzen"@de,
        "fern allies"@en,
        "ferns"@en ;
    skos:broader <http://lvr.vocnet.org/wnk/wk000855> ;
    skos:closeMatch <http://d-nb.info/gnd/4016483-4> ;
    skos:definition "Farnpflanzen (Polypodiophyta) sind eine Gruppe von Gefäßsporenpflanzen. Sie besitzen echte Wurzeln, Sprosse und charakteristische, meist gefiederte Blätter (Wedel). Anstelle von Samen vermehren sie sich über Sporen, die in Sporangien gebildet werden, häufig auf der Unterseite der Wedel. Farne gehören zu den ältesten Linien landbewohnender Pflanzen und sind weltweit verbreitet, vor allem in feuchten Lebensräumen."@de ;
    skos:exactMatch <http://vocab.getty.edu/aat/300375590>,
        <http://www.wikidata.org/entity/Q80005> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Farn"@de,
        "fern"@en .

