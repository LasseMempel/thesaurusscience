		<skos:prefLabel xml:lang="gd">STÈISEAN A' PHOILIS</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Oifis no prìomh-oifis aig feachd ionadail a' phoileis no aig sgìre a' phoileis.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">POLICE STATION</skos:prefLabel>
