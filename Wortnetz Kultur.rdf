	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021032">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Dendrolith</skos:altLabel>
		<skos:altLabel xml:lang="de">Holzstein</skos:altLabel>
		<skos:prefLabel xml:lang="en">petrified wood</skos:prefLabel>
		<skos:altLabel xml:lang="de">Versteinerte Hölzer</skos:altLabel>
		<skos:prefLabel xml:lang="de">Versteinertes Holz</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk001812"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk001812"/>
		<skos:definition xml:lang="de">Versteinertes Holz ist ein pflanzliches Fossil, das aus den mineralisierten Überresten von Holz besteht, wobei die ursprüngliche Struktur und oft auch feine Details wie Jahresringe oder Zellmuster erhalten geblieben sind. Dabei wurde das organische Material durch Mineralien wie Siliziumdioxid ersetzt, sodass das Holz in Gestein umgewandelt wurde, ohne dass seine äußere Form und innere Struktur verloren gingen.</skos:definition>
		<skos:broadMatch rdf:resource="http://d-nb.info/gnd/4368476-2"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q837117"/>
