        <skos:altLabel xml:lang="de">Dachboden (Raum)</skos:altLabel>
        <skos:altLabel xml:lang="de">Dachehre</skos:altLabel>
        <skos:altLabel xml:lang="de">Dachsöller</skos:altLabel>
        <skos:definition xml:lang="de">Dachboden, Dachehre, Dachsöller, Dachraum, der von der Dachbalkenlage und den Dachflächen begrenzte Raum des Steildachs (Dach) [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Der von Dachgebälk und Dachfläche gebildete Raum. Er liegt meist auf der Dachbalkenlage und wird als Dachboden verwendet. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Dachraum</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">půda</skos:prefLabel>
    </owl:NamedIndividual>
    


