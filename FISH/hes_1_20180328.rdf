		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1645" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1741" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1742" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1747" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1750" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1921" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1923" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1749">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1749</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">LÀRACH SEARMONACHAIDH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Structar, lann no àite nàdarra a tha ris na speuran 's a thathar a' cleachdadh mar àite-adhraidh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">PREACHING SITE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1740" />
				<skos:scopeNote xml:lang="en">An open air structure, enclosure or natural feature used as a place of worship.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1751" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/503166" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/507542">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/507542</dcterms:identifier>
				<skos:prefLabel xml:lang="en">SIKH TEMPLE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-10-24T16:19:34</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-10-24T16:23:08</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
