    <!-- https://hist-arch-vocab.org/bvha#c_a98bf67f -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_a98bf67f">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_d6df06d8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-19T23:01:06.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-18T14:03:17.000</terms:modified>
        <skos:altLabel xml:lang="de">Al secco</skos:altLabel>
        <skos:altLabel xml:lang="de">Secco-Malerei</skos:altLabel>
        <skos:altLabel xml:lang="de">Seccomalerei</skos:altLabel>
        <skos:altLabel xml:lang="de">Sekko-Technik</skos:altLabel>
        <skos:altLabel xml:lang="de">Trockenmalerei</skos:altLabel>
        <skos:altLabel xml:lang="en">secco painting</skos:altLabel>
        <skos:definition xml:lang="de">(ital. al secco ›auf dem Trockenen‹) Malen auf trockenem Putz im Gegensatz zum Fresko, das auf den noch feuchten Putz gemalt wird. Da sie weniger haltbar ist, wurde S. vor allem in Innenräumen verwendet. Ihr Vorteil ist, dass auch vorhandene Flächen und andere Trägermaterialien (Holz, Leinwand, Stein) bemalt werden können. Gerade die im Burgenbau vorkommende Wandmalerei, etwa die Fugenmalerei, Fensterumrahmungen, gemalte Friese und Ornamentmalerei, wurde häufig als S. aufgebracht. Bei vielen barocken Deckenmalereien, die als Fresko aufgebracht wurden, wurden mit Hilfe der S. noch zusätzlich Lichter aufgesetzt und Feinheiten eingearbeitet. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:definition xml:lang="de">Al-secco-Malerei (ital. secco = trocken), Wasserfarben auf trockener Wand. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Im Gegensatz zur Freskomalerei eine Wandmalerei auf trockener Putzfläche. [Koepf / Binding 2016]</skos:definition>
        <skos:note xml:lang="en">A wall painting technique where pigments mixed with an organic binder and /or lime are applied onto a dry plaster. [EwaGlos]</skos:note>
        <skos:note xml:lang="de">Bei dieser Wandmalereitechnik werden Pigmente in einem organischen Bindemittel und/oder in Kalk gebunden und auf einen trockenen Putz aufgetragen. [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="de">Secco</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">al secco</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">peinture à secco</skos:prefLabel>
        <skos:prefLabel xml:lang="es">pintura en seco</skos:prefLabel>
        <skos:prefLabel xml:lang="it">pittura a secco</skos:prefLabel>
        <skos:prefLabel xml:lang="en">secco</skos:prefLabel>
    </owl:NamedIndividual>
    


