        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-01T13:55:38.000</terms:modified>
        <skos:definition xml:lang="de">Entwässerungsrinne zwischen Dächern, auf Strebebogen, im Altertum und MA in Wasserspeiern, später in Ablaufrohren mündend, auch zur Entwässerung von Hofflächen und Straßen. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Ablaufrinne</skos:prefLabel>
    </owl:NamedIndividual>
    


