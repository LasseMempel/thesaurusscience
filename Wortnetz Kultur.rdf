	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk020964">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Fotokopie</skos:prefLabel>
		<skos:altLabel xml:lang="de">Fotokopien</skos:altLabel>
		<skos:altLabel xml:lang="en">photocopies</skos:altLabel>
		<skos:altLabel xml:lang="en">photocopy</skos:altLabel>
		<skos:altLabel xml:lang="de">Photokopie</skos:altLabel>
		<skos:altLabel xml:lang="de">Photokopien</skos:altLabel>
		<skos:altLabel xml:lang="en">xerographic copies</skos:altLabel>
		<skos:prefLabel xml:lang="en">xerographic copy</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk012196"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk020974"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk012196"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk020974"/>
		<skos:definition xml:lang="de">Eine Fotokopie ist eine Reprografie, die durch elektrofotografische Verfahren mit elektrisch geladenem Farbpulver auf Papier erzeugt wird. Zur Herstellung von Fotokopien werden Kopiergeräte eingesetzt. Seit Mitte des 20. Jahrhunderts existiert dafür quasi ausschließlich das Verfahren der Xerokopie, davor gab es noch einige andere Verfahren zur Herstellung von Fotokopien.</skos:definition>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300028484"/>
		<skos:mappingRelation rdf:resource="http://www.wikidata.org/entity/Q67137379"/>
