		<skos:prefLabel xml:lang="gd">TAIGH-CUIBHLE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Nàdar de thaigh-cruinn aig an robh saidhean cloiche na bhroinn a' cumail taic ris a' mhullach 's iad ann an cruth cuibhle.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">WHEELHOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-26T12:04:15</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/445" />
