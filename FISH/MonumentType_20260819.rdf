    <dc1:spatial rdf:resource="http://dbpedia.org/resource/England"/>
    <dc1:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
    <skos:broader>
      <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70010">
        <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2"/>
        <skos:prefLabel xml:lang="en">ROUND BARROW</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Hemispherical mound surrounded by a ditch (or occasionally two or more concentric ditches), often accompanied by an external (or occasionally internal) bank. Mound and ditch may sometimes be separated by a berm. Use specific type where known.</skos:scopeNote>
        <dc1:identifier rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70010"/>
        <dc1:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-08-19T18:09:31</dc1:issued>
