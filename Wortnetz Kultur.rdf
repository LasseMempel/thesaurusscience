	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021351">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Rabattmarke</skos:prefLabel>
		<skos:altLabel xml:lang="de">Rabattmarken</skos:altLabel>
		<skos:prefLabel xml:lang="en">trading stamp</skos:prefLabel>
