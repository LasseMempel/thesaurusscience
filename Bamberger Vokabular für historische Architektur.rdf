        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_afccf351"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_d6df06d8"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_eb0f6a4b"/>
