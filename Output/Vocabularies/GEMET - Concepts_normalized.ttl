    skos:broader <http://www.eionet.europa.eu/gemet/concept/4505> ;
    skos:definition "Method in which water drips to the soil from perforated tubes or emitters. This irrigation technology is water conserving compared to flooding, furrows, and sprinklers."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_7909> ;
