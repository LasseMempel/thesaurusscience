    <skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/MBA"/>
    <time:hasBeginning xml:lang="en">-2600</time:hasBeginning>
    <time:hasEnd xml:lang="en">-0700</time:hasEnd>
    <skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/BA"/>
    <skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/11/concepts/505101"/>
    <skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300019275"/>
    <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_period"/>
