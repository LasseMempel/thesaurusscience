    <!-- https://hist-arch-vocab.org/bvha#c_4c65dafc -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_4c65dafc">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_5270d2e2"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_39b2b180"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_488e4532"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_f0d01b1b"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_f62019cd"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-26T14:16:27.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T15:09:33.000</terms:modified>
        <skos:altLabel xml:lang="de">Minorist</skos:altLabel>
        <skos:altLabel xml:lang="de">niedriger Kleriker</skos:altLabel>
        <skos:definition xml:lang="de">Die Angehörigen der niederen Weihen f pl, lat. ordines minores, die sogenannten Minoristen m pl, versehen vor allem Hilfsdienste. Zu ihnen gehören Ostiarier, Lektoren, Exorzisten und Akolythen. Durch motu proprio Pauls VI. &quot;ministeria quaedam&quot; vom 10.8.1972 wurden die niederen Weihen als Weihen abgeschafft, als &quot;Dienste&quot;, zu denen jedoch auch Laien beauftragt werden können, wurden sie teilweise beibehalten. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">niedere Weihe</skos:prefLabel>
        <skos:prefLabel xml:lang="la">ordines minores</skos:prefLabel>
    </owl:NamedIndividual>
    


