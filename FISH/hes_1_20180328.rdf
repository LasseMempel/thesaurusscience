	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/473">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/473</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LOIDSE-GÀIRNEALAIR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach a chleachdas gàirnealairean agus a bhios na àite-còmhnaidh dhaibh. Mar is trice ann an crìochan taighe mhòir no oighreachd.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GARDENERS LODGE</skos:prefLabel>
