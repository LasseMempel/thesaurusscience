		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk004182"/>
		<skos:definition xml:lang="de">Eine Tragfläche ist ein flächiges Fahrzeugteil, das üblicherweise als Paar, also an beiden Seiten eines Fahrzeugs, dazu dient, dynamischen Auftrieb aus Vortrieb zu erzeugen.</skos:definition>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4060582-6"/>
		<skos:narrowMatch rdf:resource="https://www.wikidata.org/wiki/Q20078304"/>
