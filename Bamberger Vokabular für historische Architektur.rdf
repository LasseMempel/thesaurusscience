        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-04T09:44:57.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T15:33:05.000</terms:modified>
        <skos:altLabel xml:lang="de">doppelchörige Anlage</skos:altLabel>
        <skos:definition xml:lang="de">Kirche mit Ost- und Westchor. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Kirche mit einem Ost- und einem Westchor, oft auch zusammen mit einer Verdoppelung des Querhauses, seit etwa 800 bis zur Spätromanik bes. in Deutschland vorkommend. Die Schaffung eines zweiten Chores kann durch Aufnahme eines neuen Kirchenpatrons, eines Heiligengrabs oder andere Gründe bedingt sein. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Kostel s východním i západním chórem. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Doppelchoranlage</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">dvouchórový kostel</skos:prefLabel>
    </owl:NamedIndividual>
    


