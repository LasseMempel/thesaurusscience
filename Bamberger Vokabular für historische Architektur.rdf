    <!-- https://hist-arch-vocab.org/bvha#c_ciswiq6l -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_ciswiq6l">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_33419034"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_04173002"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_09221812"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_76382db2"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_dc16c739"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-04T14:05:38.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T15:42:15.000</terms:modified>
        <skos:definition xml:lang="cs">Autoři 4 evangelií Nového zákona: Matouš, Marek, Lukáš a Jan, z nichž Matouš a Jan byli také apoštoly. Od 4. stol. byli zobrazováni pomocí okřídlených symbolů: člověk (= Matouš), lev (= Marek), býk (= Lukáš), orel (= Jan), nebo byly tyto znaky připojovány k figurálním zobrazením evangelistů jako atributy (podle Ezechiela 1,5-14); až do 13. stol. také souhrnně v jediné postavě, tzv. tetramorf (řec. čryřpostava). [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Die Verfasser der 4 Evangelien des Neuen Testaments: Matthäus, Markus, Lukas, Johannes, von denen Matthäus und Johannes auch Apostel waren. Seit dem 4. Jh. werden sie durch ihre geflügelten Symbole: Mensch ( = Matthäus), Löwe ( = Markus), Stier (= Lukas), Adler (= Johannes) dargestellt, oder diese Kennzeichen werden den figürlichen Darstellungen der Evangelisten als Attribute beigegeben (nach Ezechiel 1,5-14). Bis zum 13. Jh. auch in einer einzigen Gestalt, dem Tetramorph (griech. Viergestalt), zusammengefasst. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Evangelist</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">evangelista</skos:prefLabel>
    </owl:NamedIndividual>
    


