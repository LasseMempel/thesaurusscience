		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk018390"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk006114"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk018888"/>
		<skos:definition xml:lang="de">Ein Splint ist ein Sicherungselement, das aus einem gespaltenen Stift aus Metall besteht und der Lagesicherung verbundener Bauteile dient. Er wird durch eine gebohrte Öffnung in  Radnaben, Schrauben und Bolzen gesteckt und durch Auseinanderbiegen seiner Enden befestigt.</skos:definition>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300036436"/>
		<skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q1412569"/>
