	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk004489">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="en">altar of celebrations</skos:altLabel>
		<skos:altLabel xml:lang="en">celebration altar</skos:altLabel>
		<skos:prefLabel xml:lang="en">main altar</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Volksaltar</skos:prefLabel>
		<skos:altLabel xml:lang="de">Volksaltäre</skos:altLabel>
		<skos:altLabel xml:lang="de">Zelebrationsaltar</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk001513"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk001513"/>
		<xe:explanation_temp xml:lang="de">Der Volksaltar als Ergänzung zum Hauptaltar wurde nach der Liturgiereform von 1964 notwendig, in deren Folge der Priester die Messe mit dem Gesicht zum Volk feiert. Das war an den alten Hauptaltären, die unmittelbar an der Chorwand stehen, nicht möglich.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Volksaltar ist ein Altar, in einer katholischen Kirche, an dem regelmäßig die Messe gefeiert wird.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4242157-3"/>
