        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T16:56:44.000</terms:modified>
        <skos:definition xml:lang="de">Eine nur zu einem kleinen Teil in die rückwärtige Mauer oder den Pfeilerkern eingebundene Säule. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Sloup, který vystupuje pouze ze tří čtvrtin z jádra pilíře nebo stěny. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Säule (Dienst), die nur zu Dreivierteln aus Pfeilerkern oder Wand hervortritt. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Dreiviertelsäule</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">tříčtvrteční sloup</skos:prefLabel>
    </owl:NamedIndividual>
    


