    <!-- https://hist-arch-vocab.org/bvha#c_35f80b69 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_35f80b69">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_6ee54738"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_8c67a8cc"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_e956df25"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-01T09:59:33.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-20T11:19:39.000</terms:modified>
        <skos:definition xml:lang="de">Die Summe der unveränderlichen Lasten. Das Gewicht der tragenden oder stützenden Bauteile und die unveränderlichen, von den tragenden Bauteilen dauernd aufzunehmenden Lasten, z.B. Auffüllungen, Fußbodenbeläge, Putz usw.</skos:definition>
        <skos:prefLabel xml:lang="de">ständige Laste</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_35ra9ohy -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_35ra9ohy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b99ef53b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-10T16:05:14.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-12-01T10:36:14.000</terms:modified>
        <skos:altLabel xml:lang="cs">dešt\&apos;ové vody</skos:altLabel>
        <skos:definition xml:lang="de">Abtraufe, Ansetztraufe; wasserabführendes Rohr aus Blech oder Stein an einer Rinnleiste, oft in figürl. Ausschmückung als Tier, Drache, Mensch, so bes. an Tempeln und got. Kathedralen, falls keine Abfallrohre der Dachrinne vorhanden sind. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Vom Dach vorspringende Regenablaufrinne, die das Mauerwerk vor Nässe schützt. Am antiken Tempel als Löwenkopf, in der Gotik als skurrile Figuren (Tiere, Menschen, Fabelwesen), deren Symbolwerte heute oft nicht mehr zu deuten sind. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Vyústění okapu vystupující ze střechy, které chrání zdivo před vlhkostí; v antickém chrámu v podobě lví hlavy, v gotice jako groteskní figury (zvířata, lidé, bájné bytosti), jejichž symbolický význam dnes již často nelze vyložit. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Wasserspeier</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">chrlič</skos:prefLabel>
        <skos:prefLabel xml:lang="it">doccione</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">gargouille</skos:prefLabel>
        <skos:prefLabel xml:lang="en">gargoyle</skos:prefLabel>
        <skos:prefLabel xml:lang="es">gárgola</skos:prefLabel>
    </owl:NamedIndividual>
    


