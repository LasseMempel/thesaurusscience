    <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2"/>
    <skos:prefLabel xml:lang="en">TIMEBALL TOWER</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A structure for visually communicating the exact time to ships in anchorage. A ball slides down a mast at the top of the tower, usually at noon or one o'clock exactly.</skos:scopeNote>
    <dc1:identifier rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93578"/>
    <dc1:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-08-19T18:09:31</dc1:issued>
