<http://www.eionet.europa.eu/gemet/concept/7630> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9144> ;
    skos:closeMatch <http://data.uba.de/umt/_00020913> ;
    skos:definition "Area of land on which sewage or any other type of waste water is distributed in order to purify it; it is a kind of waste water treatment."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Rieselfeld"@de,
