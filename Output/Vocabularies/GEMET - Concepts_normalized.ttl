    skos:closeMatch <http://dbpedia.org/resource/Statutory_declaration> ;
    skos:definition "A declaration made in a prescribed form before a justice of the peace, notary public, or other person authorized to administer an oath."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Eidesstattliche Erklärung"@de,
        "statutory declaration"@en .

<http://www.eionet.europa.eu/gemet/concept/11430> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8047> ;
    skos:closeMatch <http://data.uba.de/umt/_00050083> ;
    skos:definition "A standard which has been approved pursuant to the statutes of the standards bodies with which the Community has concluded agreements."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/3646> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Europäische Norm"@de,
        "European standard"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/European_Committee_for_Standardization> .

<http://www.eionet.europa.eu/gemet/concept/11431> a skos:Concept ;
