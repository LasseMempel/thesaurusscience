	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk011126">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Essig</skos:prefLabel>
		<skos:altLabel xml:lang="de">Essige</skos:altLabel>
		<skos:prefLabel xml:lang="en">vinegar</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk014914"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013755"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk014914"/>
		<xe:explanation_temp xml:lang="de">Essig zeichnet sich durch einen sauren Geschmack aus. Je nach Herstellung und Geschmacksrichtung kann Essig aber auch Noten von Gewürzen, Kräutern oder Früchten enthalten.</xe:explanation_temp>
		<skos:definition xml:lang="de">Essig ist Essigsäure, die stark verdünnt, vornehmlich als Würzmittel und Konservierungsmittel in der Küche Verwendung findet. Die Flüssigkeit wird durch Gärung von zumeist alkoholischen Flüssigkeiten mit Essigbakterien oder Verdünnung von Essigessenz gewonnen.</skos:definition>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4153051-2"/>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300011755"/>
