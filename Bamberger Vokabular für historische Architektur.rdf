        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-26T14:31:59.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T11:46:05.000</terms:modified>
        <skos:altLabel xml:lang="de">Marienhemd</skos:altLabel>
        <skos:altLabel xml:lang="la">Sancta Camisia</skos:altLabel>
        <skos:definition xml:lang="de">Marienkleid n; Marienhemd n; lat. camisia Mariae; Sancta Camisia: ein aus orientalischer Baumwolle gefertigtes Gewand der Mutter Gottes, das im Marienschrein des Aachener Domes bewahrt wird. Albrecht Dürer berichtet, dass er 1520 in Aachen &quot;unser Frauen Hemd und Gürtel&quot; gesehen habe. Weitere Stätten der Verehrung sind u. a. Chartres, Sens und Rom (seit 9. Jh.). [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="fr">Chemise de la Vierge</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Chemise of the Virgin</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Marienkleid</skos:prefLabel>
        <skos:prefLabel xml:lang="la">camisia Mariae</skos:prefLabel>
    </owl:NamedIndividual>
    


