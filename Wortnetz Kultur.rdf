	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk009226">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Farn</skos:prefLabel>
		<skos:altLabel xml:lang="de">Farne</skos:altLabel>
		<skos:altLabel xml:lang="de">Farnpflanzen</skos:altLabel>
		<skos:prefLabel xml:lang="en">fern</skos:prefLabel>
		<skos:altLabel xml:lang="en">fern allies</skos:altLabel>
		<skos:altLabel xml:lang="en">ferns</skos:altLabel>
		<skos:altLabel xml:lang="mul">Monilophyta</skos:altLabel>
		<skos:altLabel xml:lang="mul">Pteridophyta</skos:altLabel>
		<skos:prefLabel xml:lang="mul">Pteridophyten</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000855"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000855"/>
		<skos:definition xml:lang="de">Farnpflanzen (Polypodiophyta) sind eine Gruppe von Gefäßsporenpflanzen. Sie besitzen echte Wurzeln, Sprosse und charakteristische, meist gefiederte Blätter (Wedel). Anstelle von Samen vermehren sie sich über Sporen, die in Sporangien gebildet werden, häufig auf der Unterseite der Wedel. Farne gehören zu den ältesten Linien landbewohnender Pflanzen und sind weltweit verbreitet, vor allem in feuchten Lebensräumen.</skos:definition>
		<xe:explanation_temp xml:lang="de">Im Karbon prägten sie als Baumfarne zusammen mit Schachtelhalmen und Bärlappgewächsen ausgedehnte Wälder, die die Grundlage vieler heutiger Steinkohlevorkommen bildeten.</xe:explanation_temp>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4016483-4"/>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300375590"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q80005"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000855"/>
		<xe:subordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk021270"/>
