		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1359" />
		<skos:scopeNote xml:lang="en">A facility where refuse is burnt, sometimes producing heat for power generation.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
