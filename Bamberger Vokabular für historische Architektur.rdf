    <!-- https://hist-arch-vocab.org/bvha#c_6cc4cec2 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_6cc4cec2">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_86c8b719"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_6ee62aa1"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_7715254c"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_860ffcaf"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_d0c849fe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_db732d1e"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_f7b76b93"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_2bfa4b5f"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-07T17:36:29.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T13:33:59.000</terms:modified>
        <skos:altLabel xml:lang="de">Pastorale</skos:altLabel>
        <skos:altLabel xml:lang="de">Pastoralstab</skos:altLabel>
        <skos:altLabel xml:lang="de">Stab</skos:altLabel>
        <skos:altLabel xml:lang="la">cambuta</skos:altLabel>
        <skos:altLabel xml:lang="fr">crosse pastorale</skos:altLabel>
        <skos:altLabel xml:lang="en">crozier</skos:altLabel>
        <skos:altLabel xml:lang="en">pastoral staff</skos:altLabel>
        <skos:altLabel xml:lang="la">pedum</skos:altLabel>
        <skos:altLabel xml:lang="la">virga</skos:altLabel>
        <skos:definition xml:lang="de">Hirtenstab m; Pastoralstab m; auch Pastorale n (lat.); Stab m; Iat. baculus pastoralis; virga; pedum; cambuta etc.: ein langer Stab als Amtsinsigne hoher kirchlicher Würdenträger (Bischöfe, Äbte und Äbtissinnen; seit 5. Jh.). Er bestand zunächst aus Holz, später aus Edelmetall, Elfenbein oder Fischbein (vom Bartenwal) und endigt entweder in einer einfachen Biegung oder volutenförmig (präzis. Krummstab m; lat. baculus ad volutam), manchmal auch mit einem Querholz (Taustab). [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Hirtenstab</skos:prefLabel>
        <skos:prefLabel xml:lang="la">baculus pastoralis</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">bâton pastoral</skos:prefLabel>
        <skos:prefLabel xml:lang="en">crosier</skos:prefLabel>
    </owl:NamedIndividual>
    


