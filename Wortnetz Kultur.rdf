	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021277">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="mul">Porifera</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Schwamm (Tier)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Schwämme (Tiere)</skos:altLabel>
		<skos:altLabel xml:lang="de">Schwammtier</skos:altLabel>
		<skos:altLabel xml:lang="de">Schwammtiere</skos:altLabel>
		<skos:prefLabel xml:lang="en">sponge (animal)</skos:prefLabel>
		<skos:altLabel xml:lang="en">sponges (animals)</skos:altLabel>
		<skos:altLabel xml:lang="de">Spongiae</skos:altLabel>
		<skos:altLabel xml:lang="de">Spongien</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk001769"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk001769"/>
		<skos:definition xml:lang="de">Ein Schwamm ist ein mehrzelliges Tier, das sich durch Filtration ernährt. Ihr Körper besteht aus zwei Zellschichten mit einer gallertartigen Zwischenschicht und ist von zahlreichen Poren durchsetzt. Schwämme besitzen weder Nervengewebe noch Muskelgewebe. Sie sind sessil und häufig in fossilen und rezenten Korallenriffen vertreten.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4053694-4"/>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300265683"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q18960"/>
