    <!-- https://hist-arch-vocab.org/bvha#c_76706966 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_76706966">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
