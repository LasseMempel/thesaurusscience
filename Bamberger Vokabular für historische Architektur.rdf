        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T16:51:53.000</terms:modified>
        <skos:altLabel xml:lang="de">Ziegelwürfelkapitell</skos:altLabel>
        <skos:altLabel xml:lang="cs">cihelná kónusová hlavice</skos:altLabel>
        <skos:altLabel xml:lang="cs">kónusová hlavice</skos:altLabel>
        <skos:altLabel xml:lang="en">trapezoidal capital</skos:altLabel>
        <skos:altLabel xml:lang="cs">trychtýřová hlavice</skos:altLabel>
        <skos:definition xml:lang="de">Kapitell mit trapezförmigen Ansichtsflächen, das hauptsächl. in der byzantin. Baukunst vorkommt. Eine ähnl. Form hat auch das Würfelkapitell im Backsteinbau. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Trapezkapitell im Backsteinbau. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Trapezkapitell</skos:prefLabel>
        <skos:prefLabel xml:lang="es">capitel bizantino</skos:prefLabel>
        <skos:prefLabel xml:lang="it">capitello bizantino</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">chapiteau trapézoidal</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">košova hlavice</skos:prefLabel>
    </owl:NamedIndividual>
    


