    <time:hasBeginning xml:lang="en">-3300</time:hasBeginning>
    <time:hasEnd xml:lang="en">-2900</time:hasEnd>
    <skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/MNE"/>
    <skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/11/concepts/508448"/>
    <skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300019271"/>
    <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_period"/>
    <dc:identifier>http://purl.org/heritagedata/schemes/eh_period/concepts/MNE</dc:identifier>
    <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-17T16:46:30</dc:issued>
    <cc:license rdf:resource="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"/>
    <cc:attributionURL rdf:resource="https://historicengland.org.uk/"/>
    <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
    <dc:publisher rdf:resource="https://historicengland.org.uk/"/>
    <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
    <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
    <skos:prefLabel xml:lang="en">Middle Neolithic</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The second subdivision of the Neolithic, or New Stone Age. Circa -3300 BCE to -2900 BCE.</skos:scopeNote>
    <skos:notation xml:lang="en">MNE</skos:notation>
  </skos:Concept>

  <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_period/concepts/MPA">
    <skos:altLabel xml:lang="en">Middle Paleolithic</skos:altLabel>
    <skos:broader rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/PA"/>
    <time:hasBeginning xml:lang="en">-150000</time:hasBeginning>
    <time:hasEnd xml:lang="en">-40000</time:hasEnd>
    <skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/MPA"/>
    <skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/11/concepts/508443"/>
    <skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300019261"/>
    <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_period"/>
    <dc:identifier>http://purl.org/heritagedata/schemes/eh_period/concepts/MPA</dc:identifier>
    <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-17T16:46:30</dc:issued>
    <cc:license rdf:resource="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"/>
    <cc:attributionURL rdf:resource="https://historicengland.org.uk/"/>
    <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
    <dc:publisher rdf:resource="https://historicengland.org.uk/"/>
    <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
    <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
    <skos:prefLabel xml:lang="en">Middle Palaeolithic</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The second subdivision of the Palaeolithic or Old Stone Age. Characterized by the fine flake tools of the Mousterian tradition and economically by a hunter gatherer society. Circa -150000 BCE to -40000 BCE.</skos:scopeNote>
    <skos:notation xml:lang="en">MPA</skos:notation>
  </skos:Concept>

  <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_period/concepts/NE">
    <skos:altLabel xml:lang="en">New Stone Age</skos:altLabel>
    <skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/ENE"/>
    <skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/LNE"/>
    <skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/MNE"/>
    <skos:broader rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/LPR"/>
    <time:hasBeginning xml:lang="en">-4000</time:hasBeginning>
    <time:hasEnd xml:lang="en">-2200</time:hasEnd>
    <skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/NE"/>
    <skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/11/concepts/505124"/>
    <skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300019267"/>
    <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_period"/>
    <dc:identifier>http://purl.org/heritagedata/schemes/eh_period/concepts/NE</dc:identifier>
    <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-17T16:46:30</dc:issued>
    <cc:license rdf:resource="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"/>
    <cc:attributionURL rdf:resource="https://historicengland.org.uk/"/>
    <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
    <dc:publisher rdf:resource="https://historicengland.org.uk/"/>
    <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
    <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
    <skos:prefLabel xml:lang="en">Neolithic</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The New Stone Age, this period follows on from the Palaeolithic and the Mesolithic and is itself succeeded by the Bronze Age. This period is characterized by the practice of a farming economy and extensive monumental constructions. Circa -4000 BCE to -2200 BCE.</skos:scopeNote>
    <skos:notation xml:lang="en">NE</skos:notation>
  </skos:Concept>

  <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_period/concepts/PA">
    <skos:altLabel xml:lang="en">Old Stone Age</skos:altLabel>
    <skos:altLabel xml:lang="en">Paleolithic</skos:altLabel>
    <skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/LPA"/>
    <skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/MPA"/>
    <skos:narrower>
      <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_period/concepts/UPA">
        <skos:altLabel xml:lang="en">Upper Paleolithic</skos:altLabel>
        <skos:broader rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/PA"/>
        <time:hasBeginning xml:lang="en">-40000</time:hasBeginning>
        <time:hasEnd xml:lang="en">-10000</time:hasEnd>
        <skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/UPA"/>
        <skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/11/concepts/508444"/>
        <skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300019262"/>
        <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_period"/>
        <dc:identifier>http://purl.org/heritagedata/schemes/eh_period/concepts/UPA</dc:identifier>
        <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-17T16:46:30</dc:issued>
        <cc:license rdf:resource="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"/>
        <cc:attributionURL rdf:resource="https://historicengland.org.uk/"/>
        <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
        <dc:publisher rdf:resource="https://historicengland.org.uk/"/>
        <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
        <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
        <skos:prefLabel xml:lang="en">Upper Palaeolithic</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The third and last subdivision of the Palaeolithic or Old Stone Age; characterized by the development of projectile points made from bony materials and the development of fine blade flint tools. Circa -40000 BCE to -10000 BCE.</skos:scopeNote>
        <skos:notation xml:lang="en">UPA</skos:notation>
      </skos:Concept>
    </skos:narrower>

    <skos:broader rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/EPR"/>
    <time:hasBeginning xml:lang="en">-1000000</time:hasBeginning>
    <time:hasEnd xml:lang="en">-10000</time:hasEnd>
    <skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/scapa/concepts/PA"/>
    <skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/11/concepts/505122"/>
    <skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300019258"/>
    <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_period"/>
    <dc:identifier>http://purl.org/heritagedata/schemes/eh_period/concepts/PA</dc:identifier>
    <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-17T16:46:30</dc:issued>
    <cc:license rdf:resource="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"/>
    <cc:attributionURL rdf:resource="https://historicengland.org.uk/"/>
    <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
    <dc:publisher rdf:resource="https://historicengland.org.uk/"/>
    <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
    <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
    <skos:prefLabel xml:lang="en">Palaeolithic</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The period once referred to as the Old Stone Age. It is defined by the practice of hunting and gathering and the use of chipped flint tools. This period is usually divided up into the Lower, Middle and Upper Palaeolithic. Circa -1000000 BCE to -10000 BCE.</skos:scopeNote>
    <skos:notation xml:lang="en">PA</skos:notation>
  </skos:Concept>

  <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_period/concepts/PM">
