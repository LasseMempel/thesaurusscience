<http://www.eionet.europa.eu/gemet/concept/8202> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5978>,
        <http://www.eionet.europa.eu/gemet/concept/8204> ;
    skos:closeMatch <http://data.uba.de/umt/_00022065> ;
    skos:definition "Emissions of the gas given off during the burning of fossil fuels in power stations and other boilers. Sulphur dioxide is created because sulphur is an impurity in most coal and oils. When the fuel is burned the hot sulphur reacts with oxygen in the atmosphere to form sulphur dioxide."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_7515>,
        <http://eurovoc.europa.eu/1878>,
        <http://rdfdata.eionet.europa.eu/eea/determinants/14> ;
