		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/691" />
		<skos:scopeNote xml:lang="en">A factory for the manufacture of leather goods, such as shoes, saddles, etc. Use TANNERY for the manufacture of leather.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
