    <skos:scopeNote xml:lang="en">A mill whose machinery is driven by water.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91506">
