		<skos:altLabel xml:lang="de">Hudebäume</skos:altLabel>
		<skos:prefLabel xml:lang="de">Hutebaum</skos:prefLabel>
		<skos:altLabel xml:lang="de">Hutebäume</skos:altLabel>
		<skos:altLabel xml:lang="de">Weidbaum</skos:altLabel>
		<skos:altLabel xml:lang="de">Weidbäume</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000766"/>
