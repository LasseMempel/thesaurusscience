    skos:prefLabel "Accusative"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/809> ;
    skos:scopeNote "The accusative case of a noun or adjective or participle is the grammatical case used to mark the direct object of a transitive verb. The same case is used in many languages for the objects of (some or all) prepositions. It is a noun that has something done to it, usually used together (such as in Latin) with the nominative case. The syntactic functions of the accusative consist of designating the immediate object of an action, the intended result, the goal of a motion, and the extent of an action."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/723> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/121> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Systematic modulation (Harmonic science)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/296> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/728> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/240> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Dramatische Räume"@de,
        "Dramatic spaces"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/128> ;
    skos:scopeNote "The dramatic space constitutes the fictional space conceived by the playwright, where the play is set, not always identical with the stage space. It comprises spatial information included in the stage directions as well as the spaces of action occurring off scene or in another time, brought on stage by the characters’ narratives."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/73> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/94> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Chisels"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Tools with thin flattened ends of various sizes used to engrave the letters of the inscriptions on the engraving surface."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/736> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Midwives"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2373> ;
    skos:scopeNote "Traditional medical assistants practicing the medical profession of gynecologist in traditional societies. They take care of women during pregnancy and childbirth and of newborn babies. Midwives exist in all traditional societies and cultures."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/738> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/542> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Homodiegetic narrator"@en ;
    skos:scopeNote "Narrative technique in which the narrator is also present as a character in the story."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/746> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/381> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Curse tablets"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Inscriptions engraved on metallic tablets recording curses of a private nature, either for acts of the past or for events the engraver believes will happen in the future."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/749> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/727> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Spondee"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/634> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/757> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/569> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Miracle inscriptions"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Inscriptions recording accounts of patients, who had been treated and wanted to communicate their \"miraculous\" healing by divine intervention. These texts were engraved on a small wooden tablet or a stone stele, depending on the wealth and status of the treated person."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/761> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/584> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Horoi (public inscriptions)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Inscriptions defining and demarcating sites, such as properties of sanctuaries, burial areas, the territory of Greek cities, etc."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/764> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Potters"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/572> ;
    skos:scopeNote "Craftsmen trained in the construction of pottery and other utensils."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/775> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/681> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Adverb"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1026> ;
    skos:scopeNote "An adverb is a word that modifies a verb, adjective, determiner, clause, preposition, or sentence. Adverbs typically express manner, place, time, frequency, degree, level of certainty, etc., answering questions such as why, how, when and where. This function is called the adverbial function, and may be realized by single words (adverbs) or by multi-word expressions."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/777> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/378> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Copperplate engraving"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1484> ;
    skos:scopeNote "Technique for making prints from an etched printing plate, which is a metal plate on which a design is made by coating the plate with an acid-resistant substance, creating a design in the coating, and then exposing the plate to acid, which etches the plate where the metal is exposed."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/783> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/378> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Wood-engraving"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1484> ;
    skos:scopeNote "The oldest Printing technique. The printmaker engraves a wooden plate using sharp tools and creates his work in the form of a bas-relief. Afterwards he lays ink on the plate and he prints it. Only the surfaces that exceed (the embossed ones) are printed, whilst the engraved and the cutout spots of the wooden plate are printed white."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/789> a skos:Concept ;
    skos:altLabel "Basket makers"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Basket weavers"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/489> ;
    skos:scopeNote "Craftsmen involved in the manufacture, repair and / or sale of baskets."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/791> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/569> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Confession inscriptions"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Ιnscriptions describing the sins of individuals, their own punishment or sometimes that of their relatives by the gods - usually by illness, accidents or death - and the ultimate reconciliation with the divine. The engraving of these texts on stele attests to the public perpetual confession of the sin and is therefore a lasting evidence of reconciliation with the divine."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/792> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/669> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Simple clauses"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1024> ;
    skos:scopeNote "Simple clauses are the clauses that contain the absolutely necessary information to declare a meaning in order to transmit a message. The main elements of the clause are the verb, the subject and the object or the predicate."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/794> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/569> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Sacred laws (Religious inscriptions)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Inscriptions related to resolutions of cities defining religious obligations and the moral bearing of the citizen."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/807> a skos:Concept ;
    skos:altLabel "Explanatory apposition"@en,
        "Restrictive apposition"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/374> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Epexegetical apposition"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1193> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/808> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/429> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Mesode"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/445> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/82> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Magic (propositional object)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/275> ;
    skos:scopeNote "The belief that the ceremonial invocation and the subsequent intervention of supernatural entities or powers may alter the course of events in the natural and/or the social environment, according to the expectations of the persons pursuing this intervention.&nbsp;<br />&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/831> a skos:Concept ;
    skos:altLabel "Wood sculptors"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Wood carvers"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/659> ;
    skos:scopeNote "Artisans trained in the art of woodcarving."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/851> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/378> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Lithography"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1484> ;
    skos:scopeNote "Printing technique. The printmaker draws his pattern by use of an oily pencil on a stone or zinc plate. Then he fixes his pattern using a solution of gum and nitric acid and he lets it become oxidized. Lithography is based on the principle that the fat/oil repels water, so when the plate is cleansed using water, only spots that are drawn remain. Afterwards, the printmaker passes throughout the plate the ink which sets only on the spots that are drawn by use of the oily pencil and then the plate is printed. The surface that is printed is therefore smooth, meaning it is not printed. Through the method of Lithography it is created the biggest number of copies in relation to all the other printing methods, due to the fact that the plate is damaged slightly."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/857> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/727> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Dactyl"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/634> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/867> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/530> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Religious weddings"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/882> ;
    skos:scopeNote "Wedding ceremonies performed according to customary religious rituals."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/869> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/712> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Participle"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/748> ;
    skos:scopeNote "A participle is a part of speech derived from a verb that is used in a sentence to modify a noun, noun phrase, verb, or verb phrase, and plays a role similar to an adjective or adverb. It is one of the types of nonfinite verb forms. Usually, the participles \"share\" some of the categories of the adjective or noun (gender, number, case) and some of those of the verb (tense and voice)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/871> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/385> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Zero focalization"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/953> ;
    skos:scopeNote "Narrative way in which the events of the narration are represented by a narrator who knows more than the characters. He may know the facts about all of the protagonists, as well as their thoughts and gestures. This is the the case of the traditional \"omniscient narrator\"."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/882> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/530> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Civil weddings"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/867> ;
    skos:scopeNote "Wedding ceremonies conducted in the presence of ordained state representatives and witnesses."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/890> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/378> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Dry-point printing"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1484> ;
    skos:scopeNote "Printing technique. The printmaker engraves a copper plate using a strongly sharp tool. Then he passes ink throughout the engraved lines and prints his work on a moist paper using a press."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/891> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Furriers"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1944> ;
    skos:scopeNote "Craftsmen skilled in processing and / or selling furs."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/905> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/381> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Signatures of artists (Private inscriptions)"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Inscriptions which the craftsmen carved on objects they constructed. The content of the text usually comprises a phrase by which the craftsman declares who is the creator of the work. The use of the inscription, besides the attribution of the work to the creator, sometimes takes on another meaning, as in the case of the architects (masons), whose signature certified the completion of the works."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/906> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Goldsmiths"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/649> ;
    skos:scopeNote "Craftsmen who manufacture and sometimes sell items or jewelry made of processed gold."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/911> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Waxworkers"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/630> ;
    skos:scopeNote "Craftsmen skilled in the manufacture of candles."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/914> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/702> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Epeisodien"@de,
        "Episodes"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1291> ;
    skos:scopeNote "Episodes in ancient Greek tragedy were distinct dialogical parts between the sung choral interventions. According to Aristotle’s <em>Poetics</em> they were one of the quantitative parts of tragedy developed between the Prologue and the Exodus."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/921> a skos:Concept ;
    skos:altLabel "Democratic government"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/700> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Democracy"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/937> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/475> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Terrorism"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2217> ;
    skos:scopeNote "Planning and executing attacks against humans and infrastructures of strategic or symbolic importance. Terrorist attacks, which are undertaken by individuals or conspiratorial organizations, aim at the aggressive propagandization of ethnic, sociopolitical and religious views and ideologies, at the creation of a climate of insecurity among the population, and at compromising the effectivity of state authorities.<br />"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/939> a skos:Concept ;
    skos:altLabel "Non restrictive apposition"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/374> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Simple apposition"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1345> .

