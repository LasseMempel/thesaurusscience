		<skos:prefLabel xml:lang="gd">LÀRACH BLÀIR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite far an robh blàr no streup ann am beachd nan eòlaichean.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BATTLE SITE</skos:prefLabel>
