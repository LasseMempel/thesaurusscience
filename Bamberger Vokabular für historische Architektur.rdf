        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T18:51:58.000</terms:modified>
        <skos:definition xml:lang="de">Längsverbindungen (Stöße) fügen zwei Hölzer in gleicher Richtung kraftschlüssig aneinander. Abhängig von der Lage im Gefüge müssen diese Verbindungen Druck-, Zug- oder Biegekräfte aufnehmen können und gegen seitliches Ausweichen oder Abscheren gesichert sein.  (Eißing et al. 2012)</skos:definition>
        <skos:prefLabel xml:lang="de">Längsverbindung (Stoß)</skos:prefLabel>
        <broaderByPosition rdf:resource="https://hist-arch-vocab.org/bvha#c_88b4f652"/>
    </owl:NamedIndividual>
    


