		<skos:prefLabel xml:lang="gd">MUILEANN STAMPAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach no structar sa bheil inneal air choireigin a sginneas clach-mheatailte agus a tha co-cheangailte ri mèinnean tiona.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">STAMPING MILL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
