    skos:related <http://lvr.vocnet.org/wnk/wk004049> .

<http://lvr.vocnet.org/wnk/wk004049> a skos:Concept ;
    skos:broader <http://lvr.vocnet.org/wnk/wk001136> ;
    skos:definition "Ein Jagdlager ist ein Lager, auf dem sich zeitweise Jägergruppen aufhalten und der sich bei Funden durch ein spezifisches, relativ schmales Gerätespektrum auszeichnet."@de ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Jagdlager"@de,
        "hunting camp"@en ;
    skos:related <http://lvr.vocnet.org/wnk/wk004048> .

