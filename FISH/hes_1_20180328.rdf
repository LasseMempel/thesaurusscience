				<skos:prefLabel xml:lang="gd">FRITH-MHÈINN</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Tunail a chaidh a chladhach mar fhreagairt air tunail eile a bha nàmhaid a' cladhach.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">COUNTERMINE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-17T08:41:24</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-07-12T12:49:54</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/278" />
				<skos:scopeNote xml:lang="en">A tunnel dug in response to tunnelling by an attacking force.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
