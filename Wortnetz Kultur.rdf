		<skos:prefLabel xml:lang="de">Anhänger (Schmuck)</skos:prefLabel>
		<skos:prefLabel xml:lang="en">pendant (jewelry)</skos:prefLabel>
		<skos:altLabel xml:lang="en">pendants (jewelries)</skos:altLabel>
