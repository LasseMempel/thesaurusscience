        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-16T09:14:43.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-29T19:46:59.000</terms:modified>
        <skos:definition xml:lang="de">Rundbogen über geschweiften Kämpfersteinen. Durch den Übergang der Bogenlinie in die Begrenzung der Kämpfersteine entsteht die glockenartige Form. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Glockenbogen</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">arc en cloche</skos:prefLabel>
        <skos:prefLabel xml:lang="en">bell arch</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">zvonový oblouk</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_eea5235b"/>
    </owl:NamedIndividual>
    


