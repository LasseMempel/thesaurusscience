	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk000189">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">Bilau sails</skos:prefLabel>
		<skos:altLabel xml:lang="de">Bilausche Ventikanten</skos:altLabel>
		<skos:prefLabel xml:lang="de">Bilausche Ventikantenflügel</skos:prefLabel>
		<skos:altLabel xml:lang="de">Bilausches Flügelsystem</skos:altLabel>
		<skos:altLabel xml:lang="de">Ventikantenflügel</skos:altLabel>
		<skos:altLabel xml:lang="de">Ventikantenflügel des Systems Bilau</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk000170"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk004544"/>
