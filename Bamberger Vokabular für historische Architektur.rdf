    <!-- https://hist-arch-vocab.org/bvha#c_50c7bdfe -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_50c7bdfe">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_c72b7354"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-25T10:17:44.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T15:55:15.000</terms:modified>
        <skos:definition xml:lang="de">Als Putzträger für Holz- und Eisenteile, die mit Strohlehm beworfen und mit einem verzinkten Drahtgeflecht so überspannt werden, dass auch die Fugen überdeckt sind. Urspr. aus dünnen, schmalen oder breiteren, auf Grat kannelierten Latten (Pliesterlatten)  bestehend und anstelle von Rohr beim Deckenputz verwandt. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Pliestergeflecht</skos:prefLabel>
    </owl:NamedIndividual>
    


