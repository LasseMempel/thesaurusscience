		<skos:prefLabel xml:lang="gd">TUINEACHADH CUAIRTICHTE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach air an aithnichear tuineachadh mac an duine agus mun robh uchdan agus dìg, sonnach no rud mar sin.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ENCLOSED SETTLEMENT</skos:prefLabel>
