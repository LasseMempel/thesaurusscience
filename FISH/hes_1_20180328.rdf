		<skos:prefLabel xml:lang="gd">DROCHAID CANÀIL</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Drochaid thairis air canal.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CANAL BRIDGE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-26T14:52:00</dcterms:created>
