		<skos:prefLabel xml:lang="de">Pension (Beherbergungsbetrieb)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Pensionen (Beherbergungsbetrieb)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk001104"/>
