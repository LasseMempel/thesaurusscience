        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T19:15:13.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T19:37:33.000</terms:modified>
        <skos:altLabel xml:lang="fr">cloison</skos:altLabel>
        <skos:altLabel xml:lang="es">muro</skos:altLabel>
        <skos:altLabel xml:lang="en">wall</skos:altLabel>
        <skos:definition xml:lang="de">Wand, urspr. Bezeichnung für ein Flechtwerk aus Ruten, d.h. für die lehmverschmierten Flechtwerkwände; heute Raumabschluss oder Raumtrennung aus Holz, Fachwerk oder Glas im Gegensatz zur massiven Mauer, im allg. Sprachgebrauch wird aber häufig jeder Raumabschluss als W. bezeichnet, zumindest die Innen-Ansichtsfläche. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Wand</skos:prefLabel>
        <skos:prefLabel xml:lang="es">pared</skos:prefLabel>
        <skos:prefLabel xml:lang="it">parete</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">paroi</skos:prefLabel>
        <skos:prefLabel xml:lang="en">partition</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">stěna</skos:prefLabel>
    </owl:NamedIndividual>
    


