  <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_period/concepts/GPHA">
    <skos:broader rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/geology"/>
    <skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/GCEN"/>
    <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_period"/>
    <dc:identifier>http://purl.org/heritagedata/schemes/eh_period/concepts/GPHA</dc:identifier>
    <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-17T16:46:30</dc:issued>
    <cc:license rdf:resource="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"/>
    <cc:attributionURL rdf:resource="https://historicengland.org.uk/"/>
    <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
    <dc:publisher rdf:resource="https://historicengland.org.uk/"/>
    <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
    <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
    <skos:prefLabel xml:lang="en">Phanerozoic</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The Phanerozoic is the current eon in the geologic time scale. It extends from approximately 542 million years ago until the present and is marked by the rapid expansion and evolution of life forms allowed by the development of plants carrying out photosynthesis, thus releasing oxygen into the atmosphere. It contains the Paleozoic, Mesozoic, and Cenozoic eras.</skos:scopeNote>
    <skos:notation xml:lang="en">GPHA</skos:notation>
  </skos:Concept>

  <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_period/concepts/geology">
    <skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/GPHA"/>
    <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_period"/>
    <dc:identifier>http://purl.org/heritagedata/schemes/eh_period/concepts/geology</dc:identifier>
    <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-17T16:46:30</dc:issued>
    <cc:license rdf:resource="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"/>
    <cc:attributionURL rdf:resource="https://historicengland.org.uk/"/>
    <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
    <dc:publisher rdf:resource="https://historicengland.org.uk/"/>
    <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
    <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
    <skos:prefLabel xml:lang="en">Geological Time Scale</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An internationally recognized time scale of Earth's history since the planet's formative period subdivided into eons, eras, periods, and epochs.</skos:scopeNote>
    <skos:notation xml:lang="en">geology</skos:notation>
    <skos:topConceptOf rdf:resource="http://purl.org/heritagedata/schemes/eh_period"/>
  </skos:Concept>

  <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_period/concepts/GCEN">
    <skos:broader rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/GPHA"/>
    <skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/QUA"/>
    <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_period"/>
    <dc:identifier>http://purl.org/heritagedata/schemes/eh_period/concepts/GCEN</dc:identifier>
    <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-17T16:46:30</dc:issued>
    <cc:license rdf:resource="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"/>
    <cc:attributionURL rdf:resource="https://historicengland.org.uk/"/>
    <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
    <dc:publisher rdf:resource="https://historicengland.org.uk/"/>
    <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
    <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
    <skos:prefLabel xml:lang="en">Cenozoic</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The youngest era of the Phanerozoic. It follows the Mesozoic, extending from about 65 million years ago to the present. During the Cenozoic, flora and fauna evolved toward their present state and the continents assumed their modern configuration. The Cenozoic comprises two periods: the Tertiary (with its five epochs) and the Quaternary.</skos:scopeNote>
    <skos:notation xml:lang="en">GCEN</skos:notation>
  </skos:Concept>

  <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_period/concepts/QUA">
    <skos:broader rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/GCEN"/>
    <skos:narrower>
      <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_period/concepts/QPLE">
        <skos:broader rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/QUA"/>
        <time:hasBeginning xml:lang="en">-2500000</time:hasBeginning>
        <time:hasEnd xml:lang="en">-11700</time:hasEnd>
        <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_period"/>
        <dc:identifier>http://purl.org/heritagedata/schemes/eh_period/concepts/QPLE</dc:identifier>
        <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-17T16:46:30</dc:issued>
        <cc:license rdf:resource="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"/>
        <cc:attributionURL rdf:resource="https://historicengland.org.uk/"/>
        <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
        <dc:publisher rdf:resource="https://historicengland.org.uk/"/>
        <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
        <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
        <skos:prefLabel xml:lang="en">Pleistocene</skos:prefLabel>
        <skos:scopeNote xml:lang="en">On the geologic time scale the earlier and longer epoch of the Quaternary. The Pleistocene extends from about 1.8 million years ago to 10,000 BCE. It is best known as the time when Earth entered its most recent period of glaciation.</skos:scopeNote>
        <skos:notation xml:lang="en">QPLE</skos:notation>
      </skos:Concept>
    </skos:narrower>

    <skos:narrower>
      <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_period/concepts/QHOL">
        <skos:broader rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/QUA"/>
        <time:hasBeginning xml:lang="en">-11700</time:hasBeginning>
        <time:hasEnd xml:lang="en">2100</time:hasEnd>
        <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_period"/>
        <dc:identifier>http://purl.org/heritagedata/schemes/eh_period/concepts/QHOL</dc:identifier>
        <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-17T16:46:30</dc:issued>
        <cc:license rdf:resource="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"/>
        <cc:attributionURL rdf:resource="https://historicengland.org.uk/"/>
        <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
        <dc:publisher rdf:resource="https://historicengland.org.uk/"/>
        <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
        <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
        <skos:prefLabel xml:lang="en">Holocene</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The second epoch of the Quaternary and the most recent geologic interval of time. It extends from about 10,000 BCE to the present. It coincides with the late and post-Stone Age history of the human species.</skos:scopeNote>
        <skos:notation xml:lang="en">QHOL</skos:notation>
      </skos:Concept>
    </skos:narrower>

    <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_period"/>
    <dc:identifier>http://purl.org/heritagedata/schemes/eh_period/concepts/QUA</dc:identifier>
    <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-17T16:46:30</dc:issued>
    <cc:license rdf:resource="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"/>
    <cc:attributionURL rdf:resource="https://historicengland.org.uk/"/>
    <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
    <dc:publisher rdf:resource="https://historicengland.org.uk/"/>
    <dc:spatial rdf:resource="http://vocab.getty.edu/tgn/7002445"/>
    <dc:spatial rdf:resource="http://dbpedia.org/resource/England"/>
    <skos:prefLabel xml:lang="en">Quaternary</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The Quaternary is the second major division of geologic time in the Cenozoic era, following the Tertiary period. It extends from about 1.8 million years ago to the present. It is divided into Pleistocene and Holocene epochs.</skos:scopeNote>
    <skos:notation xml:lang="en">QUA</skos:notation>
  </skos:Concept>

  <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_period/concepts/BA">
    <skos:broader rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/LPR"/>
    <skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/eh_period/concepts/EBA"/>
