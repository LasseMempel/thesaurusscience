        <skos:altLabel xml:lang="de">Peristylium</skos:altLabel>
        <skos:altLabel xml:lang="cs">peristyl</skos:altLabel>
        <skos:definition xml:lang="de">Die einen Hof umgebende Säulenhalle. Das P. kann den Hof eines Wohnhauses, aber auch einen Tempelhof (Peribolos)  oder den Vorhof (Atrium) einer altchristl. Basilika rahmen. [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Peristylium, Peristylion, auch: Cavaedium; 1. Säulenhalle, die den Hof eines Wohnhauses oder eines Tempels umgibt; 2. das Atrium der frühchristlichen und ma\&apos;lichen Basilika. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="es"> peristilo</skos:prefLabel>
        <skos:prefLabel xml:lang="en"> peristyle</skos:prefLabel>
        <skos:prefLabel xml:lang="fr"> péristyle</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Peristyl</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">cavaedium</skos:prefLabel>
        <skos:prefLabel xml:lang="it">peristilio</skos:prefLabel>
    </owl:NamedIndividual>
    


