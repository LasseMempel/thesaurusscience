        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c7b144d0"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-23T08:30:19.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T14:10:47.000</terms:modified>
        <skos:altLabel xml:lang="de">Kneiffalz</skos:altLabel>
        <skos:altLabel xml:lang="de">Quetschfalz</skos:altLabel>
        <skos:definition xml:lang="de">Profilierung im Einschlagfalz der Höhenschenkel des Flügels und des Fensterrahmens nur an der Seite, wo der Flügel an den Fensterrahmen gehangen ist. Da der Flügel an dieser Seite nicht in den Fensterrahmen einschlägt, sondern hineingedreht wird, kann er hier anders profiliert sein. Schon seit dem ausgehenden 17. Jh. werden bei aufwendigeren Fenstern die beiden Teile so geformt. [Noky 1996]</skos:definition>
        <skos:prefLabel xml:lang="de">Klemmfalz</skos:prefLabel>
    </owl:NamedIndividual>
    


