						<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/2" />
						<dcterms:identifier>http://purl.org/heritagedata/schemes/2/concepts/501208</dcterms:identifier>
						<skos:prefLabel xml:lang="en">CALTROP</skos:prefLabel>
						<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-07-17T15:14:56</dcterms:modified>
						<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:56:41</dcterms:issued>
						<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/2/concepts/501138" />
						<skos:scopeNote xml:lang="en">Four iron spikes joined together so that when the caltrop is on the ground a spike is always pointing upwards. Used to disable infantry and cavalry.</skos:scopeNote>
						<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
						<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
