    <!-- https://hist-arch-vocab.org/bvha#c_2bfb2115 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_2bfb2115">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a36fd146"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-28T11:33:42.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T23:47:02.000</terms:modified>
        <skos:definition xml:lang="de">Börse, Handelshalle, Gebäude, in dem sich Kaufleute regelmäßig zusammenfinden, um miteinander oder durch Vermittlung von Maklern Handelsgeschäfte in Waren oder Wertpapieren abzuschließen. Schon in der Antike als Marktbasilika am Forum, im 13. Jh. bes. in Flandern und Holland in großem Stil entwickelt und dann über Europa verbreitet, unterschiedl. Bauformen: Gebäude um einen Hof, große, palastähnl. Bauten, bes. im 19. Jh. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Börse</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">tržiště</skos:prefLabel>
    </owl:NamedIndividual>
    


