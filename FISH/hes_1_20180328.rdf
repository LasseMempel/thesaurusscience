		<skos:prefLabel xml:lang="gd">MUILEANN-SÀBHAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Factaraidh far a bheilear a' dèanamh fiodh de logaichean le bhith gan cur tro shreath de shàbhan.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SAW MILL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
