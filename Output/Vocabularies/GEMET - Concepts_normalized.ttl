<http://www.eionet.europa.eu/gemet/concept/2671> a skos:Concept ;
    skos:broadMatch <http://eurovoc.europa.eu/5782> ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/716> ;
    skos:definition "A system for recording qualified air emission reductions for later use in bubble, offset, or netting transactions. Plant complexes that reduce emissions substantially may \"bank\" their \"credits\" or sell them to other industries."@en ;
