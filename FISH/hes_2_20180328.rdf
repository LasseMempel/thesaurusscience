						<dcterms:identifier>http://purl.org/heritagedata/schemes/2/concepts/501547</dcterms:identifier>
						<skos:prefLabel xml:lang="en">STIRRUP</skos:prefLabel>
						<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:56:41</dcterms:issued>
						<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/2/concepts/501122" />
						<skos:scopeNote xml:lang="en">A device in the form of a loop with a flat base hung on either side of a saddle to support the rider's foot.</skos:scopeNote>
						<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
						<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
						<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
						<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
					</skos:Concept>
				</skos:narrower>
				<skos:scopeNote xml:lang="en">This is the top term for the class covering objects associated with the care and use of animals. See ANIMAL EQUIPMENT Class List for narrow terms.</skos:scopeNote>
