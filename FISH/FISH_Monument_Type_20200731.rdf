  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140128">
    <skos:scopeNote xml:lang="en">A large type of military repair hangar mainly used on WWII bomber bases, constructed using steel stanchions and clad in corrugated iron. B 1 hangars were part of a series of prefabricated buildings intended to supplement existing hangars on bases.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70083">
