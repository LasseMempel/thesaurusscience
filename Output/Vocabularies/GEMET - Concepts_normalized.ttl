        "product life cycle"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Product_life_cycle_management_%28marketing%29> .

<http://www.eionet.europa.eu/gemet/concept/10939> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7784> ;
    skos:closeMatch <http://data.uba.de/umt/_00015954> ;
    skos:definition "A measurement of the development level in a country or community, gauged by factors such as personal income, education, life expectancy, food consumption, health care, technology and the use of natural resources."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_4400>,
        <http://eurovoc.europa.eu/2062> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Lebensstandard"@de,
        "living standard"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Standard_of_living> .

<http://www.eionet.europa.eu/gemet/concept/1094> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6724> ;
    skos:closeMatch <http://data.uba.de/umt/_00017938>,
        <http://dbpedia.org/resource/By-product> ;
    skos:definition "A product from a manufacturing process that is not considered the principal material."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/4224> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Nebenprodukt"@de,
        "by-product"@en .

<http://www.eionet.europa.eu/gemet/concept/10959> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7784> ;
    skos:definition "Any imbalance or disparity among inhabitants of the same living environment deemed inappropriate, unjust or detrimental to that environment's integrity."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Ökologische Ungleichheit"@de,
        "ecological inequality"@en .

<http://www.eionet.europa.eu/gemet/concept/10960> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7791> ;
    skos:closeMatch <http://dbpedia.org/resource/Social_inequality> ;
    skos:definition "Unequal rewards or opportunities for different individuals within a group or groups within a society. If equality is judged in terms of legal equality, equality of opportunity, or equality of outcome, then inequality is a constant feature of the human condition."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/1420> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Soziale Ungleichheit"@de,
        "social inequality"@en .

<http://www.eionet.europa.eu/gemet/concept/10964> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8579> ;
    skos:definition "A traditional or legendary story, usually dealing with supernatural beings, ancestors, heroes or events, that is with or without determinable basis of fact or a natural explanation, but is used to explain some practice, rite or phenomenon of nature, or to justify the existence of a social institution."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Mythos"@de,
        "myth"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Mythology> .

<http://www.eionet.europa.eu/gemet/concept/10968> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3788> ;
    skos:definition "Not In My BackYard: phrase used to describe people who encourage the development of agriculture land for building houses or factories, provided it is not near where they themselves are living."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Floriansprinzip"@de,
        "NIMBY aptitude"@en ;
    skos:scopeNote "aptitude \"not in my back yard\""@en .

<http://www.eionet.europa.eu/gemet/concept/10972> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7817> ;
    skos:definition "A system of values, ideas and practices established to orient individuals in their community and culture and to provide them with naming, classification and communication codes."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Soziale Vertretbarkeit"@de,
        "social representation"@en .

<http://www.eionet.europa.eu/gemet/concept/10976> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2778> ;
    skos:definition "A consciousness, sensibility or sympathetic perception of the physical world and its scenery in their uncultivated state."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Naturgefühl"@de,
        "feeling for nature"@en .

