        <skos:prefLabel xml:lang="fr">sous-diacre</skos:prefLabel>
        <skos:prefLabel xml:lang="en">subdeacon</skos:prefLabel>
        <skos:prefLabel xml:lang="la">subdiaconus</skos:prefLabel>
    </owl:NamedIndividual>
    


