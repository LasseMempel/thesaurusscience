        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_d944cc16"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_b41bd73a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c7b144d0"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-13T15:50:12.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-18T14:16:40.000</terms:modified>
        <skos:altLabel xml:lang="de">Randblei</skos:altLabel>
        <skos:altLabel xml:lang="de">Umschlagblei</skos:altLabel>
        <skos:definition xml:lang="de">U-förmige Bleistreifen, die ein Glasfeld, das mit Bleiruten oder Bleisprossen zusammengefügt ist, einfassen. Das Umblei ist nach dem Einbau des Glasfeldes in den Fensterflügel oder Fensterrahmen nicht sichtbar, weil es vollständig in der Glasnut verschwindet. [Noky 1996]</skos:definition>
        <skos:prefLabel xml:lang="de">Umblei</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_0791914a -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_0791914a">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_2pqtnskw"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-07T11:45:51.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T16:35:06.000</terms:modified>
        <skos:altLabel xml:lang="de">Blendstein</skos:altLabel>
        <skos:altLabel xml:lang="fr">brique de parement</skos:altLabel>
        <skos:altLabel xml:lang="en">facing tile</skos:altLabel>
        <skos:altLabel xml:lang="it">listello da paramento</skos:altLabel>
        <skos:altLabel xml:lang="cs">lícovka</skos:altLabel>
        <skos:altLabel xml:lang="it">mattone da rivestimento</skos:altLabel>
        <skos:definition xml:lang="de">Ein Stein aus besserem Material, der zum Verkleiden (Verblenden) einer Mauer (Mauerwerk) aus einfacherem Material dient. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Jeder als Mauerbekleidung dienende Stein. In der Regel ist er aus besserem Material als der Mauerkern. [Glossarium Artis, Bd. 3, Bögen und Mauerwerk]</skos:definition>
        <skos:prefLabel xml:lang="de">Verblender</skos:prefLabel>
        <skos:prefLabel xml:lang="en">facing brick</skos:prefLabel>
        <skos:prefLabel xml:lang="es">ladrillo de paramento</skos:prefLabel>
        <skos:prefLabel xml:lang="it">listello da rivestimento</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">lícová cihla</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">pierre de revêtement</skos:prefLabel>
    </owl:NamedIndividual>
    


