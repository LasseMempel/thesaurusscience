	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1104">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1104</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">MÈINN BARAIT</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far a bheilear a' dùsgadh barytes (barium sulfate).</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BARYTES MINE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-10-01T07:20:28</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1103" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1170" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1038" />
		<skos:scopeNote xml:lang="en">A site where barytes (barium sulphate) is mined.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
