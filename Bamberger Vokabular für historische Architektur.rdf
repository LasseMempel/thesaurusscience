        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_0158e03d"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_0662bfd8"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_11f6afbb"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_3f268134"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_495694db"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_52621f78"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_5808dd49"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_5a75b100"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_764dc0cf"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_7ca43ff0"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_89e20398"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_8ecd3753"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_aa8a813d"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_b0625d27"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_e45ea27d"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_049c4c22"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-04-29T23:06:51.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T13:29:18.000</terms:modified>
        <skos:altLabel xml:lang="de">Gewölberippe</skos:altLabel>
        <skos:altLabel xml:lang="fr">Ogive</skos:altLabel>
        <skos:altLabel xml:lang="es">cuaderna</skos:altLabel>
        <skos:altLabel xml:lang="fr">côte</skos:altLabel>
        <skos:altLabel xml:lang="it">nervatura</skos:altLabel>
        <skos:altLabel xml:lang="en">nerve</skos:altLabel>
        <skos:altLabel xml:lang="cs">žebro</skos:altLabel>
        <skos:definition xml:lang="de">Ogive, stabartiges, unterschiedlich profiliertes Konstruktionselement des Skelettbaus, z.B. zur Verstärkung von Flachdecken oder Gewölben; auch nichttragend (Spätgotik). [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Prutovitý, různě profilovaný konstrukční prvek skeletové stavby, např. k zesílení plochých stropů, nebo kleneb, může být také nenosné (pozdní gotika). [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">frz.  Ogive, verstärkender, rippenartiger Konstruktionsteil einer Stahlbetondecke (R.ndecke) oder eines Gewölbes (R.ngewölbe). Die R.n sind nicht immer sichtbar, sondern können in der Gewölbeschale oder auch am Gewölberücken (Obergurt) liegen. Das R.ngefüge ist ein Skelett mit nichttragenden Füllungen (Wangen, Kappen u. dergl.). In der Spätzeit der Gotik sind R.n oft nur dekorativ unter eine tragende Gewölbeschale gesetzt. In der Endphase können sich die R.n auch ganz von der Gewölbeschale loslösen und frei hängen (Zweischichtengewölbe). Je nach der Lage der R.n unterscheidet man entsprechend den dazugehörigen Bogen (Gewölbeformen) Wandr.n oder Schildr.n, Querr.n oder Gurtr.n, Gratr.n, Diagonalr.n oder Kreuzr.n, Kehlr.n und Scheitelr.n. Die frühesten R.n hatten rechteckigen Querschnitt (Bandr.), doch kommen auch Rundstäbe, teilweise Ringstäbe oder Bündelungen mit Hohlkehlen, Birnstäbe sowie Verbindungen und Varianten dieser Formen vor. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Rippe</skos:prefLabel>
        <skos:prefLabel xml:lang="it">costola</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">klenební žebro</skos:prefLabel>
        <skos:prefLabel xml:lang="es">nervio</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">nervure</skos:prefLabel>
        <skos:prefLabel xml:lang="en">rib</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_b1fae3f8 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b1fae3f8">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_e58fbb73"/>
