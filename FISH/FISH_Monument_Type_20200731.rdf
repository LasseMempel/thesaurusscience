    <cc:attributionURL rdf:resource="http://www.historicengland.org.uk"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-17T14:18:29</dcterms:issued>
    <dcterms:identifier>http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70131</dcterms:identifier>
    <dcterms:publisher rdf:resource="http://www.historicengland.org.uk"/>
    <skos:prefLabel xml:lang="en">Premonstratensian Cell</skos:prefLabel>
  </skos:Concept>
  <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142076">
    <cc:license rdf:resource="http://creativecommons.org/licenses/by/3.0"/>
    <cc:attributionURL rdf:resource="http://www.historicengland.org.uk"/>
    <skos:prefLabel xml:lang="en">Ferry Crossing Shelter</skos:prefLabel>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-17T14:18:30</dcterms:issued>
    <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
    <skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2"/>
    <dcterms:identifier>http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142076</dcterms:identifier>
    <dcterms:publisher rdf:resource="http://www.historicengland.org.uk"/>
  </skos:Concept>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160219">
    <skos:scopeNote xml:lang="en">An observation post used by Air Raid Precautions wardens to watch for aircraft and bomb strikes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140225">
    <skos:scopeNote xml:lang="en">A steel framed transportable hangar similar in construction to Type T2 but about half the size. Designed in 1941 and 1942.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92561">
    <skos:scopeNote xml:lang="en">A building, often close to a churchyard, used for the entertainment of poor people on their wedding day.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91620">
    <skos:scopeNote xml:lang="en">A processing house or room in a brewery.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92815">
    <skos:scopeNote xml:lang="en">A storage area usually for naval weapons and stores.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/151880">
    <skos:scopeNote xml:lang="en">A well with an unusually high mineral content that combined with extensive periods of evaporation may give objects a stony exterior. Once believed to have been caused by magic or witchcraft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70430">
    <skos:scopeNote xml:lang="en">An uncovered area, surrounded or partially surrounded by buildings.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92697">
    <skos:scopeNote xml:lang="en">A building where motor cycles are assembled.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91398">
    <skos:scopeNote xml:lang="en">Pens for housing cattle awaiting transportation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92110">
    <skos:scopeNote xml:lang="en">A small building used by a gatekeeper.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92381">
    <skos:scopeNote xml:lang="en">A hostel for packhorse teamsters.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92156">
    <skos:scopeNote xml:lang="en">A heavy framework of parallel beams used to support a ship in dock.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/122511">
    <skos:scopeNote xml:lang="en">A bridge on which dwellings or commercial premises have been built.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140432">
    <skos:scopeNote xml:lang="en">A prepared area used for the game of baseball.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167611">
    <skos:scopeNote xml:lang="en">A gate or mechanism designed to allow animals which are being raced to start at the same time.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93949">
    <skos:scopeNote xml:lang="en">A garden or collection of potted plants on the flat roof of a house or other building.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71548">
    <skos:scopeNote xml:lang="en">A place used for the milking of cows.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71641">
    <skos:scopeNote xml:lang="en">The residence of a keeper of a royal park etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159234">
    <skos:scopeNote xml:lang="en">A factory manufacturing timepieces, including clocks and watches.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68662">
    <skos:scopeNote xml:lang="en">A place where sheep are washed in a chemical bath to control  the parasites of sheep. To conserve the poisonous chemicals the bath is usually small and are not allowed to enter any watercourse.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92336">
    <skos:scopeNote xml:lang="en">A shallow pond, often located near an ICEHOUSE, built to provide ice during the winter.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70131">
    <skos:scopeNote xml:lang="en">A residence of two or three monks of the Premonstratensian order dependent on an English mother house.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93618">
    <skos:scopeNote xml:lang="en">Buildings, sites and structures associated with tramway transport.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70440">
    <skos:scopeNote xml:lang="en">A barrier of concrete or earth, etc, built across a river to create a reservoir of water for domestic and/or industrial usage.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68989">
    <skos:scopeNote xml:lang="en">A community of Protestant followers of Hussite doctrines, first founded by Moravian emigrants in Saxony, Germany.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91778">
    <skos:scopeNote xml:lang="en">A house consisting of a single storey open hall with a two storey domestic range attached to both ends forming an H shape.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159297">
    <skos:scopeNote xml:lang="en">A concrete arched military hut constructed by pouring concrete over hessian cloth that had been stretched over a temporary steel framework. Semi circular in section usually with end walls of brick. Designed by the Waller Housing Corp in 1943.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69292">
    <skos:scopeNote xml:lang="en">A spoil heap consisting mainly of slag, pieces of refuse material separated from a metal during the smelting process.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/102682">
    <skos:scopeNote xml:lang="en">A reinforced concrete structure, usually sited underground, from where it was intended to conduct the business of government in the event of nuclear war. Date specific late 1950's to early 1970's.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71722">
    <skos:scopeNote xml:lang="en">A market building, pre-19th century, incorporating other function rooms, eg. theatres, courtrooms, schoolrooms.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159204">
    <skos:scopeNote xml:lang="en">A watchtower used to guard prisons, camps or other facilities.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78800">
    <skos:scopeNote xml:lang="en">A structure housing machinery for crushing coal. Usually found at the pithead of a colliery or coal mine.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69347">
    <skos:scopeNote xml:lang="en">A building found at the site of a mine. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92863">
    <skos:scopeNote xml:lang="en">A place of worship for Particular Baptists, a Calvinistic Baptist denomination who believe in predestination.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93528">
    <skos:scopeNote xml:lang="en">A building with a regulated moderate temperature for the cultivation of plants.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68606">
    <skos:scopeNote xml:lang="en">A component of another building, often a house, used for storing nets.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91523">
    <skos:scopeNote xml:lang="en">A group of four houses in quadruplex form within a single block, of approximately square plan and set in a spacious garden. Such houses were usually provided for supervisory or skilled workers within a textile factory.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68973">
    <skos:scopeNote xml:lang="en">A wide ditch surrounding a building, usually filled with water. Use for moated sites, not defensive moats. Use with relevant site type where known, eg. MANOR HOUSE, GARDEN, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69229">
    <skos:scopeNote xml:lang="en">A workshop or factory where bells are made by casting molten metal into moulds.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70166">
    <skos:scopeNote xml:lang="en">An abbey or priory of Augustinian canonesses.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160321">
    <skos:scopeNote xml:lang="en">A road block formed by placing rails or girders in an upright position in sockets in the road surface, forming a moveable barrier.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142994">
    <skos:scopeNote xml:lang="en">A concrete marker placed to indicate the direction of a target on a bombing range to aircraft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162563">
    <skos:scopeNote xml:lang="en">A designated area within a town or village with fixed defences such as pillboxes, anti tank ditches and gun emplacements, designed to threaten the flanks of an enemy force which had broken through a stop line.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92393">
    <skos:scopeNote xml:lang="en">A place where jockeys are accomodated.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68964">
    <skos:scopeNote xml:lang="en">A round house indicated by the presence of a low, roughly circular bank of turf, earth or stone, which formed the base of the walls. Characteristic of the later prehistoric period. Where several occur together use HUT CIRCLE SETTLEMENT.</skos:scopeNote>
  </rdf:Description>
  <skos:ConceptScheme rdf:about="http://purl.org/heritagedata/schemes/1">
    <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
    <dcterms:publisher rdf:resource="http://www.historicengland.org.uk"/>
    <cc:license rdf:resource="http://creativecommons.org/licenses/by/3.0"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-08-17</dcterms:issued>
    <dcterms:identifier>http://purl.org/heritagedata/schemes/1</dcterms:identifier>
    <cc:attributionURL rdf:resource="http://www.historicengland.org.uk"/>
  </skos:ConceptScheme>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93085">
    <skos:scopeNote xml:lang="en">A raised floor along the side of a line at a railway station, for convenience in entering and alighting from a train.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91918">
    <skos:scopeNote xml:lang="en">A rustic building of picturesque design, often associated with a model farm, country house or estate. Although ornamental in design they are intended to be functional.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68676">
    <skos:scopeNote xml:lang="en">A hall in which public assemblies and meetings can be held.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162641">
    <skos:scopeNote xml:lang="en">A site intended for use by the Auxiliary Units (or British Resistance Organisation) in the event of an invasion. Use more specific term.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/84902">
    <skos:scopeNote xml:lang="en">A large bed surrounded by an earthwork and filled with composing vegetable matter and animal waste. This was used to produce Nitre, a constituent of gunpowder.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68862">
    <skos:scopeNote xml:lang="en">A multiple, parallel arrangement of linear earthwork ditches, usually accompanied by banks, and often of considerable territorial extent. Usually of later prehistoric or Roman date.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68726">
    <skos:scopeNote xml:lang="en">A pond used for the punishment, by ducking in water, of offenders.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/102972">
    <skos:scopeNote xml:lang="en">An obstruction, usually manmade, which is used to restrict or prevent access to a settlement, building or area of land. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/104015">
    <skos:scopeNote xml:lang="en">An air raid shelter, designed to be placed in the garden. Made from prefabricated components, they were often semi-sunken and the structure then covered with soil for added protection.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93738">
    <skos:scopeNote xml:lang="en">A small crane fixed to the wall of a warehouse or similar building.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69113">
    <skos:scopeNote xml:lang="en">A pit from which marl, a mixture of clay and carbonate of lime, is excavated. Marl is used as a fertilizer.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91139">
    <skos:scopeNote xml:lang="en">A hairdressing establishment for men.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68820">
    <skos:scopeNote xml:lang="en">A defensive cattle enclosure added to fortified towers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93657">
    <skos:scopeNote xml:lang="en">An extended arbour, eg. the beech arbour at Hampton Court, Middlesex.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91575">
    <skos:scopeNote xml:lang="en">A small dye works, often associated with a CALICO PRINTING WORKS.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70154">
    <skos:scopeNote xml:lang="en">An abbey or priory for monks of the Benedictine order.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91692">
    <skos:scopeNote xml:lang="en">A place where metal knives and edge cutting tools were manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91959">
    <skos:scopeNote xml:lang="en">A battery mounted in the flank of a bastion from which flanking fire is directed across a curtain wall.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71229">
    <skos:scopeNote xml:lang="en">A site, in which salt is obtained by boiling and evaporating salt brine or seawater in large pans. Often the only surviving evidence are the mounds formed from the waste produced by the process.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87478">
    <skos:scopeNote xml:lang="en">A site where the process of combing, the preparatory process for long wools, takes place.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/146424">
    <skos:scopeNote xml:lang="en">A mill used for the preparation of Barilla, an ash of burnt seaweed that was used for the production of soda.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/84599">
    <skos:scopeNote xml:lang="en">A place where vehicles can be filled up with petrol, oil, water, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/146432">
    <skos:scopeNote xml:lang="en">A bowl-shaped cavity or depression created in the subsoil by the long term presence and growth of tree roots or when a large tree is blown over or has its stump pulled out.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68678">
    <skos:scopeNote xml:lang="en">An aisled timber or masonry hall, serving as the chief administrative public meeting centre and law courts for a Roman town. Usually located alongside the forum.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69207">
    <skos:scopeNote xml:lang="en">A building where matches are manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91536">
    <skos:scopeNote xml:lang="en">Includes terms for components of site. See also terms in MINING INDUSTRY SITE grouping.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160365">
    <skos:scopeNote xml:lang="en">An airfield with associated hangars and control buildings used for the storage, maintenance and deployment of military aircraft and airships flown by the Royal Naval Air Service.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92582">
    <skos:scopeNote xml:lang="en">A building used by an organization or society instituted to promote the study of mathematics through lectures, research, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68899">
    <skos:scopeNote xml:lang="en">A strong, fortified dwelling, of between two and four storeys. Occupied only in times of trouble built mainly in the border country of the North from the mid 14th to the 17th century.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140302">
    <skos:scopeNote xml:lang="en">In fortification, a detached triangular outwork consisting of two battered faces forming a salient angle. Usually positioned in the ditch in front of a rampart and between two bastions. Term mainly for military architecture from 15th century and later.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162558">
    <skos:scopeNote xml:lang="en">A command post used to direct the guns of an anti aircraft battery.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70005">
    <skos:scopeNote xml:lang="en">Not a round barrow ploughed out at one end, but a specific type, the flat edge being additionally defined by stone slabs.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140344">
    <skos:scopeNote xml:lang="en">A component of salt works containing flues and drying areas where salt blocks are dried before being crushed and bagged.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78876">
    <skos:scopeNote xml:lang="en">A garden incorporating fountains and pools in which aquatic and other water-loving plants are grown.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94180">
    <skos:scopeNote xml:lang="en">A round or polygonal building containing a wheel turned by an ox to provide power.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94128">
    <skos:scopeNote xml:lang="en">Three storey house with a topshop; machinery powered by shafting through the upper floor.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91719">
    <skos:scopeNote xml:lang="en">A natural spring located within a, usually small,  man-made structure, such as a niche or a box. The structure is so placed to accomodate use for a specific non-religious function, such as communal bathing.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69276">
    <skos:scopeNote xml:lang="en">A crude, stone built structure, often roofless, used by tin miners to store equipment.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68744">
    <skos:scopeNote xml:lang="en">An imprecise term used to describe large Iron Age settlements of town-like proportions.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92452">
    <skos:scopeNote xml:lang="en">A wash room. Use with wider site type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/83975">
    <skos:scopeNote xml:lang="en">An 18th century garden building, designed in the style of a classical Ionic temple, used for standing or sitting in.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92448">
    <skos:scopeNote xml:lang="en">A prominent structure situated on land specifically as a guide to navigation for travellers or as an aid/warning to sailors out at sea.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/146331">
    <skos:scopeNote xml:lang="en">An arcade providing shelter for perishable market goods which also provides protection from the elements for the occupants of the adjoining properties.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99537">
    <skos:scopeNote xml:lang="en">A place of worship and residence for followers of Buddha.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159239">
    <skos:scopeNote xml:lang="en">A factory manufacturing personal hygiene and beauty products</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92896">
    <skos:scopeNote xml:lang="en">The outer boundary of an airfield.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70214">
    <skos:scopeNote xml:lang="en">A structure of wood, stone, iron, brick or concrete, etc, with one or more intervals under it to span a river or other space. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/147274">
    <skos:scopeNote xml:lang="en">A grouping of retail warehouses and supermarkets with associated car parking.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164375">
    <skos:scopeNote xml:lang="en">A garden that has been specifically created to be accessible to both disabled and non-disabled visitors. They may contain scented and edible plants and features designed to make sound etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93867">
    <skos:scopeNote xml:lang="en">A heated room or building used to dry yarn after it has been washed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78167">
    <skos:scopeNote xml:lang="en">Living quarters for animals, birds, etc, as pets or for observation, entertainment, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70239">
    <skos:scopeNote xml:lang="en">A site where merchandise and goods are temporarily stored before or after transportation by rail.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70099">
    <skos:scopeNote xml:lang="en">A small hut, dwelling or cave, usually in a secluded spot, in which a hermit lived. Hermits chose to live solitary lives often due to religious motives.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91341">
    <skos:scopeNote xml:lang="en">Buildings and structures associated with canal transport.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/83982">
    <skos:scopeNote xml:lang="en">A garden with one or more platforms with walks, often on different levels, usually close to the house.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160326">
    <skos:scopeNote xml:lang="en">A modification of WATCH OFFICE (12779/41) where the original large windows were removed and smaller frames fitted, the gap being filled with straight-joint brickwork.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69217">
    <skos:scopeNote xml:lang="en">A site where wrought iron or steel chains were manufactured.</skos:scopeNote>
  </rdf:Description>
  <skos:Concept rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/166981">
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-17T14:18:30</dcterms:issued>
    <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
    <skos:inScheme>
      <skos:ConceptScheme rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2">
        <skos:hasTopConcept rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69047"/>
        <cc:attributionURL rdf:resource="http://www.historicengland.org.uk"/>
        <skos:hasTopConcept rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68777"/>
        <dcterms:description xml:lang="en">Terminology relating to the built and buried heritage of the British Isles and used for recording sites, monuments, buildings and structures.</dcterms:description>
        <skos:hasTopConcept rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70204"/>
        <cc:license rdf:resource="http://creativecommons.org/licenses/by/3.0"/>
        <skos:hasTopConcept rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70306"/>
        <skos:hasTopConcept rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68757"/>
        <skos:hasTopConcept rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68693"/>
        <skos:hasTopConcept rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68543"/>
        <skos:hasTopConcept rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70551"/>
        <skos:hasTopConcept rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68921"/>
        <skos:hasTopConcept rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/102872"/>
        <skos:hasTopConcept rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99961"/>
        <skos:hasTopConcept rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71344"/>
        <skos:hasTopConcept rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68808"/>
        <skos:hasTopConcept rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69438"/>
        <skos:hasTopConcept rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99962"/>
        <skos:hasTopConcept rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68707"/>
        <skos:hasTopConcept rdf:resource="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93771"/>
        <cc:attributionName xml:lang="en">Historic England</cc:attributionName>
