		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013618"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk017418"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk011755"/>
		<xe:explanation_temp xml:lang="de">Enthält ein Boden mehr als 60% Partikel der Bodenart Sand, spricht man von einem Sandboden.</xe:explanation_temp>
		<skos:definition xml:lang="de">Sand ist ein Sediment, dessen einzelne Partikel kleiner als 2 mm und größer als 0,063 mm im Durchmesser sind und zumeist eine hohen Silikat- und Quarzanteil aufweist</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4051537-0"/>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300014341"/>
