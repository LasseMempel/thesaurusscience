		<skos:prefLabel xml:lang="gd">POST GEATA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Post fiodha dìreach sa bheil lùdagan a tha geata a' crochadh orra. Airson structaran bhreigean is clachaireachd, cleachd PIOLAIR GEATA</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GATE POST</skos:prefLabel>
