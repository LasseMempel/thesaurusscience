		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1221" />
		<skos:scopeNote xml:lang="en">A facility with one or more expanding gas storage tanks, often including equipment for measuring the amount used.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
