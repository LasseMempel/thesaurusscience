				<skos:prefLabel xml:lang="gd">DÌDEAN</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Daingean sealach no balla ùir, na aonar no am broinn daingean buan mar àite dìon deireannach.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">REDOUBT</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:altLabel xml:lang="en">EARTHWORK REDOUBT</skos:altLabel>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/278" />
				<skos:scopeNote xml:lang="en">A temporary fortified stronghold or earthwork, either isolated or built inside a permanent fortification as a final defensive measure.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
