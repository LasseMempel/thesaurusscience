        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T17:14:21.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T17:18:20.000</terms:modified>
        <skos:definition xml:lang="de">1. Einschnitt unterhalb des Säulenhalses; 2. keilförmiges Ausgleichselement zwischen dem leichten Gefälle des Stylobats und der waagerechten Standfläche der Säule. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">1. Spára pod krčkem sloupu. 2. Klínovitý vyrovnávací prvek mezi mírným sklonem stylobatu a vodorovnou dosednou plochou sloupu. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">An den Stylobat angearbeitetes, keilförmiges Ausgleichselement, das trotz des durch die Entwässerung bedingten Gefälles des Stylobats eine waagrechte Standfläche für die Säule schaffen soll. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Scamillus</skos:prefLabel>
        <skos:prefLabel xml:lang="es">cuña en el estilóbato</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">scamila</skos:prefLabel>
        <skos:prefLabel xml:lang="it">scamillo</skos:prefLabel>
        <skos:prefLabel xml:lang="en">scamillus</skos:prefLabel>
    </owl:NamedIndividual>
    


