        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-14T16:39:21.000</terms:modified>
        <skos:definition xml:lang="de">Eine Sonderform des steigenden Gewölbes, bei dem die Achse horizontal verläuft, die WiderIagsmauern parallel sind und die ScheitelIinie ansteigt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Gewölbe mit steigendem Rücken</skos:prefLabel>
        <skos:prefLabel xml:lang="en">vault with a rising ridge line </skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte à ligne sommitale inclinée </skos:prefLabel>
    </owl:NamedIndividual>
    


