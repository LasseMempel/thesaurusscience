        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T12:21:32.000</terms:modified>
        <skos:definition xml:lang="de">Eine Reihe von Königsfiguren, wahrscheinlich Vorfahren Christi, die quer über die Westfassade einiger französischer und englischer Kathdralen verläuft. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Soch králů, patrně předků Kristových, která je umístěna napříč západní fasádou některých francouzských a anglických katedrál. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Königsgalerie</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">královská galerie</skos:prefLabel>
    </owl:NamedIndividual>
    


