		<skos:prefLabel xml:lang="gd">OSPADAL LIGHICHEAN SPÈISEALTA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Ospadal a nì obair-lannsa no deuchainnean tinneis-inntinn no meadaigeach 's a bheir seachad leigheas do dh'euslaintich air a bheil tinneasan no leòntan sònraichte.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SPECIALIST HOSPITAL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-10-22T11:18:13</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-10-22T11:18:34</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/639">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/639</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">OSPADAL-INNTINN</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Ospadal far am faigh daoine a tha a' fulang tinneasan-inntinn cùram is leigheasadh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">PSYCHIATRIC HOSPITAL</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:altLabel xml:lang="en">ASYLUM</skos:altLabel>
				<skos:altLabel xml:lang="en">MENTAL HOSPITAL</skos:altLabel>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/505562" />
				<skos:scopeNote xml:lang="en">A hospital where patients suffering from psychiatric disorders receive care and treatment.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
