<http://www.eionet.europa.eu/gemet/concept/3810> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5135> ;
    skos:closeMatch <http://data.uba.de/umt/_00012128> ;
    skos:definition "The branch of medical science concerned with diseases of the blood."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Hämatologie"@de,
        "haematology"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Hematology> .

<http://www.eionet.europa.eu/gemet/concept/3812> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5196> ;
    skos:closeMatch <http://data.uba.de/umt/_00012171>,
        <http://dbpedia.org/resource/Hail> ;
    skos:definition "Precipitation in the form of balls or irregular lumps of ice, always produced by convective clouds, nearly always cumulonimbus."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_3469>,
        <http://eurovoc.europa.eu/5683> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Hagel"@de,
        "hail"@en .

<http://www.eionet.europa.eu/gemet/concept/3815> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033>,
        <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:closeMatch <http://data.uba.de/umt/_00012187>,
        <http://dbpedia.org/resource/Half-life> ;
    skos:definition "The time required for one-half the atoms of a given amount of radioactive material to undergo radioactive decay."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Halbwertszeit"@de,
        "half-life"@en .

<http://www.eionet.europa.eu/gemet/concept/3817> a skos:Concept ;
