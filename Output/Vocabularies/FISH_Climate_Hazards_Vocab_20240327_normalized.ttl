    skos:broader <http://purl.org/heritagedata/schemes/38076/concepts/20400> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/38076> ;
    skos:prefLabel "Mudslide"@en ;
    skos:scopeNote "Mass movement of fine or liquified debris."@en .

