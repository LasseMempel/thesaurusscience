        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_11426742"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_5f9418c5"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_6b1efaf3"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-23T09:39:35.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T13:14:16.000</terms:modified>
        <skos:definition xml:lang="de">Bezeichnung für alle Gewölbe, deren Form aus der des Zylinders abgeleitet werden kann, z.B. Tonnengewölbe, Kreuzgewölbe, Klostergewölbe und Stichkappe. Die Wölbflächen sind Zylinderflächen, die man sich durch Fortbewegen einer ebenen, regelmäßig gekrümmten Linie an einer geraden oder gekrümmten Achse entstanden denken kann. Im Unterschied zu den sphärischen Gewölben werden zylindrische Gewölbe eingeschalt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="en">cylindrical vault</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte cylindrique</skos:prefLabel>
        <skos:prefLabel xml:lang="de">zylindrisches Gewölbe</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_049c4c22"/>
    </owl:NamedIndividual>
    


