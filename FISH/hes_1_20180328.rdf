		<skos:prefLabel xml:lang="gd">LIOS-ÀRAICH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Lios far a bheilear a' fàs preasan is lusan eile gus an reic no gus an cur am badeigin eile.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">NURSERY GARDEN</skos:prefLabel>
