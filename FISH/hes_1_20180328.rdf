		<skos:prefLabel xml:lang="gd">IONAD-RIAGHLAIDH UISGE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalaichean, structaran is làraichean airson smachd a chumail air sruthadh an uisge.</skos:scopeNote>
