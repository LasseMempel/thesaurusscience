        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-26T14:06:48.000</terms:modified>
        <skos:altLabel xml:lang="de">Ritterdach</skos:altLabel>
        <skos:altLabel xml:lang="fr">toit en cavalier</skos:altLabel>
        <skos:definition xml:lang="de">Beim Kronendach (Ritterdach) trägt jede Dachlatte zwei Reihen versetzter Biberschwänze. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Eine Art der Dachdeckung, bei der jede Dachlatte zwei Reihen versetzter Biberschwanz-Ziegel trägt. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="es"> tejado coronado</skos:prefLabel>
        <skos:prefLabel xml:lang="fr"> toit couronné</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Kronendach</skos:prefLabel>
