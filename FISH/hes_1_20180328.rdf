				<skos:prefLabel xml:lang="gd">TAIGH-CÒMHNAIDH  NEACH-CLÈIREACH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Àite-còmhnaidh aig ball coimhearsnachd cràbhach, m.e. aba, priòir, ceallair is msaa.</skos:scopeNote>
