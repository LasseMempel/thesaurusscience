        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-28T13:56:26.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T14:42:08.000</terms:modified>
        <skos:prefLabel xml:lang="de">nimbiertes Kreuz</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Nimbiertes Kreuz, ein Winkelscheibkreuz, dessen Mittelschild rund ausgebildet ist. [Glossarium Artis]</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_937c4934 -->


