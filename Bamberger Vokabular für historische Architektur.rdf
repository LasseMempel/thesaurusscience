        <skos:altLabel xml:lang="de">Gürtelstrick</skos:altLabel>
        <skos:altLabel xml:lang="en">string</skos:altLabel>
        <skos:definition xml:lang="de">Strick m, Gürtelstrick m: Schnur, mit der die Kutte gegürtet wird. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Strick</skos:prefLabel>
