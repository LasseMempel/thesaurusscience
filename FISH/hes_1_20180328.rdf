		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1039" />
		<skos:scopeNote xml:lang="en">A site with equipment and structures for the extraction of tin bearing ores.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
