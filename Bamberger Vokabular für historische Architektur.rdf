        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_9f74e321"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_fd44f8d9"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-18T18:16:24.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T17:32:02.000</terms:modified>
        <skos:definition xml:lang="de">Tabernakelauskleidung f: der meist aus weißer Seide bestehende Bezug der Innenflächen des Tabernakels, der immer dann vorgeschrieben ist, wenn diese nicht vergoldet sind. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Tabernakelauskleidung</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">revêtement du tabernacle</skos:prefLabel>
        <skos:prefLabel xml:lang="en">tabernacle lining</skos:prefLabel>
    </owl:NamedIndividual>
    


