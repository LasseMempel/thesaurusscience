    skos:altLabel "Early Christian Memorial Stone"@en,
        "Inscribed Slab"@en,
        "Pillar Stone"@en,
        "Pre Conquest Inscribed Stone"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99962> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "INSCRIBED STONE"@en ;
    skos:scopeNote "An early Medieval commemorative monument in the form of a stone which has been inscribed with symbols."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70101> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99962> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "KERBED BOULDER"@en ;
    skos:scopeNote "A Prehistoric monument type in South West England in which a natural boulder is surrounded by a man-made kerb of stones."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70102> a skos:Concept ;
    skos:altLabel "Scallage"@en,
        "Scallenge"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99962> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "LYCH GATE"@en ;
    skos:scopeNote "A covered gateway, at the entrance to a churchyard, where during a funeral a coffin could be set down until the vicar arrived."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70103> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99962> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "MAYPOLE"@en ;
