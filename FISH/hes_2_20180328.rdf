						<skos:prefLabel xml:lang="en">UNIDENTIFIED POTTERY</skos:prefLabel>
						<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-04-13T13:51:05</dcterms:created>
