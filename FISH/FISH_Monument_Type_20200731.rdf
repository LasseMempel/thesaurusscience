    <skos:scopeNote xml:lang="en">Working area for rag sorting and grading.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70370">
    <skos:scopeNote xml:lang="en">A place where material used for burning is stored.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93814">
    <skos:scopeNote xml:lang="en">A place where wigs, hair-pieces and hair extensions are made and sold.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164142">
    <skos:scopeNote xml:lang="en">An industrial facility concerned with the manufacture of magnesium from magnesium hydroxide derived from sea water. Magnesium was used in the manufacture of aircraft.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91585">
    <skos:scopeNote xml:lang="en">A building in which works of art are displayed for sale.</skos:scopeNote>
  </rdf:Description>
