    <!-- https://hist-arch-vocab.org/bvha#c_7fe1d054 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_7fe1d054">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_be6dd5fa"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
