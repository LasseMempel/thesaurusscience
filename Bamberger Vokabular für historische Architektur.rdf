        <skos:altLabel xml:lang="de">Nachen</skos:altLabel>
        <skos:altLabel xml:lang="de">Rauchschiff</skos:altLabel>
        <skos:altLabel xml:lang="de">Rauchschiffchen </skos:altLabel>
        <skos:altLabel xml:lang="de">Schiffchen</skos:altLabel>
        <skos:altLabel xml:lang="fr">nacelle à encense</skos:altLabel>
        <skos:altLabel xml:lang="la">naveta</skos:altLabel>
        <skos:altLabel xml:lang="it">navicella</skos:altLabel>
        <skos:altLabel xml:lang="la">navicella</skos:altLabel>
        <skos:altLabel xml:lang="en">navicula</skos:altLabel>
        <skos:altLabel xml:lang="la">navicula</skos:altLabel>
        <skos:definition xml:lang="de">Weihrauchschiff(chen) n; auch Rauchschiff (chen) n; Nachen m; gr. dibanotris; lat. navis; navicella; navicula; naveta: eine flache, länglich ovale Schale mit flachem Fuß und einem aufklappbaren, meist zweiteiligen Deckel als Gefäß für die Weihrauchkörner. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Zubehör zum Weihrauchbehälter, nach seiner Form Schiffchen genannt. [RDK Labor]. </skos:definition>
        <skos:prefLabel xml:lang="de">Weihrauchschiffchen</skos:prefLabel>
        <skos:prefLabel xml:lang="el">dibanotris</skos:prefLabel>
        <skos:prefLabel xml:lang="en">incense-boat</skos:prefLabel>
        <skos:prefLabel xml:lang="it">navetta portaincenso</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">navette à encense</skos:prefLabel>
        <skos:prefLabel xml:lang="la">navis</skos:prefLabel>
        <skos:prefLabel xml:lang="nl">scheepje</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_b9db3c12 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b9db3c12">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_9afe9adf"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T23:19:32.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:17:42.000</terms:modified>
        <skos:altLabel xml:lang="de">Faltengewölbe</skos:altLabel>
        <skos:altLabel xml:lang="de">Mützengewölbe</skos:altLabel>
        <skos:altLabel xml:lang="de">Tütengewölbe</skos:altLabel>
        <skos:altLabel xml:lang="de">Zellgewölbe </skos:altLabel>
        <skos:altLabel xml:lang="en">cellular vault</skos:altLabel>
        <skos:altLabel xml:lang="cs">diamantová klenba</skos:altLabel>
        <skos:altLabel xml:lang="en">diamond vault</skos:altLabel>
        <skos:altLabel xml:lang="en">lierne vault</skos:altLabel>
        <skos:altLabel xml:lang="en">net vault</skos:altLabel>
        <skos:definition xml:lang="de">Rippenloses Gewölbe, dessen Leibung in vertiefte, von scharfen Graten begrenzte Fache unterschiedlicher Form gegliedert ist. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="cs">Sklípková klenba je zvláštním typem síťové klenby v severoněmecké cihlové gotice, vytváří vyduté prostory mezi hranami. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Spätgot. Gewölbeform, die durch Übereckstellung der Backsteine an den Graten entsteht. Die Flächen zwischen den Graten sind tief eingeschnitten und verputzt. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Zellengewölbe</skos:prefLabel>
        <skos:prefLabel xml:lang="es">bóveda celular.</skos:prefLabel>
        <skos:prefLabel xml:lang="en">cell vault</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">sklípková klenba</skos:prefLabel>
        <skos:prefLabel xml:lang="it">volta a ombrello</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte à alvéoles</skos:prefLabel>
        <broaderByConstruction rdf:resource="https://hist-arch-vocab.org/bvha#c_9afe9adf"/>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_9afe9adf"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_b9e0a442 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b9e0a442">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_5d9b780a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-15T16:00:50.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T14:32:52.000</terms:modified>
        <skos:altLabel xml:lang="it"> bertesca</skos:altLabel>
        <skos:altLabel xml:lang="fr"> bretèche</skos:altLabel>
        <skos:altLabel xml:lang="de">Gusserker</skos:altLabel>
        <skos:altLabel xml:lang="it">cadoia</skos:altLabel>
        <skos:altLabel xml:lang="es">matacán</skos:altLabel>
        <skos:altLabel xml:lang="it">naso</skos:altLabel>
        <skos:altLabel xml:lang="cs">piknůsek</skos:altLabel>
        <skos:definition xml:lang="de">Kleiner, erkerartiger Vorbau mit Bodenöffnung an den Außenseiten von Burg- oder Stadtmauern, an Torbauten, selten an Wohnbauten und an Bergfrieden, wie bei Gusslöchern (Wurfscharten) zum Ausgießen von heißen Flüssigkeiten (Wasser, Öl, Pech, Teer) gegen angreifende Feinde. Häufig werden Abtritte mit P.n verwechselt,  deren Einbauten und Bodenöffnung aber ihre Nutzung erkennen lassen. Die P. ist wahrscheinl. vom Orient über Südfrankreich im 13. Jh. allg. in Europa verbreitet worden. Die frz. Wehrbauten bevorzugten eme fortlaufende und zusammenhängende Anordnung als vorspringende Galerie auf Konsolen (Maschikuli). [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Licí arkýř ve středověkém hradu. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Nach unten offener Erker an der Außenseite einer Wehrmauer zum Hinabgießen von heißem Öl, Pech o. ä. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="fr"> mâchicoulis</skos:prefLabel>
        <skos:prefLabel xml:lang="it"> piombatoia</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Pechnase</skos:prefLabel>
        <skos:prefLabel xml:lang="en">machicolation</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">podsebití</skos:prefLabel>
    </owl:NamedIndividual>
    


