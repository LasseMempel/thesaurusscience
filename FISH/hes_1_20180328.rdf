	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1820">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1820</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">UCHDAN RÈILE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Druimean cloiche no ùir fuadain a chaidh a thogail gus rathad-iarainn a chur le bruach no thairis air talamh a thèid a thuileachadh gu tric.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">RAILWAY EMBANKMENT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1811" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1791" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1827" />
		<skos:scopeNote xml:lang="en">An artificial ridge of stone or earth, built to carry a railway track across a declivity or an area subject to flooding.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1824">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1824</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">STÈISEAN-RÈILE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite far a bheil ùrlaran is goireasan eile airson 's gun dhan luchd-siubhail tighinn far nan trèanaichean no a dhol orra no airson bathar a luchdadh orra no a thoirt far nan trèanaichean.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">RAILWAY STATION</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">RAILWAY TERMINUS</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1811" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1825">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1825</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">STAD-RÈILE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Stèisean-rèile beag, gu math tric as aonais thogalaichean buana.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">RAILWAY HALT</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1824" />
				<skos:scopeNote xml:lang="en">A minor railway station, often without permanent buildings.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
