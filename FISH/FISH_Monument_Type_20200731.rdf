  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91450">
    <skos:scopeNote xml:lang="en">A structure used for the roasting or drying of chicory.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93672">
    <skos:scopeNote xml:lang="en">A car park situated beneath the surface of the ground.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/145014">
    <skos:scopeNote xml:lang="en">An oven used in the coal industry for the recovery of gas, tar and other by-products of the coking process. Late 19th century-20th century.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78353">
    <skos:scopeNote xml:lang="en">A cairn featuring a mound of small diameter (normally less than 6m), which is surrounded by a kerb of stones which are considerably taller than the mound.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69148">
    <skos:scopeNote xml:lang="en">A site used for the production of dyes from natural ingredients.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91921">
    <skos:scopeNote xml:lang="en">Area of a garden for the cultivation of ferns.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94006">
    <skos:scopeNote xml:lang="en">A site used by a carrier to accommodate his horses and vehicles and store goods awaiting transportation, etc.</skos:scopeNote>
  </rdf:Description>
