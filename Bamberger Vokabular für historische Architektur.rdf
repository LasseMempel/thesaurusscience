        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-28T15:41:20.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T14:12:01.000</terms:modified>
        <skos:definition xml:lang="de">Das gemeinschaftl. Wohnhaus für Studenten in ma. und frühneuzeitl. Universitätsstädten, zumeist bestehend aus Aufenthalts- und Wirtschaftsräumen, Bibliothek und Lehrraum (Hörsaal) sowie Schlafräumen. [Koepf / Binding 2016]</skos:definition>
