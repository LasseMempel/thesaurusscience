  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68985">
    <skos:scopeNote xml:lang="en">Small settlement with no ecclesiastical or lay administrative function.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68759">
    <skos:scopeNote xml:lang="en">A sepulchral monument erected to commemorate a person or persons buried elsewhere.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71737">
    <skos:scopeNote xml:lang="en">A chapel within a parish church containing an altar and one or more tombs.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/168259">
    <skos:scopeNote xml:lang="en">A human constructed underwater structure, usually built to promote marine life in areas with a generally featureless eas bed but have also been built to control erosion, block ship passage, or improve surfing.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160244">
    <skos:scopeNote xml:lang="en">A building housing the stand-by generator set and associated equipment which could supply electricity to all essential services in the event of a power cut.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91932">
    <skos:scopeNote xml:lang="en">A carving, often a bust or full-length figure, originally found above a ship's cutwater. Use as an external feature only.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93546">
    <skos:scopeNote xml:lang="en">Includes bleaching, dressing, dyeing and printing.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69267">
    <skos:scopeNote xml:lang="en">Also use with other metal ores extracted and MINE where relevant.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170008">
    <skos:scopeNote xml:lang="en">A bell mounted on an anchored vessel, buoy, headland, rock etc and rung as a warning to mariners in foggy weather.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91338">
    <skos:scopeNote xml:lang="en">An inland settlement such as Runcorn, Ellesmere Port or Stourport, that combines docks and terminal facilities at the interface between land and canal transportation systems.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92265">
    <skos:scopeNote xml:lang="en">An outwork joined to the mainwork by two parallel wings.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162752">
    <skos:scopeNote xml:lang="en">A place of worship for the followers of Jainism</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92137">
    <skos:scopeNote xml:lang="en">A place where students live, sometimes on a college campus.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142019">
    <skos:scopeNote xml:lang="en">A small island, especially within a river.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/169844">
    <skos:scopeNote xml:lang="en">Sorting offices constructed during the Second World War designed to rapidly move goods from the vulnerable docks and ports via the rail network.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91529">
    <skos:scopeNote xml:lang="en">A stock exchange dealing in the prices for coal and shares in coal production.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92767">
    <skos:scopeNote xml:lang="en">A complex of buildings producing power derived from nuclear energy.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162627">
    <skos:scopeNote xml:lang="en">Regular courtyard farmsteads where the buildings are arranged around three sides of a yard which is open to one side.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70460">
    <skos:scopeNote xml:lang="en">A dam which can be raised or lowered to regulate the flow of water.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91933">
    <skos:scopeNote xml:lang="en">A place where metal-cutting hand files were made.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91262">
    <skos:scopeNote xml:lang="en">An area, often including a platform, used for boxing competitions.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164115">
    <skos:scopeNote xml:lang="en">A bridge that crosses over a railway.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92223">
    <skos:scopeNote xml:lang="en">A series of cages in which hens are confined for intensive egg laying.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159384">
    <skos:scopeNote xml:lang="en">A large kitchen garden enclosed by a substantial wall, not usually adjacent to its associated house.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140482">
    <skos:scopeNote xml:lang="en">A small arched hangar built by the Canadian company Fromson of Byfleet to drawing number 3971/43. Used only as storage sheds on RNASs.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70223">
    <skos:scopeNote xml:lang="en">A bridge whose deck is hung from above by large cables, chains or pinned iron or steel bars hanging from towers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160504">
    <skos:scopeNote xml:lang="en">A factory used for the manufacture of ordnance including small arms, ammunition, artillery pieces and armoured fighting vehicles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68670">
    <skos:scopeNote xml:lang="en">A place where swans are bred and reared.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/170634">
    <skos:scopeNote xml:lang="en">A trench dug through topsoil in an arable field in order to extract underlying clay which was then spread on the field and ploughed in to improve soil fertility. Usually found in peaty soil areas such as the Lincolnshire and Cambridgeshire fenlands.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91576">
    <skos:scopeNote xml:lang="en">A naval dockyard building used for the manufacture of flags.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69072">
    <skos:scopeNote xml:lang="en">A place where shale, a laminated clay or silt which has been compressed by the weight of the rocks over it, is extracted from the ground.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/135076">
    <skos:scopeNote xml:lang="en">A building, usually part of a textile mill complex, where warp yarn is sized prior to weaving. Sizing is the application of a starch solution to warp threads to add strength and protection.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140394">
    <skos:scopeNote xml:lang="en">A special school to train personnel for employment in Air Traffic Control and operation duties.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/162732">
    <skos:scopeNote xml:lang="en">Site or building used for paintballing.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94150">
    <skos:scopeNote xml:lang="en">A wall containing apertures to allow a weapon to be fired through it.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/78143">
    <skos:scopeNote xml:lang="en">A site where household rubbish and other waste products can be disposed of. May take the form of a pit, rubbish tip, landfill site or incineration plant.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70516">
    <skos:scopeNote xml:lang="en">The official residence of an archbishop, eg. Lambeth Palace.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91353">
    <skos:scopeNote xml:lang="en">A site where canvas, coarse, unbleached cloth, made from hemp or flax, was manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71398">
    <skos:scopeNote xml:lang="en">A cottage for workers on a country house estate.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140390">
    <skos:scopeNote xml:lang="en">A military storage aircraft hangar designed in 1937. It has a curved profile and is constructed from steel ribs supporting a concrete skin. The roof is covered with earth and turf.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71811">
    <skos:scopeNote xml:lang="en">The residence of a lightkeeper.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68836">
    <skos:scopeNote xml:lang="en">The courtyard of a castle, ie. the area enclosed by the rampart or curtain. Use with wider site type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93282">
    <skos:scopeNote xml:lang="en">Usually a servants' dining room.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/138698">
    <skos:scopeNote xml:lang="en">Component part of a mungo and shoddy mill, where non-wool fibres from shredded material are destroyed by either soaking rags in an acid solution or rotating them in drums in a hot acidic gas followed by heat. The result is an all-wool product.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69467">
    <skos:scopeNote xml:lang="en">A conspicuous object, such as a beacon, used by mariners to aid navigation at sea.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70124">
    <skos:scopeNote xml:lang="en">A monastic enclave dependent on a mother house.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71202">
    <skos:scopeNote xml:lang="en">Iron Age or Roman coastal site producing salt by boiling of seawater in fired clay pans, resulting in characteristic mounds of 'BRIQUETAGE' (see Archaeological Objects Thesaurus).</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143854">
    <skos:scopeNote xml:lang="en">Any building, group of buildings, or site at which tungsten ores have been converted to sodium tungstate by means of the Oxland Process. This was first used at Drakewalls Mine, Cornwall, in 1850.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/90519">
    <skos:scopeNote xml:lang="en">Engineering works dedicated solely to the manufacture and repair of boilers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68893">
    <skos:scopeNote xml:lang="en">A coastal gun/watch tower built as part of the anti-invasion defences during the Napoleonic Wars.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68720">
    <skos:scopeNote xml:lang="en">A stone on which plague victims placed vinegar-disinfected money to pay for food left for them by the townspeople.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69428">
    <skos:scopeNote xml:lang="en">A place where wheels and wheeled vehicles were manufactured, originally from wood.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143253">
    <skos:scopeNote xml:lang="en">Rocket projector site with a circular or octagonal concrete holdfast, 1.5m across, surrounded by a 4.6m radius octagonal concrete surround. Six such rocket projectors were arranged in a 3 x 2 grid. Personnel shelters placed midway between each site.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159203">
    <skos:scopeNote xml:lang="en">A monument erected as a permanent reminder of a military victory. The design usually includes images of the spoils of the battle.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70018">
    <skos:scopeNote xml:lang="en">An interment of human or animal remains. Use specific type where known. If component use with wider site type. Use FUNERARY SITE for optimum retrieval in searches.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140299">
    <skos:scopeNote xml:lang="en">A defence work, either a detached fieldwork or an outwork built as part of a fortification as a last defensive position.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68668">
    <skos:scopeNote xml:lang="en">A pit dug in the ground used to store meat, grain and other foodstuffs. A common feature of Iron Age farms.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93080">
    <skos:scopeNote xml:lang="en">A place where two or more railway lines meet.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71643">
    <skos:scopeNote xml:lang="en">A house for drying wool after fulling and dying.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71816">
    <skos:scopeNote xml:lang="en">A subscription club, usually with a library and newspaper room, established from c.1815-1860, their educational function gradually taken over by the public libraries in the later 19th century.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164229">
    <skos:scopeNote xml:lang="en">An engineering works that produces tufting machinery especially for use in the manufacturing of carpets.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71724">
    <skos:scopeNote xml:lang="en">A room used primarily for storing food and drink.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68714">
    <skos:scopeNote xml:lang="en">A building or group of buildings situated close to the sea used by coastguards to enable them to monitor the coastline.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99552">
    <skos:scopeNote xml:lang="en">A place of worship for followers of the Wesleyan Association. This group split from the Methodists in 1836 and were separate until joining the Methodist Reform Church in 1857.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69075">
    <skos:scopeNote xml:lang="en">A place where stone is dressed or shaped for use in building, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91905">
    <skos:scopeNote xml:lang="en">A dockside crane with a solid curving jib made out of rivetted iron plates.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68800">
    <skos:scopeNote xml:lang="en">The public house was a 19th century development, distinctive from the earlier BEER HOUSE by its decorative treatment and fittings.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68918">
    <skos:scopeNote xml:lang="en">A short trench used to protect troops or to provide defensive fire from, often dug for practice purposes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/136810">
    <skos:scopeNote xml:lang="en">An open flat gound where the sport of shooting with bow and arrows is pursued. The ground can be equipped with targets mounted on butts and various fixed distance marker.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69961">
    <skos:scopeNote xml:lang="en">A tomb or memorial, resembling an altar, often with a recumbent effigy on top.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142015">
    <skos:scopeNote xml:lang="en">A site where tanks and armoured fighting vehicles can be stored.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69309">
    <skos:scopeNote xml:lang="en">A factory where hemp, the woody stalk of the hemp plant, used for the making of coarse cloth and cordage, was processed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71676">
    <skos:scopeNote xml:lang="en">A building providing dining facilities and recreation for commissioned officers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70410">
    <skos:scopeNote xml:lang="en">Use only if function unknown, otherwise use specific type.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69225">
    <skos:scopeNote xml:lang="en">A building or site where bloom iron or cast iron is forged into wrought iron.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71361">
    <skos:scopeNote xml:lang="en">An open sided building known to have been used for sheltering cattle.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93693">
    <skos:scopeNote xml:lang="en">A model village built by a utopian society or group of artists.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167330">
    <skos:scopeNote xml:lang="en">A facility for the kitting out and induction of recruits before being sent on for training.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/97463">
    <skos:scopeNote xml:lang="en">An establishment where books, periodicals, music, etc, are produced from original manuscripts and distributed to booksellers, dealers and the public.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71187">
    <skos:scopeNote xml:lang="en">A man-made trough or valley through a hill, carrying at its base a railway.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70424">
    <skos:scopeNote xml:lang="en">A constructed space beneath the surface of the ground.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70090">
    <skos:scopeNote xml:lang="en">Timber or stone built structure, traces of which are found within some long and round barrows, in which human remains were interred prior to mound construction.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91792">
    <skos:scopeNote xml:lang="en">A commercial building used for the production of detailed, often technical, drawings.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140553">
    <skos:scopeNote xml:lang="en">A two-storey, structure with a brick ground floor and a reinforced concrete upper floor with balcony and large windows to the watch office and control room. This became the most common building design for air traffic control in the Second World War.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71481">
    <skos:scopeNote xml:lang="en">Engine driving a continuous wire rope for the haulage of tubs in a mine and at the heapstead.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69081">
    <skos:scopeNote xml:lang="en">A works, including an extractive site, producing a clay of high plasticity and firmness, used as a basic raw material for porcelain.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70041">
    <skos:scopeNote xml:lang="en">A deep pit used for the burial of plague victims.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91153">
    <skos:scopeNote xml:lang="en">Mill incorporating water-powered hammers for beating brass sheet, etc. into vessels, pots, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92833">
    <skos:scopeNote xml:lang="en">A hospital devoted to the curing or correcting of physical deformities.</skos:scopeNote>
