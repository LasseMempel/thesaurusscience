		<skos:prefLabel xml:lang="de">Stehender Ofen</skos:prefLabel>
		<skos:prefLabel xml:lang="en">updraught kiln</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003601"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010184"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk003601"/>
		<skos:definition xml:lang="de">Ein Stehender Ofen ist ein Brennofen, bei dem Feuerung und Brennraum übereinander angeordnet sind und durch eine horizontale Lochtenne oder Schlitztenne getrennt werden, sodass das Brenngut von unten mit Heizluft bestrichen wird.</skos:definition>
