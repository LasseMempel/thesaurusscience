	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk018848">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">probe (medical equipment)</skos:prefLabel>
		<skos:altLabel xml:lang="en">probes (medical equipment)</skos:altLabel>
		<skos:prefLabel xml:lang="de">Sonde (medizinisches Gerät)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Sonden (medizinische Geräte)</skos:altLabel>
		<skos:altLabel xml:lang="en">sound (medical equipment)</skos:altLabel>
		<skos:altLabel xml:lang="en">sounds (medical equipment)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk019093"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk019093"/>
		<skos:definition xml:lang="de">Eine Sonde ist ein medizinisches Gerät, das sowohl starr als auch biegsam stabförmig, röhrenförmig oder schlauchförmig sein kann. Es besteht in der Regel aus Metall oder Kunststoff und hat ein stumpfes Ende. Sonden variieren in ihrer Größe und werden für diagnostische oder therapeutische Zwecke in natürliche oder durch Krankheiten oder Verletzungen entstandene Hohlräume oder Körperkanäle eingeführt.</skos:definition>
		<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q33241593"/>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/7610839-9"/>
