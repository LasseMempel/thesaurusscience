				<skos:prefLabel xml:lang="gd">BOGSA-FÒN ÈIGINN-RATHAID</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Bogsa-fòn ri taobh an rathaid airson draibhearan càr 's iad feumach air cuideachadh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">MOTORING CALL BOX</skos:prefLabel>
