    <!-- https://hist-arch-vocab.org/bvha#c_751baa8d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_751baa8d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
