    <skos:scopeNote xml:lang="en">An enclosure for pigs that includes a covered pen and yard.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160498">
    <skos:scopeNote xml:lang="en">A site or building used to co-ordinate Air-Sea Rescue operations.</skos:scopeNote>
