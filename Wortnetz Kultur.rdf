		<skos:prefLabel xml:lang="en">dry  masonry</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Trockenmauerwerk</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk002319"/>
