		<skos:altLabel xml:lang="de">Adventszeit</skos:altLabel>
		<skos:altLabel xml:lang="de">Vorweihnachtsfest</skos:altLabel>
		<skos:altLabel xml:lang="de">Vorweihnachtszeit</skos:altLabel>
