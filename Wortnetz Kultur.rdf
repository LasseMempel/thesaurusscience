		<skos:altLabel xml:lang="de">Leitstände</skos:altLabel>
		<skos:altLabel xml:lang="de">Leitwarte</skos:altLabel>
		<skos:altLabel xml:lang="de">Meßwarte</skos:altLabel>
		<skos:altLabel xml:lang="de">Schaltwarte</skos:altLabel>
		<skos:altLabel xml:lang="de">Steuerwarte</skos:altLabel>
