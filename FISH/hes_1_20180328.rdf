		<skos:scopeNote xml:lang="gd">Sloc a chaidh a chladhach, a-rèir coltais, airson rudan (no sa bheil rudan) nach deach an cur ann airson stòradh, tilgeil air falbh no às-tharraing.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">RITUAL PIT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-02-28T15:12:31</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">VOTIVE PIT</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1763" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1901" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/2316" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/2317" />
		<skos:scopeNote xml:lang="en">A pit which appears to have been dug for, or which contains, objects apparently deposited for reasons other than storage, disposal or extraction.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1763">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1763</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÀRACH DHEAS-GHNÀTHAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach a thathar gu sònraichte a' cleachdadh airson deas-ghnàthan seach adhbharan àbhaisteach no gnìomhachais. Cleachd briathar pongail ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">RITUAL SITE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1762" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1645" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/2316" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/2317" />
		<skos:scopeNote xml:lang="en">A site used primarily for ritual, rather than domestic or industrial, purposes. Use specific term wherever possible.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1765">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1765</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">COMRAICH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite naomh no naomhaichte no tèarmann.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SANCTUARY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1645" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1766" />
		<skos:scopeNote xml:lang="en">A sacred or consecrated place, or a place of refuge.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1766">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1766</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">COMHARRA COMRAICH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Comharra, mar is trice ann an cruth croise, a chomharraicheas crìochan tèarmainn.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SANCTUARY MARKER</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">SANCTUARY CROSS</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1645" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1462" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1765" />
		<skos:scopeNote xml:lang="en">A marker, usually in the shape of a cross, indicating the extent of an area of sanctuary.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1767">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1767</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH-SEISEIN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach a tha ga chleachdadh mar àite-coinneachaidh aig buidheann cràbhach a tha os cionn coithionail ionadail.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SESSION HOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1645" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/188" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/501675" />
		<skos:scopeNote xml:lang="en">A building used as the meeting place of a religious body presiding over a local congregation.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1768">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1768</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">SGRÌN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite-adhraidh a tha co-cheangailte ri neach no rud naomh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SHRINE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1645" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1646" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1733" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1744" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1751" />
		<skos:scopeNote xml:lang="en">A place of worship associated with a sacred person or object.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1769">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1769</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TURSA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Clach a chaidh a sheasamh san talamh a dh'aona-ghnothach. Na cleachd ach airson clachan leotha fhèin. Air neo cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">STANDING STONE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1645" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1503" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1571" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1770" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1771" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1774" />
		<skos:scopeNote xml:lang="en">A stone that has been deliberately set upright in the ground. Use only for isolated stones. Otherwise use specific term where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1770">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1770</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">SREATH THURSACHAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Aon sreath no co-dhiù dà shreath co-shìnte de thursachan an dèidh a chèile a-rèir an aon aiseil no sreath de dh'aisealan.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">STONE ROW</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-08-21T11:28:16</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">STONE ALIGNMENT</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1645" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1769" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1774" />
		<skos:scopeNote xml:lang="en">A single line, or two or more roughly parallel lines, of standing stones set at intervals along a common axis or series of axes.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1771">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1771</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CEARCALL THURSACHAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Pàtran cruinn no ugh-chruthach de chlachan dìreach, mar is trice nan seasamh leotha fhèin. Dh'fhaoidte gum bi barrachd air aon chearcall ann air pàtran co-mheadhanach.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">STONE CIRCLE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1645" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1772">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1772</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">CEARCALL  CEITHIR-THURSACHAN</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Ceithir tursachan a tha nan seasamh aig ceithir oiseanan de cheithir-cheàrnachan neo-riaghailteach. Faodaidh gu bheil barrachd air ceithir clachan ann ach 's iad an fheadhainn aig na h-oiseanan an fheadhainn as fhollaisiche.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">FOUR POSTER STONE CIRCLE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:altLabel xml:lang="en">FOUR POSTER</skos:altLabel>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1771" />
				<skos:scopeNote xml:lang="en">A setting of four upright stones standing at the corners of an irregular quadrilateral. May feature more than four stones, but those at the corners are always the most prominent.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1773">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1773</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">CEARCALL TURSA SÌNTE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Cearcall chlachan le aonan na laighe 's dà thursachan ri thaobh, mar is tric 's iadsan an fheadhainn as àirde sa chearcall.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">RECUMBENT STONE CIRCLE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1771" />
				<skos:scopeNote xml:lang="en">A stone circle which includes a prostrate stone flanked by two uprights, which are usually the tallest stones in the circle.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1730" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1739" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1769" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1774" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/2317" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/507322" />
		<skos:scopeNote xml:lang="en">A circular or oval setting of spaced, usually freestanding, upright stones. More than one circle may be present, arranged concentrically.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1774">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1774</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">LÀRACH THURSACHAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Pàtran aig a bheil co-dhiù dà thursa. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">STONE SETTING</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1645" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1769" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1770" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1771" />
		<skos:scopeNote xml:lang="en">An arrangement of two or more standing stones. Use specific term where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1775">
