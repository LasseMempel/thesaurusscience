		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1219</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TANCA-STÒRAIDH GAS</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Tanca-stòrais airson ceò-guail agus gasaichean eile.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GAS STORAGE TANK</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1215" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1220" />
		<skos:scopeNote xml:lang="en">Storage tank for coal gas and other types of gas.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1220">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1220</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TANCA GAS</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Tanca-stòrais so-ataichte airson gas, gu tric le tomhas a dh'innseas uiread a ghas a chaidh a chleachdadh. Airson tomhas gas, na cleachd ach MEIDHEADAIR-GAS.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GAS HOLDER</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1219" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1216" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1223" />
		<skos:scopeNote xml:lang="en">Expanding storage tank for gas, often includes a meter for measuring the amount used. For gas measurement only use GASOMETER.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1221">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1221</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FACTARAIDH GAS</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Aonad gnìomhachais, mar is trice ann am baile far a bheilear a' dèanamh gas à diofar tùsan mar ghual, ola is cairbid cailceim (acetylene) mar chonnadh dhan gnìomhachas no luchd-caitheimh àbhaisteach.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GAS WORKS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">GAS MILL</skos:altLabel>
		<skos:altLabel xml:lang="en">GASWORKS</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1215" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1216" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1217" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1218" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1222" />
		<skos:scopeNote xml:lang="en">An industrial unit, usually situated in a city or town, concerned with the manufacture of gas from sources including coal, oil and calcium carbide (acetylene), for use as fuel by industrial or domestic consumers.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1222">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1222</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FACTARAIDH  GAS</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Ionad far a bheilear a' dèanamh gas a-rèir dòigh Lurgi. Thèid smùid agus ogsaidean a stealladh a-steach do ghineadair gas sa bheil gual fo bhrùthadh àrd. Faodaidh gum bi an gual seo nas miosa na an gual a chleachdar ann an saothrachadh gas àbhaisteach.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GASIFICATION PLANT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1215" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1221" />
		<skos:scopeNote xml:lang="en">A facility for the production of gas by means of the Lurgi Process. Steam and oxygen under high pressure are introduced into a gasifier containing coal, which may be of lower quality than that required by conventional gas production.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1223">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1223</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">GASOMEATAIR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Acainn a thomhaiseas co mheud gas a tha ann. Airson rud a stòras gas, cleachd TANCA-ATACHAIDH GAS.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GASOMETER</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1215" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1220" />
		<skos:scopeNote xml:lang="en">An installation for measuring the volume of gas. For gas storage use GAS HOLDER.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1225">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1225</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">IONAD CRUTHACHADH DEALAIN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalaichean, làraichean is structaran a tha co-cheangailte ri gintinn dealain.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ELECTRICITY PRODUCTION SITE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1210" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1226" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500560" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500561" />
		<skos:scopeNote xml:lang="en">Buildings, sites and structures associated with the production of electricity.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1226">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1226</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">STÈISEAN-CUMHACHD</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach no grunn thogalaichean no structaran far a bheilear a' gintinn cumhachd, gu h-àraid cumhachd dealain no cumhachd mheacanaigeach. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">POWER STATION</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">ELECTRICITY GENERATING STATION</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1225" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1227" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1228" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1229">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1229</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">STÈISEAN-CUMHACHD THRÈANAICHEAN FO THALAMH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Stèisean-cumhachd a tha a' gintinn cumhachd airson rèile fon talamh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">SUBWAY POWER STATION</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1226" />
				<skos:scopeNote xml:lang="en">A power station which provides power for an underground railway.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500921" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502143" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1236" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500560" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500612" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500673" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500880" />
		<skos:scopeNote xml:lang="en">A building or set of buildings and structures where power, especially electrical or mechanical, is generated. Use more specific term where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1227">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1227</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">STÈISEAN-CUMHACHD HAIDREOLAIG</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Aitreabh thogalaichean is structaran far a bheilear a' gintinn is a' stòradh cumhachd haidreolaig.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HYDRAULIC POWER STATION</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1226" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1238" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1239" />
		<skos:scopeNote xml:lang="en">A complex of buildings and structures where hydraulic power is generated and stored.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
