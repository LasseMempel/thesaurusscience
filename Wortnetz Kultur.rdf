		<skos:prefLabel xml:lang="de">Asylbewerber</skos:prefLabel>
		<skos:prefLabel xml:lang="en">asylum seeker</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk009864"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk018340"/>
