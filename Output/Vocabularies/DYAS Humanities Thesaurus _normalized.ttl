@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1006> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/669> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Elliptical clauses"@en ;
    skos:scopeNote "Elliptical clauses are a type of dependent or subordinate clause that is missing a word or words. Often, the missing part is a verb or verb phrase. While elliptical clauses are acceptable to use, they can sometimes cause confusion for writers and readers, especially when the sentence ends with a pronoun."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1010> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/378> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Mixed media"@en ;
    skos:scopeNote "Any combination of a variety of materials plus the associated techniques, used in the making of a single work of art. In Printmaking, use when more than one technique, such as both etching and engraving, are used in one print. For the painting technique of laying oil paint glazes over tempera paint or tempera paint glazes over oil paint, use \"Mixed technique\"."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1012> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Feltmakers"@en ;
    skos:scopeNote "Οι τεχνίτες που ασχολούνταν με την κατασκευή του κετσέ, δηλαδή του συμπιεσμένου μαλλιού προβάτου, το οποίο χρησιμοποιούνταν στο εσωτερικό του σαμαριού."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1014> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Tinners"@en ;
    skos:scopeNote "Craftsmen engaged in the tin coating of copper utensils. Most often they were itinerant craftsmen who would galvanize and polish copper utensils, such as cauldrons, spoons, forks, etc"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1016> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Laundresses"@en ;
    skos:scopeNote "Women professionally engaged in washing and ironing clothes. They worked mainly in the homes of wealthy families, as laundry was one of the most tedious housework."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1018> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/456> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Paperboys"@en ;
    skos:scopeNote "Itinerant newspaper and magazine sellers. They obtained the newspapers from the agency and wandered around in the streets and busy shops (cafes, taverns, etc) of the neighborhood, on foot or by bicycle, the newspapers under their armpit. Several of them had a permanent hangout in some corner. In the past, they were mostly children or adolescents."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1019> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Boatmen"@en ;
    skos:scopeNote "Owners and / or operators of boats. They transported people to the ships that did not dock at port. They helped passengers sit on the stern, while placing the luggage on the bow. Then, they collected the fares from the passengers, for themselves and their luggage. The transaction usually involved some haggling."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1029> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Coachmen"@en ;
    skos:scopeNote "Professional drivers of carts, trucks or coaches."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/103> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Polygamy"@en ;
    skos:scopeNote "The socially accepted condition of a person being engaged in marriage with two, or more, partners. In such instances, a man may have multiple wives (polygyny), or vice versa (polyandry)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1035> a skos:Concept ;
    skos:altLabel "Arcadocypriot dialect"@en,
        "Southern Achaean dialect"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/532> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Arcadian dialect"@en ;
    skos:scopeNote "Arcadian dialect was an ancient Greek dialect spoken in Arcadia in the central Peloponnese and in Cyprus. Its resemblance to Mycenaean Greek, as it is known from the Linear B corpus, suggests that Arcadocypriot is its descendant. Proto-Arcadocypriot (~1200 BC) is supposed to have been spoken by Achaeans in the Peloponnese before the arrival of Dorians; for this reason it is also called southern Achaean. The isoglosses of the Cypriot and Arcadian dialects testify that the Achaeans had settled in Cyprus. The establishment happened before 1100 B.C. With the arrival of Dorians in the Peloponnese, a part of the population moved to Cyprus and the rest was limited to the Arcadian mountains. After the collapse of the Mycenaean world, communication was disrupted and Cypriot was differentiated from Arcadian. It was written up to the 3rd century B.C. with Cypriot syllabary. Arcadian kept many characteristics of Mycenaean, that had disappeared in Attic and Ionic, such as the /w/ sound (digamma)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1038> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Innkeepers"@en ;
    skos:scopeNote "The owners of an inn called hani, in which travellers could rest overnight. The innkeepers charged travellers for food, accommodation, feeding their animals, and any other needs. Innkeepers also provided travellers with information on their journey’s route."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1048> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Sharpeners"@en ;
    skos:scopeNote "Craftsmen skilled in the sharpening of knives, scissors and other cutting tools."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1051> a skos:Concept ;
    skos:altLabel "Coal men"@en,
        "Colliers"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Charcoal makers"@en ;
    skos:scopeNote "Craftsmen who manufacture and distribute charcoal."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1052> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cart manufacturers"@en ;
    skos:scopeNote "Craftsmen specialized in the construction of carts."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1055> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Well drillers"@en ;
    skos:scopeNote "Workers involved in drilling wells. Because of increased water and irrigation needs, they opened private wells in addition to the communal ones."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1058> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/289> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Field guards"@en ;
    skos:scopeNote "Field guards responsible for the safety of agricultural land and production."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1059> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/456> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Chestnut sellers"@en ;
    skos:scopeNote "Outdoor chestnut salesmen, who bake them on site in a special portable stove. Seasonal job that begins in the autumn."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1061> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/378> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Silkscreen printing"@en ;
    skos:scopeNote "Printing technique. The printing of the work is made by pressing the ink on the undercoat by means of a spatula and throughout the permeable areas of a net. In comparison with other methods the Silkscreen printing allows the emplacement of a thicker layer of ink by one and only application. Its characteristic features are usely the thick coverage of the ink and the net-like texture with the serrated edges."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1062> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/542> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Heterodiegetic narrator"@en ;
    skos:scopeNote "Narrative technique in which the narrator is not a character in the story, he is absent from the narrated world."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1063> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/618> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Videos"@en ;
    skos:scopeNote "Artworks that employ video technology, especially videotapes."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1066> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/378> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Automatism"@en ;
    skos:scopeNote "A method of painting or drawing in which conscious control is suppressed, allowing the subconscious to take over."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/107> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/834> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Abstract Art"@en ;
    skos:scopeNote "A term which can generally be applied to any non-representational art, but which is more specifically used, from the early 20th century onwards, to describe painting and sculpture which are deliberately non-representational."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1074> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/289> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Porters"@en ;
    skos:scopeNote "Persons engaged in carrying baggage or cargo without beasts of burden or other means of transport."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1075> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/378> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Fresco-secco painting"@en ;
    skos:scopeNote "Technique of painting a mural in which an aqueous pigment slurry is applied to dry plaster. Fresco secco was sometimes applied over buon fresco painted regions to correct mistakes or to add details."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1076> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Shoeshiners"@en ;
    skos:scopeNote "Itinerant shoe polishers. Their craft flourished when people walked on dirt roads and shoes got dirty. The polishers had a wooden box in front of them, with brushes and varnishes of different colors hanging from it."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1080> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/700> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Polity (Aristotelian philosophy)"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1086> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/618> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Constructions"@en ;
    skos:scopeNote "Artworks created by combining parts or elements."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1088> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Muleteers"@en ;
    skos:scopeNote "Professionals who transported loads of goods or travelers with animals or animal-driven vehicles for a fee."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/109> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/26> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Trade Unions"@en ;
    skos:scopeNote "Political organizations the are created by workers and employees who have the same -or a similar- professional activity and/or the same employer, and aim at defending and promoting their members' rights and interests as to their salaries and their overall employment conditions."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1096> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/618> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Posters"@en ;
    skos:scopeNote "Developed in the 19th century, posters are printed designs of images and words on paper, produced in large numbers for the purposes of publicizing their subject through visual display. Their evolution was closely linked to the introduction of lithography. With the advent of colour lithography they reached their apogee as an art form. Most modern posters are produced by photolithographic means."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1097> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/475> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Coups"@en ;
    skos:scopeNote "Violent attempts to overthrow a government and to seize power by political and/or military groups. Coups, as a rule, are not accompanied by collective action."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1102> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Darners"@en ;
    skos:scopeNote "The women who are professionally engaged in darning."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1105> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Sieve manufacturers"@en ;
    skos:scopeNote "Craftsmen who manufacture and/ or sell sieves."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1107> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/378> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Mural-painting"@en ;
    skos:scopeNote "The activity of composing and executing painted decorations or scenes that dominate a wall or ceiling surface."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1108> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/618> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Egg tempera paintings"@en ;
    skos:scopeNote "Artworks produced in tempera paint using egg as its vehicle, traditionally the yolk only, in other cases, the whole egg."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1109> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/708> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Social reforms"@en ;
    skos:scopeNote "Reforms that induce changes in the institutional status of social groups, classes and strata within a state, in their position in respect to state authority, and in their relationships to each other."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1111> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/372>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/412> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Galleys"@en ;
    skos:scopeNote "Long and narrow rowing warships or cargo ships, which dominated Mediterranean marine life from the Middle Ages until the 17th century. Their length/width ratio was about 8/1. Their moving power was provided by the numerous oarsmen lined up along the length of the hull, but they also had sails for additional propelling power. War galleys were equipped with fire guns at the prow."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1112> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/634> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Holospondeus"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1117> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/456> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Milkmen"@en ;
    skos:scopeNote "Peddlers who sold milk and other dairy products (most commonly yogurt) door to door. They worked mainly in towns and not in villages, where producers could sell their fresh milk directly. Their means of transport were beasts of burden (donkeys or mules) and later bicycles or motorbikes."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1131> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/933> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Typologie (Linguistik)"@de,
        "Typology (Linguistics)"@en ;
    skos:scopeNote "Linguistic typology is a subfield of linguistics that studies and classifies languages according to their structural and functional features. Its aim is to describe and explain the common properties and the structural diversity of the world's languages. It includes three subdisciplines: qualitative typology, which deals with the issue of comparing languages and within-language variance; quantitative typology, which deals with the distribution of structural patterns in the world’s languages; and theoretical typology, which explains these distributions."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1132> a skos:Concept ;
    skos:altLabel "Antithetical clauses"@en,
        "Contrastive clauses"@en,
        "Oppositional clauses"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1079> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Adversative clauses"@en ;
    skos:scopeNote "Adversative clauses express an event or situation that is opposite to what of the main clause. The adversative conjunctions are while or whereas implying opposition or contrast. But and although are also adversative conjunctions introducing adversative clauses."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1133> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/800> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Multiple internal focalization"@en ;
    skos:scopeNote "Narrative way in which the same story is presented from the points of view of multiple characters in the story. Using multiple internal focalization, the same story can be repeatedly told from different perspectives by the story's characters."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1135> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/776> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Objective dative"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/114> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/834> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Folk Art"@en ;
    skos:scopeNote "The art, handicrafts, and decorative ornament produced by people who have had no formal art training but have an established tradition of styles and craftsmanship. A country or region may have a characteristic folk art."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1145> a skos:Concept ;
    skos:altLabel "Genitive of the whole"@en,
        "Wholative genitive"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/958> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Partitive genitive"@en ;
    skos:scopeNote "It is the genitive case which represents the whole or set of which the head of a partitive phrase is a portion or subset. Also, it can be a use or instance of such a genitive case."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1146> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/800> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Interior monologue"@en ;
    skos:scopeNote "Narrative technique which consists of the direct, immediate presentation of the unspoken thoughts of a character without any intervening narrator."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1150> a skos:Concept ;
    skos:altLabel "Base"@en,
        "Root"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/849> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Stamm (Linguistik)"@de,
        "Stem (Linguistics)"@en ;
    skos:scopeNote "A stem is a part of a word. The term is used with slightly different meanings.In one usage, a stem is a form to which affixes can be attached. Thus, in this usage, the English word improvements contains the stem 'improve', to which the derivational suffix '-ment' is attached to form a new stem 'improvement', to which the inflectional suffix '-s' is attached. In a variant of this usage, the root of the word (in the example, improve) is not counted as a stem."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1151> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/933> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Psycholinguistik"@de,
        "Psycholinguistics"@en ;
    skos:scopeNote "Psycholinguistics or psychology of language is the study of the psychological and neurobiological factors that enable humans to acquire, use, comprehend and produce language. Initial forays into psycholinguistics were largely philosophical or educational schools of thought, due mainly to their location in departments other than applied sciences (e.g., cohesive data on how the human brain functioned). Modern research makes use of biology, neuroscience, cognitive science, linguistics, and information science to study how the brain processes language, and less so the known processes of social sciences, human development, communication theories and infant development, among others."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1161> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1087> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Oligarchy based on property assessments"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1163> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/377> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Carthaginian aristocracy"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1167> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/804> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Gesellschaftskomödie"@de,
        "Comedy of manners"@en ;
    skos:scopeNote "Comic genre aiming at flouting situations, behaviours or practices of a certain social group or period. Its purpose is to correct the vices of humans by using satire and mockery."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1169> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1025> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cappadocian dialect"@en ;
    skos:scopeNote "Cappadocian Dialect is a mixed language spoken in Cappadocia (Central Turkey) and areas of northern Greece. The language originally diverged from the Medieval Greek of the Byzantine Empire. The Cappadocian Greek rapidly shifted to Standard Modern Greek with plenty of Turkish words and morphosyntactic phenomena. It is related with the Pontic dialect and is believed to have been isolated from the rest of the Greek Language during the Ottoman domination as the various ethnicities (Greeks or others) who lived in Asia Minor gradually began to lose some language features, which have been replaced by the strong language of the country, Turkish."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1173> a skos:Concept ;
    skos:altLabel "Descriptive genitive"@en,
        "Genitive of measure"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/958> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Attributive genitive"@en ;
    skos:scopeNote "This use describes an attribute or quality to the head noun. It can be thought of as a simple adjective modifying the head noun, but with stronger force and emphasis. If it can be turned into an attributive adjective, then it is probably this use of the genitive."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1175> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/730> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Scene (Narratology-Methods)"@en ;
    skos:scopeNote "The narrative technique in which story-time and narrative-time are conventionally considered identical (this is usually the case in dialogue). Narrative time corresponds to the story's time. Dialogue is often regarded as the best example of scene: the narrator virtually ‘disappears’ here."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1179> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/740> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Pragmatik"@de,
        "Pragmatics"@en ;
    skos:scopeNote "Pragmatics is a subfield of linguistics and semiotics that studies the ways in which context contributes to meaning. Pragmatics encompasses speech act theory, conversational implicature, talk in interaction and other approaches to language behavior in philosophy, sociology, linguistics and anthropology. Unlike semantics, which examines meaning that is conventional or \"coded\" in a given language, pragmatics studies how the transmission of meaning depends not only on structural and linguistic knowledge (e.g., grammar, lexicon, etc.) of the speaker and listener, but also on the context of the utterance, any pre-existing knowledge about those involved, the inferred intent of the speaker, and other factors. In this respect, pragmatics explains how language users are able to overcome apparent ambiguity, since meaning relies on the manner, place, time etc. of an utterance."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1182> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1087> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Oligarchy based on familial succession"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1187> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/809> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Accusative of relation"@en ;
    skos:scopeNote "The nominal phrase in the accusative, which expresses the thing in respect to which the scope of the concept of the designated adjective or substantive is restricted."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1190> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/933> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Sprachdidaktik"@de,
        "Language teaching"@en ;
    skos:scopeNote "This branch of linguistics is about teaching people to speak and understand a foreign language or to master better a mother language."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1194> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2406> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Graphic Arts"@en ;
    skos:scopeNote "Arts that produce two-dimensional images that are shaped through the drawing using the techniques of printing mainly on paper but also on panel, canvas or any other material support.&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1197> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/874> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Social revolutions"@en ;
    skos:scopeNote "Revolutions that are accompanied with the eruption of rebellions by subaltern social groups aiming at the seizure of power and the radical change of socio-political and economic structures."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1203> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/968> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Kingship of heroes"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1204> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/958> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Genitive of material"@en ;
    skos:scopeNote "This use of genetive shows the substance of which a noun is composed."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1206> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/933> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Korpuslinguistik"@de,
        "Corpus linguistics"@en ;
    skos:scopeNote "Corpus linguistics is the study of language as expressed in samples (corpora) of \"real world\" text. This method represents a digestive approach to deriving a set of abstract rules by which a natural language is governed or else relates to another language. Originally done by hand, corpora are now largely derived by an automated process."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1209> a skos:Concept ;
    skos:altLabel "Elective tyranny"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/670> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "The rule of Aesymnetes"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1212> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1090> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Historisches Drama"@de,
        "Historical drama"@en ;
    skos:scopeNote "Subdivision of drama that draws on history in order to throw light on events or people that determined the course of a nation or a certain period. In ages of crisis or major developments, didactics and the enhancement of national identity and continuity of peoples play a prominent role, while during the 20th century playwrights exploited historical material to trace its relations to the contemporary social reality and to delve into philosophical or existential questions."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1213> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/377> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Spartan aristocracy"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1215> a skos:Concept ;
    skos:altLabel "Diachronic Linguistics"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/933> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Historische Sprachenwissenschaft"@de,
        "Historical linguistics"@en ;
    skos:scopeNote "Historical linguistics, also called diachronic linguistics, is the scientific study of language change over time. Principal concerns of historical linguistics include: a) to describe and account for observed changes in particular languages, b) to reconstruct the pre-history of languages and to determine their relatedness, grouping them into language families (comparative linguistics), c) to develop general theories about how and why language changes, d) to describe the history of speech communities, and e) to study the history of words, i.e. etymology"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1219> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1119> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Aristocracy of wealth and merit"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1220> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/730> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Summary (Narratology-Methods)"@en ;
    skos:scopeNote "A narrative technique in which the story-time is longer than the narrative-time. Most retrospective sections belong to this type of narration. One of the most important and frequent uses of the summary is to convey rapidly a sketch of past life."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1222> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/785> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Complement clauses"@en ;
    skos:scopeNote "Complement clauses are clauses introduced by a complementizer like that or whether. A complement clause is attached to a preceding noun, adjective or verb. In some cases the complementizer may be optionally omitted."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1223> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/968> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Spartan kingship"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1224> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/958> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Objective genitive"@en ;
    skos:scopeNote "The nominal phrase in the genitive case, which expresses the object of the verbal action, denoted by the identified verbal name (noun or adjective)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1226> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/730> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ellipsis (Narratology-Methods)"@en ;
    skos:scopeNote "The narrative device of omitting a portion of the sequence of events, and of taking a chronological leap to a future point of the plot. With this tecnique the plot advancement is accelerated."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1228> a skos:Concept ;
    skos:altLabel "Combining form"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/849> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Bound stem"@en ;
    skos:scopeNote "A bound stem is a stem which cannot occur as a separate word apart from any other morpheme (such as -logy, tele-, -poiea)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1232> a skos:Concept ;
    skos:altLabel "Semasiology"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/740> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Semantik"@de,
        "Sematics"@en ;
    skos:scopeNote "Semantics is the study of meaning. It focuses on the relation between signifiers, like words, phrases, signs, and symbols, and what they stand for. Linguistic semantics is the study of meaning that is used for understanding human expression through language. Other forms of semantics include the semantics of programming languages, formal logics, and semiotics. In international scientific vocabulary semantics is also called semasiology."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1233> a skos:Concept ;
    skos:altLabel "Clauses of consequence"@en,
        "Consecutive clauses"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1079> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Result clauses"@en ;
    skos:scopeNote "Consecutive clauses are also called clauses of consequence or result clauses. They express an (actual or potential) consequence or result of the previous clause: so that/with the result that. Two different constructions occur: hṓste is combined either with finite verb forms, i.e., with the tense and mood of independent clauses, or with infinitive or accusative plus infinitive."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1234> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/933> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Neurolinguistik"@de,
        "Neurolinguistics"@en ;
    skos:scopeNote "Neurolinguistics is the study of the neural mechanisms in the human brain that control the comprehension, production, and acquisition of language. As an interdisciplinary field, neurolinguistics draws methodology and theory from fields such as neuroscience, linguistics, cognitive science, neurobiology, communication disorders, neuropsychology, and computer science. Researchers are drawn to the field from a variety of backgrounds, bringing along a variety of experimental techniques as well aswidely varying theoretical perspectives. Much work in neurolinguistics is informed by models in psycholinguistics and theoretical linguistics, and is focused on investigating how the brain can implement the processes that theoretical and psycholinguistics propose are necessary in producing and comprehending language. Neurolinguists study the physiological mechanisms by which the brain processes information related to language, and evaluate linguistic and psycholinguistic theories, using aphasiology, brain imaging, electrophysiology, and computer modeling."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1238> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/785> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Indirect question clauses"@en ;
    skos:scopeNote "Indirect question (or indirect interrogative) clauses are questions inside a main clause or following a main clause. The same tense must be kept, and also the indicative mood (unless it is a deliberative question in subjunctive, in which case subjunctive tense must be kept). If, for instance, the original question is formulated in future tense, the verb of the indirect question will be in the future tense, regardless of the tense of the main clause. As in the cases of reported speech, the oblique optative can be used if the introductory verb is in a secondary tense, creating the so called secondary clause."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1242> a skos:Concept ;
    skos:altLabel "Phonematics"@en,
        "Phonemics"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/740> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Phonologie"@de,
        "Phonology"@en ;
    skos:scopeNote "Phonology is a branch of linguistics concerned with the systematic organization of sounds in languages. It has traditionally focused largely on the study of the systems of phonemes, but it may also cover any linguistic analysis either at a level beneath the word (including syllable, onset and rime, articulatory gestures, articulatory features, mora, etc.) or at all levels of language where sound is considered to be structured for conveying linguistic meaning."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1244> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1079> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Concessive clauses"@en ;
    skos:scopeNote "Concessive clauses are clauses which begin with 'although' or 'even though' and which express an idea that suggests the opposite of the main part of the sentence. 'Despite' and 'in spite of' do not introduce a concessive clause. They are rather followed by a noun or a verb+ing form."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1249> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/921> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Mob rule (Aristotelian philosophy)"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1254> a skos:Concept ;
    skos:altLabel "Clauses of time"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1079> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Temporal clauses"@en ;
    skos:scopeNote "Temporal clauses are introduced by particles which are almost all of relative origin. They are construed like other relative clauses, except where they have developed into special idiomatic constructions. They begin with 'when', 'whenever', 'while', 'as', 'since', 'after', 'before', 'until', 'as soon as', 'once'. The time clause may come before or after the main clause with no change in meaning. If they refer to the future, the Simple Present is used in the time clause, and shall/will + infinitive/perfect infinitive or modal + infinitive, or imperative is used in the main clause."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1256> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1025> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Grico dialect"@en ;
    skos:scopeNote "Griko, sometimes spelled Grico in Salento is the dialect of Italiot Greek spoken by Griko people in Salento and in Calabria of Southern Italy. Some Greek linguists consider it to be a Modern Greek dialect and often call it Katoitaliótika or Grekanika. Griko and Standard Modern Greek are partially mutually intelligible."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1259> a skos:Concept ;
    skos:altLabel "Advance mention"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/852> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Seed"@en ;
    skos:scopeNote "A narrative technique that introduces an apparently irrelevant information in the story, the significance of which becomes clear only after it is first mentioned."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/126> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/31> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ethnomethodology"@en ;
    skos:scopeNote "Method of analysing the ways in which individuals perceive and describe the social milieu and their experiences within it. Ethnomethodology interprets the performative connotations of linguistic expressions and focuses on the cultural usage of linguistic categories."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1260> a skos:Concept ;
    skos:altLabel "Genitive of belonging"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/958> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Possessive genitive"@en ;
    skos:scopeNote "Possessive genitive shows the ideas of ownership or possession. To see if it is the genitive of possession, try substituting the word ‘of’ with ‘belonging to’ or ‘possessed by’. However, this use does not have to indicate actual, physical ownership of some property. It may be a broadly defined type of ownership. This is a very common use of the genitive. A possessive pronoun will often be used in the genitive case to show possession."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1263> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/849> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Allomorph"@de,
        "Allomorph"@en ;
    skos:scopeNote "Allomorphs are defined as the different varieties of the same morpheme, which share such lexical information as semantic representation and argument structure, but differ unpredictably and arbitrarily in their phonological form and in the morphological environments in which they occur."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1264> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/958> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Genitive of cause"@en ;
    skos:scopeNote "This use of the genitive with verbs of emotion shows the cause or origin of that emotion."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1266> a skos:Concept ;
    skos:altLabel "Narrateur autodiégétique"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/738> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Autodiegetic narrator"@en ;
    skos:scopeNote "Narrative technique in which the narrator is also present as the protagonist in the story."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1267> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1025> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cypriot dialect"@en ;
    skos:scopeNote "Cypriot Greek is the variety of Modern Greek that is spoken by the majority of the Cypriot populace and Greek Cypriot diaspora. It is a markedly divergent variety as it differs from Standard Modern Greek in various aspects of its lexicon, phonetics, phonology, morphology, syntax and even pragmatics, not only for historical reasons, but also because of geographical isolation, different settlement patterns, and extensive contact with typologically distinct languages."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1269> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/740> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Phonetik"@de,
        "Phonetics"@en ;
    skos:scopeNote "Phonetics is a branch of linguistics that comprises the study of the sounds of human speech. It is concerned with the physical properties of speech sounds or signs (phones): their physiological production, acoustic properties, auditory perception, and neurophysiological status. Phonology, on the other hand, is concerned with the abstract, grammatical characterization of systems of sounds or signs."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1271> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/740> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Syntax"@de,
        "Syntax"@en ;
    skos:scopeNote "In linguistics, syntax is the set of rules, principles, and processes that govern the structure of sentences and utterances in a given language. The term syntax is also used to refer to the study of such principles and processes and to the effort of discovering the syntactic rules common to all languages."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1274> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/958> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Genitive of comparison"@en ;
    skos:scopeNote "This use of the genitive almost always comes after a comparative adjective (like ‘more’, ‘less’, ‘greater’, etc.). The customarily used ‘of’ translated with the genitive should instead be translated ‘than’. It is a relatively common use of the genitive case."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1275> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1025> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Tsakonian dialect"@en ;
    skos:scopeNote "Tsakonian is a Modern Greek language which is both highly divergent from other spoken varieties of Modern Greek and, from a philological standpoint, is also linguistically classified separately from them. It is spoken in the Tsakonian region of the Peloponnese, Greece. Tsakonian descends from Doric, which was an Ancient Greek language on the Western branch of Hellenic languages, and it is its only living descendant[(along with the debatable Maniot dialect of Modern Greek). Although Tsakonian is treated as a dialect of Modern Standard Greek, some compendia treat it as a separate language, since Modern Standard Greek descends from Ionic and Attic which belong to the Eastern branch of the Hellenic languages, while Tsakonian (as a descendant of Doric) is the sole surviving member of the Western branch."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1277> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/800> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Variable internal focalization"@en ;
    skos:scopeNote "Narrative way in which the story events are told from the point of view of a variety of characters in the story from character to character consecutively (e.g. <em>Madame Bovary</em>)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1278> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/740> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Morphologie"@de,
        "Morphology"@en ;
    skos:scopeNote "In linguistics, morphology is the identification, analysis, and description of the structure of a given language's morphemes and other linguistic units, such as root words, affixes, parts of speech, intonations and stresses, or implied context. In contrast, morphological typology is the classification of languages according to their use of morphemes, while lexicology is the study of those words forming a language's wordstock."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1283> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/933> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Forensische Linguistik"@de,
        "Forensic Linguistics"@en ;
    skos:scopeNote "Forensic linguistics, legal linguistics, or language and the law, is the application of linguistic knowledge, methods and insights to the forensic context of law, language, crime investigation, trial, and judicial procedure. It is a branch of applied linguistics.There are principally three areas of application for linguists working in forensic contexts: understanding language of the written law, understanding language use in forensic and judicial processes, and the provision of linguistic evidence."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1298> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/874> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "National liberation revolutions"@en ;
    skos:scopeNote "Revolutions that take form through the mobilization of broad social groups, politically and ideologically conceived as a nation, and aim at overthrowing imperial or colonial structures of power and establishing nation states."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1303> a skos:Concept ;
    skos:altLabel "Clauses of Reason"@en,
        "Clauses of cause"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1079> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Adverb clauses of reason"@en ;
    skos:scopeNote "The adverb clauses of reason indicate why the particular action of the verb is taken. They are introduced by the subordinating conjunctions because, as, since and that. Note that a because-clause can stand alone. As and since-clauses cannot be used like this."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1305> a skos:Concept ;
    skos:altLabel "Genitive of price"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/958> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Genitive of value"@en ;
    skos:scopeNote "Shows the value (typically monetary) of an object.<br />"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1307> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1025> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Pontic dialect"@en ;
    skos:scopeNote "<br />Pontic Greek is a Greek dialect originally spoken in the Pontus area on the southern shores of the Black Sea, northeastern Anatolia, the Eastern Turkish/Caucasus province of Kars, southern Georgia and today mainly in northern Greece. Its speakers are referred to as Pontic Greeks or Pontian Greeks. The linguistic lineage of Pontic Greek stems from Ionic Greek via Koine and Byzantine Greek, and contains influences from Georgian, Russian, Turkish and Armenian. The Ophitic variant of Pontic Greek in eastern Turkey has been identified as the living language that is closest to Ancient Greek."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1308> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/785> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Relative noun clauses"@en ;
    skos:scopeNote "Relative noun clauses are dependent clauses that act like a noun. They serve the exact same function as a noun. They can be a subject, object, or complement. Like the adverb clause, a noun clause usually begins with a relative pronoun. However, it can also begin with a subordinate conjunction. A noun clause will not stand alone. Because a noun clause works as a noun, it can be used many different ways in a sentence. It will begin with a relative pronoun or relative adverb. These would include 'who,' 'whom,' 'whose,' 'that,' and 'which' for a pronoun and 'when,' 'where,' or 'why' for an adverb. Looking for these signal words can help you identify this type of clause."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/131> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/225> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Fishing"@en ;
    skos:scopeNote "The process of capturing living creatures from water ecosystems, with an aim to meet dietary needs."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1311> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/852> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:scopeNote "The narrative technique in which the narration doesn’t start at the beginning but \"in media res\", that is at a crucial point in the middle of the action."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1315> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/958> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Subjective genitive"@en ;
    skos:scopeNote "The genitive substantive functions semantically as the subject of the verbal idea implicit in the head noun. To substantiate this condition, try to turn it into a sentence with the noun in the genitive as the subject."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1316> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/785> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Volitional clauses"@en ;
    skos:scopeNote "Volitional clauses are noun sentences introduced with the conjunction 'to' as a complement to the meaning of a verb or, sometimes, of a name. They follow the verbs with austere, linguistic, prohibitive, aesthetic meaning and are used as the subject or as the object of specific verbal categories."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1324> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/933> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Textlinguistik"@de,
        "Text linguistics"@en ;
    skos:scopeNote "Text linguistics is a branch of linguistics that deals with texts as communication systems. Its original aims lay in uncovering and describing text grammars. The application of text linguistics has, however, evolved from this approach to a point in which text is viewed in much broader terms that go beyond a mere extension of traditional grammar towards an entire text. Text linguistics takes into account the form of a text, but also its setting, i.e. the way in which it is situated in an interactional, communicative context. Both the author of a written or spoken text as well as its addressee are taken into consideration in their respective (social and/or institutional) roles in the specific communicative context. In general it is an application of discourse analysis at the much broader level of text, rather than just a sentence or word."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1326> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/800> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Constant internal focalization"@en ;
    skos:scopeNote "Narrative way in which everything is told from the point of view of a single character in the story (e.g. Dr. Watson in most Sherlock Holmes stories)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1328> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/785> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Hesitational clauses"@en ;
    skos:scopeNote "Hesitational clauses are introduced with the hesitant conjuctions like 'not to', or it expresses some fear, hesitation about something unpleasant that may or may not happen. These clauses depend on verbs that express fear or anxiety, and they are used as an object, as an explanation and as a subject (rarely)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1337> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1025> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cretan dialect"@en ;
    skos:scopeNote "The Cretan Greek is normally considered to be merely a dialect of the Greek language that is spoken by the people living in Crete and the many thousands who make up the diaspora. Many dialectologists suggest that in Crete, just like many other islands in Greece, there are only pronunciation differences and different words or expressions compared to standard Greek and that these can vary within the island of Crete itself. Today the Cretan dialect is rarely used in writing. However, Cretan Greeks normally communicate with each other in speech using this dialect. Cretan does not differ greatly from other Greek dialects or from Standard Greek, leading to a fairly high level of mutual intelligibility. It was believed that Cretan could have become the basis of Modern Standard Greek, given its flourishing history and achievements. According to them, this process was interrupted by the Ottoman conquest in 1669."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1340> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/968> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Absolute kingship"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1341> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/958> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Genitive of content"@en ;
    skos:scopeNote "The genitive substantive specifies the contents of the word to which it is related. This word may be a noun, an adjective, or a verb."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1343> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1079> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Conditional clauses"@en ;
    skos:scopeNote "Conditional sentences are sentences expressing factual implications, or hypothetical situations and their consequences. They are so called because the validity of the main clause of the sentence is conditional on the existence of certain circumstances, which may be expressed in a dependent clause or may be understood from the context. Different types of conditional sentences (depending largely on whether they refer to a past, present or future time frame) require the use of particular verb forms (tenses and moods) to express the condition and the consequence. The most common patterns are referred to as first conditional, second conditional and third conditional; there is also a zero conditional and mixed conditional."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1346> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1079> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Relative adverbial clauses"@en ;
    skos:scopeNote "The relative adverbs 'where', 'when' and 'why' can be used to join sentences or clauses. They replace the more formal structure of preposition, which is used to introduce a relative clause. Relative clauses cannot stand alone. These are incomplete thoughts and should be joined to an independent clause to become a complete sentence.<br />"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1350> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1332> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Zirkumfix"@de,
        "Circumfix"@en ;
    skos:scopeNote "A circumfix is an affix which has two parts, one placed at the start of a word, and the other at the end. Circumfixes contrast with prefixes, attached to the beginnings of words; suffixes, attached at the end; and infixes, inserted in the middle."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1356> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1296> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Computerlexicographie"@de,
        "Computational lexicography"@en ;
    skos:scopeNote "Computational lexicology is that branch of computational linguistics, which is concerned with the use of computers in the study of lexicon. It has been more narrowly described by several researchers as the use of computers in the study of machine-readable dictionaries. It is distinguished from computational lexicography, which more properly would be the use of computers in the construction of dictionaries, though some researchers have used computational lexicography as synonymous."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1361> a skos:Concept ;
    skos:altLabel "Complete flashback"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1180> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Complete analepsis"@en ;
    skos:scopeNote "A flashback which begins in the past and carries the reader right up to the moment at which the principal narrative began. In effect the two narratives flush fit against each other."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1368> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1296> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Computersyntax"@de,
        "Computational Syntax"@en ;
    skos:scopeNote "Computational syntax deals with central methods and techniques in the development of formal grammatical approaches to natural language, such as: phrase-structure grammar, categorial grammar and feature-based grammar formalisms. It also includes an overview of syntactic constructions and how they are to be described and implemented in a formal grammar."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1374> a skos:Concept ;
    skos:altLabel "Einfügung"@de ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1332> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Infix"@de,
        "Infix"@en ;
    skos:scopeNote "A word element (a type of affix) that can be inserted within the base form of a word (rather than at its beginning or end) to create a new word or intensify meaning."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1375> a skos:Concept ;
    skos:altLabel "External flashback"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1180> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "External analepsis"@en ;
    skos:scopeNote "A flashback to events that took place outside the time span of the main story."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1386> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1174> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Descriptive pause"@en ;
    skos:scopeNote "The narrative technique in which the story is interrupted to make room exclusively for the narrator's static descriptions. Descriptive pause occurs when time stands still in the story while description carries on at length."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1392> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1296> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Computersemantik"@de,
        "Computational Semantics"@en ;
    skos:scopeNote "Computational semantics is the study of how to automate the process of constructing and reasoning with meaning representations of natural language expressions. It consequently plays an important role in natural language processing and computational linguistics. Some traditional topics of interest are: construction of meaning representations, semantic underspecification, anaphora resolution, presupposition projection, and quantifier scope resolution. Methods employed usually draw from formal semantics or statistical semantics. Computational semantics has points of contact with the areas of lexical semantics (word sense disambiguation and semantic role labeling), discourse semantics, knowledge representation and automated reasoning (in particular, automated theorem proving)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1394> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1296> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Computerpragmatik"@de,
        "Computational Pragmatics"@en ;
    skos:scopeNote "Computational pragmatics might be defined as the computational study of the relation between utterances and context. Like other kinds of pragmatics, this means that computational pragmatics is concerned with indexicality, with the relation between utterances and action, with the relation between utterances and discourse, and with the relationship between utterances and the place, time, and environmental context of their being uttered."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1396> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1325> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Internal prolepsis"@en ;
    skos:scopeNote "<strong>Ι</strong>nternal<strong> </strong>prolepsis concerns events that take place within the time span of the main story."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1400> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1296> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Computermorphologie"@de,
        "Computational morphology"@en ;
    skos:scopeNote "Computational morphology deals with the processing of words and word forms, in both their graphemic, i.e., written form, and their phonemic, i.e., spoken form. It has a wide range of practical applications. To solve such seemingly simple tasks often poses hard problems for a computer program."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1402> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1325> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "External prolepsis"@en ;
    skos:scopeNote "External prolepsis concerns events which fall outside the time span of the main story."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1404> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1296> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Computerphonologie"@de,
        "Computational Phonology"@en ;
    skos:scopeNote "Computational phonology is formal phonology, and formal phonology is theoretical phonology. Computational phonology is not concerned with the implementation of phonological theories on computers (though that may be a byproduct of computational analysis). The primary concern of computational phonology is the content of the theory itself."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1405> a skos:Concept ;
    skos:altLabel "Partial flashback"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1180> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Partial analepsis"@en ;
    skos:scopeNote "The retrospective narrative analepsis begins in the distant past and moves forward to a point in the recent past; however, it does not bring the action all the way up to the starting point of the main narrative. The narrator leaves a gap to be bridged by an ellipsis between the analeptic exposition and the first or principal narrative."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1413> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1174> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Digression"@en ;
    skos:scopeNote "A narrative technique in which a narrator’s comment interrupts the story-time, while the narrative time continues. This take place, for example, when the narrator interrupts the progression of the story in order to hold forth about general problems, to comment on the characters’ behavior, or to reflect on the act of narration."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1418> a skos:Concept ;
    skos:altLabel "Internal flashback"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1180> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Internal analepsis"@en ;
    skos:scopeNote "A flashback to events that took place within the time span of the main story."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1423> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1373> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Derivationsprefix"@de,
        "Derivational prefix"@en ;
    skos:scopeNote "With derivational suffixes, the new word has a new meaning, and is usually a different part of speech. But the new meaning is related to the old meaning - it is \"derived\" from the old meaning.We can add more than one suffix, as in this example: derive (verb) + ation → derivation (noun) + al → derivational (adjective)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1426> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1373> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Flexionsprefix"@de,
        "Inflectional prefix"@en ;
    skos:scopeNote "Inflectional prefix do not change the class of the root, but change the meaning of the root. It means that the prefixes are Inflectional."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1427> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1420> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Derivationssuffix"@de,
        "Derivational suffix"@en ;
    skos:scopeNote "With derivational suffixes, the new word has a new meaning, and is usually a different part of speech. But the new meaning is related to the old meaning - it is \"derived\" from the old meaning.We can add more than one suffix, as in this example: derive (verb) + ation → derivation (noun) + al → derivational (adjective)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1430> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1420> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Flexionssuffix"@de,
        "Inflectional suffix"@en ;
    skos:scopeNote "inflectional suffix is added at the end of a root word."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1460> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/208> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Epistemic communities"@en ;
    skos:scopeNote "Networks of experts with recognised competence and authoritative claim to policy-relevant knowledge within their domain. These experts have a shared set of normative and principled beliefs, shared causal beliefs, shared notions of validity and shared values and practices about policy direction and implementation."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1476> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1475> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Environmental archaeology"@en ;
    skos:scopeNote "Environmental archaeology is a sub-field of archaeology that specializes in reconstructing the relationships between ancient societies and the environments they lived in. It mainly focuses on the impact people had on the world around them, and the way ancient peoples perceived and were affected by their surroundings, plants and animals on which they relied."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1477> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/31> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Excavation (Archaeology)"@en ;
    skos:scopeNote "The principal method of data acquisition in archaeology, involving the systematic uncovering of archaeological remains through the removal of the deposits of soil and the other material covering them. Through this method the archaeologist examines, records and interprets archaeological deposits, features and structures and retrieves artefacts, ecofacts and other remains within a specified area or site. There are two basic types of archaeological excavation: research excavation, when time and resources are available to excavate the site fully and at a leisurely pace and development-led excavation, undertaken by archaeologists when the site is threatened by building development."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1478> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1475> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Geoarchaeology"@en ;
    skos:scopeNote "The discipline that uses geoscience methods, techniques and concepts in solving archaeological problems. Geoarchaeology aims to recognize how natural and human induced processes alter the landscape. Also it aims to reconstruct the landscape for understanding site locations and distributions as well as the formation processes that built and preserved the site. The methods used derive from various fields of study such as geomorphology, climatology, geochronology, stratigraphy, soil science, sedimentology, and geoecology."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1480> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1475> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Underwater archaeology"@en ;
    skos:scopeNote "Underwater archaeology is a sub-discipline, which studies submerged sites, artifacts, human remains and landscapes. The surveying, excavation and preservation of sites are important phases of the process of underwater archaeological research."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1493> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/575> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Copts"@en ;
    skos:scopeNote "Ethnoreligious Christian group of northeast Africa, mainly Egypt. The Copts have developed a distinct cultural identity as adherents of the Coptic Orthodox Church of Alexandria, which can be traced back to the first Christian centuries. The Coptic language is mostly confined to liturgical service and most Copts are Arabic-speaking. The Copts constitute the largest religious minority in Egypt, while there are many Coptic diasporic communities all over the world.<br />"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1497> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1499> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Obituaries"@en ;
    skos:scopeNote "Texts published in the daily or periodical press, which present concisely the life, activity and work of a recently deceased public person. Obituaries provide a wide range of information and thus lend themselves to various types of research regarding prosopographical documentation, social perception and group identity."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1500> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1564> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Greek Orthodox Christians"@en ;
    skos:scopeNote "Christians of the Chalcedonian Orthodox Eastern Churches (patriarchal and autocephalous) who follow the ecclesiastical and cultural traditions of the Byzantine and post-Byzantine world, as they were expressed mainly by the Patriarchate of Constantinople."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1514> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1513> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Inclusion"@en ;
    skos:scopeNote "inclusion is the semantic relationship that exists between two (or more) words in such a way that the meaning of one word includes (or contains) the meaning of other words."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1516> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1513> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Attribution"@en ;
    skos:scopeNote "&nbsp;Attribution in general describes the relationship of how humans explain things that happen in the world.&nbsp; In language learning, it describes how learners perceive their relative accomplishments or disappointments."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1518> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/205> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Dyeing"@en ;
    skos:scopeNote "The art of dyeing."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1519> a skos:Concept ;
    skos:altLabel "Complementary antonymy"@en,
        "Contradictory antonymy"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1517> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ungraded antonymy"@en ;
    skos:scopeNote "Ungraded antonyms are pairs of words in which one member has a certain semantic property that the other member does not have. Therefore, in the context(s) in which one member is true, the other member cannot be true. It is said that these pairs of antonyms exhibit an either/or kind of contrast in which there is no middle ground."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1520> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1517> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Gradable antonymy"@en ;
    skos:scopeNote "Gradable or scalar antonymy describes pairs of words that are contrasted with respect to their degree of possession of a certain semantic property. Each term represents or&nbsp;stands for an end-point (or extreme) on a scale (e.g., of temperature, size, height, beauty, etc.); between those end-points there are other intermediate points."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1522> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1521> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Partial synonymy"@en ;
    skos:scopeNote "Partial synonymy meets the criterion of identity of meaning, which, however, for various reasons, fails to meet the conditions of what is generally referred to as absolute synonymy."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1523> a skos:Concept ;
    skos:altLabel "Complete synonymy"@en,
        "Identical synonymy"@en,
        "Perfect synonymy"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1521> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Absolute synonymy"@en ;
    skos:scopeNote "Absolute synonyms are pairs of words that have the same meaning (or share the same semantic features) in all the situational and syntactic contexts in which they can appear."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1526> a skos:Concept ;
    skos:altLabel "Blanket term"@en,
        "Superordinate"@en,
        "Umbrella term"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1525> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Hypernymy"@en ;
    skos:scopeNote "Hypernymy is the semantic relation between a more general word and a more specific word. Tree is a hyperonym of oak, because the set of trees includes the set of oaks. Hyperonymy is the converse of hyponymy."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1530> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1529> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Component meronymy"@en ;
    skos:scopeNote "The relation of the functional component to its whole, such as the relation between heart and body or engine and car."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1531> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1529> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Member meronymy"@en ;
    skos:scopeNote "The relation of a member to a collection or an element to a set, such as sheep and flock, player and team."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1532> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1529> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Portion meronymy"@en ;
    skos:scopeNote "The relation of a segment to a preexisting whole, like slice and cake."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1541> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1540> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Presbyterians"@en ;
    skos:scopeNote "Protestant Christians who follow the general teachings of Calvinism and emphasize particularly the authority of the Scriptures and the importance of divine grace through faith. Presbyterian Churches originate in the 16th-century Protestant Church of Scotland, whence they expanded to America. Presbyterians have been involved in issues of ecumenical dialogue between Christian confessions."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1545> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1542> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Archives (Corpora)"@en ;
    skos:scopeNote "An archive is an accumulation of historical or digital records. Archives contain primary source documents that have accumulated over the course of an individual's or organisation's lifetime and are kept to show the function of that person or organisation."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1546> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1542> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Electronic text libraries"@en ;
    skos:scopeNote "Text that has been encoded for digital electronic creation and transmission, often for display on cell phones or personal computers and their word processing software and often in the ASCII encoding format. Books and other printed materials that are available in a media format that can be displayed on a computer. The media format may be online or may use a compact disk, digital video disk, or other storage device as a distribution media. In many cases, electronic text exactly duplicates the text found in the printed version of the same work."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/155> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/22> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1565> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/26> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Police"@en ;
    skos:scopeNote "The civil force of a state, responsible for the prevention and detection of crime and the maintenance of public order."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1612> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1619> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "World wars"@en ;
    skos:scopeNote "Large-scale wars fought across wide regions of the planet, in which the most powerful states are involved along with states of lesser power, organised in opposing alliances. World wars are about restructuring the international inter-state system and the balance of power in accordance with economic and geopolitical aims."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1617> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/643> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Total wars"@en ;
    skos:scopeNote "Wars in which the belligerents mobilise all available resources, material and human, and use all available means in order to achieve victory, a process viewed as a struggle for survival. As a rule, total wars have an open-ended and evolving set of goals, which includes the annihilation of the opponent and his coersion into acceptance of a new sociopolitical order. At the same time, the total mobilisation and control of resources has a significant and long-lasting impact on the relationship between political power, society and economy."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1618> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1596> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Holy wars"@en ;
    skos:scopeNote "Wars that take place, are described and legitimized as fought at God's command and on God's behalf. The participants in holy war, like the Crusades or Islamic holy war, are sanctified, and in case of death acquire the status of martyr for the faith."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1621> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1620> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Anti-colonial wars"@en ;
    skos:scopeNote "Wars aiming at the secession from an imperial colonial power and at the acquisition of state autonomy or independence of a national, ethnic, or religious group, together with the territory it occupies."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/163> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Orientalism"@en ;
    skos:scopeNote "The basic ontological distinction between the &quot;West&quot; and the &quot;East&quot;, based upon the stereotypical representation of the &quot;East&quot; as a homogeneous, inherently backward social and cultural entity."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1637> a skos:Concept ;
    skos:altLabel "Calligraphic script"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Biblical script"@en ;
    skos:scopeNote "Type of majuscule script which is encountered in official manuscripts during the Byzantine period."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1638> a skos:Concept ;
    skos:altLabel "Koine script"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cursive script"@en ;
    skos:scopeNote "Type of majuscule script for private documents during the Byzantine period"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1639> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Bureaucratic script"@en ;
    skos:scopeNote "Type of majuscule script used by professional secretaries for public documents during the Byzantine period."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1640> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/22> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Minuscule script"@en ;
    skos:scopeNote "Script type according to which the letters are extended beyond the two parallel lines."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1645> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/643> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Guerilla warfare"@en ;
    skos:scopeNote "Wars in which irregulars engage in fast-moving, small-scale actions against orthodox military and police forces and, on occasion, against rival insurgent forces, either independently or in conjunction with a larger strategy. Over the centuries those engaged in guerilla warfare have been hailed as freedom fighters by their supporters (often local populations) and sympathizers of their cause, or stigmatized as brigands, mercenaries.and terrorists by their adversaries."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1646> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/643> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Biological warfare"@en ;
    skos:scopeNote "Wars in which microorganisms, toxins derived from living organisms, or bioregulators are used to deliberately cause the death or illness of humans, animals, or plants."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1647> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/643> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Nuclear warfare"@en ;
    skos:scopeNote "Wars in which weapon assemblies are used that are capable of inflicting mass destruction through the release of energy caused by nuclear fission or fusion."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1648> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/643> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Chemical warfare"@en ;
    skos:scopeNote "Wars in which toxic chemicals are used as weapons in order to harm, kill, incapacitate or control adversaries."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1649> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/643> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Asymmetric wars"@en ;
    skos:scopeNote "Wars characterized by incompatibility as to the military force, strategy, organisation and goals of the parties involved. Asymmetric wars take place between states, on the one hand, and organisations self-identified in national, ethnic, religious or ideological terms, on the other. In these conflicts, the opponents of the first category rely in the use of force and generalised repression, while those of the latter category draw on their organisational flexibility in the implementation of -often terrorist- attacks, in the targeted use of technology, and in non-transparent recruitment and support networks. Assymetric wars are often fuelled by conflicts in the framework of the collapse of a \"failed state\"; they often go beyond strict territorial boundaries and assume the characteristics of a spatially extended and dispersed struggle."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1652> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/702> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Proposals of decrees (Epigraphy)"@en ;
    skos:scopeNote "A structural element of a typical Attika decree. Τhe text of the proposal consists of the decision, preceded by the name of the proponent, and is rendered in indirect speech. The proposal ends with an instruction to inscribe the decree and with a provision for the relevant expenses."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1653> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/381> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Graffiti"@en ;
    skos:scopeNote "Inscriptions engraved on vases or sherds, usually after their firing, but also before. They are short texts, consisting of a man's name, more usually the name of the owner of the vase, or even a short sentence. Their subject matter varies and derives mainly from the activities of everyday life in ancient Greece."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1679> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1659> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Chiasmus"@en ;
    skos:scopeNote "Αrrangement of words and phrases in the form of a cross (from the Greek letter &ldquo;X&rdquo;); it is most<br />commonly used in two adjacent lines of a poem.&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1682> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1659> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Anaphora (figure of speech)"@en ;
    skos:scopeNote "A figure of speech that creates a literary effect by the repetition of the same word or phrase at the beginning of successive clauses or verses.&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1683> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1659> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Alliteration"@en ;
    skos:scopeNote "Figure of speech which creates a literary effect by the repetition&nbsp;of&nbsp;identical&nbsp;or&nbsp;similar&nbsp;sounds&nbsp;at&nbsp;the&nbsp;beginning&nbsp;of&nbsp;words&nbsp;or&nbsp;in&nbsp;stressed&nbsp;syllables in the same phrase or verse.&nbsp;<strong> </strong><br />&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1685> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1659> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Metaphor (figure of speech)"@en ;
    skos:scopeNote "A figure of speech containing an implied comparison between two dissimilar things that have something in common. Ε.g. &quot;gold coin&quot; (literal meaning), &quot;heart of gold&quot; (metaphor)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1686> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1659> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Simile"@en ;
    skos:scopeNote "A figure of speech involving the comparison of one thing with another thing of a different kind, used to make a description more emphatic or vivid: \"she slept like an angel\"."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1687> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1659> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Metonymy"@en ;
    skos:scopeNote "A figure of speech in which a thing or concept is referred to by the name of something closely associated with that thing or concept (e.g. &quot;the White House&quot; for the President)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1688> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2558> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Litotes"@en ;
    skos:scopeNote "A figure of speech in which a positive statement is expressed by negating its opposite expressions (e.g. using the expression &quot;not too bad&quot; for &quot;very good&quot;).&nbsp;&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1689> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1517> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Relational antonymy"@en ;
    skos:scopeNote "Relational antonymy descibes a pair of words that refer to a relationship from opposite points of view. There is no lexical opposite of teacher, but teacher and pupil are opposite within the context of their relationship. This makes them relational antonyms (for example. husband vs. wife, parent vs. child)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1692> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1691> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Homophony"@en ;
    skos:scopeNote "A term used in semantic analysis and referring to words that have the same pronunciation, but they differ in meaning. Homophony appears in pairs such as threw/through, rode/rowed."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1693> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1691> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Homography"@en ;
    skos:scopeNote "Ηomography is the property of pairs of words in a language when&nbsp;written symbols of their written form and the sounds of their spoken form have a 1-to-1 correspondence."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1694> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1659> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Personification (figure of speech)"@en ;
    skos:scopeNote "A figure of speech in which an inanimate object, an animal or an abstraction is endowed with human attributes (e.g. &ldquo;The sky weeps&quot;)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1697> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Mayor"@en ;
    skos:scopeNote "The office of mayor, in modern usage, identifies the head of a municipal government. The mayor is almost invariably the chairman of the municipal council. Whatever the form of local government, the mayor’s role rests largely on his relationship to the council and to the central government. Mayors are either appointed or elected. In Europe, until about the middle of the 19th century, most mayors were appointed by the central government. With the rise of representative government, more and more countries adopted the practice of electing the mayor by the local population."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1698> a skos:Concept ;
    skos:altLabel "Co-hyponymy"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1525> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cohyponymy"@en ;
    skos:scopeNote "Two or more predicates are co-hyponyms (or 'cohyponyms') when they are hyponyms of the same hyperonym. Example: 'dog' and 'cat' (common hyperonyms: animal, pet, mammal, etc. Co-hyponyms may or may not be incompatibles."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/170> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Baroque"@en ;
    skos:scopeNote "A term now generally used to describe art in Europe between 1600 and 1750. It is broadly accepted today that Baroque implies dynamism and movement (particularly in architecture and sculpture), and a theatricality dependent on a mastery of space and geometry. The illusionism of Baroque painting is founded on the ability to depict reality."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1703> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/38> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Beekeeping"@en ;
    skos:scopeNote "Care and manipulation of honeybees to enable them to produce and store more honey than they need so that the excess can be collected. Honeybees are also kept for other products they produce or their services as pollinators of fruit and vegetable blossoms. Beekeeping is one of the oldest forms of animal husbandry."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1704> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1525> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Autohyponymy"@en ;
    skos:scopeNote "A word is an autohyponym if it is used as both a hypernym and its hyponym. For example, the word dog describes both Canis familiaris and male Canis familaris, so it is possible to say &quot;That dog isn&#39;t a dog, it&#39;s a bitch&quot; (&quot;That hypernym Z isn&#39;t a hyponym Z, it&#39;s a hyponym Y&quot;). Similarly, the verb to drink (a beverage) is a hypernym for to drink (an alcoholic beverage). Autohyponymy is also called &quot;vertical polysemy&quot;."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1705> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1525> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Holonymy"@en ;
    skos:scopeNote "Holonymy is a semantic relation. Holonymy defines the relationship between a term denoting the whole and a term denoting a part of, or a member of, the whole. That is,<br />'X' is a holonym of 'Y' if Ys are parts of Xs, or<br />'X' is a holonym of 'Y' if Ys are members of Xs.<br />For example, 'tree' is a holonym of 'bark', of 'trunk' and of 'limb.'"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1706> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/248> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Sigillography"@en ;
    skos:scopeNote "The discipline that deals with the study of seals, i.e. their material, their form, but also their historical and archaeological interpretation. Sigillography aims at the identification, description, reading, dating, as well as the historical and archaeological evaluation of the stamps."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1711> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1709> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Analytic languages"@en ;
    skos:scopeNote "An analytic language is a language that primarily conveys relationships between words in sentences by way of helper words (particles, prepositions, etc.) and word order, as opposed to utilizing inflections (changing the form of a word to convey its role in the sentence). Most languages are not purely analytic, but many rely primarily on analytic syntax."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1712> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1709> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Isolating languages"@en ;
    skos:scopeNote "An isolating language is a type of language with a very low morpheme per word ratio and no inflectional morphology whatsoever. In the extreme case, each word contains a single morpheme. Currently, the most spoken purely-isolating language is Yoruba."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1713> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/157> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Philately"@en ;
    skos:scopeNote "Systematic engagement with the collection, study, classification, presentation and/or marketing of stamps as well as other items of postal history."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1714> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1709> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Synthetic languages"@en ;
    skos:scopeNote "A synthetic language uses inflection or agglutination to express syntactic relationships within a sentence. Inflection is the addition of morphemes to a root word that assigns grammatical property to that word, while agglutination is the combination of two or more morphemes into one word. The information added by morphemes can include indications of a word's grammatical category, such as whether a word is the subject or object in the sentence. Morphology can be either relational or derivational"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1726> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1725> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Maronites"@en ;
    skos:scopeNote "Ethnoreligious group of the Near East. Maronites are Arabic-speaking Catholic Christians who follow the Syriac rite and trace the origins of their Church in the ascetic St Maron, who was active in 4th and 5th-century Syria. During the intra-Christian conflicts of late antiquity, the Chalcedonian Church of the Maronites, together with its flock, moved toward the Mount of Lebanon. The Crusades brought the Maronites in close contact with the Catholic Church, and the Maronite Church entered the Catholic fold. The Maronites' concentration in the Mount of Lebanon, together with their distinct religious and confessional identity, contributed to their formation as an ethnoreligious group that is regarded today as a vital part of Lebanese society and politics. Many Maronites have migrated in European and American countries."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1737> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1731> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Historical novel"@en ;
    skos:scopeNote "Α type of novel that not only takes its setting and some characters and events from history, but makes the historical events and issues crucial for the central characters and the course of the narrative."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1745> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2338> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Druzes"@en ;
    skos:scopeNote "Ethnoreligious group of the Near East. The Druzes are a particularly divergent branch of Shia Ismailism that originates in the dynasty of the Fatimids in medieval Egypt, and specifically in the reign of the caliph al-Ḥakim bi-Amr Allah, who is considered by them by as an incarnation of God. The formation of an extreme unitarian version of Ismailism by Hamza al-Zawzani, which rejected some of the most widely accepted Islamic practices, led to persecutions against his followers. The latter were confined to Syria and, mainly, to Mount Lebanon, where the Druzes were formed as an ethnoreligious group based on a tribal social structure. During the 19th century, and in the context of the European Powers' intervention and competition, a part of the Druzes committed massacres against the Maronite Christians. European intervention led to the creation of the state of Lebanon. The Druzes are a vital part of Lebanese society and politics."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1746> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/627> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Sunni Muslims"@en ;
    skos:scopeNote "The largest Islamic community, which comprises approximately 80% of the Muslims worldwide. The Sunnites follow the tradition of Sunnah, which adopts the traditional practices of the Islamic communities on the basis of the example of prophet Muhammad and his companions. Many Sunnites regard themselves as the \"orthodox\" branch of Islam in contrast to the Shiites. They acknowledge the first four caliphs as legitimate successors of the prophet, as well as the legitimacy of the Ummayad and Abbasid caliphates. The Sunnites are in turn divided in four legal traditions (Hanafi, Maliki, Shafii and Hanbali) that display different approaches in the interpetation of Islamic law and in the sociopoliitical practices they endorse."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1748> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1747> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Imamiyyah Shiites"@en ;
    skos:scopeNote "Muslims who follow the branch of Imamiyya Shiism, the largest of the Shia traditions. The Imamiyyah Shiites, called also Twelvers, believe in 12 divinely inspired <em>Imam</em>s descended from Muhammad through his daughter Fatima and her husband Ali, considered to be the first Imam. The <em>Imam</em>s, regarded as exemplary authorities for the community and focal points for religious devotion, epitomise ideas of martyrdom and righteous suffering, which open the way to salvation . Accordings to Imamiyya Shiites, the 12th <em>Imam, </em>who has entered concealment, will be sent by God as a messianic redeemer who will inaugurate the rule of justice in anticipation of Judgment Day."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1751> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Member of Parliament"@en ;
    skos:scopeNote "Elected representative of a constituency, member of a national (or federal or autonomous) parliament. In countries with a bicameral system, Members of Parliament are the members of the lower house. The duties of the Members of Parliament are defined by the Constitution in the framework of the exertion of legislative power, while their tenure depends on the parliamentary term. Members of Parliament who belong to the same party form parliamentary groups. In countries with a pure parliamentary system the governmental positions (certainly the one of the prime minister) are as a rule occupied by Members of Parliament, while in countries with a strict separation between the executive and legislative branch the members of the government are not Members of Parliament."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1752> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "President of the Republic"@en ;
    skos:scopeNote "The highest political office in nation states with a regime of presidential or parliamentary republic. In presidential republics (as the USA) and semi-presidential republics (as France), the president is elected through general elections and is the head of state and the head of the executive at the same time. In parliamentary republics, executive power rests with the prime minister and his/her cabinet, while the president is elected by parliament as the head of state, but his/her functions are rather ceremonial, in accordance with those of the king/queen in constitutional monarchies.<br />"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1753> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "King"@en ;
    skos:scopeNote "Leader of a monarchical state. Kingship is usually hereditary and the king's power may be absolute or restricted, or his role may be purely ceremonial and symbolic. In many regions of the world kingship had been for centuries invested with sacral meaning and was regarded as a manifestation of divine will."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1754> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Emperor"@en ;
    skos:scopeNote "The ruler of an empire, a state with a large territory and expansionary claims that rules over peoples and populations that differ in ethnic, religious and cultural terms. The emperor embodies the state's claims to universal domination and is regarded superior in status to other monarchs and rulers, such as kings. More often than not, emperors belong to a dynasty, which, in the case of the Ottoman Empire, may be identified with the state itself, while in other traditions, like the Roman one, the ascension of the emperor to power either is not inscribed in dynastic structures or does not depend only on dynastic continuity."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1755> a skos:Concept ;
    skos:altLabel "Secretary of State"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1750> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Minister of Foreign Affairs"@en ;
    skos:scopeNote "Minister who deals with the foreign policy of a government. The minister of foreign affairs is the head of the state diplomacy and is responsible for planning and implementing the government's policy in regard to the relations of the state with other states, often in the framework of interstate agreements and organisations, and to the overall position of the state in the international geopolitical system."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1758> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ambassador"@en ;
    skos:scopeNote "High-ranking diplomat, representative of a state and head of a permanent diplomatic mission resident in the capital of another state or at an international organisation. The ambassador has the status of diplomatic immunity and represents his home country and its government in all matters of bilateral relations. The office of the ambassador as the permanently resident representative of a state originates in the Rennaissance and the early modern era. Today it is an essential part of the international system of interstate relations."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1768> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1655> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Pope"@en ;
    skos:scopeNote "Head of the Catholic Church, bishop of Rome and holder of one among the most ancient sees of Christianity. The pope is regarded by Catholic Christians as the apostolic sucessor of Peter and, therefore, as the head of all Christians. The dogma of papal infallibility is based on apostolic succession. According to it, the pope is beyond the possibility of error when speaking <em>ex cathedra</em> or when issuing a decision or a clarification on religious and moral issues. Apart from being a religious leader, the pope is the head of the Vatican state in Rome, while during the middle ages and until the unification of the Italian nation state he had under his rule the so-called \"papal states\"."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1769> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1655> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Metropolitan bishop"@en ;
    skos:scopeNote "Bishop who is the head of a -usually major- ecclesiastical administrative unit (metropolis). The office originates in the early Christian era, when the metroplitan was the bishop of the capital of a Roman province. The position of the metropolitan vis-à-vis the closely related office of archbishop, as well as in the framework of the overall ecclesiastical adminisrtative system, differs in the Catholic, Eastern Orthodox, Oriental Orthoidox and Anglican Churches."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1770> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2040> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Sufi orders"@en ;
    skos:scopeNote "This term Sufi refers to the Islam of inward vision and individual religious experience. It encompasses an assortment of mystically oriented doctrines, practices, forms of social interaction, and literary works. Historically, Sufism began with individual ascetics living in Iraq and Iran during the eighth and ninth centuries. During the tenth and eleventh centuries, Sufi adepts began to organise into groups of masters and their disciples that developed into organised dervish orders, each with its own distinct doctrines, practices, and spiritual genealogy."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1771> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/627> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Mevlevis"@en ;
    skos:scopeNote "Members of one of the most well known Sufi orders, due to its famous characteristic \"whirling\" meditative dance. It takes its name from the great 13th-century mystic poet Jalal al-din Rumi, who is known in Turkish as Mevlana (from the Arabic mawlana = “our master”). Though Rumi’s poetry was composed in Persian, the language of the Seljuk court, the order developed mostly in the Turkish environment of the Ottoman Empire, where it benefited from the patronage of Ottoman sultans. Mevlevi dervishes studied and produced art in their worship centres (<em>tekke</em>s). The order in general appealed to the upper classes and the intellectuals, and many Ottoman poets, composers, and calligraphers were Mevlevis."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1772> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/627> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Bektashis"@en ;
    skos:scopeNote "Members of the he Bektashi dervish order that was popular among the peasants of Anatolia and in the Balkans from the founding of the Ottoman Empire until its demise. Members of the order still are an important part of Albanian Muslims. The founder is said to have been Hajji Bektaş, a mystic who went to Anatolia in the 13th century from northeastern Iran. The order’s practices were unorthodox for Sunni Muslims as they blended elements of Islam with Turkish shamanism, while some of the order's practices resembled those of Christianity. This, along with the tolerant spirit of the Bektashis, became a factor for the order's wide appeal to Christians in the Balkan provinces of the Empire, something that is regarded as having contributed to the conversion of many to Islam."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1774> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1707> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Benedictine monks"@en ;
    skos:scopeNote "Monks who belong to the monastic order of St Benedict (6th century) and follow his coenobitic rule. The Benedictines became the most important monastic order of Europe from the 8th and 9th century onwards, when the Carolingians tried to impose their rule on all monastic communities. They were connected to high officials of the Church, as well as to nobility, while their abbeys disposed of large landed property, but also of rich libraries, where the monks studied and copied manuscripts. In the 13th and the 14th centuries the Benedictines had to deal with the emergence of new monastic orders that were linked to the cities, like the Franciscans and the Dominicans. During the Reformation and Counter-Reformation, and with the advent of secularisation, the Dominicans followed the course of the other ancient monastic orders and gradually lost their important socio-economic and cultural role."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1775> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1707> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Capuchin monks"@en ;
    skos:scopeNote "Members of the Catholic Capuchin Order, which emerged as a branch of the Franciscan Order and subsequently was recognised as an autonomous order in 1528. The main characteristic of Capuchin monks was the emphasis on leading a frugal life in a framework of poverty, which they viewed as a revival of the rule of St. Francis. During the Counter-Reformation the Capuchin monks played a significant role in the Catholic Church's counteroffensive with their missionary work, their preaching and their providing succour to the lower social strata, particularly during outbreaks of epidemics."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1779> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Doge"@en ;
    skos:scopeNote "The highest political office in some of the Italian city-states (Venice, Genoa) during the Middle Ages and the early modern period. The selection of the doge was effectuated by an electoral body which became increasingly oligarchic in the early modern period. The doge, a member of a powerful family of the city, was surrounded by institutional bodies that in fact limited his power and autonomy. The doge of Venice, the most important version of the office, developed into a figure that expressed symbolically and ceremoniously the city itself and its position in the world."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1780> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Consul (Diplomat)"@en ;
    skos:scopeNote "A representative of a state in the territory of another state, whose task is to foster the economic relations between the two states on a practical level, as well as to assist their co-nationals during their stay in their area of jurisdiction in legal, institutional and bureaucratic issues. The consuls of one state in another state may be more than one and can be stationed in regions that their co-nationals visit often or in which they have developed economic activity."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1781> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Viceroy"@en ;
    skos:scopeNote "A high official who rules a country, province or colonial possession as the representative of his sovereign or king and who is empowered to act in the sovereign’s name. The office designates persons appointed by the sovereign and is not necessarily linked with nobility. Viceroy (virrey) was the title given to the principal governors of Spain’s American colonies, as well as to the governors of the “kingdoms” (reinos) of peninsular Spain proper (e.g., Aragon, Valencia). In the course of time, the office of viceroy was mostly connected with Spanish, British, and Portuguese colonialism."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1782> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1783> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Caliph"@en ;
    skos:scopeNote "Ruler of the Islamic community, conceived as successor of the prophet Muhammad and head of a Muslim state that claims legitimacy over all Muslims."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1784> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1783> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Imam"@en ;
    skos:scopeNote "The title of imam refers to persons who perform functions of religious leadership and guidance in the framework of Muslim communities. The office of imam refers to the religious person who leads worship services (e.g. prayer) and provides guidance to the believers in their religious duties. The title, however, is also bestowed on persons of legal and theological authority, like the founders of the legal schools of Islam and the experts and intepreters of the holy tradition (hadith). In a broader sense, the office of the imam refers to the political and religious leader of the Muslim community. In the Shiite tradition, imams are the successors of the caliph Ali, son-in-law of Muhammad. Their number, however, as well as the line of succession, differ according to the different branches of Shiism."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1785> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1783> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Mufti"@en ;
    skos:scopeNote "Expert and interpreter of the Muslim holy law. The muftis issued legal opinions (fetvas) on particular cases. Although they were not binding for the decisions of the court, the legal opinions carried weight in the handling of the eventual cases. In the Ottoman Empire the state established the office of grand mufti (Shaykh al-Islām). His legal opinions were particularly important for the legitimation of state policies."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1788> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1783> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Shaykh"@en ;
    skos:scopeNote "Title used for authority figures and offices in Islamic societies. Originally applied specifically to older men in kin-based Arab tribal societies, it has become a title of respect for those who mastered the religious sciences, for administrators of religious institutions, and for masters of dervish groups. The title was also bestowed on the highest religious office in the Ottoman Empire, the <em>shaykh al-Islam</em>."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1789> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/133> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Kingdoms"@en ;
    skos:scopeNote "Monarchies ruled by a king. Kingdoms are one of the most ancient forms of state organisations, and may be tribal states, city-states, feudal states, absolutist states and even parliamentary nation-states, in which the role of the king is mainly ceremonial and symbolic."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1791> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1790> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Religious conversion"@en ;
    skos:scopeNote "The passage of one or more individuals, sometimes of entire social or etho-cultural groups, from one religion to another. Religious conversion is a multifaceted process that has to do with systems of belief and practice, institutions, cultural change and social identities. Conversion is not only connected to a quest for investing human life with a metaphysical meaning, but also to the sociopolitical role of religion, as well as to the relationship between religiosity and secularisation."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1792> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1790> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Schisms"@en ;
    skos:scopeNote "Schisms are complex events that lead to the splitting of a more or less unified religious group and organisation into two or more distinct parts. Schisms arise out of conflict and controversy not only on theological, but mainly on political and social issues. The opposite groups that emerge from schisms often stigmatise one another as heretic or schismatic, and claim for themselves dogmatic purity and institutional legitimacy."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1793> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1790> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Synods (events)"@en ;
    skos:scopeNote "Assemblies of high ecclesiastical officials and theologians with the purpose of making and enforcing decisions on issues of dogma, religious practice and ecclesiastical organisation. The synods as major ecclesiastical events (among which the Ecumenical Synods of late antiquity were prominent) are to be distinguished from the notion of synod as a collective body of officials that belongs to the governing institutions of a Church."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1794> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/315> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Enthronements"@en ;
    skos:scopeNote "Ritual events that accompany a person&#39;s accession to kingship or highest ecclesiastical office. As a rule, enthronements follow a specific ceremony that conveys symbolic legitimation to the person and the office, reinforces the claims of power that derive from the office, and invokes a representation of the social and political order that the office is considered to embody."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1796> a skos:Concept ;
    skos:altLabel "Wiedererkennen (Theater)"@de,
        "Recognition (theatre)"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/31> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Anagnorisis"@de,
        "Anagnorisis"@en ;
    skos:scopeNote "Essential part of the plot of a tragedy according to Aristotle, anagnorisis (recognition) -already known from the Homeric epics- defines the transition of the tragic hero from ignorance to knowledge through a sudden revelation. This procedure results in the awareness of the true nature of their situation, or that of the others and the discovery of their identity&ndash; leading to the resolution of the drama. In classical and contemporary dramaturgy, it constitutes a dramaturgical technique where a character is recongised by another and the conflict is resolved."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1805> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/804> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Farce"@de,
        "Farce"@en ;
    skos:scopeNote "Popular dramatic subgenre of comedy dominated by the rapid-fire pace with the depersonalised types operating outside of any social background or ideology, often violating logic and verisimilitude, and excluding emotional involvement or psychological deepening. Farce is of limited length, has a strict geometric structure, at its core a deception plan for the purpose of some material or erotic benefit. Its basic elements are the rudimentary plot, the twists, the unexpected events, the misunderstandings, the disguises, the change of roles, the extravagant exaggeration, the gross jokes, the naive lines, the puns and the language with sexual innuendoes. In terms of stage practice, the genre is characterised by the actor&#39;s intense physical expression with mimicry, grimaces, and gestures."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1811> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Barrel-organ players"@en ;
    skos:scopeNote "Street musicians playing the barrel-organ."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1813> a skos:Concept ;
    skos:altLabel "Nannies"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Wet nurses"@en ;
    skos:scopeNote "Women who nursed/ breast-fed another woman’s infant for a fee and / or undertook its upbringing."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1814> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2040> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Synods (collective bodies)"@en ;
    skos:scopeNote "Church bodies that meet relatively regularly and either constitute the main administrative authority of the Church or advise it on matters of faith, order, and government. We must disitniguish between synods of ordained ministers (bishops or clergy) and synods in which lay members have an equal say. We must also distinguish between synods that give council to a higher authority and synods that have a binding right of decision in their own domain, as well as between synods of the whole Church and synods at a lesser level."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1830> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/19> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Arsons"@en ;
    skos:scopeNote "Willful damage or destruction of public or private property by means of fire or explosion. Reckless activity—or burning without regard to consequences—can result in an arson conviction. Large scale destructions by fire have been attributed to deliberate arsons, although their causes are often natural phenomena or accidents. An arsonist may act from a variety of different motives, including sabotage, rage, profit, and the desire to conceal or destroy evidence. Persons suffering from pyromania have a pathological urge to set fires."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1833> a skos:Concept ;
    skos:altLabel "Fires"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/14> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Conflagrations"@en ;
    skos:scopeNote "Large-scale uncontrolled fires in a built area or in the countryside with disastrous consequences for the natural and/or the human-made environment. Although conflagrations are sometimes due to intentional action (arson), they mostly are provoked either by natural phenomena (e.g. drought, flashes of lightning) or by a combination of natural phenomena and human activity (e.g. ways of construction and of resource exploitation, management of combustible materials)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1834> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/14> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Floods"@en ;
    skos:scopeNote "Phenomena of water overflow over dry land that can have disastrous effects on living beings and human establishments in the affected areas. Floods are caused by excessive rainfall (especially on saturated ground) and by snow or ice melt, often in combination with geomorphological and hydrological characteristics that prevent water from infiltrating the ground or running off toward the sea."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1835> a skos:Concept ;
    skos:altLabel "Cyclones"@en,
        "Hurricanes"@en,
        "Typhoons"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/14> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Tropical cyclones"@en ;
    skos:scopeNote "Intense atmospheric vortices with low centre barometric pressure that form over the warm tropical oceans. Tropical cyclones incite violent winds that drive significant storm waves and produce torrential precipitation, thus often causing major catastrophes in human-built and natural environment."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1839> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1837> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Plague epidemics"@en ;
    skos:scopeNote "Epidemics of plague, an infectious disease caused by parasites of infected rodents. Plague can take the form of bubonic, septicemic and pneumonic plague. Plague epidemics refer mostly to bubonic plague and have sometimes developed into extremely destructive pandemics, such as the one of the 6th century CE (\"plague of Justinian\") and the one of the 14th century, known as \"Black death\", which may have been responsible for the extinction of 1/3 of the population of Europe."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1840> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1837> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cholera epidemics"@en ;
    skos:scopeNote "Outbreaks of cholera, an infectious disease whose bacterium is spread through water and food. Cholera infects the small intestine, provokes acute diarrhea and may lead to dehydration and death. Cholera is connected with bad sanitation, lack of clean drinking water, and poverty. Cholera epidemics were particularly hard in the 19th century; they have often developed into pandemics that hit the poorest regions of the planet."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1841> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1837> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Smallpox epidemics"@en ;
    skos:scopeNote "Violent outbreaks of smallpox, an infectious disease that affects the cells and the mucosa of the skin, the mouth and the pharynx, and causes skin pimples and pustules. Smallpox has been responsible for millions of deaths, mostly of children, in human history. Smallpox epidemics were often caused by the exposure to the virus of populations that had no former contact with it, as well as by the poor health conditions of the working classes of Europe and America. After having replaced the plague as the main infectious disease in the 18th century, and after its serious impact on the world population, smallpox was efffectively fought off through vaccination in the late 20th century. Today it is considered as eradicated."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1842> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1837> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Influenza epidemics"@en ;
    skos:scopeNote "Acute outbreaks of influenza, an infectious disease that affects mainly the respiratory system and may have serious complications or even lead to death. Most known among the influenza epidemics is the 1918-1919 Spanish influenza, which developed into a pandemic and caused the death of millions across the planet."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1843> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1837> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Typhus epidemics"@en ;
    skos:scopeNote "Outbreaks of typhus, an infectious disease that is transmitted by body lice. Typhus, which manifests in headaches and severe rashes, may provoke meningoencephalitis and lead to death. Its symptoms include headaches and severe rashes, and it may provoke meningoencephalitis and lead to death. Typhus epidemics are connected with bad health conditions and the concentration of many people in a restricted space. This is why they have particularly hit military units during war, prisoners in concentration camps, migrants and refugees."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1845> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1844> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Genocides"@en ;
    skos:scopeNote "Intentional and coordinated actions aiming at the total -or to a great extent- annhihilation of a racial, ethnic, religious or social group. The term was used after World War II to designate a category of war crimes and has been adopted by international law. Its use in historiography, however, is problematic, since the conditions, under which mass killings emerge in history, are complex and often contradictory. Therefore, it is difficult to define typically some of those phenomena as genocides in contrast to others."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1849> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/14> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Droughts"@en ;
    skos:scopeNote "Prolonged periods of restricted rainfall that drastically reduce subsoil water and have catastrophic effects on the ecosystem and the productive activities, leading thus often to acute food crises. The effects of droughts on human societies depend always on socio-economic and political structures, goals, and inequalities."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/185> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/26> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Minorities"@en ;
    skos:scopeNote "Population groups within states, which are treated as distinct from a social majority on account of particular and divergent ethnic, religious, cultural and other traits. Minorities are formed either informally or as institutionally regulated categories."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1850> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/19> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Sabotage"@en ;
    skos:scopeNote "Deliberate action by small army or guerilla groups, or even by activists associated with social movements, aiming at damaging means of production or infrastructure in order to weaken a government in times of internal conflict or war. During World War II anti-German resistance groups in Europe practiced effective sabotage against factories, military installations, railroads, bridges etc. Sabotage became a basic strategy of insurgent groups associated with anticolonial and separatist movements."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1853> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1852> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Battles"@en ;
    skos:scopeNote "Armed conflicts between opponent forces during a wider politico-military confrontation, which are included in strategic plans for the achievement of a final goal. Battles vary according to their duration, intensity, size of participant forces, casualties, military means, tactics and forms of conflict. However, it is analytically advisable to consider them all as a single category with its relevant internal differentiations."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1854> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1852> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Naval battles"@en ;
    skos:scopeNote "Armed conflicts between opposing forces that take place on the water, mostly on the sea, and in which mainly (but not exclusively) waterborne military means are employed. Naval battles are conducted in the framework of particular tactical planning that applies to the water environment (naval warfare)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1855> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1852> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Sieges"@en ;
    skos:scopeNote "Military blockades from land and/or sea of an inhabited and/or fortified place aiming at its capture by assault or surrender. Sieges often include strike operations against the defenders, but they are mostly based on exercising pressure through the cutting of supply lines, which can lead the besieged to negotiations for surrender."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1865> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/289> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Shepherds"@en ;
    skos:scopeNote "Peasants who graze animals, mainly sheep and goats."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1868> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/289> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Woodcutters"@en ;
    skos:scopeNote "Workers who engage professionally in wood cutting, mainly in the forests."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1869> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Tinsmiths"@en ;
    skos:scopeNote "Craftmen who make or repair tinware or items of other light metals."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1870> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Street musicians"@en ;
    skos:scopeNote "People who play professionally, a traditional musical instrument."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1871> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/289> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Lighthouse guardians"@en ;
    skos:scopeNote "Persons responsible for the operation, maintenance and control of a lighthouse."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1874> a skos:Concept ;
    skos:altLabel "Novel of education"@en,
        "Novel of formation"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1731> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Bildungsroman"@en ;
    skos:scopeNote "German term for &quot;novel of education&quot;; the term is also applied in English for a sub-genre of the novel which<br />generally shows the development of a protagonist from childhood to maturity."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1886> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Regent"@en ;
    skos:scopeNote "Person who assumes the duties of the monarch if the latter is unable to do so (usually because he/she is a minor). Sometimes the regent assumes the rule during periods of interregnum. In theory, the regent (who does not necessarily belong to the nobility) cannot claim any rights to the throne and is relieved of power as soon as the conditions, under which the regent was appointed, cease to exist."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1897> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1858> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Comparative literature"@en ;
    skos:scopeNote "The study of similar literary works from two or more nations, periods, or languages in relation to each other, or the study of any literary phenomenon from the perspective of at least two literatures."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1903> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/26> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Guilds"@en ;
    skos:scopeNote "Organisations of craftsmen and professionals in the urban space whose function was to determine product prices, supervise the right to exercise the profession, obtain raw materials, regulate pay, tax status and generally maintain control over production. The guilds were, in various forms, a widespread phenomenon in pre-modern societies."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1907> a skos:Concept ;
    skos:altLabel "New novel"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1731> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Nouveau roman"@en ;
    skos:scopeNote "Type of novel, mainly experimental, that came to prominence in the 1950s. It rejected standard elements such as plot, characters, and omniscient narrator central to the traditional novel, in an attempt to reflect more faithfully the sometimes random nature of experience."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/194> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/23> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Residential areas"@en ;
    skos:scopeNote "This term classifies built environments regardless of size, duration of construction or use, which include housing units, infrastructures and facilities that serve the social, or/ and professional and economic needs of their residents."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/195> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/31> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Theater im Theater"@de,
        "Play within a play"@en ;
    skos:scopeNote "Dramatic device by which an element or a set of elements (persons, actions, situations) appearing relatively detached from the rest of the play, become the object of the spectator’s gaze on-stage, i.e. of the actors impersonating the spectators, while at the same time they themselves are watched by the audience."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1951> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/158> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Sawmills"@en ;
    skos:scopeNote "Woodworking facilities."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1984> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Kolakretis (city-state period)"@en ;
    skos:scopeNote "An office that first appears in ancient Athens. Kolakretai were officials in charge of managing public revenue and expenses. The term dates back to the Homeric years, when Kolakretai were persons responsible for the dismemberment and the sharing of the sacrificed animals. In later years Solon appointed them treasurers of the State Treasury. The office was abolished in 411 BC, and their duties were transferred to the Hellinotamies."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1986> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/21> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cultural syncretism"@en ;
    skos:scopeNote "Interactions and combinations between elements of two distinct historical and cultural traditions. Syncretism has been viewed as referring mostly to interactions in the sphere of religion, but it can also be identified in other spheres of cultural and social life. Syncretism is different from the formation of new cultural forms from bits and pieces of cultural practice of diverse origins, in that syncretism does not represent a cultural mosaic, but a reintegration of elements into a new whole."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1987> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/21> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cultural hybridity"@en ;
    skos:scopeNote "Cultural hybridity is a form of cultural change and creativity that challenges fixed or essentialist accounts of identity by incorporating the crossing of racial and cultural boundaries. Cultural hybridity is not merely fusing existing cultural elements. Rather, hybridity refers to the process of the emergence of a culture, in which its elements are being continually transformed or translated through irrepressible encounters."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1990> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1989> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Home-community migration"@en ;
    skos:scopeNote "Movement of individuals from one place to another within the home community. For humans, these movements consist most basically of young men and women moving from one family to another in marriage. Thus, many and perhaps most humans experience home-community migration, as they start new families of their own. In patrilineal systems, it is women who move from one family to another to marry the men and produce the next generation. In matrilineal systems, in contrast, the tendency is for the women to stay with the family into which they were born, and for men to move from one family to another."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1991> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1989> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Colonisation"@en ;
    skos:scopeNote "Departure of individuals from one community to establish a new community that replicates the home community. Usually, the colonists settle in an environment very similar to that of their home community, and thereby maintain the same style of life. Colonisation takes place occasionally, especially in cases of communities that are thriving. The colonists settle and begin new communities without having to learn new languages or customs."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1992> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1989> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Whole-community migration"@en ;
    skos:scopeNote "Displacement of all the members of a community. Humans do not have a universal pattern of community migration. Some communities – nomadic communities, as we call them – do migrate habitually, often adopting the habits of the animals they have come to domesticate or hunt. Another pattern is that of whole communities migrating in order to flee a natural disaster such as famine or a human disaster such as expulsion from their homeland."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1993> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1989> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cross-community migration"@en ;
    skos:scopeNote "Cross-community migration consists of selected individuals and groups leaving one community and moving to join another community. This pattern is followed universally by humans, and rarely by other species: language communication among humans provides the basic reason for this distinct pattern of migration. All human communities experience out-migration by members of their population who go to other communities. The migrants leave their home communities for various reasons – to benefit the home community, to benefit themselves, to escape the home community, or because they have been forcibly removed. At the same time, the home community accepts in-migrants from other communities for either a short or long time. The rates and directions of migration may vary significantly, but the practice is universal among humans."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1994> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1989> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Forced migration"@en ;
    skos:scopeNote "The expulsion of people from their homeland either by natural or by human forces. The main patterns of forced migration have been enslavement, natural disasters, expulsion of groups from localities, and forced resettlement by imperial powers. Of these, enslavement has been more consistently documented. One should distinguish, however, between <em>forced migration</em> (the seizure and transportation of captives) and <em>forced labour</em> (the expolitation of those held in slavery). The two processes, while being inextricably linked, are quite different."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2007> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1321> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Religious painting"@en ;
    skos:scopeNote "Biographies of saints, usually written, but includes oral or visual works as well."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2009> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2581> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Academies of Fine Arts"@en ;
    skos:scopeNote "Institutions of higher education assigned to promote the study of visual arts."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2010> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1321> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ruins painting"@en ;
    skos:scopeNote "Painting genre which represents the remains of buildings that have been destroyed or are in a state of great disrepair or decay."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2011> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/378> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Chiaroscuro"@en ;
    skos:scopeNote "Chiaroscuro is an Italian term which translates as light-dark, and refers to the balance and pattern of light and shade in a painting or drawing. Chiaroscuro is generally only remarked upon when it is a particularly prominent feature of the work, usually when the artist is using extreme contrasts of light and shade."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2012> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/202> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Art exhibitions"@en ;
    skos:scopeNote "Τemporary displays of works of art for pleasure, instruction, the enhancement of scholarship, or for sale."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2017> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/618> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Studies"@en ;
    skos:scopeNote "Works of art that explore a specific subject matter and the alternative ways of its pictorial –when it comes to the visual arts– representation in whole and in details. A study corresponds at the preliminary phase of artistic creation and has a more finished character in comparison to a sketch."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2018> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Tone"@en ;
    skos:scopeNote "Variations of color produced by changes in intensity or value."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2019> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/378> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Composition"@en ;
    skos:scopeNote "The arrangement of distinct elements within a work of art in a cohesive way that turns them into a meaningful and formal unity. In the classical tradition, triangular or pyramidal compositions were used because they created a sense of balance and harmony by arranging the figres into a stable overall geometric structure. To the extend that modern art rejected that tradition, the idea of correct composition was revised or even abandoned.&nbsp;&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2022> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Orientalism"@en ;
    skos:scopeNote "A trend of the western art of the 19th century referring to the pictorial representation of the cultutal zone of Near East and its ideological interpretation by western artists.&nbsp;<br />&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2023> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/378> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Sfumato"@en ;
    skos:scopeNote "Italian term referring to the special painting technique of building the form through slight and smooth variations of tone and without the use of clear and distinct lines."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2025> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/248> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Art criticism"@en ;
    skos:scopeNote "The writing practice that evaluates the art of its time."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2026> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1988> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Trierarchies"@en ;
    skos:scopeNote "One of the occasional liturgies associated with the naval power of ancient Athens. From the early 5th century the Athenian strategoi chose for one year from the wealthiest citizens a number of trierarchs corresponding to the number of triremes to be manned. The costs involved the expenses both for the repair and maintenance of the ship and for the food and payment of the crew. The institution of trierarchy was abolished in 307 BC."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2027> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/309> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ethnic groups"@en ;
    skos:scopeNote "Populations that regard themselves as distinct peoples bound by common origins, shared experience and culture, and quite possibly a distinct language and religious practice. This act of self-identification is always made with reference to other groups with whom an ethnic population interacts or shares an area or both."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2028> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/127> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Subaltern groups"@en ;
    skos:scopeNote "Groups that are socially and politically outside the hierarchy of power, and lack any autonomy in the sense of specific social subjects, being thus exluded from the structure of economic and cultural hegemony."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2032> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/127> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Slaves"@en ;
    skos:scopeNote "People who are reduced to the status of property under one or more owners. Therefore, they are robbed of any personal, civil and political rights, are subject to forced labour and concubinage, and may be bought, sold, and handed over. Slaves are subject to a legal status that defines their position as property assets (and sometimes concedes them some rights in regard to their owners' behaviour towards them) or are placed <em>de facto</em> in this situation, even though it is prohibited by law."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2041> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/26> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Age groups"@en ;
    skos:scopeNote "Groups within a specific population, which are made of individuals who belong to the same (or approximately the same) biological age and/or undergo collectively the same socialization and coming-of-age experiences. Age groups are regarded either as distinct collectivities within a population or as methodological tools for social research."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2049> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/148> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Linseed cultivation"@en ;
    skos:scopeNote "Branch of horticulture which deals with the cultivation of flax."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2050> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/157> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Gardening"@en ;
    skos:scopeNote "The cultivation and maintenance of gardens as a recreational or professional activity."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2055> a skos:Concept ;
    skos:altLabel "Tree farming"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/148> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Arboriculture"@en ;
    skos:scopeNote "Branch of horticulture which deals with the cultivation of fruit and ornamental trees and shrubs."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2056> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/148> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Tobacco cultivation"@en ;
    skos:scopeNote "Branch of horticulture which deals with the cultivation of tobacco."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2057> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/148> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cereal cultivation"@en ;
    skos:scopeNote "Branch of horticulture that deals exclusively with the cultivation of starch seeds such as oats, barley, rice, rye, wheat, etc., which are an essential foodstuff for humans and animals."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2063> a skos:Concept ;
    skos:altLabel "Olive cultivation"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/148> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Olive farming"@en ;
    skos:scopeNote "Branch of horticulture which deals with the cultivation of olive trees."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2064> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/148> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Viticulture"@en ;
    skos:scopeNote "Branch of horticulture which deals with the cultivation of vines."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2074> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/285> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ekphyllophoria (Ancient Greece)"@en ;
    skos:scopeNote "A type of vote that appears in ancient Athens. In the ekphyllophoria, members of the Council voted to expel one of its members on grounds that he had committed a punishable act. The voter's decision (YES/NO) was written on olive leaves."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2075> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/26> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Mitroxenoi"@en ;
    skos:scopeNote "A term used in ancient Greece for children born to a foreign mother. The mitroxenoi had full political rights as citizens with indigenous parents. In ancient Athens, this was ceased by the enforcement of a law voted in 451/0 BC, a measure attributed to Pericles, by which Athenian citizens were considered only those who had both Athenian parents."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2098> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2097> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Incised technique of inscriptions"@en ;
    skos:scopeNote "A technique of imprinting inscriptions on the material bearing the inscription by incising the text on a hard surface."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2115> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2097> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Dipinti technique of inscriptions"@en ;
    skos:scopeNote "A technique of imprinting inscriptions on the material bearing the inscription, whereby the text is painted on the surface of the object in color."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2117> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2097> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Dotted technique of inscriptions"@en ;
    skos:scopeNote "A technique of imprinting inscriptions on the material bearing the inscription, whereby the letters are formed in successive dots."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/213> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Eclecticism"@en ;
    skos:scopeNote "A term, rather than a style, used to describe the combination of different elements from various historical styles, principally in architecture, but also in the fine and decorative arts."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2145> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2097> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Impressed technique of inscriptions"@en ;
    skos:scopeNote "A technique of imprinting inscriptions on the material bearing the inscription, whereby the letters are stamped on the surface of the object so that they appear embossed."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2151> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2097> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Εpithesis technique of inscriptions"@en ;
    skos:scopeNote "A technique of imprinting inscriptions on vessels, whereby the letters are formed from the same material that the vessel is made of and appear as prints on its surface. During the Roman period a similar practice of fitting letters made of metal to special holes on monumental public inscriptions was adopted."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2161> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1093> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Casualty lists"@en ;
    skos:scopeNote "Inscriptions containing lists of names of men fallen in battles. It was common for these lists to be used as funerary inscriptions erected by decision of the Council and the Assembly."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2168> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2167> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Graphe alogiou"@en ;
    skos:scopeNote "A legal procedure that occured in ancient Athens. Archons who did not provide financial accounts (logoi), upon the termination of their office for the public money they managed, were publicly prosecuted by means of the graphe alogiou."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2169> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2167> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Graphe xenias"@en ;
    skos:scopeNote "A legal procedure that occured in ancient Athens. Through the graphe xenias any citizen could bring a public prosecution against someone who was registered in the registries of the Demos and therefore could participate in the Assembly as an Athenian citizen, although he was not entitled to it, such as the metics."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/217> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cubism"@en ;
    skos:scopeNote "Generally acknowledged to have been the most significant movement in 20th-century art, Cubism was created in the period 1907-1914. It abandoned the traditional fixed viewpoint which had dominated western painting since the Renaissance, and instead explored a multiplicity of viewpoints to develop an accumulated idea of the subject. Among the movements which took Cubism as a starting point or an essential component were Constructivism and Futurism."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2170> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2167> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Graphe yvreos"@en ;
    skos:scopeNote "A legal procedure that occured in ancient Athens. Through the graphe yvreos any citizen could bring a public prosecution against someone who deliberately insulted the honor and reputation of a man or woman, free or slave."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2192> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1093> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Votive offerings catalogues"@en ;
    skos:scopeNote "Inscriptions which record catalogues that include an inventory of the tributes dedicated to a sanctuary. The recorded list is part of the handing over process when a new sanctuary treasurer took over from the previous one."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2196> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2185> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Artistic languages"@en ;
    skos:scopeNote "An artistic language or artlang is a constructed language designed for aesthetic pleasure. Language can be artistic to the extent that artists use it as a source of creativity in art, poetry, calligraphy or as a metaphor to address themes as cultural diversity and the vulnerability of the individual in a globalizing world. Unlike engineered languages or auxiliary languages, artistic languages often have irregular grammar systems, much like natural languages. Many are designed within the context of fictional worlds, such as J. R. R. Tolkien&#39;s Middle-earth. Others can represent fictional languages in a world not patently different from the real world, or have no particular fictional background attached."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2197> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2158> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Constructed languages"@en ;
    skos:scopeNote "A constructed language (sometimes called a conlang) is a language whose phonology, grammar, and vocabulary, instead of having developed naturally, are consciously devised. Constructed languages may also be referred to as artificial languages, planned languages or invented languages and in some cases fictional languages. Planned languages are languages that have been purposefully designed. They are the result of deliberate controlling intervention, thus of a form of language planning."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2199> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1093> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Tribute lists"@en ;
    skos:scopeNote "Inscriptions recording 1/60th of the tax (aparchai) offered annually to the goddess Athena by cities participating in the Delian League (478/7 BC). From 443/2 BC onwards the names of the cities were listed by geographical regions along with the corresponding amounts recorded in the acrophonic number system."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2203> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/20> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Proben (Darstellende Künste)"@de,
        "Rehearsals"@en ;
    skos:scopeNote "A practice session to prepare a play or other performance for presentation before an audience."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2206> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/20> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Premiere"@de,
        "Premieres"@en ;
    skos:scopeNote "A premiere is the first public performance or showing of a play or film, dance, or musical composition and more generally an organised spectacle."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2207> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1701> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Choreografie"@de,
        "Choreography"@en ;
    skos:scopeNote "Choreography is the art of designing and composing sequences of movements of physical bodies (or their depictions) and involves determining the pace, flow, structure, and execution of a piece of dance, or any other piece of rehearsed movement."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2208> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/625> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ingenue"@de,
        "Ingénue"@en ;
    skos:scopeNote "The ing&eacute;nue is a stock character in literature, film, and a role type in the theatre. Typically, a girl or a young woman who is endearingly innocent, beautiful, and often na&iuml;ve, in mental or emotional danger rather than physical danger. Ing&eacute;nue may also refer to a new young actress or one typecast in such roles."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/221> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Neoclassicism"@en ;
    skos:scopeNote "A reaction to Rococo, Neoclassicism was born of the Enlightenment idea that human affairs should be ruled by reason and the common good rather than by tradition. From the mid-18th century, infatuation with the antique encouraged the development of a neoclassical movement in art throughout Europe."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2213> a skos:Concept ;
    skos:altLabel "Engelangs"@en,
        "Engilangs"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2159> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Engineered languages"@en ;
    skos:scopeNote "Engineered languages are constructed languages devised to test or prove some hypotheses about how languages work or might work. There are at least three subcategories, philosophical languages (or ideal languages), logical languages (sometimes abbreviated as loglangs), and experimental languages. Raymond Brown describes engineered languages as &quot;languages that are designed to specified objective criteria, and modeled to meet those criteria&quot;. Some engineered languages have been considered candidate global auxiliary languages, and some languages intended as international auxiliary languages have certain engineered aspects."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2216> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/26> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Refugees"@en ;
    skos:scopeNote "According to the Geneva Convention of 1951, refugees are persons \"who are outside their country or origin and unable or unwilling to return there or to avail themselves of its protection, owing to well-founded fear of persecution for reasons of race, religion, nationality, membership of a particular social group, or political opinion.\" Legal definitions such as the above, however, fail to capture the multiplicity of refugees and migrants in history. In this sense, refugees can be regarded as persons who flee their domicile because of persecution, ethnic cleansing, expulsion, natural catastrophes, and dire economic or environmental conditions that render social reproduction or even mere survival impossible."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2219> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/26> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Revolutionary groups"@en ;
    skos:scopeNote "Organisations of like-minded theoreticians and activists that are formed with the aim to prepare, organise and conduct revolutionary movements. As a rule, revolutionary organisations act in illegal circumstances and are often treated by the establishment as terrorist groups or even secret societies with dubious goals. They often constitute radical fractions within political organisations and they may evolve into political parties after the outbreak (and potential success) of the revolutionary movements."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2220> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/26> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Elites"@en ;
    skos:scopeNote "Groups of people who occupy the most influential roles and positions in the most important spheres of social life. The members of the elites come usually (but not exclusively) from the higher social strata and possess high social capital. Elites tend to form personal relations among their members and to promote their internal reproduction."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2222> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2253> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Secret societies"@en ;
    skos:scopeNote "Οrganizations whose activities, functioning or membership are concealed from non-members. Secret societies have their own particular set of rituals and beliefs, their founding myth and their mission, that give the members a common ethos and sustain them as parts of a distinct collectivitiy. Secret societies can be elite or non-elite, defined by age, gender or profession; they can be religious, sectarian or political, subversive or deep-state. Their secrecy is due to issues of legality, elitism, and formation of niches and networks of influence and power. Secret societies, real and fictional, have very often been objects of conspiracy theories, propaganda and demonisation."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2224> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/26> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Resistance groups"@en ;
    skos:scopeNote "Organisations created in order to withstand an occupying power or a regime by force and/or by acts of civil disobedience. Resistance organisations have specific ideological and political characteristics, as well as social origins."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2225> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2097> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Embossed technique of inscriptions"@en ;
    skos:scopeNote "A technique of imprinting inscriptions on the material bearing the inscription, whereby the letters are engraved on the metal plate by hitting the antennas of letters on the reverse surface of the metal plate so that the letters appear on the obverse."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2227> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2158> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Technical communication systems"@en ;
    skos:scopeNote "Technical communication is a broad field and includes any form of communication that exhibits one or more of the following characteristics: communicating about technical or specialised topics, such as computer applications, medical procedures, or environmental regulations; communicating by using technology, such as web pages, help files, or social media sites; providing instructions about how to do something, regardless of how technical the task is or even if the technology is used to create or distribute that communication. The value that technical communicators deliver is twofold: They make information more useable and accessible to those who need that information, and in doing so, they advance the goals of the companies or organisations that employ them."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2231> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2232> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Symphony orchestras"@en ;
    skos:scopeNote "Musical ensemble consisting of musicians playing string, wind (wood and brass) and percussion instruments of the European musical tradition. Symphony orchestras are ensembles of a few dozens to more than a hundred players, depending on the musical genre and on the period the respective work was created. The roots of the symphony orchestra are to be found in the musical ensembles of religious music and, mostly, in the opera orchestras of the Baroque. Crucial in the development of symphony orchestras was the gradual autonomy of instrumental classical music from song, which led to the emergence of the symphony as the par excellence musical form from the classical period onwards. Since the 19th and, mainly, in the 20th century, symphony orchestras became important cultural institutions in the big cities of Europe and North America, and gradually of the whole world, while orchestra conductors acquired the status of great artists and celebrities at the same time."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2235> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2234> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Olympic Games"@en ;
    skos:scopeNote "Series of athletic festivals that originated in ancient Greece and was revived in the late 19th century. Today it includes a great number of individual and group sports competitions. Before the 1970s the Games were officially limited to competitors with amateur status, but in the 1980s many events were opened to professional athletes. Currently, the Games are open to all, even the top professional athletes. In 1924 the Winter Games were sanctioned for winter sports (as separate festivals). The Olympic Games have come to be regarded as the world’s foremost sports competition. They take place every four years, attract a vast publicity, and sustain a global market of media, advertising, athletic, and touristic goods and services."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2237> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Bailo (Venetian office)"@en ;
    skos:scopeNote "Permanent envoy of the Venetian Republic in the Ottoman Empire. The name bailo, which at the beginning referred only to Muslim officials, was given to many European officials in the Middle Ages. At that period, the office of a Venetian bailo was only a little different from that of consul. In the Modern Age, the only bailo still existing was that in Constantinople, while, since the 15th century, resident ambassadors had also made their appearance in international relations. The Venetian bailo continued to be responsible for all the Venetian consuls living in the Ottoman Empire but he began to deal more and more with international relations and with the highest authorities of the state. Eventually, in 1575, a law officially recognized the status of the bailo as equal to that of a resident and his position as equal to that of an ambassador."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2241> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2040> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Christian monastic orders"@en ;
    skos:scopeNote "Organisations of monastic communities with common practices enforced by a centralised administration. The Christian monastic orders emerged in the 12th century in Western Christianity and have since then constituted an important factor in the organisation of Christian religious life and activity, particularly in the Catholic Church."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2242> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2253> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "State and government bodies"@en ;
    skos:scopeNote "Collective bodies that undertake the administrative and governance functions of a sovereign state. The growth of state and government bodies began in the early modern period and reached a high point with the emergence of the modern state, administrative bureaucracy, and with the expansion of governmentality in an increasingly wider spectrum of social and political life."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2244> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/157> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cultural heritage management"@en ;
    skos:scopeNote "Cultural heritage management involves the identification, protection, and stewardship of cultural heritage in the public interest. It is part of a burgeoning interest in heritage generally and the subject of increasing discussion, debate, and controversy among both specialists (including archaeologists, anthropologists, legal scholars, collectors, curators, historians, political scientists, economists, conservators, etc.) and the public."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2245> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/21> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Invented traditions"@en ;
    skos:scopeNote "Sets of practices created more or less arbitrarily in order to support an unbroken continuity with the past. Invented traditions impose specific values and norms of behaviour by legitimising them as authentic expressions of historical continuity in order to fulfill social and cultural aspirations and aims."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2247> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/157> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Thermalism"@en ;
    skos:scopeNote "Specialisation in the theory, practice, and services concerning the use of thermal springs for therapy and wellness. The formation of a thermalist theory and practice dates back to Greco-Roman antiquity. Since the 19th century, thermalism was organised medicinally and became a distinct category of therapeutic treatments for several ilnesses and of wellness tourism."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2248> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/168> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Thermal establishments"@en ;
    skos:scopeNote "Facilities and building complexes near thermal springs that provide thermalist services. Thermal establishments date back to Greco-Roman antiquity and in the course of time have taken many forms and social functions (<em>thermae</em>, <em>balnae</em>, <em>kaplıca</em>, spa etc.). Since the 19th century thermal establishments have grown in size for accommodating multiple services. They are often concentrated in centers of therapy and wellness tourism (spa towns) and play an important role in local economy."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2250> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2249> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Religious tourism"@en ;
    skos:scopeNote "Form of tourism that is mainly expressed in visiting religious monuments, following religious practices, and taking part in religious pilgrimages. Religious tourism is motivated by specific religious precepts, by the desire for experiences of faith, by a quest of spirituality, or even by expectations of purification and healing. The roots of religious tourism lie in the pilgrimage practices inherent in many world religions."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2251> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2249> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Curative tourism"@en ;
    skos:scopeNote "A form of tourism that aims at finding cure and wellness through medical and cosmetic treatment, alternative therapies, and activities for bodily, psychological, and spiritual relaxation."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2252> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2160> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Acoustic animal communication systems"@en ;
    skos:scopeNote "Acoustic communication is exceedingly common in nature, possibly because sound can be adapted to a wide variety of environmental conditions and behavioral situations. Sounds can vary substantially in amplitude, duration, and frequency structure, all of which impact how far the sound will travel in the environment and how easily the receiver can localise the position of the sender. For example, many passerine birds emit pure-tone alarm calls that make localisation difficult, while the same species produce more complex, broadband mate attraction songs that allow conspecifics to easily find the sender. A particularly specialised form of acoustic communication is seen in microchiropteran bats and cetaceans that use high-frequency sounds to detect and localise prey. After sound emission, the returning echo is detected and processed, ultimately allowing the animal to build a picture of their surrounding environment and make very accurate assessments of prey location."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2255> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2246> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Gestures (Visual animal communication systems)"@en ;
    skos:scopeNote "The best known form of communication involves the display of distinctive body parts, or distinctive bodily movements; often these occur in combination, so a movement acts to reveal or emphasize a body part. A notable example is the presentation of a parent herring gull’s bill to its chick as a signal for feeding. Like many gulls, the herring gull has a brightly coloured bill, yellow with a red spot on the lower mandible near the tip. When the parent returns to the nest with food, it stands over its chick and taps the bill on the ground; this elicits a begging response from a hungry chick (pecking at the red spot), which stimulates the parent to regurgitate food. The complete signal therefore involves a distinctive morphological feature (body part), the red-spotted bill, and a distinctive movement (tapping towards the ground) which makes the red spot highly visible to the chick. While all primates use some form of gesture, Frans de Waal concluded that apes and humans are unique in that only they use intentional gestures to communicate. He tested the hypothesis that gestures evolve into language by studying the gestures of bonobos and chimps."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2256> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/157> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Tourism (discipline)"@en ;
    skos:scopeNote "Tourism as a discipline is a vast and global system of professional specialisations concerning services, goods, networks, infrastructure, transport, accommodation, advertisement, economic analysis, and planning that deal with the organisation and management of tourist flows."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2257> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2249> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cultural tourism"@en ;
    skos:scopeNote "Form of tourism that centers on visits οf monuments and sites of cultural and historic importance. Cultural tourism is a reaction to the mass tourism of the second half of the 20th century. It is included in post-industrial consumption patterns that promote personalised services and experiences of recreation and knowledge, which give meaning to notions of identity and alterity. Cultural tourism originates in the tradition of the educational voyages of the European elites. It is now supported by an international system of services and promotion that deploys widely spread narratives of cultural traditions, history, and authenticity."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2258> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2249> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Walking tourism"@en ;
    skos:scopeNote "Form of tourism centered on the practice of peripatetic walking in sites of cultural and/or natural interest that aims at embodied experience and close acquaintance with the place. Walking tourism is included in the wider category of \"slow\" tourism which, in contrast to mass tourism, emphasises traveling in environmentally friendly and economically sustainable ways."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2259> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2249> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Mass tourism"@en ;
    skos:scopeNote "Τravel by groups on pre-scheduled tours organised by tourism companies. Mass tourism originates in the second half of the 19th century in the coastal towns of Britain but became an international phenomenon after World War II. Its rise was due to transport innovations, to the consolidation of a welfare system, to the increase of the middle and working classes' real income, and to the democratisation of leisure time. By extending the principle of industrial capitalism and consumerism to the realm of leisure time, mass tourism has developed to a vast global economy profoundly affecting the societies, the resources and the natural environment of tourist destinations."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2261> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Horistis (city-state period)"@en ;
    skos:scopeNote "An office that appears in ancient Greece. The horistai were responsible for setting the boundaries of public or private lands."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2262> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Horkotis (city-state period)"@en ;
    skos:scopeNote "An office that appears in ancient Athens. The horkotai were citizens who accepted the oaths of another city when the cities were forming an alliance."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2264> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Social representations"@en ;
    skos:scopeNote "Sets of concepts, statements and explanations originating in daily life in the course of inter-individual communication. Social representations constitute a society's values, ideas, beliefs and practices, and function both as rule systems structuring social life and as codes facilitating communication."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2265> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Blasphemy"@en ;
    skos:scopeNote "Statement or attitude that is considered as a profanation of established religious orders, beliefs and morals. Blasphemy is in fact a social transgression that is taken to embody disrespect and threat for the established order, and often induces punishment. Therefore, it is a culturally relative category that is framed in terms of the orthodox discourses and the institutions that define it and interpret/ rerpoduce it."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2266> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Mentalities"@en ;
    skos:scopeNote "Attitudes of ordinary people towards everyday life, including ideas concerning childhood, sexuality, family, time, and death. This approach is closely identified with the French Annales school of historiography. The historians who investigate mentalities examine the psychological realities underpinning human conceptions of intimate relationships and basic habits of mind."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2267> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/21> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Censorship"@en ;
    skos:scopeNote "A set of formal and informal, overt and covert processes by which restrictions are imposed on the collection, display, dissemination, and exchange of information, opinions, ideas, and imaginative expression. Censorship has been -and is- conducted mainly by public and private centers of power like governments, private institutions, corporations, religious, political, and media organisations."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2268> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2246> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Facial expressions (Visual animal communication systems)"@en ;
    skos:scopeNote "Facial gestures play an important role in animal communication. Often a facial gesture is a signal of emotion. Dogs, for example, express anger through snarling and showing their teeth. In alarm their ears perk up, in fear the ears flatten while the dogs expose their teeth slightly and squint their eyes. Mogil studied the facial expressions of mice during increments of increasing pain; there were five recognizable facial expressions; orbital tightening, nose and cheek bulge, and changes in ear and whisker carriage."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2291> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/309> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Levantines"@en ;
    skos:scopeNote "Ethnocultural group of the Ottoman Empire that consisted of Catholic Christians who originated either from European settlers in Ottoman territories or from local Christians. The latter had developed close relations with a European diplomatic mission and had thus acquired the legal status of protection from a foreign power, a fact that granted to them tax privileges and some degree of extraterritoriality. In the 18th and 19th centuries the Levantines became a characteristic trait of the empire&#39;s important trade centres, like Istanbul, Smyrna, and Aleppo. Being for the most part merchants, interpreters, and middlemen, they developed marriage strategies that led them either to endogamy or to intermarriage with Europeans, Greeks, Armenians, or Catholic Arabs, in order to strengthen and expand their networks of activity."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2294> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/380> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cittadini (Ionian Islands)"@en ;
    skos:scopeNote "Members of a prominent urban social group that constituted an administrative aristocracy, had a monopoly over communal offices, and reproduced its power through family and patronage networks. The cittadini emerged as a distinct oligarchic group in the Ionian Islands under Venetian rule, particularly from the 16th century onwards."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2295> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/380> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Popolari (Ionian Islands)"@en ;
    skos:scopeNote "Members of the urban population in the Ionian Islands under Venetian rule. The popolari were an intermediate group between the \"citizens\" (cittadini) and the peasants and did not constitute a recognised social order. They included the various professionals and artisans, as well as the merchants, the tax farmers, and the members of the liberal professions, provided they were excluded from the group of the cittadini. The popolari, in particular their upper strata, were in conflict with the cittadini and pushed for participation in the communal offices and the administration."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2297> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/240> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Theater der Grausamkeit"@de,
        "Theatre of cruelty"@en ;
    skos:scopeNote "Term coined in the 1930s by Antonin Artaud to describe his manifesto theory for the theatre he envisaged. Attacking Western bourgeois culture en bloc, he championed the necessity for an uncompromising mise-en-sc&egrave;ne, that would disentangle theatre from literature and the tyranny of the word, bringing together actor and spectator in a mystical and shocking experience. The latter entailed subjecting the spectators to emotional shock treatment, to free them from the grip of discursive and logical thought. He sought to combine his theories with elements of Eastern dance drama to create a violent and ritualistic form of theatre. The text is offered in a kind of ritual incantation (rather than being spoken in the mode of psychological interpretation). The whole stage is used as in a ritual, as a producer of images (hieroglyphs) addressed to the spectator&#39;s unconscious. The innovative ideas introduced in relation to the spiritual and the holistic view of art, the cultural and anthropological interest in performance, the imagist and sensuous conception of the theatre event, the new role of the audience as one of participation and visceral involvement, the redefinition of the performance text and the emphasis on theatre as a process and not a finished product had a profound impact on the physical experiments of the 1960s and 1970s."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2299> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/240> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Dokumentarisches Theater"@de,
        "Documentary theatre"@en ;
    skos:scopeNote "Twentieth-century extension of historical drama or the pi&egrave;ce &agrave; th&egrave;se, the documentary theatre uses pre-existing documentary material (such as newspapers, government reports, interviews, journals, correspondence, photos etc.) as source material for stories about real events and people, frequently without altering the performance&#39;s text. On the documentary performance level, Εpic theatre techniques are used to present critiques of dominant ideologies dialectically. Information becomes the protagonist through a rhetoric of fact that gives the action its credibility. The major functions of documentary theatre are to reassess national/local histories, to celebrate communities/marginalised groups and their histories and to investigate important events and issues past and present."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2300> a skos:Concept ;
    skos:altLabel "Sephardic Jews"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/309> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Sephardi Jews"@en ;
    skos:scopeNote "Jews of the Iberian Peninsula who were expelled from their homes in the late 15th and during the 16th century, after the demise of the last Islamic states in the region. The term &quot;Sephardi Jews&quot; refers to the refugees themselves, who settled at first in regions of the central and eastern Mediterranean, and subsequently in regions of western Europe and America, but also to their descendants, who formed a distinct ethno-cultural group with its own Romance (ladino, known also as &quot;Judeo-Spanish&quot;), folk and elite traditions, social structures and networks."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2301> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/309> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ashkenazi Jews"@en ;
    skos:scopeNote "Jews of eastern and central Europe, mostly speakers of Yiddish, a German-based language. One of the Ashkenazi&#39;s origins is, according to many, the region of the Rhine valley, where a distinct Jewish etho-culrtural group was formed during the Middle Ages, which dispersed towards the east after the massacres and persecutions during the Crusades. The Ashkenazi were often the victims of persecutions, which contributed to migratory flows to western Europe and, later, to America, mostly the USA, while the rise of Zionism led to migration to Palestine. The Ashkenazi were the main victims of the Shoah perpetrated by the Nazis. Most European communities were decimated and the centre of Ashkenazi life shifted to America and the state of Israel."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2303> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1090> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Melodram"@de,
        "Melodrama"@en ;
    skos:scopeNote "Dramatic genre that appeared in Europe at the turn of the 18th to the 19th century. The term was originally applied to scenes of mime or spoken dialogue accompanied by music. Melodrama combines prose with music to underscore dramatic effect, the tragic with the comic, spectacle with excess and codified structure with stock heroes and heroines that meet the expectations of the large audience. Melodramatic plays feature a sensational plot, an impressive adventure story, improbable and unexpected twists of fate, successive alternation of intense emotions, aiming to generate responses from the spectators, recognisability of the characters in terms of their moral standing; they deal with the eternal battle of good and evil, rendering in the end a sense of justice, with the punishment of the villains and the triumph of virtue. The genre lost its impetus early in the 20th century, but survived in various forms in modern cinema and television."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2305> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/240> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Vaudeville"@de,
        "Vaudeville"@en ;
    skos:scopeNote "Theatrical genre born in France. Originally, the term denoted a show composed of songs, acrobatics, and monologues. In the nineteenth century, vaudeville became, with playwrights as Scribe, and then Labiche and Feydeau, a light comedy of intrigue without songs, rich in intricacies (usually erotic) that arise from chance encounters and misunderstandings, coincidences, and surprises."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2306> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2563> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Pantalone"@de,
        "Pantalone"@en ;
    skos:scopeNote "Pantalone is the most prominent representative of the elderly types of Commedia dell&rsquo; arte, depicting the Venetian merchant. Jealous, stingy, and bitter, he derives his origin from the senex in Roman comedy and reproduces all the frailties of the elderly of every age and of his society. Strict and adherent of the absolute paternal authority in the family, a cunning husband, he relents in the end and accepts the love choice of his child. Respectful towards the priests and practicing confession, he secretly maintains a flexible and convenient morality, lending money with enormous interest or squandering it on mistresses."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2307> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2563> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Dottore"@de,
        "Dottore"@en ;
    skos:scopeNote "Il Dottore is a typical example of the elderly types of Commedia dell&rsquo; arte. Well-read and pedantic, he is primarily a verbal type, since what makes him stand out is the distinctive way he speaks. He used mainly a corrupted and exaggerated speech. Corruption is based on the alliteration, distortion of one word or its transformation into another with a similar sound, resulting in comic effects that make the speech either irrational or difficult to understand. Exaggerated speech based on obviousness has the same effect. His long-winded disquisitions, scholarly puns, and malapropisms were spoken in a jargon of Latin jumbled with local dialect."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2318> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/378> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Airbrushing"@en ;
    skos:scopeNote "A method of painting by means of a small mechanical paint sprayer in order to give an even and consistent surface often used to create a high level of realism. In the 1960s artists used it to evoke the qualities of advertising."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2321> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/285> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Klerosis ek prokriton"@en ;
    skos:scopeNote "Type of lottery that appeared in the 5th century BC. in Athens. This system combined election and lottery. For example, it was used for the election of the nine archons; candidates for the offices of the archons were elected from each tribe (ten first, one hundred later), and among them, a lottery was held to determine who would assume the office."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2327> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/285> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Klerosis apo kiamou"@en ;
    skos:scopeNote "Type of lottery for the election of members of the Council that appeared in the 5th century BC in Athens. The procedure was as follows: Two urns were set up. One contained the names of the members of the tribe who had put themselves forward as candidates. The other contained an equal number of beans, a number of white beans equal to the number of Council members, while the remaining beans were black. A name was then drawn from one urn and a bean from the other. If the bean was white, the candidate was selected, if it was black he was rejected."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/233> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Romanticism"@en ;
    skos:scopeNote "A broad cultural manifestation that can be seen simply as a late 18th- to early 19th-century reaction against the reason of the Enlightenment and the order of Neoclassicism. Implicit to this process were beliefs in the primacy of individual experience and in the irrational as well the rational."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/235> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2391> a skos:Concept ;
    skos:altLabel "Edres (Ancient Greece)"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Edrai (Ancient Greece)"@en ;
    skos:scopeNote "Τhe sessions of the Council in ancient Athens, which were held in the Bouleuterion, where the texts of decrees of the Assembly were kept. Sessions related to issues of naval equipment took place in the dockyard.&nbsp;&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2395> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/618> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:scopeNote "Works that use non-art elements, often junk and/or debris, to form a three-dimensional work of art by combining various elements. Assemblages are sculptural works created since about 1945. They may include elements painted, carved or modeled by the artist."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2403> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/900> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Aquatint"@en ;
    skos:scopeNote "An intaglio etching technique in which a metal plate is sprinkled with a finely-powdered resin; the plate is heated to melt the resin, then cooled, and placed in an acid bath. The acid lightly etches areas not covered with resin."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2405> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/378> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Foreshortening"@en ;
    skos:scopeNote "In pictorial representation, the diminishing of certain dimensions of an object or figure in order to indicate its recession into pictorial space."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2408> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1321> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "History painting"@en ;
    skos:scopeNote "Painting genre with subject matter inspired from classical literature (ancient history, mythology and the Bible).&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2409> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/378> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Decalcomania"@en ;
    skos:scopeNote "Technique of transferring pictures and designs from specially prepared paper onto a surface, such as glass. In surrealist painting, paint was spread over some parts of the canvas, then glass or a sheet of paper was pressed onto it. Chance air bubbles, rivulets and branchings of paint producing a varied surface structure also came about when the glass or paper was lifted from the canvas."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/241> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Mannerism"@en ;
    skos:scopeNote "A confusing term, subject to radically different interpretations but generally used to describe the art in Italy which directly succeeded that of the Renaissance and preceded the Baroque. Its first widespread use, in the 17th century, was pejorative, implying an overelaborate distortion, an imbalance, and a neurosis."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2410> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/378> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:scopeNote "A term of French origin describing the process used by artists of the <em>nouveau realisme</em> movement in the 1960s, to remove an element from a public space surface (usually posters) in order to be used as a new work."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2411> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/378> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:scopeNote "Pictorial technique of deceiving the eye, applied to images so realistic that they may fool the viewer into thinking that the represented objects are real rather than images. Effects include faux windows, false frames etc."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2412> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/150> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Figurative art"@en ;
    skos:scopeNote "Figurative art describes any form of modern art that retains strong references to the real world and particularly to the human figure."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2413> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/89> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Touring"@en ;
    skos:scopeNote "The mode of touring around a foreign -usually exotic- land simply for leisure or in order to study the lifestyle of residents,&nbsp;to admire and study the remains of the Classical past and to collect art and antiquities."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2414> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/618> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Multiple"@en ;
    skos:scopeNote "A series of identical artworks, usually in a signed and limited edition made specifically for selling."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2415> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/378> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Perspective"@en ;
    skos:scopeNote "Refers to any graphic method concerned with conveying an impression of depth, usually on a two-dimensional surface, by means of geometric projection using foreshortening, and/or atmospheric effects. In Western art, the term generally refers to the geometrical technique of linear perspective that was invented in the early Renaissance."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2416> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/618> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:scopeNote "Τables depicting scenes or objects of daily life with an emphasis on their trivial side.&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2418> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1321> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:scopeNote "Painting (usually landscape painting) which is entirely executed out of doors and not in the closed space of the atelier.&nbsp; &nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2437> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/681> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Postposition"@en ;
    skos:scopeNote "Prepositions and postpositions, together called adpositions, are a class of words used to express spatial or temporal relations or mark various semantic roles. Postposition typically combines with a noun or pronoun, or more generally a noun phrase, this being called its complement, or sometimes object. A postposition comes after its complement."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2447> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/21> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Eisangelia (Ancient Greece)"@en ;
    skos:scopeNote "An institution that appears in ancient Athens, which enabled the Areopagos to examine any citizen who was accused of a serious crime, or of treason or dissolution of democracy."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/246> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/247> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Renaissance"@en ;
    skos:scopeNote "Originally a french term (‘renaissance’, ‘rebirth’) pertaining to cultural history, it is now employed to describe the arts in Italy from the early 14th to the mid-16th centuries. By extension it is also more loosely applied to other european countries of that era. Renaissance art was based on renewed study of the art of antiquity and of nature."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2473> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2029> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Monasteries (Christianity)"@en ;
    skos:scopeNote "Organised collectivities of Christians who have devoted themselves to monastic life at a particular place and under a common set of rules. Christian monasteries dispose of a set of buildings and dwellings for the performance of holy services and the accomodation of the monks or nuns, as well as some means of production that provide the necessary income of the monastery or simply guarantee the monks&#39; subsistence. In the course of time some monasteries acquired great property and functioned as important production units in their own right with cosiderable influence in public affairs, while some also developed significant libraries and became sites of knowledge production and reproduction. Monasteries are organised according to an adminstrative structure under the governance of a prior. In the history of Western Christianity, the monasteries&#39; networks and their relationship with Church authorities depended on the development of distinct monastic orders. In Eastern Christianity, monasteries retained to a larger extent the traditions of early Christianity, with the main divide between monasteries being whether they are autonomous or not from local Church administration. The tradition of cenobitic monasteries has become prevalent, with the idiorrhythmic (&quot;self-regulated&quot;) monasteries having as a rule been absorbed by larger cenobitic ones."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2482> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1696> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Proboulos (city-state period)"@en ;
    skos:scopeNote "An office that appears in city-states in ancient Greece. In particular, in Athens at the end of 413 BC, after the catastrophic Sicilian expendition, the Assembly chose ten elders, who were to exercise some of the duties of the Council and the prytaneis (that is, they would approve matters for discussion by the Assembly) and would propose measures for the salvation of the city.&nbsp;&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/249> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Symbolism"@en ;
    skos:scopeNote "From c. 1880 to c. 1900, following and in contrast to Realism and Impressionism, Symbolism was a movement in literature as well as the visual arts. In ways an expression of Romanticism, Symbolism was also subjective and emotional rather than objective and detached."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2493> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Prodikiai"@en ;
    skos:scopeNote "A term that appears in ancient Greece. Prodikia was the privilege granted to someone in order to have his case heard first."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2494> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Epidoseis (Ancient Greece)"@en ;
    skos:scopeNote "Type of voluntary offer from the citizens in ancient Athens. The majority of epidoseis were related to military operations and to a minor extent to other purposes such as sacrifices, purchases of grain etc. The city demanded an extraordinary voluntary contribution of money from the citizens, determining the highest and the lowest amount. The contributors were rewarded by the state with different honors."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2495> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Promanteiai"@en ;
    skos:scopeNote "A term that appears in ancient Greece. The promanteia wasthe privilege granted by the Delphi sanctuary to someone to receive an oracle before others. This privilege was given by the priesthood of Delphi to cities or (from the beginning of the 4th century BC.) to persons who had benefited the sanctuary. Often, this privilege was combined with others such as the prothysis."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2504> a skos:Concept ;
    skos:altLabel "Five-hundred-bushel men"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/26> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Pentakosiomedimnoi"@en ;
    skos:scopeNote "One of the four classes in which Athenian citizens were divided from the 6th century BC according to the income their property could generate. The class of pentakosiomedimnoi consisted of citizens whose land yielded at least 500 medimnoi of corn or the equivalent in other produce. Initially, archons were chosen among citizens from this class. Later members of other classes could also hold senior offices."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2524> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2463> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Philosophical psychology"@en ;
    skos:scopeNote "Philosophical psychology investigates folk psychology, a body of commonsensical, protoscientific views about mental phenomena. Such investigations attempt to articulate and refine views found in folk psychology about conceptualization, memory, perception, sensation, consciousness, belief, desire, intention, reasoning, action, and so on."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2537> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1860> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Poetry (body of works)"@en ;
    skos:scopeNote "The body of literary compositions usually in metered or free verse, which follows rhythmic patterns. Sometimes the boundaries between poetry and prose are blurred, as in the case of prose poems or in the case of novels written in metered verse."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2539> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1858> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "History of literature"@en ;
    skos:scopeNote "The study of literary trends and movements over time."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2543> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1659> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Hyperbaton"@en ;
    skos:scopeNote "Hyperbaton is a figure of speech in which the typical, natural order of words is changed, as certain words are moved out of order.&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2544> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1659> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ηindmost foremost"@en ;
    skos:scopeNote "<br />Α figure of speech in which we first mention an act or a concept to emphasize it, while another relevant one should have preceded it.&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2545> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1659> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Epanalepsis"@en ;
    skos:scopeNote "The repetition at the end of a line, phrase, or clause of the word or words that occurred at the beginning of the same line, phrase, or clause.<br /><strong>&nbsp;</strong>"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2546> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1659> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Omoioteleuton"@en ;
    skos:scopeNote "Similarity of endings of adjacent or parallel words. This figure is often combined with alliteration in accentuating the rhythm&nbsp;of parallel members."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2550> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/23> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Tourism facilities"@en ;
    skos:scopeNote "Buildings, building complexes and specially arranged spaces (hotels, restaurants, commercial centres, beaches, sports facilities, etc.) that offer to tourists services and products in connection to accommodation, food service, and various types of recreation."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2552> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1659> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Polysyndeton"@en ;
    skos:scopeNote "A figure of speech in which several coordinating conjunctions are used in succession in order to achieve emphasis.&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2553> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1659> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Oxymoron"@en ;
    skos:scopeNote "A figure of speech in which apparently contradictory terms appear in conjunction in order to achieve emphasis or to reveal a paradox (e.g. &quot;deafening silence&quot;).&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2555> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1659> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Synecdoche"@en ;
    skos:scopeNote "Α figure of speech in which a term for a part of something refers to the whole of something. A classic example of synecdoche is the use of the term&nbsp;<em>hands</em>&nbsp;to mean &ldquo;workers&rdquo;."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2556> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2232> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "String quartets"@en ;
    skos:scopeNote "Musical ensembles that consist of four musicians: two violinists, one viola player and one cellist. String quartets are included in chamber music ensembles. They appeared as a distinct type in the second half of the 18th century and were intended for private performance and enjoyment. Since the early 19th century, however, they were included in public concerts. String quartets, for which a multitude of important works has been composed, constitute until toady one of the most recognisable types of musical ensembles of western art music."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2559> a skos:Concept ;
    skos:altLabel "Verbal irony"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2558> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Irony (figure of speech)"@en ;
    skos:scopeNote "Figure of speech in which a word or phrase is used to convey a meaning that is the opposite of its literal meaning, typically for humorous or emphatic effect (e.g. &quot;what a great idea&quot; meaning a foolish idea)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2560> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2558> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Euphemism (figure of speech)"@en ;
    skos:scopeNote "Figure of speech in which a word or phrase with positive connotations is used in place of one considered to be too harsh, unpleasant or embarrassing. Euphemisms may be used to refer to taboo topics (e.g. &laquo;passed away&raquo; instead of &laquo;died&raquo;)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2562> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1659> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Hyperbole"@en ;
    skos:scopeNote "A figure of speech that involves exaggeration of statements or claims&nbsp;for the sake of emphasis (e.g. &quot;I am trying to solve a million issues these days&quot;)."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2572> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1738> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Monologic epistolary novel"@en ;
    skos:scopeNote "Epistolary novel which consists entirely of the main character&#39;s letters.&nbsp;&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2573> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1738> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Polylogic epistolary novel"@en ;
    skos:scopeNote "Epistolary novel consisting of the letters of two or more characters."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2576> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1731> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Picaresque novel"@en ;
    skos:scopeNote "Type of novel which emerged in the 16th century in Spain. The main character of the picaresque novel is the &quot;picaro&quot; (the Spanish word for &quot;rogue&quot;), and a typical story concerns the escapades of an insouciant rascal who lives by his wits and shows little if any alteration of character through a long succession of adventures.&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/259> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/20> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Group management"@en ;
    skos:scopeNote "This term classifies complex activities carried out by at least two individuals aimed at forming, modifying or dissolving any form (legal or illegal) of unitary relationships of any kind (economic, religious, athletic, political, etc.), which exhibit organizational characteristics. A precondition for the formation, modification or dissolution of these kinds of unitary relations is the adoption of certain common beliefs, goals, decisions and/ or shared actions."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2617> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2622> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Eleven (Collective authorities)"@en ;
    skos:scopeNote "Magistrates, selected by lot, in ancient Athens. They acted as caretakers for those imprisoned. Thieves and people enslaving free persons arrested in the act were immediately put to death by them, if they admitted their crime; if they did not, each case was introduced before the court. If the court decided that the defendant had committed the crime he was accused of, the Eleven were responsible for his execution. The Eleven also introduced cases of disputed property before the court before confiscation.&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2621> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/205> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Secondary production"@en ;
    skos:scopeNote "Secondary production is a production sector that makes use of primary production, with the processing of raw materials. Its individual branches are handicrafts, artisanship and industry. The secondary sector includes the processing of products, such as the production units of pasteurized milk, tomato paste, plastics, furniture, clothing, paper, etc."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2624> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1321> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Genre painting"@en ;
    skos:scopeNote "Type of painting having as subject matter scenes or events from everyday life.&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2634> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/378> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Mosaic construction"@en ;
    skos:scopeNote "The technique of composing images or decorative patterns by putting together small, colored and regularly shaped pieces of durable material (stone, glass, terracota) on a support made of ciment or other binder material.&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2637> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Yüzükcis"@en ;
    skos:scopeNote "Ring makers in the traditional societies of the Ottoman period. The word comes from &quot;y&uuml;z&uuml;k&quot; which means &quot;ring&quot; and the addition of the suffix -ci which in Turkish means professions. This occupation declined with industrialization and the emergence and gradual prevalence of the respective modern specialties and professions."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2638> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Atescis"@en ;
    skos:scopeNote "<br />Casting heaters in the traditional societies of the Ottoman period. The word comes from the Turkish &quot;ateş&quot; which means fire."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2639> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Astarcis"@en ;
    skos:scopeNote "Manufacturers or/and sellers of&nbsp;&quot;primer&quot;,&nbsp;lining in the traditional societies of the Ottoman period. &nbsp;This occupation declined with industrialization and the emergence and gradual prevalence of the respective modern specialties and professions."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2640> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Gaidacis"@en ;
    skos:scopeNote "Manufacturers or instrument players of bagpipes and&nbsp;tsambounas in the traditional societies of the early modern period."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2641> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Abacis"@en ;
    skos:scopeNote "Sellers of abba and/or tailors of male clothes from a thick woolen fabric called abba in the traditional societies of the Ottoman and early modern period. This occupation declined with industrialization and the emergence and gradual prevalence of the respective modern specialties and professions."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2642> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Vlatades"@en ;
    skos:scopeNote "Manufacturers and/or sellers of red silk fabrics called &ldquo;vlatia&rsquo;&nbsp;in the traditional societies of the Ottoman and early modern period. This profession declined with industrialization and the emergence and gradual prevalence of the respective modern specialties and professions.<br />&nbsp;"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2643> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Vourkacis"@en ;
    skos:scopeNote "Manufacturers and/or sellers of leather bags called &ldquo;vourka&rdquo;&nbsp;in the traditional societies of the Ottoman and early modern period. This profession declined with industrialization and the emergence and gradual prevalence of the respective modern specialties and professions."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2644> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Spindle makers"@en ;
    skos:scopeNote "Manufacturers and sellers of spindles&nbsp;in the traditional societies of the Ottoman and early modern period. This profession declined with industrialization and the emergence and gradual prevalence of the respective modern specialties and professions."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2645> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Herbalists"@en ;
    skos:scopeNote "&nbsp;<br />Herbalists, traders of spices, seasonings and other aromatic products in the traditional societies of the Ottoman and early modern period. This profession declined with industrialization and the emergence and gradual prevalence of the respective modern specialties and professions."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2646> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Amanecis"@en ;
    skos:scopeNote "Private postmen carrying packaged parcels called &quot;amanatia&#39;&#39; in&nbsp;the traditional societies of the Ottoman and early modern period. This profession declined with industrialization and the emergence and gradual prevalence of the respective modern specialties and professions."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2647> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Amelis"@en ;
    skos:scopeNote "Persons responsible for the reception and hospitality of foreigners in the community hostel of the village called &quot; ameliko&quot;<br />in the traditional societies of the Ottoman and the early modern period. This profession declined with industrialization and the emergence and gradual prevalence of the respective modern specialties and professions."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2648> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Gavata makers"@en ;
    skos:scopeNote "Manufacturers or/and sellers of gavata bowls, that is wooden or clay pots mainly used for food&nbsp;in the traditional societies of the Ottoman and the early modern period. This occupation declined with industrialization and the emergence and gradual prevalence of the respective modern specialties and professions."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/269> a skos:Concept ;
    skos:altLabel "Minimal Art"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Minimalism"@en ;
    skos:scopeNote "A type of abstract art, which is characterized by simplicity of form and a deliberate lack of expressive content. Its aim is a concentration on the pure qualities of colour, form, space, and materials without the distractions of \"composition\". It first emerged in the 1950s and flourished in the 1960s and 1970s. Minimal art was mainly an american phenomenon."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/280> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/32> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Communities (administrative units)"@en ;
    skos:scopeNote "Administrative units in the framework of a state institutional mechanism. Communities include one or several settlements and the adjacent territory; they are governed by bodies of representatives from among the inhabitants."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/292> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Neo-Impressionism"@en ;
    skos:scopeNote "A movement in french painting that developed from and in reaction to Impressionism. Neo-Impressionism (the term was devised in 1886) sought to apply a more rational and scientific method, whereby pure dots of colour, of equal size, gave a maximum of luminosity."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/293> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Superrealism"@en ;
    skos:scopeNote "A style of painting, and to a certain extent sculpture, popular in the United States and Britain from the late 1960s and characterized by its use of minute detail in its depiction of its subjects. Alternatively Hyperrealism is called Photorealism."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/299> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Myths"@en ;
    skos:scopeNote "Fables containing references to events, phenomena or collective experiences related to supernatural entities, gods, humans and/or animals. Myths express the beliefs and perceptions of the groups that reproduce them, with regard to their descent, the creation and the essence of the natural world, and the manners of social interaction."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/310> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Expressionism"@en ;
    skos:scopeNote "When used generally, this is a term which implies heightened subjectivity or emotion. More specifically, it is employed with reference to a self-conscious movement that is traced to the supreme individualism and self-expression of two contemporary 19th-century artists – van Gogh and Gauguin."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/311> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Futurism"@en ;
    skos:scopeNote "An artistic movement of the early 20th century with political implications. Italian in origin, it expressed the disappointment felt there in advanced artistic and political circles at the apparent lack of progress the country had made since its unification in the mid-19th century. Accordingly, stress was laid on modernity, and the virtues of technology, machinery, and speed were promoted by the Futurists. In Germany the Dadaists learnt from the noisy publicity techniques of the Futurists, as did the Vorticists in England."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/313> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Post-Impressionism"@en ;
    skos:scopeNote "This term refers to the approach of painters who developed out of Impressionism but argued with some themes or intents, such as its absorption with the fleeting, momentary appearance."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/319> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/31> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Beiseitesprechen"@de,
        "Aside"@en ;
    skos:scopeNote "Dramatic device in which a character doesn’t address himself to another character on stage but to himself and consequently to the audience. Although in asides there is no interlocutor and, therefore, they possess strong monologic features, they are distinguished from monologues by their brevity, the absence of inner structure and their interdependence with the dramatic discourse."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/343> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Constructivism"@en ;
    skos:scopeNote "A modern art movemet developed in Russia The aim was to construct abstract sculpture suitable for an industrialized society, and the work pioneered the use of modern technology and materials such as wood, glass, plastics, and steel."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/344> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Fauvism"@en ;
    skos:scopeNote "The first of the major European avant-garde movements to have emerged between the turn of the 20th century and the outbreak of the First World War, it was distinguished by its concentration on a use of colour freed from a purely descriptive role and employed, instead, for expressive and emotional effect. It would itself prove highly influential, notably on german Expressionism."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/346> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/31> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Dramatischer Ironie"@de,
        "Dramatic irony"@en ;
    skos:scopeNote "Dramaturgic technique presenting the dramatis personae ignoring current or future situations other characters and/or the audience are aware of. As a result, their words take on a different—often contradictory—meaning for those who know the truth. The character acts in a way that the spectators know is erroneous for the specific circumstances or expects the opposite of what is fated to happen."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/350> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Proverbs"@en ;
    skos:scopeNote "Short sayings of educational character that allegorically assert claims confirmed by common sense or collective experience."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/354> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/24> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Masken (Theater)"@de,
        "Masks (theatre)"@en ;
    skos:scopeNote "Specially designed objects used for covering the face or parts of it, resulting in changing its appearance or making it unrecognizable. In theatre, the use of masks denaturalises the character by introducing a foreign body into the process of identification between spectator and actor. It is therefore often used when the stage direction seeks to avoid emotional transference and defamiliarises the character."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/358> a skos:Concept ;
    skos:altLabel "Goodness"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/28> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Good"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/363> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/23> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Infrastructure"@en ;
    skos:scopeNote "This term classifies structures, either terrestrial or subterranean, that make up the underlying installations and technical works which are the essential basis for the functioning and communication of urban and rural communities, and which serve the day-to-day needs of these same communities."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/365> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/215> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Narratized speech"@en ;
    skos:scopeNote "A narrative technique in which the character's words and actions are integrated into the narration and are treated like any other event."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/367> a skos:Concept ;
    skos:altLabel "Hellenistic Koine"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/116> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Koine Greek"@en ;
    skos:scopeNote "Koine Greek (also known as Alexandrian dialect, common Attic or Hellenistic Greek) was the common supra-regional form of Greek spoken and written during Hellenistic and Roman antiquity. It developed through the spread of Greek following the conquests of Alexander the Great in the 4th century BC, and served as the common lingua franca of much of the Mediterranean region and the Middle East during the following centuries. It was based mainly on Attic and related Ionic speech forms, with various admixtures brought about through dialect levelling with other varieties."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/389> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/86> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Epimeric ratios"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/41> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Naturalism"@en ;
    skos:scopeNote "An approach to art in which objects are depicted by the artist as they are empirically observed rather than according to stylistic or conceptual preconceptions. The term is often used interchangeably with Realism."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/418> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/352> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Socialist ideologies"@en ;
    skos:scopeNote "Ideologies that emerged since the late 18th century and, despite their partial differences, share the basic principle of pursuing political, social and economic equality by allowing the state to control and plan production, by diffusing wealth over society, and by eliminating social inequalities that are based on assymetrical power relations and access to resources.<br />"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/421> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/240> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Postdramatisches Theater"@de,
        "Postdramatic theatre"@en ;
    skos:scopeNote "Term introduced by the end of the 20th century to describe the new theatre forms that have emerged since the 1970s. It refers to theatre beyond drama, at a time ‘after’ the authority of the dramatic paradigm in theatre and was born as a response to the emergence of new media technologies. The abandonment of the dramatic text as the central element of the performance and the end of the representation of a fictive cosmos, the mimetic staging of a fable (story), are its principle features. The text, whenever it is used, is merely one element of the entire composition and has the same value as gesture, music, visual images, dance, poetry, documentary film or oral narratives. Postdramatic theatre has broad horizons and is characterised by ambiguity, polysemy or even lack of significance; it doesn’t “signify” but it “is”; it invites the spectator to find the meaning and the correlations. It is elliptical or overwhelming and determined by the absolute, non-significant, presence of the body leading to new communication and participation processes. It reflects the “performative turn” and owes much to new French philosophy and the strategies of deconstruction, the unstable meanings and the ambiguous shaping of identity."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/440> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/245> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Modern Greek metre"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/453> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/240> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Absurdes Theater"@de,
        "Theatre of the Absurd"@en ;
    skos:scopeNote "Form of theatre that appeared after the second world war and tried to express the sense of meaningless human existence and the inadequacy of rational approach. Abandoning inductive reasoning, it employed the free subconscious composition of elements and symbols. Its dramaturgy comprises plays without plot and concrete dramatis personae. Questioning the essential human ability to communicate, it led to a stripping down of language and a lessening of its value. With the intrusion of the bizarre in the stage reality and the disintegration of the human personality, it achieved the juxtaposition of the tragic and the comic and glorified the fictional."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/454> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/116> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Medieval Greek"@en ;
    skos:scopeNote "Medieval Greek, also known as Byzantine Greek, is the stage of the Greek language between the end of Classical antiquity in the 5th–6th centuries and the end of the Middle Ages, conventionally dated to the Ottoman conquest of Constantinople. Medieval Greek is the link between this vernacular, known as Koine Greek, and Modern Greek. Though Byzantine Greek literature was still strongly influenced by Attic Greek, it was also influenced by vernacular Koine Greek, which is the language of the New Testament and the liturgical language of the Greek Orthodox Church."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/465> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/48> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Nominative"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/468> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/240> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Pantomime"@de,
        "Pantomime"@en ;
    skos:scopeNote "Form of theatre using body language (facial expression, gesture, and movement) to imitate an action without using speech. It derives from the Latin pantomimus and is rooted in Greek-Roman representational and Asiatic art as well as in the religious rituals of primitive peoples."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/490> a skos:Concept ;
    skos:altLabel "Vendetta"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/232> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Feud"@en ;
    skos:scopeNote "Repeated acts of violence executed reciprocally between members of two kinship groups, with the purpose to reinstate their honour."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/500> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/285> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Reflexivity (Anthropology)"@en ;
    skos:scopeNote "The systematic examination of perceptions, modes of knowledge and methods, with a special focus on the conditions and the conceptual frameworks upon which they are founded. In Anthroplology, reflexivity refers to the meta-gognitive evaluation of the epistemological and cultural contexts that influence the emergent anthropological discourse."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/507> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/133> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Empires"@en ;
    skos:scopeNote "State organizations with large territory and expansionary claims, which rule over peoples and populations that differ in ethnic, religious and cultural terms, and incorporate them in the state through various political and economic patterns. Empires can be territorially continuous, governed by a monarch and legitimized by the imperial dynasty, or they can be colonial powers that are governed by a metropolitan centre in the form of a nation-state."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/51> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Impressionism"@en ;
    skos:scopeNote "A movement in french painting, characterized by the use of a bright palette, broken brushwork, and an emphasis on depictions of contemporary life and landscape. Impressionists, as Realists, rejected the restrictions of traditional subjects in favor of the visible contemporary world. But they intensified the real-time immediacy of their focus, objectivity, and an interest in monitoring and understanding the eye’s perceptions."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/516> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/48> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Vocative"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/521> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/309> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Communities (ethno-confessional groups)"@en ;
    skos:scopeNote "Institutionally acknowledged groups that are constituted on the basis of religion and/or ethnic origin, dispose of hierarchical representation and self-government structures, and internalize common socio-cultural values and norms."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/531> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/240> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Dramaturgie (Gesamtheit der Werke)"@de,
        "Dramaturgy (set of plays)"@en ;
    skos:scopeNote "The term is often used to denote the body of dramatic texts (plays) of a playwright, an historic period, a country or an artistic movement."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/534> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/127> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Social elites"@en ;
    skos:scopeNote "Groups of individuals who hold leading positions at the top of social organizations and institutions. The members of the elites have dense interaction with each other and develop a sense of common ethics and interests."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/537> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/133> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Nation-states"@en ;
    skos:scopeNote "State organizations that rule over a territory in the name of the political community of the nation. Nation-states emerged in the modern period through economic, social and ideological processes."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/540> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/215> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Plot (Narratology-Methods)"@en ;
    skos:scopeNote "The way in which the events and characters’ actions in a story are arranged by the author and how this arrangement in turn facilitates the identification of their motivations and consequences. The plot must not be confused with the story. The story is the chronological sequence of events, whereas the plot is the causal and logical structure which connects events. According to this distinction the same story can be represented through, theoretically, an infinite number of plots."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/55> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Anthropological theories of kinship"@en ;
    skos:scopeNote "Theoretical models used in Anthropology in order to describe and interpret structures of kinship and the corresponding social relationships."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/57> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Postmodernism"@en ;
    skos:scopeNote "A term which describes the reactions to the dominance of Modernism in architecture and the visual arts. It came into use in the 1970s, at first mainly in connection with architecture, and then later with the visual and decorative arts. To the extent that Modern \"isms\" establish a formal attitude to both the making and critiquing of art, Postmodernism rejects that approach in favor of Eclecticism."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/585> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/116> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Proto-Greek language"@en ;
    skos:scopeNote "The Proto-Greek language (also known as Proto-Hellenic), an Indo-European language, is the assumed last common ancestor of all known varieties of Greek, including Mycenaean Greek, the subsequent ancient Greek dialects (i.e., Attic, Ionic, Aeolic, Doric, Ancient Macedonian and Arcadocypriot) and, ultimately, Koine, Byzantine and Modern Greek. The unity of Proto-Greek possibly ended as Hellenic migrants, who spoke the predecessor of the Mycenaean language, entered the Greek peninsula sometime in the Neolithic or the Bronze Age."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/59> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Rococo"@en ;
    skos:scopeNote "A term used to describe the light, elegant, and sensuous style in the visual arts which originated in France at the beginning of the 18th century, reached its apogee in the 1730s, and was eventually supplanted by the stern, moralizing qualities of Neoclassicism in the 1760s."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/596> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/240> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Repertoire"@de,
        "Repertory"@en ;
    skos:scopeNote "A repertory is the body of plays staged by a theatre in the course of a season or over a period of time."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/60> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/27> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Surrealism"@en ;
    skos:scopeNote "One of the most important and subversive movements of the 20th century, it flourished particularly in the 1920s and 1930s and provided a radical alternative to the rational and formal qualities of Cubism. Surrealism sought access to the subconscious and to translate this flow of thought into terms of art."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/601> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/352> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Liberal ideologies"@en ;
    skos:scopeNote "Ideologies that emerged since the late 17th century and, despite their partial differences, share the basic principle of pursuing individual liberty. Aspects of this prιnciple are the protection of individual property, the legal equality between the members of society, and the abolishment of state control over the function of the market."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/604> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/330> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Ancient Greek prose"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/605> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/335> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Acrolith"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/624> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/215> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Reported speech"@en ;
    skos:scopeNote "A narrative technique in which the character’s words are cited verbatim by the narrator."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/632> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/240> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Schattentheater"@de,
        "Shadow theatre"@en ;
    skos:scopeNote "Form of improvisational folk theatre with a century- long course from Asia tο the Mediterranean. It is based in orality (memorisation), empirical learning (artistry) and is a primarily collective anonymous creation. It is performed with flat articulated cut-out figures painted on paper, leather or other material against a white screen lighted from the back. The artists of shadow theatre move the figures, the result being that the audience sees the silhouettes or/and the colours -depending of the figures used. The Greek shadow theatre is Karagiozis, deriving from the Turkish Karagöz."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/640> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/39> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Headscarfs"@en ;
    skos:scopeNote "Scarfs that are traditionally used to cover the hair and/or part of the head. As a component of traditional costumes, headscarfs appear in different forms, depending on the climate conditions, the social status of the person(s) wearing them, the type of costume they are part of, etc."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/647> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/192> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Machine-powered ships"@en ;
    skos:scopeNote "Ships propelled by engines."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/654> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/352> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Fascist ideologies"@en ;
    skos:scopeNote "Ideologies that emerged in the first half of the 20th century that view society as an organic whole based on a biologically defined national community. According to them, society should be fully controlled by the state and be organized along the standards of military structure, while resisters and persons viewed as racially, physically or morally degenerate should be excluded from society and politically (or even physically) neutralized. Economic activity is also viewed as an organic process that must be controlled by the state in order to guarantee its power.<br />"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/661> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/133> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "City-states"@en ;
    skos:scopeNote "Independent or autonomous states, whose territory covers an urban centre and its surrounding region."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/671> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/121> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Modulation of melodic character (Harmonic science)"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/673> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/119> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Rhythmical notation"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/686> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/119> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Phonetic notation"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/688> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/119> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Instrumental notation"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/690> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/205> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Cottage industry"@en ;
    skos:scopeNote "The small-scale processing of raw materials, agricultural and animal products, conducted by the members of a family at their home."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/692> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/25> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Spirit possession"@en ;
    skos:scopeNote "The cultural interpretation that attributes a person's extraordinary psychosomatic state to their possesion by supernatural forces or entities."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/698> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/240> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Aufführungstexte"@de,
        "Performance texts"@en ;
    skos:scopeNote "According to the contemporary performance-centered approach of theatre that conceives the dramatic text as one of the performance elements, not necessarily the predominant one, performance text denotes any text that can be used in a performance. It is a new play with a new structure that can comprise the dramatic text but is not identical to it."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/715> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/127> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Social strata"@en ;
    skos:scopeNote "Social groups, whose members share common characteristics as to social position, profession, constitutional status and inclusion in political relations and power structures."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/721> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/116> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Mycenaean Greek"@en ;
    skos:scopeNote "Mycenaean Greek is the most ancient attested variation of the Greek language, that was spoken on the Greek mainland, Crete and Cyprus in Mycenaean Greece, before the hypothesised Dorian invasion. The language is preserved in inscriptions in Linear B, a script first attested on Crete before the 14th century. Most inscriptions are on clay tablets found in Knossos, in central Crete, as well as in Pylos, in the southwest of the Peloponnese. Other tablets have been found at Mycenae itself, Tiryns and Thebes and at Chania, in Western Crete. The language is named after Mycenae, one of the major centres of Mycenaean Greece."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/729> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Fortune tellers (from coffee grounds left in cup)"@en ;
    skos:scopeNote "Women professionally or amateurly engaged in fortune telling from coffee cup sediments."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/733> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Coppersmiths"@en ;
    skos:scopeNote "Craftsmen who use copper as the raw material for the manufacture of various items such as weapons, household utensils etc."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/735> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/618> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Aquarelles"@en ;
    skos:scopeNote "Two-dimensional artworks, usually on a paper support, to which pigment suspended in water is applied with a brush to create an image or design."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/739> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/589> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Extradiegetic narratee"@en ;
    skos:scopeNote "Narrative technique in which the narratee is a person not involved in the story. On rare occasions this person can be identified with the reader."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/744> a skos:Concept ;
    skos:altLabel "Dorian dialect"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/532> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Doric dialect"@en ;
    skos:scopeNote "Doric is a dialect of Ancient Greek. Its variants were spoken in the southern and eastern Peloponnese, Crete, Rhodes, certain islands in the southern Aegean Sea, certain cities on the coasts of Asia Minor, Southern Italy, Sicily, Epirus and Macedonia. Together with Northwestern Greek, it forms the \"Western group\" of classical Greek dialects. By Hellenistic times, under the Achaean League, the Achaean Doric Koine displayed many peculiarities common to all Doric dialects and delayed the spread of the Attic-based Koine to the Peloponnese until the 2nd century BC."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/747> a skos:Concept ;
    skos:altLabel "Itinerant photographer"@en ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Outdoor photographers"@en ;
    skos:scopeNote "Wandering photographers who carried a wooden camera mounted on a wooden tripod on their back and took pictures. Their main feature was the white long blouse they wore. To the outdoor street photographers we owe many of the photos that have survived from the 19th and the 20th century to the ‘50s."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/750> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Puppeteers"@en ;
    skos:scopeNote "Puppeteers who manipulate the figures and create the voices of all the roles of a story in the karagiozis shadow theater. The puppeteers were sometimes accompanied by a singer. They also had assistants to hold the figures and to clap their hands."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/751> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2636> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Matchmakers"@en ;
    skos:scopeNote "Women who in traditional societies arranged for bringing together a man and a woman for the purpose of marriage."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/753> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/618> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Tempera paintings"@en ;
    skos:scopeNote "Artworks produced by use of paint formed of an emulsion of fatty and watery constituents. The standard emulsion is usually created with egg yolk and water, with variants of man-made emulsions created with whole egg, linseed oil, casein glue, gum, or wax."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/754> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Soap manufacturers"@en ;
    skos:scopeNote "Craftsmen involved in the manufacture of soap."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/756> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/685> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Saddlers"@en ;
    skos:scopeNote "Craftsmen trained in the construction of pack saddles."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/758> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/378> ;
