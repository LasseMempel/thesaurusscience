        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/69> ;
    skos:scopeNote "Strict layout of letters in an inscription text, according to which each letter is engraved at equal distances from the letters engraved to the right, left, above and below it."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/916> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/491> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Spiridon script style"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/69> ;
    skos:scopeNote "Inscription text layout, according to which the length of each verse is shortened relative to the verse above, forming the shape of a basket."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/940> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/693> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Matrilineal descent"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/108>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/1103> ;
    skos:scopeNote "Descent system in which children of both sexes are affiliated to their mother&#39;s kinship group"@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/943> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/662> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Red alphabets"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573>,
        <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/69> ;
    skos:scopeNote "A type of archaic alphabet that gathers common features of the alphabets of Evia, Thessaly, Eastern Central Greece, part of the Peloponnese, Kythira, Kefallinia and Ithaca, Lyceum. The name of the alphabet was established in 1887 by Adolf Kirchhoff."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/983> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/381> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Funerary inscriptions"@en ;
    skos:related <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/573> ;
    skos:scopeNote "Inscriptions written on stelae or monuments erected on a tomb (sarcophagi, altars). Usually they included the name of the deceased and other information, such as the name of the person who took care of the burial or the memorial, or additional information about the dead (profession, career, age, etc.) or the mode of death, words of farewell and suffering, threats against anyone who might violate the grave."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/993> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/727> ;
