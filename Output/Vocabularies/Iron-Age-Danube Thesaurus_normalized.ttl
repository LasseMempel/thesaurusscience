    skos:broader <https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme/concept495> ;
    skos:inScheme <https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme> ;
    skos:prefLabel "Planumsgrabung"@de,
        "arbitrary level excavation"@en .

<https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme/concept497> a skos:Concept ;
    skos:altLabel "coring"@en,
        "drills"@en ;
    skos:broader <https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme/concept495> ;
    skos:inScheme <https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme> ;
    skos:prefLabel "Kernbohrung"@de,
        "core drilling"@en .

<https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme/concept498> a skos:Concept ;
    skos:broader <https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme/concept495> ;
    skos:definition "A technique developed to assist in the recovery of plant, insect, and molluscan remains from archaeological deposits; a method of screening in which minute pieces of flora are separated from the soil by agitation with water. The technique works on the principle that organic material such as carbonized seeds, snail-shells, and beetle wing-cases have a lower specific gravity than inorganic materials such as soil and stone, and will thus float on the top of a suitable liquid medium while the rest will sink. Water is commonly used for flotation, though there are disadvantages since it has a fairly low specific gravity and heavier material such as fruit stones will sink. Other media have been used, such as carbon tetrachloride solution or zinc chloride solution. Flotation of samples by hand is called wet sieving. Samples of material are slowly poured into water, any lumps are broken up, and the flot is drawn off with a sieve. The method is more controlled than flotation by machine, and the recovery rate is better. For large-scale excavations, machines are used. Operating principles vary: samples are poured into a large container of water, or water and paraffin, which is agitated by air injection or by currents of inflowing water. The addition of a floculating agent increases surface tension, though not all machines are 'froth flotation' machines. The flot is carried off the surface through a mesh, or series of meshes to allow preliminary sorting. Samples retrieved are sent away for specialist identification and analysis by an archaeobotanist."@en ;
    skos:inScheme <https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme> ;
    skos:prefLabel "Flotieren"@de,
        "flotation"@en .

<https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme/concept499> a skos:Concept ;
    skos:broader <https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme/concept495> ;
    skos:definition "Archaeological excavation where microstratigraphic sampling of the sedimentary record is carried out. Micromorphological analysis is used to help determining stratigraphic layering and planning of the excavation."@en ;
    skos:inScheme <https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme> ;
    skos:prefLabel "mikrostratigraphische Ausgrabung"@de,
        "microstratigraphic excavation"@en .

<https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme/concept501> a skos:Concept ;
    skos:broader <https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme/concept500> ;
    skos:definition "A method used to separate small artefacts from the soil by sieving."@en ;
    skos:inScheme <https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme> ;
    skos:prefLabel "Trockensiebung"@de,
        "dry-sieving"@en .

<https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme/concept502> a skos:Concept ;
    skos:broader <https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme/concept500> ;
    skos:definition "A method used to separate organic material (seeds, snails, insects, etc.) from soil before drying, identification, and analysis. It is a more time-consuming method of extraction than flotation by machine, but has the advantage of being more accurate in its results since there is more control over extraction from the sample. The sample is poured into a sieve in a bowl of water, the lumps of soil are carefully broken up, and the organic material is trapped in the mesh while the soil particles are removed."@en ;
    skos:inScheme <https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme> ;
    skos:prefLabel "Nasssiebung"@de,
        "wet-sieving"@en .

<https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme/concept503> a skos:Concept ;
    skos:altLabel "Schichtengrabung"@de,
        "Stratengrabung"@de ;
    skos:broader <https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme/concept495> ;
    skos:definition "Archaeological excavation where the deposits (rocks, sediments, soils, or cultural debris) are removed in the reverse order of their deposition based on the principle that the lowest layer is the oldest and the uppermost is the youngest. The sequence of deposition can be assessed by a study of relationships of different layers."@en ;
    skos:inScheme <https://vocabs.acdh.oeaw.ac.at/iadthesaurus/scheme> ;
    skos:prefLabel "stratigraphische Ausgrabung"@de,
        "stratigraphic excavation"@en .

