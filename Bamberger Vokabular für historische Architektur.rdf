        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-25T15:07:53.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T11:29:57.000</terms:modified>
        <skos:altLabel xml:lang="de">Monstranzreliquiar</skos:altLabel>
        <skos:altLabel xml:lang="de">Ostensoriumreliquiar</skos:altLabel>
        <skos:altLabel xml:lang="de">Reliquienostensorium</skos:altLabel>
        <skos:altLabel xml:lang="fr">ostensoir-reliquaire</skos:altLabel>
        <skos:altLabel xml:lang="la">ostensorium reliquiarum</skos:altLabel>
        <skos:definition xml:lang="de">Reliquienmonstranz f ; Reliquienostensorium n; auch Monstranzreliquiar n; Ostensoriumreliquiar n; lat. monstrantia reliquiarum; ostensorium reliquiarum: ein Reliquienbehälter, in dem die Partikel in einem Schaugefäß enthalten sind, oft in einer durch eine metallene Wand zweigeteilten Kapsel, in deren verglaster Vorderseite sich die Reliquie befindet, während die Rückseite die gefaltete Authentiken  thält. Reliquienmonstranzen sind sehr verbreitet (seit 13. Jh.) und zeigen eine große Formenvielfalt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Reliquienmonstranz</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">monstrance-reliquaire</skos:prefLabel>
        <skos:prefLabel xml:lang="en">monstrance-reliquary</skos:prefLabel>
        <skos:prefLabel xml:lang="la">monstrantia reliquiarum</skos:prefLabel>
    </owl:NamedIndividual>
    


