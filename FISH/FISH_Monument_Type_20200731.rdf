    <skos:scopeNote xml:lang="en">A trench, usually linking two or more rows of trenches, enabling the conveyance of messages or equipment safely from one trench to another.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92463">
    <skos:scopeNote xml:lang="en">A building for a society formed for the promotion of some branch of learning or science.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69348">
    <skos:scopeNote xml:lang="en">A vertical or inclined excavation giving access to an underground mine.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/141948">
    <skos:scopeNote xml:lang="en">Fixed or hardened installation for machine guns. Temporary soft installations are possible as well.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68769">
