  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92181">
    <skos:scopeNote xml:lang="en">A kiln where gypsum was dried to a state where it could be used as plaster of Paris or for the production of cement.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69117">
    <skos:scopeNote xml:lang="en">A place where tin ore is washed using a stream as the water source.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69335">
    <skos:scopeNote xml:lang="en">A windmill with a stationary timber body which contains the grinding machinery, and which supports a rotating cap in which the sails rotate.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71411">
    <skos:scopeNote xml:lang="en">An area within a building (usually the barn or stable) for storing husks from the grain crop (chaff) for animal feed after it has been threshed and winnowed in the barn.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/139365">
    <skos:scopeNote xml:lang="en">A building or other establishment used for the retail, making and repairing of jewellery.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69114">
