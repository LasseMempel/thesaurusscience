        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-25T11:41:34.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T13:29:12.000</terms:modified>
        <skos:definition xml:lang="de">Aussichtswarte, Warte, ein Turm, der eine Fernsicht, bes. in Stadt- und Waldgebieten, ermöglicht. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Aussichtsturm</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">pozorovací věž, rozhledna</skos:prefLabel>
    </owl:NamedIndividual>
    


