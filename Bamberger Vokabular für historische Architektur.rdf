    <!-- https://hist-arch-vocab.org/bvha#c_be068deb -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_be068deb">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_290c8d10"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-20T11:19:40.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T14:54:23.000</terms:modified>
        <skos:note xml:lang="de">Das Überwachen verschiedener Umweltparameter, um den Einfluss der Umwelt auf die Erhaltung der Wandmalereien und Architekturoberflächen einzugrenzen. (EwaGlos)</skos:note>
        <skos:note xml:lang="en">Monitoring various environmental parameters in order to limit the impact of the environment on the conservation conditions of wall paintings and architectural surfaces.</skos:note>
        <skos:note xml:lang="fr">Suivi des paramètres environnementaux afin de limiter l’impact de l’environnement sur la conservation des peintures murales et surfaces architectoniques. (EwaGlos)</skos:note>
        <skos:prefLabel xml:lang="de">Umweltmanagement</skos:prefLabel>
        <skos:prefLabel xml:lang="en">environmental management</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">gestion de l’environnement</skos:prefLabel>
        <skos:prefLabel xml:lang="it">gestione dell’ambiente</skos:prefLabel>
        <skos:prefLabel xml:lang="es">gestión medioambiental</skos:prefLabel>
        <skos:prefLabel xml:lang="hu">környezet menedzsment</skos:prefLabel>
        <skos:prefLabel xml:lang="ro">management de mediu</skos:prefLabel>
        <skos:prefLabel xml:lang="hr">upravljanje okolišem</skos:prefLabel>
        <skos:prefLabel xml:lang="pl">zarządzanie warunkami środowiska</skos:prefLabel>
        <skos:prefLabel xml:lang="tr">çevresel yönetim</skos:prefLabel>
        <skos:prefLabel xml:lang="bg">Управление на околната среда</skos:prefLabel>
    </owl:NamedIndividual>
    


