		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-11-16T16:03:17+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk020963">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="en">last will</skos:altLabel>
		<skos:altLabel xml:lang="de">Letzter Wille</skos:altLabel>
		<skos:prefLabel xml:lang="de">Testament (Dokument)</skos:prefLabel>
		<skos:altLabel xml:lang="en">testament (document)</skos:altLabel>
		<skos:altLabel xml:lang="de">Testamente (Dokumente)</skos:altLabel>
		<skos:altLabel xml:lang="en">testaments (documents)</skos:altLabel>
		<skos:altLabel xml:lang="de">Vermächtnis (Dokument)</skos:altLabel>
		<skos:prefLabel xml:lang="en">will (document)</skos:prefLabel>
		<skos:altLabel xml:lang="en">wills (documents)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk018001"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk018001"/>
		<skos:definition xml:lang="de">Ein Testament ist eine schriftliche Aufzeichnung über die Verwendung des Nachlasses im Todesfall eines Erblassers und ist rechtlich bindend.</skos:definition>
		<skos:mappingRelation rdf:resource="http://vocab.getty.edu/aat/300027764"/>
		<skos:mappingRelation rdf:resource="http://www.wikidata.org/entity/Q155656"/>
