		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000522"/>
		<skos:definition xml:lang="de">Ein Rigosol ist ein anthropogener Boden, der durch tiefes Umgraben bis in über einen Meter Tiefe entsteht und dadurch keine typische Horizontabfolge mehr aufweist.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000522"/>
