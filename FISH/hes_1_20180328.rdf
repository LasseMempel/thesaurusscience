		<skos:prefLabel xml:lang="gd">PÀILLEAN SPÀ</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach no structar aotrom sgeadachail a chaidh a thogail mun cuairt air fuaran uisge-iarainn.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">SPA PAVILION</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
