        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-05T11:36:37.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-31T00:19:23.000</terms:modified>
        <skos:altLabel xml:lang="de">Taufbecken</skos:altLabel>
        <skos:definition xml:lang="cs">Od 11. stol. kamenná, bronzová nebo dřevěná nádoba s křticí vodou, která nahradila raně křesťanské baptisterium; většinou zdobena biblickými a apotropejskými tématy souvisejícími se křtem a vodou. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Taufbecken (in Nord-Deutschland: Fünte), seit 11. Jh. Stein-, Bronze- oder Holzbecken mit Taufwasser, welches das frühchristliche Baptisterium ablöst. Meist mit biblischen und apotropäischen Themen verziert, die mit Taufe und Wasser zusammenhängen (Taufe Christi, Paradiesesflüsse). [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Taufstein</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">křtitelnice</skos:prefLabel>
    </owl:NamedIndividual>
    


