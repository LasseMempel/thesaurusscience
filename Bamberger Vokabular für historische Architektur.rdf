        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-16T15:16:12.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-05T12:22:38.000</terms:modified>
        <skos:altLabel xml:lang="fr">arcs jumelés</skos:altLabel>
        <skos:altLabel xml:lang="en">coupled arches</skos:altLabel>
        <skos:altLabel xml:lang="de">gekuppelter Bogen</skos:altLabel>
        <skos:altLabel xml:lang="en">gemelled arches</skos:altLabel>
        <skos:altLabel xml:lang="en">geminated arches</skos:altLabel>
        <skos:definition xml:lang="de">Zwei Bogen, die sich entweder auf derselben Stütze oder in einem hängenden Bogenanfall begegnen. Meist liegt über ihnen ein Überfangbogen. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Zwillingsbogen</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">arcs géminés</skos:prefLabel>
        <skos:prefLabel xml:lang="en">twin arch</skos:prefLabel>
    </owl:NamedIndividual>
    


