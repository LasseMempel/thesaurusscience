  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93172">
    <skos:scopeNote xml:lang="en">A long bed containing rose plants.</skos:scopeNote>
  </rdf:Description>
