        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-25T15:12:36.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T15:56:37.000</terms:modified>
        <skos:altLabel xml:lang="de">Zylinderreliquiar</skos:altLabel>
        <skos:altLabel xml:lang="en">reliquair with cylinder</skos:altLabel>
        <skos:definition xml:lang="de">Röhrenreliquiar n; auch Zylinderreliquiar n: ein liegender oder stehender, meist auf einem Gestell montierter KristallzyIinder, in dem sich Reliquien befinden. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Röhrenreliquiar</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">reliquaire à cylindre</skos:prefLabel>
        <skos:prefLabel xml:lang="en">reliquary with cylinder</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_ff262a8d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_ff262a8d">
