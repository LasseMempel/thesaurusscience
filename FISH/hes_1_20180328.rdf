		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500508" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/507383" />
		<skos:scopeNote xml:lang="en">Sites and structures, often unmanned, intended to impede or confuse enemy forces.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/312">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/312</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BLOCA RATHAID</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Measgachadh de bhacaidhean airson stad a chur air feachdan nàmhad no gus an stiùireadh far an rathaid.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ROAD BLOCK</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/310" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/313" />
		<skos:scopeNote xml:lang="en">A combination of obstructions, used either to stop enemy forces or to force them off the road.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/313">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/313</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BACADH THANCAICHEAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Oibseact no structar airson adhartas tanca no carbad armach a bhacadh. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TANK TRAP</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">ANTI TANK DEFENCES</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/310" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/314" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/315" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/316" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/283" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/312" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/336" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/507383" />
		<skos:scopeNote xml:lang="en">An object or structure designed to obstruct the progress of a tank or armoured vehicle. Use more specific term where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/314">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/314</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BLOCAICHEAN ANTI  THANCAICHEAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Loidhnichean de bhlocaichean concrait mòra 's beaga air an talamh a chuireas bacadh air tancaichean.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ANTI TANK BLOCKS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/313" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/315" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/316" />
		<skos:scopeNote xml:lang="en">Lines of concrete blocks, large and small placed on the ground to impede tanks.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/315">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/315</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">DÌG ANTI- THANCAICHEAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Dìg a chaidh a chladhach a dh'aona-ghnothach an aghaidh thancaichean 's a dh'aithnichear air an loidhne a tha fada nas gèire.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ANTI TANK DITCH</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-06-21T11:43:19</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/313" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/314" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/316" />
		<skos:scopeNote xml:lang="en">A specifically dug ditch for anti-tank defence, detected by much sharper cut line.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/316">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/316</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BALLA ANTI- THANCAICHEAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Balla, gu tric balla concrait, is e a' leudachadh ballachan cloiche làithreach a ghnàth agus gu tric le lùb gunna na bhroinn.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ANTI TANK WALL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/313" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/314" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/315" />
		<skos:scopeNote xml:lang="en">A wall, often concrete, usually an extension to existing stone walls, will often have a gun loop built into it</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/317">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/317</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">DÌG</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Seanail fada caol san talamh a chleachdar airson uisgeachadh no traoghadh, mar chrìoch no mar phàirt de bhacadh dìonach.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">DITCH</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
