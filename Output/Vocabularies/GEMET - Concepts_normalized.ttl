<http://www.eionet.europa.eu/gemet/concept/1310> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:closeMatch <http://data.uba.de/umt/_00006024>,
        <http://dbpedia.org/resource/Chemical_industry> ;
    skos:definition "Industry related with the production of chemical compounds. The chemical processing industry has a variety of special pollution problems due to the vast number of products manufactured. The treatment processes combine processing, concentration, separation, extraction, by-product recovery, destruction, and reduction in concentration. The wastes may originate from solvent extraction, acid and caustic wastes, overflows, spills, mechanical loss, etc."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_1515>,
        <http://eurovoc.europa.eu/1362> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Chemische Industrie"@de,
        "chemical industry"@en ;
    skos:related <http://www.eionet.europa.eu/gemet/concept/1311>,
        <http://www.eionet.europa.eu/gemet/concept/1316> .

