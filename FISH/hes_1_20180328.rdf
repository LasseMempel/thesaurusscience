		<skos:prefLabel xml:lang="gd">PORT-ADHAIR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach air port-adhair on a thèid luchd-siubhail air bòrd plèana no dhan a thèid iad nuair a thig iad far a' phlèana.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">AIR TERMINAL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-25T15:13:14</dcterms:created>
