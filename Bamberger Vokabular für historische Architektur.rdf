    <!-- https://hist-arch-vocab.org/bvha#c_b25c3eda -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b25c3eda">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_dbac5de7"/>
