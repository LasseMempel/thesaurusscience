		<skos:altLabel xml:lang="en">FEVER HOSPITAL</skos:altLabel>
		<skos:altLabel xml:lang="en">ISOLATION HOSPITAL</skos:altLabel>
		<skos:altLabel xml:lang="en">PLAGUE HOSPITAL</skos:altLabel>
		<skos:altLabel xml:lang="en">QUARANTINE HOSPITAL</skos:altLabel>
		<skos:altLabel xml:lang="en">SMALLPOX HOSPITAL</skos:altLabel>
		<skos:altLabel xml:lang="en">TROPICAL DISEASES HOSPITAL</skos:altLabel>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/638" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/505562" />
		<skos:scopeNote xml:lang="en">An isolation hospital for infectious diseases; commonly situated on the edge of a town. For leprosy use LEPER HOSPITAL.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
