	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk012264">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Parfüm</skos:prefLabel>
		<skos:altLabel xml:lang="de">Parfum</skos:altLabel>
		<skos:altLabel xml:lang="de">Parfüme</skos:altLabel>
		<skos:altLabel xml:lang="de">Parfüms</skos:altLabel>
		<skos:prefLabel xml:lang="en">perfume (scent)</skos:prefLabel>
		<skos:altLabel xml:lang="en">perfumes (scents)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk018451"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk002505"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013655"/>
		<skos:definition xml:lang="de">Parfüm ist ein Material, das aus einer Mischung von Duftstoffen in Lösungsmitteln, meist Alkohol, und optional weiteren Zusatzstoffen besteht. Es dient zur Verleihung eines angenehmen Geruchs an Personen, Gegenstände oder Räume. Parfüme können aus natürlichen Duftstoffen wie ätherischen Ölen, Absolues und Extrakten, sowie aus synthetischen Duftstoffen hergestellt werden. Die Konzentration der Duftstoffe variiert je nach Parfümtyp, wie Eau de Parfum, Eau de Toilette oder Eau de Cologne.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300015166"/>
