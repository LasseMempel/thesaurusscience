        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_400b39c4"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_9593ddb3"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-10T17:35:23.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T14:01:00.000</terms:modified>
        <skos:definition xml:lang="de">Doppelsiegel n: ein Siegel, das auf Vorder- und Rückseite verschiedene Stempel trägt. Sind beide Siegelstempel gleich groß, spricht man von Münzsiegel (n); ist das Siegel auf der Rückseite kleiner als das auf der Vorderseite, heißt es Gegensiegel (n) oder Rücksiegel (n). [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Doppelsiegel</skos:prefLabel>
        <skos:prefLabel xml:lang="en">double-sided seal</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">sceau à double-face</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_fd44f8d9 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_fd44f8d9">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0f62a529"/>
