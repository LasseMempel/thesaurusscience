        <skos:prefLabel xml:lang="fr">cuculle</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kukula</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_7a0c6f8a -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_7a0c6f8a">
