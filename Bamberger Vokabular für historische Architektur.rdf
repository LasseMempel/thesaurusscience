        <skos:altLabel xml:lang="de">Überstaben</skos:altLabel>
        <skos:definition xml:lang="cs">Průnik profilů, zvl. u rohů portálů a oken ve vrcholné a pozdní gotice. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Überstaben, Überschneidung, Profildurchdringung besonders bei der Eckenbildung von hoch- und spätgotischen Portalen und Fenstern. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Überstabung, Durchdringung von Profilen, Rundstäben u. dergl. bei Eckausbildung spätgot. Portale, Nischen oder Fenster. Ü.en entstehen auch, wenn ein Bogenlauf von einem Rechteckrahmen überlagert wird. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="es">ensamble cruzado</skos:prefLabel>
        <skos:prefLabel xml:lang="en">overlap</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">přetínání profilů</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">recoupement</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Überschneidung</skos:prefLabel>
    </owl:NamedIndividual>
    


