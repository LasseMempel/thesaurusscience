	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/118">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/118</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">COILLE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Fearann air a bheil craobhan a tha uaireannan na chrìoch no na bhacadh, mar is trice nas lugha agus chan ann cho fiadhaich ri frìth.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">WOOD</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">WOODLAND</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/115" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/116" />
		<skos:scopeNote xml:lang="en">A tract of land with trees, sometimes acting as a boundary or barrier, usually smaller and less wild than a forest.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/119">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/119</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">PLANNTACHAS</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Badan de chraobhan no preasan a chaidh an cur ann, mar is trice dhen aon aois agus dhen aon ghnè.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PLANTATION</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/552" />
