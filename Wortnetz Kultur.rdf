	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk002985">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Jagdstern</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk020260"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk003815"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk004310"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019757"/>
		<gvp:aat2801_conjuncted_with rdf:resource="http://lvr.vocnet.org/wnk/wk002984"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk002576"/>
		<gvp:aat2801_conjuncted_with rdf:resource="http://lvr.vocnet.org/wnk/wk000835"/>
		<xe:explanation_temp xml:lang="de">Der zentrale Platz kann etwa von einem Rondell gebildet werden oder mit einem Gebäude bestanden sein. Große Waldgebiete können auch mehrere Jagdsterne enthalten. Auch ein Jagdpark enthält in der Regel wenigstens einen Jagdstern.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Jagdstern ist der Bestandteil eines offenen Raumes, der in einem Jagdgebiet liegt und bei dem von einem zentralen Platz mehr als vier Wege ausgehen, die in geraden Schneisen durch den Wald führen.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003815"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk004310"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019757"/>
