    <!-- https://hist-arch-vocab.org/bvha#c_8073bca1 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_8073bca1">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_32b3164e"/>
