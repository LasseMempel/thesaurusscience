		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk019015"/>
		<skos:definition xml:lang="de">Eine Bildkarte ist eine kartenverwandte Darstellung mit schräger oder senkrechter Ansicht.</skos:definition>
		<foaf:page rdf:resource="https://en.wikipedia.org/w/index.php?title=Pictorial_map&amp;oldid=859970881"/>
