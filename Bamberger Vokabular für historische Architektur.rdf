        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_f70f0624"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-06T12:07:21.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T12:27:29.000</terms:modified>
        <skos:definition xml:lang="de">Aus dem stehenden Dachfenster entwickelter, in der Höhe der Trauflinie aufsteigender Dachaufbau, dessen Vorderseite bündig mit der Außenfläche des Gebäudes liegt (Lukarne). [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Dacherker</skos:prefLabel>
    </owl:NamedIndividual>
    


