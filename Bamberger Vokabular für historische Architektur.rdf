        <skos:altLabel xml:lang="cs">lancetový oblouk</skos:altLabel>
        <skos:definition xml:lang="de">Schmaler, hoher Spitzbogen, bei dem die Kreismittelpunkte auf der über die Kämpferpunkte hinaus verlängerten Kämpferlinie liegen. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Lanzettbogen</skos:prefLabel>
