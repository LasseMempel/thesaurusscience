    skos:closeMatch <http://data.uba.de/umt/_00013309>,
        <http://dbpedia.org/resource/Industrial_crop> ;
    skos:definition "Any crop that provides materials for industrial processes and products such as soybeans, cotton (lint and seed), flax, and tobacco."@en ;
