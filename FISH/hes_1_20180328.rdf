		<skos:prefLabel xml:lang="gd">TAIGH-CÒMHNAIDH CHLÈIREACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àitichean-còmhnaidh aig daoine diadhach is clèirich.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CLERICAL DWELLING</skos:prefLabel>
