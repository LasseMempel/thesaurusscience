        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T16:59:02.000</terms:modified>
        <skos:definition xml:lang="de">Reliquienprozession f: eine feierliche Prozession, bei der Reliquien mitgeführt werden. [Glossarium Artis]</skos:definition>
