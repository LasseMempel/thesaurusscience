    <!-- https://hist-arch-vocab.org/bvha#c_5bb02087 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_5bb02087">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_73f409e3"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-27T22:36:49.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-21T18:25:05.000</terms:modified>
        <skos:altLabel xml:lang="cs">chodbová krypta</skos:altLabel>
        <skos:definition xml:lang="de">Stollenkrypta, ein halb oder ganz unterirdischer, tonnengewölbter Gang (Stollen), der innen oder außen der Rundgang der Apsis folgt. Im Scheitel der Apsis öffnet sich der Gang mit einem Fensterchen (Fenestella) oder in einem kurzen Stollen zu einer unter oder hinter dem Hauptaltar gelegenen Kammer mit dem Märtyrer- oder Heiligengrab. Durch den Grundriss des Chors oder Chorquadrats bedingt können die Stollen rechtwinklig geführt und im O. auch kammerartig erweitert sein oder, bes. in Westfrankreich, in parallelen Kammern enden. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Stollenkrypta</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">stolová krypta</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Ein oder mehrere, einander kreuzende Stollen. [Koch 2009]</skos:scopeNote>
    </owl:NamedIndividual>
    


