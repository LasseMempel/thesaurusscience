        <skos:altLabel xml:lang="la">capsula</skos:altLabel>
        <skos:altLabel xml:lang="la">repositorium</skos:altLabel>
        <skos:definition xml:lang="de">Custodia f (lat.); Kustodia f ; Repositorium n (lat.); auch Sakramentsbehälter m; gr. artophorion;lat. capsular ein oft schmuckloser, verschIießbarer Behälter aus Edelmetall zur Aufbewahrung der zur Aussetzung in der Monstranz bestimmten großen Hostie samt ihrem Träger (Lunula) im Tabernakel. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Custodia</skos:prefLabel>
        <skos:prefLabel xml:lang="el">artophorion</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">custode</skos:prefLabel>
        <skos:prefLabel xml:lang="la">custodia</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kustodie</skos:prefLabel>
        <skos:prefLabel xml:lang="en">repository</skos:prefLabel>
    </owl:NamedIndividual>
    


