        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T13:58:49.000</terms:modified>
        <skos:altLabel xml:lang="de">Pontifikalring</skos:altLabel>
        <skos:altLabel xml:lang="fr">anneau pontifical</skos:altLabel>
        <skos:definition xml:lang="de">Papstring m; Pontifikalring m; lat. anulus pontificalis: ein kostbarer Ring, den der Papst beim Pontifiikalamt trägt, wenn für die Bischöfe der Bischofsring vorgeschrieben ist. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Papstring</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">anneau papal</skos:prefLabel>
        <skos:prefLabel xml:lang="la">anulus pontificalis</skos:prefLabel>
        <skos:prefLabel xml:lang="en">pontifical ring</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_b4ff976b -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b4ff976b">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f4ceb052"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c7b144d0"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-23T08:49:35.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-15T15:31:27.000</terms:modified>
        <skos:definition xml:lang="de">Ein Mangel bei Gläsern sind beispielsweise Einschlüsse im Glas. Diese Einschlüsse (oft Fremdkörper) werden in ihrer Größe genau definiert. Gelegentlich kommt es vor, dass ein Einschluss mit einem Durchmesser von 1 mm das Glas im Umkreis von bsp. 4 mm &quot;verzerrt&quot;. Der eigentliche &quot;Mangel&quot; wirkt dadurch deutlich größer ist als der in der Richtlinie bezeichnete Einschluss. Das verzerrte Umfeld um einen Einschluss im Glas wird als &quot;Hof&quot; bezeichnet. [Pax - Fenster &amp; Türen Fachbegriffe]</skos:definition>
        <skos:prefLabel xml:lang="de">Hof (Fensterglas)</skos:prefLabel>
    </owl:NamedIndividual>
    


