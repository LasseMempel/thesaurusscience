				<skos:prefLabel xml:lang="gd">MUILEANN-GAOITHE PUMPAIDH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Muileann-gaoithe a tha ag obrachadh pumpa.</skos:scopeNote>
