        <skos:altLabel xml:lang="en">gemel chalice</skos:altLabel>
        <skos:definition xml:lang="de">DoppelkeIch m: ein Kelch, der aus zwei durch einen Knauf miteinander verbundenen Kuppen besteht, wobei die untere als Fuß dient. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Doppelkelch</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">calices jumeaux</skos:prefLabel>
        <skos:prefLabel xml:lang="en">double chalice</skos:prefLabel>
