        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-04-05T07:51:39.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T17:42:11.000</terms:modified>
        <skos:altLabel xml:lang="cs">kruhové schodiště</skos:altLabel>
        <skos:altLabel xml:lang="cs">točité schody</skos:altLabel>
        <skos:definition xml:lang="cs">Vřetena nebo kolem schodišťového otvoru (zrcadlo, otevřené vřeteno), zvl. v pozdní gotice a renesanci dovedeno k dokonalosti. [Koch 2008]</skos:definition>
