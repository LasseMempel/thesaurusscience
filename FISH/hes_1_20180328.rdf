		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/438" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/529" />
		<skos:scopeNote xml:lang="en">A row of terraced dwellings purpose built by an employer to house industrial workers.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
