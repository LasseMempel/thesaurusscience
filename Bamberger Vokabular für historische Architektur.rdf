    <!-- https://hist-arch-vocab.org/bvha#c_b2269f42 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b2269f42">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_69593e2e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_b6fa4613"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-09T17:29:09.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T16:27:12.000</terms:modified>
        <skos:altLabel xml:lang="de">Fastentuch</skos:altLabel>
        <skos:altLabel xml:lang="de">Hungertuch</skos:altLabel>
        <skos:altLabel xml:lang="de">Palmtuch</skos:altLabel>
        <skos:altLabel xml:lang="la">cortina</skos:altLabel>
        <skos:altLabel xml:lang="cs">hladové plátno</skos:altLabel>
        <skos:altLabel xml:lang="fr">parament de carême </skos:altLabel>
        <skos:altLabel xml:lang="cs">postní plátno</skos:altLabel>
        <skos:altLabel xml:lang="la">sindon</skos:altLabel>
        <skos:altLabel xml:lang="la">velamen quadragesimale</skos:altLabel>
        <skos:altLabel xml:lang="la">velum templi</skos:altLabel>
        <skos:altLabel xml:lang="fr">voile de carême</skos:altLabel>
        <skos:altLabel xml:lang="cs">vélum postní</skos:altLabel>
        <skos:definition xml:lang="de">Fastenvelum n, Hungertuch n, auch Fastentuch n, velum quadragesimale: zweiteiliges, häufig mit Passionsmotiven besticktes oder bemaltes violettes Tuch, das in manchen Gegenden während der Fastenzeit zwischen Chor und Langschiff aufgehängt wird; zu unterscheiden vom Passionsvelum und Ostertuch. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Hungertuch, Palmtuch, Fastenvelum, in Niedersachsen und Rheinland »S(ch)machtlappen«, ein großes Leinentuch, das in quadratischen Feldern mit Passionsszenen oder Passionswerkzeugen bemalt, bedruckt oder gewirkt ist. Zur Fastenzeit wird es zwischen Chor und Schiff aufgehängt (14.-18. Jh., heute selten). [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Také postní rouška, postní velum, v Dolním Sasku a Porýní lidově ,,hladový hadr&quot;, velký kus plátna, na kterém byly do čtvercových polí namalovány, vytištěny nebo vyšity pašijové scény nebo nástroje Kristova utrpení; v postní době se zavěšovalo mezi chór a loď (14.-18. stol., dnes zřídka). [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Fastenvelum</skos:prefLabel>
        <skos:prefLabel xml:lang="en">lenten veil</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">postní sukno</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">tenture de carême </skos:prefLabel>
        <skos:prefLabel xml:lang="la">velum quadragesimale</skos:prefLabel>
    </owl:NamedIndividual>
    


