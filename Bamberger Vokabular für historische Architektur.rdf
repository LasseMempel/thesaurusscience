        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_0ea453f7"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-24T16:45:29.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-21T18:26:04.000</terms:modified>
        <skos:altLabel xml:lang="cs">chór</skos:altLabel>
        <skos:altLabel xml:lang="cs">kněžiště</skos:altLabel>
        <skos:altLabel xml:lang="cs">presbyterium</skos:altLabel>
        <skos:definition xml:lang="de">Presbyterium (gr.), den Priestern vorbehaltener Raumteil der Kirche im Bereich des Hauptaltars, in Kosterkirchen durch Chorschranken, Lettner oder Chorgitter vom Laienraum geschieden. Auf der Nordseite des P.s befand sich das Sakramentshaus, auf der Südseite der Levitenstuhl. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Presbyterium (griech. presbyterion = Ältestenrat), Priesterraum einer Kirche beim Hauptaltar. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Též kněžiště, presbyterium, z řec. presbyterion = rada starších, prostor pro kněží v kostele u hlavního oltáře. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Presbyterium</skos:prefLabel>
        <skos:prefLabel xml:lang="en">chancel</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">chancel</skos:prefLabel>
        <skos:prefLabel xml:lang="ca">presbiteri</skos:prefLabel>
        <skos:prefLabel xml:lang="es">presbiterio</skos:prefLabel>
        <skos:prefLabel xml:lang="it">presbiterio</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">presbytář</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_4880e8cc"/>
    </owl:NamedIndividual>
    


