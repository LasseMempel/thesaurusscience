	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk021347">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Muffel (Behälter)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Muffeln (Behälter)</skos:altLabel>
		<skos:prefLabel xml:lang="en">muffle (container)</skos:prefLabel>
		<skos:altLabel xml:lang="en">muffles (container)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk021348"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk021348"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk003599"/>
		<skos:definition xml:lang="de">Eine Muffel ist ein feuerfester Behälter, meist röhrenförmig oder kastenförmig, der in Öfen eingesetzt wird, um Proben, Werkstücke oder Materialien indirekt zu erhitzen und vor direktem Kontakt mit Flamme, Rauchgasen oder Verbrennungsrückständen zu schützen. Muffeln bestehen typischerweise aus Keramik oder feuerfestem Stahl und ermöglichen gleichmäßige Temperaturführung bei Prozessen wie Glühen, Brennen, Rösten oder Kalzinieren, insbesondere bei Laboranwendungen, in der Keramikbearbeitung und Metallverarbeitung.</skos:definition>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q12130885"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk021348"/>
