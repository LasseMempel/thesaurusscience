	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk018581">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Schiefertafel</skos:prefLabel>
		<skos:altLabel xml:lang="de">Schiefertafeln</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk016808"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk021130"/>
