    <!-- https://hist-arch-vocab.org/bvha#c_qec4iu60 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_qec4iu60">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_3dfbc602"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_gctathni"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-22T18:11:13.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T15:55:36.000</terms:modified>
        <skos:definition xml:lang="de">Apokryphen m pl: geheime Bücher mit religiösen Lehren für den Kreis der Eingeweihten; im engeren Sinne von der Kirche nicht als dogmatische Autoritäten anerkannte Schriften, z.B. die Evangelien des Jakobus und Petrus, die Berichte über das Leben und die Himmelfahrt der Jungfrau Maria, über die Kindheit und über die Höllenfahrt Christi, über das Gerichtsverfahren vor Pilatus oder über das Leben der Apostel. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Apokryphen</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">apocryphes</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">apokryf</skos:prefLabel>
    </owl:NamedIndividual>
    


