    <!-- https://hist-arch-vocab.org/bvha#c_rhrrwb0h -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_rhrrwb0h">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_63d87b7c"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_c2d76511"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_ed43f447"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_34ca6582"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-05T21:46:32.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T17:58:58.000</terms:modified>
        <skos:altLabel xml:lang="de">Dreck</skos:altLabel>
        <skos:altLabel xml:lang="de">Kontamination</skos:altLabel>
        <skos:altLabel xml:lang="de">Schmutz</skos:altLabel>
        <skos:altLabel xml:lang="de">Verunreinigung</skos:altLabel>
        <skos:altLabel xml:lang="en">dirt</skos:altLabel>
        <skos:altLabel xml:lang="fr">salissure</skos:altLabel>
        <skos:definition xml:lang="de">Ablagerung einer sehr dünnen Schicht von Fremd - partikeln (z. B. Ruß), welche der Stein ober fläche ein schmutziges Aussehen verleihen. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="en">Deposit of a very thin layer of exogenous particles (eg. soot) giving a dirty appearance to the stone surface. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="fr">Dépôt très fin de particules exogènes (par ex. poussières, suies) donnant un aspect sale à la surface de pierre. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="de">Externe Faktoren, die natürlich oder anthropogen sein können, verursachen Zerfall. [EwaGlos]</skos:definition>
        <skos:definition xml:lang="en">The accumulation of extraneous material on a surface leading to discolouration. [EwaGlos]</skos:definition>
        <skos:definition xml:lang="cs">znečištění, špinění je uložení velmi tenké vrstvy exogenních částic (např. sazí), dávající povrchu kamene špinavý vzhled. [ICOMOS-ISCS]</skos:definition>
        <skos:prefLabel xml:lang="de">Verschmutzung</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">encrassement</skos:prefLabel>
        <skos:prefLabel xml:lang="en">soiling</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">znečištění</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Beziehungen zum Substrat: Bei einer Verschmutzung wird die Struktur des Substrats nicht angegriffen. Die Verschmutzung kann unterschiedlich stark am Substrat haften.[ICOMOS-ISCS]</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Relationship with the substrate : With soiling, the substrate stucture is not considered as affect - ed. Soiling may have different degrees of adhesion to the substrate. [ICOMOS-ISCS]</skos:scopeNote>
    </owl:NamedIndividual>
    


