        <skos:definition xml:lang="de">Bogen, der zwei oder mehr Bogenöffnungen oder Arkaden in einer Wandnische überfängt. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Ein verstärkender Hauptbogen, der kleinere Nebenbogen umgreift und entlastet. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="cs">Často bývají okna sdružena pomocí slepého oblouku = vylehčovací oblouku. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="fr">arc d\&apos;encadrement</skos:prefLabel>
        <skos:prefLabel xml:lang="es">arco de refuerzo</skos:prefLabel>
        <skos:prefLabel xml:lang="it">arco estradossato di una volta</skos:prefLabel>
        <skos:prefLabel xml:lang="en">enclosing arch</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">vylehčovací oblouk</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Überfangbogen</skos:prefLabel>
