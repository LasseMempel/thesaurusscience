    <!-- https://hist-arch-vocab.org/bvha#c_24f8dff1 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_24f8dff1">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
