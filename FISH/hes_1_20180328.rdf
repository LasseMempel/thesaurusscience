	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1938">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1938</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">ÀMHAINN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Soitheach breige, cloiche no iarainn anns am fuinear aran no biadh eile.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">OVEN</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1897" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1933" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/831" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/993" />
		<skos:scopeNote xml:lang="en">A brick, stone or iron receptacle in which bread and other food is baked.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
