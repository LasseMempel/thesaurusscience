        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_47v6axo2"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_a469ccf4"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_fac70203"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-22T18:45:43.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T16:52:26.000</terms:modified>
        <skos:definition xml:lang="de">Glockenweihe f: die nach dem Pontificale Romanum seit dem 8. Jh. gebräuchliche feierliche Benediktion der Glocken zum kirchlichen Gebrauch. Seit dem Ende des 10. Jh. ist es üblich, den Glocken Namen zu geben. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Glockenweihe</skos:prefLabel>
        <skos:prefLabel xml:lang="en">blessing of bells</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">bénédiction d\&apos;une cloche </skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_c2828222 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_c2828222">
