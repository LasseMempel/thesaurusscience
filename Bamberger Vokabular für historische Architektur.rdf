    <!-- https://hist-arch-vocab.org/bvha#c_7987b532 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_7987b532">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_d3971ceb"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
