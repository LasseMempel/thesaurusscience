    <!-- https://hist-arch-vocab.org/bvha#c_528a88fc -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_528a88fc">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_78eff904"/>
