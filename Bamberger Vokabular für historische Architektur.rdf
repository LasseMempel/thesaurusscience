    <!-- https://hist-arch-vocab.org/bvha#c_547fcfae -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_547fcfae">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_acee6be4"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_08ba96ad"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_be46b94e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:altLabel xml:lang="en">Albarrana tower</skos:altLabel>
        <skos:altLabel xml:lang="de">al-barrānī</skos:altLabel>
        <skos:altLabel xml:lang="es">torre albarrana</skos:altLabel>
        <skos:definition xml:lang="es">&quot;Del árabe al-barrāna, la de fuera. Torre de vigilancia separada de las murallas que está unida a la fortificación por un subterráneo o un puente. Ejemplo: la Torre del Oro de Sevilla.&quot; [Lajo 1990]</skos:definition>
        <skos:definition xml:lang="en">&quot;Spanish term for a tower projecting from the walls of a castle or city fortifications and connected by means of a bridge. The earliest example in Spain is at Merida and is connected to the ninth-century fortress, but most other examples are later.&quot; [Petersen 1996]</skos:definition>
        <skos:prefLabel xml:lang="de">Albarrana</skos:prefLabel>
        <skos:prefLabel xml:lang="es">albarrana</skos:prefLabel>
        <skos:prefLabel xml:lang="en">albarrani</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_548ad7f5 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_548ad7f5">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1fbc2459"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_19d56a39"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-23T12:22:30.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T11:46:04.000</terms:modified>
        <skos:definition xml:lang="de">Schräges geschosshohes Holz, das von der Schwelle bis zum Rähm bzw. Geschossriegel reicht und einen Bund- oder Zwischenständer überblattet; im Dachgerüst auch zwischen Dachbalken und Kehlbalken oder -riegel. [Eißing et al. 2012]</skos:definition>
        <skos:prefLabel xml:lang="de">Steigstrebe</skos:prefLabel>
    </owl:NamedIndividual>
    


