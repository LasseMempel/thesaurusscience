    <!-- https://hist-arch-vocab.org/bvha#c_c56398cd -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_c56398cd">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_zynvte6n"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-20T11:35:34.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T14:54:57.000</terms:modified>
        <skos:note xml:lang="fr">Actions visant à stopper provisoirement le développement d’une dégradation et à sauver une peinture murale ou une partie. (EwaGlos)</skos:note>
        <skos:note xml:lang="de">Restauratorische Eingriffe, die eine aktive Schädigung zeitweise stoppen sollen, um einen Teil oder die gesamte Wandmalerei zu retten. (EwaGlos)</skos:note>
        <skos:note xml:lang="en">Treatments that aim to temporarily halt active deterioration and preserve a part of or the entire wall painting. (EwaGlos)</skos:note>
        <skos:prefLabel xml:lang="de">Notfallmaßnahmen</skos:prefLabel>
        <skos:prefLabel xml:lang="tr">acil durum önlemleri</skos:prefLabel>
