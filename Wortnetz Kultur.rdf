	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk014976">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="en">candy</skos:altLabel>
		<skos:prefLabel xml:lang="en">confectionery (food)</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Süßware</skos:prefLabel>
		<skos:altLabel xml:lang="de">Süßwaren</skos:altLabel>
