        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-30T16:28:57.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-03T16:01:04.000</terms:modified>
        <skos:definition xml:lang="de">Die Form [der Doppelzahnfläche] entspricht weitestgehend der Glattfläche. Die Anzahl der Zähne ist sehr unterschiedlich. [...] Anhand von Bearbeitungsspuren kann jedoch nachgewiesen werden, dass die Zahnfläche in unterschiedlichster Ausführung vorkam und sich im laufe der Jahrhunderte deutlich veränderte. [Voelkle 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Doppelzahnfläche</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_52621f78 -->


