    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Osier Beds"@en ;
    skos:scopeNote "An area where osiers (types of willows, producing long straight stems) are cultivated for use in basketry."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151252> a skos:Concept ;
