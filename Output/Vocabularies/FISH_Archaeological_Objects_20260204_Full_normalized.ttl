    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96512> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Collared Lid"@en ;
    skos:scopeNote "A lid with a carinated conical profile and straight vertical sides, surmounted by a conical top with and integral knob. (Source: MPRG)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/148407> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96512> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Conical Lid"@en ;
    skos:scopeNote "A lid with a shallow conical profile and an integral knob. (Source: MPRG)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/148408> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96512> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Dish Lid"@en ;
    skos:scopeNote "A simple flat-topped lid resembling an inverted dish but with no central knob or handle. (Source: MPRG)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/148409> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96512> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Domed Lid"@en ;
    skos:scopeNote "A lid with a shallow domed profile and a central knob. (Source: MPRG)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/148410> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96512> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Flat Lid"@en ;
    skos:scopeNote "A simple, flat or nearly flat lid. In ceramic forms, often made by rolling out clay rather than by throwing on a wheel. (Source: MPRG)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/148411> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96512> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Flat Topped Lid"@en ;
    skos:scopeNote "A lid resembling an inverted dish with a flat top and an integral or added knob or loop handle. (Source: MPRG)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/148412> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96512> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Saucer Shaped Lid"@en ;
    skos:scopeNote "A lid comprising a shallow flared dish with an integral knob rising from the centre. (Source: MPRG)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/148414> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/148413> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Locking Lid"@en ;
    skos:scopeNote "A type of flanged lid where the lower flange is partly cut away to leave two projections or lugs, which can be fitted into corresponding cut-outs in the rim of the vessel beneath and secure the lid when it is rotated. (Source: MPRG)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/148415> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96512> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Complex Lid"@en ;
    skos:scopeNote "A complex or ornate lid which cannot be easily classified according to the main forms of lid. (Source: MPRG)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/148416> a skos:Concept ;
    skos:altLabel "Chamber Candlestick"@en,
        "Hand Lamp"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96198> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Saucer Candlestick"@en ;
    skos:scopeNote "A candlestick in which a simple socket is set in the centre of a drip tray or saucer. There may be a vertical loop handle linking the socket to the rim of the saucer. (Source: MPRG)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/148419> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96198> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Upright Candlestick"@en ;
    skos:scopeNote "A candlestick in which the socket is above a drip tray or grease tray, placed on a pedestal base which is generally hollow. There may be a vertical loop handle and one or more secondary drip trays. (Source: MPRG)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/148420> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96213> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Compartmented Lamp"@en ;
    skos:scopeNote "A deep, square or rectangular, flat slab of clay, the upper surface of which has two or more cup-shaped holders cut into it. (Source: MPRG)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/148421> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96213> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Double Shelled Lamp"@en ;
    skos:scopeNote "A pedestal lamp with a drip-tray below the bowl. There may be a vertical loop handle linking bowl and drip-tray. Some variants have a more enclosed bowl form with a small tubular spout projecting from the bowl. (Source: MPRG)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/148422> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96213> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Hemispherical Lamp"@en ;
    skos:scopeNote "A small hemispherical bowl with a pinched or pulled wick lip. (Source: MPRG)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/148423> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96213> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Pedestal Lamp"@en ;
    skos:scopeNote "A small bowl on a pedestal base, which may be solid or at least partly hollow. It may have a wick lip at the rim or a lug handle. (Source: MPRG)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/148424> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96213> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Saucer Lamp"@en ;
    skos:scopeNote "A small bowl on a pedestal base above a drip-tray or saucer. It may have a wick lip at the rim. May have pierced lugs projecting form the rim for suspension of a handle, spout or vertical loop handle linking bowl and saucer. (Source: MPRG)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/148425> a skos:Concept ;
    skos:altLabel "Pricket Lamp"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96213> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Spike Lamp"@en ;
    skos:scopeNote "A small hemispherical or flared bowl with a solid pointed base or spike. May include a wick lip at the rim and one or two pierced lugs for suspension. (Source: MPRG)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/148427> a skos:Concept ;
    skos:altLabel "Bowl Curfew"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97555> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Flared Curfew"@en ;
    skos:scopeNote "A curfew with straight sides flaring outwards from the top. (Source: MPRG)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/148429> a skos:Concept ;
    skos:altLabel "Bell Shaped Curfew"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97555> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Hemispherical Curfew"@en ;
    skos:scopeNote "A curfew with a rounded profile merging into a rounded top, with no discernible angle. (Source: MPRG)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/148431> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97555> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Half Round Curfew"@en ;
    skos:scopeNote "A curfew consisting of a half section of an inverted bowl. The form has been adapted for use against a wall. (Source: MPRG)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/148432> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97555> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Flanged Curfew"@en ;
    skos:scopeNote "A curfew consisting of a half-bell shape with a raised flange around the cut-away side. A vertical loop handle joins the flange and body. The form is adapted for use against a wall and some are highly decorated. (Source: MPRG)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/149182> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96928> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Convex End Scraper"@en ;
    skos:scopeNote "An end scraper that has a retouched end which is convex in form. (Source: SARC)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/149183> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96928> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Transverse End Scraper"@en ;
    skos:scopeNote "An end scraper made on a flake that is wider than it is long. (Source: SARC)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/149184> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96928> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Straight End Scraper"@en ;
    skos:scopeNote "An end scraper which has a retouched end that is straight in form. If the tool blank is a blade or flake, and the retouch is abrupt retouch rather than scraper retouch then use either Truncated blade or Truncated flake. (Source: SARC)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/149185> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96928> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Concave End Scraper"@en ;
    skos:scopeNote "An end scraper which has a retouched end that is concave in form. (Source: SARC)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/149186> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97143> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Notch"@en ;
    skos:scopeNote "A side scraper with a short concavity retouched into an edge. This may be achieved by a single blow. (Source: SARC)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/149188> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96373> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Lanceolate Microlith"@en ;
    skos:scopeNote "A microlith retouched to a point, usually with oblique retouch. They are synonymous with 'obliquely blunted points' of the English Mesolithic. (Source: SARC)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/149189> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96373> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Lunate Microlith"@en ;
    skos:scopeNote "A microlith retouched to a half moon or crescent shape. (Source: SARC)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/149190> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96373> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Triangular Microlith"@en ;
    skos:scopeNote "A microlith retouched to a triangular shape. They can be sub-divided into scalene and isosceles triangles. (Source: SARC)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/149191> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96373> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Trapeze Microlith"@en ;
    skos:scopeNote "A microlith retouched to a trapezium shape. (Source: SARC)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/149192> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96373> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Rectangle Microlith"@en ;
    skos:scopeNote "A microlith retouched to a rectangular shape. (Source: SARC)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/149193> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96373> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Rhomboid Microlith"@en ;
    skos:scopeNote "A microlith retouched to a thomboid shape. (Source: SARC)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/149194> a skos:Concept ;
    skos:altLabel "Core Axe"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/100153>,
        <http://purl.org/heritagedata/schemes/mda_obj/concepts/97566> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Core Axehead"@en ;
    skos:scopeNote "A stone axe in which the surface is fully covered by negative removals. Core axes may be made on flakes and have part of the flake's original surface but this cannot be part of the edge otherwise use FLAKED AXE. (Source: SARC)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/149195> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/151831> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Conical Blade Core"@en ;
    skos:scopeNote "A stone core with a conical form and a core platform which may or may not be prepared. Blades are removed around the circumference of the platform. The end of the core opposite the platform usually tapers to a point. (Source: SARC)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/149196> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/151831> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Conical Microblade Core"@en ;
    skos:scopeNote "A small stone core with a conical form and a single core platform which may or may not be prepared. Microblades are removed form the circumference of the platform. The end opposite the platform usually tapers to a point. (Source: SARC)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/149197> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97552> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Handle Core"@en ;
    skos:scopeNote "A stone core made on a large thick flake and characterized by a distinctive, unworked or slightly-shaped handle section. The platform is plain and microblades are detached mainly form the front section of the core. (Source: SARC)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/149198> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/151831> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Cylindrical Blade Core"@en ;
    skos:scopeNote "A core which has two opposing platforms. One end serving as the main platform for the removal of blades - the other being used to straighten the face of the core and correct knapping errors. Removals are taken from the full circumference. (Source: SARC)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/149199> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97552> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Keeled Core"@en ;
    skos:scopeNote "A core used to produce flakes from a single plain platform. The base of the core, or 'keel', is often formed by alternate removal from a process resembling cresting. Often one end has a relatively unmodified section. (Source: SARC)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/149200> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97552> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Multiple Platform Core"@en ;
    skos:scopeNote "A core with more than two distinct platforms usually including one or two striking surfaces and the the traces of former platforms. Usually restricted to flake production. (Source: SARC)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/149201> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97552> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Irregular Core"@en ;
    skos:scopeNote "A stone core which is irregular in shape. It can have numerous usuable or abandoned striking platforms. It is the most common core type and it is often the last attempt of a knapper to extract the final usable flakes form the core. (Source: SARC)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/149205> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97243>,
        <http://purl.org/heritagedata/schemes/mda_obj/concepts/97448> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Fuming Pot"@en ;
    skos:scopeNote "A jar-shaped vessel with pierced apertures or cut-out on an open or closed pedestal base. Herbs, spices or scented woods would be placed in the pot and a burning coal placed underneath to warm the herbs so they would release their scent."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/149207> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97448> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Heating Stand"@en ;
    skos:scopeNote "A heating apparatus in which coals or embers are placed in the pedestal or base below a container in which food or liquid could be held and kept warm."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/149208> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97448> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Beverage Warmer"@en ;
    skos:scopeNote "A small, handled, open vessel, generally with a steep profile, designed to sit partially within a larger vessel and used to warm drinks. (Source: MPRG)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/149210> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97233> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Cucurbit"@en ;
    skos:scopeNote "A vessel used as the lower part of a distillation unit consisting of a round-bottomed vessel with walls sloping inwards towards the rim. Some examples may have an external flange to support the upper unit (ALEMBIC). (Source: MPRG)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/149211> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/97233> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Candlemakers Trough"@en ;
    skos:scopeNote "A deep, rectangular or oval, straight-sided vessel with an everted, crenellated rim, used to hold either wax for dipping candles or molten sulphur for dipping matches. (Source: MPRG)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/149213> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96848> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Barrel Costrel"@en ;
    skos:scopeNote "A costrel with a barrel-shaped body and a centrally placed neck. One end is usually flat and the other domed. Two opposed strap handles or lugs join the rim or neck and shoulder. (Source: MPRG)"@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/149214> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96848> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Cylindrical Costrel"@en ;
