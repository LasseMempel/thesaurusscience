				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1215" />
				<skos:scopeNote xml:lang="en">An enclosure defined by a wall or fence that is situated above an underground gas supply pipe containing buildings or other structures designed to provide access to the supply via valves.</skos:scopeNote>
