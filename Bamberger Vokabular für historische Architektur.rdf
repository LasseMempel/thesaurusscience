        <skos:definition xml:lang="de">(Mz. Anuli); Schmale Ringe am dorischen Kapitell. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">ANULI (č.j. anulus), úzké proužky na dórské lavici. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Anuli (lat. Ringe), scharf unterschnittene Ringe, meist vier, mit überfallendem Profil am dor. Kapitell am unteren Ende des Echinus (Dorische Ordnung). [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Anulus</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">anulus</skos:prefLabel>
    </owl:NamedIndividual>
    


