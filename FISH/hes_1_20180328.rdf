		<skos:prefLabel xml:lang="gd">TÈIRMINEAL GAS</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Ionad aig ceann thall pìob-loidhne far a bheilear a' stòradh gas nàdarra mus tèid a chur air adhart.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GAS TERMINAL</skos:prefLabel>
