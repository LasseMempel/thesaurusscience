    skos:closeMatch <http://data.uba.de/umt/_00025123> ;
    skos:definition "EPA is the US Government's watchdog agency responsible for controlling the pollution of air and water, pesticides, radiation hazards and noise pollution. The agency is also involved in research to examine the effects of pollution."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Umweltbehörde"@de,
        "environmental protection agency"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/United_States_Environmental_Protection_Agency> .

<http://www.eionet.europa.eu/gemet/concept/2902> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/607> ;
    skos:definition "Associations whose object resides in the protection of natural environment."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Umweltschutzverband"@de,
        "environmental protection association"@en .

<http://www.eionet.europa.eu/gemet/concept/2903> a skos:Concept ;
    skos:broadMatch <http://eurovoc.europa.eu/5839> ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2796> ;
    skos:closeMatch <http://data.uba.de/umt/_00025313> ;
