        <skos:prefLabel xml:lang="cs">typy profilů (u dveří)</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_b7d397ba -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b7d397ba">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_d91b6895"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-21T16:42:36.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-10-14T15:57:58.000</terms:modified>
        <skos:definition xml:lang="de">(gr. falscher Prostylos), Tempel mit Wandsäulen anstelle der Säulen an den Stirnseiten. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Pseudoprostylos</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_b7d6262f -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b7d6262f">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f5854446"/>
