<http://www.eionet.europa.eu/gemet/concept/7541> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/901> ;
    skos:closeMatch <http://data.uba.de/umt/_00022322> ;
    skos:definition "In the case of disruption of an existing biotope, secondary biotope can be created as a compensation and substitute measure for the loss of the natural one."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Sekundärbiotop"@de,
