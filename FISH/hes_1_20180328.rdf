		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/742" />
		<skos:scopeNote xml:lang="en">A building or site used for the manufacture of small arms and artillery pieces, ammunition, propellants, explosives etc.</skos:scopeNote>
