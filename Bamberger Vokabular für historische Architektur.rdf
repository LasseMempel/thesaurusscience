        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-05T09:43:35.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T11:33:30.000</terms:modified>
        <skos:altLabel xml:lang="de">Verdachung</skos:altLabel>
        <skos:definition xml:lang="de">Fensterbekrönung, vorspringendes Bauglied über einer Fensteröffnung an der Außenwand, urspr. zur Entlastung und vielleicht als Regenschutz, meist aber rein dekorativ angewendet. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Fensterverdachung</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">zastřešení okna (např. římsa)</skos:prefLabel>
    </owl:NamedIndividual>
    


