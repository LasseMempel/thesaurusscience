        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T23:15:07.000</terms:modified>
        <skos:definition xml:lang="de">Denkmal in Form einer Säule, schon im gr. Delphi und in spätröm. Zeit bekannt, in neuerer Zeit nachgeahmt. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Ehrensäule</skos:prefLabel>
    </owl:NamedIndividual>
    


