    <!-- https://hist-arch-vocab.org/bvha#c_5c8f441d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_5c8f441d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_5615a6bf"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-04-05T07:11:46.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T17:37:14.000</terms:modified>
        <skos:definition xml:lang="cs"> Nezastřešené schodiště umístěné před domovní průčelím, v době renesance a baroka zvl. reprezentativně ztvárněno, často zdůrazňuje symetrii budovy. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Der Hausfassade vorgelegte Treppe ohne Dach, in Renaissance und Barock besonders repräsentativ gestaltet. Betont oft die Symmetrie des Gebäudes. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Große, nicht innerhalb eines Baukörpers liegende und meist axial auf den Eingang zuführende Treppe. B. Sch.-W. . [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:definition xml:lang="de">Offene Treppenanlage, die zum erhöhten Erdgeschoss oder 1. Obergeschoss eines Gebäudes emporführt, im Unterschied zur Außentreppe senkrecht auf den Eingang zuführend. Bereits im Altertum waren monumentale F.n ein wichtiges baukünstler. Gestaltungsmittel bei Burganlagen; Propyläen, Tempeln; im MA vor Kirchen, seit der Renaissance an Rathäusern, Schlössern und Bürgerhäusern. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Freitreppe</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">venkovní schodiště</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_5615a6bf"/>
        <broaderByPosition rdf:resource="https://hist-arch-vocab.org/bvha#c_5615a6bf"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_5c93b850 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_5c93b850">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1672bfe8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-25T11:37:32.000</terms:created>
        <skos:prefLabel xml:lang="de">Erfassungszeitpunkt</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_5c965d43 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_5c965d43">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_eea5235b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T20:30:21.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-02T16:27:58.000</terms:modified>
        <skos:altLabel xml:lang="de">Hornbogen</skos:altLabel>
        <skos:altLabel xml:lang="de">ansteigender Bogen</skos:altLabel>
        <skos:altLabel xml:lang="es">arco en declive</skos:altLabel>
        <skos:altLabel xml:lang="es">arco inclinado</skos:altLabel>
        <skos:altLabel xml:lang="en">rampant arch</skos:altLabel>
        <skos:definition xml:lang="de">Bogen, bei dem die Verbindungslinie zweier korrespondierender Kämpferpunkte nicht auf einer waagerechten Linie liegen. Er kommt häufig unter Treppenläufen vor und man spricht dann auch von einem Schwanenhals(bogen). Zu unterscheiden vom Halbbogen. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Ein Bogen oder Gewölbe, bei dem die korrespondierenden Kämpferpunkte (Kämpfer) nicht in derselben Höhe liegen (Bogenformen). [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">einhüftiger Bogen, ~ *Bogenform mit steigender Kämpferlinie. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="fr">arc rampant</skos:prefLabel>
        <skos:prefLabel xml:lang="es">arco por tranquil</skos:prefLabel>
        <skos:prefLabel xml:lang="it">arco rampante</skos:prefLabel>
        <skos:prefLabel xml:lang="de">einhüftiger Bogen</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kobylí hlava</skos:prefLabel>
        <skos:prefLabel xml:lang="en">rising arch</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_eea5235b"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_5ca32d4c -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_5ca32d4c">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
