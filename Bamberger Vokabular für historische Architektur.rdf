    <!-- https://hist-arch-vocab.org/bvha#c_3a4425c0 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_3a4425c0">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f4e2bee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-11T13:25:49.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-02T15:23:48.000</terms:modified>
        <skos:altLabel xml:lang="de">Mönch-und-Nonnen-Dach</skos:altLabel>
        <skos:definition xml:lang="de">Auch Mönch-und-Nonnen-Dach, besonders in Süd-Europa übliche Anordnung halbrunder Dachziegel. Die unteren Ziegel heißen Nonnen, sind breit und liegen eng, die Fuge wird von einem schmaleren »Mönch« bedeckt. Mönch und Nonne in einem Stück gebacken ergeben die Klosterpfanne. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Uspořádání půlkruhových střešních tašek používané zvl. v jižní Evropě; spodní tašky se nazývají „korýtka&quot; (N Nonne), jsou široké a leží těsně vedle sebe, mezeru mezi nimi zakrývá užší „hák&quot; (N Monch); korýtko a hák vypálené v jednom kusu tvoří tzv. klášterní tašku. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Priependach</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">prejzová střecha</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_3a4cd422 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_3a4cd422">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b9eb688f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-03T20:55:31.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-03T20:57:48.000</terms:modified>
        <skos:altLabel xml:lang="de">Hornreliquiar</skos:altLabel>
        <skos:altLabel xml:lang="de">Olifant</skos:altLabel>
        <skos:definition xml:lang="de">Reliquienhorn n; Hornreliquiar n; auch Olifant m; lat. cornu eburneum: ein aus Elfenbein gefertigtes Horn, ehemals ein Jagd- oder Signalhorn, das mit Beschlägen reich verziert ist und Reliquien birgt. Es steht oft auf einem Ständer oder hängt an Ketten. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Reliquienhorn</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">corne-reliquaire</skos:prefLabel>
        <skos:prefLabel xml:lang="la">cornu eburneum</skos:prefLabel>
        <skos:prefLabel xml:lang="en">horn-reliquary</skos:prefLabel>
    </owl:NamedIndividual>
    


