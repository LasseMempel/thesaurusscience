				<skos:prefLabel xml:lang="gd">STÈISEAN DÌ-MHAGNAITEACHAIDH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Ionad far an deach comas magnaiteach de shoithichean a lùghdachadh airson 's gum biodh e na b' fhasa dhaibh mèinnean magnaiteach a sheachnadh.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">DEGAUSSING STATION</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1382" />
				<skos:scopeNote xml:lang="en">An installation where the magnetic signature of ships was lowered thereby making them less susceptible to magnetic mines.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
