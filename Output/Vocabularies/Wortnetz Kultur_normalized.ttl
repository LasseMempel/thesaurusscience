<http://lvr.vocnet.org/wnk/wk021250> a skos:Concept ;
    skos:altLabel "Brieftaubenuhr"@de,
        "Konstatierapparat"@de,
        "Taubenuhr"@de,
        "pigeon clocks"@en ;
    skos:broadMatch <http://vocab.getty.edu/aat/300434732> ;
    skos:broader <http://lvr.vocnet.org/wnk/wk003319> ;
    skos:definition "Eine Konstatieruhr ist eine Uhr, die die spezielle Funktion erfüllt, Ankunftszeiten von Brieftauben manipulationssicher zu dokumentieren. Sie besteht aus einem Uhrwerk, das mit einem Schlagwerk verbunden ist, das die Ankunftszeiten von Brieftauben auf einem Papierstreifen festhält. Sie hat oft eine Vorrichtung zur Aufnahme von Gummiringen, die den Tauben zugeordnet sind."@de ;
    skos:exactMatch <http://d-nb.info/gnd/1175406635>,
        <http://www.wikidata.org/entity/Q1782910> ;
    skos:inScheme <http://lvr.vocnet.org/wnk> ;
    skos:prefLabel "Konstatieruhr"@de,
        "pigeon clock"@en .

