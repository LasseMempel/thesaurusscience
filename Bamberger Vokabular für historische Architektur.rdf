        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-25T15:00:46.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-28T08:47:07.000</terms:modified>
        <skos:altLabel xml:lang="en-gb"></skos:altLabel>
        <skos:altLabel xml:lang="de">Altarglöckchen </skos:altLabel>
        <skos:altLabel xml:lang="de">Altarschelle</skos:altLabel>
        <skos:altLabel xml:lang="en">Mass bell</skos:altLabel>
        <skos:altLabel xml:lang="de">Messglöckchen</skos:altLabel>
        <skos:altLabel xml:lang="en">Sacryn bell</skos:altLabel>
        <skos:altLabel xml:lang="de">Sanktusglocke</skos:altLabel>
        <skos:altLabel xml:lang="it">campanello da messa</skos:altLabel>
        <skos:altLabel xml:lang="fr">clochette d\&apos;autel</skos:altLabel>
        <skos:altLabel xml:lang="en">sacring bell</skos:altLabel>
        <skos:altLabel xml:lang="en">saints\&apos; bell</skos:altLabel>
        <skos:altLabel xml:lang="en">sance-bell</skos:altLabel>
        <skos:altLabel xml:lang="en">sanctus bell</skos:altLabel>
        <skos:altLabel xml:lang="fr">sonnette</skos:altLabel>
        <skos:definition xml:lang="de">Ein Glöckchen, mit dem nach heutiger Vorschrift in der Messe beim Sanktus und bei den auf die Konsekration der Hostie und des Weines folgenden Elevationen allgemein sowie nach örtlichem Brauch vielfach auch bei Beginn der Opferung und dem Domine non sum dignus vor der Kommunion ein Zeichen gegeben wird, um die Aufmerksamkeit der Gläubigen auf jene Akte zu lenken. [RDK Labor]</skos:definition>
        <skos:prefLabel xml:lang="de">Altarglocke</skos:prefLabel>
        <skos:prefLabel xml:lang="nl">altaarschel</skos:prefLabel>
        <skos:prefLabel xml:lang="en">altar bell</skos:prefLabel>
        <skos:prefLabel xml:lang="it">campanello</skos:prefLabel>
        <skos:prefLabel xml:lang="la">campanula</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">oltářní zvonek</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">sonnette d\&apos;autel</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_7cee1fe4 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_7cee1fe4">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_162d82c1"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_f10222e0"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-03T11:48:00.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T13:23:51.000</terms:modified>
        <skos:altLabel xml:lang="de">Schrämschlitz</skos:altLabel>
        <skos:definition xml:lang="de">Mit einem langstieligen, schlanken Zweispitz (Schrämhacke oder Sehrotpickel genannt) wurden etwa 10 - 15 cm breite Schlitze, die sogenannten Schräme, in den Sandstein gehauen. Die Tiefe dieser Schräme und damit die Blockgröße hing neben der nutzbaren Abbauhöhe auch vom handwerklichen Können des Steinbrechers ab. [Voelkle 2016] </skos:definition>
        <skos:prefLabel xml:lang="de">Schräme</skos:prefLabel>
    </owl:NamedIndividual>
    


