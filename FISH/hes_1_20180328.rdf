		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1014" />
		<skos:scopeNote xml:lang="en">An externally-heated boiler made from a fabricated steel tube with domed ends, designed to contain high-pressure steam. Egg-end boilers were often used to drive steam engines.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
