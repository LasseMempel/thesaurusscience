		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/665" />
		<skos:scopeNote xml:lang="en">A building where tallow is produced. Tallow is solid animal fat that has been separated by heating, usually for making candles.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
