		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Aufbackbrot</skos:prefLabel>
		<skos:altLabel xml:lang="de">Aufbackbrote</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006171"/>
