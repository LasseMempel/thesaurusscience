    skos:inScheme <http://purl.org/heritagedata/schemes/eh_com> ;
    skos:prefLabel "Lavatorium"@en ;
    skos:scopeNote "A communal wash area, sometimes a dedicated outbuilding, or facility, such as a basin or trough, used by monks."@en .

<http://purl.org/heritagedata/schemes/eh_com/concepts/139627> a skos:Concept ;
    skos:altLabel "Inscribed Panel"@en,
