				<skos:scopeNote xml:lang="en">Traces left by past cultivation, in the form of upstanding features, subsoil marks or cropmarks. Use more specific term where possible.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
