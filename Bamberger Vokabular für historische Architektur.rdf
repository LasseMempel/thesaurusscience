    <!-- https://hist-arch-vocab.org/bvha#c_zafa5lop -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_zafa5lop">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_3e25acca"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_fadb7f3f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_b4dbeb90"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_c9eb50a0"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-10T14:55:40.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T17:24:15.000</terms:modified>
        <skos:altLabel xml:lang="de">Gewölbeschlusstein</skos:altLabel>
        <skos:altLabel xml:lang="de">Hängeknauf (Schlussstein)</skos:altLabel>
        <skos:altLabel xml:lang="it">chiave d\&apos;arco</skos:altLabel>
        <skos:altLabel xml:lang="it">chiave di volta</skos:altLabel>
        <skos:altLabel xml:lang="es">clave de arco</skos:altLabel>
        <skos:altLabel xml:lang="fr">clef de voûte</skos:altLabel>
        <skos:altLabel xml:lang="en">keystone</skos:altLabel>
        <skos:altLabel xml:lang="cs">klenák z přírodní břidlice</skos:altLabel>
        <skos:altLabel xml:lang="cs">svorník</skos:altLabel>
        <skos:altLabel xml:lang="cs">vrcholový klenák</skos:altLabel>
        <skos:altLabel xml:lang="cs">závěrný klenák</skos:altLabel>
        <skos:definition xml:lang="de">1. Der im Scheitel eines Bogens oder Knotenpunkts von Rippen sitzende Stein, auch als Knauf ausgebildet; 2. Abhängling, Hängeknauf, spätgotische Form des Schlusssteins: herabhängender Knauf. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Oberster Stein in einem Bogen oder in einem Kreuzrippengewölbe. In der Sakralarchitektur ist dieser Stein oft besonders gestaltet und durch Bauskulptur geschmückt. Im Burgenbau ist dies seltener der Fall, doch kommt es vor, dass die Sch.e mit Wappenschildern versehen sind (Burg Lauf BY). B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:definition xml:lang="de">Scheitelstein, 1. der Stein im Scheitelpunkt eines Bogens, falls keine Scheitelfuge vorhanden ist. 2. Stein am Hauptknotenpunkt der Rippeneines Gewölbes. Die Rippenquerschnitte sind noch teilweise an den meist kreisrunden und figurierten S. angearbeitet. Seltener kommt der ringförmige S. mit offenem Scheitelloch vor, während der hängende S.(Abhängling) eine Sonderform ist. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Schlussstein</skos:prefLabel>
        <skos:prefLabel xml:lang="en">apex stone</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">clef d\&apos;arc</skos:prefLabel>
        <skos:prefLabel xml:lang="es">piedra angular</skos:prefLabel>
        <skos:prefLabel xml:lang="it">serraglia</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">závěrečný klenák</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_fadb7f3f"/>
        <broaderByPosition rdf:resource="https://hist-arch-vocab.org/bvha#c_3e25acca"/>
    </owl:NamedIndividual>
    


