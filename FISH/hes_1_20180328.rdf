		<skos:prefLabel xml:lang="gd">UAMH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar fon talamh a ruigear o bhruthach, aodann creige is msaa. Dh'fhaoidte gun deach an uamh a chleachdadh mar àite-fuirich, stòras, àite tìodhlacaidh, ionad sgudail no àite falaich.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CAVE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1566" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/413" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/466" />
		<skos:scopeNote xml:lang="en">A subterranean feature entered from a hillside, cliff face, etc. A cave may have been used for occupation, storage, burial, refuse, or as a hide-away.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
