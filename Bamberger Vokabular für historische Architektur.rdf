        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_a8df27f2"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-23T18:33:14.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T13:05:47.000</terms:modified>
        <skos:prefLabel xml:lang="de">Pokal</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">pohár</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Ein Pokal st ein Trinkgefäß, dessen Schale (Kuppa) vom Fuß durch einen eigenen Schaft getrennt ist. Vom Kelch und Ziborium unterscheidet er sich durch seinen profanen Gebrauch, vom Becher durch den hohen Schaft.</skos:scopeNote>
    </owl:NamedIndividual>
    


