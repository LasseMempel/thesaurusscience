        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-18T15:12:10.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-24T16:52:37.000</terms:modified>
        <skos:altLabel xml:lang="de">Oratorianerkragen</skos:altLabel>
        <skos:altLabel xml:lang="de">Vatikan-Kollar</skos:altLabel>
        <skos:altLabel xml:lang="en">clerical collar</skos:altLabel>
        <skos:altLabel xml:lang="en">dog collar</skos:altLabel>
        <skos:altLabel xml:lang="de">römisches Kollar</skos:altLabel>
        <skos:definition xml:lang="de">Piuskragen m; Oratorianerkragen m; auch Vatikan-Kollar n; römisches Kollar n: steifer, weißer Kragen aus Tuch oder Synthetic, wie z. B. Azetatseide, der hinten mit einem Knopf geschlossen und zu einem kragenlosen Hemd getragen wird. Anglikanische Geistliche tragen den Piuskragen über dem Hemdkragen. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Piuskragen</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Roman collar</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">col romain</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">římský límec</skos:prefLabel>
    </owl:NamedIndividual>
    


