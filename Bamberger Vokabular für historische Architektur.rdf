        <skos:altLabel xml:lang="cs">obklad</skos:altLabel>
        <skos:altLabel xml:lang="fr">revêtement</skos:altLabel>
        <skos:definition xml:lang="de">Oberflächenverkleidung, die Massivität aus besserem Material vortäuscht. [Koepf / Binding 2016]</skos:definition>
