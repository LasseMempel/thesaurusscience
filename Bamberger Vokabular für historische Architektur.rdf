    <!-- https://hist-arch-vocab.org/bvha#c_4ddb53ed -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_4ddb53ed">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0b6bd415"/>
