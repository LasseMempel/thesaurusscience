        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-13T13:52:29.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:59:48.000</terms:modified>
        <skos:definition xml:lang="de">Ein an Quergurten und einer Zugstange verankertes, kegelformiges Teilgewölbe; oft, wie der Fächer, berippt und in Schichten gegliedert. Zu unterscheiden vom Abhängling. &gt; Hängegewölbe. (Glossarium Artis, Bd.6) </skos:definition>
        <skos:prefLabel xml:lang="de">Hängender Trichter</skos:prefLabel>
        <skos:prefLabel xml:lang="en">pendant (of fan vaulting)</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">retombee (de voûte) pendante</skos:prefLabel>
    </owl:NamedIndividual>
    


