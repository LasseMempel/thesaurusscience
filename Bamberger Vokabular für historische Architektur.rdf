        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-03T15:54:52.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T14:15:23.000</terms:modified>
        <skos:altLabel xml:lang="de">Tropfkante</skos:altLabel>
        <skos:altLabel xml:lang="de">Wassernase</skos:altLabel>
        <skos:altLabel xml:lang="it">cavettino</skos:altLabel>
        <skos:altLabel xml:lang="es">cortagoteras</skos:altLabel>
        <skos:altLabel xml:lang="it">gocciolatoio</skos:altLabel>
        <skos:altLabel xml:lang="cs">okapnice</skos:altLabel>
        <skos:altLabel xml:lang="cs">splávek</skos:altLabel>
        <skos:definition xml:lang="de">An der Unterseite des Wetterschenkels ausgehobelte Rinne. Daran soll - wie bei einem Gesims - der Wasserfluss gebrochen werden und abtropfen, technisches Profil. [Noky 1996]</skos:definition>
        <skos:definition xml:lang="de">Wassernase, Tropfleiste an der vorderen Kante eines Wasserschlags. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Tropfnase</skos:prefLabel>
        <skos:prefLabel xml:lang="en">drip nose</skos:prefLabel>
        <skos:prefLabel xml:lang="es">goterón</skos:prefLabel>
        <skos:prefLabel xml:lang="it">gronda</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">mouchette</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">okapní nos</skos:prefLabel>
    </owl:NamedIndividual>
    


