    skos:closeMatch <http://data.uba.de/umt/_00006617> ;
    skos:definition "Liquid that has seeped through solid waste in a landfill and has extracted soluble dissolved or suspended materials in the process."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_35794> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Deponiesickerwasser"@de,
        "landfill leachate"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Leachate> .

