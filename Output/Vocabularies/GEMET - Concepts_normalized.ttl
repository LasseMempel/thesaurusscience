    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_15509> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Nekrose"@de,
        "necrosis"@en .

<http://www.eionet.europa.eu/gemet/concept/5559> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8794> ;
    skos:closeMatch <http://data.uba.de/umt/_00050801> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Stadtteilentwicklungsprogramm"@de,
        "neighbourhood improvement scheme"@en .

<http://www.eionet.europa.eu/gemet/concept/5565> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4475> ;
    skos:closeMatch <http://data.uba.de/umt/_00017953>,
        <http://dbpedia.org/resource/Nematode> ;
    skos:definition "A group of unsegmented worms which have been variously recognized as an order, class, and phylum."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Nematoden"@de,
        "nematode"@en .

<http://www.eionet.europa.eu/gemet/concept/5569> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/406> ;
    skos:closeMatch <http://data.uba.de/umt/_00017969>,
        <http://dbpedia.org/resource/Nervous_system> ;
    skos:definition "A coordinating and integrating system which functions in the adaptation of an organism to its environment; in vertebrates, the system consists of the brain, brainstem, spinal cord, cranial and peripheral nerves, and ganglia."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_5138> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Nervensystem"@de,
        "nervous system"@en .

<http://www.eionet.europa.eu/gemet/concept/5571> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2566> ;
    skos:closeMatch <http://data.uba.de/umt/_00050804> ;
    skos:definition "The total decrease in the amount of natural materials available for use by humans and other living beings."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Direkter Ressourcenabbau"@de,
        "net resource depletion"@en .

<http://www.eionet.europa.eu/gemet/concept/5572> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4233> ;
    skos:closeMatch <http://data.uba.de/umt/_00040298>,
        <http://dbpedia.org/resource/Emissions_trading> ;
    skos:definition "All emission sources in the same area that are owned or controlled by a single company are treated as one large source, thereby allowing flexibility in controlling individual sources in order to meet a single emissions standard."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/5782> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Netting Policy"@de,
        "netting policy (emissions trading)"@en .

<http://www.eionet.europa.eu/gemet/concept/5575> a skos:Concept ;
    skos:broadMatch <http://eurovoc.europa.eu/3135> ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8538> ;
    skos:closeMatch <http://data.uba.de/umt/_00018018>,
        <http://dbpedia.org/resource/Neurotoxicity> ;
    skos:definition "The occurrence of adverse effects on a nervous system following exposure to a chemical."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_34316> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Neurotoxizität"@de,
        "neurotoxicity"@en .

<http://www.eionet.europa.eu/gemet/concept/5577> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1324> ;
    skos:closeMatch <http://data.uba.de/umt/_00018025> ;
    skos:definition "To make a solution neutral by adding a base to an acidic solution, or an acid to a basic solution."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Neutralisierung"@de,
        "neutralisation"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Neutralization> .

<http://www.eionet.europa.eu/gemet/concept/5580> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7791> ;
    skos:definition "A sociopolitical, religious, occupational or other group of common characteristics and interests formed as an alternative to social, and often residential, options currently available."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Neue Gemeinschaft"@de,
        "new community"@en .

<http://www.eionet.europa.eu/gemet/concept/5581> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4242> ;
    skos:closeMatch <http://data.uba.de/umt/_00017985> ;
    skos:definition "A device, system, or piece of equipment that has been recently installed."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Neuanlage"@de,
        "new installation"@en .

<http://www.eionet.europa.eu/gemet/concept/5583> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5305> ;
    skos:closeMatch <http://data.uba.de/umt/_00047413> ;
    skos:definition "Novel high-performance materials obtained through the interdisciplinary research of chemistry, applied chemistry, chemical engineering, and mechanical engineering."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/3689> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Neuartige Materialien"@de,
        "new material"@en .

<http://www.eionet.europa.eu/gemet/concept/5585> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8330> ;
    skos:definition "Electronic instruments and devices which have recently been developed and are been introduced into industry. New technologies have been introduced often in almost total ignorance or disregard of the biological and ecological systems that they subsequently disturb, and of the dynamic and evolving nature of living systems."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_37468>,
        <http://eurovoc.europa.eu/3636> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Neue Technologie"@de,
        "new technology"@en .

<http://www.eionet.europa.eu/gemet/concept/5593> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4350> ;
    skos:closeMatch <http://data.uba.de/umt/_00028736>,
        <http://dbpedia.org/resource/Nitrate> ;
    skos:definition "Any salt or ester of nitric acid, such as sodium nitrate."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Nitrat"@de,
        "nitrate"@en .

<http://www.eionet.europa.eu/gemet/concept/5598> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1324> ;
    skos:closeMatch <http://data.uba.de/umt/_00018162>,
        <http://dbpedia.org/resource/Nitrification> ;
    skos:definition "The process by which ammonia compounds, including man-made fertilizer and the humus provided by organic matter or plant and animal origin, are converted into nitrites and then nitrates, which are then absorbed as a nutrient by crops. Excess nitrate can be leached into surface waters and groundwaters, causing pollution. Excess nitrate may also be converted by microbes back into gaseous nitrogen, which is an important greenhouse gas, and released back into the atmosphere. The ultimate source of nitrogen in the ecosystem is the molecular nitrogen in the atmosphere. To a very limited extent, some dissolves in water. However, none is found in rock."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_12834> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Nitrifikation"@de,
        "nitrification"@en .

<http://www.eionet.europa.eu/gemet/concept/5601> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4350> ;
    skos:closeMatch <http://data.uba.de/umt/_00018171>,
        <http://dbpedia.org/resource/Nitrite> ;
    skos:definition "A salt or ester of nitric acid, included in compounds such as potassium nitrite, sodium nitrite and butyl nitrite."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Nitrit"@de,
        "nitrite"@en .

<http://www.eionet.europa.eu/gemet/concept/5607> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/833> ;
    skos:closeMatch <http://dbpedia.org/resource/Nitrogen_cycle> ;
    skos:definition "The complex set of processes by which crops acquire the large amount of nitrogen they need to make proteins, nucleic acids and other biochemicals of which they are composed, and how the nitrogen returns to the atmosphere."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_27938> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Stickstoffkreislauf"@de,
        "nitrogen cycle"@en .

<http://www.eionet.europa.eu/gemet/concept/5608> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5613> ;
    skos:closeMatch <http://data.uba.de/umt/_00023467>,
        <http://dbpedia.org/resource/Nitrogen_dioxide> ;
    skos:definition "A reddish-brown gas; it exists in varying degrees of concentration in equilibrium with other nitrogen oxides; used to produce nitric acid."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_5194>,
        <http://rdfdata.eionet.europa.eu/eea/determinants/83> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Stickstoffdioxid"@de,
        "nitrogen dioxide"@en .

<http://www.eionet.europa.eu/gemet/concept/5612> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5613> ;
    skos:closeMatch <http://data.uba.de/umt/_00023484> ;
    skos:definition "A colourless gas, soluble in water, ethanol and ether. It is formed in many reactions involving the reduction of nitric acid, but more convenient reactions for the preparation of reasonably pure NO are reactions of sodium nitrite, sulphuric acid, etc."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Stickstoffmonoxid"@de,
        "nitrogen monoxide"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Nitric_oxide> .

<http://www.eionet.europa.eu/gemet/concept/5618> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/372> ;
    skos:closeMatch <http://data.uba.de/umt/_00018177>,
        <http://dbpedia.org/resource/Nitrosamine> ;
    skos:definition "Any one of a class of neutral, usually yellow oily compounds containing the divalent group = NNO."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_12837> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Nitrosamin"@de,
        "nitrosamine"@en .

<http://www.eionet.europa.eu/gemet/concept/5630> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1064> ;
    skos:closeMatch <http://data.uba.de/umt/_00015625>,
        <http://dbpedia.org/resource/Noise_barrier> ;
    skos:definition "Barriers for reducing the propagation of sound: they are widely used in industry and alongside roads and railways to shield receivers from noise sources. Barriers will not reduce the noise on the receivers side, but will increase it, unless the barrier is also covered in absorbing material."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Lärmschutzwall"@de,
        "noise barrier"@en .

<http://www.eionet.europa.eu/gemet/concept/5633> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13839> ;
    skos:closeMatch <http://data.uba.de/umt/_00015551> ;
    skos:definition "Noise interferes with communication and interferes with thought processes. Noise interferes with sleep, it causes anger and frustration, and has been implicated as a contributor to various psychological and physiological problems. Noise detracts from the quality of life and the environment."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Lärmbelästigung"@de,
        "noise disturbance"@en .

<http://www.eionet.europa.eu/gemet/concept/5637> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3757> ;
    skos:closeMatch <http://data.uba.de/umt/_00015539> ;
    skos:definition "A mandatory sum of money levied by government upon producers of disturbing, harmful or unwanted sounds, frequently in the transportation or construction industries, to encourage reduction of sound levels."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Lärmabgabe"@de,
        "noise emission levy"@en .

<http://www.eionet.europa.eu/gemet/concept/5638> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2932> ;
    skos:closeMatch <http://data.uba.de/umt/_00047808> ;
    skos:definition "Sound is radiated both as air-borne and as structure-borne; most sources produce both, thus various noise attenuation principles must be employed. Measures include: the replacement of components with quieter parts and material; the enclosure of particularly noisy components; the selection of quieter types of fan; the replacement of noisy compressed-air nozzles with quieter types; the choice of quieter transmission and cooling systems."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Lärmarme Technik"@de,
        "noise-free technology"@en .

<http://www.eionet.europa.eu/gemet/concept/566> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3757> ;
    skos:closeMatch <http://data.uba.de/umt/_00019127> ;
    skos:definition "Agreement to provide refunds or payments in exchange for used bottles or packaging materials."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Pfandregelung"@de,
        "arrangement for a deposit on packaging"@en .

<http://www.eionet.europa.eu/gemet/concept/5662> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7531> ;
    skos:closeMatch <http://data.uba.de/umt/_00018198>,
        <http://dbpedia.org/resource/Nomad> ;
    skos:definition """1) A member of a people or tribe who move from place to place to find pasture and food.
2) Nomads include gypsies, desert tribes such as the Bedouin and the many primitive tribes in the Americas, Asia and Australia. Herding survives as a way of life around the Sahara, in the Middle East, in Asia as far east as western India, and in the Asian parts of the USSR. The end of pastoral nomadism would be regrettable not merely on account of the independence and distinctiveness of this way of life but because this type of economy may be a more rational means of raising large numbers of animals under arid conditions than is capital-intensive ranching."""@en ;
    skos:exactMatch <http://eurovoc.europa.eu/2065> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Nomade"@de,
        "nomad"@en .

<http://www.eionet.europa.eu/gemet/concept/5664> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8380> ;
    skos:closeMatch <http://dbpedia.org/resource/Nomenclature> ;
    skos:definition "A system of names or terms, particularly those related to a specific area of science or art, or the assignment of names to things."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_5207>,
        <http://eurovoc.europa.eu/2066> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Nomenklatur"@de,
