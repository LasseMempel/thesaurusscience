        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-29T09:12:51.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T17:28:12.000</terms:modified>
        <skos:altLabel xml:lang="fr">pilier d\&apos;arcboutant </skos:altLabel>
        <skos:definition xml:lang="de">Ein in seinem unteren Teil oder in voller Höhe in den Innenraum eingebundener Strebepfeiler, der Einsatzkapellen ausbilden kann. [Glossarium Artis]</skos:definition>
        <skos:definition xml:lang="de">Eingezogene Strebepfeiler nennt man Strebepfeiler, die in ihrem unteren Teil oder in voller Höhe in den Innenraum einbezogen sind und Rechtecknischen (Einsatzkapellen) umschließen. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="fr">contrefort intérieur</skos:prefLabel>
        <skos:prefLabel xml:lang="de">eingezogener Strebepfeiler</skos:prefLabel>
        <skos:prefLabel xml:lang="es">pilar de arbotante</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_1b866b08 -->


