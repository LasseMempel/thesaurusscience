        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-04T13:35:13.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T13:45:38.000</terms:modified>
        <skos:definition xml:lang="de">Kegelförmige oder runde Haube mit Infulae und Zierbesatz am unteren Rand (mitra cum aurifrisio in circulo). [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Mitra cum aufrisio in circulo</skos:prefLabel>
        <skos:prefLabel xml:lang="la">mitra cum aufrisio in circulo</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_c529c13a"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_b8339847 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b8339847">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_bfa98060"/>
