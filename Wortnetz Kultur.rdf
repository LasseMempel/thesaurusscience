		<skos:altLabel xml:lang="de">Gewürzpaprika</skos:altLabel>
		<skos:altLabel xml:lang="de">Paprika (Frucht)</skos:altLabel>
		<skos:prefLabel xml:lang="de">Paprikaschote</skos:prefLabel>
		<skos:altLabel xml:lang="de">Paprikaschoten</skos:altLabel>
