        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-08T21:05:58.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T14:45:12.000</terms:modified>
        <skos:altLabel xml:lang="tr">derzleme</skos:altLabel>
        <skos:definition xml:lang="en">Action fill/refill the mortar joints between masonry blocks (including those made of stone, brick or other materials).(EwaGlos)</skos:definition>
        <skos:definition xml:lang="fr">Avant de rejointoyer, il est necessaire d’eliminer, manuellement ou mecaniquement, le mortier degrade subsistant dans les joints de la maconnerie, ce qui permettra de remplir les joints avec un mortier adapte. Dans le cas de mortiers historiques, on essaie de conserver le plus de materiau original possible. (EwaGlos)</skos:definition>
        <skos:definition xml:lang="de">Masnahme, um die Mörtel-Verfugung zwischen Mauersteinen (aus Stein, Ziegel oder anderen Materialien) zu füllen oder zu erneuern.. (EwaGlos)</skos:definition>
        <skos:prefLabel xml:lang="de">Neuverfugung</skos:prefLabel>
        <skos:prefLabel xml:lang="tr">derz tamiri</skos:prefLabel>
        <skos:prefLabel xml:lang="hu">fugajavitas</skos:prefLabel>
        <skos:prefLabel xml:lang="bg">npecjlyr~paHe</skos:prefLabel>
        <skos:prefLabel xml:lang="hr">ponovno fugiranje</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">rejointoiement</skos:prefLabel>
        <skos:prefLabel xml:lang="es">rejuntar</skos:prefLabel>
        <skos:prefLabel xml:lang="en">repointing</skos:prefLabel>
        <skos:prefLabel xml:lang="it">ricigliare</skos:prefLabel>
        <skos:prefLabel xml:lang="ro">rostuire</skos:prefLabel>
        <skos:prefLabel xml:lang="pl">spoinowanie</skos:prefLabel>
    </owl:NamedIndividual>
    


