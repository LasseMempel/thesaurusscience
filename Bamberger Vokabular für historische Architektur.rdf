        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-01T09:28:11.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-29T13:07:54.000</terms:modified>
        <skos:definition xml:lang="de">Das einzelne Sparrenpaar, aber auch das Sparrenwerk als Gesamtheit aller Sparren eines Dachs. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Gespärre, Sparrenwerk, Gesamtheit der Sparren einer Dachkonstruktion. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="cs">(střešní) trámoví</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Dachgespärre</skos:prefLabel>
    </owl:NamedIndividual>
    


