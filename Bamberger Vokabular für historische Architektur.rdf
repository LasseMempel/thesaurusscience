        <skos:definition xml:lang="de">An mehrere konstruktive Hölzer angeblattete Bohle, zumeist schräg verlaufend,auch als angeblattetes Vollholz vorkommend (Schwertriegel). [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Schwertung</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_e2d61e5c"/>
    </owl:NamedIndividual>
    


