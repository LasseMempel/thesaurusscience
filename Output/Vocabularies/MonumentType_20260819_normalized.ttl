    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70064> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "PASSAGE GRAVE"@en ;
    skos:scopeNote "A form of Neolithic burial monument comprising a large circular stone or earthen mound, with a low and narrow entrance passage leading to a wider and higher stone built chamber."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70069> a skos:Concept ;
    skos:altLabel "Portal Tomb"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70064> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "PORTAL DOLMEN"@en ;
    skos:scopeNote "A megalithic tomb of Neolithic date comprising a chamber bounded by large upright orthostats, often only three or four in number, which support a large capstone."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70070> a skos:Concept ;
    skos:altLabel "Bone House"@en,
        "Carnary"@en ;
