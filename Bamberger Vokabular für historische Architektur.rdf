        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-17T16:07:36.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T14:49:57.000</terms:modified>
        <skos:definition xml:lang="de">Bezeichnung für den Drehgriff der Basküle. Die Griffe haben oftmals die Form einer Olive, daher der Name. [Noky 1996]</skos:definition>
        <skos:definition xml:lang="de">Der zur Betätigung von Fensterverschlüssen häufig gebrauchte, o.nförmige Drehknauf, d.h. ein Handgriff, mit dem die zum Öffnen und Schließen erforderl. Drehung des Gestänges oder des Fallriegels ausgeführt wird. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="fr"> (bouton en) olive</skos:prefLabel>
        <skos:prefLabel xml:lang="es"> oliva</skos:prefLabel>
        <skos:prefLabel xml:lang="it"> oliva</skos:prefLabel>
        <skos:prefLabel xml:lang="en"> olive</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Olive</skos:prefLabel>
    </owl:NamedIndividual>
    


