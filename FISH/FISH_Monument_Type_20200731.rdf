  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70108">
    <skos:scopeNote xml:lang="en">A complex of buildings, often within an enclosure, housing a pre-Benedictine Reform secular religious community. Now commonly used to describe the main church within such a complex, which over time attained higher status.</skos:scopeNote>
