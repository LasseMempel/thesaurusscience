    skos:closeMatch <http://data.uba.de/umt/_00050792> ;
    skos:definition "Underground prospection conducted with various methods to discover natural gas deposits which are usually found in the immediate vicinity of crude petroleum."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Erdgasexploration"@de,
        "natural gas exploration"@en .

<http://www.eionet.europa.eu/gemet/concept/5506> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3852> ;
    skos:closeMatch <http://dbpedia.org/resource/Natural_hazard> ;
    skos:definition "The probability of occurrence, within a specific period of time in a given area of a potentially damaging phenomenon of nature."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Naturgefahr"@de,
        "natural hazard"@en .

<http://www.eionet.europa.eu/gemet/concept/5508> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2818> ;
    skos:definition "A rule or body of rules that derives from nature and is believed to be binding upon human society, as opposed to human-made laws such as legislative acts and judicial decisions."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Naturgesetz"@de,
        "rights of nature"@en .

<http://www.eionet.europa.eu/gemet/concept/551> a skos:Concept ;
    skos:broadMatch <http://eurovoc.europa.eu/4785> ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8388> ;
    skos:closeMatch <http://data.uba.de/umt/_00049703> ;
    skos:definition "The interacting system of a biological community and its non-living environmental surroundings in a climatic region where the annual precipitation averages less than 10 inches per year."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Ökosystem eines Trockengebietes"@de,
        "arid land ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/5511> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6740> ;
    skos:closeMatch <http://data.uba.de/umt/_00017884>,
        <http://dbpedia.org/resource/Natural_monument> ;
    skos:definition "A natural/cultural feature which is of outstanding or unique value because of its inherent rarity, representative of aesthetic qualities or cultural significance. Guidance for selection of a natural monument is: a) The area should contain one or more features of outstanding significance (appropriate natural features include spectacular waterfalls, caves, craters, fossil beds, sand dunes and marine features, along with unique or representative fauna and flora; associated cultural features might include cave dwellings, cliff-top forts, archaeological sites, or natural sites which have heritage significance to indigenous peoples).; b) The area should be large enough to protect the integrity of the feature and its immediately related surroundings."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Naturdenkmal"@de,
        "natural monument"@en .

<http://www.eionet.europa.eu/gemet/concept/5518> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6925> ;
    skos:closeMatch <http://data.uba.de/umt/_00017878> ;
    skos:definition "Radiation stemming mainly from uranium, present in small amounts in many rocks, soils, building material, etc."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Natürliche Radioaktivität"@de,
        "natural radioactivity"@en ;
    skos:relatedMatch <http://dbpedia.org/resource/Background_radiation> .

<http://www.eionet.europa.eu/gemet/concept/5520> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7170> ;
    skos:definition "The management of living and non-living resources in such a way as to sustain the maximum benefit for present and future generations."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Rohstoffschutz"@de,
        "natural resource conservation"@en .

<http://www.eionet.europa.eu/gemet/concept/5523> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4648> ;
    skos:closeMatch <http://data.uba.de/umt/_00015730> ;
    skos:definition "An area where human effects, if present, are not significant to the landscape as a whole."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Landschaftsbild"@de,
        "natural scenery"@en .

<http://www.eionet.europa.eu/gemet/concept/5530> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2775> ;
    skos:closeMatch <http://data.uba.de/umt/_00047803> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Eigenwert der Natur"@de,
        "natural value"@en .

<http://www.eionet.europa.eu/gemet/concept/5536> a skos:Concept ;
    skos:broadMatch <http://eurovoc.europa.eu/2825> ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5671> ;
    skos:closeMatch <http://data.uba.de/umt/_00030574> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Naturschutzorganisation"@de,
        "nature conservation organisation"@en .

<http://www.eionet.europa.eu/gemet/concept/5538> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2862> ;
    skos:closeMatch <http://data.uba.de/umt/_00017904> ;
    skos:definition "A binding rule or body of rules prescribed by a government to protect, preserve or renew an area's natural habitats or ecosystem."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Naturschutzrecht"@de,
        "nature conservation legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/5539> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2897> ;
    skos:closeMatch <http://data.uba.de/umt/_00017903> ;
    skos:definition "An organized group of activities and procedures, often run by a government agency or a nonprofit organization, to preserve and protect elements of the natural world such as mountains, trees, animals or rivers."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Naturschutzprogramm"@de,
        "nature conservation programme"@en .

<http://www.eionet.europa.eu/gemet/concept/5554> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4046> ;
    skos:closeMatch <http://data.uba.de/umt/_00017949>,
        <http://dbpedia.org/resource/Necrosis> ;
