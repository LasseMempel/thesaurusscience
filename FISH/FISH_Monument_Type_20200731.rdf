  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93072">
    <skos:scopeNote xml:lang="en">A complex of buildings used for the manufacture of radio valves or similar electronic components.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87945">
    <skos:scopeNote xml:lang="en">Series of wire mesh screens used for grading lumps of coal according to size.</skos:scopeNote>
  </rdf:Description>
