    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "ROCOCO GARDEN"@en ;
    skos:scopeNote "Garden comprising rockwork features including grottoes, cascades and arches, often in different architectural styles ie. Gothic, Chinese and rustic. In use from the mid C18."@en .

<http://purl.org/heritagedata/schemes/eh_tmt2/concepts/100192> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91991>,
        <http://purl.org/heritagedata/schemes/eh_tmt2/concepts/94350> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/eh_tmt2> ;
    skos:prefLabel "BUFFER DEPOT"@en ;
    skos:scopeNote "A strategic food store, directly operated by, or on behalf of, the government. The stores were used to store a variety of foodstuffs. They were in operation from the end of the Second World War until the early 1990's."@en .

