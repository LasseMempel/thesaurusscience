        <skos:altLabel xml:lang="fr">disque de coffrage coulissante </skos:altLabel>
        <skos:definition xml:lang="de">Ein zur Wölbung in Ringschichten benötigtes, auf einem Gerüst verschiebbares Gestell, das die Breite mehrerer Mauerringe, manchmal auch nur eines Mauerringes, hat. Es bietet eine Teilschalung oder Gleitschalung. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Rutschbogen </skos:prefLabel>
        <skos:prefLabel xml:lang="fr">disque de coffrage glissante</skos:prefLabel>
        <skos:prefLabel xml:lang="en">rolling scaffolding </skos:prefLabel>
    </owl:NamedIndividual>
    


