    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
    skos:prefLabel "Imprint styles of incriptions"@en ;
    skos:scopeNote "The techniques used to imprint inscriptions on the material bearing the inscription."@en .

<https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/2187> a skos:Concept ;
    skos:broader <https://humanitiesthesaurus.academyofathens.gr/dyas-resource/Concept/22> ;
    skos:inScheme <https://humanitiesthesaurus.academyofathens.gr> ;
