        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T23:45:18.000</terms:modified>
        <skos:definition xml:lang="de">Glockenspiel n: ein Klangkörper aus mehreren, mindestens aber vier chromatisch aufeinander abgestimmten Glocken, die durch Hämmer mit der Hand angeschlagen oder automatisch mit Stiftwalzen betätigt werden; in Europa seit dem 9. Jh. bekannt. Beispiel: das Glockenspiel von Dünkirchen mit 44 Glocken. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Glockenspiel</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">carillon</skos:prefLabel>
        <skos:prefLabel xml:lang="en">chime of bells</skos:prefLabel>
    </owl:NamedIndividual>
    


