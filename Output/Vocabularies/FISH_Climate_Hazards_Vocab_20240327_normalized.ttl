    skos:altLabel "Fire season"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/38076/concepts/2080> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/38076> ;
    skos:prefLabel "Fire weather"@en ;
    skos:scopeNote "Diurnal and seasonal periods when fires are likely to start and spread."@en .

<http://purl.org/heritagedata/schemes/38076/concepts/30100> a skos:Concept ;
