				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1913" />
				<skos:scopeNote xml:lang="en">An interior or projecting shelter surrounding an entrance to a building.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
