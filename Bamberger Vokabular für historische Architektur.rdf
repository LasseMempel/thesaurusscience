    <!-- https://hist-arch-vocab.org/bvha#c_8ebe21de -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_8ebe21de">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_080560d3"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_176fcff1"/>
