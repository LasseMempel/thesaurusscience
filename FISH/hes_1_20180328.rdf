		<skos:prefLabel xml:lang="gd">DOCA-TIORAM</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Doca-tioram far a bheilear a' dèanamh obair-chàraidh is obair-ghlèidhidh air sligean longan.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GRAVING DOCK</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
