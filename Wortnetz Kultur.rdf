	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk018813">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Pfostenstein</skos:prefLabel>
		<skos:altLabel xml:lang="de">Pfostensteine</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk018632"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk018632"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk011552"/>
		<skos:definition xml:lang="de">Ein Pfostenstein ist ein Architekturelement aus einem behauenen, quaderförmigen Stein, der als Fundament oder Unterlage für hölzerne Pfosten in Gebäuden diente. Pfostensteine wurden in Pfostengruben platziert, um den Pfosten zusätzliche Stabilität zu verleihen und sie vor Bodenfeuchtigkeit zu schützen. Zu diesem Zweck konnten sie Eintiefungen zur Aufnahme der Pfosten besitzen und waren meist nicht vollständig in den Boden eingelassen.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk018632"/>
