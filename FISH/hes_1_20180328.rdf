		<skos:prefLabel xml:lang="gd">OIFIS THIOGAIDEAN</skos:prefLabel>
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/504129">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/504129</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">MUILEANN-LUADHAIDH</skos:prefLabel>
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/504140">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/504140</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CLADHAN  UILLT</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Cladhan a chaidh a thogail os cionn duct-uisge airson allt a tha a' dol seachad air airson 's nach bleith e structar an duct-uisge agus air eagal 's gun sileadh uisge nach eilear ag iarraidh dhan duct-uisge. Cladhan de dh'iarann mòlltaichte an cruth U no feadhainn a chaidh a lìnigeach le clachan no concrait.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BURN COVER</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-04-16T14:39:24</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-07-24T12:46:19</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/2010" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1870" />
		<skos:scopeNote xml:lang="en">Constructed channel for carrying burns over the top of a subterranean aqueduct preventing erosion of aqueduct structure and intrusion of unwanted water into the water supply. Either cast-iron 'U'-shaped channels or stone or concrete linings.</skos:scopeNote>
