        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_fc304d3c"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-12T10:42:41.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T12:57:50.000</terms:modified>
        <skos:altLabel xml:lang="cs">dům s nižšími příčnými střechami a štíty na podélné (okapové) straně sedlové střechy</skos:altLabel>
        <skos:altLabel xml:lang="cs">vikýř</skos:altLabel>
        <skos:definition xml:lang="cs">Podkrovní obytný prostor ve výši podlaží zastřešený boční stříškou. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Zwerchhaus (zwerch = quer), geschosshohes Dachhäuschen in der Hausflucht und unter einem Zwerchdach. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="de">Zwerchhaus</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">vikýř s obytným prostorem</skos:prefLabel>
    </owl:NamedIndividual>
    


