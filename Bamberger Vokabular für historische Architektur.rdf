        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_9cb3d277"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-04T10:34:30.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T10:50:00.000</terms:modified>
        <skos:definition xml:lang="de">Columbarium (lat. columba = Taube), Begräbnisstätte mit taubenschlagähnlichen Wandnischen, in denen Leichen, Knochenreste, Aschenurnen beigesetzt werden. Seit frühchristlicher Zeit bis heute, bes. im südlichen Europa. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Lat. columba = holub. 1. Holubník (Les Beaux v Provence). 2. Hrobka s nikami ve zdi podobnými holubníku, v nichž jsou pohřbeny mrtvoly, kosterní pozůstatky a urny s popelem, od raně křesťanských dob až dodnes, zvl. v jižní Evropě, katakomby. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Columbarium</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kolumbárium</skos:prefLabel>
    </owl:NamedIndividual>
    


