        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T17:18:41.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T01:40:55.000</terms:modified>
        <skos:definition xml:lang="de">Urspr. der Raum einer Gottheit, Aufenthalts- und Schlafraum eines Mönchs oder einer Nonne in christl. Klöstern, erst im Spätmittelalter wurden die Schlafsäle (Dormitorium) in Z.n unterteilt. Später auch als Bezeichnung für Gefängnisraum, Umkleideraum. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Zelle</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">cela</skos:prefLabel>
        <skos:prefLabel xml:lang="es">celda</skos:prefLabel>
        <skos:prefLabel xml:lang="en">cell</skos:prefLabel>
        <skos:prefLabel xml:lang="it">cella</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">cellule</skos:prefLabel>
    </owl:NamedIndividual>
    


