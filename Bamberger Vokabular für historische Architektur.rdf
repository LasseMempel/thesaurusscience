    <!-- https://hist-arch-vocab.org/bvha#c_5d272114 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_5d272114">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_298d4e12"/>
