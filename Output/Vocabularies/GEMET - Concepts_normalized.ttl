    skos:definition "Any conduct or action undertaken on behalf of a person, group, business or government, often as an elected or appointed voice."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:narrowMatch <http://eurovoc.europa.eu/3379> ;
