        <skos:altLabel xml:lang="de">Treppenabsatz</skos:altLabel>
        <skos:altLabel xml:lang="es">rellano</skos:altLabel>
        <skos:altLabel xml:lang="fr">repos</skos:altLabel>
        <skos:definition xml:lang="de">Ein zwischen zwei Läufen einer Treppe eingefügtes Podest. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Treppenabsatz am Beginn oder Ende eines Treppenlaufes bzw. zwischen den Treppenläufen, meist an der Stelle des Richtungswechsels. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Podest (Treppe)</skos:prefLabel>
        <skos:prefLabel xml:lang="es">descanso</skos:prefLabel>
        <skos:prefLabel xml:lang="en">landing (of staircase)</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">odpočívadlo</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">palier (d\&apos;escalier)</skos:prefLabel>
