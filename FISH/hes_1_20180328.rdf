		<skos:prefLabel xml:lang="gd">DOCA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Lann far a bheilear a' togail 's a' càradh longan agus far a bheilear a' cruinneachadh diofar stòrasan nan long.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">DOCKYARD</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1018" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1022">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1022</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">DOCA NÈIBHIDH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Bunait a' chabhlaich far a bheilear a' togail, a' càradh, a' docachadh, ag iompachadh is ag ath-sholar longan-cogaidh. Bidh luchd-obrach agus einnseanairean-togalach ag obair ann fo rianachd oifigearan-dleastanais einnseanaireachd.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">NAVAL DOCKYARD</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1021" />
				<skos:scopeNote xml:lang="en">A naval base that builds, repairs, docks, converts or resupplies warships, and is manned by civilian engineers and workers and administered by engineer duty officers.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
