<http://www.eionet.europa.eu/gemet/concept/4612> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14933>,
        <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:closeMatch <http://dbpedia.org/resource/Land_cover> ;
    skos:definition "Land cover is the physical state of the land surface. It is the combination of vegetation, soil, rock, water and human-made structures, which make up the earth's landscape. The land cover is the interface between the earth's crust and the atmosphere, influencing the exchange of energy and matter in the climatic system and biogeochemical cycles."@en ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_37897> ;
