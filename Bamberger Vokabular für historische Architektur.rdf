    <!-- https://hist-arch-vocab.org/bvha#c_3751f0ec -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_3751f0ec">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_fbedadd4"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_b41bd73a"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-17T17:11:45.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-17T17:12:25.000</terms:modified>
        <skos:definition xml:lang="de">Senkrechtes Holz in der Innenkonstruktion des Fensterrahmens. Beim Fenster mit zwei Querhölzern bilden einzelne Höhenhölzer einen geteilten Pfosten. Das halbe Höhenholz gibt es nur beim Schiebefenster. Da, wo der Schiebeflügel am geteilten Pfosten vorbeiläuft, muss das Höhenholz halbiert sein, weil die Laufnuten etwa auf der Mitte der Querhölzer bzw. Ober- und/oder Unterschenkel angeordnet sind. [Noky 1996]</skos:definition>
        <skos:prefLabel xml:lang="de">Höhenholz</skos:prefLabel>
    </owl:NamedIndividual>
    


