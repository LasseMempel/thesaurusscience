	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/412">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/412</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">DÙN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach no tuineachadh le gàrradh tiugh, mar is trice cruinn no ugh-chruthach agus air talamh àrd.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">DUN</skos:prefLabel>
