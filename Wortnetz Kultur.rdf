		<skos:altLabel xml:lang="de">Oblaten (Gebäck)</skos:altLabel>
		<skos:prefLabel xml:lang="en">wafer (food)</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk009556"/>
