		<skos:prefLabel xml:lang="gd">FÀRADH-ÈISG</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Staidhir a chaidh a dhealbhadh dhan iasg airson 's gum faigh iad seachad air uisge a' tuiteam no dama.</skos:scopeNote>
