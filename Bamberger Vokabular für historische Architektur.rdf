        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-24T18:51:08.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-18T13:58:50.000</terms:modified>
        <skos:note xml:lang="de">Eine Maltechnik, in der Emulsionen auf Wasserbasis oder von Iösungsmitteihaitigen Farben aus Acrylpolymeren verwendet werden, die schnell trocknen und nach der Trocknung wasserunlöslich sind. [EwaGlos]</skos:note>
        <skos:note xml:lang="en">The use ofwater-based emulsions or solvent based paints, derived from acrylic polymers, which dry rapidly and are water insoluble after drying. [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="de">Acrylmalerei</skos:prefLabel>
        <skos:prefLabel xml:lang="en">acrylic painting</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">akryl</skos:prefLabel>
    </owl:NamedIndividual>
    


