        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T11:03:45.000</terms:modified>
        <skos:altLabel xml:lang="de">Rückenschild</skos:altLabel>
        <skos:altLabel xml:lang="de">Schild</skos:altLabel>
        <skos:altLabel xml:lang="fr">capuce de chape</skos:altLabel>
        <skos:altLabel xml:lang="cs">štít</skos:altLabel>
        <skos:definition xml:lang="de">Schild m, auch Pluvialschild m, Rückenschild m, clipeus: ornamentaler, meist schildförmiger Stoffbehang, zu dem sich die Kapuze am Pluviale zurückbildete. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Pluvialschild</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">chaperon de chape</skos:prefLabel>
        <skos:prefLabel xml:lang="la">clipeus</skos:prefLabel>
        <skos:prefLabel xml:lang="en">hood</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_43e35ceb -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_43e35ceb">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
