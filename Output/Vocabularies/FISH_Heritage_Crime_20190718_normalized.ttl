    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Off Road Car Use"@en ;
    skos:scopeNote "The illicit driving of a car over natural terrain or archaeologically sensitive areas where such activity is not permitted."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152675> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152658> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Off Road Motorcycle Use"@en ;
    skos:scopeNote "The illicit riding of a motorcycle over natural terrain or archaeologically sensitive areas where such activity is not permitted."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152676> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152658> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Off Road Bicycle Use"@en ;
    skos:scopeNote "The illicit riding of a bicycle over natural terrain or archaeologically sensitive areas where such activity is not permitted."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152680> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152679>,
        <http://purl.org/heritagedata/schemes/596/concepts/163253> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Fly Tipping"@en ;
    skos:scopeNote "The illegal deposit of any waste onto land that is not  licensed to accept waste."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152683> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152656>,
        <http://purl.org/heritagedata/schemes/596/concepts/163253> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Illegal Parking"@en ;
    skos:scopeNote "The act of leaving a vehicle in a place where parking prohibited or at a time when parking is restricted."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152684> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152656>,
        <http://purl.org/heritagedata/schemes/596/concepts/163253> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Abandoned Vehicle"@en ;
    skos:scopeNote "The act of disposing of a vehicle in a place where it is illegal to leave it."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152688> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152686> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Unlicensed Excavation"@en ;
    skos:scopeNote "The act of causing damage to and/or the destruction of archaeological deposits at a heritage assest by means of unauthorized excavation work."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152689> a skos:Concept ;
    skos:altLabel "Panhandling"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152660>,
        <http://purl.org/heritagedata/schemes/596/concepts/163252> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Begging"@en ;
    skos:scopeNote "The act of attempting to secure material benefits from others in a public place."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152693> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152660>,
        <http://purl.org/heritagedata/schemes/596/concepts/163253> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Uncontrolled Animals"@en ;
    skos:scopeNote "Domestic animals that have either been left to roam uncontrolled by their owners or are allowed to cause distress to other members of the public whilst with their owner."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152696> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152695> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Airgun Misuse"@en ;
    skos:scopeNote "The improper use of a airgun in a public place and/or the use of a firearm to threaten or inflict violence or harm."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152697> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152660>,
        <http://purl.org/heritagedata/schemes/596/concepts/163252> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Firework Misuse"@en ;
    skos:scopeNote "The irresponsible use of a firework and/or the use of fireworks as weapons ro harass and injure other individuals."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152698> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152677> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Street Drinking"@en ;
    skos:scopeNote "The consumption of alcohol in public places."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152700> a skos:Concept ;
    skos:altLabel "Unlicensed Party"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152660>,
        <http://purl.org/heritagedata/schemes/596/concepts/163253> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Unlicensed Rave"@en ;
    skos:scopeNote "A party \"free\" from the restrictions of the legal club scene where the people present create and enforce the rules. As a result drugs may be readily available and noise levels may be illegally high."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152701> a skos:Concept ;
    skos:altLabel "Plant Removal"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152651>,
        <http://purl.org/heritagedata/schemes/596/concepts/152685>,
        <http://purl.org/heritagedata/schemes/596/concepts/163253> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Flora Removal"@en ;
    skos:scopeNote "The deliberate and illegal removal of plants and flowers from a site; this can include unauthorized turf removal and the removal of plant life from wall caps."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152702> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152704> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Bat Disturbance"@en ;
    skos:scopeNote "To intentionally or recklessly disturb a bat in its roost or deliberately disturb a group of bats without a licence."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152705> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152685>,
        <http://purl.org/heritagedata/schemes/596/concepts/159394>,
        <http://purl.org/heritagedata/schemes/596/concepts/163253> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Wildlife Shooting"@en ;
    skos:scopeNote "The illegal or unlicensed shooting of animals with firearms or bow weapons."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152706> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152685>,
        <http://purl.org/heritagedata/schemes/596/concepts/163253> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Wildlife Trapping"@en ;
    skos:scopeNote "The illegal or unlicensed use of a device, such as a snare, foothold, cage trap or funnel trap etc, to remotely catch an animal."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152707> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152685>,
        <http://purl.org/heritagedata/schemes/596/concepts/163253> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Wildlife Poisoning"@en ;
    skos:scopeNote "The illegal or unlicensed poisoning of animals or birds."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152709> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152685>,
        <http://purl.org/heritagedata/schemes/596/concepts/163253> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Bird Egg Removal"@en ;
    skos:scopeNote "The act of illegally removing the eggs of protected species of birds from their nests."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152715> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152660>,
        <http://purl.org/heritagedata/schemes/596/concepts/163252> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Unauthorized Game Playing"@en ;
    skos:scopeNote "The playing of games in a location where they are not permitted."@en .

<http://purl.org/heritagedata/schemes/596/concepts/152716> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152660>,
        <http://purl.org/heritagedata/schemes/596/concepts/163252> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Rowdiness"@en ;
    skos:scopeNote "Disorderly and noisy behaviour."@en .

<http://purl.org/heritagedata/schemes/596/concepts/159122> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/159374> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Illegal Artefact Dealing"@en ;
    skos:scopeNote "The act of trading in cultural property which has been stolen, illegally excavated or illegally imported."@en .

<http://purl.org/heritagedata/schemes/596/concepts/159351> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152660>,
        <http://purl.org/heritagedata/schemes/596/concepts/163252> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Ritual Activity"@en ;
    skos:scopeNote "The practice of alternative religous activities."@en .

<http://purl.org/heritagedata/schemes/596/concepts/159355> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152691> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Urban Exploration"@en ;
    skos:scopeNote "The exploration of the normally unseen or off-limits parts of heritage sites without the permission of the owner."@en .

<http://purl.org/heritagedata/schemes/596/concepts/159358> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152710> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Verbal Intimidation"@en ;
    skos:scopeNote "The action of causing a person to fear injury or harm by using verbal abuse."@en .

<http://purl.org/heritagedata/schemes/596/concepts/159359> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152710> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Physical Intimidation"@en ;
    skos:scopeNote "The action of causing a person to fear injury or harm by threatening them with physical violence."@en .

<http://purl.org/heritagedata/schemes/596/concepts/159360> a skos:Concept ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Assault (Custodian)"@en ;
    skos:scopeNote "A crime of violence against the custodian of a heritage site. Double index with the type and severity of the assault if known)."@en .

<http://purl.org/heritagedata/schemes/596/concepts/159361> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152662> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Minor Assault"@en ;
    skos:scopeNote "The unlawful threat of violence or touching of another persion with intent to inflict bodily harm."@en .

<http://purl.org/heritagedata/schemes/596/concepts/159362> a skos:Concept ;
    skos:altLabel "Grievous Bodily Harm"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152662> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Serious Assault"@en ;
    skos:scopeNote "The unlawful infliction of bodily harm upon another person."@en .

<http://purl.org/heritagedata/schemes/596/concepts/159363> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152662> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Fatal Assault"@en ;
    skos:scopeNote "A crime of violence against another person that results in the death of the person being assaulted."@en .

<http://purl.org/heritagedata/schemes/596/concepts/159364> a skos:Concept ;
    skos:altLabel "Rape"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152662>,
        <http://purl.org/heritagedata/schemes/596/concepts/152663> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Sexual Assault"@en ;
    skos:scopeNote "The intentional touching of another in a sexual manner where the perpetrator does not believe that the other party consents to their actions. Created by section 3 of the Sexual Offences Act 2003."@en .

<http://purl.org/heritagedata/schemes/596/concepts/159368> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152667> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Kerb Crawling"@en ;
    skos:scopeNote "The practice of driving slowly by the side of a road with the intention of either harassing or soliciting prostitutes for sex."@en .

<http://purl.org/heritagedata/schemes/596/concepts/159369> a skos:Concept ;
    skos:altLabel "Peeping Tom"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152663> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Voyeurism"@en ;
    skos:scopeNote "The act of obtaining sexual stimulation from the covert observation of the sexual organs or actions of others."@en .

<http://purl.org/heritagedata/schemes/596/concepts/159371> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152663> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Bestiality"@en .

<http://purl.org/heritagedata/schemes/596/concepts/159373> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152685>,
        <http://purl.org/heritagedata/schemes/596/concepts/159372>,
        <http://purl.org/heritagedata/schemes/596/concepts/159394> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Badger Baiting"@en ;
    skos:scopeNote "An illegal blood sport in which badgers are forced to fight a sucession of dogs."@en .

<http://purl.org/heritagedata/schemes/596/concepts/159376> a skos:Concept ;
    skos:altLabel "Artefact Theft"@en,
        "Metal Detecting (Removal Of Artefacts)"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152687> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Removal Of Artefacts"@en ;
    skos:scopeNote "The use of a metal detector at a heritage asset which has resulted in the location and removal of artefacts without consent."@en .

<http://purl.org/heritagedata/schemes/596/concepts/159377> a skos:Concept ;
    skos:altLabel "Metal Detecting (Non Removal Of Artefacts)"@en ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152687> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Non Removal Of Artefacts"@en ;
    skos:scopeNote "The use of a metal detector at a heritage asset which had yet to result in the location and removal of artefacts without consent."@en .

<http://purl.org/heritagedata/schemes/596/concepts/159378> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152651>,
        <http://purl.org/heritagedata/schemes/596/concepts/152687> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Nighthawking"@en ;
    skos:scopeNote "The illicit use of metal detectors on archaeological sites, or sites of archaeological significance. An activity usually undertaken at night with the intention of stealing artifacts from the ground which are then often sold for personal profit."@en .

<http://purl.org/heritagedata/schemes/596/concepts/159396> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152681> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Drug Paraphanalia"@en ;
    skos:scopeNote "The littering of sites with items used for and relating to the taking of illegal drugs such as syringes, cigarette rolling papers, crack pipes etc."@en .

<http://purl.org/heritagedata/schemes/596/concepts/159398> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152686> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Breach Of Condition"@en ;
    skos:scopeNote "The act of breaching the conditions set when scheduled monument consent/listed building consent was granted."@en .

<http://purl.org/heritagedata/schemes/596/concepts/159399> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/596/concepts/152686> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/596> ;
    skos:prefLabel "Contravention Of Stop Notice"@en ;
    skos:scopeNote "The act of continuing on site works to either a scheduled monument or a listed building after notice has been given to cease all on site works."@en .

