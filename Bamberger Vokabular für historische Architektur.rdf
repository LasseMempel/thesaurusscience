        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_db732d1e"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-18T17:49:09.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T16:08:47.000</terms:modified>
        <skos:definition xml:lang="de">Pannisellus m, lat.; sudarium: kleines, fahnenähnliches Tüchlein am Knauf des -&gt; Abtsstabes, wohl vom 13. Jh. an gebräuchlich. Der Pannisellus war bis zum 16. Jh. unterscheidendes Merkmal zum Bischofsstab, obgleich er auch manchmal an diesem angebracht war. Er diente dazu, das Metall gegen das Anlaufen zu schützen, wenn man es berührte. Nach Einführung der Pontifikalhandschuhe wurde er überflüssig. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Pannisellus</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">sudarium</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">sudarium</skos:prefLabel>
        <skos:prefLabel xml:lang="la">sudarium</skos:prefLabel>
        <skos:prefLabel xml:lang="en">vexillum</skos:prefLabel>
    </owl:NamedIndividual>
    


