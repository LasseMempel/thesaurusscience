        <skos:definition xml:lang="de">Band zwischen Ständer und Schwelle im Fachwerkbau, das am Fußpunkt einen Dreiecksverband herstellt. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Fußband: den unteren Winkel zwischen zwei Gerüsthölzern aussteifendes, maximal geschosshohes Holz. [Eißing et al. 2012]</skos:definition>
        <skos:prefLabel xml:lang="de">Fußband</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">zápora</skos:prefLabel>
    </owl:NamedIndividual>
    


