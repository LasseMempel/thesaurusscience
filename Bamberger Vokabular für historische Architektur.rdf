        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-28T08:57:12.000</terms:modified>
        <skos:altLabel xml:lang="de">Glockenschläger</skos:altLabel>
        <skos:altLabel xml:lang="de">Glockenschwengel</skos:altLabel>
        <skos:definition xml:lang="de">Klöppel m; auch Glockenschlägel m; Glockenschwengel m: ein freischwingender, unten verdickter Metallstab (Klöppelschaft m mit Klöppelballen m) im Inneren der Glocke, der beim Auftreffen auf die Wandung (Schlagring) den Glockenton erzeugt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Klöppel</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">battant</skos:prefLabel>
        <skos:prefLabel xml:lang="en">bell-clapper</skos:prefLabel>
    </owl:NamedIndividual>
    


