        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_5bfe131e"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_75163f7e"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-23T12:32:14.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T19:52:07.000</terms:modified>
        <skos:altLabel xml:lang="de">Bundbalken</skos:altLabel>
        <skos:altLabel xml:lang="de">Bundtram</skos:altLabel>
        <skos:altLabel xml:lang="de">Holzrähm</skos:altLabel>
        <skos:altLabel xml:lang="de">Oberschwelle</skos:altLabel>
        <skos:altLabel xml:lang="de">Rahmenholz</skos:altLabel>
        <skos:altLabel xml:lang="cs">ližina</skos:altLabel>
        <skos:altLabel xml:lang="en">rail</skos:altLabel>
        <skos:definition xml:lang="de">Bundbalken, Binderbalken, Bundtram; durchgehender Deckenbalken einer Dachbalkenlage, der mit den Sparren einen festen Verband bildet. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Horizontales, auf Ständer oder Stuhlsäulen (Stuhlr., regional auch Pfette) aufgezapftes, längsverbindendes und die Wand oben abschließendes Holz; Oberr.-, Hochr.- und Unterrähmkonstruktion sind Zimmerungsarbeiten, bei denen sich das R. oberhalb, mit Abstand oberhalb bzw. unterhalb der Balkenlage befindet. [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Horizontales, den Quer- oder Längsbund oben begrenzendes Holz, auf dem die Decken-, Dach-, Kehl- oder Stichbalken aufliegen. [Eißing et al. 2012]</skos:definition>
        <skos:prefLabel xml:lang="de">Rähm</skos:prefLabel>
        <skos:prefLabel xml:lang="es">carrera</skos:prefLabel>
        <skos:prefLabel xml:lang="en">head</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">sablière supérieure</skos:prefLabel>
        <skos:prefLabel xml:lang="it">trave di edificio a ossatura lignea</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">vaznice</skos:prefLabel>
    </owl:NamedIndividual>
    


