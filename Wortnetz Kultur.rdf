		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk000350"/>
		<xe:explanation_temp xml:lang="de">Jadeit tritt als massiges Mineral in Metamorphiten auf.</xe:explanation_temp>
		<skos:definition xml:lang="de">Jadeit ist ein Pyroxen, das eine weißlich-grüne bis dunkelgrüne, aber immer undurchsichtige, Farbe aufweist.</skos:definition>
