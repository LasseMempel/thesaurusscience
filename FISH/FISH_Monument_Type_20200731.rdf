  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/167087">
    <skos:scopeNote xml:lang="en">A building or site used for the storage and distribution of food.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93090">
    <skos:scopeNote xml:lang="en">Buildings, sites and structures associated with railway transport.</skos:scopeNote>
  </rdf:Description>
