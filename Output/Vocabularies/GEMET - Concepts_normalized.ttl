    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Grundüberwachung"@de,
        "baseline monitoring"@en .

<http://www.eionet.europa.eu/gemet/concept/7269> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3485> ;
    skos:closeMatch <http://data.uba.de/umt/_00028847> ;
    skos:definition "Water which flows in a channel from high ground to low ground and ultimately to a lake or the sea, except in a desert area where it may dwindle away to nothing."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Flußwasser"@de,
