        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-23T13:44:56.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T22:47:39.000</terms:modified>
        <skos:definition xml:lang="de">Reguläre Hofanlage, bei der auf drei Seiten Gebäude (Wohnstallhaus, Stall oder Schuppen, Scheune oder in Norddtl. Wohnhaus, Stall, Scheune) stehen; die vierte Seite schließt ein Zaun mit Tor (geschlossener D.) oder sie bleibt offen (offener D.). [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Dreiseithof</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">třístranný dvůr</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_dca4fc02 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_dca4fc02">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
