		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/944" />
		<skos:scopeNote xml:lang="en">A mill used for the processing of tin ore by razing, stamping or smelting.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
