		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1847</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">PUMPA PEATROIL</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Pumpa a chleachdar gus peatral a ghluasad eadar tanca-stòrais agus càraichean, làraidhean is carbadan-rathaid eile.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PETROL PUMP</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
