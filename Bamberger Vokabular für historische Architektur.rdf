    <!-- https://hist-arch-vocab.org/bvha#c_848b92b9 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_848b92b9">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_0f3cab11"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_11426742"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T23:20:08.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:16:07.000</terms:modified>
        <skos:altLabel xml:lang="cs">rovová klenba</skos:altLabel>
        <skos:altLabel xml:lang="fr">voûte en auge</skos:altLabel>
        <skos:definition xml:lang="de">Muldengewölbe sind als Tonnengewölbe mit gewölbten Enden oder als Klostergewölbe mit zwischengefügtem Tonnenstück erklärbar. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Muldengewölbe, über rechteckigem Grundriss gespannte Spitztonne, die von zwei Schmalseiten her von je einer rund- oder spitzbogigen Wange angeschnitten wird, eine Art Klostergewölbe. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="cs">Necková klenba vzniká jako valená klenba se zaklenutými konci, nebo jako klášterní klenba s vloženou valenou částí. [Koch 2008]</skos:definition>
        <skos:definition xml:lang="de">Über rechteckiger Grundfläche gespannte Rund- oder Spitztonne, die an den beiden Schmalseiten von je einer rundbogen- oder spitzbogenförmigen Gewölbewange geschlossen wird. Dabei bilden sich Kehlen aus. Alle Umfassungsmauern sind Widerlagermauern. &gt; Gewölbe, geschlossenes &gt; Klostergewölbe [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Muldengewölbe</skos:prefLabel>
        <skos:prefLabel xml:lang="en">barrel vault closed by coves</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">necková klenba</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">voûte en cuvette</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_11426742"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_849603be -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_849603be">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1b21ae94"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_07d6fc36"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_473bbc7d"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T19:15:00.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T19:22:59.000</terms:modified>
        <skos:definition xml:lang="de">Bei allen Betrachtungen der Bodenbearbeitung müssen zwei Gesichtspunktebeachtet werden:• Da es abgesehen von - aus heutiger Sicht einfachen - Schöpfwerken keine effizientenMethoden der Wasserhaltung gab, konnte man kaum direkt im Grundwasser-oder Wasserbereich bauen, es sein denn, durch Einsatz von Pfählenoder Schüttungen.• Da die wahren Bodenverhältnisse unter dem Gründungsniveau selten bekanntwaren und da nur begrenzte Methoden der Baugrunduntersuchung zur Verfügungstanden, richteten sich die Bauleute nach dem Boden, den sie sahen oderden sie aus den Setzungen beim Bau selbst oder bei Nachbarbauten schlussfolgerten. [Nodoushani]</skos:definition>
        <skos:prefLabel xml:lang="de">Gründung</skos:prefLabel>
    </owl:NamedIndividual>
    


