		<skos:prefLabel xml:lang="gd">GÀRRADH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Gàrradh-cloiche no balla sgratha a tha na bhacadh dìreach.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">DYKE</skos:prefLabel>
