		<skos:prefLabel xml:lang="gd">SLOC CRAOIBHE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Sloc eu-domhain no lagan san talamh a nochd nuair a thuit craobh mu làr.</skos:scopeNote>
