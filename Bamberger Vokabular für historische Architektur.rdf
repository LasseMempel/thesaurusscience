        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T16:08:34.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-18T14:05:07.000</terms:modified>
        <skos:definition xml:lang="de">Einen Werkstein oder Quader an seiner Vorderseite mit dem Zweispitz, Spitzeisen o.Ä. grob zuhauen, so dass eine erhabene Bosse stehenbleibt, die dann weiter ausgearbeitet wird. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Bossieren</skos:prefLabel>
    </owl:NamedIndividual>
    


