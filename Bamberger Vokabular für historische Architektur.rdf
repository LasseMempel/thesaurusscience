    <!-- https://hist-arch-vocab.org/bvha#c_0095e4ea -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_0095e4ea">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_b9eb688f"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_2e3d5fc3"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_7f2e2699"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-03T20:40:03.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-03T20:52:26.000</terms:modified>
        <skos:altLabel xml:lang="fr">reliquaire topique</skos:altLabel>
        <skos:altLabel xml:lang="en">speaking reliquary</skos:altLabel>
        <skos:definition xml:lang="de">Reliquiar n, redendes: ein Reliquienbehälter, dessen Form auf den in ihm enthaltenen Körperteil oder Gegenstand hinweist, z. B. Armreliquiar, Fußreliquiar und Rippenreliquiar. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">redendes Reliquiar</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">reliquaire parlent</skos:prefLabel>
        <skos:prefLabel xml:lang="en">topical reliquary</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Der Terminus &quot;redendes Reliquiar&quot; wird von der aktuellen Forschung kritisch betrachtet, da sog. &quot;redende Reliquiare&quot; nicht unbedingt Reliquien der Körperteile enthalten, die durch das Reliquiar abgebildet werden. Beispiel: Barbarossakopf, Cappenberg. Alternativ wird der Terminus &quot;Körperteilreliquiar&quot; verwendet. [S. Schmidt]</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_009ce08f -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_009ce08f">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
