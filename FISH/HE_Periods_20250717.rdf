    <skos:prefLabel xml:lang="en">Middle Iron Age</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The second subdivision of the Iron Age. Circa -300 BCE to -100 BCE.</skos:scopeNote>
    <skos:notation xml:lang="en">MIA</skos:notation>
