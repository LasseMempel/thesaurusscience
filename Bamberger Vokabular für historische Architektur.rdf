    <!-- https://hist-arch-vocab.org/bvha#c_d382388d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_d382388d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_45fded98"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-24T21:05:25.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T11:40:29.000</terms:modified>
        <skos:definition xml:lang="de">Acheiropoieta f pl; von gr. acheiropoietos eikon &quot;ohne Hand gemachtes Bild&quot;; lat. acheropitae imagines: Bilder, die auf übernatürliche Weise entstanden sein sollen und daher als authentische Christus- bzw. Marienbilder gelten und als Reliquien verehrt werden; auch Bezeichnung für den ihnen folgenden Typus von Ikonen. In der byzantinischen Kunst werden MarienbiIder, die nicht von Menschenhand geschaffen sein sollen, als Theotokos-Acheiropoieta verehrt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Acheiropoieton</skos:prefLabel>
        <skos:prefLabel xml:lang="la">acheropita imago</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_d3946715 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_d3946715">
