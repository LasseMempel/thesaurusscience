        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_597af9bd"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_e289f1fb"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_e870cf52"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-28T10:34:58.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T15:31:27.000</terms:modified>
        <skos:altLabel xml:lang="la">pecten eburneus</skos:altLabel>
        <skos:definition xml:lang="de">Kamm m, liturgischer; lat. pecten (eburneus): ein kunstvoll gearbeiteter Kamm aus Edelmetall oder Elfenbeinschnitzerei, den der Priester beim Ankleiden zur Messe benützt. Die Verwendung bei der Bischofsweihe (dann auch Konsekrationskamm m genannt) ist nicht eindeutig belegt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="en">liturgical comb</skos:prefLabel>
        <skos:prefLabel xml:lang="de">liturgischer Kamm</skos:prefLabel>
        <skos:prefLabel xml:lang="la">pecten</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">peigne liturgique</skos:prefLabel>
    </owl:NamedIndividual>
    


