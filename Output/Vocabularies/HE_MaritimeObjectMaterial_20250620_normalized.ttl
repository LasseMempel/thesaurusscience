    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Dolerite"@en ;
    skos:scopeNote "Coarse basaltic rock."@en .

<http://purl.org/heritagedata/schemes/73/concepts/142974> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75385> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Ceramic"@en ;
    skos:scopeNote "A hard material formed by firing clay. For pottery, use POTTERY."@en .

<http://purl.org/heritagedata/schemes/73/concepts/143005> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/73/concepts/75335> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/73> ;
    skos:prefLabel "Lead Alloy"@en ;
