        <skos:altLabel xml:lang="de">Ohrmuschelwerk</skos:altLabel>
        <skos:altLabel xml:lang="cs">sloh boltcového ornamentu</skos:altLabel>
        <skos:definition xml:lang="de">(Ohrmuschelstil), im 17. Jh. hauptsächl. in den german. Ländern vorkommende, pflanzenähnl. Dekoration, die an Knorpel (Knorpelwerk) bzw. Ohrmuscheln erinnert. [Koepf/Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Ornamentik des niederländisch-deutschen Manierismus. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Ornamentika nizozemsko-německého manýrismu. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Ohrmuschelstil</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">boltcová ornamentika</skos:prefLabel>
    </owl:NamedIndividual>
    


