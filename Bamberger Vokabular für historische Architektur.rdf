        <skos:definition xml:lang="de">Kreuzrippe, Diagonalrippe eines Kreuzrippengewölbes im Unterschied zu den Gurtrippen bzw. Gurtbogen. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Kreuzrippe</skos:prefLabel>
        <skos:prefLabel xml:lang="en">cross rib</skos:prefLabel>
        <skos:prefLabel xml:lang="it">nervatura della crociera</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">ogive</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_914e4b37 -->


