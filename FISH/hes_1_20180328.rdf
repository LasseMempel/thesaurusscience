		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1170" />
		<skos:scopeNote xml:lang="en">A building found at the surface at the site of a mine. Use specific type where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
