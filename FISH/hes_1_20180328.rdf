		<skos:prefLabel xml:lang="gd">TOGALACH MÈINNE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach a tha air uachdar na talmhainn air làrach mèinne. Cleachd seòrsa nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MINE BUILDING</skos:prefLabel>
