        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_97c17ec7"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-11-04T16:43:15.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T14:39:04.000</terms:modified>
        <skos:definition xml:lang="de">Im Blockbau werden horizontal aufeinandergeschichtete, an den Ecken kraftschlüssig miteinander verbundene Hölzer zu Blockkränzen gefügt. Der horizontale Ausgleich zwischen den Blockkränzen erfolgt durch eine wechselseitige Anordnung der naturgemäß konischen Baumstämme (Wipfel- über Wurzelende/Zopf- über Stockende). [Eißing et al. 2012]</skos:definition>
        <skos:prefLabel xml:lang="de">Blockkranz</skos:prefLabel>
    </owl:NamedIndividual>
    


