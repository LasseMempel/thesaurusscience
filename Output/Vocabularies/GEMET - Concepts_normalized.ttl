    skos:closeMatch <http://data.uba.de/umt/_00050618> ;
    skos:definition "Any expanse of land which requires a person or agency with authority to interpose or interfere in how it is used or administrated."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Eingriff in die Raumordnung"@de,
        "land-management intervention area"@en .

<http://www.eionet.europa.eu/gemet/concept/11344> a skos:Concept ;
