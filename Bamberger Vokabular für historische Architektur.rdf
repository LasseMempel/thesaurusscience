    <!-- https://hist-arch-vocab.org/bvha#c_222e5cb9 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_222e5cb9">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_ec4abd50"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_34ca6582"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-11-07T14:44:01.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T17:39:44.000</terms:modified>
        <skos:altLabel xml:lang="de">Kryptofloreszenz</skos:altLabel>
        <skos:altLabel xml:lang="en">cryptoflorescence</skos:altLabel>
        <skos:altLabel xml:lang="fr">cryptoflorescence</skos:altLabel>
        <skos:altLabel xml:lang="cs">kryptoflorescence</skos:altLabel>
        <skos:definition xml:lang="fr">Cristaux de sels habituellement blancs, peu adhérents, formés sous la surface de la pierre. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="en">Poorly adhesive soluble salts, commonly white, located under the stone surface. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="de">Schwach anhaftende, lösliche, gemeinhin weiße Salze unterhalb der Gesteinsoberfläche. Der Begriff wird in den Fällen gebraucht, indenen die Kristallisation innerhalb des Materials stattfindet. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="cs">Špatně soudržné rozpustné soli, obvykle bílé, lokalizované pod povrchem kamene. Termín je používán v případě, kdy krystalizaceprobíhá uvnitř materiálu. [ICOMOS-ISCS]</skos:definition>
        <skos:prefLabel xml:lang="cs">Subflorescence</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Subfloreszenz</skos:prefLabel>
        <skos:prefLabel xml:lang="en">subflorescence</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">subflorescence</skos:prefLabel>
    </owl:NamedIndividual>
    


