	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502115">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502115</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TOGALACH EAGLAISEIL</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach a thathar dhen bheachd gun robh ceangal cràbhach aige.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ECCLESIASTICAL BUILDING</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-14T15:05:11</dcterms:created>
