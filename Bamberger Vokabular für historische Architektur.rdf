        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-15T15:18:44.000</terms:modified>
        <skos:definition xml:lang="de">(lat., Mz. Transennen), Verschluss der Fensteröffnung mit durchbrochenen Stein oder Holzplatten oder auch mit dünn geschliffenen Marmorplatten, vor Einführung der Fensterverglasung. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Mz. Transennen, Fensterabschluss aus dünn geschliffenem oder durchbrochenem Marmor, Alabaster, Stein, Holz. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Závěr okna z jemně broušeného nebo prolamovaného mramoru, alabastru, kamene nebo dřeva. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Transenna</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">transena</skos:prefLabel>
        <skos:prefLabel xml:lang="en">transenna</skos:prefLabel>
        <skos:prefLabel xml:lang="it">transenna</skos:prefLabel>
    </owl:NamedIndividual>
    


