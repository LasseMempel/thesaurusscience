        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-20T13:22:08.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T22:40:32.000</terms:modified>
        <skos:altLabel xml:lang="fr"> pont de pontons</skos:altLabel>
        <skos:altLabel xml:lang="it"> ponte di barconi</skos:altLabel>
        <skos:altLabel xml:lang="de">Pontonbrücke</skos:altLabel>
        <skos:altLabel xml:lang="cs">plovoucí most</skos:altLabel>
        <skos:altLabel xml:lang="it">ponte su barche</skos:altLabel>
        <skos:altLabel xml:lang="en">ponton bridge</skos:altLabel>
        <skos:definition xml:lang="de">Pontonbrücke, eine Brücke, die statt auf Pfeilern auf Schwimmkörpern oder Booten (Pontons) aufruht. Die S. wird hauptsächl. bei militär. Unternehmungen verwendet,  da sie bes. rasch montiert bzw. demontiert werden kann. Die erste große S. wurde von Harpalos im Auftrag des Perserkönigs Xerxes über den Hellespont gelegt. [Koepf /Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Schiffsbrücke, Brücke auf verankerten Schiffen oder Schwimmkörpern (Pontons). [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="fr"> pont de bateaux</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Schiffbrücke</skos:prefLabel>
        <skos:prefLabel xml:lang="it">ponte su chiatte</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">pontonový most</skos:prefLabel>
        <skos:prefLabel xml:lang="en">pontoon bridge</skos:prefLabel>
        <skos:prefLabel xml:lang="es">puente de pontones</skos:prefLabel>
    </owl:NamedIndividual>
    


