    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Strap End"@en ;
    skos:scopeNote "A fitting specifically functioning as the strengthener and support for the end of a strap of leather or fabric."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141182> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/mda_obj/concepts/96127> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/mda_obj> ;
    skos:prefLabel "Hypocaust Tile"@en ;
    skos:scopeNote "One of a number of tiles cemented together to form pillars supporting the floor above a hypocaust."@en .

<http://purl.org/heritagedata/schemes/mda_obj/concepts/141183> a skos:Concept ;
