<http://thesauri.dainst.org/_233a3677> a skos:Concept ;
    skos:altLabel "built environment (BBT)"@en ;
    skos:broader <http://thesauri.dainst.org/_1c0fa2d2> ;
    skos:definition "Dieser Term klassifiziert Strukturen sowie Befunde, einfach oder komplex, unabhängig von ihrer Größe, Dauer der Konstruktion oder Nutzung, die im Boden befestigt oder eingebettet sind und die nicht ohne irreversible Schäden bewegt werden können. (nach Dariah BBT 1.2.2 \"built environment\")"@de ;
    skos:exactMatch <https://vocabs.dariah.eu/bbt/Concept/000018> ;
    skos:inScheme <http://thesauri.dainst.org/scheme> ;
    skos:prefLabel "Gebaute Umgebung und Befunde"@de,
        "Built environment"@en ;
    skos:related <http://thesauri.dainst.org/_95140d65> .

