		<skos:prefLabel xml:lang="gd">CAMPA LUCHD-OBRACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach shealach far am faigh luchd-obrach togalach àite-fuirich.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">WORKERS CAMP</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-18T09:36:44</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-08-16T14:34:14</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/489" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502889" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/504820">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/504820</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">CAMPA LUCHD-OBRACH COILLTEARACHD</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Grunn thogalaichean no structaran sealach a bha nan àite-còmhnaidh do luchd-obrach na coilltearachd.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">FORESTRY WORKERS CAMP</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-03-29T11:40:18</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-03-29T11:41:12</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502243" />
				<skos:scopeNote xml:lang="en">A group of buildings or structures used as temporary accommodation for forestry workers.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/505841">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/505841</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">CAMPA LUCHD-BUANA DHEARCAN</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Làrach a chaidh a thogail a dh'aona-ghnothach mar àite-fuirich do luchd-obrach a tha an sàs obair ràitheil togail nam measan boga. Mar is trice, bidh sgiathan-cadail, còcaireachd is ithe fa leth ann.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">BERRY PICKERS CAMP</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-05-23T10:21:19</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-05-23T10:21:56</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502243" />
				<skos:scopeNote xml:lang="en">A purpose-built site providing accommodation for seasonal soft fruit workers, typically comprising separate dormitory, kitchen and dining wings.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:scopeNote xml:lang="en">A temporary site providing accommodation for construction workers.</skos:scopeNote>
