        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-25T13:06:36.000</terms:modified>
        <skos:altLabel xml:lang="en">beak</skos:altLabel>
        <skos:altLabel xml:lang="es">engrosamiento cuneiforme de un muro defensivo</skos:altLabel>
        <skos:altLabel xml:lang="en">nozzle</skos:altLabel>
        <skos:definition xml:lang="de">An der Angriffsseite eines Turms angebaute, keilförmige Mauerverdickung als Abprallschräge für Geschosse. [Koepf / Binding 2016]</skos:definition>
