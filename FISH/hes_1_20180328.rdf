		<skos:prefLabel xml:lang="gd">INNEALRADH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Inneal a chleachdar gus cumhachd mheacanaigeach a chur an gnìomh air rud no inneal a nì gnìomh sònraichte. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MACHINERY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/647" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1011" />
