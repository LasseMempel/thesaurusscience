<http://www.eionet.europa.eu/gemet/concept/2674> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6474> ;
    skos:closeMatch <http://data.uba.de/umt/_00008015> ;
    skos:definition "A chemical process, building, furnace, plant or other entity responsible for the discharge of pollutants or contaminants into the environment."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Emittent"@de,
        "emission source"@en .

<http://www.eionet.europa.eu/gemet/concept/2684> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2683> ;
    skos:closeMatch <http://data.uba.de/umt/_00051618> ;
    skos:definition "Issues or initiatives pertaining to the inter-relationship between ecological concerns and the economics of employment, including sustained, environmentally safe development; the effect of environmental activism on jobs; and the creation of environmental occupations."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Arbeit und Umwelt"@de,
        "employment and environment"@en .

<http://www.eionet.europa.eu/gemet/concept/2687> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2683> ;
    skos:closeMatch <http://data.uba.de/umt/_00004481> ;
    skos:definition "The result or impact of a specific policy, action or event upon the number of working-age persons holding jobs in a specific region, nation or sector of the economy."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
