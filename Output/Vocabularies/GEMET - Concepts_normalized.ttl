    skos:closeMatch <http://data.uba.de/umt/_00041610> ;
    skos:definition "Considering, weighing or counterbalancing the competing political or financial concerns of different parts of society, including industries, consumers, trade unions and other groups or organizations."@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Interessenausgleich"@de,
