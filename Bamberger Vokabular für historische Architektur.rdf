        <skos:altLabel xml:lang="de">Aufstandfläche</skos:altLabel>
        <skos:altLabel xml:lang="de">Widerlagsfläche</skos:altLabel>
        <skos:altLabel xml:lang="en">bearing surface</skos:altLabel>
        <skos:altLabel xml:lang="fr">cul d\&apos;imposte</skos:altLabel>
