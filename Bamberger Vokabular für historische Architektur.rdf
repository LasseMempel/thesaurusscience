        <skos:prefLabel xml:lang="fr">croix de consécration</skos:prefLabel>
        <skos:prefLabel xml:lang="la">crux signata</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">konsekrační kříž</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_c10d78d5"/>
    </owl:NamedIndividual>
    


