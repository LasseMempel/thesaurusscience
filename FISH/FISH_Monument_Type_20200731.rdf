  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92309">
    <skos:scopeNote xml:lang="en">A place of burial for members of the French Protestant Church.</skos:scopeNote>
  </rdf:Description>
