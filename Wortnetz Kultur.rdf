		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk020814"/>
		<skos:definition xml:lang="de">Ein Rüsselbecher ist ein merowingerzeitliches Trinkglas in Becherform, über dessen Außenwandung kleine, wie Rüssel oder Henkel aussehende Verzierungen aus Glasmasse ausgebildet sind. Oft treten zusätzliche horizontale Glasfadenverzierungen auf. Rüsselbecher sind hoch und konisch oder glockenförmig und haben einen kleinen Standfuß.</skos:definition>
		<skos:exactMatch rdf:resource="http://d-nb.info/gnd/7614217-6"/>
		<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q2204021"/>
