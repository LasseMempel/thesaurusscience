				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/501693</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">LÀRACH DEARBHADH ÀRC-EÒLAIS</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Làrach no cuimhneachan a chaidh a thogail air dòighean probhail airson diofar beachdan-bharail is mìneachaidhean air dàta àrc-eòlach a chur fo dheuchainn.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">EXPERIMENTAL ARCHAEOLOGY SITE</skos:prefLabel>
