		<skos:altLabel xml:lang="de">Terrinenform</skos:altLabel>
		<skos:altLabel xml:lang="de">Terrinenformen</skos:altLabel>
		<skos:altLabel xml:lang="en">terrines (baking dishes)</skos:altLabel>
