				<skos:prefLabel xml:lang="gd">GÀRRADH ÌOMHAIGHEAN SNAIGHTE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Gàrradh a chaidh a dhealbhadh airson taisbeanadh cruth-ealain, gu prìobhaideach no gu poblach.</skos:scopeNote>
