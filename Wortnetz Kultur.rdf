		<skos:altLabel xml:lang="de">Hiffen</skos:altLabel>
		<skos:altLabel xml:lang="de">Hiven</skos:altLabel>
		<skos:prefLabel xml:lang="en">rose hip</skos:prefLabel>
		<skos:altLabel xml:lang="de">Rosenäpfel</skos:altLabel>
