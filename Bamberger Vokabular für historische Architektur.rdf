        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-31T15:59:53.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T16:31:16.000</terms:modified>
        <skos:altLabel xml:lang="de">Triumphkreuzgruppe</skos:altLabel>
        <skos:definition xml:lang="de">Kreuzigungsgruppe f; auch Triumphkreuzgruppe f: ein Kruzifix mit Maria und Johannes dem Täufer als Fürbittern. Als plastische Gruppe im hohen Mittelalter oft auf dem Triumphbalken aufgestellt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Kreuzigungsgruppe</skos:prefLabel>
        <skos:prefLabel xml:lang="en">group of the triumphant Christ</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">groupe du Christ triomphant</skos:prefLabel>
    </owl:NamedIndividual>
    


