        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T14:40:11.000</terms:modified>
        <skos:note xml:lang="de">Erfassen von Informationen vor Ort mit Techniken, die keinen Kontakt mit der Wandmalerei haben. [EwaGlos]</skos:note>
        <skos:note xml:lang="en">Gathering of information on site using techniques that do not touch the surface of the wall painting. [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="de">berührungsfreie Untersuchung</skos:prefLabel>
        <skos:prefLabel xml:lang="en">contactless investigation</skos:prefLabel>
    </owl:NamedIndividual>
    


