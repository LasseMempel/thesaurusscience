    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_e1a11575">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_61a8f901"/>
