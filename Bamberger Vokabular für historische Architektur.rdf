        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_fac99281"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-11T17:07:31.000</terms:created>
