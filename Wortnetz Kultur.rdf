	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk018001">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Aufzeichnung (Dokument)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Aufzeichnungen (Dokumente)</skos:altLabel>
		<skos:prefLabel xml:lang="en">record (document)</skos:prefLabel>
		<skos:altLabel xml:lang="en">records (documents)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk005823"/>
		<vocnet:isMemberOfArray rdf:resource="http://lvr.vocnet.org/wnk/wk005824"/>
		<skos:definition xml:lang="de">Eine Aufzeichnung ist ein Dokument, das Daten oder Wissen in einem bestimmten Format oder auf einem bestimmten Medium festhält. Diese Informationen können in vielfältigen Kontexten erstellt, empfangen und verwaltet werden. Typischerweise werden aufgezeichnete Informationen in einer standardisierten Weise strukturiert, um ihre Organisation und den späteren Zugriff zu erleichtern.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300026685"/>
