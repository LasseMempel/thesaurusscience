	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk003998">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Gewann</skos:prefLabel>
		<skos:altLabel xml:lang="de">Gewanne</skos:altLabel>
		<skos:prefLabel xml:lang="en">open-field system</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk001455"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010296"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk010554"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019853"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019934"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk001455"/>
		<skos:definition xml:lang="de">Ein Gewann ist eine Flurform, die aus einem Verbund mehrerer schmaler, langgestreckter Parzellen mit einheitlicher Ausrichtung und Bewirtschaftung besteht. Entstanden durch die Einführung der flächengebundenen Dreifelderwirtschaft, brachten die streifenförmigen Gewanne Vorteile in der Bewirtschaftung der Flächen mit dem Pflug. Eine Einteilung in Gewanne wurde durch die Einführung der Fruchtwechselwirtschaft und die Aufhebung des Flurzwangs überflüssig.</skos:definition>
		<xe:explanation_temp xml:lang="de">Anders als beispielsweise bei der Hufenflur weisen die Parzellen keinen Anschluss an die Höfe auf. Gewanne sind insbesondere typisch für Regionen, in denen Realteilung praktiziert wurde. Ihre Auflösung zugunsten von für die moderne Landwirtschaft effizienteren Flurformen ging in der Regel mit einem Verlust der für sie typischen kleinteiligen Gliederung der Flur einher.</xe:explanation_temp>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010296"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010554"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019853"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019934"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk001455"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-02-23T12:51:00+01:00+01:00</dcterms:modified>
	</skos:Concept>
