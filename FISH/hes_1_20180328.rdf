	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1526">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1526</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">ROILIG</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite-tìodhlacaidh, gu math tric am broinn cille, mun a bheil balla, feansa no callaid.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BURIAL ENCLOSURE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1667" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1525" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1692" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1697" />
		<skos:scopeNote xml:lang="en">A burial ground, often within a graveyard, enclosed by a wall, fence or hedge.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1527">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1527</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CUIMHNEACHAN CABHSAIREACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Cuimhneachan à linn ùr na cloiche; dìg a tha cha mhòr cearclach mun cuairt air, le iomadh cabhsair a' dol a-steach air agus gu tric le uchdan na bhroinn, le iomadh cabhsair aige-san cuideachd.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CAUSEWAYED ENCLOSURE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1525" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/2317" />
		<skos:scopeNote xml:lang="en">A Neolithic monument comprising a sub-circular enclosing ditch, interrupted by frequent causeways, and often accompanied by an internal bank, also causewayed.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/1532">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/1532</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">GEÀRRAIDH SHLOCACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Lann a tha ga chomharradh le sreath de shlocan no tuill phuist.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PIT ENCLOSURE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-05-14T14:55:49</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1525" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1901" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/324" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/507323" />
		<skos:scopeNote xml:lang="en">An enclosure where the boundary is defined by a line of pits. Usually revealed as cropmarks on aerial photographs. Where excavation has shown the pits contained upright timber posts use TIMBER ENCLOSURE.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
