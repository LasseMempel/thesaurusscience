	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk008146">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Bolero (Jacke)</skos:prefLabel>
		<skos:prefLabel xml:lang="en">bolero</skos:prefLabel>
		<skos:altLabel xml:lang="de">Boleros (Jacken)</skos:altLabel>
		<skos:altLabel xml:lang="en">boleros</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk006028"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk006028"/>
		<skos:definition xml:lang="de">Ein Bolero ist eine kurze Jacke mit langen oder kurzen Ärmeln, die vorne offen getragen wird. Sie ist meist aus leichtem Stoff wie Spitze, Seide, Baumwolle oder Strickware gefertigt. Boleros sind ein ursprünglich spanisches Kleidungsstück, das vor allem von Männern, später aber auch von Frauen getragen wurde. Früher hat ein Bolero oft dekorative Elemente wie Stickereien, Fransen oder Verzierungen gehabt.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300209876"/>
