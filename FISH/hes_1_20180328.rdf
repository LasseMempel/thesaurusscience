			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500633">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500633</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">CORP-EAGLAISE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Prìomh-earrann eaglaise a tha a' dol o cheann an iar suas gun t-seansal no na cruistean.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">NAVE</skos:prefLabel>
