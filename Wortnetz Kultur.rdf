	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk005244">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:altLabel xml:lang="de">Dada</skos:altLabel>
		<skos:prefLabel xml:lang="en">dada</skos:prefLabel>
		<skos:altLabel xml:lang="en">dadaism</skos:altLabel>
		<skos:prefLabel xml:lang="de">Dadaismus</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk005838"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk012793"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk005838"/>
		<xe:explanation_temp xml:lang="de">Als internationale Bewegung fand sie ihren Mittelpunkt in der Schweiz in dem 1916 in Zürich gegründeten Cabaret Voltaire.</xe:explanation_temp>
		<skos:definition xml:lang="de">Der Dadaismus ist ein moderner Kunststil, der das revolutionäre Ziel verfolgt, sinnentleerte und bürgerliche Konventionen durch etwas Neues zu ersetzen.</skos:definition>
		<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300021500"/>
