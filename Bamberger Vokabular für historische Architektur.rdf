        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_23ef6484"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-19T16:56:15.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T13:16:30.000</terms:modified>
        <skos:altLabel xml:lang="de">Bauwerk</skos:altLabel>
        <skos:altLabel xml:lang="de">Gebäude</skos:altLabel>
        <skos:altLabel xml:lang="cs">stavba</skos:altLabel>
        <skos:altLabel xml:lang="cs">stavební objekt </skos:altLabel>
        <skos:definition xml:lang="de">Das sich über das Terrain erhebende Gesamtvolumen eines Bauwerks, bestimmt von Form, Struktur, Gruppierung und Material; spiegelt zumeist das innere Raumgefüge. [Koepf / Binding 2016] </skos:definition>
        <skos:definition xml:lang="de">Ein sich über die Erde erhebendes und Räume umschließendes Bauwerk. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Hochbauwerk</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">nadzemní konstrukce (stavba) </skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_dd7d3e1a -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_dd7d3e1a">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_e2a5d877"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-05T12:42:59.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T01:07:43.000</terms:modified>
        <skos:definition xml:lang="de">(gr. gymnos: nackt), Schule mit Laufbahnen, Bädern und Hörsälen, die auch mit einer Ringerschule (Palästra) verbunden sein kann, für die körperl. Ausbildung der Knaben, Epheben und Jünglinge. Ein G. mit mehreren, terrassenförmig angelegten Stadien lag z.B. am Stadtrand von Priene. Eine große G.anlage mit mehreren Auditorien ist z.T. noch neben dem Demeterbezirk in Pergamon erhalten. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Gymnasion (griech. gymnos = nackt), griechisch-antiker Sport- und Ausbildungsplatz für Knaben, Epheben, Jünglinge, später durch Stoa, Bad, Palaistra (Ringerschule), Stadion (Laufbahn) und Lehrsäle erweitert. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Řec. gymnos = nahý. Sportovní a školní objekt v antickém Řecku pro chlapce, jinochy a mladé muže, později rozšířen o stou, lázně, palestru (zápasnická škola), stadion (běžecká dráha) a učební sály. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Gymnasion</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">gymnasion</skos:prefLabel>
    </owl:NamedIndividual>
    


