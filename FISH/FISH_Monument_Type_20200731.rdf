    <skos:scopeNote xml:lang="en">A grave or sepulchre including a monument. Use specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/130174">
    <skos:scopeNote xml:lang="en">An old opencast iron ore site, which has been abandoned.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68788">
    <skos:scopeNote xml:lang="en">A building which provides the centralized market for trading in stocks and shares and for raising capital for industry.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93470">
    <skos:scopeNote xml:lang="en">A room or office at a general practitioners' or veterinary practice, where patients or animals are seen and medicine dispensed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71857">
    <skos:scopeNote xml:lang="en">A place of worship for followers of the Countess of Huntingdon's Connexion, a Calvinistic Methodist sect founded in the 1740s by Selina Hastings, Countess of Huntingdon.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91598">
    <skos:scopeNote xml:lang="en">A site where concrete and concrete products are manufactured from a mixture of cement and aggregate.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70225">
    <skos:scopeNote xml:lang="en">A bridge whose upkeep and repair was financed by the exaction of a toll.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159306">
    <skos:scopeNote xml:lang="en">A prefabricated structure of a light timber frame with external weather boarded walls and a timber felt covered roof. They were used as barrack blocks during WWII. Manufactured by Magnet Limited.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91976">
    <skos:scopeNote xml:lang="en">A factory where floorcloths are manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68969">
    <skos:scopeNote xml:lang="en">A building or room where food is prepared and cooked.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68751">
    <skos:scopeNote xml:lang="en">A planned administrative capital for local government which provided amenities for the Roman and peregrine (non-Roman) inhabitants of the town.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93041">
    <skos:scopeNote xml:lang="en">A site where acts of corporal and capital punishment were carried out.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/97276">
    <skos:scopeNote xml:lang="en">A building or group of buildings, often enclosed by a system of fortifications, used by an armed force for the storage and distribution of military equipment.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160127">
    <skos:scopeNote xml:lang="en">A turf-covered mound in a curvilinear E-shape, and hard-standing to take an aircraft. There were usually an access point to an air raid shelter at the rear. In use during WW2</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92944">
    <skos:scopeNote xml:lang="en">A storage rack for sections of steel plate used in the construction of ships.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68905">
    <skos:scopeNote xml:lang="en">A protective earthen mound, often the main defence of a fortification.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140311">
    <skos:scopeNote xml:lang="en">A building housing washing facilities and toilets. The term occurs mainly in a military context.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142010">
    <skos:scopeNote xml:lang="en">A grave which has been formed by cutting into the bedrock of a site.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91718">
    <skos:scopeNote xml:lang="en">A building in which raw pottery is finished by dipping it in glaze.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71410">
    <skos:scopeNote xml:lang="en">A building in which cows are milked.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71642">
    <skos:scopeNote xml:lang="en">A golf course, clubhouse and ancilliary buildings.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87874">
    <skos:scopeNote xml:lang="en">A council-owned block of flats.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69257">
    <skos:scopeNote xml:lang="en">Horse powered ore crusher, consisting of a stone wheel running over a circular iron or stone bed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71357">
    <skos:scopeNote xml:lang="en">A room used by those who have to wait at railway or bus stations, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93829">
    <skos:scopeNote xml:lang="en">A specialist hospital where women receive medical and surgical treatment.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71444">
    <skos:scopeNote xml:lang="en">A custodial institution for offenders below the legal age of responsibility.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140152">
    <skos:scopeNote xml:lang="en">A building that houses material that can be used to facilitate the study of a site, landscape or an historical event/period. Such centres are often found in close proximity to the sites and/or landscapes that they seek to encourage the study of.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93958">
    <skos:scopeNote xml:lang="en">A large store for the temporary accommodation of goods awaiting transportation to or from the sea.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160242">
    <skos:scopeNote xml:lang="en">A power house built to Air Ministry drawing number 207/17 and comprising four rooms; a driver's room, workshop and store, battery room and engine room containing 2 generator sets.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70407">
    <skos:scopeNote xml:lang="en">Circular or near circular ditches, usually seen as cropmarks. Use the term where the function is unknown. Ring ditches may be the remains of ploughed out round barrows, round houses, or of modern features such as searchlight emplacements.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68595">
    <skos:scopeNote xml:lang="en">A device for catching fish, may be a portable or permanent structure, often a fence or row stakes made in a river, harbour, etc</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93684">
    <skos:scopeNote xml:lang="en">An office where the administrative duties of a university are performed.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71369">
    <skos:scopeNote xml:lang="en">A county judicial building where the Quarter Session and the Assizes for the County were held.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70056">
    <skos:scopeNote xml:lang="en">A cemetery comprising exclusively cremated human remains, some or all of which may be contained within pottery vessels.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69976">
    <skos:scopeNote xml:lang="en">An enclosed area of ground immediately surrounding a cathedral.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140060">
    <skos:scopeNote xml:lang="en">A site where cementstone nodules are extracted under ground.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68928">
    <skos:scopeNote xml:lang="en">A building for human habitation, especially a dwelling place. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70277">
    <skos:scopeNote xml:lang="en">A series of flat-topped structures, usually made of stone or wood, used to facilitate a person's movement from one level to another.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70102">
    <skos:scopeNote xml:lang="en">A covered gateway, at the entrance to a churchyard, where during a funeral a coffin could be set down until the vicar arrived.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/147549">
    <skos:scopeNote xml:lang="en">The highest judicial court where appeals can be heard and whose rulings are not subject to further review by another court.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/152399">
    <skos:scopeNote xml:lang="en">A trench in the form of a flattened 'W' with a flat concrete roof covered in turf, supported on concrete pillars. The name derives from the resemblance to a child's drawing of a seagull in flight.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91038">
    <skos:scopeNote xml:lang="en">A place of worship and residence for Anglican nuns.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70192">
    <skos:scopeNote xml:lang="en">A stone circle featuring four upright stones standing at the corners of an irregular quadrilateral. The monument may feature more than 4 stones, overall, but the corner stones are often the most prominent.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/99658">
    <skos:scopeNote xml:lang="en">A place of worship for members of the Seventh Day Adventists Church. This was formed in 1843 by followers believing in the imminent second coming of Christ.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71862">
    <skos:scopeNote xml:lang="en">A place where the homeless are accommodated, permanently or temporarily.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92740">
    <skos:scopeNote xml:lang="en">A building providing accommodation, dining and recreational facilities for commissioned naval officers.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92774">
    <skos:scopeNote xml:lang="en">A grotto or shrine dedicated to the nymphs, composed of fountains designed to imitate a natural grotto.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69034">
    <skos:scopeNote xml:lang="en">A park for the use of the public for entertainment and relaxation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/90199">
    <skos:scopeNote xml:lang="en">A room or building occupied by a person employed to keep accounts of workers' hours of labour.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68821">
    <skos:scopeNote xml:lang="en">A building used to house members of the armed forces.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143509">
    <skos:scopeNote xml:lang="en">In the glass industry, a furnace of Lorraine Type, comprising a central rectangular melting furnace with ancillary structures at each corner, adjacent to the fires. Post-Mediaeval until superceded by coal-fired furnaces.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93136">
    <skos:scopeNote xml:lang="en">A factory where ribbons are manufactured.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93725">
    <skos:scopeNote xml:lang="en">A point in a village providing water for drinking and washing.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71371">
    <skos:scopeNote xml:lang="en">A row of houses attached to and adjoining one another and planned and built as one unit.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69418">
    <skos:scopeNote xml:lang="en">A handloom weavers workshop where the weaver received yarn from a clothier and manufactured a woven piece of cloth from it.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69374">
    <skos:scopeNote xml:lang="en">A device for converting one voltage of alternating current to another voltage.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160509">
    <skos:scopeNote xml:lang="en">An area of hardstanding, surrounded on three sides by a protective wall or bank, used for parking aircraft, in a state of readiness, usually around the perimeter of an airfield.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160499">
    <skos:scopeNote xml:lang="en">A building or site conducting research into communication techniques for use in the Royal Navy.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68735">
    <skos:scopeNote xml:lang="en">An establishment where offenders are confined. Use more specific type where known.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/164099">
    <skos:scopeNote xml:lang="en">A military depot where horses were taken and trained for service in the army.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93694">
    <skos:scopeNote xml:lang="en">A small building housing a valve which controls the flow within a water regulation system.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92594">
    <skos:scopeNote xml:lang="en">A dwelling-house with outbuildings and land assigned to its use.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/69962">
    <skos:scopeNote xml:lang="en">A small dwelling for the solitary confinement of a pious reclusive religious man or monk, often attached to the north wall of a church. A squint enabled the occupant to witness the Mass.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/147241">
    <skos:scopeNote xml:lang="en">A building which has been fortified, often as a temporary measure rather than as part of the original design</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/92595">
    <skos:scopeNote xml:lang="en">A modern building in which the load is carried by a metal girder framework and infilled with a light curtain wall.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/129045">
    <skos:scopeNote xml:lang="en">A single storey building designed so that windows incorporated into the saw tooth roof catch the available light.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/159240">
    <skos:scopeNote xml:lang="en">A factory complex consisting of PRINTING SHOPS, COLOUR HOUSES, DYE HOUSES, etc, in which patterns are printed onto textiles.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71708">
    <skos:scopeNote xml:lang="en">A house or hut for a nightwatchman; including parish watch houses in churchyards and private watch houses, eg. in dockyards, factories, etc.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/140647">
    <skos:scopeNote xml:lang="en">An establishment from which food is distributed to the public during wartime or similar states of emergency.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160362">
    <skos:scopeNote xml:lang="en">A complex of buildings used as a headquarters and training base for Royal Navy personnel. Even though they are buildings on land shore establishments are deemed to be shipsand are designated 'HMS' eg. HMS Dolphin in Portsmouth.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/142958">
    <skos:scopeNote xml:lang="en">A well concealed structure, usually constructed underground, intended for use by members of the British Resistance Organization in the event of invasion.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/143450">
    <skos:scopeNote xml:lang="en">An observation tower is a structure used to provide panoramic views of the surrounding area. They are often used as attractions at seaside resorts e.g. Blackpool Tower.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160522">
    <skos:scopeNote xml:lang="en">A building or site used by the armed forces for the storage and issuing of military stores and materials.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/93081">
    <skos:scopeNote xml:lang="en">A mechanically operated lift used to transfer rolling stock from one level of track to another.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/68582">
    <skos:scopeNote xml:lang="en">A yard or enclosure attached to a farmhouse, usually surrounded by other farm buildings.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70342">
    <skos:scopeNote xml:lang="en">A covered walk, walled on one side and usually arcaded on the other, surrounding or partly surrounding an open area in a monastery or similar complex of Christian buildings.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70445">
    <skos:scopeNote xml:lang="en">Manmade constructions used to prevent water flooding the surrounding area. Often taking the form of a bank or wall but may be more elaborate e.g. the Thames Barrier.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/87919">
    <skos:scopeNote xml:lang="en">A building where miners could improve their knowledge by attending lectures and using the reading room facilities.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/160221">
    <skos:scopeNote xml:lang="en">A sign used by the Air Raid Precautions network to assist in identifying vital equipment and resources in the event of an air raid or to aid movement during blackouts.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91714">
