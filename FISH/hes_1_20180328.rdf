		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/525">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/525</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BAILE CROITEARACHD</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Tuineachadh a dh'aithnichear air a phàtran cunbhalach. Bidh taighean nan croitearan ann an sreath a ghnàth 's croit ri gach taigh. Tha na croitean nan lotaichean ceart-cheàrnach ri taobh a chèile mar is trice.</skos:scopeNote>
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/526">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/526</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TUINEACHADH FOSGAILTE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Tuineachadh gun lann mun cuairt air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">UNENCLOSED SETTLEMENT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/507" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/2018">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/2018</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">TUINEACHADH BACACH CUAIRTICHTE</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Tuineachadh ro-eachdraidheil, le grunn ùrlaran airson taighean-cruinne fiodha, mar is trice air leathad 's gu h-àraid ann an Crìochan na h-Alba.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">UNENCLOSED PLATFORM SETTLEMENT</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/526" />
				<skos:scopeNote xml:lang="en">A prehistoric settlement, comprising a number of platforms for timber roundhouses, usually found on a hillside, particularly in the Border Counties.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/320" />
		<skos:scopeNote xml:lang="en">A settlement lacking an enclosure boundary.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/528">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/528</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BAILE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Tuineachadh sa bheil taighean-còmhnaidh prìobhaideach agus togalaichean eile, nas lugha na baile mòr agus le eagrachas is rianachd nas simplidhe.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">VILLAGE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">DESERTED VILLAGE</skos:altLabel>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/530" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/529" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/507" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/192" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/198" />
		<skos:scopeNote xml:lang="en">A settlement with private dwellings and other buildings, smaller than a town and with a simpler form of organisation and administration.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/529">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/529</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BAILE GNÌOMHACHAIS</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Baile sa bheil luchd-obrach gnìomhachais, gu sònraichte, a' fuireach ann còmhla ris an teaghlaichean agus mar is trice, fo fhastadh aig gnìomhachasan faisg air làimh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">INDUSTRIAL VILLAGE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">COAL MINERS VILLAGE</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/528" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/647" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/504100" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/530" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/535" />
		<skos:scopeNote xml:lang="en">A village inhabited mainly by industrial workers and their families, usually employed at nearby industrial concerns.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/530">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/530</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BAILE DEALBHAICHTE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Baile no tuineachadh a chaidh a phlanadh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MODEL VILLAGE</skos:prefLabel>
