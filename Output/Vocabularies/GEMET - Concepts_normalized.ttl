    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Straßenunterhaltung"@de,
        "road maintenance"@en .

<http://www.eionet.europa.eu/gemet/concept/728> a skos:Concept ;
    skos:broadMatch <http://eurovoc.europa.eu/3810> ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1327> ;
    skos:closeMatch <http://data.uba.de/umt/_00047316> ;
    skos:definition "Any chemical species, ionic or molecular, capable of accepting or receiving a proton (hydrogen ion) from another substance; the other substance acts as an acid in giving of the proton; the other ion is a base."@en ;
