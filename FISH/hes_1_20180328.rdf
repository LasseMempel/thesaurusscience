		<skos:prefLabel xml:lang="gd">LÀRACH LEAGHADH LUAIDHE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach far a bheilear a' sgaradh luaidhe mheatailteach on chlach-mhèinnir aice.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">LEAD SMELTING SITE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
