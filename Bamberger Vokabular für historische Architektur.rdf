        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-05T16:32:04.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T23:13:47.000</terms:modified>
        <skos:definition xml:lang="de">Ein als Blockbau errichtetes Haus, dessen Obergeschoss oder Dach (Dachgeschoss) auf einer selbständigen äußeren Tragkonstruktion aus Säulen oder Ständern, Rähm, Riegeln und Streben bzw. Kopfbändern ruht. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Umgebindehaus</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">hrázděný dům s vnitřním nosným skeletem a samonosnými obvodovými stěnami</skos:prefLabel>
    </owl:NamedIndividual>
    


