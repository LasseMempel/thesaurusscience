        <skos:altLabel xml:lang="de">Fußgesims</skos:altLabel>
        <skos:definition xml:lang="de">Fußgesims, Sockelgesims, Gesims als unterer Abschluss einer Wand auch über einem Sockel. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Gesims, das den Sockel oder das Sockelgeschoss (Geschoss) abschließt. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Sockelgesims</skos:prefLabel>
        <skos:prefLabel xml:lang="en">base moulding</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">chanfrein de socle</skos:prefLabel>
