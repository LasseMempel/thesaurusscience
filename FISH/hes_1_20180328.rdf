	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/236">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/236</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH-MALAIRT</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach coimeirsealta airson iomadh rud, gu sònraichte mar ionad malairt do mharsantan ach le bùthan, oifisean poblach, tallachan chomann-cheàird is msaa cuideachd.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">EXCHANGE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/237" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/211" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/505461">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/505461</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">SEÒMAR-MALAIRT</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Togalach sa bheil bòrd a chaidh a stèidheachadh airson leas na malairt aca a dhìon.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">CHAMBER OF COMMERCE</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-09-28T13:51:29</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-09-28T13:53:13</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/236" />
				<skos:scopeNote xml:lang="en">A building housing a board organised to protect the interests of commerce.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
