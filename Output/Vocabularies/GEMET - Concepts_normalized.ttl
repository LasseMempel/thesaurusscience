    skos:broader <http://www.eionet.europa.eu/gemet/concept/6724> ;
    skos:closeMatch <http://data.uba.de/umt/_00023059> ;
    skos:definition """1) Both metals and non-metals, essential for the metabolic processes of algae, invertebrates and vertebrates. Organisms that derive nearly all their energy via photosynthesis are especially dependent upon dissolved trace substances.
2) Impurities that are present at small but detectable levels."""@en ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
    skos:prefLabel "Spurenstoff"@de,
