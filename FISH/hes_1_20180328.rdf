		<skos:prefLabel xml:lang="gd">TAIGH-TOBAIR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach os cionn tobair sa bheil acainnean a thogas uisge an àirde. Gu math tric, bidh CUIBHLE ASAIL no EINNSEAN EICH ann.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">WELL HOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-11T15:32:12</dcterms:created>
