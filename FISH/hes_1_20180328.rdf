		<skos:prefLabel xml:lang="gd">TAIGH-GNÌOMHACHAIS</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite-còmhnaidh, agus uaireannan àite-obrach, aig luchd-obrach gnìomhachais.</skos:scopeNote>
