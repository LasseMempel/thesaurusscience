		<skos:prefLabel xml:lang="gd">COMHARRAN TREABHAIDH</skos:prefLabel>
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/49">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/49</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">ACHADH CHÀRN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Buidheann de chàirn a tha faisg air a chèile 's a' chuid as motha dhiubh nan càirn cartaidh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CAIRNFIELD</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">SMALL CAIRNS</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/105" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1461" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1699" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/42" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/43" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/54" />
		<skos:scopeNote xml:lang="en">A group of cairns in close proximity to each other, the majority of which are clearance cairns.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/51">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/51</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BARRAID ÀITEACHAIS</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Pìos de thalamh air leathad 's a chaidh a thogail ach am bi talamh rèidh ann far an urrainnear fàs a thoirt air bàrr.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">CULTIVATION TERRACE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-02-27T10:15:30</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/105" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/52" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/54" />
		<skos:scopeNote xml:lang="en">A strip of land on a slope, which has built up to provide a flat surface for the cultivation of crops.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/52">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/52</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BARRAID TREABHAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Barraid no uchdan a tha a' comharrachadh crìochan  achadh uachdarach is ìochdarach. Thàinig seo am bith mar thoradh air gluasad na h-ùire leis an leathad an cois treabhaidh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">LYNCHET</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/105" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/4" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/51" />
		<skos:scopeNote xml:lang="en">A scarp or bank defining the upper and lower boundaries of a field. Formed as a result of the gradual downhill movement of soil loosened by ploughing.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/53">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/53</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">COMHARRAN TREABHAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Comharran fon ùir a nochd an cois àiteachais o chionn fhada nuair a bhite a' treabhadh an fhearainn le crann-treabhaidh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PLOUGH MARKS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
