    <!-- https://hist-arch-vocab.org/bvha#c_5f7da97c -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_5f7da97c">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f54d07cc"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_dd93313a"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-04T11:19:39.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T21:36:20.000</terms:modified>
        <skos:definition xml:lang="de">Inkrustation (lat. crusta = Rinde), Einlegearbeit von farbigen Steinen in Stein, bei der z.B. heller und dunkler Marmor wechseln (besonders in Wänden und Fußböden). Blütezeit: Antike, Byzantinische Kunst, Italien vom Mittelalter bis Barock. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Lat. crusta = kůra. Vkládání barevných kamenů do kamene, kdy se např. střídá světlejší a tmavší mramor (zvl. na stěnách a podlahách), rozkvět: antika, byzantské umění, Itálie od středověku po baroko. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Inkrustation (Kunsthandwerk)</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">inkrustace (řemeslo)</skos:prefLabel>
    </owl:NamedIndividual>
    


