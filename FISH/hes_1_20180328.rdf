	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500626">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500626</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CRANN RÈIDEAR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Crann de theannadairean meatailte (no fiodha) ann an cruth laitise 's a chleachdar ann an stèisean rèideir.  Tha seo na sheasamh air ceithir stèidhean concrait agus taic uèirichean a bharrachd ris gu tric.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">RADAR MAST</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-30T09:52:11</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-03-09T11:45:10</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/374" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/378" />
		<skos:scopeNote xml:lang="en">A mast of metal girders (or wood) in a lattice construction for use by a Radar Station.  Usually stands on four concrete plinths and is often supported by additional wires.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500627">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500627</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">CLACHMHÌLE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Pleata, mar is trice fear fiodha no meatailt, a chaidh a shuidheachadh aig rathad, canal no rathad-iarainn gus na mìltean o àite no a dh'ionnsaigh àite a chomharradh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MILE PLATE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-30T09:56:03</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-30T09:56:28</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1775" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1815" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1849" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1857" />
		<skos:scopeNote xml:lang="en">A plate, usually of wood or metal, set up on a road, canal or railway to mark the miles from or to a place.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500629">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500629</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">GIL MÈINNIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Mòr-ghil a dh'èirich an cois cleachdadh uisge gus cuisle a nochdadh no a dhùsgadh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">HUSH</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-30T09:59:49</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-30T10:00:23</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">LEAD HUSH</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1032" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1984" />
		<skos:scopeNote xml:lang="en">A ravine formed by using water to reveal or exploit a vein.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
