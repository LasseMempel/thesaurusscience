@prefix dct: <http://purl.org/dc/terms/> .
@prefix ns1: <http://creativecommons.org/ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://purl.org/heritagedata/schemes/571/concepts/151056> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151715> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Waterworks"@en ;
    skos:scopeNote "Buildings, engineering constructions and machinery, used for the purpose of supplying a town, or region with water distributed through pipes."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151058> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151055> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Sea Wall"@en ;
    skos:scopeNote "A form of sea defence, may be of hard and strong material (eg concrete) or an earthen bank constructed on the landward part of a coast to reduce the effects of strong waves."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151060> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151717> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Sewage Works"@en ;
    skos:scopeNote "An area in which local sewage is filtered and purified in large rectangular or circular tanks."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151061> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151055> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Groynes"@en ;
    skos:scopeNote "A series of structures extending into the sea for the purpose of preventing further lateral movement of washed up sand and shingle."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151065> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151697> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "School"@en ;
    skos:scopeNote "Primary and secondary educational establishments, buildings and directly associated and usually defined grounds, including car parking etc."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151066> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151697> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "University Campus"@en ;
    skos:scopeNote "Educational establishments awarding degrees and undertaking research. Includes buildings and directly associated and usually defined grounds."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151067> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151697> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "College Campus"@en ;
    skos:scopeNote "Buildings and grounds of secondary or tertiary educational establishments, below the status of universities."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151068> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151698> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Hospital"@en ;
    skos:scopeNote "Establishment (buildings and directly associated grounds) providing care to casualties and the seriously or chronically ill."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151069> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151459> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Workhouse"@en ;
    skos:scopeNote "Establishment (buildings and directly associated and usually defined grounds) where the community's poor were maintained at public expense, and provided with labour."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151072> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151707> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Chapel"@en ;
    skos:scopeNote "Place of Christian worship; can include non-conformist (and non-parochial) churches (q.v.) and privately owned chapels. Includes immediately associated and usually physically defined land."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151073> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151707> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Mosque"@en ;
    skos:scopeNote "Place (buildings and directly associated, usually defined, grounds) of Islamist or Mohammedan worship."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151074> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151707> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Synagogue"@en ;
    skos:scopeNote "Place of worship (buildings and directly associated and usually defined grounds) for communities of Jews."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151076> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151458> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Shopping Street"@en ;
    skos:scopeNote "Street (often with associated back yards etc) predominantly fitted with retail outlets."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151080> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151458> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Garden Centre"@en ;
    skos:scopeNote "A place, buildings and directly associated grounds, where gardening tools, plants, etc, are sold."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151086> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151647>,
        <http://purl.org/heritagedata/schemes/571/concepts/151667> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Terminal Building"@en ;
    skos:scopeNote "A building within a transport terminal, often associated with the registration and clearing of incoming and outgoing passengers or freight. Also used for waiting and so often provided with commercial outlets and other facilities."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151088> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151090> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Navigable River"@en ;
    skos:scopeNote "Length of river sufficiently deep for regular use by water transport and traffic."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151092> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151091> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Dry Dock"@en ;
    skos:scopeNote "A stone-faced enclosure, with entrance closed by a floatable caisson or by gates, which can be pumped dry for inspection, maintenance, or repair of the hull or underwater fittings of a ship or ships."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151093> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151091> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Wet Dock"@en ;
    skos:scopeNote "An artificial structure or group of structures enclosing an area of water which was impounded by lock gates to maintain water levels artificially, facilitating the loading, unloading, building or repair of ships."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151094> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151667> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Quarantine Area"@en ;
    skos:scopeNote "An area, often linked to a port, where a period of detention was imposed on travellers or voyagers suspected of carrying infectious diseases before they were allowed to enter a country or town."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151098> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151648> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Slipway"@en ;
    skos:scopeNote "A structure inclined towards the water on which a ship may be built or lowered into the water."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151099> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151652> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Container Terminal"@en ;
    skos:scopeNote "An area of a port, dock or harbour where cargo vessels load and unload large storage containers. Includes associated container storage areas and rail terminals for containers transported to the terminal by rail."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151100> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151652> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Ferry Terminal"@en ;
    skos:scopeNote "An area of a port, dock or harbour, often including buildings for passport control, customs and for sheltered waiting and storage, where passengers and vehicles using ferry services can embark/disembark and where supplies can be taken on board."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151102> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151101> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Commercial Shipping Route"@en ;
    skos:scopeNote "Route regularly used by ships engaged in commerce or trade. May be defined by usage or in some areas, formally defined by regulation. Distinguished from the Navigation route Sub-character Type by the association with commerical shipping."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151103> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151101> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Ferry Crossing"@en ;
    skos:scopeNote "A regular commercial passenger route across an area of sea, estuary, river or lake, or an area of port, dock or harbour. Includes chain link ferry crossings."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151104> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151678> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Dredged Area"@en ;
    skos:scopeNote "An area from which sediments have been removed to ensure a safe depth of water in channels and berths for navigational purposes or to mitigate risk of flooding or protect a sensitive habitat."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151105> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151678> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Anchorage"@en ;
    skos:scopeNote "An area of sea or coast where vessels anchor, often provided by sheltered conditions afforded by the topography of the nearby coast. They are often located along coastlines within bays or areas sheltered from prevailing winds and/or strong currents."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151106> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151681> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Wreck Hazard"@en ;
    skos:scopeNote "Relates to the area of the hazard which may include a single wreck or a cluster of several. Wrecks have greatest relevance from their roles as hazards to navigational activity, or as indicators of areas and routes of past navigational or trading activity."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151107> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151681> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Shallows"@en ;
    skos:scopeNote "An area of the sea, a lake, or a river where the water is not very deep."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151108> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152539> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Lighthouse"@en ;
    skos:scopeNote "A tower or structure, with a powerful light or lights at the top, usually erected at an important or dangerous point on or near the sea-coast for the warning and guidance of mariners, but may also be sited inland."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151109> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152539> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Buoyage"@en ;
    skos:scopeNote "Floating, fixed markers indicating to a navigator a sea area to approach or avoid. Single or arrangements of buoys, beacons and lights are often used to demarcate safely navigable entrances to estuaries and rivers, submerged hazards and foul areas."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151110> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152539> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Coastguard Station"@en ;
    skos:scopeNote "A building or group of buildings situated close to the sea used by coastguards, or a volunteer coastwatch, to enable them to monitor the coastline."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151111> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152539> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Lifeboat Station"@en ;
    skos:scopeNote "A building designed to house a lifeboat, usually with a ramp to launch the boat into the sea."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151112> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152539> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Rocket Station"@en ;
    skos:scopeNote "A coastal site containing equipment that enabled a lifeline to be fired at stricken ships that were close to the coastline."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151114> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151650> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Railway"@en ;
    skos:scopeNote "System of rail tracks along which passenger carriages or goods wagons are moved, usually by locomotive engines. Usually includes beds, cuttings, embankments, tunnels etc."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151115> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151650> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Railway Station"@en ;
    skos:scopeNote "Where railway trains stop to load and unload passengers or freight. Includes buildings and directly related grounds."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151116> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151650> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Railyard"@en ;
    skos:scopeNote "Complex, often attached to a railway station where engines, coaches and wagons are laid up and maintained."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151117> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151113> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Motorway"@en ;
    skos:scopeNote "Large multiple carriageway for fast-moving motor traffic, continuing for long distances without traffic intersections and subject to legally specified 'motorway regulations'."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151118> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151113> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Trunk Road"@en ;
    skos:scopeNote "Large road, often multiple carriagewayed, linking significant places."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151120> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151651> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Car Park"@en ;
    skos:scopeNote "Area for parking motor vehicles; usually with permanent surfacing, sometimes in purpose-built multi-storey buildings."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151122> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151444> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Lake"@en ;
    skos:scopeNote "An inland body of fresh water. Lakes generally refer to larger examples, ponds to smaller, but there is no clear break along the gradation between the two."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151123> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151443>,
        <http://purl.org/heritagedata/schemes/571/concepts/151444> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Lagoon"@en ;
    skos:scopeNote "A body of shallow salt, brackish or fresh water totally or partially enclosed from the sea by a sand bar, spit or reef running across the entrance."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151124> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151444> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Pond"@en ;
    skos:scopeNote "An inland body of fresh water. Ponds generally refer to smaller examples, lakes to larger, but there is no clear break along the gradation between the two. Ponds are often artificial and made for a specific purpose."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151125> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151444> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Mere"@en ;
    skos:scopeNote "A shallow lake that is broad in relation to its depth"@en .

<http://purl.org/heritagedata/schemes/571/concepts/151126> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151443> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Creek"@en ;
    skos:scopeNote "A small inlet on a sea coast or estuary, its sediments often exposed at low tide. Sometimes applied to a river tributary or stream."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151128> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/152591> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Submerged Forest"@en ;
    skos:scopeNote "Tracts of submerged land retaining macrofossil evidence, often in situ, for former woodland and other woody vegetation cover."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151134> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151250>,
        <http://purl.org/heritagedata/schemes/571/concepts/151273> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Carr"@en ;
    skos:scopeNote "An area of fenland that has become overgrown with trees or shrubs. Normally the result of natural succession, and thus regarded as a form of ancient woodland."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151138> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151734> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Salt Works"@en ;
    skos:scopeNote "A site, building or factory used for the production of salt."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151139> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151642> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Naval Dockyard"@en ;
    skos:scopeNote "A naval base that builds, repairs, docks or converts warships and is manned by civilian engineers and workers and administered by engineer duty officers."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151140> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151451> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Orchard"@en ;
    skos:scopeNote "An enclosed area of land or garden for the growing of fruit-bearing trees."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151141> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151451> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Vineyard"@en ;
    skos:scopeNote "An area of land and associated buildings where grapevines are cultivated."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151143> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151142> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Formal Garden"@en ;
    skos:scopeNote "A garden of regular, linear or geometrical design, often associated with the traditional Italian, French and Dutch styles. Usually either adjacent to the house or within the pleasure grounds."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151144> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/160197> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Arboretum"@en ;
    skos:scopeNote "A botanical garden, as an element of a designed or ornamental landscape, designed specifically for the cultivation and display of, often rare, trees."@en .

<http://purl.org/heritagedata/schemes/571/concepts/151145> a skos:Concept ;
    skos:broader <http://purl.org/heritagedata/schemes/571/concepts/151667> ;
    skos:inScheme <http://purl.org/heritagedata/schemes/571> ;
    skos:prefLabel "Marina"@en ;
