	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/502128">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/502128</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BARRAID GÀRRAIDH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Raon rèidh ann an gàrradh. Bidh seo na raon togte gu math tric a ruigear air staidhre.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GARDEN TERRACE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-15T08:47:47</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-05-15T08:48:42</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/552" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/106" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/108" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500669" />
		<skos:scopeNote xml:lang="en">A flat, level area of ground within a garden. Often raised and accessed by steps.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
