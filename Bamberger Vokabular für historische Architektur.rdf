    <!-- https://hist-arch-vocab.org/bvha#c_0e8d8cf2 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_0e8d8cf2">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_3da3c0b4"/>
