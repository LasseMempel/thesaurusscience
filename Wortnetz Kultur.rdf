	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk003851">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="es">sienita</skos:prefLabel>
		<skos:prefLabel xml:lang="it">sienite</skos:prefLabel>
		<skos:prefLabel xml:lang="de">Syenit</skos:prefLabel>
		<skos:prefLabel xml:lang="en">syenite</skos:prefLabel>
		<skos:prefLabel xml:lang="fr">syénite</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003849"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019456"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk003849"/>
		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk003856"/>
		<xe:explanation_temp xml:lang="de">Er ist dem Granit sehr ähnlich, enthält aber weniger Quarz.</xe:explanation_temp>
		<skos:definition xml:lang="de">Ein Syenit ist ein Tiefengestein, der in verschiedenen Färbungen, häufig rötlich und feinkörnig bis grobkörnig, auftritt.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003849"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019456"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>closed</xe:processingState>
		<dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-03-28T11:15:50+01:00+01:00</dcterms:modified>
	</skos:Concept>
	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk003852">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Diorit</skos:prefLabel>
		<skos:prefLabel xml:lang="es">diorita</skos:prefLabel>
		<skos:prefLabel xml:lang="en">diorite</skos:prefLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk003849"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk019456"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk003849"/>
		<skos:definition xml:lang="de">Ein Diorit ist ein Tiefengestein, das eine dunkle, grüne bis schwarze Färbung aufweist und hauptsächlich aus dem Mineral Feldspat besteht.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk003849"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk019456"/>
