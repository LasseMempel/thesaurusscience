        <skos:altLabel xml:lang="de">Fialhelm</skos:altLabel>
        <skos:altLabel xml:lang="de">Helm</skos:altLabel>
        <skos:altLabel xml:lang="de">Ryse</skos:altLabel>
        <skos:altLabel xml:lang="en">fortified church</skos:altLabel>
        <skos:altLabel xml:lang="cs">helmice</skos:altLabel>
        <skos:altLabel xml:lang="cs">jehlan fiály</skos:altLabel>
        <skos:altLabel xml:lang="cs">jehlanec</skos:altLabel>
        <skos:definition xml:lang="de">Riese, mhdt. \&apos;Ryse\&apos;, pyramidenförmiger, krabbenbesetzter und in einer Kreuzblume endender Helm einer Fiale. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Ryse, Helm der Fiale. [Koch 2009]</skos:definition>
        <skos:prefLabel xml:lang="fr"> pyramidon</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Riese</skos:prefLabel>
        <skos:prefLabel xml:lang="it">gigante</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">hrot (fiála)</skos:prefLabel>
        <skos:prefLabel xml:lang="es">piramidión</skos:prefLabel>
    </owl:NamedIndividual>
    


