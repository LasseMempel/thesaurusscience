        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-04T17:18:21.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-24T17:53:28.000</terms:modified>
        <skos:altLabel xml:lang="de">Fanone</skos:altLabel>
        <skos:altLabel xml:lang="fr">fanon</skos:altLabel>
        <skos:altLabel xml:lang="la">favo</skos:altLabel>
        <skos:altLabel xml:lang="la">orale</skos:altLabel>
        <skos:definition xml:lang="de">Fano m, Fanone m: aus weißer Seide gefertigtes Schultergewand des Papstes; es ist kreisförmig geschnitten, mit roten und goldenen, parallel verlaufenden Zierstreifen besetzt und auf dem vorderen Teil mit einem goldenen Kreuz bestickt. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Fano</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">fanon</skos:prefLabel>
        <skos:prefLabel xml:lang="en">fanon</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">fanon papale</skos:prefLabel>
        <skos:prefLabel xml:lang="la">fanum</skos:prefLabel>
    </owl:NamedIndividual>
    


