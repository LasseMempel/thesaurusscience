	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/325">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/325</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">DÙN RUBHA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Lann dhìonach far an deach co-dhiù aon sreath de rampairean a thogail tarsainn air caol rubha mar ghleus dìonach no gus smachd a chumail air inntrigeadh do rubha no rinn, an dà chuid am broinn no dùthcha no air a' chladach. Cleachd airson làraichean ro-eachdraidheil agus tràth-eachdraidheil.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PROMONTORY FORT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-07-16T14:06:09</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/320" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1525" />
		<skos:scopeNote xml:lang="en">A defensive enclosure created by constructing one or more lines of ramparts across a neck of land, in order to defend, or restrict access to, a spur or promontory, either inland or on the coast. Use for prehistoric and early historic sites.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/327">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/327</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">DÙNAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Daingean beag arm na Ròimhe, mar is trice na ghearastan-blàir do 80 saighdear no nas lugha dhiubh, ga dhìon le aon rampair is dìg agus le àitichean-fuirich airson feachd is oifigearan, còmhla ri stòrasan is togalaichean eile.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">FORTLET</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-08-21T09:42:01</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502553" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500482" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/266" />
		<skos:scopeNote xml:lang="en">A small Roman military installation, generally built as an outpost for 80 soldiers or fewer, usually defended by a single rampart and ditch, and containing accommodation for troops and officers, together with stores and ancillary buildings.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/328">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/328</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">DAINGNEACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach no structar a chaidh a chleachdadh airson àite a dhìon mar is trice. Cleachd GEARASTAN airson làraichean ro-eachdraidheil agus tràth-eachdraidheil.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">FORTIFICATION</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-07-16T13:59:21</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">EARTHWORK FORTIFICATION</skos:altLabel>
		<skos:altLabel xml:lang="en">CROMWELLIAN FORT</skos:altLabel>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/330" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/334" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/338" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/278" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/329" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/331" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/332" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/333" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/337" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/339" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/340">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/340</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">DORAS-IONNSAIGH</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Bealach beag a chaidh a ghearradh tro aghaidh-thogalaich chùirtearach no na tùir ri taobh. Chaidh seo a chleachdadh mar is trice mar doras a-mach gus ionnsaigh a thoirt air nàmhaid.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">SALLYPORT</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/328" />
				<skos:scopeNote xml:lang="en">A small gateway cut through a curtain wall or its flanking towers. Used primarily as an outlet for counter-attacking forces.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502131" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/287" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/295" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/296" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/346" />
		<skos:scopeNote xml:lang="en">A work or installation with a primarily defensive purpose. Use FORT for prehistoric and early historic sites.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/329">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/329</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">DAINGNEACH GHUNNACHAN MÒRA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Structar daingnichte aig a bheil àitichean a chaidh a thogail gu sònraichte do ghunnaichean-mòra.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">ARTILLERY FORTIFICATION</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">HANOVERIAN FORT</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/328" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/289" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/337" />
		<skos:scopeNote xml:lang="en">A fortified structure containing purpose built emplacements for artillery pieces.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/330">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/330</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">GÀRRADH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Cùirt-lios caisteil, 's e sin an t-àite mun a tha an rampair no aghaidh-thogalaich chùirtearach. Cleachd seòrsa de làrach nas fharsainge ma tha fhios dè.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BAILEY</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/328" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/297" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/298" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/299" />
		<skos:scopeNote xml:lang="en">The courtyard of a castle, i.e. the area enclosed by the rampart or curtain wall. Use with wider site type where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/331">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/331</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BARBACAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Balla, balla-ùir, baisteon no fo-dhìdean no measgachadh dhiubh, mar is trice le dìg no staing.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BARBICAN</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/328" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1451" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/399" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/502131" />
		<skos:scopeNote xml:lang="en">Any earthworks, walling, bastion or fortified outwork, or combination of these, generally with ditch or moat.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/332">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/332</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BÀBHAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Lann dhìonach às na meadhan-aoisean, mar is trice co-cheangailte ri taigh-tùir.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BARMKIN</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/328" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/343" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/344" />
		<skos:scopeNote xml:lang="en">A medieval  defensive enclosure, usually attached to a tower house.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/333">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/333</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">SGIATH-BHALLA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Tùr cliathaich no sròn cliathaich a stobas a-mach o phrìomh bhalla-dìon. Bhiodh gearastan a' dìon na talmhainn air a bheulaibh no air a chliathaich uaithe seo.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BASTION</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/328" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/399" />
		<skos:scopeNote xml:lang="en">A flanking tower or projection from the main walls of a defensive work, from which a garrison can defend the ground in front or on the flank.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/334">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/334</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH-FAIRE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Gearastan dealaichte a tha a' dìon puing ro-innleachdach.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BLOCKHOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/328" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/335">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/335</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">BUNCAIR</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Structar a chaidh a thogail (fon talamh gu tric) airson àite a dhìon agus mar ionad co-òrdanachadh an airm.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">BUNKER</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-04-20T11:42:51</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/334" />
				<skos:scopeNote xml:lang="en">A structure, often built underground, used for defence and co-ordination of military activity.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/336" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/337" />
		<skos:scopeNote xml:lang="en">A detached fort covering a strategic point.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/336">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/336</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">FASGADH FO-THALAMH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach crùbanach mar is trice aig a bheil ballachan tiugha le torain ann agus mullach rèidh, air a dhealbhadh airson diofar buill-airm agus gu tric ann an àite far an dìon e puing chugallach ann an siostam dìon.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PILLBOX</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/334" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/313" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/337" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/403" />
		<skos:scopeNote xml:lang="en">An often squat building with thick, loopholed walls and a flat roof, designed to accommodate a variety of weapons, usually strategically positioned to cover a vulnerable point in a defensive system.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/337">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/337</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">IONAD-GUNNA</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Làrach dhaingnichte far an deach gunna, moirtear no canan a shuidheachadh.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">GUN EMPLACEMENT</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">MACHINE GUN EMPLACEMENT</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/328" />
		<skos:narrower>
			<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/500839">
				<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
				<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/500839</dcterms:identifier>
				<skos:prefLabel xml:lang="gd">IONAD BEAIRT-GHUNNA</skos:prefLabel>
				<skos:scopeNote xml:lang="gd">Structar fosgailte le ballachan concrait, bhreigean no bhagaichean-gainmhich a bha mun cuairt air co-dhiù aon bheairt-ghunna air leinnteil mar dhìon aotram talmhainn is an aghaidh phlèanaichean.</skos:scopeNote>
				<skos:prefLabel xml:lang="en">MACHINE GUN POST</skos:prefLabel>
				<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-11-17T15:29:30</dcterms:created>
				<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-04-20T11:44:35</dcterms:modified>
				<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
				<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/337" />
				<skos:scopeNote xml:lang="en">An open walled structure built of concrete, brick or sandbags which enclosed one or more machine-guns mounted on lintels for light anti-aircraft and ground defence.</skos:scopeNote>
				<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
				<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
				<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
				<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
			</skos:Concept>
		</skos:narrower>
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/329" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/334" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/336" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/397" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/509046" />
		<skos:scopeNote xml:lang="en">A fortified site in which a gun, mortar or cannon is positioned.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/338">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/338</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BALLA THORAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Balla no pìos balla sa bheil tuill a thilgear saighdean, urchraichean no airm eile tromhpa.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">LOOPHOLED WALL</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/328" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1454" />
		<skos:scopeNote xml:lang="en">A wall or section of wall with apertures designed for the firing of weapons.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/339">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/339</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">RAMPAIR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Uchdan ùir a chaidh a thogail mun cuairt air àite gus a dhìon.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">RAMPART</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/328" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1467" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/394" />
		<skos:scopeNote xml:lang="en">An earth embankment built around a site for defensive purposes.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/341">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/341</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH DAINGNICHTE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Taigh a chaidh a dhaingneachadh gu follaiseach. Tha baidealan creanaileach agus uinneagan glè chaol aca gu tric.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">FORTIFIED HOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/422" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/342" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/343" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/344" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/278" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500569" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/295" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/439" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/490" />
		<skos:scopeNote xml:lang="en">A house which bears signs of fortification. These often include crenellated battlements and narrow slit-like windows.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/342">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/342</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">BAISTEAL</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Taigh daingnichte dà no trì-ùrlarach leis an ùrlar ìochdarach na stòras no/agus airson nam beathaichean agus na h-ùrlaran uachdarach airson fuireach ann.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">BASTLE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">BASTLE HOUSE</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/341" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/26" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/343" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/344" />
		<skos:scopeNote xml:lang="en">A fortified house of two or three storeys, the lower floor being used for storage and/or to house animals and the upper floors for domestic use.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/343">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/343</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TÙR-SMÙDAIN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Taigh-còmhnaidh làidir is daingnichte ach as aonais chreanailean, eadar dà is ceithir ùrlaran. Chaidh an togail eadar meadhan na 14mh linn agus an 17mh linn gu sònraichte.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">PELE HOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/341" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/332" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/342" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/344" />
		<skos:scopeNote xml:lang="en">An uncrenellated, strong, fortified dwelling, of between two and four storeys, built mainly from the mid 14th to the 17th century.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/344">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/344</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TAIGH-TÙIR</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite-còmhnaidh daingnichte san robhar a' fuireach gu buan 's a chaidh a thogail eadar meadhan na 14mh suas gun 17mh linn. Tha plana ùrlar lìneach aig taighean-tùir, gu tric le co-dhiù aon sgiath agus le àitichean-fuireach air iomadh ùrlar.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">TOWER HOUSE</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/341" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/332" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/342" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/343" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/424" />
		<skos:scopeNote xml:lang="en">A permanently occupied, fortified residence, built from the mid-14th to the 17th century. Tower-houses are rectilinear in plan, often with one or more additional wings, and provide accommodation on several storeys.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/345">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/345</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">EILEAN DAINGNICHTE</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Eilean nàdarra no leth-nàdarra far a bheil lorg balla dìonach mun cuairt air. Cleachd briathran nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">FORTIFIED ISLAND</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-10-30T14:50:21</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/278" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/462" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500706" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/508" />
		<skos:scopeNote xml:lang="en">An island, natural or partly artificial, with evidence for a defensive perimeter wall. Use more specific terms where possible.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/346">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/346</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">GEARASTAN</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Àite daingnichte cudromach, gu math tric na bhaile, le rùm gu leòr airson feachd mòr. Mas e fear leis na Ròmanaich a tha ann, cleachd GEARASTAN LÈIGIONACH.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">FORTRESS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/347" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/278" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/328" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/399" />
		<skos:scopeNote xml:lang="en">A major fortified place, often a town, capable of containing a large force. If Roman use LEGIONARY FORTRESS.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/347">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/347</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">GEARASTAN LÈIGIONACH</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Bunait mhòr bhuan dhaingnichte an airm a chaidh a thogail airson lèigiun Ròmanach, mar is trice le ramapair is dìg ga dhìon.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">LEGIONARY FORTRESS</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-08-21T10:25:37</dcterms:modified>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/346" />
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500482" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/2322" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/265" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/266" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/364" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/398" />
		<skos:scopeNote xml:lang="en">A large, fortified permanent military base built to house a Roman legion, generally defended by at least one rampart and ditch.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
		<cc:attributionName xml:lang="en">Historic Environment Scotland</cc:attributionName>
		<dcterms:publisher rdf:resource="https://www.historicenvironment.scot/" />
	</skos:Concept>
	<skos:Concept rdf:about="http://purl.org/heritagedata/schemes/1/concepts/349">
		<skos:inScheme rdf:resource="http://purl.org/heritagedata/schemes/1" />
		<dcterms:identifier>http://purl.org/heritagedata/schemes/1/concepts/349</dcterms:identifier>
		<skos:prefLabel xml:lang="gd">TOGALACH AIRM</skos:prefLabel>
		<skos:scopeNote xml:lang="gd">Togalach air làrach airm ach gun fhios dè air a shon a bha e. Cleachd briathar nas mionaidiche ma tha fios air.</skos:scopeNote>
		<skos:prefLabel xml:lang="en">MILITARY BUILDING</skos:prefLabel>
		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2006-07-03T14:26:54</dcterms:created>
		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/278" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/350" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/184" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/353" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/500609" />
		<skos:narrower rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/503860" />
		<skos:scopeNote xml:lang="en">A building of unknown purpose found at a military site. Use more specific type where known.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
		<cc:attributionURL rdf:resource="https://canmore.org.uk/thesaurus" />
