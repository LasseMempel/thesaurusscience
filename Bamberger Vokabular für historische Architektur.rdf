        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_5f9f59a5"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-22T14:43:23.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T19:22:44.000</terms:modified>
        <skos:altLabel xml:lang="de">Blindrahmen (Tür)</skos:altLabel>
        <skos:definition xml:lang="de">Bauart eines Fensterrahmens und Türrahmens. Wird dem Baukörper vorgeblendet und dient der Befestigung der Fensterflügel oder des Türblatts. Seine Rahmenhölzer besitzen einen liegendrechteckigen Querschnitt. Der Blendrahmen wird nicht wie der Blockrahmen oder der Zargenrahmen in die Wandöffnung hineingeschoben, sondern außen, seltener innen der Gebäudewand vorgeblendet oder in einen entsprechenden Falz montiert. Sein Vorteil ist, dass die gesamte lichte Breite und Höhe der Wandöffnung genutzt werden kann. [Schrader / Voigt 2003]</skos:definition>
        <skos:prefLabel xml:lang="de">Blendrahmen (Tür)</skos:prefLabel>
        <broaderByConstruction rdf:resource="https://hist-arch-vocab.org/bvha#c_13411016"/>
    </owl:NamedIndividual>
    


