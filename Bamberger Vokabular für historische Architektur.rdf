    <!-- https://hist-arch-vocab.org/bvha#c_d583a72a -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_d583a72a">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_ad800342"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-09T08:41:53.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:31:37.000</terms:modified>
        <skos:definition xml:lang="de">Gezimmerte Pseudokuppel, die den Eindruck einer echten, mit Keilsteinen gewölbten Kuppel erwecken soll. Beispiel: Die stuckierte und bemalte HauptkuppeI der Wallfahrtskirche Wies/ Oberbayern, 1746. (Glossarium Artis)</skos:definition>
        <skos:prefLabel xml:lang="de">Holzkuppel </skos:prefLabel>
        <skos:prefLabel xml:lang="fr">coupole en bois</skos:prefLabel>
        <skos:prefLabel xml:lang="en">wooden dome</skos:prefLabel>
        <broaderByConstructionMaterial rdf:resource="https://hist-arch-vocab.org/bvha#c_ad800342"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_d594d5fa -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_d594d5fa">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_36fea3c7"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_3619710b"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_d91b6895"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-18T21:16:16.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T13:24:20.000</terms:modified>
        <skos:altLabel xml:lang="de">Propyläen</skos:altLabel>
        <skos:altLabel xml:lang="cs">propylaje</skos:altLabel>
        <skos:definition xml:lang="de">Propylon (gr.), Propyläen, Torbau eines meist von hohen Mauern umschlossenen gr. Tempelbezirks. Das P. hat meist eine oder mehrere Türen, eine größere äußere und eine kleinere innere Vorhalle. Ähnl. Formen wurden in der Renaissance und bes. im Klassizismus aufgegriffen. Bei frühchristl. Basiliken wird auch der Anteportikus P., bei antiken Chalcidikum genannt. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Propyläen, Propylon (griech. propylaion = Vortor), Torbau vor einem abgeschlossenen griechischen Tempelbezirk (Temenos). Am bekanntesten die Propyläen der Akropolis, der »Götterburg« von Athen. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="cs">Též propylaje, řec. rropylaion = před branou, budova brány před uzavřeným řeckým chrámovým okrskem (temenos), nejznámější propyleje jsou na Akropoli v Aténách. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Propylon</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">propyleje</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_36fea3c7"/>
    </owl:NamedIndividual>
    


