        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T14:10:04.000</terms:modified>
        <skos:altLabel xml:lang="fr">sonnerie</skos:altLabel>
        <skos:definition xml:lang="de">Glockenwerk n: die Gesamtheit der Glocken einer Kirche, eines Klosters etc. Jede Kirche sollte nach der Kirchenordnung wenigstens über drei Glocken verfügen. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Glockenwerk</skos:prefLabel>
        <skos:prefLabel xml:lang="en">bells</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_46e470d7 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_46e470d7">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_6bbfbe49"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_50ec0c5e"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_c8a571d9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-19T10:17:10.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T13:07:01.000</terms:modified>
        <skos:altLabel xml:lang="cs">ruina</skos:altLabel>
        <skos:definition xml:lang="de">Bauwerk im Zustand des Verfalls. In früheren Epochen wurden R.n als Steinbrüche ausgebeutet oder aber für neue Zwecke (meist Wohnbauten) adaptiert. Seit dem Spätbarock wurden in den Parkanlagen künstl. R.n errichtet und in der Zeit der Romantik setzte eine sentimentale R.nbegeisterung ein. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Ruine</skos:prefLabel>
        <skos:prefLabel xml:lang="it">rovina</skos:prefLabel>
        <skos:prefLabel xml:lang="en">ruin</skos:prefLabel>
        <skos:prefLabel xml:lang="es">ruina</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">ruine</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">zřícenina</skos:prefLabel>
    </owl:NamedIndividual>
    


