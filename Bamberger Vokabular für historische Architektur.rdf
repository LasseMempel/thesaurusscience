        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-22T15:51:07.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-23T16:39:30.000</terms:modified>
        <skos:altLabel xml:lang="de">Plenar</skos:altLabel>
        <skos:altLabel xml:lang="fr">lectionnaire plénier</skos:altLabel>
        <skos:altLabel xml:lang="fr">missel plénier</skos:altLabel>
        <skos:definition xml:lang="de">Plenarium n, Plenar n, liber plenarius: mittelalterliche Bezeichnung für ein Buch, namentlich ein liturgisches Buch, in dem vorher getrennt auftretende Texte zusammengefaßt sind, z. B. das Missale und das Lektionar; im späten Mittelalter Bezeichnung für eine Sammlung liturgischer Texte (Episteln und Evangelien), die aus dem Missale ins Deutsche übersetzt waren. [Glossarium Artis]</skos:definition>
        <skos:prefLabel xml:lang="de">Plenarium</skos:prefLabel>
        <skos:prefLabel xml:lang="la">liber plenarius</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">livre plénier</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">plenář</skos:prefLabel>
    </owl:NamedIndividual>
    


