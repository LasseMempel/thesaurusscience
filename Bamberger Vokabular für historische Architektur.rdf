        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-18T18:04:33.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T12:11:01.000</terms:modified>
        <skos:prefLabel xml:lang="de">Chorbestandteil</skos:prefLabel>
        <skos:scopeNote xml:lang="de">Ein mit dem Chor durch offene Bogenstellungen verbundener Umgang. Seit der Romanik vorkommend. An den Chorumgang angeschlossen sind oft als halbrunder Kapellenkranz angeordnete Chorkapellen. </skos:scopeNote>
    </owl:NamedIndividual>
    


