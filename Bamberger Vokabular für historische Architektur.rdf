    <!-- https://hist-arch-vocab.org/bvha#c_8d662389 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_8d662389">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_1192c84c"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_f10222e0"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_6193f765"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_95302611"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-15T09:27:15.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-18T14:06:00.000</terms:modified>
        <skos:altLabel xml:lang="en">  to char</skos:altLabel>
        <skos:altLabel xml:lang="fr">charruer</skos:altLabel>
        <skos:definition xml:lang="de">Oberflächenbehandlung der Steine mit einem Scharriereisen, wodurch schmale, parallele Rillen entstehen. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Vor dem abschließenden Scharrieren wird die Oberfläche mit der Glattfläche abgearbeitet, wobei die Hiebe durchaus noch recht grob ausgeführt sein können und etwa 90° zur späteren Scharrierung liegen sollten. Das Scharrieren kann sowohl an horizontal als auch an schräg liegenden Oberflächen durchgeführt werden. Das Eisen wird in einem Winkel von etwa 60° zur Außenkante angesetzt und in Bahnen parallel zum Randschlag vorwärts geführt. Der Anstellwinkel der Schneide ist abhängig vom Gewicht und von der Schlagstärke des Knüpfels sowie der Materialhärte, wird aber so gewählt, dass das Eisen das anstehende Material durch den Schlag »schneidet«, wodurch die typisch weiche Form entsteht. [Voelkle 2016]</skos:definition>
        <skos:prefLabel xml:lang="de"> Scharrieren</skos:prefLabel>
        <skos:prefLabel xml:lang="es">cincelar</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">ciseler</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">rýhovat</skos:prefLabel>
        <skos:prefLabel xml:lang="it">scalpellare sca nalature parallele</skos:prefLabel>
        <skos:prefLabel xml:lang="en">to drove</skos:prefLabel>
    </owl:NamedIndividual>
    


