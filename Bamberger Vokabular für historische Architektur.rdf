        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-22T19:10:59.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T14:41:22.000</terms:modified>
        <skos:altLabel xml:lang="de">Basquille</skos:altLabel>
        <skos:definition xml:lang="de">Schubstangenverschluss bestehend aus zwei meist quadratischen Riegelstangen, die durch Drehung eines Griffes (Olive) nach oben und unten gegenläufig bewegt werden. Die Stangenenden greifen dabei in Kloben, die am Kämpfer bzw. am unteren und oberen Blendrahmen befestigt sind. [Pax - Fenster &amp; Türen Fachbegriffe]</skos:definition>
        <skos:prefLabel xml:lang="de">Basküle</skos:prefLabel>
    </owl:NamedIndividual>
    


