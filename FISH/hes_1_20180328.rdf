		<dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-28T11:55:34</dcterms:issued>
		<skos:altLabel xml:lang="en">ORATORY</skos:altLabel>
		<skos:broader rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/1742" />
		<skos:related rdf:resource="http://purl.org/heritagedata/schemes/1/concepts/503166" />
		<skos:scopeNote xml:lang="en">A small private chapel in a church or house, either attached or in a separate building.</skos:scopeNote>
		<cc:license rdf:resource="http://reference.data.gov.uk/id/open-government-licence" />
