    <!-- https://hist-arch-vocab.org/bvha#c_b58f9cbc -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b58f9cbc">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_61354695"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_ed43f447"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_315cf028"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_34ca6582"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-13T14:38:06.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T16:35:33.000</terms:modified>
        <skos:altLabel xml:lang="de">Abschälen</skos:altLabel>
        <skos:altLabel xml:lang="fr">ecaillage</skos:altLabel>
        <skos:altLabel xml:lang="en">peeling off</skos:altLabel>
        <skos:altLabel xml:lang="cs">sloupávání</skos:altLabel>
        <skos:definition xml:lang="de">Absondern, Abfallen oder teilweise Ablösung einer oberflächlichen Schicht (Schichtdicke weniger als ein Millimeter oder im Millimeterbereich), welche das Aussehen eines Films oder Überzugs hat, der auf die Oberfläche aufgebracht wurde. [ICOMOS-ISCS] </skos:definition>
        <skos:definition xml:lang="fr">Décollement partiel ou total d’une fine couche(épaisseur inframillimétrique à millimétrique) ayantl’aspect d’un film ou d’un revêtement appliqué sur lapierre. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="cs">Odlupování, nebo částečné odtrhávání povrchovévrstvy kamene (mocnost: submilimetry až milimetry),mající vzhled povlaku nebo nátěru aplikovanéhona jeho povrch. [ICOMOS-ISCS] </skos:definition>
        <skos:definition xml:lang="de">Partielle Ablösung einer Oberfläche, was häufig so aussieht, als wenn sich eine Beschichtung von der Oberfläche abschälen würde. [EwaGlos] </skos:definition>
        <skos:definition xml:lang="en">Shedding, coming off, or partial detachment of asuperficial layer (thickness : submillimetric to millimetric)having the aspect of a film or coating whichhas been applied on the stone surface. [ICOMOS-ISCS]</skos:definition>
        <skos:definition xml:lang="en">The partial detachment of a superficial layer which often looks like a detached coating that has been applied to its surface. [EwaGlos]</skos:definition>
        <skos:prefLabel xml:lang="de">Schollenbildung</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">odlupování</skos:prefLabel>
        <skos:prefLabel xml:lang="en">peeling</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">pelage</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_b595c2f9 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b595c2f9">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_c14ab9ce"/>
