        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-12T15:40:49.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T12:50:56.000</terms:modified>
        <skos:altLabel xml:lang="en">vault formed of curved beams </skos:altLabel>
        <skos:altLabel xml:lang="fr">voûte en linteaux échancrés</skos:altLabel>
        <skos:altLabel xml:lang="fr">voûte en poutres courbes</skos:altLabel>
        <skos:definition xml:lang="de">Falsches Gewölbe, das von bogenförmigen oder geraden, gegeneinander gestemmten Stützbalken aus Stein gebildet wird. [Glossarium Artis]</skos:definition>
