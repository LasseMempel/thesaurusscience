    skos:definition "Any north temperate fagaceous tree of the genus Castanea, such as Castanea sativa, which produce flowers in long catkins and nuts in a prickly bur."@en ;
    skos:exactMatch <http://eurovoc.europa.eu/1116> ;
    skos:inScheme <http://www.eionet.europa.eu/gemet/gemetThesaurus> ;
