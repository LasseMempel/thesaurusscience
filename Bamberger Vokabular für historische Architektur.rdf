    <!-- https://hist-arch-vocab.org/bvha#c_1e9ecd96 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_1e9ecd96">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_8b190e59"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-19T13:03:34.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-27T14:27:24.000</terms:modified>
        <skos:altLabel xml:lang="en">cable construction</skos:altLabel>
        <skos:definition xml:lang="de">Seilnetzkonstruktion, Seiltragwerk; ein aus Zugelementen bestehendes, hängendes Tragwerk ohne Biegespannungen und dadurch geringerer Materialaufwand als bei einer Schalenkonstruktion. Die über Pylone (2) geführten Seilzüge müssen in Widerlagern im Erdreich oder Fundament verankert werden. Älteste Konstruktionen sind die Hängebrücken aus Lianen in tropischen Gebieten und die Sonnensegel in röm. Amphitheatern. Die Erfindung des Flussstahls 1883 ermöglichte große, an Kabeln aufgehängte Brücken. In den 1950er Jahren wurden freischwebende Hängedächer auf der Grundlage von Seilnetzen entwickelt, die mit Holz-, Metall- oder Kunststoffplatten als Dachhaut belegt werden. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Seilkonstruktion</skos:prefLabel>
        <skos:prefLabel xml:lang="es">construcción en malla de cables</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">construction à câbles</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">lanová konstrukce</skos:prefLabel>
        <skos:prefLabel xml:lang="en">rope construction</skos:prefLabel>
        <skos:prefLabel xml:lang="it">tensostruttura</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_1e9fe67d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_1e9fe67d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_c7fb1aeb"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-15T16:40:58.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-12T17:53:20.000</terms:modified>
        <skos:altLabel xml:lang="en"> entresol</skos:altLabel>
        <skos:altLabel xml:lang="fr"> entresol</skos:altLabel>
        <skos:altLabel xml:lang="it"> piano ammezzato</skos:altLabel>
        <skos:altLabel xml:lang="de">Mezzaningeschoss</skos:altLabel>
        <skos:altLabel xml:lang="cs">mezipatro</skos:altLabel>
        <skos:altLabel xml:lang="cs">polopatro</skos:altLabel>
        <skos:definition xml:lang="de">Mezzanin (ital.), -geschoss, ein niedriges Halb- oder Zwischengeschoss unterm Dach oder überm Erdgeschoss. Renaissance, Barock, Klassizismus. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">Mezzanin n (ital. mezzo ›halb‹), Halbgeschoss, dessen Deckenhöhe deutlich geringer ist als die der Hauptgeschosse. Es nimmt untergeordnete Räume, vor allem die der Dienerschaft, auf. Im Gegensatz zum oberhalb des Hauptgesimses liegenden Attikageschoss wird das M. meist über dem Erdgeschoss eingefügt. Nur in wenigen Fällen (Würzburg Residenz BY) wird jedem Geschoss ein M. zugeordnet. B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:prefLabel xml:lang="en"> mezzanine</skos:prefLabel>
        <skos:prefLabel xml:lang="fr"> mezzanine</skos:prefLabel>
        <skos:prefLabel xml:lang="it"> mezzanino</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Mezzanin</skos:prefLabel>
        <skos:prefLabel xml:lang="es">entrepiso</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">mezanin</skos:prefLabel>
        <broaderByShape rdf:resource="https://hist-arch-vocab.org/bvha#c_c7fb1aeb"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_1ea9614d -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_1ea9614d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_3b32f219"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-16T16:01:13.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-19T13:28:22.000</terms:modified>
        <skos:altLabel xml:lang="cs">dolní pás</skos:altLabel>
        <skos:altLabel xml:lang="cs">klenební pás vystupující z líce klenby</skos:altLabel>
        <skos:altLabel xml:lang="cs">spodní pás</skos:altLabel>
        <skos:definition xml:lang="de">Gurtbogen, der im Gegensatz zum Obergurt an der Laibung eines Gewölbes vortritt. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Untergurt</skos:prefLabel>
        <skos:prefLabel xml:lang="it">arco intradossato di una volta</skos:prefLabel>
        <skos:prefLabel xml:lang="en">bottom boom</skos:prefLabel>
        <skos:prefLabel xml:lang="es">cabeza inferior</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">spodní pásnice</skos:prefLabel>
        <skos:scopeNote xml:lang="de">An der Gewölbelaibung sichtbarer Gurtbogen. [BHVA]</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_1eaaad47 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_1eaaad47">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_8npondzn"/>
