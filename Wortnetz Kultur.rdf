	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk017436">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Streichbaum (Textiltechnik)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Streichbäume (Textiltechnik)</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk018661"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk018661"/>
		<skos:definition xml:lang="de">Ein Streichbaum ist ein walzenförmiger Bestandteil des Webstuhls, der die Umlenkung der Kettfäden in die Webebene reguliert. Darüber hinaus gleicht der Streichbaum die Laufschwankungen des Kettbaumes aus, um eine gleichmäßige Gewebequalität zu erzielen.</skos:definition>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/4515264-0"/>
