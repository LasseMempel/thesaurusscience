		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk004269"/>
		<skos:definition xml:lang="de">Eine Torfgrube ist eine Abbaustelle, an der Torf gestochen wird.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk002436"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010315"/>
