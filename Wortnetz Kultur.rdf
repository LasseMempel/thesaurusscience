	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk018233">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="de">Luftschlange</skos:prefLabel>
		<skos:altLabel xml:lang="de">Luftschlangen</skos:altLabel>
		<skos:prefLabel xml:lang="en">paper streamer</skos:prefLabel>
		<skos:altLabel xml:lang="en">paper streamers</skos:altLabel>
		<skos:altLabel xml:lang="en">serpentine streamer</skos:altLabel>
		<skos:altLabel xml:lang="en">serpentine streamers</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk005829"/>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk012399"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013567"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk005829"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk012399"/>
		<skos:definition xml:lang="de">Eine Luftschlange ist eine Dekoration, die aus einem dünnen, bunt bedruckten Papierstreifen besteht, der zu einem Ring aufgerollt ist. Durch Blasen kann die Luftschlange entrollt werden und fliegt dann mit schlangenartigen Bewegungen durch die Luft oder kann aufgehängt werden. Luftschlangen werden bei fröhlichen Feierlichkeiten wie Partys, Silvesterfeiern und Karneval verwendet.</skos:definition>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/1053910436"/>
		<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q152859"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk013567"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk012399"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk005829"/>
		<xe:status>candidate</xe:status>
		<iso-thes:status>Proposed</iso-thes:status>
		<xe:processingState>in_progress</xe:processingState>
