    <!-- https://hist-arch-vocab.org/bvha#c_604a31da -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_604a31da">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
