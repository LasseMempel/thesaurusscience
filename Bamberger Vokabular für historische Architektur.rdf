    <!-- https://hist-arch-vocab.org/bvha#c_b85cf2f1 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_b85cf2f1">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_9c69c39b"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a41833c5"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-11T13:19:34.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T15:44:24.000</terms:modified>
        <skos:altLabel xml:lang="de">Steinanker</skos:altLabel>
        <skos:altLabel xml:lang="de">Zungenstein</skos:altLabel>
        <skos:definition xml:lang="de">Ankerstein zur Verbindung von Mauerteilen. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Bund, Wirtel; ein Stein, der eine Wandsäule konstruktiv mit der Mauer verbindet (Schaftring). [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Schwalbenschwanzförmiger oder gekröpfter Werkstein, der ineinandergreifend eine bes. feste Verbindung des Mauerwerks ergibt, daher hauptsächl. bei Vormauerungen, bei weit ausladenden Gesimsen, bei Widerlagern und Brückenpfeilern verwendet. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Ankerstein</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">kotva do zdi (úchytka)</skos:prefLabel>
        <skos:prefLabel xml:lang="es">piedra de anclaje</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">pierre d\&apos;ancrage</skos:prefLabel>
        <skos:prefLabel xml:lang="it">pietra di ancoraggio</skos:prefLabel>
        <broaderByFunction rdf:resource="https://hist-arch-vocab.org/bvha#c_9c69c39b"/>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_b85fa3c5 -->


