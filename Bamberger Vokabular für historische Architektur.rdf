        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T18:31:42.000</terms:modified>
        <skos:altLabel xml:lang="de">Ägyptischer Ziegel</skos:altLabel>
        <skos:definition xml:lang="de">Adobe (span.), ungebrannter, luftgetrockneter Backstein aus Lehm, in Spanien und Lateinamerika für den Hausbau verwendet. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Getrockneter, ungebrannter Lehmziegel, den man volkstümlich auch Ägyptischer Ziegel nannte. Gibt es in verschiedenen Formaten, etwa 230 bis 380 mm lang, 115 bis 190 mm breit und so bis 180 mm hoch. [Schrader / Voigt 2003]</skos:definition>
        <skos:prefLabel xml:lang="de">Adobeziegel</skos:prefLabel>
    </owl:NamedIndividual>
    


