    <!-- https://hist-arch-vocab.org/bvha#c_798f7d32 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_798f7d32">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a2e37af3"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_57be8ee8"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-06T18:48:36.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-15T18:08:41.000</terms:modified>
        <skos:note xml:lang="en">A colloidal system formed of tiny liquid or solid particles distributed uniformly through a gas, usually air. [EwaGlos]</skos:note>
        <skos:note xml:lang="de">Ein kolloidales System, das durch sehr kleine, flüssige oder feste Partikel gebildet wird, die gleichmäßig in Gas, üblicherweise Luft, verteilt sind. [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="de">Aerosole</skos:prefLabel>
        <skos:prefLabel xml:lang="en">aerosols</skos:prefLabel>
    </owl:NamedIndividual>
    


