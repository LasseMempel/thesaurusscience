    <!-- https://hist-arch-vocab.org/bvha#c_59332eac -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_59332eac">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_bfa40c59"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
