    <!-- https://hist-arch-vocab.org/bvha#c_de0d4536 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_de0d4536">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f4914836"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-21T14:10:56.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T12:05:26.000</terms:modified>
        <skos:definition xml:lang="de">Ein quadrat. oder rechteckiger Raum, der gegenüber dem Kirchensaal zumeist um Mauerdicke oder mehr eingezogen und entweder voll geöffnet oder mittels Mauerzungen abgeschnürt ist. Hinsichtl. seiner Funktion ist er ident. mit der Apsis. Er findet ihn vornehml. bei einfachen Saalkirchen, seltener bei großen Kirchen; später wählen häufig die Reformorden den R„  der auch von rechteckigen Nebenchören begleitet sein kann wie bei Zisterzienserkirchen. [Koepf/Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="fr"> chœur rectangulaire</skos:prefLabel>
        <skos:prefLabel xml:lang="it"> coro rettangolare</skos:prefLabel>
        <skos:prefLabel xml:lang="en"> rectangular choir</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Rechteckchor</skos:prefLabel>
        <skos:prefLabel xml:lang="es">coro rectangular</skos:prefLabel>
    </owl:NamedIndividual>
    


