    <!-- https://hist-arch-vocab.org/bvha#c_ffc8d015 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_ffc8d015">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_381f9e69"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1d7ba54b"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_fcbdaf2c"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-06T13:45:35.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-14T15:03:22.000</terms:modified>
        <skos:altLabel xml:lang="es">espiral</skos:altLabel>
        <skos:definition xml:lang="de">Spiral- oder Schneckenform, die häufig an Konsolen, Giebeln (V.-giebel) und Kapitellen (ion. Kapitell) vorkommt. [Koepf / Binding 2016]</skos:definition>
        <skos:definition xml:lang="de">Volute (lat. volutum = das Gerollte), schneckenförmig eingerolltes Bauglied. Merkmal des ionischen Kapitells und des römisch-korinthischen Konsolgesimses. In Renaissance und Barock zur Vermittlung zwischen senkrechten und waagerechten Bauteilen angewandt. [Koch 2009]</skos:definition>
        <skos:definition xml:lang="de">f (lat.), eingerolltes Ornament an Kapitell, Giebel und Konsole. Die V. ist Teil des Kapitells der ionischen und kompositen Säulenordnung, wird jedoch seit der Renaissance auch als selbständiges Ornament gebraucht. Besonders häufig findet sie sich an Ziergiebeln in der deutschen Baukunst des späten 16. und 17. Jhs. (Friedrichsbau im Schloss Heidelberg BW; Hämelschenburg bei Hameln NI). B. Sch.-W. [Wörterbuch der Burgen, Schlösser und Festungen]</skos:definition>
        <skos:definition xml:lang="cs">Římsko-korintské konzolové římsy; v renesanci a baroku se používala k přechodu mezi svislými a vodorovnými částmi stavby. [Koch 2008]</skos:definition>
        <skos:prefLabel xml:lang="de">Volute</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">voluta</skos:prefLabel>
        <skos:prefLabel xml:lang="es">voluta</skos:prefLabel>
        <skos:prefLabel xml:lang="it">voluta</skos:prefLabel>
        <skos:prefLabel xml:lang="en">volute</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">volute</skos:prefLabel>
    </owl:NamedIndividual>
    


