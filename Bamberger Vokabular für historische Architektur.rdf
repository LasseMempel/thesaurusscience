        <skos:altLabel xml:lang="fr">marteau de porte</skos:altLabel>
        <skos:altLabel xml:lang="it">picchiotto</skos:altLabel>
        <skos:definition xml:lang="de">Bewegl., oft ornamental ausgestalteter Beschlag, der zum Klopfen um Einlass diente. [Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Türklopfer</skos:prefLabel>
