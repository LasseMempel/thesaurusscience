		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk000964"/>
		<gvp:aat2801_conjuncted_with rdf:resource="http://lvr.vocnet.org/wnk/wk002030"/>
		<gvp:aat2801_conjuncted_with rdf:resource="http://lvr.vocnet.org/wnk/wk001232"/>
		<skos:definition xml:lang="de">Eine Bewässerungswiese ist eine Wiese, die durch das Aufstauen von Wasser aus einem Fließgewässer z.B. mithilfe von Bewässerungsgräben und Stauwehren gedüngt wird, wodurch eine Ertragssteigerung von Gras und Heu erzielt werden kann.</skos:definition>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk000964"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010295"/>
		<xe:superordinateSimple rdf:resource="http://lvr.vocnet.org/wnk/wk010552"/>
