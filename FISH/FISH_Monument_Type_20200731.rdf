  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91160">
    <skos:scopeNote xml:lang="en">A steam engine with a horizontal beam connecting the piston and crank.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/91245">
    <skos:scopeNote xml:lang="en">An ornamental grove, thicket or shrubbery pierced by walks.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/71517">
    <skos:scopeNote xml:lang="en">A hall built as a memorial to a particular person or event.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/heritagedata/schemes/eh_tmt2/concepts/70275">
