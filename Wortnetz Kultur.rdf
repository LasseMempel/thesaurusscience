		<skos:related rdf:resource="http://lvr.vocnet.org/wnk/wk000421"/>
		<skos:definition xml:lang="de">Der Allgemeinbegriff &amp;quot;Sichtachse&amp;quot; bezeichnet eine lineare oder korridorförmige Blickbeziehung zwischen Bauwerken, landschaftsprägenden Elementen oder markanten Punkten in der Landschaft. Eine Sichtachse kann auch gezielt angelegt sein.</skos:definition>
		<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300056351"/>
		<skos:closeMatch rdf:resource="http://d-nb.info/gnd/7623193-8"/>
