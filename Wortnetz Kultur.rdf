	<skos:Concept rdf:about="http://lvr.vocnet.org/wnk/wk005915">
		<skos:inScheme rdf:resource="http://lvr.vocnet.org/wnk"/>
		<skos:prefLabel xml:lang="en">beaker (drinking vessel)</skos:prefLabel>
		<skos:altLabel xml:lang="en">beakers (drinking vessels)</skos:altLabel>
		<skos:prefLabel xml:lang="de">Becher (Trinkgefäß)</skos:prefLabel>
		<skos:altLabel xml:lang="de">Trinkbecher</skos:altLabel>
		<skos:broader rdf:resource="http://lvr.vocnet.org/wnk/wk010221"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk012069"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk013716"/>
		<vocnet:isMemberOfConceptGroup rdf:resource="http://lvr.vocnet.org/wnk/wk017961"/>
		<iso-thes:broaderGeneric rdf:resource="http://lvr.vocnet.org/wnk/wk010221"/>
		<skos:definition xml:lang="de">Ein Becher ist ein Trinkgefäß mit zylindrischer, konischer oder bauchiger Form, normalerweise höher als der Mündungsdurchmesser breit ist. Er kann einen Fuß besitzen, aber keinen Stiel, auch Henkel treten auf, dann aber meist an Exemplaren ohne Fuß.</skos:definition>
		<skos:scopeNote xml:lang="de">Verwendet für das Trinkgefäß. Für andere Behälter, die die Form eines Bechers haben, benutze spezifischere Begriffe, etwa Eierbecher (wk012860), Würfelbecher, Messbecher (wk013364).</skos:scopeNote>
		<skos:broadMatch rdf:resource="http://d-nb.info/gnd/4144244-1"/>
