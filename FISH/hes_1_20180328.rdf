		<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-04-12T14:48:16</dcterms:created>
		<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-04-12T14:48:38</dcterms:modified>
