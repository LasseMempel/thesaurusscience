        <skos:altLabel xml:lang="en">rubble vault</skos:altLabel>
        <skos:altLabel xml:lang="fr">voûte en moellons bruts</skos:altLabel>
        <skos:altLabel xml:lang="fr">voûte en pierres de carrière </skos:altLabel>
        <skos:definition xml:lang="de">Ein falsches Gewölbe aus unbehauenen, in Mörtel gebetteten Steinen (Pläner = in Platten brechender Bruchstein). [Koepf/Binding 2016]</skos:definition>
