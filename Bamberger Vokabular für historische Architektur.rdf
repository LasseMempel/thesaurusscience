    <!-- https://hist-arch-vocab.org/bvha#c_0da8a3da -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_0da8a3da">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_a1b21914"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_jqmv6iaq"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_1f14b4dd"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_37522b74"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_8c0441f9"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ec8c77bf"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ef0a8695"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_5a138dc5"/>
        <skos:narrower rdf:resource="https://hist-arch-vocab.org/bvha#c_f66e21eb"/>
        <skos:related rdf:resource="https://hist-arch-vocab.org/bvha#c_pjvitn4h"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-15T09:05:54.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-30T15:07:55.000</terms:modified>
        <skos:altLabel xml:lang="la">opus coronarium</skos:altLabel>
        <skos:altLabel xml:lang="en">parget</skos:altLabel>
        <skos:altLabel xml:lang="cs">tenkovrtstvá omítka</skos:altLabel>
        <skos:altLabel xml:lang="es">yeso de estucar</skos:altLabel>
        <skos:altLabel xml:lang="cs">štuková omítka </skos:altLabel>
        <skos:note xml:lang="de">Gemisch aus Gips, Kalk und Sand, gut formbar, aber schnell erhärtend, wird für Plastiken und plastische Wanddekoration verwendet. [Koch 2009]</skos:note>
        <skos:note xml:lang="de">Schnell härtendes Gemisch aus Leimwasser und Gips, oft mit Zusätzen von Kalk oder Marmor etc. zum halbplastischen Verzieren von Decken und Wänden. [Glossarium Artis, Bd. 3, Bögen und Mauerwerk] </skos:note>
        <skos:note xml:lang="cs">Směs sádry, vápna a písku, dobře tvarovatelná, ale rychle tvrdnoucí, používá se pro plastiky a plastické dekorace stěn. [Koch 2008]</skos:note>
        <skos:note xml:lang="de">Stuck ist die plastische Ausformung von Mörteln aller Art auf Architekturoberflächen. [EwaGlos]</skos:note>
        <skos:note xml:lang="de">Stuck, ein mit Leimwasser angemachter Gipsmörtel. Je nach den Zusätzen (Kalk, Marmor) unterscheidet man Gipss., Weißs., S.marmor (Stucco lustro), Kalks., Zements. und Graus. S. ist nicht wetterfest (Gips!) und wird daher meist in Innenräumen verwendet. Seiner spezif. Eigenschaften wegen wird er bes. zur Herstellung frei aufgetragener Dekorationen, zum Ziehen von Profilen mit Schablone oder für geschliffenen und polierten Wandputz verwendet. [Koepf / Binding 2016]</skos:note>
        <skos:note xml:lang="en">The plastic moulding of all kinds of mortars on architectural surfaces for decorative purposes. [EwaGlos]</skos:note>
        <skos:prefLabel xml:lang="de">Stuck</skos:prefLabel>
        <skos:prefLabel xml:lang="es">estuco</skos:prefLabel>
        <skos:prefLabel xml:lang="la">opus album</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">stuc</skos:prefLabel>
        <skos:prefLabel xml:lang="en">stucco</skos:prefLabel>
        <skos:prefLabel xml:lang="it">stucco</skos:prefLabel>
        <skos:prefLabel xml:lang="cs">štuk</skos:prefLabel>
    </owl:NamedIndividual>
    


