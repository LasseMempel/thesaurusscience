        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ede8e468"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-25T12:08:06.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-26T14:03:22.000</terms:modified>
        <skos:definition xml:lang="de">Oft plast., knospenähnl. Ornament in Hohlkehlen von ma. Portalgewänden und Gesimsen.[Koepf / Binding 2016]</skos:definition>
        <skos:prefLabel xml:lang="de">Ballenblume</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://hist-arch-vocab.org/bvha#c_ea23a271 -->


    <owl:NamedIndividual rdf:about="https://hist-arch-vocab.org/bvha#c_ea23a271">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_70f41797"/>
        <skos:broader rdf:resource="https://hist-arch-vocab.org/bvha#c_f9171b53"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_7816b346"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_84fc24e6"/>
        <skos:inScheme rdf:resource="https://hist-arch-vocab.org/bvha#conceptScheme_ea998ebe"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-05T15:21:30.000</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-22T12:30:11.000</terms:modified>
        <skos:definition xml:lang="de">Vorkragende Erker und Galerien aus Holz an Gebäuden und Wehrmauern. [Koepf / Binding 2016]</skos:definition>
